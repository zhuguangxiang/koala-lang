/*
 * demo/app — application logic, depends on demo/math and demo/text.
 */

import "demo/math"
import "demo/text"

/// Return a greeting for name.
pub func greet(name str) str {
    return text.concat("Hello, ", text.concat(name, "!"))
}

/// Return (a + b) * c.
pub func compute(a int, b int, c int) int {
    return math.mul(math.add(a, b), c)
}

import "std/sys"

func main() {
    print(sys.args())
    print(greet("wombat"))
    print(compute(1,2,3))
    print(sys.path)
}
