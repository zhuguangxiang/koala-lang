/*
 * demo/math — arithmetic helpers.
 */

link "demo_math"

/// Return `x * 3`, implemented in `native/math_native.c`.
@native
func triple(x int) int {}

/// Return a + b.
pub func add(a int, b int) int {
    return a + b
}

/// Return a - b.
pub func sub(a int, b int) int {
    return a - b
}

print(triple(5))  // 15
