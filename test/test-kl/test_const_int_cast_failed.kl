    print(float16(a))
}
// CHECK: constant float overflow in cast: cannot cast from int64 to float16

// ===== int64 -> float16 (INT64_MAX) =====
func test_i64_to_f16_max() {
    let a int64 = 9223372036854775807
    print(float16(a))
}
// CHECK: constant float overflow in cast: cannot cast from int64 to float16

// ---------- int -> float precision loss ----------

// ===== int16 -> float16 (above 2^11, folds to 32768) =====
func test_i16_to_f16_precision() {
    let a int16 = 32767
    print(float16(a))
}
// CHECK: constant float overflow in cast: cannot cast from int16 to float16

// ===== int32 -> float32 (above 2^24, folds to 2147483648) =====
func test_i32_to_f32_precision() {
    let a int32 = 2147483647
    print(float32(a))
}
// CHECK: constant float overflow in cast: cannot cast from int32 to float32

// ===== int64 -> float32 (above 2^24, folds to 9223372036854775808) =====
func test_i64_to_f32_precision() {
    let a int64 = 9223372036854775807
    print(float32(a))
}
// CHECK: constant float overflow in cast: cannot cast from int64 to float32

// ===== int64 -> float64 (above 2^53, folds to 9007199254740992) =====
func test_i64_to_f64_precision() {
    let a int64 = 9007199254740993
    print(float64(a))
}
// CHECK: constant float overflow in cast: cannot cast from int64 to float64

