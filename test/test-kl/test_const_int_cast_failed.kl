// CHECK: constant integer overflow in cast: cannot cast negative int64 to uint32

// ===== int64 -> uint64 (val < 0) =====
func test_i64_to_u64_neg() {
    let a int64 = -1
    print(uint64(a))
}
// CHECK: constant integer overflow in cast: cannot cast negative int64 to uint64

// ===== int64 -> uint8 (val > UINT8_MAX) =====
