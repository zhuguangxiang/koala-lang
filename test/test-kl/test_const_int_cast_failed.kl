    let a int64 = -1
    print(uint8(a))
}
// CHECK: constant integer overflow in cast: cannot cast negative int64 to uint8

// ===== int64 -> uint16 (val < 0) =====
func test_i64_to_u16_neg() {
    let a int64 = -1
    print(uint16(a))
}
// CHECK: constant integer overflow in cast: cannot cast negative int64 to uint16

// ===== int64 -> uint32 (val < 0) =====
