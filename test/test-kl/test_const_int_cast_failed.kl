// CHECK: constant integer overflow in cast: cannot cast from int64 to uint16

// ===== int64 -> uint32 (val > UINT32_MAX) =====
func test_i64_to_u32_pos() {
    let a int64 = 5000000000
    print(uint32(a))
}
// CHECK: constant integer overflow in cast: cannot cast from int64 to uint32

// ===== int64 -> float16 (val > 65504, rounds to inf) =====
func test_i64_to_f16_pos() {
    let a int64 = 100000
    print(float16(a))
}
// CHECK: constant float overflow in cast: cannot cast from int64 to float16

