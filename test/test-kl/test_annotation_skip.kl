// RUN: ! koalac %s | filecheck %s

func add(v1 int, v2 int) int { return v1 + v2 }

@test
func test_add_bad(v int) {}

@test("reason")
func test_add_with_param() {}

@bench(invalid_param=10)
func test_bench_invalid_param() {}

@bench(warmup="string")
func test_bench_string_param() {}

@bench
func bench_no_prefix() {}

@bench
func test_bench_generic[T]() {}

@bench
func test_bench_with_return() int {}

@bench
func test_bench_with_arg(x int) {}

// CHECK: func 'test_add_bad' with 'test' annotation cannot have any argument.
// CHECK: func 'test_add_with_param' with 'test' annotation cannot have any parameter.
// CHECK: func 'test_bench_invalid_param' with 'bench' annotation has unknown parameter 'invalid_param'.
// CHECK: func 'test_bench_string_param' with 'bench' annotation parameter 'warmup' must be an integer.
// CHECK: func 'test_bench_generic' is a generic function. The 'bench' annotation only be used for non-generic function.
// CHECK: func 'test_bench_with_return' with 'bench' annotation cannot have return type.
// CHECK: func 'test_bench_with_arg' with 'bench' annotation cannot have any argument.
