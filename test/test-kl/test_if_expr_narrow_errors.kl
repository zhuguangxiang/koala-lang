// RUN: ! koalac %s 2>&1 | filecheck %s
// The narrowing of an 'if' expression stays in its branches.

func f(v str?) int {
    // the then branch of `v == nil` keeps `v` optional
    let a = if v == nil { v.len() } else { 0 }
    // CHECK: optional cannot use dot operator.

    // after the expression `v` is optional again
    let b = if v == nil { 0 } else { v.len() }
    let c = v.len()
    // CHECK: optional cannot use dot operator.
    return a + b + c
}

// CHECK-NOT: error:
