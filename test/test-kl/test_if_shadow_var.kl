// RUN: koalac %s | filecheck %s

func fn1(v1 int?) {
    if v1 != nil {
        v1 + 123
    }

    v1 + 200
    // CHECK: optional type cannot be used with '+' operator.
}

func fn2(v1 int?) {
    if v1 != nil {
        v1 + 123

        let v2 int? = nil

        if (v2 == nil) {
            v2 + 456
            // CHECK-NEXT: optional type cannot be used with '+' operator when value is nil.
        }

        v1 + 456

        v2 + 789
        // CHECK-NEXT: optional type cannot be used with '+' operator.
    }

    v1 + 200
    // CHECK-NEXT: optional type cannot be used with '+' operator.
}

func fn3(v1 int?) {
    if v1 == nil {
        return
    }

    v1 + 100
}

func fn4(v int?) int {
    if nil != v {
        return 1
    } else {
        return 0
    }

    if nil != v { return 1 }

    v + 1
    // CHECK-NEXT: optional type cannot be used with '+' operator when value is nil.

    nil != v

    return 100
}

func fn5(v1 int?) {
    if v1 != nil {
        v1 + 123

        let v2 int? = nil
        if (v2 == nil) {
            return
        }

        v1 + 456
        v2 + 789
    }

    v1 + 200
    // CHECK-NEXT: optional type cannot be used with '+' operator.
}

func fn6(v1 int?) {
    if v1 != nil {
        v1 + 123

        let v2 int? = nil
        {
            if (v2 == nil) {
                return
            }

            v1 + 456
        }
        v2 + 789
        // CHECK-NEXT: optional type cannot be used with '+' operator.

    }

    v1 + 200
    // CHECK-NEXT: optional type cannot be used with '+' operator.
}

func fn7(v1 int) {
    let v2 int? = nil
    if (v1 > 0) {
        if (v2 == nil) { return }
    }
    v2 + 1
    // CHECK-NEXT: optional type cannot be used with '+' operator.
}

func fn8(v1 int?, v2 int?) {
    if (v1 == nil) { return }
    // Shadow Scope A (v1: int)
    if (v2 == nil) { return }
    // Shadow Scope B (v1: int, v2: int)
    v1 + v2
}

func fn9() {
    let v2 int? = nil
    {
        {
            if (v2 == nil) { return }
        }
        v2 + 1
        // CHECK-NEXT: optional type cannot be used with '+' operator.
    }
    v2 + 1
    // CHECK-NEXT: optional type cannot be used with '+' operator.
}

func fn10(v int?) {
    if !(v != nil) {
        return
    }
    v + 1
}

func fn10_1(v int?) {
    if !!(v == nil) {
        return
    }
    v + 1
}

func fn10_2(v int?) {
    if !!(!(v == nil)) {
        return
    }
    v + 1
    // CHECK-NEXT: optional type cannot be used with '+' operator when value is nil.
}

func fn11(v int?) int {
    if (v == nil) {
        return 1
        v + 1 // dead code
    }

    v + 1
}

func fn12(v int?) int {
    if (v == nil) {
        {
            return 1 // The return is inside a naked block
        }

        v + 2 // dead code
    }

    v + 1
}

func fn13(v int?) int {
    if (v == nil) {
        return 1
        v + 1 // // dead code
    }

    v + 1

    if (v == nil) {
        // CHECK-NEXT: cannot compare non-optional type with optional type for '==' operator.
        {
            return 1 // The return is inside a naked block
        }

        v + 2 // dead code
    }
}

func fn14(v1 int?) int {
    var v int? = v1

    if (v == nil) { return 0 }

    {
        v = nil
    }

    if (v == nil) { return 1 }

    return v
}

func fn14_1(v1 int?) int {
    var v int? = v1

    if (v == nil) { return 0 }

    {
        v = 100
    }

    return v
}

func fn14_2(v1 int?) int {
    var v int? = v1
    v = 100
    return v
    // CHECK-NEXT: return type mismatch in function 'fn14_2'
}

func fn15 () {
    let v1 int? = nil

    if (v1 != nil) {
        // in here, 'v' is non-nil
    } else {
        // in here, 'v' is nil
    }
    // no shadow

    v1 - 200
    // CHECK-NEXT: optional type cannot be used with '-' operator.

    if v1 == nil {
        return
    }
    // shadow 'v1' as non-nil here

    v1 + 200

    let v2 int? = 1

    if (v2 == nil) {
        // in here, 'v2' is nil
    }
    // no shadow

    v2 - 100
    // CHECK-NEXT: optional type cannot be used with '-' operator.

    if v2 == nil {
        return
    }
    // shadow 'v2' as non-nil here

    v2 + 100
    v1 + 123
}

// CHECK-NOT: {{.}}
