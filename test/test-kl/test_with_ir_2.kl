// RUN: koalac %s --cgen --dump=no-opt-ir,ir,lir | filecheck %s
// `with v = expr { }`: v is bound to the resource, __exit__ before `return`, `break` and `continue`

class Lock : Withable {
    pub var n int
    pub func __init__() { n = 7 }
    pub func __enter__() {}
    pub func __exit__() {}
}

func bind() int {
    with v = Lock() {
        return v.n
    }
}

func loops(k int) {
    for i in range(0, k) {
        with v = Lock() {
            if i == v.n {
                break
            }
            continue
        }
    }
}

// nested 'with' blocks: 'break' / 'continue' call the inner __exit__, then the outer one
func nested(a Lock, b Lock, k int) {
    while k > 0 {
        with a {
            with b {
                if k == 1 {
                    break
                }
                continue
            }
        }
    }
}

// a 'with' block around a loop: 'break' of that loop does not call its __exit__
func around(a Lock, k int) {
    with a {
        while k > 0 {
            break
        }
    }
}

