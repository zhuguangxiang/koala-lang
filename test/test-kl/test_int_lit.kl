// RUN: ! koalac %s | filecheck %s

let NUM = 18_446_744_073_709_551_616
// CHECK: Number 18_446_744_073_709_551_616 is out of int range

let NUM2 int64 = -9223372036854775809
// CHECK-NEXT: Number -9223372036854775809 is out of int range
// CHECK-NEXT: Value -9223372036854775809 overflows 'int64' range

var v int = 400
var v2 int16 = 128
var v3 = 600
var v4 int32 = -200

var v6 int8 = -0x01
var v8 uint64 = 100

// uint64 max is 18446744073709551615
var v9 int64 = 18446744073709551615 // Error: Value 18446744073709551615 overflows 'int64' range

// CHECK-NEXT: Value 18446744073709551615 overflows 'int64' range

// int64 max is 9223372036854775807 and min is -9223372036854775808
var a int64 = -9223372036854775808;

var a1 uint8 = -129

// CHECK-NEXT: Value -129 overflows 'uint8' range

var q = 100
var r = 9223372036854775808
var a2 int8 = 0x7F        // Success: 127 (max value of int8)
var b int8 = 0x80         // Success: -128 (interpreted as bit pattern 1000 0000)
var c int8 = 0xFF         // Success: -1 (interpreted as bit pattern 1111 1111)
var d uint8 = 0xFF        // Success: 255 (bit-width matches)

var e int16 = -0xFF       // Success: -255 (mathematical value within range)
var f int8 = -0x80        // Success: -128 (exactly reaches the int8 lower limit)

var g int64 = 0x7FFFFFFFFFFFFFFF  // Success: INT64_MAX
var h int64 = 0x8000000000000000  // Success: INT64_MIN (bit pattern interpreted as signed)
var i uint64 = 0xFFFFFFFFFFFFFFFF // Success: UINT64_MAX
var j int64 = -9223372036854775808 // Success: INT64_MIN (parsed using int128 for precision)

var k = 100               // Success: default type inference to int64
var l int32 = +0xFF       // Success: '+' prefix does not change the value

// --- Decimal Mathematical Overflow (General Application Safety) ---
var m int8 = 128         // Error: 128 > 127 (strict decimal checking)
var n uint8 = 256        // Error: 256 > 255

// CHECK-NEXT: Value 128 overflows 'int8' range
// CHECK-NEXT: Value 256 overflows 'uint8' range

// --- Non-decimal Physical Bounds (Bit-width Protection) ---
var o int8 = 0x100       // Error: physically exceeds 8 bits (Bit pattern exceeds width)
var p uint16 = 0x1FFFF   // Error: physically exceeds 16 bits

// CHECK-NEXT: Bit pattern exceeds the bit width of 'int8'
// CHECK-NEXT: Bit pattern exceeds the bit width of 'uint16'

// --- Negative Bounds & Sign Protection ---
var q1 uint32 = -1       // Error: cannot assign negative value to unsigned type
var r1 uint64 = -0x1     // Error: negative hex literal forbidden for unsigned type
var s int8 = -129        // Error: value below int8 lower limit

// CHECK-NEXT: Value -1 overflows 'uint32' range
// CHECK-NEXT: Negative hex literal -0x1 overflows 'uint64' range
// CHECK-NEXT: Value -129 overflows 'int8' range

var t int8 = -0xFF       // Error: value -255 is below int8 lower limit (-128)

// CHECK-NEXT: Negative hex literal -0xFF overflows 'int8' range

var w int32 = -0x7FFFFFFF // Success: -2147483647
var x int32 = -0x80000000 // Success: -2147483648 (bit pattern for int32 min)

// --- 64-bit Physical Limit Interception ---
// var u uint64 = 18446744073709551616 // Error: exceeds 64-bit maximum value (2^64)
// var v int64 = -9223372036854775809  // Error: below int64 lower limit (INT64_MIN - 1)

// --- Default Type Inference Tests ---
var y = 0xFFFFFFFFFFFFFFFF // Success: inferred as uint64

var z = -0x88 // Success: inferred as int64

var z1 int8 = 0x88 // Success: -120 (bit pattern 1000 1000 interpreted as signed)

var v5 int8 = 300 // Error: constant 300 overflows int8 (if applicable)

// CHECK-NEXT: Value 300 overflows 'int8' range

var z12 int8 = 0x88 // Success: -120 (same as z1)

var z2 int8 = -0x88 // Error: value -136 overflows int8 range

// CHECK-NEXT: Negative hex literal -0x88 overflows 'int8' range

// --- Default Type Inference For Non-Decimal Literals ---
// A literal is int64 by default, whatever base it is written in; only a
// value that does not fit into int64 degrades to uint64. These declarations
// must all compile, the type itself is checked in test-ut/test_int_literal.kl.
var lit_hex = 0xFF
var lit_bin = 0b1010
var lit_oct = 0o17
var lit_neg_bin = -0b1010
var lit_pos_hex = +0xFF
var lit_max = 0x7FFFFFFFFFFFFFFF
var lit_big = 0x8000000000000000
var lit_umax = 0xFFFFFFFFFFFFFFFF

// CHECK-NOT: {{.}}
