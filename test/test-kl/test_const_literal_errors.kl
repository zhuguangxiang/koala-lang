// RUN: ! koalac %s 2>&1 | filecheck %s
// A const initializer must be a whitelisted constant expression: a literal, another
// const, or a unary/binary operation over constant operands. Anything else errors.

func foo() int = 1

const B = foo()
// CHECK: const value must be a constant expression.
const D = [1]
// CHECK: const value must be a constant expression.
const T = (1, 2)
// CHECK: a const tuple is not supported.
const BY = b"by"
// CHECK: a const bytes is not supported.
const SC = "a" == "b"
// CHECK: str only supports '+' in a const expression.
const DZ = 5 / 0
// CHECK: division by zero
const OV = 9223372036854775807 + 1
// CHECK: signed integer overflow in binary add
const SH = 1 << 64
// CHECK: shift count out of range: 64
const F = nil
// CHECK: cannot assign 'nil' to variable 'F' without explicit type
const CR = CR + 1
// CHECK: circular reference detected for 'CR'

func main() {
    const L = foo()
    // CHECK: const value must be a constant expression.
}
