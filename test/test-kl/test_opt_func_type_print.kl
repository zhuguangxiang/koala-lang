// RUN: koalac --irgen --dump=all %s | filecheck %s
//
// An optional *function* type prints as `(func(...)...)?`, with parens around
// the function type. Without them the trailing `?` would read as an optional
// return type, which is a different type (see the contrast below).

type F = func(int) int
type OptFn = F?

// parameter of optional function type
// CHECK: func @takes(%cb (func(int64)int64)?) int64 {
func takes(cb OptFn) int {
    return 0
}

// return of optional function type
// CHECK: func @gives() (func(int64)int64)? {
func gives() OptFn {
    return nil
}

// contrast: a function returning optional int keeps the bare `?` suffix
// CHECK: func @opt_ret() int64? {
func opt_ret() int? {
    return nil
}

// nested in a generic argument: the specialized klass name carries the
// mangled type argument, so it is wildcarded as in test_type_alias.kl
// CHECK: func @boxed(%xs std/builtin.list<{{.*}}>) int64 {
func boxed(xs list[OptFn]) int {
    return 0
}