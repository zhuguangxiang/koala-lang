// CHECK-NEXT: %0 = cmpne %o test_with_ir_3.Res?, nil
// CHECK-NEXT: branch %0 bool, label %bb2, label %bb3
// CHECK-EMPTY:
// CHECK-NEXT: %bb1(with-end):
// CHECK-NEXT: ret void
// CHECK-EMPTY:
// CHECK-NEXT: %bb2(with-then):
// CHECK-NEXT: call @Res:__enter__, %r test_with_ir_3.Res
// CHECK-NEXT: %1 = call @Res:get, %r test_with_ir_3.Res
// CHECK-NEXT: call @Res:__exit__, %r test_with_ir_3.Res
// CHECK-NEXT: jmp label %bb1
// CHECK-EMPTY:
// CHECK-NEXT: %bb3(with-else):
// CHECK-NEXT: jmp label %bb1
// CHECK-NEXT: }
//
