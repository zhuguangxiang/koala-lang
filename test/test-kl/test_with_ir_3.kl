// RUN: koalac %s --cgen --dump=no-opt-ir,ir,lir | filecheck %s
// `with let v = expr { } else { }`: nil skips __enter__ / __exit__ and runs the else block;
// jumps out of the else block call no __exit__

class Res : Withable {
    pub func __enter__() {}
    pub func __exit__() {}
    pub func get() int { return 1 }
}

func opt(o Res?) int {
    with let r = o {
        return r.get()
    } else {
        return 0
    }
}

func no_else(o Res?) {
    with let r = o {
        r.get()
    }
}

func loop_let(o Res?, k int) {
    while k > 0 {
        with let r = o {
            break
        } else {
            continue
        }
    }
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK: func @opt(%o test_with_ir_3.Res?) int64 {
// CHECK-NEXT: %bb0(entry):
// CHECK-NEXT: %r = local [immutable] test_with_ir_3.Res
// CHECK-NEXT: move %r test_with_ir_3.Res, %o test_with_ir_3.Res?
// CHECK-NEXT: %0 = cmpne %o test_with_ir_3.Res?, nil
// CHECK-NEXT: branch %0 bool, label %bb2, label %bb3
// CHECK-EMPTY:
// CHECK-NEXT: %bb1(with-end):
// CHECK-NEXT: ret void
// CHECK-EMPTY:
// CHECK-NEXT: %bb2(with-then):
// CHECK-NEXT: call @Res:__enter__, %r test_with_ir_3.Res
// CHECK-NEXT: %1 = call @Res:get, %r test_with_ir_3.Res
// CHECK-NEXT: %with.ret = local [immutable] int64
// CHECK-NEXT: move %with.ret int64, %1 int64
// CHECK-NEXT: call @Res:__exit__, %r test_with_ir_3.Res
// CHECK-NEXT: ret %with.ret int64
// CHECK-EMPTY:
// CHECK-NEXT: %bb3(with-else):
// CHECK-NEXT: ret 0 int64
// CHECK-NEXT: }
//
// CHECK: func @no_else(%o test_with_ir_3.Res?) <NO-TYPE> {
// CHECK-NEXT: %bb0(entry):
// CHECK-NEXT: %r = local [immutable] test_with_ir_3.Res
