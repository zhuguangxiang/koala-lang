// RUN: ! koalac %s 2>&1 | filecheck %s

// A class of another package without a public `__init__` cannot be constructed. A generic class is
// reported like any other, and the compiler does not crash.

import "test_pkg/pkg_no_init"

func main() {
    let a = pkg_no_init.Plain()
    // CHECK: test_external_class_no_init.kl:9:{{.*}}class 'Plain' is external, but has no public '__init__()'.

    let b = pkg_no_init.Generic[int]()
    // CHECK-NEXT: test_external_class_no_init.kl:12:{{.*}}class 'Generic' is external, but has no public '__init__()'.

    let c = pkg_no_init.Generic()
    // CHECK-NEXT: test_external_class_no_init.kl:15:{{.*}}class 'Generic' is external, but has no public '__init__()'.

    let d = pkg_no_init.WithInit[int]()
    // CHECK-NOT: error:
}
