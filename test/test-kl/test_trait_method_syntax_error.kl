// RUN: ! koalac %s 2>&1 | filecheck %s

// A syntax error in a trait method is reported, and the compiler does not crash.

trait Wrong { func apply(a int b) int }
// CHECK: expected a function prototype.

trait FuncParam[T] { func apply(f func(T) int) int }
// CHECK: expected a function prototype.

trait WithAccess { pub func apply(a int b) int }
// CHECK: expected a function prototype.

func main() {}
