// RUN: ! koalac %s 2>&1 | filecheck %s
// name(), hash() and fmt() are the only methods on an enum value: 0/1 arguments, call-only,
// normal dot.

enum Color { RED, GREEN = 5 }

func main() {
    let c = Color.RED

    print(c.name(1))
    // CHECK: too many arguments in function call

    let f = c.name
    // CHECK: enum method 'name' can only be called

    c.name = "x"
    // CHECK: enum method 'name' can only be called

    print(Color.name())
    // CHECK: enum 'Color' has no member 'name'

    print(c.other())
    // CHECK: enum 'Color' has no members

    print(c!.name())
    // CHECK: enum member can't use `!.` or `?.`

    print(c.hash(1))
    // CHECK: too many arguments in function call

    let g = c.hash
    // CHECK: enum method 'hash' can only be called

    print(Color.hash())
    // CHECK: enum 'Color' has no member 'hash'

    print(c!.hash())
    // CHECK: enum method 'hash' can't use `!.` or `?.`

    print(c.fmt)
    // CHECK: enum method 'fmt' can only be called

    let o Color? = Color.RED
    print(o!.name())
    // CHECK: 'name' is not found in 'Color'

    let i = 5
    print(i.name())
    // CHECK: 'name' is not found in class 'int64'
}