// ---------- Infinities ----------

// ===== float64(+inf) -> int8 =====
func test_f64_inf_to_i8() {
    let a float64 = 1.0e400
    print(int8(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to int8

// ===== float64(+inf) -> uint8 =====
func test_f64_inf_to_u8() {
    let a float64 = 1.0e400
    print(uint8(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to uint8

// ===== float64(+inf) -> int64 =====
func test_f64_inf_to_i64() {
    let a float64 = 1.0e400
    print(int64(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to int64

// ===== float64(+inf) -> uint64 =====
func test_f64_inf_to_u64() {
    let a float64 = 1.0e400
    print(uint64(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to uint64

// ===== float64(-inf) -> int8 =====
func test_f64_ninf_to_i8() {
    let a float64 = -1.0e400
    print(int8(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to int8

// ===== float64(-inf) -> uint8 (v < 0 fires first) =====
func test_f64_ninf_to_u8() {
    let a float64 = -1.0e400
    print(uint8(a))
}
// CHECK: constant float overflow in cast: cannot cast negative float64 to uint8

// ===== float64(-inf) -> uint64 (v < 0 fires first) =====
func test_f64_ninf_to_u64() {
    let a float64 = -1.0e400
    print(uint64(a))
}
// CHECK: constant float overflow in cast: cannot cast negative float64 to uint64

// ===== float16(+inf) -> int8 / uint8 =====
func test_f16_inf_to_i8() {
    let a float16 = 1.0e400
    print(int8(a))
}
// CHECK: constant float overflow in cast: cannot cast from float16 to int8

func test_f16_inf_to_u8() {
    let a float16 = 1.0e400
    print(uint8(a))
}
// CHECK: constant float overflow in cast: cannot cast from float16 to uint8

// ---------- NaN ----------

// ===== NaN -> int8 =====
func test_nan_to_i8() {
    let a float64 = 1.0e400 - 1.0e400
    print(int8(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to int8

// ===== NaN -> int16 =====
func test_nan_to_i16() {
    let a float64 = 1.0e400 - 1.0e400
    print(int16(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to int16

// ===== NaN -> int32 =====
func test_nan_to_i32() {
    let a float64 = 1.0e400 - 1.0e400
    print(int32(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to int32

// ===== NaN -> int64 =====
func test_nan_to_i64() {
    let a float64 = 1.0e400 - 1.0e400
    print(int64(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to int64

// ===== NaN -> uint8 =====
func test_nan_to_u8() {
    let a float64 = 1.0e400 - 1.0e400
    print(uint8(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to uint8

// ===== NaN -> uint16 =====
func test_nan_to_u16() {
    let a float64 = 1.0e400 - 1.0e400
    print(uint16(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to uint16

// ===== NaN -> uint32 =====
func test_nan_to_u32() {
    let a float64 = 1.0e400 - 1.0e400
    print(uint32(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to uint32

// ===== NaN -> uint64 =====
func test_nan_to_u64() {
    let a float64 = 1.0e400 - 1.0e400
    print(uint64(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to uint64

func test_f64_to_f16_2() {
    let f = 1.2345678901234567
    let n = float16(f)
    print(n)

    // f32 rounds a big int value
    print(float32(float(16777217)))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to float16
// CHECK: constant float overflow in cast: cannot cast from float64 to float32

// CHECK-NOT: {{.}}
