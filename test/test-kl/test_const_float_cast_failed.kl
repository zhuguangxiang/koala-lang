// RUN: koalac %s --opt 2>&1 | filecheck %s

// ---------- float64 source -> int8 ----------

// ===== float64 -> int8 (ival > INT8_MAX) =====
func test_f64_to_i8_pos() {
    let a float64 = 200.5
    print(int8(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to int8

// ===== float64 -> int8 (ival < INT8_MIN) =====
func test_f64_to_i8_neg() {
    let a float64 = -200.5
    print(int8(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to int8

// ===== float64 -> int8 (|v| >= 2^63, rejected before the cast) =====
func test_f64_to_i8_huge() {
    let a float64 = 1.0e30
    print(int8(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to int8

func test_f64_to_i8_huge_neg() {
    let a float64 = -1.0e30
    print(int8(a))
}
// CHECK: constant float overflow in cast: cannot cast from float64 to int8

