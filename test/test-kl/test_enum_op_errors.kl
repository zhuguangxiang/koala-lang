// RUN: ! koalac %s 2>&1 | filecheck %s
// Enum only supports '==' and '!='.

enum A {
    X,
}

func enum_errors() {
    var i int = 1
    let a A = A.X
    let cmp0 = a < a
    // CHECK: enum only supports '==' and '!=', not '<'.
    let cmp1 = a <= a
    // CHECK: enum only supports '==' and '!=', not '<='.
    let cmp2 = a > a
    // CHECK: enum only supports '==' and '!=', not '>'.
    let cmp3 = a >= a
    // CHECK: enum only supports '==' and '!=', not '>='.
    let cmp4 = a < 3
    // CHECK: enum only supports '==' and '!=', not '<'.
    let cmp5 = i >= a
    // CHECK: enum only supports '==' and '!=', not '>='.
    let bin0 = a + a
    // CHECK: enum only supports '==' and '!=', not '+'.
    let bin1 = a - a
    // CHECK: enum only supports '==' and '!=', not '-'.
    let bin2 = a * a
    // CHECK: enum only supports '==' and '!=', not '*'.
    let bin3 = a / a
    // CHECK: enum only supports '==' and '!=', not '/'.
    let bin4 = a % a
    // CHECK: enum only supports '==' and '!=', not '%'.
    let bin5 = a & a
    // CHECK: enum only supports '==' and '!=', not '&'.
    let bin6 = a | a
    // CHECK: enum only supports '==' and '!=', not '|'.
    let bin7 = a ^ a
    // CHECK: enum only supports '==' and '!=', not '^'.
    let bin8 = a << a
    // CHECK: enum only supports '==' and '!=', not '<<'.
    let bin9 = a >> a
    // CHECK: enum only supports '==' and '!=', not '>>'.
    let bin10 = a && a
    // CHECK: enum only supports '==' and '!=', not '&&'.
    let bin11 = a || a
    // CHECK: enum only supports '==' and '!=', not '||'.
    let rl = 1 + a
    // CHECK: enum only supports '==' and '!=', not '+'.
    let ri = i * a
    // CHECK: enum only supports '==' and '!=', not '*'.
    let un0 = !a
    // CHECK: enum does not support unary operators.
    let un1 = ~a
    // CHECK: enum does not support unary operators.
    let un2 = +a
    // CHECK: enum does not support unary operators.
    let un3 = -a
    // CHECK: enum does not support unary operators.
}
