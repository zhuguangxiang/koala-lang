// RUN: ! koalac %s 2>&1 | filecheck %s
// A @mock stub's parameters and return type must match the target function.

import "std/os"

@mock("os.getenv")
func bad_ret(key str) str { return "x" }
// CHECK: return type does not match target 'os.getenv'

@mock("os.getenv")
func bad_arg(key int) str? { return nil }
// CHECK: parameter 'key' type does not match target 'os.getenv'

@mock("os.getenv")
func bad_count() str? { return nil }
// CHECK: has 0 parameter(s) but target 'os.getenv' expects 1

@mock("os.no_such_func")
func bad_target(key str) str? { return nil }
// CHECK: function 'no_such_func' not found in package 'os'