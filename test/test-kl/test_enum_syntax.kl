// RUN: koalac %s 2>&1 | filecheck %s --allow-empty
// The enum forms the grammar accepts: members separated by ',', ';' or newlines,
// with an optional trailing separator. Only the front end runs, no error is expected.

enum Signal { HUP = 1, INT = 2, QUIT = 3, KILL = 9 }

// trailing ','
enum Color { RED, GREEN, BLUE, }

// one member per line, no trailing ','
enum Level {
    TRACE,
    DEBUG,
    INFO = 10,
    OFF
}

// members separated by newlines only
enum Weekday {
    MON
    TUE
    WED
}

// members separated by ';', a trailing ';'
enum Dir { UP; DOWN; LEFT; RIGHT; }

// hex / binary literals, trailing ','
enum Mode {
    READ = 0x1,
    WRITE = 0b10,
}

// negative values and the int64 limits
pub enum Bound { LOW = -1, ZERO, MAX = 9223372036854775807, MIN = -9223372036854775808 }

// digits and '_' after the first letter, a single member
enum Proto { HTTP2, TLS_1_3 }
enum One { ONLY }

func main() {}
// CHECK-NOT: error
