// RUN: koalac %s 2>&1 | filecheck %s

func fn1() {
    return
}

func fn2() int {
    return 100
}

func fn3() str {
    return "hello"
}

func fn4() int {
    return "test"
    // CHECK: return type mismatch in function 'fn4'
}

func fn5() int {
    return
    // CHECK-NEXT: function 'fn5' needs a return value.
}

func fn5_1() int? {
    return nil
}

func println(s str) {
}

func fn6() int {
    let i = 200
    if i < 100 {
        let j = "hello"
        println("small")
    } else {
        let j = true
        println("big")
    }
    return 200
}

var opt int? = 100
var val int = opt
// CHECK-NEXT: Types of two sides are not matched.
// CHECK-NEXT: lhs: int64 =/= rhs: int64?

var val1 int = nil
// CHECK-NEXT: Types of two sides are not matched.
// CHECK-NEXT: lhs: int64 =/= rhs: _?

var val1_1 int? = nil

var val2 bool = opt == nil
var val3 bool = opt != nil
var val4 bool = nil == opt
var val5 bool = nil != opt
var val6 bool = nil == nil
var val7 bool = nil != nil
var val8 bool = 100 == nil
// CHECK-NEXT: cannot compare non-optional type with optional type for '==' operator.
var val9 bool = nil != 100
// CHECK-NEXT: cannot compare optional type with non-optional type for '!=' operator.

var val10 bool = opt == 100
// CHECK-NEXT: cannot compare optional type with non-optional type for '==' operator.

var val11 bool = 100 != opt
// CHECK-NEXT: cannot compare non-optional type with optional type for '!=' operator.

var val12 bool = opt == opt
var val13 bool = opt != opt

class Foo {
    func __init__() {}
    func fly() int? { return 100; }
}

let foo_fly = Foo().fly()

func fn7(v int?) {
    v + 100
    // CHECK-NEXT: optional type cannot be used with '+' operator.

    nil + 100
    // CHECK-NEXT: optional type cannot be used with '+' operator.

    if v {
        let k = 100
        k + 200
    }
    // CHECK-NEXT: if condition must be boolean type.

    100 + v
    // CHECK-NEXT: argument type mismatch for operator '+' of type 'int64'.

    if v != nil {
        v + 123
    }

    v + 123
    // CHECK-NEXT: optional type cannot be used with '+' operator.

    if nil != v {
        456 + v
    }

    if nil != nil {
        789 + 100
    }

    if v == nil {
        v + 321
        // CHECK-NEXT: optional type cannot be used with '+' operator when value is nil.
    }

    if v != nil {
        if v == 100 { // 这里 v 已经是 int 了，应该允许和 100 比较
            // OK
        }
    }

    if Foo().fly() {
        // CHECK-NEXT: if condition must be boolean type.
        foo_fly + 50
        // CHECK-NEXT: optional type cannot be used with '+' operator.
    }

    if Foo().fly() != nil {
        Foo().fly() + 50
        // CHECK-NEXT: optional type cannot be used with '+' operator.
    }

    let n = 100
    n.__add__(50)
    // CHECK-NEXT: '__add__' cannot be called explicitly, use the '+' operator instead.

    if (v == nil) {
        v + 100
        // CHECK-NEXT: optional type cannot be used with '+' operator when value is nil.
    } else {
        v + 200
    }

    if (v != nil) {
        v + 300
    } else {
        v + 400
        // CHECK-NEXT: optional type cannot be used with '+' operator when value is nil.
    }

    if v == nil {
        500 + v
        // CHECK-NEXT: argument type mismatch for operator '+' of type 'int64'.
    } else if v > 100 {
        600 + v
    } else {
        700 + v
    }

    if v == nil {
        324 + v
        // CHECK-NEXT: argument type mismatch for operator '+' of type 'int64'.
    } else {
        if v > 1000 {
            111 + v
        } else {
            222 + v
        }
    }

    if v == nil {
       return
    }

    v + 999

    // how to handle the variable shadowing here?

    // if let f = Foo().fly() {
    //     f + 100
    // }

    // 100 + f
    // // CHECK-NEXTxxxxxxxxxxxxx: cannot find symbol 'f'.

    // 100.__add__(foo_fly)
}

func fn16(v1 int?) int {
    var v int? = v1
    v = 100
    return v
    // CHECK-NEXT: return type mismatch in function 'fn16'
}

func fn14(v1 int?) int {
    var v int? = v1

    if (v == nil) { return 0 }

    {
        v = nil
    }

    if (v == nil) { return 1 }

    return v
}

func fn15(v1 int?) int {
    var v int? = v1

    if (v == nil) { return 0 }

    {
        v = 100
    }

    return v
}

// 100.__add__(1)
// 100.0.__add__(2.0)
// CHECK-NOT: {{.}}
