// RUN: koalac %s --cgen --dump=no-opt-ir,ir,lir | filecheck %s
// `with r { }`: __enter__ and __exit__ are called on the param / local directly,
// __exit__ on the end of the block and before `return`

class Res : Withable {
    pub func __enter__() {}
    pub func __exit__() {}
    pub func get() int { return 1 }
}

func plain(r Res) {
    with r {
        r.get()
    }
}

func early(r Res, flag bool) int {
    with r {
        if flag {
            return r.get()
        }
    }
    return 0
}

// 'with v = a' binds a new immutable 'v', assigning 'a' in the block leaves 'v' alone;
// 'with b' on a 'var' local shadows it, it cannot change in the block
func locals() {
    var a = Res()
    with v = a {
        a = Res()
    }
    var b = Res()
    with b {
        b.get()
    }
}

// a global is read once into a hidden local
let g = Res()

func global() {
    with g {
        g.get()
    }
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK: func @plain(%r test_with_ir.Res) <NO-TYPE> {
// CHECK-NEXT: %bb0(entry):
// CHECK-NEXT: call @Res:__enter__, %r test_with_ir.Res
// CHECK-NEXT: %0 = call @Res:get, %r test_with_ir.Res
// CHECK-NEXT: call @Res:__exit__, %r test_with_ir.Res
// CHECK-NEXT: jmp label %bb1
// CHECK-EMPTY:
// CHECK-NEXT: %bb1(with-end): ;; preds = %bb0
// CHECK-NEXT: ret void
// CHECK-NEXT: }
//
// CHECK: func @early(%r test_with_ir.Res, %flag bool) int64 {
// CHECK-NEXT: %bb0(entry):
// CHECK-NEXT: call @Res:__enter__, %r test_with_ir.Res
// CHECK-NEXT: branch %flag bool, label %bb2, label %bb3
// CHECK-EMPTY:
// CHECK-NEXT: %bb1(with-end): ;; preds = %bb4
// CHECK-NEXT: ret 0 int64
// CHECK-EMPTY:
// CHECK-NEXT: %bb2(if-then): ;; preds = %bb0
// CHECK-NEXT: %0 = call @Res:get, %r test_with_ir.Res
// CHECK-NEXT: %with.ret = local [immutable] int64
// CHECK-NEXT: move %with.ret int64, %0 int64
// CHECK-NEXT: call @Res:__exit__, %r test_with_ir.Res
// CHECK-NEXT: ret %with.ret int64
// CHECK-EMPTY:
// CHECK-NEXT: %bb3(if-else): ;; preds = %bb0
// CHECK-NEXT: jmp label %bb4
// CHECK-EMPTY:
// CHECK-NEXT: %bb4(if-end): ;; preds = %bb3
// CHECK-NEXT: call @Res:__exit__, %r test_with_ir.Res
// CHECK-NEXT: jmp label %bb1
// CHECK-NEXT: }
//
