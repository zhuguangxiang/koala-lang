// RUN: koalac %s | filecheck %s

for i in range(1, 5) {
    print(i)
}

for i, j in range(1, 5) {}
// CHECK: iterable element type 'j' for 'Lstd/builtin.range;' is not tuple for multiple vars of for loop

for t in [(1,2),(3,4)] {
    t[0] + 1
    t[1] + 2
    t[2] + 3
// CHECK: tuple index out of range, got 2 but expected 0 <= index < 2
// CHECK: failed to infer type parameters for function '__getitem__'.
}

for i, j in [(1,2),(3,4)] {
    i + 1
    j + 2
}

for k in (1,2,3) { i + 1; k + 2; }
// CHECK: 'i' is not found

func foo() (int, str) { return (1, "hello") }

for i, s in foo() {
    i + 1.0
    s - " world"
// CHECK: iterable element type 'o' for 'Lstd/builtin.tuple<ju>;' is not tuple for multiple vars of for loop
// CHECK: 'i' is not found
// CHECK: 's' is not found
}

for s, s2 in "hello" {}
// CHECK: iterable element type 'u' for 'u' is not tuple for multiple vars of for loop

for s in "hello" {}

// CHECK-NOT: {{.}}
