// RUN: koalac %s 2>&1 | filecheck %s

let a = b + 100
let b = 200

let v = foo()

func foo() int {
    return bar()
}

func bar() int {
    return a + 400
}

class Foo : Bar {
    func __init__() {
    }

    func bar() int {
        return 300
    }
}

class Bar {
    func bar() int {
        return 100
    }
}
// CHECK: 'Bar' is not trait, only trait can be used as base

trait F1 : F2 {}

trait F2 : F1 {}
// CHECK: circular dependency detected when resolving 'F1'

// CHECK-NOT: {{.}}
