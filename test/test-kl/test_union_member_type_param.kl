// RUN: ! koalac %s 2>&1 | filecheck %s

// TODO §76: a union member can contain a type parameter. The declaration should be the error, and
// for now it is reported at the call, with `T` not bound.

trait Shapes[T] { func uni(x list[T] | bool) int }

class S : Shapes[str] {
    pub func uni(x list[str] | bool) int { return 2 }
}

func main() {
    let s Shapes[str] = S()
    s.uni(["x"])
    // CHECK: Incompatible type: expected 'bool | std/builtin.list[Shapes:T]'
}
