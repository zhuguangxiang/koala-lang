// RUN: ! koalac %s 2>&1 | filecheck %s

// error recovery for 'let (...)', 'var (...)' and 'for' loop variables

func let_missing_paren() {
    let (a, b = (1, 2)
}
// CHECK: expected ')'.

func var_missing_assign() {
    var (a, b) (1, 2)
}
// CHECK: expected '='.

func for_missing_paren() {
    let pairs = [(1, 2)]
    for (k, v in pairs {
        print(k, v)
    }
}
// CHECK: expected ')'.

func for_missing_in() {
    let pairs = [(1, 2)]
    for k, v pairs {
        print(k, v)
    }
}
// CHECK: expected 'in' after loop variables.

func for_paren_missing_in() {
    let pairs = [(1, 2)]
    for (k, v) pairs {
        print(k, v)
    }
}
// CHECK: expected 'in' after loop variables.
