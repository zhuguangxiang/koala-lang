// RUN: koalac %s | filecheck %s

class Bar {
    func bar() int {
        return 10
    }

    func get_id() int? { return 42 }
}

class Foo {
    func __init__() {}

    func foo() Bar? {
        return nil
    }

    func test1() int { return 1; }

    func test2() int? { return 1; }

    func bar() int = 1111
}

let f = Foo()

f!.foo()
// CHECK: only optional type can use bang dot operator.

f?.foo()
// CHECK-NEXT: only optional type can use optional dot operator.

f.foo()

let v = Foo().foo().bar()
// CHECK-NEXT: optional cannot use dot operator.

let v2 = Foo().foo()?.bar()

v2 + 5

// CHECK-NEXT: optional type cannot be used with '+' operator.

let v3 = Foo().foo()!.bar()

v3 + 5

let v4 = Foo().foo()?.get_id()


var f1 Foo? = Foo()

let a = f1?.test1() // 应推导为 int?

let b = f1?.test2() // 应推导为 int? (由于你的扁平化逻辑，不再是 int??)

let f2 Foo? = nil // OK

f2.bar()
// CHECK-NEXT: optional cannot use dot operator.

let f3 Foo = f2

// CHECK-NEXT: Types of two sides are not matched.
// CHECK-NEXT: lhs: test_expr.Foo =/= rhs: test_expr.Foo?

// print("hello world")


func fn(v int?) int {
    if v == nil{
        return 1
    } else {
        return 0
    }

    if v == nil { return 1 }

    v + 1

    v == nil
    // CHECK-NEXT: cannot compare non-optional type with optional type for '==' operator.
    return 100
}

func fn2(v int?) int {
    if nil != v {
        return 1
    } else {
        return 0
    }

    if nil != v { return 1 }

    v + 1
    // CHECK-NEXT: optional type cannot be used with '+' operator when value is nil.

    nil != v

    return 100
}

func fn3(v int?, v2 int?) int {
    if v == nil {
        if nil == v2 {
            return 1
        }

        return v2
    }

    return v
}

func fn4(v int?, v2 int?) int {
    if v == nil {
        return 0
    } else {
        if nil == v2 {
            return 1
        }

        return v2 + v
    }
}

// CHECK-NOT: {{.}}
