// RUN: ! koalac %s 2>&1 | filecheck %s

// `{:}` takes its type only from an expected dict[K, V]. Another type gives it nothing, and a
// non-empty map must match the expected type.

func take_dict(items dict[str, int]) {}

func take_list(items list[int]) {}

func return_list() list[int] {
    return {:}
    // CHECK: test_empty_map_errors.kl:11:{{.*}}
}

func return_dict() dict[str, int] {
    return {1: 2}
    // CHECK: test_empty_map_errors.kl:16:{{.*}}
}

func main() {
    take_list({:})
    // CHECK: test_empty_map_errors.kl:21:{{.*}}

    take_dict({1: 2})
    // CHECK: test_empty_map_errors.kl:24:{{.*}}

    let a list[int] = {:}
    // CHECK: test_empty_map_errors.kl:27:{{.*}}

    let b dict[str, int] = {1: 2}
    // CHECK: test_empty_map_errors.kl:30:{{.*}}

    var c = [1]
    c = {:}
    // CHECK: test_empty_map_errors.kl:34:{{.*}}

    var d = {"x": 1}
    d = {1: 2}
    // CHECK: test_empty_map_errors.kl:38:{{.*}}
}
