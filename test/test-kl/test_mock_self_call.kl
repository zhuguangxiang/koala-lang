// RUN: ! koalac %s 2>&1 | filecheck %s
// A stub must not reference its own target (call or value load): it would recurse.

import "std/os"
import "test_pkg/mock_calc_dep"

@mock("os.getenv")
func getenv_stub(key str) str? {
    return os.getenv(key)
}
// CHECK: @mock stub 'getenv_stub' cannot call or reference its own target 'std/os::getenv'

@mock("mock_calc_dep.Calc.compute")
func compute_stub(c mock_calc_dep.Calc, x int) int {
    return c.compute(x)
}
// CHECK: @mock stub 'compute_stub' cannot call or reference its own target 'test_pkg/mock_calc_dep::Calc::compute'

@mock("mock_calc_dep.env_or")
func env_or_stub(key str, dfl str) str {
    let f = mock_calc_dep.env_or
    return f(key, dfl)
}
// CHECK: @mock stub 'env_or_stub' cannot call or reference its own target 'test_pkg/mock_calc_dep::env_or'