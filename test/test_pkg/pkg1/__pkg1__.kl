
// pub let v = 100
// pub var v2 = v + 1
// let v3 = "hello"
// var v4 = "world"

pub func hello() {
    print("Hello from pkg1")
}

func world() {
    print("world")
}

pub class Point {
    let x int
    let y int

    pub func __init__(_x int, _y int) {
        x = _x
        y = _y
    }

    pub func show() {
        print("Point(", x, ", ", y, ")", sep="")
    }
}

pub class Foo {
    pub func bar() {
        print("bar")
    }
}

pub trait Fly {
    pub func fly() str
}

pub trait FlyG[T] {
    func fly() T
}

pub class BAR[T] {
    var value T

    pub func __init__(_value T) {
        value = _value
    }

    pub func set_value(_value T) {
        value = _value
    }

    pub func get_value() T {
        return value
    }
}

pub class Baz[T] : FlyG[T] {
    var value T

    pub func __init__(_value T) {
        print("Baz init with value:", _value)
        value = _value
    }

    pub func fly() T {
        return value
    }
}

pub trait Animal {
    func fly(name str, age int) str

    func swim(name str, age int) str
}

link "pkg1_native"

@native
pub func test_pkg_foo(a Animal) {}
