// Used by test-run/test_ext_instance_shared.kl and test-run/test_ext_trait_shared_itable.kl:
// loading this klc creates the instances list[bytes] and tuple(int, int) and
// their bases (e.g. Iterable[bytes], Sequence[int]) in this package's symbol
// table, besides the ones the importing module creates in its own.
pub class Chunks {
    pub func __init__() {}

    pub func all() list[bytes] {
        let res = list[bytes]()
        res.append("x".to_bytes())
        res.append("y".to_bytes())
        return res
    }
}

// a tuple(int, int) return: its bases include Sequence[int]
pub func pair() (int, int) { return (10, 20) }

