
@noline
pub func helper(x int) int { return x + 1 }
pub func entry(x int) int { return helper(x) }

pub trait Runner {
    func run(x int) int
}

pub class Svc : Runner {
    pub func __init__() {}
    @noline
    pub func base(x int) int { return x + 1 }
    pub func top(x int) int { return self.base(x) }
    pub func run(x int) int { return self.base(x) }
}

pub func free_uses_method(s Svc, x int) int { return s.base(x) }
pub func use_runner(r Runner, x int) int { return r.run(x) }
