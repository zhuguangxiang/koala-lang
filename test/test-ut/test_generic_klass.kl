// RUN: koala %s --test

trait Animal {
    func eat() str
}

trait Swim : Animal {
    func swim()
}

class Baz: Swim {

}

trait Fly[T] {
    func fly() T
}

trait Swim2[T] : Animal & Fly[T] {
    func swim() T
}

class Duck : Swim2[int] & Fly[int] {
    let v1 int
    let v2 int

    func __init__(_v1 int, _v2 int) {
        v1 = _v1
        v2 = _v2
    }

    func fly() int {
        return v2
    }

    func swim() int {
        return v1
    }

    func eat() str {
        return "Duck eat"
    }
}

import "std/ut"

@test
func test_normal_case() {
    let d Swim2[int] = Duck(42, 43)
    ut.assert_eq(d.eat(), "Duck eat")
    ut.assert_eq(d.fly(), 43)
    ut.assert_eq(d.swim(), 42)
}

@test_expect_panic("func 'Baz::eat' for 'Swim' is not implemented!")
func test_Swim_Baz_eat_not_impl() {
    let b Swim = Baz()
    b.eat()
}

@test_expect_panic("func 'Baz::swim' for 'Swim' is not implemented!")
func test_Swim_Baz_swim_not_impl() {
    let b Swim = Baz()
    b.swim()
}
