// RUN: koala %s --test

import "std/io"
import "std/ut"

@test
func test_bytesio_init_empty() {
    let bio = io.BytesIO()
    ut.assert_eq(bio.tell(), 0)
    ut.assert_eq(bio.size(), 0)
    ut.assert_eq(bio.capacity(), 8192)
    ut.assert_false(bio.is_closed())

    // reading an empty stream returns 0 (EOF)
    let buf = bytes(16)
    ut.assert_eq(bio.read(buf), 0)
}

@test
func test_bytesio_init_size() {
    let bio = io.BytesIO(16)
    ut.assert_eq(bio.capacity(), 16)
    ut.assert_eq(bio.size(), 0)
}

@test
func test_bytesio_from_bytes() {
    let bio = io.BytesIO.from_bytes("hello".to_bytes())
    ut.assert_eq(bio.size(), 5)
    ut.assert_eq(bio.capacity(), 5)
    ut.assert_eq(bio.tell(), 0)

    // from_bytes copies the data, the source is not referenced
    let buf = bytes(16)
    ut.assert_eq(bio.read(buf), 5)
    ut.assert_eq(buf.view(0, 5), b"hello")

    // EOF afterwards
    ut.assert_eq(bio.read(buf), 0)
}

@test
func test_bytesio_from_str() {
    let bio = io.BytesIO.from_str("koala")
    ut.assert_eq(bio.size(), 5)

    let buf = bytes(8)
    ut.assert_eq(bio.read(buf), 5)
    ut.assert_eq(buf.view(0, 5), b"koala")
}

@test
func test_bytesio_write_then_read() {
    let bio = io.BytesIO(64)
    ut.assert_eq(bio.write_str("Hello, "), 7)
    ut.assert_eq(bio.write_str("Koala!"), 6)
    ut.assert_eq(bio.size(), 13)
    ut.assert_eq(bio.tell(), 13)

    // rewind and read everything back
    ut.assert_eq(bio.seek(0, 0), 0)
    let buf = bytes(64)
    ut.assert_eq(bio.read(buf), 13)
    ut.assert_eq(buf.view(0, 13), b"Hello, Koala!")
    ut.assert_eq(bio.tell(), 13)

    // EOF
    ut.assert_eq(bio.read(buf), 0)
}

@test
func test_bytesio_partial_reads() {
    let bio = io.BytesIO.from_str("abcdefgh")

    let buf = bytes(3)
    ut.assert_eq(bio.read(buf), 3)
    ut.assert_eq(buf.view(0, 3), b"abc")
    ut.assert_eq(bio.read(buf), 3)
    ut.assert_eq(buf.view(0, 3), b"def")

    // short read: only 2 bytes left
    ut.assert_eq(bio.read(buf), 2)
    ut.assert_eq(buf.view(0, 2), b"gh")

    // EOF
    ut.assert_eq(bio.read(buf), 0)
}

@test
func test_bytesio_seek_tell() {
    let bio = io.BytesIO.from_str("abcdefgh") // end == 8

    // SEEK_SET
    ut.assert_eq(bio.seek(3, 0), 3)
    ut.assert_eq(bio.tell(), 3)

    // SEEK_CUR, forward and backward
    ut.assert_eq(bio.seek(2, 1), 5)
    ut.assert_eq(bio.seek(-4, 1), 1)

    // SEEK_END
    ut.assert_eq(bio.seek(0, 2), 8)
    ut.assert_eq(bio.seek(-6, 2), 2)

    // clamping: never below 0, never above end
    ut.assert_eq(bio.seek(-100, 1), 0)
    ut.assert_eq(bio.seek(100, 0), 8)

    // invalid whence -> -1, position unchanged
    ut.assert_eq(bio.seek(0, 7), -1)
    ut.assert_eq(bio.tell(), 8)
}

@test
func test_bytesio_overwrite() {
    let bio = io.BytesIO.from_str("hello world")

    // overwrite in the middle: end does not move
    ut.assert_eq(bio.seek(6, 0), 6)
    ut.assert_eq(bio.write_str("koala"), 5)
    ut.assert_eq(bio.size(), 11)
    ut.assert_eq(bio.getvalue(), b"hello koala")

    // truncate by rewriting from the start
    bio.seek(0, 0)
    bio.write_str("hi")
    ut.assert_eq(bio.size(), 11)
    ut.assert_eq(bio.getvalue().view(0, 2), b"hi")
}

@test
func test_bytesio_getvalue() {
    let bio = io.BytesIO(32)
    bio.write(b"abc")
    bio.write(b"def")

    // getvalue does not disturb the position
    ut.assert_eq(bio.tell(), 6)
    let v = bio.getvalue()
    ut.assert_eq(v.len(), 6)
    ut.assert_eq(v, b"abcdef")
    ut.assert_eq(bio.tell(), 6)

    // the result is an independent copy
    bio.write_str("g")
    ut.assert_eq(v.len(), 6)
    ut.assert_eq(bio.getvalue(), b"abcdefg")
}

@test
func test_bytesio_close() {
    let bio = io.BytesIO.from_str("data")
    ut.assert_false(bio.is_closed())

    bio.close()
    ut.assert(bio.is_closed())

    // closing twice is safe
    bio.close()

    // seek/tell report -1 after close
    ut.assert_eq(bio.seek(0, 0), -1)
    ut.assert_eq(bio.tell(), -1)
    ut.assert_eq(bio.size(), -1)
}

@test
func test_bytesio_as_reader() {
    // BytesIO passed as an io.Reader trait value, consumed via read()
    let r io.Reader = io.BytesIO.from_str("trait read")
    let buf = bytes(10)
    ut.assert_eq(r.read(buf), 10)
    ut.assert_eq(buf.view(0, 10), b"trait read")
    ut.assert_eq(r.read(buf), 0)
}

@test
func test_bytesio_with_bufreader() {
    // end-to-end: BytesIO -> BufReader with a small internal buffer,
    // so the reader must refill from BytesIO repeatedly
    let bio = io.BytesIO.from_str("hello buffered world")
    let br = io.BufReader(bio, 8)

    let buf = bytes(64)
    ut.assert_eq(br.read(buf), 8)
    ut.assert_eq(buf.view(0, 8), b"hello bu")
    ut.assert_eq(br.read(buf), 8)
    ut.assert_eq(buf.view(0, 8), b"ffered w")
    ut.assert_eq(br.read(buf), 4)
    ut.assert_eq(buf.view(0, 4), b"orld")
    ut.assert_eq(br.read(buf), 0)
}

@test_expect_panic("I/O operation on closed BytesIO")
func test_bytesio_read_after_close_should_panic() {
    let bio = io.BytesIO.from_str("data")
    bio.close()
    let buf = bytes(4)
    bio.read(buf)
}

@test_expect_panic("I/O operation on closed BytesIO")
func test_bytesio_write_after_close_should_panic() {
    let bio = io.BytesIO(8)
    bio.close()
    bio.write_str("x")
}

@test_expect_panic("I/O operation on closed BytesIO")
func test_bytesio_flush_after_close_should_panic() {
    let bio = io.BytesIO(8)
    bio.close()
    bio.flush()
}

@test_expect_panic("BytesIO write exceeds capacity")
func test_bytesio_write_overflow_should_panic() {
    let bio = io.BytesIO(4)
    bio.write_str("abcd")
    bio.write_str("e")
}

@test_expect_panic("BytesIO size must be >= 0")
func test_bytesio_negative_size_should_panic() {
    let bio = io.BytesIO(-1)
    bio.flush()
}
