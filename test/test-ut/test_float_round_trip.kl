// RUN: koala --test %s

// Unit tests for float64.to_str_exact(), the shortest round-trip formatter.
//
// to_str() keeps 16 significant digits. That is a readability trade-off: 16
// decimal digits cannot name every double (53 significand bits need 17), so the
// extremes lose a digit and the truncated text no longer parses back. DBL_MIN
// comes out as 2.225073858507201e-308, which is below DBL_MIN, so to_float() on
// that text underflows, str_to_float rejects ERANGE, and the call panics.
// to_str_exact() picks the fewest digits that still reproduce the exact same
// double, which is what serialization needs.
//
// Every round-trip assertion below uses assert_eq and never assert_float_close:
// the contract is bit-exact reproduction, and an epsilon comparison would hide
// precisely the drift this method exists to prevent.

import "std/ut"

// ---------------------------------------------------------------------------
// shortest, not longest: values that fit in 15 digits must not gain any
// ---------------------------------------------------------------------------

@test
func test_to_str_exact_keeps_common_values_short() {
    ut.assert_eq((3.5).to_str_exact(), "3.5")
    ut.assert_eq((0.5).to_str_exact(), "0.5")
    ut.assert_eq((1.0).to_str_exact(), "1")
    ut.assert_eq((0.0).to_str_exact(), "0")
    ut.assert_eq((-2.5).to_str_exact(), "-2.5")
    ut.assert_eq((1e30).to_str_exact(), "1e+30")

    // to_str() agrees on every one of these, so being exact costs nothing on
    // the values that dominate real output.
    ut.assert_eq((3.5).to_str(), "3.5")
    ut.assert_eq((1e30).to_str(), "1e+30")
}

// ---------------------------------------------------------------------------
// 15 digits are not always enough
// ---------------------------------------------------------------------------

@test
func test_to_str_exact_uses_16_digits_when_15_are_not_enough() {
    // 1/3 is 0.333...3148296162562473 in binary. Truncating it to 15 digits
    // parses back to a different double, so the loop goes one step further.
    let v = 1.0 / 3.0
    ut.assert_eq(v.to_str_exact(), "0.3333333333333333")
    ut.assert_eq(v.to_str_exact().to_float(), v)

    // to_str() lands on the same text here, which is the point: going exact
    // does not make ordinary values longer.
    ut.assert_eq(v.to_str(), "0.3333333333333333")
}

// ---------------------------------------------------------------------------
// 16 digits are not enough either: the extremes
// ---------------------------------------------------------------------------

@test
func test_to_str_exact_round_trips_dbl_min() {
    // The smallest normal double, and the case to_str() gets wrong: its 16
    // digits read 2.225073858507201e-308, which sits below DBL_MIN, so parsing
    // that text back underflows and to_float() panics.
    let v = 2.2250738585072014e-308
    let text = v.to_str_exact()
    ut.assert_eq(text, "2.2250738585072014e-308")
    ut.assert_eq(text.to_float(), v)
}

@test
func test_to_str_exact_round_trips_dbl_max() {
    // The largest finite double. to_str() rounds it up past DBL_MAX, so its
    // text overflows to infinity on the way back.
    let v = 1.7976931348623157e308
    let text = v.to_str_exact()
    ut.assert_eq(text, "1.7976931348623157e+308")
    ut.assert_eq(text.to_float(), v)
}

// ---------------------------------------------------------------------------
// the contrast with to_str(): one ulp apart must stay apart
// ---------------------------------------------------------------------------

@test
func test_to_str_exact_separates_values_that_to_str_merges() {
    // 0.1 + 0.2 and 0.3 are two different doubles one ulp apart. to_str() maps
    // both onto "0.3", so the difference disappears silently. to_str_exact()
    // keeps them distinguishable and each still round-trips to itself.
    let sum = 0.1 + 0.2
    let three = 0.3

    ut.assert_eq(sum.to_str(), "0.3")
    ut.assert_eq(three.to_str(), "0.3")

    ut.assert_eq(sum.to_str_exact(), "0.30000000000000004")
    ut.assert_eq(three.to_str_exact(), "0.3")
    ut.assert_ne(sum.to_str_exact(), three.to_str_exact())

    ut.assert_eq(sum.to_str_exact().to_float(), sum)
    ut.assert_eq(three.to_str_exact().to_float(), three)
}

// ---------------------------------------------------------------------------
// non-finite values must produce text, not abort
// ---------------------------------------------------------------------------

@test
func test_to_str_exact_non_finite() {
    // NaN never compares equal to itself, so the precision loop always runs to
    // the end and returns the last attempt's text. The sign bit of a NaN is
    // implementation defined, so only check that "nan" appears in it. Note that
    // this text cannot be fed back through to_float(): str_to_float rejects
    // anything non-finite, so there is no round trip to assert here.
    let nan_text = (0.0 / 0.0).to_str_exact()
    ut.assert_true(nan_text.index("nan") != -1, "expected nan text")

    // Infinity compares equal on the very first attempt.
    ut.assert_eq((1e308 * 10.0).to_str_exact(), "inf")
    ut.assert_eq((-1e308 * 10.0).to_str_exact(), "-inf")
}

// ---------------------------------------------------------------------------
// round trip across a spread of magnitudes
// ---------------------------------------------------------------------------

@test
func test_to_str_exact_round_trips_all_magnitudes() {
    for v in [0.1, 0.2, 0.3, 1.0 / 3.0, 3.141592653589793, 2.718281828459045,
              1e-5, 1e-300, 1e30, 1e300, 123456789.123456789] {
        ut.assert_eq(v.to_str_exact().to_float(), v)
    }
}
