// RUN: koala --test %s

func test_i32_to_i32(n int32) int32 { return n }

// Lossless signed widening: no explicit cast needed

func test_i32_to_i64(n int32) int64 { return n }

// Explicit conversion required:
//
// signed narrowing cannot be implicit.

func test_i32_to_i8(n int32) int8 { return int8(n) }

func test_i32_to_i16(n int32) int16 { return int16(n) }

// Explicit conversion required:
//
// signed and unsigned types cannot be implicitly converted.

func test_i32_to_u8(n int32) uint8 { return uint8(n) }

func test_i32_to_u16(n int32) uint16 { return uint16(n) }

func test_i32_to_u32(n int32) uint32 { return uint32(n) }

func test_i32_to_u64(n int32) uint64 { return uint64(n) }

// Arithmetic promotes int32 to int64 first: the result type is always `int`,
// so products that overflow int32 stay exact.

func test_i32_neg(n int32) int { return -n }

func test_i32_add_i8(n int32, m int8) int { return n + m }

func test_i32_add_i16(n int32, m int16) int { return n + m }

func test_i32_add_i32(n int32, m int32) int { return n + m }

func test_i32_sub_i64(n int32, m int64) int { return n - m }

func test_i32_mul_i32(n int32, m int32) int { return n * m }

func test_i32_div_i64(n int32, m int64) int { return n / m }

// A small unsigned operand also promotes to int64, so mixing int32 with
// uint8/uint16/uint32 stays in the signed domain.

func test_i32_mod_u8(n int32, m uint8) int { return n % m }

func test_i32_add_u16(n int32, m uint16) int { return n + m }

func test_i32_add_u32(n int32, m uint32) int { return n + m }

// uint64 cannot implicitly mix with a signed type: explicit int64 cast required.

func test_i32_add_u64(n int32, m uint64) int { return n + int64(m) }

import "std/ut"

// -----------------------------------------------------------------------------
// Conversion tests
// -----------------------------------------------------------------------------

@test
func test_ut_i32_to_i32() {
    ut.assert(test_i32_to_i32(INT32_MIN) == INT32_MIN)
    ut.assert(test_i32_to_i32(-1) == -1)
    ut.assert(test_i32_to_i32(0) == 0)
    ut.assert(test_i32_to_i32(1) == 1)
    ut.assert(test_i32_to_i32(INT32_MAX) == INT32_MAX)
}

@test
func test_ut_i32_to_i64() {
    ut.assert(test_i32_to_i64(INT32_MIN) == INT32_MIN)
    ut.assert(test_i32_to_i64(-1) == -1)
    ut.assert(test_i32_to_i64(0) == 0)
    ut.assert(test_i32_to_i64(1) == 1)
    ut.assert(test_i32_to_i64(INT32_MAX) == INT32_MAX)
}

// Explicit int32 -> int8 / int16: the low bits are kept and reinterpreted.

@test
func test_ut_i32_to_i8() {
    ut.assert(test_i32_to_i8(INT32_MIN) == 0)
    ut.assert(test_i32_to_i8(-256) == 0)
    ut.assert(test_i32_to_i8(-1) == -1)
    ut.assert(test_i32_to_i8(0) == 0)
    ut.assert(test_i32_to_i8(1) == 1)
    ut.assert(test_i32_to_i8(INT8_MAX) == INT8_MAX)
    ut.assert(test_i32_to_i8(128) == INT8_MIN)
    ut.assert(test_i32_to_i8(255) == -1)
    ut.assert(test_i32_to_i8(INT32_MAX) == -1)
}

@test
func test_ut_i32_to_i16() {
    ut.assert(test_i32_to_i16(INT32_MIN) == 0)
    ut.assert(test_i32_to_i16(-65536) == 0)
    ut.assert(test_i32_to_i16(-1) == -1)
    ut.assert(test_i32_to_i16(0) == 0)
    ut.assert(test_i32_to_i16(INT16_MAX) == INT16_MAX)
    ut.assert(test_i32_to_i16(32768) == INT16_MIN)
    ut.assert(test_i32_to_i16(INT32_MAX) == -1)
}

@test
func test_ut_i32_to_u8() {
    ut.assert(test_i32_to_u8(INT32_MIN) == 0)
    ut.assert(test_i32_to_u8(-1) == UINT8_MAX)
    ut.assert(test_i32_to_u8(0) == 0)
    ut.assert(test_i32_to_u8(UINT8_MAX) == UINT8_MAX)
    ut.assert(test_i32_to_u8(256) == 0)
    ut.assert(test_i32_to_u8(INT32_MAX) == UINT8_MAX)
}

@test
func test_ut_i32_to_u16() {
    ut.assert(test_i32_to_u16(INT32_MIN) == 0)
    ut.assert(test_i32_to_u16(-1) == UINT16_MAX)
    ut.assert(test_i32_to_u16(0) == 0)
    ut.assert(test_i32_to_u16(UINT16_MAX) == UINT16_MAX)
    ut.assert(test_i32_to_u16(65536) == 0)
    ut.assert(test_i32_to_u16(INT32_MAX) == UINT16_MAX)
}

@test
func test_ut_i32_to_u32() {
    ut.assert(test_i32_to_u32(INT32_MIN) == 2147483648)
    ut.assert(test_i32_to_u32(-1) == UINT32_MAX)
    ut.assert(test_i32_to_u32(0) == 0)
    ut.assert(test_i32_to_u32(1) == 1)
    ut.assert(test_i32_to_u32(INT32_MAX) == INT32_MAX)
}

@test
func test_ut_i32_to_u64() {
    ut.assert_uint_eq(test_i32_to_u64(INT32_MIN), 18446744071562067968)
    ut.assert_uint_eq(test_i32_to_u64(-1), UINT64_MAX)
    ut.assert_uint_eq(test_i32_to_u64(0), 0)
    ut.assert_uint_eq(test_i32_to_u64(1), 1)
    ut.assert_uint_eq(test_i32_to_u64(INT32_MAX), INT32_MAX)
}

// -----------------------------------------------------------------------------
// Unary minus: promoted to int64, so INT32_MIN negates without overflow
// -----------------------------------------------------------------------------

@test
func test_ut_i32_neg() {
    ut.assert(test_i32_neg(INT32_MIN) == 2147483648)
    ut.assert(test_i32_neg(-1) == 1)
    ut.assert(test_i32_neg(0) == 0)
    ut.assert(test_i32_neg(1) == -1)
    ut.assert(test_i32_neg(INT32_MAX) == -INT32_MAX)
}

// -----------------------------------------------------------------------------
// int32 in the signed domain: result type is `int`
// -----------------------------------------------------------------------------

@test
func test_ut_i32_add_i8() {
    ut.assert(test_i32_add_i8(0, 0) == 0)
    ut.assert(test_i32_add_i8(-1, 1) == 0)
    ut.assert(test_i32_add_i8(INT32_MAX, 1) == 2147483648)
    ut.assert(test_i32_add_i8(INT32_MIN, -1) == -2147483649)
    ut.assert(test_i32_add_i8(INT32_MAX, INT8_MAX) == 2147483774)
    ut.assert(test_i32_add_i8(INT32_MIN, INT8_MIN) == -2147483776)
}

@test
func test_ut_i32_add_i16() {
    ut.assert(test_i32_add_i16(0, 0) == 0)
    ut.assert(test_i32_add_i16(1000, 2000) == 3000)
    ut.assert(test_i32_add_i16(INT32_MAX, INT16_MAX) == 2147516414)
    ut.assert(test_i32_add_i16(INT32_MIN, INT16_MIN) == -2147516416)
    ut.assert(test_i32_add_i16(INT32_MAX, INT16_MIN) == 2147450879)
}

@test
func test_ut_i32_add_i32() {
    ut.assert(test_i32_add_i32(0, 0) == 0)
    ut.assert(test_i32_add_i32(-1, -1) == -2)
    ut.assert(test_i32_add_i32(INT32_MAX, INT32_MAX) == 4294967294)
    ut.assert(test_i32_add_i32(INT32_MIN, INT32_MIN) == -4294967296)
    ut.assert(test_i32_add_i32(INT32_MAX, INT32_MIN) == -1)
}

@test
func test_ut_i32_sub_i64() {
    ut.assert(test_i32_sub_i64(0, 0) == 0)
    ut.assert(test_i32_sub_i64(1, 1) == 0)
    ut.assert(test_i32_sub_i64(-1, 1) == -2)
    ut.assert(test_i32_sub_i64(INT32_MAX, 1) == 2147483646)
    ut.assert(test_i32_sub_i64(INT32_MIN, 1) == -2147483649)
    ut.assert(test_i32_sub_i64(INT32_MAX, INT64_MAX) == -9223372034707292160)
    ut.assert(test_i32_sub_i64(INT32_MIN, INT64_MIN) == 9223372034707292160)
}

@test
func test_ut_i32_mul_i32() {
    ut.assert(test_i32_mul_i32(0, INT32_MAX) == 0)
    ut.assert(test_i32_mul_i32(1, INT32_MAX) == INT32_MAX)
    ut.assert(test_i32_mul_i32(-1, INT32_MAX) == -INT32_MAX)
    ut.assert(test_i32_mul_i32(2, 3) == 6)
    ut.assert(test_i32_mul_i32(-2, -3) == 6)

    // Products far beyond the int32 range stay exact in int64.
    ut.assert(test_i32_mul_i32(INT32_MAX, INT32_MAX) == 4611686014132420609)
    ut.assert(test_i32_mul_i32(INT32_MIN, INT32_MIN) == 4611686018427387904)
    ut.assert(test_i32_mul_i32(INT32_MIN, INT32_MAX) == -4611686016279904256)
}

@test
func test_ut_i32_div_i64() {
    ut.assert(test_i32_div_i64(0, 1) == 0)
    ut.assert(test_i32_div_i64(1, 1) == 1)
    ut.assert(test_i32_div_i64(-1, 1) == -1)
    ut.assert(test_i32_div_i64(100, 10) == 10)
    ut.assert(test_i32_div_i64(-100, 10) == -10)

    // Truncation toward zero.
    ut.assert(test_i32_div_i64(7, 2) == 3)
    ut.assert(test_i32_div_i64(-7, 2) == -3)
    ut.assert(test_i32_div_i64(INT32_MAX, 2) == 1073741823)
    ut.assert(test_i32_div_i64(INT32_MIN, 2) == -1073741824)

    // INT32_MIN / -1 does not overflow once promoted to int64.
    ut.assert(test_i32_div_i64(INT32_MIN, -1) == 2147483648)
    ut.assert(test_i32_div_i64(INT32_MAX, INT64_MAX) == 0)
    ut.assert(test_i32_div_i64(INT32_MIN, INT64_MIN) == 0)
}

// -----------------------------------------------------------------------------
// int32 mixed with small unsigned types: still the signed domain
// -----------------------------------------------------------------------------

@test
func test_ut_i32_mod_u8() {
    ut.assert(test_i32_mod_u8(0, 1) == 0)
    ut.assert(test_i32_mod_u8(7, 3) == 1)
    ut.assert(test_i32_mod_u8(-7, 3) == -1)
    ut.assert(test_i32_mod_u8(100, 10) == 0)
    ut.assert(test_i32_mod_u8(-100, 10) == 0)
    ut.assert(test_i32_mod_u8(-1, 2) == -1)
    ut.assert(test_i32_mod_u8(127, 128) == 127)
    ut.assert(test_i32_mod_u8(INT32_MAX, UINT8_MAX) == 127)
    ut.assert(test_i32_mod_u8(INT32_MIN, UINT8_MAX) == -128)
}

@test
func test_ut_i32_add_u16() {
    ut.assert(test_i32_add_u16(0, 0) == 0)
    ut.assert(test_i32_add_u16(1, 1) == 2)
    ut.assert(test_i32_add_u16(-1, 1) == 0)
    ut.assert(test_i32_add_u16(-1, UINT16_MAX) == 65534)
    ut.assert(test_i32_add_u16(INT32_MAX, UINT16_MAX) == 2147549182)
    ut.assert(test_i32_add_u16(INT32_MIN, UINT16_MAX) == -2147418113)
}

@test
func test_ut_i32_add_u32() {
    ut.assert(test_i32_add_u32(0, 0) == 0)
    ut.assert(test_i32_add_u32(1, 1) == 2)
    ut.assert(test_i32_add_u32(-1, 1) == 0)
    ut.assert(test_i32_add_u32(-1, UINT32_MAX) == 4294967294)
    ut.assert(test_i32_add_u32(INT32_MAX, UINT32_MAX) == 6442450942)
    ut.assert(test_i32_add_u32(INT32_MIN, UINT32_MAX) == INT32_MAX)
}

// -----------------------------------------------------------------------------
// int32 with uint64: only via an explicit int64 cast
// -----------------------------------------------------------------------------

@test
func test_ut_i32_add_u64() {
    ut.assert(test_i32_add_u64(0, 0) == 0)
    ut.assert(test_i32_add_u64(1, 1) == 2)
    ut.assert(test_i32_add_u64(-1, 1) == 0)
    ut.assert(test_i32_add_u64(INT32_MIN, 0) == INT32_MIN)
    ut.assert(test_i32_add_u64(INT32_MAX, 0) == INT32_MAX)

    // int64(UINT64_MAX) is -1, so the sum stays in the signed domain.
    ut.assert(test_i32_add_u64(0, UINT64_MAX) == -1)
    ut.assert(test_i32_add_u64(1, UINT64_MAX) == 0)
    ut.assert(test_i32_add_u64(INT32_MIN, UINT64_MAX) == -2147483649)

    // int64(2^63) is INT64_MIN.
    ut.assert(test_i32_add_u64(1, INT64_MAX) == INT64_MIN)
    ut.assert(test_i32_add_u64(-1, INT64_MAX) == 9223372036854775806)
    ut.assert(test_i32_add_u64(INT32_MAX, 9223372036854775808) == -9223372034707292161)
}

// -----------------------------------------------------------------------------
// Two's complement round trip
// -----------------------------------------------------------------------------

func i32_to_u32(v int32) uint32 {
    return uint32(v)
}

func u32_to_i32(v uint32) int32 {
    return int32(v)
}

@test
func test_ut_i32_twos_complement() {
    ut.assert(i32_to_u32(-1) == UINT32_MAX)
    ut.assert(i32_to_u32(-2) == 4294967294)
    ut.assert(i32_to_u32(INT32_MIN) == 2147483648)

    ut.assert(u32_to_i32(UINT32_MAX) == -1)
    ut.assert(u32_to_i32(4294967294) == -2)
    ut.assert(u32_to_i32(2147483648) == INT32_MIN)
}
