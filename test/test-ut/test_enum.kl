// RUN: koala --test %s
// Skipped until irgen folds enum values into int64 constants.

import "std/ut"

enum Proto {
    ICMP,
    TCP = 6,
    UDP = 17,
    MY_CONST_1,
}

enum Sign {
    NEG = -1,
    ZERO,
    POS,
}

enum One { ONLY = 42 }

enum Trailing {
    P,
    Q,
}

enum Inline { R, S }

enum Lines {
    L0
    L1
}

var g_proto Proto = Proto.TCP
let g_const Proto = Proto.UDP

func echo(p Proto) Proto {
    return p
}

func to_int(i int) int {
    return i
}

func is_tcp(p Proto) bool {
    return p == Proto.TCP
}

func next_proto(p Proto) Proto {
    if (p == Proto.ICMP) {
        return Proto.TCP
    }
    if (p == Proto.TCP) {
        return 17
    }
    return Proto.ICMP
}

class Packet {
    pub var proto Proto
    pub var len int

    pub func __init__(p Proto, n int) {
        proto = p
        len = n
    }

    pub func is_udp() bool {
        return proto == Proto.UDP
    }
}

@test
func test_member_values() {
    ut.assert_int_eq(Proto.ICMP, 0)
    ut.assert_int_eq(Proto.TCP, 6)
    ut.assert_int_eq(Proto.UDP, 17)
    ut.assert_int_eq(Proto.MY_CONST_1, 18)
    ut.assert_int_eq(Sign.NEG, -1)
    ut.assert_int_eq(Sign.ZERO, 0)
    ut.assert_int_eq(Sign.POS, 1)
    ut.assert_int_eq(One.ONLY, 42)
    ut.assert_int_eq(Trailing.Q, 1)
    ut.assert_int_eq(Inline.S, 1)
    ut.assert_int_eq(Lines.L1, 1)
}

@test
func test_same_enum_assign() {
    let a Proto = Proto.ICMP
    let b Proto = Proto.TCP
    var c Proto = a
    ut.assert_true(c == Proto.ICMP)
    c = b
    ut.assert_true(c == Proto.TCP)
    c = Proto.UDP
    ut.assert_true(c == Proto.UDP)
}

@test
func test_enum_to_int() {
    let i int = Proto.TCP
    ut.assert_int_eq(i, 6)
    let j int64 = Proto.UDP
    ut.assert_int_eq(j, 17)
    ut.assert_int_eq(to_int(Proto.UDP), 17)
    var k int = 0
    k = Proto.TCP
    ut.assert_int_eq(k, 6)
}

@test
func test_literal_to_enum() {
    let a Proto = 6
    ut.assert_true(a == Proto.TCP)
    var b Proto = Proto.ICMP
    b = 17
    ut.assert_true(b == Proto.UDP)
    b = 0
    ut.assert_true(b == Proto.ICMP)
    ut.assert_true(echo(18) == Proto.MY_CONST_1)
    let s Sign = -1
    ut.assert_true(s == Sign.NEG)
}

@test
func test_equality() {
    let a Proto = Proto.ICMP
    let b Proto = Proto.TCP
    ut.assert_true(a == a)
    ut.assert_false(a == b)
    ut.assert_true(a != b)
    ut.assert_false(a != a)
}

@test
func test_compare_with_int() {
    let a Proto = Proto.TCP
    var i int = 6
    ut.assert_true(a == 6)
    ut.assert_true(6 == a)
    ut.assert_true(a == i)
    ut.assert_true(i == a)
    ut.assert_true(a != 7)
    ut.assert_false(a != i)
}

@test
func test_function_arg_and_return() {
    let a Proto = Proto.TCP
    ut.assert_true(echo(a) == Proto.TCP)
    ut.assert_true(echo(Proto.UDP) == Proto.UDP)
    ut.assert_true(echo(6) == Proto.TCP)
    ut.assert_true(is_tcp(a))
    ut.assert_true(is_tcp(6))
    ut.assert_false(is_tcp(Proto.UDP))
    ut.assert_true(next_proto(Proto.ICMP) == Proto.TCP)
    ut.assert_true(next_proto(Proto.TCP) == Proto.UDP)
    ut.assert_true(next_proto(Proto.UDP) == Proto.ICMP)
}

@test
func test_control_flow() {
    var p Proto = Proto.ICMP
    var steps = 0
    while p != Proto.ICMP || steps == 0 {
        p = next_proto(p)
        steps += 1
    }
    ut.assert_int_eq(steps, 3)

    if (p == Proto.ICMP) {
        steps = 100
    } else {
        steps = 200
    }
    ut.assert_int_eq(steps, 100)

    // ordering goes through the underlying int64
    let r Proto = Proto.UDP
    let iv int = r
    var hit = 0
    if (iv >= 6 && iv <= 17) {
        hit = 1
    }
    ut.assert_int_eq(hit, 1)
}

@test
func test_global() {
    ut.assert_true(g_proto == Proto.TCP)
    ut.assert_true(g_const == Proto.UDP)
    g_proto = Proto.ICMP
    ut.assert_true(g_proto == Proto.ICMP)
    g_proto = 17
    ut.assert_true(g_proto == Proto.UDP)
    g_proto = Proto.TCP
}

@test
func test_class_field() {
    let p = Packet(Proto.UDP, 10)
    ut.assert_true(p.proto == Proto.UDP)
    ut.assert_true(p.is_udp())
    p.proto = Proto.TCP
    ut.assert_false(p.is_udp())
    p.proto = 17
    ut.assert_true(p.is_udp())
}

@test
func test_multiple_enums() {
    let a Proto = Proto.TCP
    let s Sign = Sign.POS
    ut.assert_true(a != Proto.ICMP)
    ut.assert_true(s != Sign.NEG)
    ut.assert_true(s == 1)
    ut.assert_true(a == 6)
}

func enum_list_from_params(a Proto, b Proto) list[Proto] {
    return list[Proto](a, b)
}

func optional_enum_list_from_param(a Proto?) list[Proto?] {
    return list[Proto?](a)
}

func enum_generic_identity[T](value T) T {
    return value
}

@test
func test_enum_list_type_arg() {
    let values = enum_list_from_params(Proto.TCP, Proto.UDP)
    ut.assert_int_eq(values.len(), 2)
    ut.assert_true(values[0] == Proto.TCP)
    ut.assert_true(values[1] == Proto.UDP)

    let empty = list[Proto]()
    ut.assert_int_eq(empty.len(), 0)
    empty.append(Proto.ICMP)
    ut.assert_true(empty[0] == Proto.ICMP)
}

@test
func test_optional_enum_list_type_arg() {
    let values = optional_enum_list_from_param(Proto.TCP)
    ut.assert_int_eq(values.len(), 1)
    ut.assert_true(values[0]! == Proto.TCP)

    let absent = optional_enum_list_from_param(nil)
    ut.assert_true(absent[0] == nil)

    let empty = list[Proto?]()
    empty.append(nil)
    empty.append(Proto.UDP)
    ut.assert_true(empty[0] == nil)
    ut.assert_true(empty[1]! == Proto.UDP)
}

@test
func test_enum_function_type_arg() {
    let value = enum_generic_identity[Proto](Proto.UDP)
    ut.assert_true(value == Proto.UDP)
    let sign = enum_generic_identity[Sign](Sign.NEG)
    ut.assert_true(sign == Sign.NEG)
    let integer = enum_generic_identity[int](123)
    ut.assert_int_eq(integer, 123)
    let optional = enum_generic_identity[Proto?](Proto.TCP)
    ut.assert_true(optional! == Proto.TCP)
    let absent = enum_generic_identity[Proto?](nil)
    ut.assert_true(absent == nil)
}

func nested_enum_list(items list[Proto]) list[list[Proto]] {
    return list[list[Proto]](items)
}

func nested_enum_list_from_value(value Proto) list[list[Proto]] {
    return list[list[Proto]](list[Proto](value))
}

func nested_optional_enum_list(items list[Proto?]) list[list[Proto?]] {
    return list[list[Proto?]](items)
}

func optional_inner_enum_list(items list[Proto]?) list[list[Proto]?] {
    return list[list[Proto]?](items)
}

func enum_tuple_list(a Proto, b Proto?) list[(Proto, Proto?)] {
    return list[(Proto, Proto?)]((a, b))
}

@test
func test_nested_enum_list() {
    let items = enum_list_from_params(Proto.TCP, Proto.UDP)
    let nested = nested_enum_list(items)
    ut.assert_int_eq(nested.len(), 1)
    ut.assert_int_eq(nested[0].len(), 2)
    ut.assert_true(nested[0][0] == Proto.TCP)
    ut.assert_true(nested[0][1] == Proto.UDP)
    items.append(Proto.ICMP)
    ut.assert_int_eq(nested[0].len(), 3)
    ut.assert_true(nested[0][2] == Proto.ICMP)

    let direct = nested_enum_list_from_value(Proto.UDP)
    ut.assert_true(direct[0][0] == Proto.UDP)

    let empty = list[list[Proto]]()
    ut.assert_int_eq(empty.len(), 0)
    empty.append(items)
    ut.assert_true(empty[0][0] == Proto.TCP)
}

@test
func test_nested_optional_enum_list() {
    let present = nested_optional_enum_list(optional_enum_list_from_param(Proto.TCP))
    ut.assert_true(present[0][0]! == Proto.TCP)
    let absent = nested_optional_enum_list(optional_enum_list_from_param(nil))
    ut.assert_true(absent[0][0] == nil)

    let empty = list[list[Proto?]]()
    empty.append(optional_enum_list_from_param(nil))
    ut.assert_true(empty[0][0] == nil)
}

@test
func test_optional_inner_enum_list() {
    let present = optional_inner_enum_list(enum_list_from_params(Proto.TCP, Proto.UDP))
    let inner = present[0]!
    ut.assert_true(inner[0] == Proto.TCP)
    ut.assert_true(inner[1] == Proto.UDP)

    let absent = optional_inner_enum_list(nil)
    ut.assert_true(absent[0] == nil)

    let empty = list[list[Proto]?]()
    empty.append(nil)
    ut.assert_true(empty[0] == nil)
}

@test
func test_enum_tuple_type_arg() {
    let present = enum_tuple_list(Proto.TCP, Proto.UDP)
    let pair = present[0]
    ut.assert_true(pair[0] == Proto.TCP)
    ut.assert_true(pair[1]! == Proto.UDP)

    let absent = enum_tuple_list(Proto.ICMP, nil)
    let absent_pair = absent[0]
    ut.assert_true(absent_pair[0] == Proto.ICMP)
    ut.assert_true(absent_pair[1] == nil)

    let empty = list[(Proto, Proto?)]()
    empty.append((Proto.UDP, nil))
    let appended = empty[0]
    ut.assert_true(appended[0] == Proto.UDP)
    ut.assert_true(appended[1] == nil)
}
