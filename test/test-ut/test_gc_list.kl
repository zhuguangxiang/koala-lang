// RUN: koala --no-jit --test %s

import "std/gc"
import "std/ut"

func churn() {
    for i in range(20000) {
        let _x = "abc" + "def"
    }
}

func make(n int) list[str] {
    let l = list[str]()
    for i in range(n) {
        l.append("s" + "x")
    }
    return l
}

@test
func test_items_survive() {
    // runtime strings live only in the list, past several expansions
    let l = make(100)
    churn()
    gc.collect()
    ut.assert_eq(l.len(), 100)
    ut.assert_eq(l[0], "sx")
    ut.assert_eq(l[99], "sx")
}

func tail_view() list[str] {
    let l = list[str]()
    l.append("a" + "1")
    l.append("b" + "2")
    l.append("c" + "3")
    return l[1:]
}

@test
func test_view_keeps_array_alive() {
    // the source list is gone; the view keeps the shared array and its items
    let v = tail_view()
    churn()
    gc.collect()
    ut.assert_eq(v.len(), 2)
    ut.assert_eq(v[0], "b2")
    ut.assert_eq(v[1], "c3")
}

@test
func test_view_append_does_not_clobber_source() {
    let l = list[int]()
    l.extend([1, 2, 3, 4])
    let v = l[0:2]
    v.append(9)
    ut.assert_eq(l[2], 3)
    ut.assert_eq(v.len(), 3)
    ut.assert_eq(v[2], 9)
}

@test
func test_view_after_head_pop() {
    let l = list[int]()
    l.extend([1, 2, 3, 4])
    l.pop(0)
    let v = l[1:3]
    ut.assert_eq(v[0], 3)
    ut.assert_eq(v[1], 4)
    v.insert(0, 7)
    ut.assert_eq(v[0], 7)
    ut.assert_eq(l[1], 3)
}

@test
func test_clear_detaches_view() {
    let l = list[int]()
    l.extend([1, 2, 3])
    let v = l[0:2]
    l.clear()
    l.append(8)
    ut.assert_eq(v[0], 1)
    ut.assert_eq(l[0], 8)
}

@test
func test_extend_self() {
    let l = list[int]()
    l.extend([1, 2, 3, 4])
    l.extend(l)
    ut.assert_eq(l.len(), 8)
    ut.assert_eq(l[7], 4)
}

@test
func test_step_slice_survives() {
    let l = make(10)
    let s = l[::2]
    l.clear()
    churn()
    gc.collect()
    ut.assert_eq(s.len(), 5)
    ut.assert_eq(s[4], "sx")
}
