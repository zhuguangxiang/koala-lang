// RUN: koala --test %s

import "std/fs"
import "std/os"
import "std/ut"

func path_segment_is_str(segment fs.Path | str) bool {
    return segment is str
}

func path_segment_is_path(segment fs.Path | str) bool {
    return segment is fs.Path
}

func path_segment_if_is_str(segment fs.Path | str) bool {
    if segment is str {
        return true
    } else {
        return false
    }
}

func path_segment_as_str(segment fs.Path | str) str {
    return (segment as str)!
}

func path_segment_as_path(segment fs.Path | str) fs.Path {
    return (segment as fs.Path)!
}

class PathSegmentCheck {
    func is_str(segment fs.Path | str) bool { return segment is str }
}

@test
func test_path_init_and_to_str() {
    let p = fs.Path("/a/b/file.kl")
    ut.assert_eq(p.to_str(), "/a/b/file.kl")
}

@test
func test_path_name() {
    // Basic structural name extraction
    ut.assert_eq(fs.Path("/a/b/file.kl").name(), "file.kl")
    ut.assert_eq(fs.Path("file.kl").name(), "file.kl")

    // Boundary check for paths ending with separators
    ut.assert_eq(fs.Path("/a/b/").name(), "b")
    ut.assert_eq(fs.Path("/a/b\\\\").name(), "b")

    // Root and boundary configurations
    ut.assert_eq(fs.Path("/").name(), "")
    ut.assert_eq(fs.Path("").name(), "")
}

@test
func test_path_ext() {
    ut.assert_eq(fs.Path("/a/b/file.kl").ext(), "kl")
    ut.assert_eq(fs.Path("archive.tar.gz").ext(), "gz")

    // Edge cases for no extension and hidden system configuration files
    ut.assert_eq(fs.Path("/a/b/makefile").ext(), "")
    ut.assert_eq(fs.Path(".gitignore").ext(), "")
}

@test
func test_path_stem() {
    ut.assert_eq(fs.Path("/a/b/file.kl").stem(), "file")
    ut.assert_eq(fs.Path("archive.tar.gz").stem(), "archive.tar")
    ut.assert_eq(fs.Path("/a/b/makefile").stem(), "makefile")
    ut.assert_eq(fs.Path(".gitignore").stem(), ".gitignore")
}

@test
func test_path_parent() {
    ut.assert_eq(fs.Path("/a/b/file.kl").parent().to_str(), "/a/b")

    // Immediate children of root directory
    ut.assert_eq(fs.Path("/config.toml").parent().to_str(), "/")

    // Trailing slash parsing for parent directory tracking
    ut.assert_eq(fs.Path("/a/b/").parent().to_str(), "/a")

    // Absolute bounds and empty state evaluation
    ut.assert_eq(fs.Path("main.kl").parent().to_str(), ".")
    ut.assert_eq(fs.Path("/").parent().to_str(), "/")
}

@test
func test_path_is_absolute() {
    // POSIX absolute standards
    ut.assert_eq(fs.Path("/a/b").is_absolute(), true)

    // Windows absolute standards
    ut.assert_eq(fs.Path("C:\\a\\b").is_absolute(), true)
    ut.assert_eq(fs.Path("d:/a/b").is_absolute(), true)

    // Relative structures
    ut.assert_eq(fs.Path("a/b").is_absolute(), false)
    ut.assert_eq(fs.Path("").is_absolute(), false)
}

@test
func test_path_normalize() {
    // Redundant sequence cleaning
    ut.assert_eq(fs.Path("a//b").normalize().to_str(), "a/b")
    ut.assert_eq(fs.Path("a/./b").normalize().to_str(), "a/b")

    // Parent boundary stack flattening
    ut.assert_eq(fs.Path("a/b/../c").normalize().to_str(), "a/c")
    ut.assert_eq(fs.Path("/a/b/../../c").normalize().to_str(), "/c")

    // Relative underflow boundaries
    ut.assert_eq(fs.Path("a/../../b").normalize().to_str(), "../b")
    ut.assert_eq(fs.Path("").normalize().to_str(), ".")

    // Spaces belong to the names and are kept.
    ut.assert_eq(fs.Path("a/ x /b").normalize().to_str(), "a/ x /b")
    ut.assert_eq(fs.Path(" /a").normalize().to_str(), " /a")
    ut.assert_eq(fs.Path("dir").cat(" x").to_str(), "dir/ x")
}

@test
func test_path_equality() {
    let p1 = fs.Path("/a/b")
    let p2 = fs.Path("/a/b")
    let p3 = fs.Path("/a/c")

    ut.assert_eq(p1 == p2, true)
    ut.assert_eq(p1 != p3, true)
    ut.assert_ne(p1, p3)
}

@test
func test_path_cat_polymorphism() {
    ut.assert_eq(path_segment_is_str("def"), true)
    ut.assert_eq(path_segment_is_path("def"), false)
    ut.assert_eq(path_segment_is_str(fs.Path("def")), false)
    ut.assert_eq(path_segment_is_path(fs.Path("def")), true)
    ut.assert_eq(path_segment_if_is_str("def"), true)
    ut.assert_eq(path_segment_if_is_str(fs.Path("def")), false)
    ut.assert_eq(path_segment_as_str("def"), "def")
    ut.assert_eq(path_segment_as_path(fs.Path("def")).to_str(), "def")
    ut.assert_eq(PathSegmentCheck().is_str("def"), true)

    let base = fs.Path("abc")

    // String segments and Path segments are both accepted by the union parameter.
    let p_str = base.cat("def").cat("ok")
    ut.assert_eq(p_str.to_str(), "abc/def/ok")

    let sub_path = fs.Path("sub/dir")
    let p_path = base.cat(sub_path)
    ut.assert_eq(p_path.to_str(), "abc/sub/dir")

    // Existing separators are normalized rather than duplicated.
    let p_slash1 = fs.Path("abc/").cat("/def")
    let p_slash2 = fs.Path("abc").cat("/def")
    ut.assert_eq(p_slash1.to_str(), "abc/def")
    ut.assert_eq(p_slash2.to_str(), "abc/def")

    // Appending an empty segment leaves the path unchanged.
    ut.assert_eq(base.cat("").to_str(), "abc")
}

@test
func test_path_with_fs_functions() {
    // The fs top-level functions accept a Path where a path string is expected.
    let p = fs.Path("/tmp/kl_fs_path_probe.txt")

    ut.assert(fs.write_str(p, "path arg"))

    // `exists` is native and reads a `Path` argument directly (no str shim).
    ut.assert(fs.exists(p))
    ut.assert_false(fs.exists(fs.Path("/tmp/kl_fs_path_no_such_file")))

    let buf = bytes(64)
    ut.assert_eq(fs.read_bytes(p, buf), 8)
    ut.assert_eq(buf.view(0, 8).to_str(), "path arg")

    ut.assert(fs.remove(p))
    ut.assert_false(fs.remove(p)) // the file is already gone
    ut.assert_false(fs.exists(p)) // gone: native `exists` with a `Path`
}

@test
func test_os_getcwd_chdir() {
    // getcwd returns the real, absolute working directory.
    let orig = os.getcwd()
    ut.assert(orig.len() > 0)
    ut.assert(orig.starts_with("/"))

    // chdir into a fresh directory; getcwd reflects the move.
    // The name suffix is checked rather than the full path, since a
    // symlinked prefix (e.g. /tmp -> /private/tmp) is resolved by getcwd.
    ut.assert(fs.mkdir("/tmp/kl_fs_path_cwd_dir"))
    ut.assert(os.chdir("/tmp/kl_fs_path_cwd_dir"))
    ut.assert(os.getcwd().ends_with("kl_fs_path_cwd_dir"))

    // Restore the original cwd so later tests are unaffected.
    ut.assert(os.chdir(orig))
    ut.assert_eq(os.getcwd(), orig)

    // Entering a missing directory fails.
    ut.assert_false(os.chdir("/tmp/kl_fs_path_no_such_dir"))

    ut.assert(fs.rmdir("/tmp/kl_fs_path_cwd_dir"))
}

@test
func test_path_absolute() {
    // An absolute path only normalizes.
    ut.assert_eq(fs.Path("/a/b/../c").absolute().to_str(), "/a/c")

    // A relative path resolves against the real cwd (getcwd), not PWD.
    let cwd = os.getcwd()
    let abs = fs.Path("sub/file.kl").absolute().to_str()
    ut.assert(abs.starts_with(cwd))
    ut.assert(abs.ends_with("sub/file.kl"))
}

@test
func test_path_parts() {
    // list == compares identity, so the parts are joined for the checks
    ut.assert_eq("|".join(fs.Path("/usr//lib/./x.so").parts()), "/|usr|lib|x.so")
    ut.assert_eq("|".join(fs.Path("a/../b").parts()), "a|..|b")
    ut.assert_eq("|".join(fs.Path("a/b/").parts()), "a|b")
    ut.assert_eq("|".join(fs.Path("/").parts()), "/")
    ut.assert_eq("|".join(fs.Path("C:\\x\\y").parts()), "C:/|x|y")
    ut.assert_eq(fs.Path("").parts().len(), 0)
    ut.assert_eq(fs.Path(".").parts().len(), 0)
}

@test
func test_path_with_name_ext() {
    ut.assert_eq(fs.Path("src/main.kl").with_name("util.kl").to_str(), "src/util.kl")
    ut.assert_eq(fs.Path("main.kl").with_name("x").to_str(), "x")
    ut.assert_eq(fs.Path("/main.kl").with_name("x").to_str(), "/x")

    ut.assert_eq(fs.Path("src/main.kl").with_ext("klc").to_str(), "src/main.klc")
    ut.assert_eq(fs.Path("a.tar.gz").with_ext("").to_str(), "a.tar")
    ut.assert_eq(fs.Path("Makefile").with_ext("bak").to_str(), "Makefile.bak")
    ut.assert_eq(fs.Path(".bashrc").with_ext("old").to_str(), ".bashrc.old")
}

@should_panic
func test_path_with_name_root_panics() {
    fs.Path("/").with_name("x")
}

@should_panic
func test_path_with_name_separator_panics() {
    fs.Path("a/b").with_name("c/d")
}

@should_panic
func test_path_with_ext_dot_panics() {
    fs.Path("a.kl").with_ext(".klc")
}

@test
func test_path_relative_to() {
    ut.assert_eq(fs.Path("/a/b/c.kl").relative_to("/a")!.to_str(), "b/c.kl")
    ut.assert_eq(fs.Path("/a/b").relative_to(fs.Path("/a/b/"))!.to_str(), ".")
    ut.assert_eq(fs.Path("src/x/y.kl").relative_to("./src")!.to_str(), "x/y.kl")
    ut.assert_eq(fs.Path("a/b").relative_to(".")!.to_str(), "a/b")
    ut.assert_eq(fs.Path("/a/x/../b").relative_to("/a")!.to_str(), "b") // normalized first

    ut.assert(fs.Path("/a/b").relative_to("/x") == nil)
    ut.assert(fs.Path("/ab").relative_to("/a") == nil) // whole components only
    ut.assert(fs.Path("/a").relative_to("/a/b") == nil)
    ut.assert(fs.Path("a/b").relative_to("/a") == nil) // relative vs absolute
}


@test
func test_path_relative_to_walk_up() {
    ut.assert_eq(fs.Path("/a/b").relative_to("/a/x/y", true)!.to_str(), "../../b")
    ut.assert_eq(fs.Path("/a").relative_to("/a/b", true)!.to_str(), "..")
    ut.assert_eq(fs.Path("a/b").relative_to("c", true)!.to_str(), "../a/b")
    ut.assert_eq(fs.Path("/a/b/c").relative_to("/a", true)!.to_str(), "b/c") // below: no ..
    ut.assert(fs.Path("/a/b").relative_to("/a/x") == nil) // walk_up is off by default
    ut.assert(fs.Path("x").relative_to("../y", true) == nil) // cannot step out of ..
    ut.assert(fs.Path("a").relative_to("/a", true) == nil) // relative vs absolute
}

@test
func test_path_parents() {
    let ps = fs.Path("/a/b/c").parents()
    ut.assert_eq(ps.len(), 3)
    ut.assert_eq(ps[0].to_str(), "/a/b")
    ut.assert_eq(ps[1].to_str(), "/a")
    ut.assert_eq(ps[2].to_str(), "/")

    let rs = fs.Path("a/b").parents()
    ut.assert_eq(rs.len(), 2)
    ut.assert_eq(rs[0].to_str(), "a")
    ut.assert_eq(rs[1].to_str(), ".")

    ut.assert_eq(fs.Path("/").parents().len(), 0)
}

@test
func test_path_with_stem_suffixes() {
    ut.assert_eq(fs.Path("src/main.kl").with_stem("util").to_str(), "src/util.kl")
    ut.assert_eq(fs.Path("a.tar.gz").with_stem("b").to_str(), "b.gz")
    ut.assert_eq(fs.Path("Makefile").with_stem("GNUmakefile").to_str(), "GNUmakefile")

    ut.assert_eq("|".join(fs.Path("x/a.tar.gz").suffixes()), "tar|gz")
    ut.assert_eq(fs.Path("a.kl").suffixes().len(), 1)
    ut.assert_eq(fs.Path(".bashrc").suffixes().len(), 0)
    ut.assert_eq("|".join(fs.Path(".config.json").suffixes()), "json")
    ut.assert_eq(fs.Path("Makefile").suffixes().len(), 0)
}

@test
func test_path_cwd_home() {
    ut.assert_eq(fs.Path.cwd().to_str(), os.getcwd())
    ut.assert_eq(fs.Path.home()!.to_str(), os.home_dir()!)
}
