// RUN: koala %s --test

import "std/ut"

@test
func test_buffer_init() {
    let buffer = Buffer()
    ut.assert_eq(len(buffer), 0)
    ut.assert(buffer.empty())
}

@test
func test_buffer_write_byte() {
    let buffer = Buffer()
    buffer.write_byte(65)
    ut.assert_eq(len(buffer), 1)
    buffer.clear()
    ut.assert_eq(len(buffer), 0)
    ut.assert(buffer.empty())

    buffer.write_str("B")
    ut.assert_eq(len(buffer), 1)
}

@test
func test_buffer_write_str() {
    let buffer = Buffer()
    buffer.write_str("Hello, ")
    buffer.write_str("Koala!")
    ut.assert_eq(len(buffer), 13)
    buffer.clear()
    ut.assert_eq(len(buffer), 0)
    ut.assert(buffer.empty())

    buffer.write_str("Another string")
    ut.assert_eq(len(buffer), 14)
    ut.assert_eq(buffer.to_str(), "Another string")
}

@test
func test_buffer_to_bytes() {
    let buffer = Buffer()
    buffer.write_str("Hello, Koala!")
    let bytes_view = buffer.to_bytes()
    ut.assert_eq(len(bytes_view), 13)
    buffer.clear()
    ut.assert_eq(len(buffer), 0)
    ut.assert(buffer.empty())
}

@test
func test_buffer_to_str() {
    let buffer = Buffer()
    buffer.write_str("Hello, Koala!")
    let str_view = buffer.to_str()
    ut.assert_eq(str_view, "Hello, Koala!")
    ut.assert_eq(len(str_view), 13)
    buffer.clear()
    ut.assert_eq(len(buffer), 0)
    ut.assert(buffer.empty())
}

@test
func test_buffer_write_and_read() {
    let buffer = Buffer()
    buffer.write_str("Hello, Koala!")
    let str_view = buffer.to_str()
    ut.assert_eq(len(str_view), 13)
    ut.assert_eq(str_view, "Hello, Koala!")
    let bytes_view = buffer.to_bytes()
    ut.assert_eq(len(bytes_view), 13)
    buffer.clear()
    ut.assert_eq(len(buffer), 0)
    ut.assert(buffer.empty())
}
