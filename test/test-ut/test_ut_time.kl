// RUN: koala %s --test

import "std/ut"

from "std/time" import Duration

@test
func test_add() {
    let d1 = Duration.from_secs(1)
    let d2 = Duration.from_millis(500)
    ut.assert_eq(d1 + d2, Duration.from_millis(1500))
}

@test
func test_str() {
    let d = Duration.from_millis(123)
    ut.assert_eq(str(d), "123ms")
}
