// RUN: koala --test %s

func test_i64_to_i64(n int64) int64 { return n }

// int64 is the home type of the signed domain: there is no wider signed type,
// so every conversion out of int64 is narrowing or sign-changing and needs an
// explicit cast.

func test_i64_to_i8(n int64) int8 { return int8(n) }

func test_i64_to_i16(n int64) int16 { return int16(n) }

func test_i64_to_i32(n int64) int32 { return int32(n) }

func test_i64_to_u8(n int64) uint8 { return uint8(n) }

func test_i64_to_u16(n int64) uint16 { return uint16(n) }

func test_i64_to_u32(n int64) uint32 { return uint32(n) }

func test_i64_to_u64(n int64) uint64 { return uint64(n) }

// Arithmetic in the signed domain: every narrow operand promotes to int64,
// and the result type stays `int`. int64 itself wraps at INT64_MIN / INT64_MAX
// because there is nothing wider to promote into.

func test_i64_neg(n int64) int { return -n }

func test_i64_add_i8(n int64, m int8) int { return n + m }

func test_i64_add_i16(n int64, m int16) int { return n + m }

func test_i64_add_i32(n int64, m int32) int { return n + m }

func test_i64_add_i64(n int64, m int64) int { return n + m }

func test_i64_sub_i64(n int64, m int64) int { return n - m }

func test_i64_mul_i64(n int64, m int64) int { return n * m }

func test_i64_div_i64(n int64, m int64) int { return n / m }

func test_i64_mod_i64(n int64, m int64) int { return n % m }

// A small unsigned operand promotes to int64 as well, so mixing int64 with
// uint8 / uint16 / uint32 stays lossless and in the signed domain.

func test_i64_mod_u8(n int64, m uint8) int { return n % m }

func test_i64_add_u16(n int64, m uint16) int { return n + m }

func test_i64_add_u32(n int64, m uint32) int { return n + m }

// uint64 is the only integer type that cannot implicitly mix with a signed
// type: it does not fit int64, so an explicit cast is mandatory.

func test_i64_add_u64(n int64, m uint64) int { return n + int64(m) }

import "std/ut"

// -----------------------------------------------------------------------------
// Conversion tests
// -----------------------------------------------------------------------------

@test
func test_ut_i64_to_i64() {
    ut.assert(test_i64_to_i64(INT64_MIN) == INT64_MIN)
    ut.assert(test_i64_to_i64(-1) == -1)
    ut.assert(test_i64_to_i64(0) == 0)
    ut.assert(test_i64_to_i64(1) == 1)
    ut.assert(test_i64_to_i64(INT64_MAX) == INT64_MAX)
}

// Explicit int64 -> narrow signed: the low bits are kept and reinterpreted.

@test
func test_ut_i64_to_i8() {
    ut.assert(test_i64_to_i8(INT64_MIN) == 0)
    ut.assert(test_i64_to_i8(-256) == 0)
    ut.assert(test_i64_to_i8(-1) == -1)
    ut.assert(test_i64_to_i8(0) == 0)
    ut.assert(test_i64_to_i8(INT8_MAX) == INT8_MAX)
    ut.assert(test_i64_to_i8(128) == INT8_MIN)
    ut.assert(test_i64_to_i8(255) == -1)
    ut.assert(test_i64_to_i8(INT64_MAX) == -1)
}

@test
func test_ut_i64_to_i16() {
    ut.assert(test_i64_to_i16(INT64_MIN) == 0)
    ut.assert(test_i64_to_i16(-65536) == 0)
    ut.assert(test_i64_to_i16(-1) == -1)
    ut.assert(test_i64_to_i16(INT16_MAX) == INT16_MAX)
    ut.assert(test_i64_to_i16(32768) == INT16_MIN)
    ut.assert(test_i64_to_i16(INT64_MAX) == -1)
}

@test
func test_ut_i64_to_i32() {
    ut.assert(test_i64_to_i32(INT64_MIN) == 0)
    ut.assert(test_i64_to_i32(-4294967296) == 0)
    ut.assert(test_i64_to_i32(-1) == -1)
    ut.assert(test_i64_to_i32(INT32_MAX) == INT32_MAX)
    ut.assert(test_i64_to_i32(2147483648) == INT32_MIN)
    ut.assert(test_i64_to_i32(INT64_MAX) == -1)
}

// Explicit int64 -> unsigned: same bits, reinterpreted.

@test
func test_ut_i64_to_u8() {
    ut.assert(test_i64_to_u8(INT64_MIN) == 0)
    ut.assert(test_i64_to_u8(-1) == UINT8_MAX)
    ut.assert(test_i64_to_u8(0) == 0)
    ut.assert(test_i64_to_u8(UINT8_MAX) == UINT8_MAX)
    ut.assert(test_i64_to_u8(256) == 0)
    ut.assert(test_i64_to_u8(INT64_MAX) == UINT8_MAX)
}

@test
func test_ut_i64_to_u16() {
    ut.assert(test_i64_to_u16(INT64_MIN) == 0)
    ut.assert(test_i64_to_u16(-1) == UINT16_MAX)
    ut.assert(test_i64_to_u16(0) == 0)
    ut.assert(test_i64_to_u16(UINT16_MAX) == UINT16_MAX)
    ut.assert(test_i64_to_u16(65536) == 0)
    ut.assert(test_i64_to_u16(INT64_MAX) == UINT16_MAX)
}

@test
func test_ut_i64_to_u32() {
    ut.assert(test_i64_to_u32(INT64_MIN) == 0)
    ut.assert(test_i64_to_u32(-1) == UINT32_MAX)
    ut.assert(test_i64_to_u32(0) == 0)
    ut.assert(test_i64_to_u32(INT32_MAX) == INT32_MAX)
    ut.assert(test_i64_to_u32(2147483648) == 2147483648)
    ut.assert(test_i64_to_u32(INT64_MAX) == UINT32_MAX)
}

@test
func test_ut_i64_to_u64() {
    ut.assert_uint_eq(test_i64_to_u64(INT64_MIN), 9223372036854775808)
    ut.assert_uint_eq(test_i64_to_u64(-2), 18446744073709551614)
    ut.assert_uint_eq(test_i64_to_u64(-1), UINT64_MAX)
    ut.assert_uint_eq(test_i64_to_u64(0), 0)
    ut.assert_uint_eq(test_i64_to_u64(INT64_MAX), INT64_MAX)
}

// -----------------------------------------------------------------------------
// Unary minus
// -----------------------------------------------------------------------------

@test
func test_ut_i64_neg() {
    ut.assert(test_i64_neg(-1) == 1)
    ut.assert(test_i64_neg(0) == 0)
    ut.assert(test_i64_neg(1) == -1)
    ut.assert(test_i64_neg(INT64_MAX) == -INT64_MAX)
    ut.assert(test_i64_neg(INT64_MIN + 1) == INT64_MAX)
}

// -----------------------------------------------------------------------------
// int64 with narrow signed operands
// -----------------------------------------------------------------------------

@test
func test_ut_i64_add_i8() {
    ut.assert(test_i64_add_i8(0, 0) == 0)
    ut.assert(test_i64_add_i8(1, 1) == 2)
    ut.assert(test_i64_add_i8(-1, 1) == 0)
    ut.assert(test_i64_add_i8(INT64_MAX, INT8_MIN) == 9223372036854775679)
    ut.assert(test_i64_add_i8(INT64_MIN, INT8_MAX) == -9223372036854775681)
}

@test
func test_ut_i64_add_i16() {
    ut.assert(test_i64_add_i16(0, 0) == 0)
    ut.assert(test_i64_add_i16(0, INT16_MIN) == INT16_MIN)
    ut.assert(test_i64_add_i16(0, INT16_MAX) == INT16_MAX)
    ut.assert(test_i64_add_i16(INT64_MAX, INT16_MIN) == 9223372036854743039)
    ut.assert(test_i64_add_i16(INT64_MIN, INT16_MAX) == -9223372036854743041)
}

@test
func test_ut_i64_add_i32() {
    ut.assert(test_i64_add_i32(0, 0) == 0)
    ut.assert(test_i64_add_i32(0, INT32_MIN) == INT32_MIN)
    ut.assert(test_i64_add_i32(0, INT32_MAX) == INT32_MAX)
    ut.assert(test_i64_add_i32(INT64_MAX, INT32_MIN) == 9223372034707292159)
    ut.assert(test_i64_add_i32(INT64_MIN, INT32_MAX) == -9223372034707292161)
}

// -----------------------------------------------------------------------------
// int64 with int64: wrap-around at the int64 boundaries
// -----------------------------------------------------------------------------

@test
func test_ut_i64_add_i64() {
    ut.assert(test_i64_add_i64(0, 0) == 0)
    ut.assert(test_i64_add_i64(1, -1) == 0)
    ut.assert(test_i64_add_i64(INT64_MAX, INT64_MIN) == -1)
    ut.assert(test_i64_add_i64(INT64_MIN, INT64_MIN) == 0)
    ut.assert(test_i64_add_i64(INT64_MAX, INT64_MAX) == -2)
    ut.assert(test_i64_add_i64(INT64_MAX, 1) == INT64_MIN)
    ut.assert(test_i64_add_i64(INT64_MIN, -1) == INT64_MAX)
}

@test
func test_ut_i64_sub_i64() {
    ut.assert(test_i64_sub_i64(0, 0) == 0)
    ut.assert(test_i64_sub_i64(1, 2) == -1)
    ut.assert(test_i64_sub_i64(INT64_MAX, INT64_MAX) == 0)
    ut.assert(test_i64_sub_i64(INT64_MIN, INT64_MAX) == 1)
    ut.assert(test_i64_sub_i64(INT64_MIN, 1) == INT64_MAX)
    ut.assert(test_i64_sub_i64(INT64_MAX, -1) == INT64_MIN)
}

@test
func test_ut_i64_mul_i64() {
    ut.assert(test_i64_mul_i64(0, INT64_MAX) == 0)
    ut.assert(test_i64_mul_i64(1, INT64_MAX) == INT64_MAX)
    ut.assert(test_i64_mul_i64(-1, INT64_MAX) == -INT64_MAX)
    ut.assert(test_i64_mul_i64(2, 3) == 6)
    ut.assert(test_i64_mul_i64(-2, -3) == 6)
    ut.assert(test_i64_mul_i64(1000000000, 1000000000) == 1000000000000000000)
    ut.assert(test_i64_mul_i64(INT64_MAX, 2) == -2)
}

@test
func test_ut_i64_div_i64() {
    ut.assert(test_i64_div_i64(0, 1) == 0)
    ut.assert(test_i64_div_i64(1, 1) == 1)
    ut.assert(test_i64_div_i64(-1, 1) == -1)
    ut.assert(test_i64_div_i64(100, 10) == 10)
    ut.assert(test_i64_div_i64(-100, 10) == -10)

    // Truncation toward zero.
    ut.assert(test_i64_div_i64(7, 2) == 3)
    ut.assert(test_i64_div_i64(-7, 2) == -3)
    ut.assert(test_i64_div_i64(INT64_MAX, 2) == 4611686018427387903)
    ut.assert(test_i64_div_i64(INT64_MIN, 2) == -4611686018427387904)

    ut.assert(test_i64_div_i64(INT64_MAX, INT64_MAX) == 1)
    ut.assert(test_i64_div_i64(INT64_MIN, INT64_MAX) == -1)
    ut.assert(test_i64_div_i64(INT64_MAX, INT64_MIN) == 0)
}

@test
func test_ut_i64_mod_i64() {
    ut.assert(test_i64_mod_i64(0, 1) == 0)
    ut.assert(test_i64_mod_i64(7, 3) == 1)
    ut.assert(test_i64_mod_i64(-7, 3) == -1)
    ut.assert(test_i64_mod_i64(100, 10) == 0)
    ut.assert(test_i64_mod_i64(INT64_MAX, 2) == 1)
    ut.assert(test_i64_mod_i64(INT64_MIN, 2) == 0)
    ut.assert(test_i64_mod_i64(INT64_MAX, INT64_MAX) == 0)
    ut.assert(test_i64_mod_i64(INT64_MIN, INT64_MAX) == -1)
}

// -----------------------------------------------------------------------------
// int64 with small unsigned operands: promoted to int64, signed domain
// -----------------------------------------------------------------------------

@test
func test_ut_i64_mod_u8() {
    ut.assert(test_i64_mod_u8(0, 1) == 0)
    ut.assert(test_i64_mod_u8(7, 3) == 1)
    ut.assert(test_i64_mod_u8(-7, 3) == -1)
    ut.assert(test_i64_mod_u8(127, 128) == 127)
    ut.assert(test_i64_mod_u8(INT64_MAX, UINT8_MAX) == 127)
    ut.assert(test_i64_mod_u8(INT64_MIN, UINT8_MAX) == -128)
}

@test
func test_ut_i64_add_u16() {
    ut.assert(test_i64_add_u16(0, 0) == 0)
    ut.assert(test_i64_add_u16(0, UINT16_MAX) == UINT16_MAX)
    ut.assert(test_i64_add_u16(-1, UINT16_MAX) == 65534)
    ut.assert(test_i64_add_u16(INT64_MIN, UINT16_MAX) == -9223372036854710273)
}

@test
func test_ut_i64_add_u32() {
    ut.assert(test_i64_add_u32(0, 0) == 0)
    ut.assert(test_i64_add_u32(0, UINT32_MAX) == UINT32_MAX)
    ut.assert(test_i64_add_u32(-1, UINT32_MAX) == 4294967294)
    ut.assert(test_i64_add_u32(INT64_MIN, UINT32_MAX) == -9223372032559808513)
}

// -----------------------------------------------------------------------------
// int64 with uint64: only via an explicit int64 cast
// -----------------------------------------------------------------------------

@test
func test_ut_i64_add_u64() {
    ut.assert(test_i64_add_u64(0, 0) == 0)
    ut.assert(test_i64_add_u64(1, 1) == 2)
    ut.assert(test_i64_add_u64(-1, 1) == 0)

    // int64(UINT64_MAX) is -1, so the sum stays in the signed domain.
    ut.assert(test_i64_add_u64(0, UINT64_MAX) == -1)
    ut.assert(test_i64_add_u64(1, UINT64_MAX) == 0)
    ut.assert(test_i64_add_u64(-1, UINT64_MAX) == -2)
    ut.assert(test_i64_add_u64(INT64_MIN, UINT64_MAX) == INT64_MAX)

    // int64(2^63) is INT64_MIN.
    ut.assert(test_i64_add_u64(INT64_MAX, 9223372036854775808) == -1)
    ut.assert(test_i64_add_u64(0, 9223372036854775808) == INT64_MIN)
}

// -----------------------------------------------------------------------------
// Two's complement round trip
// -----------------------------------------------------------------------------

func i64_to_u64(v int64) uint64 {
    return uint64(v)
}

func u64_to_i64(v uint64) int64 {
    return int64(v)
}

@test
func test_ut_i64_twos_complement() {
    ut.assert_uint_eq(i64_to_u64(-1), UINT64_MAX)
    ut.assert_uint_eq(i64_to_u64(-2), 18446744073709551614)
    ut.assert_uint_eq(i64_to_u64(INT64_MIN), 9223372036854775808)
    ut.assert_uint_eq(i64_to_u64(INT64_MAX), INT64_MAX)

    ut.assert(u64_to_i64(UINT64_MAX) == -1)
    ut.assert(u64_to_i64(18446744073709551614) == -2)
    ut.assert(u64_to_i64(9223372036854775808) == INT64_MIN)
    ut.assert(u64_to_i64(INT64_MAX) == INT64_MAX)
}
