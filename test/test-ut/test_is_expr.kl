@test
func test_is_always_true() {
    let d = Dog()
    // warning: 'is' check is always true
    assert(d is Dog)

    // error: target type of 'is' operator must be a class type.
    // assert(d is Pet)
    // assert(d is Speaker)
    // assert(d is any)

    let p = Poodle()
    // error: target type of 'is' operator must be a class type.
    // assert(p is ShowPet)
    // assert(p is Pet)
}

@test
func test_is_always_false() {
    let d = Dog()
    assert_false(d is Cat)
    assert_false(d is Robot)
    assert_false(d is Poodle)
    // warning: 'is' check is always false
    assert_false([1, 2, 3] is list[str])
}

