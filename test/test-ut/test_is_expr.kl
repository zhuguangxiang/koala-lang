// RUN: koala --test %s

from "std/ut" import assert, assert_false, assert_eq

@test
func test_is_1() {
    // error: target type of 'is' operator must be a class type.
    // assert(true is any)
    // assert(100 is ToString)
    // assert(100 is Arithmetic[int])

    // warning: 'is' check is always true
    assert([1,2,3] is list[int])
    assert_false([1,2,3] is list[str])
}

trait Speaker { func speak() str }
trait Pet     { func cuddle() str }
trait ShowPet : Pet { func show() str }

class Dog: Speaker & Pet {
    func speak() str { return "woof" }
    func cuddle() str { return "hug" }
    func fetch() str { return "ball" }
}

class Cat: Speaker & Pet {
    func speak() str { return "meow" }
    func cuddle() str { return "purr" }
}

class Poodle: ShowPet {
    func cuddle() str { return "soft" }
    func show() str   { return "ta-da" }
}

class Robot: Speaker {
    func speak() str { return "beep" }
}

@test
func test_is_2() {
    let d = Dog()
    let c = Cat()

    // error: target type of 'is' operator must be a class type.
