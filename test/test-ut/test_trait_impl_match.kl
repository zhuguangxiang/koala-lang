// RUN: koala --test %s

import "std/ut"

// Classes that satisfy the trait method check.

trait P { func f(x int) int }

// A trait method the class does not implement is not an error.
class NotImplemented : P {
}

trait Q { func f(x int) int }

// Two traits with the same signature share one implementation.
class SameSignature : P & Q {
    pub func f(y int) int { return y + 1 }
}

// `T` is bound through the trait chain: MutableSequence[T] : Sequence[T] : Iterable[T].
class Bound : MutableSequence[uint8] {
    pub func iter(step = 1) Iterator[uint8] { return b"ok".iter(step) }
    pub func len() int { return 2 }
    pub func __getitem__(index int) uint8 { return b"ok"[index] }
}

// The class's own `T` is bound to the trait's.
class Generic[T] : Iterable[T] {
    let items list[T]

    pub func __init__(_items list[T]) { items = _items }
    pub func iter(step = 1) Iterator[T] { return items.iter(step) }
}

// Parameter names and default values are not compared.
trait D { func d(a int, b = 1) int }

class OtherDefault : D {
    pub func d(x int, y = 2) int { return x + y }
}

// A covariant return: the class returns a type that implements the trait's.
trait SetMaker { func make() Set[int] }

class HashSetMaker : SetMaker {
    pub func make() hashset[int] { return hashset[int]() }
}

// A return of `T` is narrower than `T?`.
trait Maybe { func get() int? }

class Always : Maybe {
    pub func get() int { return 1 }
}

// `any` is the parent of every type.
trait AnyMaker { func make() any }

class IntMaker : AnyMaker {
    pub func make() int { return 1 }
}

// A parameter may widen to a union, an optional or `any`.
trait Taker {
    func take_int(x int) int
    func take_str(x str) int
}

class WideTaker : Taker {
    pub func take_int(x int | str) int { return 1 }
    pub func take_str(x any) int { return 3 }
}

trait OptionalTaker { func take(x int) int }

class NilTaker : OptionalTaker {
    pub func take(x int?) int { return 4 }
}

// A method with an `infer` type parameter is deduced by the compiler, not checked.
trait Indexed { func at(index int) int }

class InferIndexed : Indexed {
    pub func at[infer U](index int) U { panic("not called") }
}

@test
func test_covariant_return() {
    ut.assert_eq(HashSetMaker().make().len(), 0)
    ut.assert_eq(Always().get(), 1)
    ut.assert_eq(IntMaker().make(), 1)
}

@test
func test_wider_param_through_trait() {
    let t Taker = WideTaker()
    ut.assert_eq(t.take_int(1), 1)
    ut.assert_eq(t.take_str("x"), 3)

    let o OptionalTaker = NilTaker()
    ut.assert_eq(o.take(1), 4)
}

@test
func test_same_signature() {
    ut.assert_eq(SameSignature().f(1), 2)
}

@test
func test_other_default() {
    ut.assert_eq(OtherDefault().d(1), 3)
}

@test
func test_bound_through_trait_chain() {
    let b = Buffer()
    b.extend(Bound())
    ut.assert_eq(b.to_str(), "ok")
}

@test
func test_generic_class() {
    var n = 0
    for x in Generic[int](list[int](1, 2)) { n += x }
    ut.assert_eq(n, 3)
}
