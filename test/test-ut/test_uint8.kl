// RUN: koala --test %s

func test_u8_to_u8(n uint8) uint8 { return n }

// Lossless unsigned widening: no explicit cast needed

func test_u8_to_u16(n uint8) uint16 { return n }

func test_u8_to_u32(n uint8) uint32 { return n }

func test_u8_to_u64(n uint8) uint64 { return n }

// Explicit conversion required:
//
// Signed and unsigned types of the same width cannot be implicitly converted.

func test_u8_to_i8(n uint8) int8 { return int8(n) }

// Lossless signed widening: no explicit cast needed

func test_u8_to_i16(n uint8) int16 { return n }

func test_u8_to_i32(n uint8) int32 { return n }

func test_u8_to_i64(n uint8) int64 { return n }

// Arithmetic and return values: implicitly promoted, no explicit cast needed

func test_u8_add_u8(n uint8, m uint8) uint64 { return n + m }

func test_u8_sub_u16(n uint8, m uint16) uint64 { return n - m }

func test_u8_mul_u32(n uint8, m uint32) uint64 { return n * m }

func test_u8_div_u64(n uint8, m uint64) uint64 { return n / m }

func test_u8_mod_i8(n uint8, m int8) int { return n % m }

func test_u8_add_i16(n uint8, m int16) int { return n + m }

func test_u8_add_i32(n uint8, m int32) int { return n + m }

func test_u8_add_i64(n uint8, m int64) int { return n + m }


import "std/ut"

// -----------------------------------------------------------------------------
// Conversion tests
// -----------------------------------------------------------------------------

@test
func test_ut_u8_to_u8() {
    ut.assert(test_u8_to_u8(UINT8_MIN) == UINT8_MIN)
    ut.assert(test_u8_to_u8(1) == 1)
    ut.assert(test_u8_to_u8(127) == 127)
    ut.assert(test_u8_to_u8(128) == 128)
    ut.assert(test_u8_to_u8(254) == 254)
    ut.assert(test_u8_to_u8(UINT8_MAX) == UINT8_MAX)
}

@test
func test_ut_u8_to_unsigned_widening() {
    ut.assert(test_u8_to_u16(UINT8_MIN) == UINT16_MIN)
    ut.assert(test_u8_to_u16(UINT8_MAX) == UINT16_MAX - (UINT16_MAX - UINT8_MAX))

    ut.assert(test_u8_to_u32(UINT8_MIN) == UINT32_MIN)
    ut.assert(test_u8_to_u32(UINT8_MAX) == UINT8_MAX)

    ut.assert_uint_eq(test_u8_to_u64(UINT8_MIN), UINT64_MIN)
    ut.assert_uint_eq(test_u8_to_u64(UINT8_MAX), UINT8_MAX)
}

@test
func test_ut_u8_to_signed_widening() {
    ut.assert(test_u8_to_i16(UINT8_MIN) == INT16_MIN - INT16_MIN)
    ut.assert(test_u8_to_i16(127) == 127)
    ut.assert(test_u8_to_i16(128) == 128)
    ut.assert(test_u8_to_i16(UINT8_MAX) == 255)

    ut.assert(test_u8_to_i32(UINT8_MIN) == INT32_MIN - INT32_MIN)
    ut.assert(test_u8_to_i32(127) == 127)
    ut.assert(test_u8_to_i32(128) == 128)
    ut.assert(test_u8_to_i32(UINT8_MAX) == 255)

    ut.assert(test_u8_to_i64(UINT8_MIN) == INT64_MIN - INT64_MIN)
    ut.assert(test_u8_to_i64(127) == 127)
    ut.assert(test_u8_to_i64(128) == 128)
    ut.assert(test_u8_to_i64(UINT8_MAX) == 255)
}

// Explicit uint8 -> int8 conversion.

@test
func test_ut_u8_to_i8() {
    ut.assert(test_u8_to_i8(UINT8_MIN) == INT8_MIN + 128)
    ut.assert(test_u8_to_i8(1) == 1)
    ut.assert(test_u8_to_i8(INT8_MAX) == INT8_MAX)
    ut.assert(test_u8_to_i8(128) == INT8_MIN)
    ut.assert(test_u8_to_i8(129) == -127)
    ut.assert(test_u8_to_i8(254) == -2)
    ut.assert(test_u8_to_i8(UINT8_MAX) == -1)
}


// -----------------------------------------------------------------------------
// uint8 + uint8
// -----------------------------------------------------------------------------

@test
func test_ut_u8_add_u8() {
    ut.assert_uint_eq(test_u8_add_u8(UINT8_MIN, UINT8_MIN), UINT8_MIN)
    ut.assert_uint_eq(test_u8_add_u8(UINT8_MIN, UINT8_MAX), UINT8_MAX)
    ut.assert(test_u8_add_u8(1, UINT8_MAX) == 256)
    ut.assert_uint_eq(test_u8_add_u8(127, 128), UINT8_MAX)
    ut.assert(test_u8_add_u8(128, 128) == 256)
    ut.assert(test_u8_add_u8(UINT8_MAX, UINT8_MAX) == 510)
}


// -----------------------------------------------------------------------------
// uint8 - uint16
//
// uint8 and uint16 are promoted to uint64 before subtraction.
// Unsigned underflow therefore wraps at UINT64_MAX.
// -----------------------------------------------------------------------------

@test
func test_ut_u8_sub_u16() {
    ut.assert_uint_eq(test_u8_sub_u16(UINT8_MAX, UINT16_MIN), UINT8_MAX)
    ut.assert(test_u8_sub_u16(UINT8_MAX, 1) == 254)
    ut.assert(test_u8_sub_u16(UINT8_MAX, UINT8_MAX) == 0)

    ut.assert(test_u8_sub_u16(1, 2) == UINT64_MAX)
    ut.assert(test_u8_sub_u16(0, 1) == UINT64_MAX)
    ut.assert(test_u8_sub_u16(0, UINT16_MAX) == 18446744073709486081)
    ut.assert(test_u8_sub_u16(UINT8_MAX, 256) == UINT64_MAX)
}


// -----------------------------------------------------------------------------
// uint8 * uint32
// -----------------------------------------------------------------------------

@test
func test_ut_u8_mul_u32() {
    ut.assert(test_u8_mul_u32(UINT8_MIN, 0) == 0)
    ut.assert(test_u8_mul_u32(UINT8_MIN, UINT32_MAX) == 0)

    ut.assert(test_u8_mul_u32(1, 1) == 1)
    ut.assert_uint_eq(test_u8_mul_u32(1, UINT32_MAX), UINT32_MAX)

    ut.assert_uint_eq(test_u8_mul_u32(UINT8_MAX, 1), UINT8_MAX)
    ut.assert_uint_eq(test_u8_mul_u32(UINT8_MAX, 0x01010101), UINT32_MAX)

    ut.assert(test_u8_mul_u32(UINT8_MAX, 0x01000000) == 0xff000000)
}


// -----------------------------------------------------------------------------
// uint8 / uint64
// -----------------------------------------------------------------------------

@test
func test_ut_u8_div_u64() {
    ut.assert(test_u8_div_u64(0, 1) == 0)
    ut.assert(test_u8_div_u64(1, 1) == 1)
    ut.assert(test_u8_div_u64(1, 2) == 0)
    ut.assert(test_u8_div_u64(2, 1) == 2)

    ut.assert_uint_eq(test_u8_div_u64(UINT8_MAX, 1), UINT8_MAX)
    ut.assert(test_u8_div_u64(UINT8_MAX, 2) == 127)
    ut.assert(test_u8_div_u64(UINT8_MAX, 127) == 2)
    ut.assert(test_u8_div_u64(UINT8_MAX, UINT8_MAX) == 1)
    ut.assert(test_u8_div_u64(UINT8_MAX, 256) == 0)
}


// -----------------------------------------------------------------------------
// uint8 % int8
// -----------------------------------------------------------------------------

@test
func test_ut_u8_mod_i8() {
    ut.assert(test_u8_mod_i8(0, 1) == 0)
    ut.assert(test_u8_mod_i8(1, 1) == 0)
    ut.assert(test_u8_mod_i8(UINT8_MAX, 1) == 0)

    ut.assert(test_u8_mod_i8(127, 10) == 7)
    ut.assert(test_u8_mod_i8(128, 10) == 8)
    ut.assert(test_u8_mod_i8(UINT8_MAX, 10) == 5)

    ut.assert(test_u8_mod_i8(127, -10) == 7)
    ut.assert(test_u8_mod_i8(128, -10) == 8)
    ut.assert(test_u8_mod_i8(UINT8_MAX, -10) == 5)

    ut.assert(test_u8_mod_i8(128, -127) == 1)
    ut.assert(test_u8_mod_i8(127, INT8_MIN) == 127)
    ut.assert(test_u8_mod_i8(128, INT8_MIN) == 0)
    ut.assert(test_u8_mod_i8(UINT8_MAX, INT8_MIN) == 127)
}


// -----------------------------------------------------------------------------
// uint8 + int16
// -----------------------------------------------------------------------------

@test
func test_ut_u8_add_i16() {
    ut.assert(test_u8_add_i16(UINT8_MIN, 0) == 0)
    ut.assert(test_u8_add_i16(UINT8_MAX, 0) == UINT8_MAX)

    ut.assert(test_u8_add_i16(UINT8_MIN, -1) == -1)
    ut.assert(test_u8_add_i16(UINT8_MAX, -1) == 254)

    ut.assert(test_u8_add_i16(UINT8_MIN, INT16_MIN) == INT16_MIN)
    ut.assert(test_u8_add_i16(UINT8_MAX, INT16_MIN) == -32513)

    ut.assert(test_u8_add_i16(UINT8_MIN, INT16_MAX) == INT16_MAX)
    ut.assert(test_u8_add_i16(UINT8_MAX, INT16_MAX) == 33022)
}


// -----------------------------------------------------------------------------
// uint8 + int32
// -----------------------------------------------------------------------------

@test
func test_ut_u8_add_i32() {
    ut.assert(test_u8_add_i32(UINT8_MIN, 0) == 0)
    ut.assert(test_u8_add_i32(UINT8_MAX, 0) == UINT8_MAX)

    ut.assert(test_u8_add_i32(UINT8_MIN, -1) == -1)
    ut.assert(test_u8_add_i32(UINT8_MAX, -1) == 254)

    ut.assert(test_u8_add_i32(UINT8_MIN, INT32_MIN) == INT32_MIN)
    ut.assert(test_u8_add_i32(UINT8_MAX, INT32_MIN) == -2147483393)

    ut.assert(test_u8_add_i32(UINT8_MIN, INT32_MAX) == INT32_MAX)
    ut.assert(test_u8_add_i32(UINT8_MAX, INT32_MAX) == 2147483902)
}


// -----------------------------------------------------------------------------
// uint8 + int64
// -----------------------------------------------------------------------------

@test
func test_ut_u8_add_i64() {
    ut.assert(test_u8_add_i64(UINT8_MIN, 0) == 0)
    ut.assert(test_u8_add_i64(UINT8_MAX, 0) == UINT8_MAX)

    ut.assert(test_u8_add_i64(UINT8_MIN, -1) == -1)
    ut.assert(test_u8_add_i64(UINT8_MAX, -1) == 254)

    ut.assert(test_u8_add_i64(UINT8_MIN, INT64_MIN) == INT64_MIN)
    ut.assert(test_u8_add_i64(UINT8_MAX, INT64_MIN) == -9223372036854775553)

    ut.assert(test_u8_add_i64(UINT8_MIN, INT64_MAX) == INT64_MAX)
}

func test_ut_sub(n uint64, m uint64) uint64 { return n - m }

@test
func test_ut_sub_func() {
    ut.assert(test_ut_sub(10, 20) == 18446744073709551606)
}
