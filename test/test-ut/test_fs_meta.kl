// }

@test
func test_fs_mkdir() {
    cleanup_fs_meta()

    let deep = "/tmp/kl_fs_meta_dir/a/b/c"

    // mkdir creates the whole chain (mkdir -p semantics).
    ut.assert(fs.mkdir(deep))
    ut.assert(fs.is_dir("/tmp/kl_fs_meta_dir"))
    ut.assert(fs.is_dir(deep))

    // An existing directory is success.
    ut.assert(fs.mkdir(deep))

    // A Path argument is accepted.
    ut.assert(fs.mkdir(fs.Path(deep)))

    // rmdir removes only empty directories, bottom-up.
    ut.assert_false(fs.rmdir("/tmp/kl_fs_meta_dir"))
    ut.assert(fs.rmdir(deep))
    ut.assert(fs.rmdir("/tmp/kl_fs_meta_dir/a/b"))
    ut.assert(fs.rmdir("/tmp/kl_fs_meta_dir/a"))
    ut.assert(fs.rmdir("/tmp/kl_fs_meta_dir"))
    ut.assert_false(fs.exists("/tmp/kl_fs_meta_dir"))

    ut.assert_false(fs.rmdir("/tmp/kl_fs_meta_missing_dir"))
}

@test
func test_fs_rename() {
    cleanup_fs_meta()

    // Rename a file: the old path is gone, the new path carries the content.
    ut.assert(fs.write_str("/tmp/kl_fs_meta_old.txt", "data"))
    ut.assert(fs.rename("/tmp/kl_fs_meta_old.txt", "/tmp/kl_fs_meta_new.txt"))
    ut.assert_false(fs.exists("/tmp/kl_fs_meta_old.txt"))
    ut.assert(fs.is_file("/tmp/kl_fs_meta_new.txt"))

    let buf = bytes(16)
    ut.assert_eq(fs.read_bytes("/tmp/kl_fs_meta_new.txt", buf), 4)
    ut.assert_eq(buf.view(0, 4).to_str(), "data")

    // Renaming a missing source fails.
    ut.assert_false(fs.rename("/tmp/kl_fs_meta_missing.txt", "/tmp/kl_fs_meta_x.txt"))

    // A Path argument is accepted on both ends.
    ut.assert(fs.rename(fs.Path("/tmp/kl_fs_meta_new.txt"), fs.Path("/tmp/kl_fs_meta_renamed.txt")))
    ut.assert(fs.is_file("/tmp/kl_fs_meta_renamed.txt"))

    // A directory can be renamed as well.
    ut.assert(fs.mkdir("/tmp/kl_fs_meta_rdir"))
    ut.assert(fs.rename("/tmp/kl_fs_meta_rdir", "/tmp/kl_fs_meta_rdir2"))
    ut.assert_false(fs.exists("/tmp/kl_fs_meta_rdir"))
    ut.assert(fs.is_dir("/tmp/kl_fs_meta_rdir2"))

    ut.assert(fs.remove("/tmp/kl_fs_meta_renamed.txt"))
    ut.assert(fs.rmdir("/tmp/kl_fs_meta_rdir2"))
}

@test
func test_fs_list_dir() {
    cleanup_fs_meta()

    ut.assert(fs.mkdir("/tmp/kl_fs_meta_list/sub"))
    ut.assert(fs.write_str("/tmp/kl_fs_meta_list/b.txt", "b"))
    ut.assert(fs.write_str("/tmp/kl_fs_meta_list/a.txt", "a"))

    let items = fs.list_dir("/tmp/kl_fs_meta_list")

    // Entries are joined with the directory and sorted ascending;
    // `.` and `..` are skipped.
    ut.assert_eq(items.len(), 3)
    ut.assert_eq(items[0].to_str(), "/tmp/kl_fs_meta_list/a.txt")
    ut.assert_eq(items[1].to_str(), "/tmp/kl_fs_meta_list/b.txt")
    ut.assert_eq(items[2].to_str(), "/tmp/kl_fs_meta_list/sub")

    // The entries are strongly-typed `Path` objects, directly usable
    // with the fs functions; the base name stays accessible.
    ut.assert_eq(items[0].name(), "a.txt")
    ut.assert_eq(items[0].ext(), "txt")
    ut.assert(fs.is_file(items[0]))
    ut.assert(fs.is_dir(items[2]))

    // A `Path` argument is accepted as well.
    let items2 = fs.list_dir(fs.Path("/tmp/kl_fs_meta_list"))
    ut.assert_eq(items2.len(), 3)

    // Cleanup.
    ut.assert(fs.remove(items[0]))
    ut.assert(fs.remove(items[1]))
    ut.assert(fs.rmdir(items[2]))
    ut.assert(fs.rmdir(fs.Path("/tmp/kl_fs_meta_list")))
}

