// RUN: koala %s --test

import "std/fs"
import "std/ut"

/// Best-effort cleanup so every run starts from a known state.
func cleanup_fs_meta() {
    fs.remove("/tmp/kl_fs_meta_probe.txt")
    fs.rmdir("/tmp/kl_fs_meta_probe_dir")
    fs.rmdir("/tmp/kl_fs_meta_dir/a/b/c")
    fs.rmdir("/tmp/kl_fs_meta_dir/a/b")
    fs.rmdir("/tmp/kl_fs_meta_dir/a")
    fs.rmdir("/tmp/kl_fs_meta_dir")
    fs.remove("/tmp/kl_fs_meta_list/a.txt")
    fs.remove("/tmp/kl_fs_meta_list/b.txt")
    fs.rmdir("/tmp/kl_fs_meta_list/sub")
    fs.rmdir("/tmp/kl_fs_meta_list")
}

@test
func test_fs_exists_is_file_is_dir() {
    cleanup_fs_meta()

    // Missing paths report false for all three queries.
    ut.assert_false(fs.exists("/tmp/kl_fs_meta_missing"))
    ut.assert_false(fs.is_file("/tmp/kl_fs_meta_missing"))
    ut.assert_false(fs.is_dir("/tmp/kl_fs_meta_missing"))

    ut.assert(fs.write_str("/tmp/kl_fs_meta_probe.txt", "probe"))
    ut.assert(fs.exists("/tmp/kl_fs_meta_probe.txt"))
    ut.assert(fs.is_file("/tmp/kl_fs_meta_probe.txt"))
    ut.assert_false(fs.is_dir("/tmp/kl_fs_meta_probe.txt"))

    ut.assert(fs.mkdir("/tmp/kl_fs_meta_probe_dir"))
    ut.assert(fs.exists("/tmp/kl_fs_meta_probe_dir"))
    ut.assert(fs.is_dir("/tmp/kl_fs_meta_probe_dir"))
    ut.assert_false(fs.is_file("/tmp/kl_fs_meta_probe_dir"))

    ut.assert(fs.remove("/tmp/kl_fs_meta_probe.txt"))
    ut.assert(fs.rmdir("/tmp/kl_fs_meta_probe_dir"))
}

@test
func test_fs_size() {
    ut.assert(fs.write_str("/tmp/kl_fs_meta_size.txt", "hello"))
    ut.assert_eq(fs.size("/tmp/kl_fs_meta_size.txt"), 5)

    // Multi-byte content counts the encoded bytes.
    ut.assert(fs.write_str("/tmp/kl_fs_meta_size.txt", "你好"))
    ut.assert_eq(fs.size("/tmp/kl_fs_meta_size.txt"), 6)

    // Rewriting truncates, shrinking the size.
    ut.assert(fs.write_str("/tmp/kl_fs_meta_size.txt", "abcdefgh"))
    ut.assert_eq(fs.size("/tmp/kl_fs_meta_size.txt"), 8)
    ut.assert(fs.write_str("/tmp/kl_fs_meta_size.txt", "ab"))
    ut.assert_eq(fs.size("/tmp/kl_fs_meta_size.txt"), 2)

    ut.assert(fs.remove("/tmp/kl_fs_meta_size.txt"))
}

