// RUN: koala --test %s

from "std/ut" import assert_eq

// `any` is the top type: any class/trait/primitive value can be stored in an
// `any` variable. After `v is T` narrows a value to a concrete `T`, reading the
// shadow variable emits `OP_IR_CAST(any -> T)`, which isel must lower to a
// plain move (the tagged value is already the target value). Without the
// `TYPE_ANY` arm in `isel_lower_cast`, this path hits `NYI()`.

class Cat {
    pub func name() str { return "cat" }
}

// any -> class narrow, then direct member access (unbox)
func cat_name(v any) str {
    if v is Cat {
        return v.name()
    }
    return "?"
}

// any -> primitive narrow, then direct arithmetic use (unbox)
func int_inc(v any) int {
    if v is int {
        return v + 1
    }
    return 0
}

@test
func test_any_narrow_class() {
    assert_eq(cat_name(Cat()), "cat")
    assert_eq(cat_name("x"), "?")
}

@test
func test_any_narrow_int() {
    assert_eq(int_inc(42), 43)
    assert_eq(int_inc("x"), 0)
}