// RUN: koala --test %s

func test_u64_to_u64(n uint64) uint64 { return n }

// uint64 is the widest unsigned type: every conversion out of it is narrowing
// or sign-changing, so an explicit cast is always required.

func test_u64_to_u8(n uint64) uint8 { return uint8(n) }

func test_u64_to_u16(n uint64) uint16 { return uint16(n) }

func test_u64_to_u32(n uint64) uint32 { return uint32(n) }

func test_u64_to_i8(n uint64) int8 { return int8(n) }

func test_u64_to_i16(n uint64) int16 { return int16(n) }

func test_u64_to_i32(n uint64) int32 { return int32(n) }

func test_u64_to_i64(n uint64) int64 { return int64(n) }

// uint64 is the only integer type that may not mix implicitly with a signed
// type. With unsigned operands of any width it promotes them to uint64, and
// the result type is uint64 (underflow wraps at UINT64_MAX).

func test_u64_add_u8(n uint64, m uint8) uint64 { return n + m }

func test_u64_add_u16(n uint64, m uint16) uint64 { return n + m }

func test_u64_add_u32(n uint64, m uint32) uint64 { return n + m }

func test_u64_add_u64(n uint64, m uint64) uint64 { return n + m }

func test_u64_sub_u8(n uint64, m uint8) uint64 { return n - m }

func test_u64_sub_u64(n uint64, m uint64) uint64 { return n - m }

func test_u64_mul_u64(n uint64, m uint64) uint64 { return n * m }

func test_u64_div_u32(n uint64, m uint32) uint64 { return n / m }

func test_u64_mod_u16(n uint64, m uint16) uint64 { return n % m }

func test_u64_mod_u64(n uint64, m uint64) uint64 { return n % m }

// Mixing with a signed type needs an explicit cast in one direction or the
// other. Both forms below are legal; the implicit form is a compile error.

func test_u64_add_i8_as_uint(n uint64, m int8) uint64 { return n + uint64(m) }

func test_u64_add_i64_as_uint(n uint64, m int64) uint64 { return n + uint64(m) }

func test_u64_add_i64_as_int(n uint64, m int64) int { return int64(n) + m }

import "std/ut"

// -----------------------------------------------------------------------------
// Conversion tests
// -----------------------------------------------------------------------------

@test
func test_ut_u64_to_u64() {
    ut.assert_uint_eq(test_u64_to_u64(UINT64_MIN), UINT64_MIN)
    ut.assert_uint_eq(test_u64_to_u64(1), 1)
    ut.assert_uint_eq(test_u64_to_u64(INT64_MAX), INT64_MAX)
    ut.assert_uint_eq(test_u64_to_u64(9223372036854775808), 9223372036854775808)
    ut.assert_uint_eq(test_u64_to_u64(UINT64_MAX), UINT64_MAX)
}

// Explicit uint64 -> narrow unsigned: the low bits are kept (wrap mode).

@test
func test_ut_u64_to_u8() {
    ut.assert(test_u64_to_u8(UINT64_MIN) == UINT8_MIN)
    ut.assert(test_u64_to_u8(1) == 1)
    ut.assert(test_u64_to_u8(UINT8_MAX) == UINT8_MAX)
    ut.assert(test_u64_to_u8(256) == 0)
    ut.assert(test_u64_to_u8(9223372036854775808) == 0)
    ut.assert(test_u64_to_u8(UINT64_MAX) == UINT8_MAX)
}

@test
func test_ut_u64_to_u16() {
    ut.assert(test_u64_to_u16(UINT64_MIN) == UINT16_MIN)
    ut.assert(test_u64_to_u16(1) == 1)
    ut.assert(test_u64_to_u16(UINT16_MAX) == UINT16_MAX)
    ut.assert(test_u64_to_u16(65536) == 0)
    ut.assert(test_u64_to_u16(9223372036854775808) == 0)
    ut.assert(test_u64_to_u16(UINT64_MAX) == UINT16_MAX)
}

@test
func test_ut_u64_to_u32() {
    ut.assert(test_u64_to_u32(UINT64_MIN) == UINT32_MIN)
    ut.assert(test_u64_to_u32(1) == 1)
    ut.assert(test_u64_to_u32(UINT32_MAX) == UINT32_MAX)
    ut.assert(test_u64_to_u32(4294967296) == 0)
    ut.assert(test_u64_to_u32(9223372036854775808) == 0)
    ut.assert(test_u64_to_u32(UINT64_MAX) == UINT32_MAX)
}

// Explicit uint64 -> signed: same bits, reinterpreted.

@test
func test_ut_u64_to_i8() {
    ut.assert(test_u64_to_i8(UINT64_MIN) == INT8_MIN + 128)
    ut.assert(test_u64_to_i8(1) == 1)
    ut.assert(test_u64_to_i8(INT8_MAX) == INT8_MAX)
    ut.assert(test_u64_to_i8(128) == INT8_MIN)
    ut.assert(test_u64_to_i8(UINT8_MAX) == -1)
    ut.assert(test_u64_to_i8(9223372036854775808) == 0)
    ut.assert(test_u64_to_i8(UINT64_MAX) == -1)
}

@test
func test_ut_u64_to_i16() {
    ut.assert(test_u64_to_i16(UINT64_MIN) == INT16_MIN + 32768)
    ut.assert(test_u64_to_i16(1) == 1)
    ut.assert(test_u64_to_i16(INT16_MAX) == INT16_MAX)
    ut.assert(test_u64_to_i16(32768) == INT16_MIN)
    ut.assert(test_u64_to_i16(UINT16_MAX) == -1)
    ut.assert(test_u64_to_i16(9223372036854775808) == 0)
    ut.assert(test_u64_to_i16(UINT64_MAX) == -1)
}

@test
func test_ut_u64_to_i32() {
    ut.assert(test_u64_to_i32(UINT64_MIN) == INT32_MIN + 2147483648)
    ut.assert(test_u64_to_i32(1) == 1)
    ut.assert(test_u64_to_i32(INT32_MAX) == INT32_MAX)
    ut.assert(test_u64_to_i32(2147483648) == INT32_MIN)
    ut.assert(test_u64_to_i32(UINT32_MAX) == -1)
    ut.assert(test_u64_to_i32(9223372036854775808) == 0)
    ut.assert(test_u64_to_i32(UINT64_MAX) == -1)
}

@test
func test_ut_u64_to_i64() {
    ut.assert(test_u64_to_i64(UINT64_MIN) == INT64_MIN - INT64_MIN)
    ut.assert(test_u64_to_i64(1) == 1)
    ut.assert(test_u64_to_i64(INT64_MAX) == INT64_MAX)
    ut.assert(test_u64_to_i64(9223372036854775808) == INT64_MIN)
    ut.assert(test_u64_to_i64(18446744073709551614) == -2)
    ut.assert(test_u64_to_i64(UINT64_MAX) == -1)
}

// -----------------------------------------------------------------------------
// uint64 with narrow unsigned operands: all promoted to uint64
// -----------------------------------------------------------------------------

@test
func test_ut_u64_add_u8() {
    ut.assert_uint_eq(test_u64_add_u8(UINT64_MIN, UINT8_MIN), UINT64_MIN)
    ut.assert_uint_eq(test_u64_add_u8(1, 1), 2)
    ut.assert_uint_eq(test_u64_add_u8(9223372036854775808, UINT8_MAX), 9223372036854776063)
    ut.assert_uint_eq(test_u64_add_u8(UINT64_MAX, 1), 0)
    ut.assert_uint_eq(test_u64_add_u8(UINT64_MAX, UINT8_MAX), 254)
}

@test
func test_ut_u64_add_u16() {
    ut.assert_uint_eq(test_u64_add_u16(UINT64_MIN, UINT16_MIN), UINT64_MIN)
    ut.assert_uint_eq(test_u64_add_u16(1, 1), 2)
    ut.assert_uint_eq(test_u64_add_u16(9223372036854775808, 32768), 9223372036854808576)
    ut.assert_uint_eq(test_u64_add_u16(UINT64_MAX, 1), 0)
    ut.assert_uint_eq(test_u64_add_u16(UINT64_MAX, UINT16_MAX), 65534)
}

@test
func test_ut_u64_add_u32() {
    ut.assert_uint_eq(test_u64_add_u32(UINT64_MIN, UINT32_MIN), UINT64_MIN)
    ut.assert_uint_eq(test_u64_add_u32(1, 1), 2)
    ut.assert_uint_eq(test_u64_add_u32(9223372036854775808, 2147483648), 9223372039002259456)
    ut.assert_uint_eq(test_u64_add_u32(UINT64_MAX, 1), 0)
    ut.assert_uint_eq(test_u64_add_u32(UINT64_MAX, UINT32_MAX), 4294967294)
}

@test
func test_ut_u64_add_u64() {
    ut.assert_uint_eq(test_u64_add_u64(UINT64_MIN, UINT64_MIN), UINT64_MIN)
    ut.assert_uint_eq(test_u64_add_u64(1, 1), 2)
    ut.assert_uint_eq(test_u64_add_u64(INT64_MAX, 1), 9223372036854775808)
    ut.assert_uint_eq(test_u64_add_u64(9223372036854775808, 9223372036854775808), 0)
    ut.assert_uint_eq(test_u64_add_u64(UINT64_MAX, 1), 0)
    ut.assert_uint_eq(test_u64_add_u64(UINT64_MAX, UINT64_MAX), 18446744073709551614)
}

// -----------------------------------------------------------------------------
// Subtraction: underflow wraps at UINT64_MAX
// -----------------------------------------------------------------------------

@test
func test_ut_u64_sub_u8() {
    ut.assert_uint_eq(test_u64_sub_u8(1, 1), 0)
    ut.assert_uint_eq(test_u64_sub_u8(256, UINT8_MAX), 1)
    ut.assert_uint_eq(test_u64_sub_u8(9223372036854775808, 1), INT64_MAX)
    ut.assert_uint_eq(test_u64_sub_u8(0, 1), UINT64_MAX)
}

@test
func test_ut_u64_sub_u64() {
    ut.assert_uint_eq(test_u64_sub_u64(10, 20), 18446744073709551606)
    ut.assert_uint_eq(test_u64_sub_u64(UINT64_MAX, UINT64_MAX), 0)
    ut.assert_uint_eq(test_u64_sub_u64(UINT64_MAX, UINT64_MIN), UINT64_MAX)
    ut.assert_uint_eq(test_u64_sub_u64(9223372036854775808, 1), INT64_MAX)
    ut.assert_uint_eq(test_u64_sub_u64(0, 1), UINT64_MAX)
    ut.assert_uint_eq(test_u64_sub_u64(0, UINT64_MAX), 1)
}

// -----------------------------------------------------------------------------
// Multiplication, division, modulo
// -----------------------------------------------------------------------------

@test
func test_ut_u64_mul_u64() {
    ut.assert_uint_eq(test_u64_mul_u64(UINT64_MIN, UINT64_MAX), UINT64_MIN)
    ut.assert_uint_eq(test_u64_mul_u64(1, UINT64_MAX), UINT64_MAX)
    ut.assert_uint_eq(test_u64_mul_u64(2, 3), 6)
    ut.assert_uint_eq(test_u64_mul_u64(4294967296, 4294967296), 0)
    ut.assert_uint_eq(test_u64_mul_u64(UINT64_MAX, 2), 18446744073709551614)
    ut.assert_uint_eq(test_u64_mul_u64(UINT64_MAX, UINT64_MAX), 1)
}

@test
func test_ut_u64_div_u32() {
    ut.assert_uint_eq(test_u64_div_u32(0, 1), 0)
    ut.assert_uint_eq(test_u64_div_u32(1, 1), 1)
    ut.assert_uint_eq(test_u64_div_u32(1, 2), 0)
    ut.assert_uint_eq(test_u64_div_u32(9223372036854775808, 2), 4611686018427387904)
    ut.assert_uint_eq(test_u64_div_u32(UINT64_MAX, 2), 9223372036854775807)
    ut.assert_uint_eq(test_u64_div_u32(UINT64_MAX, UINT8_MAX), 72340172838076673)
    ut.assert_uint_eq(test_u64_div_u32(UINT64_MAX, UINT32_MAX), 4294967297)
}

@test
func test_ut_u64_mod_u16() {
    ut.assert_uint_eq(test_u64_mod_u16(0, 1), 0)
    ut.assert_uint_eq(test_u64_mod_u16(7, 3), 1)
    ut.assert_uint_eq(test_u64_mod_u16(UINT64_MAX, 2), 1)
    ut.assert_uint_eq(test_u64_mod_u16(UINT64_MAX, UINT8_MAX), 0)
    ut.assert_uint_eq(test_u64_mod_u16(UINT64_MAX, UINT16_MAX), 0)
}

@test
func test_ut_u64_mod_u64() {
    ut.assert_uint_eq(test_u64_mod_u64(0, 1), 0)
    ut.assert_uint_eq(test_u64_mod_u64(7, 3), 1)
    ut.assert_uint_eq(test_u64_mod_u64(UINT64_MAX, 2), 1)
    ut.assert_uint_eq(test_u64_mod_u64(UINT64_MAX, UINT64_MAX), 0)
    ut.assert_uint_eq(test_u64_mod_u64(UINT64_MAX, 9223372036854775808), INT64_MAX)
}

// -----------------------------------------------------------------------------
// uint64 with signed operands: explicit cast required, in either direction
// -----------------------------------------------------------------------------

@test
func test_ut_u64_add_i8_as_uint() {
    ut.assert_uint_eq(test_u64_add_i8_as_uint(0, 1), 1)
    ut.assert_uint_eq(test_u64_add_i8_as_uint(1, -1), 0)
    ut.assert_uint_eq(test_u64_add_i8_as_uint(128, INT8_MIN), 0)
    ut.assert_uint_eq(test_u64_add_i8_as_uint(0, -1), UINT64_MAX)
    ut.assert_uint_eq(test_u64_add_i8_as_uint(9223372036854775808, INT8_MIN), 9223372036854775680)
}

@test
func test_ut_u64_add_i64_as_uint() {
    ut.assert_uint_eq(test_u64_add_i64_as_uint(0, 0), 0)
    ut.assert_uint_eq(test_u64_add_i64_as_uint(1, 1), 2)
    ut.assert_uint_eq(test_u64_add_i64_as_uint(1, -1), 0)
    ut.assert_uint_eq(test_u64_add_i64_as_uint(0, -1), UINT64_MAX)
    ut.assert_uint_eq(test_u64_add_i64_as_uint(UINT64_MAX, 1), 0)
    ut.assert_uint_eq(test_u64_add_i64_as_uint(9223372036854775808, INT64_MIN), 0)
}

@test
func test_ut_u64_add_i64_as_int() {
    ut.assert(test_u64_add_i64_as_int(0, 0) == 0)
    ut.assert(test_u64_add_i64_as_int(1, 1) == 2)
    ut.assert(test_u64_add_i64_as_int(1, -1) == 0)
    ut.assert(test_u64_add_i64_as_int(UINT64_MAX, 0) == -1)
    ut.assert(test_u64_add_i64_as_int(UINT64_MAX, 1) == 0)
    ut.assert(test_u64_add_i64_as_int(9223372036854775808, 0) == INT64_MIN)
    ut.assert(test_u64_add_i64_as_int(INT64_MAX, 1) == INT64_MIN)
}

// -----------------------------------------------------------------------------
// Two's complement round trip
// -----------------------------------------------------------------------------

func u64_to_i64(v uint64) int64 {
    return int64(v)
}

func i64_to_u64(v int64) uint64 {
    return uint64(v)
}

@test
func test_ut_u64_twos_complement() {
    ut.assert(u64_to_i64(UINT64_MAX) == -1)
    ut.assert(u64_to_i64(18446744073709551614) == -2)
    ut.assert(u64_to_i64(9223372036854775808) == INT64_MIN)

    ut.assert_uint_eq(i64_to_u64(-1), UINT64_MAX)
    ut.assert_uint_eq(i64_to_u64(-2), 18446744073709551614)
    ut.assert_uint_eq(i64_to_u64(INT64_MIN), 9223372036854775808)
}
