// RUN: koala --test %s
//
// os.run cwd / env options, os.output, and the system information functions.

import "std/os"
import "std/ut"

@test
func test_run_cwd() {
    let (code, out, _) = os.output("sh", ["-c", "pwd -P"], cwd = "/")!
    ut.assert_eq(code, 0)
    ut.assert_eq(out, "/\n")

    // A missing working directory fails the spawn.
    ut.assert(os.run("true", nil, "/tmp/kl_os_run_missing_dir") == nil)
}

@test
func test_run_env() {
    let env = dict[str, str]()
    env["KL_FOO"] = "bar"
    let (_, out, _) = os.output("sh", ["-c", "echo \"$KL_FOO\"; echo \"$HOME\""], env = env)!
    ut.assert_eq(out, "bar\n\n") // the dict is the whole environment: no HOME

    // nil inherits this process's environment.
    os.setenv("KL_OS_RUN_INHERIT", "yes")
    let (_, out2, _) = os.output("sh", ["-c", "echo \"$KL_OS_RUN_INHERIT\""])!
    ut.assert_eq(out2, "yes\n")
    os.unsetenv("KL_OS_RUN_INHERIT")

    // An empty dict gives an empty environment.
    let (_, out3, _) = os.output("sh", ["-c", "echo \"$KL_FOO$HOME\""], env = dict[str, str]())!
    ut.assert_eq(out3, "\n")
}

@test
func test_output() {
    let (code, out, err) = os.output("sh", ["-c", "echo o; echo e 1>&2; exit 3"])!
    ut.assert_eq(code, 3)
    ut.assert_eq(out, "o\n")
    ut.assert_eq(err, "e\n")

    ut.assert(os.output("kl_os_run_no_such_program") == nil)
}

@test
func test_system_info() {
    // the shell's parent is this process
    let (_, out, _) = os.output("sh", ["-c", "echo $PPID"])!
    ut.assert_eq(out, os.getpid().to_str() + "\n")

    ut.assert(os.cpu_count() >= 1)
    ut.assert_eq(os.platform(), "linux")
}

// stdio modes: PIPE (default), INHERIT, DEVNULL, and stderr = STDOUT
@test
func test_run_stdio_modes() {
    // stderr into the stdout pipe (2>&1)
    let p = os.run("sh", ["-c", "echo out; echo err 1>&2"], stderr = os.STDOUT)!
    let (out, err) = p.communicate()!
    ut.assert_eq(out.to_str(), "out\nerr\n")
    ut.assert_eq(err.len(), 0) // not a pipe: empty
    ut.assert_eq(p.wait()!, 0)

    // DEVNULL: no input (EOF at once), output dropped
    let q = os.run("sh", ["-c", "cat; echo dropped"], stdin = os.DEVNULL, stdout = os.DEVNULL)!
    let (qout, _) = q.communicate()!
    ut.assert_eq(qout.len(), 0)
    ut.assert_eq(q.wait()!, 0)

    // INHERIT: the child writes to this process's stdout; nothing to read here
    let r = os.run("true", stdin = os.INHERIT, stdout = os.INHERIT, stderr = os.INHERIT)!
    ut.assert_eq(r.wait()!, 0)
}

@should_panic
func test_run_stdio_not_a_pipe_panics() {
    let p = os.run("true", stdout = os.DEVNULL)!
    p.wait()!
    p.stdout().read_all()
}

@should_panic
func test_run_stdio_invalid_mode_panics() {
    os.run("true", stdin = os.STDOUT) // STDOUT is for stderr only
}

@test
func test_wait_timeout() {
    let p = os.run("sleep", ["10"], stdin = os.DEVNULL)!
    ut.assert(p.wait(0.1) == nil) // still running
    p.kill()
    ut.assert_eq(p.wait(5.0)!, -os.SIGKILL)

    let q = os.run("true")!
    ut.assert_eq(q.wait(5.0)!, 0)
}

@test
func test_communicate_timeout() {
    // finishes in time: like communicate
    let p = os.run("cat")!
    let (out, _) = p.communicate("hi".to_bytes(), 5.0)!
    ut.assert_eq(out.to_str(), "hi")
    ut.assert_eq(p.wait()!, 0)

    // does not finish in time: nil, the child still runs
    let q = os.run("sleep", ["10"])!
    ut.assert(q.communicate(nil, 0.1) == nil)
    ut.assert(q.poll() == nil)
    q.kill()
    ut.assert_eq(q.wait()!, -os.SIGKILL)
}
