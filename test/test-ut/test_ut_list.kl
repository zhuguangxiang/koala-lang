// ---------------------------------------------------------------------------
// __getslice__ positive-step variants + boundary clamping
// ---------------------------------------------------------------------------
@test
func test_list_getslice_steps() {
    let values = [0, 1, 2, 3, 4, 5]

    let s1 = values[1:6:2]           // [1,3,5]
    ut.assert_eq(s1.len(), 3)
    ut.assert_eq(s1[0], 1)
    ut.assert_eq(s1[2], 5)

    let s2 = values[2:6:2]           // [2,4]
    ut.assert_eq(s2.len(), 2)
    ut.assert_eq(s2[1], 4)

    let s3 = values[::3]             // [0,3]
    ut.assert_eq(s3.len(), 2)
    ut.assert_eq(s3[1], 3)

    // out-of-range bounds clamp
    let clamp = values[4:100]        // [4,5]
    ut.assert_eq(clamp.len(), 2)
    ut.assert_eq(clamp[0], 4)

    let neg = values[-4:-1]          // [2,3,4]
    ut.assert_eq(neg.len(), 3)
    ut.assert_eq(neg[0], 2)
    ut.assert_eq(neg[2], 4)

    // empty when start >= end (positive step)
    ut.assert_true(values[3:3].empty())
    ut.assert_true(values[5:1].empty())
}

// ---------------------------------------------------------------------------
// __setslice__ over all RHS source types (never resizes)
// ---------------------------------------------------------------------------
@test
func test_list_setslice_sources() {
    // list RHS equal / longer / shorter
    let a = [1, 2, 3, 4]
    a[1:3] = [7, 8]                  // equal -> [1,7,8,4]
    ut.assert_eq(a.len(), 4)
    ut.assert_eq(a[1], 7)
    ut.assert_eq(a[2], 8)

    a[1:3] = [5, 6, 7, 8, 9]         // longer -> truncate to first 2
    ut.assert_eq(a.len(), 4)
    ut.assert_eq(a[1], 5)
    ut.assert_eq(a[2], 6)

    a[1:3] = [0]                     // shorter -> fill idx1, idx2 keeps 6
    ut.assert_eq(a.len(), 4)
    ut.assert_eq(a[1], 0)
    ut.assert_eq(a[2], 6)

    // range RHS
    let b = [0, 0, 0, 0]
    b[1:4] = range(5, 10)            // slots 3, first 3 range values 5,6,7
    ut.assert_eq(b.len(), 4)
    ut.assert_eq(b[1], 5)
    ut.assert_eq(b[3], 7)
    ut.assert_eq(b[0], 0)            // outside slice untouched

    // tuple RHS
    let c = [0, 0, 0]
    c[0:3] = (7, 8)                  // slots 3, tuple 2 -> idx2 keeps original
    ut.assert_eq(c.len(), 3)
    ut.assert_eq(c[0], 7)
    ut.assert_eq(c[1], 8)
    ut.assert_eq(c[2], 0)

    // stepped slice RHS scatter
    let d = [1, 2, 3, 4, 5]
    d[0:5:2] = [7, 8, 9]             // idx 0,2,4 <- 7,8,9
    ut.assert_eq(d[0], 7)
    ut.assert_eq(d[1], 2)
    ut.assert_eq(d[2], 8)
    ut.assert_eq(d[3], 4)
    ut.assert_eq(d[4], 9)

    // empty slice -> no-op
    let e = [1, 2, 3]
    e[2:1] = [9]
    ut.assert_eq(e.len(), 3)
    ut.assert_eq(e[2], 3)
}

// ---------------------------------------------------------------------------
// __setslice__ over all RHS source types (never resizes)
// ---------------------------------------------------------------------------
@test
func test_list_setslice_sources_variants() {
    // list RHS equal / longer / shorter
    let a = [1, 2, 3, 4]
    a[1:3] = [7, 8]                  // equal -> [1,7,8,4]
    ut.assert_eq(a.len(), 4)
    ut.assert_eq(a[1], 7)
    ut.assert_eq(a[2], 8)

    a[1:3] = [5, 6, 7, 8, 9]         // longer -> truncate to first 2
    ut.assert_eq(a.len(), 4)
    ut.assert_eq(a[1], 5)
    ut.assert_eq(a[2], 6)

    a[1:3] = [0]                     // shorter -> fill idx1, idx2 keeps 6
    ut.assert_eq(a.len(), 4)
    ut.assert_eq(a[1], 0)
    ut.assert_eq(a[2], 6)

    // range RHS
    let b = [0, 0, 0, 0]
    b[1:4] = range(5, 10)            // slots 3, first 3 range values 5,6,7
    ut.assert_eq(b.len(), 4)
    ut.assert_eq(b[1], 5)
    ut.assert_eq(b[3], 7)
    ut.assert_eq(b[0], 0)            // outside slice untouched

    // tuple RHS
    let c = [0, 0, 0]
    c[0:3] = (7, 8)                  // slots 3, tuple 2 -> idx2 keeps original
    ut.assert_eq(c.len(), 3)
    ut.assert_eq(c[0], 7)
    ut.assert_eq(c[1], 8)
    ut.assert_eq(c[2], 0)

    // stepped slice RHS scatter
    let d = [1, 2, 3, 4, 5]
    d[0:5:2] = [7, 8, 9]             // idx 0,2,4 <- 7,8,9
    ut.assert_eq(d[0], 7)
    ut.assert_eq(d[1], 2)
    ut.assert_eq(d[2], 8)
    ut.assert_eq(d[3], 4)
    ut.assert_eq(d[4], 9)

    // empty slice -> no-op
    let e = [1, 2, 3]
    e[2:1] = [9]
    ut.assert_eq(e.len(), 3)
    ut.assert_eq(e[2], 3)
}

// ---------------------------------------------------------------------------
// iter / reversed full drain and step beyond length
// ---------------------------------------------------------------------------
@test
func test_list_iter_drain_edges() {
    // step larger than length yields only the first element
    let v = [10, 20, 30]
    let it = v.iter(5)
    ut.assert_eq(it.next_strict(), 10)
    ut.assert_false(it.has_next())

    // single-element list, forward and reverse
    let one = [99]
    let fi = one.iter()
    ut.assert_eq(fi.next_strict(), 99)
    ut.assert_true(fi.next() == nil)

    let ri = one.reversed()
    ut.assert_eq(ri.next_strict(), 99)
    ut.assert_true(ri.next() == nil)
}

@test_expect_panic("No more elements in ListIter")
func test_list_iter_next_strict_past_end_panics() {
    let v = [1]
    let it = v.iter()
    it.next_strict()
    it.next_strict()                 // exhausted -> panic
}

@test_expect_panic("No more elements in ListRevIter")
func test_list_reviter_next_strict_past_end_panics() {
    let v = [1]
    let it = v.reversed()
    it.next_strict()
    it.next_strict()                 // exhausted -> panic
}

// ---------------------------------------------------------------------------
// iter / reversed construction guard: step <= 0 panics
// ---------------------------------------------------------------------------
@test_expect_panic("Step must be positive")
func test_list_iter_zero_step_panics() {
    let v = [1, 2, 3]
    let it = v.iter(0)
}

@test_expect_panic("Step must be positive")
func test_list_reviter_negative_step_panics() {
    let v = [1, 2, 3]
    let it = v.reversed(-1)
}

// ---------------------------------------------------------------------------
// iter / reversed return a FRESH iterator each call (independent cursors)
// ---------------------------------------------------------------------------
@test
func test_list_iter_fresh_each_call() {
    let v = [1, 2, 3]
    let a = v.iter()
    let b = v.iter()

    ut.assert_eq(a.next_strict(), 1)
    ut.assert_eq(b.next_strict(), 1)  // b starts from scratch, unaffected by a
    ut.assert_eq(a.next_strict(), 2)
    // ut.assert_false(b.has_next() == false && a.has_next() == false)
    ut.assert_eq(b.next_strict(), 2)
}

// ---------------------------------------------------------------------------
// reversed full drain and stepped drain
// ---------------------------------------------------------------------------
@test
func test_list_reversed_drain() {
    let v = [1, 2, 3, 4]
    let it = v.reversed()
    var out = list[int]()
    while it.has_next() {
        out.append(it.next_strict())
    }
    ut.assert_eq(out.len(), 4)
    ut.assert_eq(out[0], 4)
    ut.assert_eq(out[1], 3)
    ut.assert_eq(out[2], 2)
    ut.assert_eq(out[3], 1)

    // stepped reverse: [1,2,3,4,5,6] -> 6,4,2
    let big = [1, 2, 3, 4, 5, 6]
    let sit = big.reversed(2)
    ut.assert_eq(sit.next_strict(), 6)
    ut.assert_eq(sit.next_strict(), 4)
    ut.assert_eq(sit.next_strict(), 2)
    ut.assert_false(sit.has_next())
    ut.assert_true(sit.next() == nil)
}

// ---------------------------------------------------------------------------
// iter / reversed over a WINDOWED view (logical range only)
// ---------------------------------------------------------------------------
@test
func test_list_iter_window_view() {
    let base = [10, 20, 30, 40, 50]
    let v = base[1:4]                // logical [20,30,40]
    let it = v.iter()
    ut.assert_eq(it.next_strict(), 20)
    ut.assert_eq(it.next_strict(), 30)
    ut.assert_eq(it.next_strict(), 40)
    ut.assert_false(it.has_next())

    let rit = v.reversed()
    ut.assert_eq(rit.next_strict(), 40)
    ut.assert_eq(rit.next_strict(), 30)
    ut.assert_eq(rit.next_strict(), 20)
    ut.assert_false(rit.has_next())
}

// ---------------------------------------------------------------------------
// index / count out-of-range bounds are clamped (no panic)
// ---------------------------------------------------------------------------
@test
func test_list_index_count_clamp_bounds() {
    let v = [1, 2, 3, 2, 1]
    ut.assert_eq(v.index(1, 0, 100), 0)   // end clamps to len
    ut.assert_eq(v.index(1, 100), -1)     // start clamps to len -> empty range
    ut.assert_eq(v.index(2, -1), 1)       // negative start clamps to 0
    ut.assert_eq(v.count(2, 0, 100), 2)   // end clamps to len
    ut.assert_eq(v.count(1, 100), 0)      // start beyond range
    ut.assert_eq(v.count(1, -1, 100), 2)  // start clamps to 0, end to len
}

// ---------------------------------------------------------------------------
// pop preserves object references (identity survives removal order)
// ---------------------------------------------------------------------------
@test
func test_list_pop_penguin_refs() {
    let flock = [Penguin("Ping", 2), Penguin("Tux", 5)]
    let last = flock.pop()                // tail penguin
    ut.assert_eq(last.name, "Tux")
    ut.assert_eq(last.age, 5)
    ut.assert_eq(flock.len(), 1)
    ut.assert_eq(flock[0].name, "Ping")

    let head = flock.pop(0)               // head penguin
    ut.assert_eq(head.name, "Ping")
    ut.assert_true(flock.empty())
}

// ---------------------------------------------------------------------------
// copy of an object list keeps element identity (same referenced objects)
// ---------------------------------------------------------------------------
@test
func test_list_copy_object_identity() {
    let p = Penguin("Ek", 1)
    let orig = [p, Penguin("Tux", 5)]
    let c = orig.copy()
    ut.assert_eq(c.len(), 2)

    // same referenced instances (shallow), value-equal and identity-equal
    ut.assert_true(c[0] == p)
    ut.assert_true(orig[0] == c[0])
    // c[0].age = 99                          // mutate through the copy
    // ut.assert_eq(p.age, 99)                // shared instance -> orig sees it
    ut.assert_eq(orig.len(), 2)            // containers still independent
}

// ---------------------------------------------------------------------------
// __contains__ / index / count on empty list
// ---------------------------------------------------------------------------
@test
func test_list_search_empty() {
    let e = list[int]()
    ut.assert_false(1 in e)
    ut.assert_eq(e.index(1), -1)
    ut.assert_eq(e.count(1), 0)
    ut.assert_true(e.empty())
    ut.assert_eq(e.len(), 0)
}

// ---------------------------------------------------------------------------
// getslice whole-list view shares backing (copy-on-write NOT in play)
// ---------------------------------------------------------------------------
@test
func test_list_getslice_whole_view() {
    let base = [1, 2, 3]
    let w = base[:]                    // full window, step==1 -> shared view
    ut.assert_eq(w.len(), 3)
    base[1] = 99                       // mutate parent
    ut.assert_eq(w[1], 99)             // view reflects it (shared backing)
}

// ---------------------------------------------------------------------------
// setslice into a windowed view writes only inside the logical window
// ---------------------------------------------------------------------------
@test
func test_list_setslice_window_view() {
    let base = [1, 2, 3, 4, 5]
    let v = base[1:4]                  // logical [2,3,4], shares backing
    v[0:3] = [7, 8, 9]                 // fill entire window
    ut.assert_eq(v[0], 7)
    ut.assert_eq(v[2], 9)
    ut.assert_eq(base[0], 1)           // outside window untouched
    ut.assert_eq(base[1], 7)           // shared backing updated
     ut.assert_eq(base[3], 9)
    ut.assert_eq(base[4], 5)

    // partial fill within the window: tail slots keep originals
    let base2 = [1, 2, 3, 4, 5]
    let v2 = base2[1:4]                // logical [2,3,4]
    v2[0:2] = [7]                       // slots 2, only idx0 written
    ut.assert_eq(v2[0], 7)
    ut.assert_eq(v2[1], 3)              // preserved
    ut.assert_eq(base2[1], 7)
    ut.assert_eq(base2[2], 3)
}

// ---------------------------------------------------------------------------
// append grows the tail past the initial minimum capacity and keeps order
// ---------------------------------------------------------------------------
@test
func test_list_append_capacity_boundary() {
    let v = list[int]()
    for i in range(0, 20) {            // crosses 4/8/16 doubling thresholds
        v.append(i * 2)
    }
    ut.assert_eq(v.len(), 20)
    ut.assert_eq(v[0], 0)
    ut.assert_eq(v[3], 6)
    ut.assert_eq(v[19], 38)
    ut.assert_true(38 in v)
    ut.assert_false(39 in v)
}

// ---------------------------------------------------------------------------
// insert then remove round-trip restores the original contents
// ---------------------------------------------------------------------------
@test
func test_list_insert_remove_roundtrip() {
    let v = [1, 2, 3, 4]
    v.insert(2, 99)                    // [1,2,99,3,4]
    ut.assert_eq(v.len(), 5)
    v.remove(99)                       // [1,2,3,4]
    ut.assert_eq(v.len(), 4)
    ut.assert_eq(v[0], 1)
    ut.assert_eq(v[1], 2)
    ut.assert_eq(v[2], 3)
    ut.assert_eq(v[3], 4)

    // insert head / remove head
    v.insert(0, 0)                     // [0,1,2,3,4]
    v.remove(0)                        // [1,2,3,4]
    ut.assert_eq(v.len(), 4)
    ut.assert_eq(v[0], 1)

    // insert tail / remove tail
    v.insert(v.len(), 5)               // [1,2,3,4,5]
    v.remove(5)                        // [1,2,3,4]
    ut.assert_eq(v.len(), 4)
    ut.assert_eq(v[3], 4)
}

// ---------------------------------------------------------------------------
// reverse of a typed list preserves element identity ordering
// ---------------------------------------------------------------------------
@test
func test_list_reverse_object_identity() {
    let a = Penguin("A", 1)
    let b = Penguin("B", 2)
    let c = Penguin("C", 3)
    let flock = [a, b, c]
    flock.reverse()                    // [c, b, a]
    ut.assert_eq(flock[0].name, "C")
    ut.assert_eq(flock[1].name, "B")
    ut.assert_eq(flock[2].name, "A")

    // after reverse, index resolves by __eq__ to the new logical position
    ut.assert_eq(flock.index(Penguin("A", 1)), 2)
    ut.assert_eq(flock.index(Penguin("C", 3)), 0)
}

// ---------------------------------------------------------------------------
// extend from another list does not share backing (independent growth)
// ---------------------------------------------------------------------------
@test
func test_list_extend_no_shared_backing() {
    let src = [1, 2, 3]
    let dst = list[int]()
    dst.extend(src)                    // dst copies values, no sharing
    src[0] = 99                        // mutate source
    ut.assert_eq(dst[0], 1)            // destination unaffected
    dst.append(4)                      // grow destination
    ut.assert_eq(src.len(), 3)         // source unaffected
}

// ---------------------------------------------------------------------------
// clear does not shrink capacity: repeated fill reuses the buffer
// ---------------------------------------------------------------------------
@test
func test_list_clear_capacity_reuse() {
    let v = list[int]()
    for i in range(0, 10) {
        v.append(i)
    }
    v.clear()
    ut.assert_true(v.empty())
    for i in range(0, 10) {
        v.append(i * i)
    }
    ut.assert_eq(v.len(), 10)
    ut.assert_eq(v[0], 0)
    ut.assert_eq(v[3], 9)
    ut.assert_eq(v[9], 81)
}

// ---------------------------------------------------------------------------
// getslice/setslice negative single-step window with mixed signs
// ---------------------------------------------------------------------------
@test
func test_list_slice_mixed_sign_bounds() {
    let v = [0, 1, 2, 3, 4, 5, 6]

    let a = v[-3:]                     // [4,5,6]
    ut.assert_eq(a.len(), 3)
    ut.assert_eq(a[0], 4)

    let b = v[1:-2]                    // [1,2,3,4]
    ut.assert_eq(b.len(), 4)
    ut.assert_eq(b[3], 4)

    b[0:4] = [9, 9, 9, 9]             // write back into the shared window
    ut.assert_eq(v[1], 9)
    ut.assert_eq(v[4], 9)
    ut.assert_eq(v[0], 0)              // outside the window
    ut.assert_eq(v[5], 5)
    ut.assert_eq(v[6], 6)
}

// ---------------------------------------------------------------------------
// __setitem__ into a windowed view (element write, no growth -> safe)
// ---------------------------------------------------------------------------
@test
func test_list_setitem_window_view() {
    let base = [1, 2, 3, 4, 5]
    let v = base[1:4]                // logical [2,3,4]
    v[0] = 20                        // writes base[1]
    v[2] = 40                        // writes base[3]
    ut.assert_eq(v[0], 20)
    ut.assert_eq(v[2], 40)
    ut.assert_eq(base[1], 20)        // shared backing updated
    ut.assert_eq(base[3], 40)
    ut.assert_eq(base[0], 1)         // outside the window untouched
    ut.assert_eq(base[4], 5)
    ut.assert_eq(base.len(), 5)
}

