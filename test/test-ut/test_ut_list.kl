// ---------------------------------------------------------------------------
// extend empty / single / order (list+tuple+range fast paths)
// ---------------------------------------------------------------------------
@test
func test_list_extend_edges() {
    let v = [1]
    // v.extend([])                     // empty list: no-op
    ut.assert_eq(v.len(), 1)
    // v.extend(())                     // empty tuple: no-op
    // ut.assert_eq(v.len(), 1)
    v.extend(range(2, 2))            // empty range: no-op
    ut.assert_eq(v.len(), 1)

    v.extend([2])                    // single list element
    ut.assert_eq(v[1], 2)
    v.extend((3,))                   // single tuple element
    ut.assert_eq(v[2], 3)
    v.extend(range(4, 7))            // 4,5,6
    ut.assert_eq(v.len(), 6)
    ut.assert_eq(v[3], 4)
    ut.assert_eq(v[5], 6)
}

// ---------------------------------------------------------------------------
// __add__ empty sides and window-view operand (result always independent)
// ---------------------------------------------------------------------------
@test
func test_list_add_edges() {
    let a = [1, 2, 3]
    let e = list[int]()
    ut.assert_eq((a + e).len(), 3)
    ut.assert_eq((e + a).len(), 3)
    ut.assert_eq((e + e).len(), 0)

    let base = [0, 1, 2, 3, 4]
    let view = base[1:4]             // logical [1,2,3]
    let r = view + [7, 8]
    ut.assert_eq(r.len(), 5)
    ut.assert_eq(r[0], 1)
    ut.assert_eq(r[4], 8)
    r.append(99)
    ut.assert_eq(base.len(), 5)      // parent untouched (result not shared)

    let both_view = base[0:2] + base[3:5]   // [0,1] + [3,4]
    ut.assert_eq(both_view.len(), 4)
    ut.assert_eq(both_view[2], 3)
}

