// ---------------------------------------------------------------------------
// pop every element down to empty
// ---------------------------------------------------------------------------
@test
func test_list_pop_until_empty() {
    let v = [1, 2, 3, 4, 5]
    let popped = list[int]()
    while !v.empty() {
        popped.append(v.pop())
    }
    ut.assert_true(v.empty())
    ut.assert_eq(popped.len(), 5)
    ut.assert_eq(popped[0], 5)       // tail-first drain order
    ut.assert_eq(popped[4], 1)
}

// ---------------------------------------------------------------------------
// extend then search reflects the newly appended elements
// ---------------------------------------------------------------------------
@test
func test_list_extend_then_search() {
    let v = [3]
    v.extend([1, 3, 2, 3])
    ut.assert_eq(v.len(), 5)
    ut.assert_eq(v.index(3), 0)      // first 3 is the original element
    ut.assert_eq(v.index(3, 1), 2)   // first 3 after index 1
    ut.assert_eq(v.index(2), 3)
    ut.assert_eq(v.count(3), 3)
    ut.assert_true(2 in v)
    ut.assert_false(9 in v)
}

// ---------------------------------------------------------------------------
// __add__ result is fully independent: reverse / mutate must not touch operands
// ---------------------------------------------------------------------------
@test
func test_list_add_result_independence() {
    let a = [1, 2]
    let b = [3, 4]
    let c = a + b
    c.reverse()                      // [4,3,2,1]
    ut.assert_eq(c[0], 4)
    ut.assert_eq(c[3], 1)
    ut.assert_eq(a[0], 1)            // operand a untouched
    ut.assert_eq(a.len(), 2)
    ut.assert_eq(b[0], 3)            // operand b untouched
    ut.assert_eq(b.len(), 2)

    c.clear()
    ut.assert_eq(a.len(), 2)
    ut.assert_eq(b.len(), 2)
}

// ---------------------------------------------------------------------------
// indexed traversal over the whole list via len()/__getitem__
// ---------------------------------------------------------------------------
@test
func test_list_indexed_traversal() {
    let v = [10, 20, 30]
    var sum = 0
    for i in range(0, v.len()) {
        sum = sum + v[i]
    }
    ut.assert_eq(sum, 60)

    let base = [1, 2, 3, 4, 5]
    let view = base[1:4]             // logical [2,3,4]
    var vs = 0
    for i in range(0, view.len()) {
        vs = vs + view[i]            // view indices are logical
    }
    ut.assert_eq(vs, 9)
}

// ---------------------------------------------------------------------------
// remove from a windowed view only shifts the logical window
// ---------------------------------------------------------------------------
@test
func test_list_remove_window_view() {
    let base = [1, 2, 3, 4, 5]
    let v = base[1:4]                // logical [2,3,4]
    v.remove(3)                      // remove the middle logical element
    ut.assert_eq(v.len(), 2)
    ut.assert_eq(v[0], 2)
    ut.assert_eq(v[1], 4)
    // ut.assert_true(3 in base)        // parent still holds the other copy
}

// ===========================================================================
// __setslice__ branch/step/length/bounds/element-type matrix (gaps only).
// Invariant under test: set_slice NEVER resizes; it writes exactly
// count = MIN(len(rhs), slots) elements into the slice window, leaving the
// remaining target slots at their original values.
// ===========================================================================

// ---------------------------------------------------------------------------
// range RHS: step!=1 scatter, shorter-than-slots keep-tail, equal length
// ---------------------------------------------------------------------------
@test
func test_list_setslice_range_variants() {
    // range RHS scattered over a stepped slice (idx 0,2,4 <- 10,11,12)
    let a = [0, 0, 0, 0, 0]
    a[0:5:2] = range(10, 20)         // slots 3, range len 10 -> first 3
    ut.assert_eq(a.len(), 5)
    ut.assert_eq(a[0], 10)
    ut.assert_eq(a[1], 0)            // odd slots untouched
    ut.assert_eq(a[2], 11)
    ut.assert_eq(a[3], 0)
    ut.assert_eq(a[4], 12)

    // range RHS SHORTER than slots -> fill prefix, tail slot keeps original
    let b = [1, 2, 3, 4, 5]
    b[1:4] = range(7, 9)             // slots 3 (idx1,2,3), range = 7,8 (len 2)
    ut.assert_eq(b.len(), 5)
    ut.assert_eq(b[1], 7)
    ut.assert_eq(b[2], 8)
    ut.assert_eq(b[3], 4)            // preserved
    ut.assert_eq(b[4], 5)

    // range RHS exactly filling the slice
    let c = [0, 0, 0]
    c[0:3] = range(1, 4)             // 1,2,3
    ut.assert_eq(c[0], 1)
    ut.assert_eq(c[1], 2)
    ut.assert_eq(c[2], 3)
}

// ---------------------------------------------------------------------------
// tuple RHS: step!=1 scatter, equal length, shorter keep-tail
// ---------------------------------------------------------------------------
@test
func test_list_setslice_tuple_variants() {
    // tuple scattered over a stepped slice (idx 0,2,4 <- 7,8,9)
    let a = [0, 0, 0, 0, 0]
    a[0:5:2] = (7, 8, 9)
    ut.assert_eq(a.len(), 5)
    ut.assert_eq(a[0], 7)
    ut.assert_eq(a[1], 0)
    ut.assert_eq(a[2], 8)
    ut.assert_eq(a[3], 0)
    ut.assert_eq(a[4], 9)

    // tuple exactly filling (step==1 memmove)
    let b = [1, 2, 3]
    b[0:3] = (7, 8, 9)
    ut.assert_eq(b[0], 7)
    ut.assert_eq(b[1], 8)
    ut.assert_eq(b[2], 9)

    // tuple shorter -> tail slot keeps original
    let c = [1, 2, 3, 4]
    c[1:4] = (8, 9)                  // slots 3, tuple 2 -> idx3 keeps 4
    ut.assert_eq(c.len(), 4)
    ut.assert_eq(c[1], 8)
    ut.assert_eq(c[2], 9)
    ut.assert_eq(c[3], 4)
}

// ---------------------------------------------------------------------------
// step!=1 edge cases: longer-truncate, negative bounds, empty RHS, empty
// target slice (r==0), step beyond length, full stepped replace
// ---------------------------------------------------------------------------
@test
func test_list_setslice_step_edges() {
    // list RHS LONGER than a stepped slice -> truncate to first `slots`
    let a = [1, 2, 3, 4, 5]
    a[0:5:2] = [7, 8, 9, 10, 11]     // slots 3 -> only 7,8,9 land on idx 0,2,4
    ut.assert_eq(a.len(), 5)
    ut.assert_eq(a[0], 7)
    ut.assert_eq(a[1], 2)
    ut.assert_eq(a[2], 8)
    ut.assert_eq(a[3], 4)
    ut.assert_eq(a[4], 9)

    // negative bounds combined with a step
    let b = [1, 2, 3, 4, 5, 6]
    b[-4:-1:2] = [7, 8]              // start->2, end->5, step 2 -> idx 2,4
    ut.assert_eq(b.len(), 6)
    ut.assert_eq(b[1], 2)            // outside window
    ut.assert_eq(b[2], 7)
    ut.assert_eq(b[3], 4)
    ut.assert_eq(b[4], 8)
    ut.assert_eq(b[5], 6)

    // empty RHS on a stepped slice -> no-op
    let c = [1, 2, 3, 4, 5]
    c[0:5:2] = list[int]()
    ut.assert_eq(c.len(), 5)
    ut.assert_eq(c[0], 1)
    ut.assert_eq(c[2], 3)
    ut.assert_eq(c[4], 5)

    // empty target slice (start == end) -> slice_adjust returns r==0 -> no-op
    let d = [1, 2, 3]
    d[2:2:2] = [9]
    ut.assert_eq(d.len(), 3)
    ut.assert_eq(d[0], 1)
    ut.assert_eq(d[2], 3)

    // step larger than the span -> a single slot
    let e = [1, 2, 3]
    e[0:3:10] = [9]                  // slots 1 (idx 0 only)
    ut.assert_eq(e[0], 9)
    ut.assert_eq(e[1], 2)
    ut.assert_eq(e[2], 3)

    // full stepped replace
    let f = [1, 2, 3, 4, 5, 6]
    f[::2] = [7, 8, 9]               // idx 0,2,4
    ut.assert_eq(f[0], 7)
    ut.assert_eq(f[1], 2)
    ut.assert_eq(f[2], 8)
    ut.assert_eq(f[3], 4)
    ut.assert_eq(f[4], 9)
    ut.assert_eq(f[5], 6)
    ut.assert_eq(f.len(), 6)
}

// ---------------------------------------------------------------------------
// set_slice over object elements (references copied, length invariant)
// ---------------------------------------------------------------------------
@test
func test_list_setslice_object_elements() {
    let a = Penguin("A", 1)
    let b = Penguin("B", 2)
    let l = [Penguin("X", 0), Penguin("Y", 0), Penguin("Z", 0)]
    l[0:2] = [a, b]                  // replace first two by value/identity
    ut.assert_eq(l.len(), 3)
    ut.assert_true(l[0] == a)
    ut.assert_eq(l[0].name, "A")
    ut.assert_eq(l[1].name, "B")
    ut.assert_eq(l[2].name, "Z")     // untouched

    // stepped replace of object elements
    let m = [Penguin("P", 1), Penguin("Q", 2), Penguin("R", 3)]
    m[0:3:2] = [Penguin("New", 9)]   // slots idx 0,2 -> only idx0 written
    ut.assert_eq(m[0].name, "New")
    ut.assert_eq(m[1].name, "Q")     // untouched
    ut.assert_eq(m[2].name, "R")     // preserved (RHS shorter)
}

// ---------------------------------------------------------------------------
// set_slice over str elements
// ---------------------------------------------------------------------------
@test
func test_list_setslice_str_elements() {
    let l = ["a", "b", "c", "d"]
    l[1:3] = ["x", "y"]
    ut.assert_eq(l.len(), 4)
    ut.assert_eq(l[0], "a")
    ut.assert_eq(l[1], "x")
    ut.assert_eq(l[2], "y")
    ut.assert_eq(l[3], "d")

    // longer RHS truncates
    l[0:2] = ["p", "q", "r"]         // slots 2 -> p,q
    ut.assert_eq(l[0], "p")
    ut.assert_eq(l[1], "q")
    ut.assert_eq(l.len(), 4)

    // tuple RHS of strings
    l[2:4] = ("m", "n")
    ut.assert_eq(l[2], "m")
    ut.assert_eq(l[3], "n")
}
