// RUN: koala --test %s

func test_u16_to_u16(n uint16) uint16 { return n }

// Lossless unsigned widening: no explicit cast needed

func test_u16_to_u32(n uint16) uint32 { return n }

func test_u16_to_u64(n uint16) uint64 { return n }

// Lossless signed widening: no explicit cast needed
//
// The whole uint16 range fits int32 and int64.

func test_u16_to_i32(n uint16) int32 { return n }

func test_u16_to_i64(n uint16) int64 { return n }

// Explicit conversion required:
//
// Unsigned narrowing cannot be implicit.

func test_u16_to_u8(n uint16) uint8 { return uint8(n) }

// Explicit conversion required:
//
// uint16 does not fit int8 or int16, so signed narrowing needs a cast.

func test_u16_to_i8(n uint16) int8 { return int8(n) }

func test_u16_to_i16(n uint16) int16 { return int16(n) }

// Arithmetic over unsigned operands only: both are promoted to uint64,
// so the result type is uint64 and underflow wraps at UINT64_MAX.

func test_u16_add_u8(n uint16, m uint8) uint64 { return n + m }

func test_u16_add_u16(n uint16, m uint16) uint64 { return n + m }

func test_u16_sub_u32(n uint16, m uint32) uint64 { return n - m }

func test_u16_mul_u64(n uint16, m uint64) uint64 { return n * m }

func test_u16_div_u32(n uint16, m uint32) uint64 { return n / m }

func test_u16_mod_u32(n uint16, m uint32) uint64 { return n % m }

// Arithmetic with any signed operand: the whole expression is promoted to
// int64, so the result type is `int`.

func test_u16_add_i8(n uint16, m int8) int { return n + m }

func test_u16_mod_i16(n uint16, m int16) int { return n % m }

func test_u16_add_i32(n uint16, m int32) int { return n + m }

func test_u16_div_i64(n uint16, m int64) int { return n / m }

import "std/ut"

// -----------------------------------------------------------------------------
// Conversion tests
// -----------------------------------------------------------------------------

@test
func test_ut_u16_to_u16() {
    ut.assert(test_u16_to_u16(UINT16_MIN) == UINT16_MIN)
    ut.assert(test_u16_to_u16(1) == 1)
    ut.assert(test_u16_to_u16(INT16_MAX) == 32767)
    ut.assert(test_u16_to_u16(32768) == 32768)
    ut.assert(test_u16_to_u16(UINT16_MAX) == UINT16_MAX)
}

@test
func test_ut_u16_to_unsigned_widening() {
    ut.assert(test_u16_to_u32(UINT16_MIN) == UINT32_MIN)
    ut.assert(test_u16_to_u32(32768) == 32768)
    ut.assert(test_u16_to_u32(UINT16_MAX) == UINT16_MAX)

    ut.assert_uint_eq(test_u16_to_u64(UINT16_MIN), UINT64_MIN)
    ut.assert_uint_eq(test_u16_to_u64(32768), 32768)
    ut.assert_uint_eq(test_u16_to_u64(UINT16_MAX), UINT16_MAX)
}

@test
func test_ut_u16_to_signed_widening() {
    ut.assert(test_u16_to_i32(UINT16_MIN) == INT32_MIN - INT32_MIN)
    ut.assert(test_u16_to_i32(INT16_MAX) == 32767)
    ut.assert(test_u16_to_i32(32768) == 32768)
    ut.assert(test_u16_to_i32(UINT16_MAX) == 65535)

    ut.assert(test_u16_to_i64(UINT16_MIN) == INT64_MIN - INT64_MIN)
    ut.assert(test_u16_to_i64(INT16_MAX) == 32767)
    ut.assert(test_u16_to_i64(32768) == 32768)
    ut.assert(test_u16_to_i64(UINT16_MAX) == 65535)
}

// Explicit uint16 -> uint8: the low 8 bits are kept (wrap mode).

@test
func test_ut_u16_to_u8() {
    ut.assert(test_u16_to_u8(UINT16_MIN) == UINT8_MIN)
    ut.assert(test_u16_to_u8(1) == 1)
    ut.assert(test_u16_to_u8(UINT8_MAX) == UINT8_MAX)
    ut.assert(test_u16_to_u8(256) == 0)
    ut.assert(test_u16_to_u8(257) == 1)
    ut.assert(test_u16_to_u8(UINT16_MAX) == UINT8_MAX)
}

// Explicit uint16 -> int8 / int16: same bits, reinterpreted as signed.

@test
func test_ut_u16_to_i8() {
    ut.assert(test_u16_to_i8(UINT16_MIN) == INT8_MIN + 128)
    ut.assert(test_u16_to_i8(1) == 1)
    ut.assert(test_u16_to_i8(INT8_MAX) == INT8_MAX)
    ut.assert(test_u16_to_i8(128) == INT8_MIN)
    ut.assert(test_u16_to_i8(UINT8_MAX) == -1)
    ut.assert(test_u16_to_i8(256) == 0)
    ut.assert(test_u16_to_i8(UINT16_MAX) == -1)
}

@test
func test_ut_u16_to_i16() {
    ut.assert(test_u16_to_i16(UINT16_MIN) == INT16_MIN + 32768)
    ut.assert(test_u16_to_i16(1) == 1)
    ut.assert(test_u16_to_i16(INT16_MAX) == INT16_MAX)
    ut.assert(test_u16_to_i16(32768) == INT16_MIN)
    ut.assert(test_u16_to_i16(65534) == -2)
    ut.assert(test_u16_to_i16(UINT16_MAX) == -1)
}

// -----------------------------------------------------------------------------
// uint16 + uint8
// -----------------------------------------------------------------------------

@test
func test_ut_u16_add_u8() {
    ut.assert_uint_eq(test_u16_add_u8(UINT16_MIN, UINT8_MIN), UINT16_MIN)
    ut.assert_uint_eq(test_u16_add_u8(1, 1), 2)
    ut.assert_uint_eq(test_u16_add_u8(32768, 128), 32896)
    ut.assert_uint_eq(test_u16_add_u8(UINT16_MAX, 1), 65536)
    ut.assert_uint_eq(test_u16_add_u8(UINT16_MAX, UINT8_MAX), 65790)
}

// -----------------------------------------------------------------------------
// uint16 + uint16
// -----------------------------------------------------------------------------

@test
func test_ut_u16_add_u16() {
    ut.assert_uint_eq(test_u16_add_u16(UINT16_MIN, UINT16_MIN), UINT16_MIN)
    ut.assert_uint_eq(test_u16_add_u16(1, 1), 2)
    ut.assert_uint_eq(test_u16_add_u16(32768, 32768), 65536)
    ut.assert_uint_eq(test_u16_add_u16(UINT16_MAX, 1), 65536)
    ut.assert_uint_eq(test_u16_add_u16(UINT16_MAX, UINT16_MAX), 131070)
}

// -----------------------------------------------------------------------------
// uint16 - uint32
//
// Both operands are promoted to uint64, so underflow wraps at UINT64_MAX.
// -----------------------------------------------------------------------------

@test
func test_ut_u16_sub_u32() {
    ut.assert_uint_eq(test_u16_sub_u32(UINT16_MAX, UINT32_MIN), UINT16_MAX)
    ut.assert_uint_eq(test_u16_sub_u32(UINT16_MAX, UINT16_MAX), 0)
    ut.assert_uint_eq(test_u16_sub_u32(UINT16_MAX, 1), 65534)

    ut.assert_uint_eq(test_u16_sub_u32(1, 2), UINT64_MAX)
    ut.assert_uint_eq(test_u16_sub_u32(0, 1), UINT64_MAX)
    ut.assert_uint_eq(test_u16_sub_u32(0, UINT32_MAX), 18446744069414584321)
    ut.assert_uint_eq(test_u16_sub_u32(UINT16_MAX, UINT32_MAX), 18446744069414649856)
}

// -----------------------------------------------------------------------------
// uint16 * uint64
// -----------------------------------------------------------------------------

@test
func test_ut_u16_mul_u64() {
    ut.assert_uint_eq(test_u16_mul_u64(UINT16_MIN, UINT64_MAX), UINT64_MIN)
    ut.assert_uint_eq(test_u16_mul_u64(1, UINT64_MAX), UINT64_MAX)
    ut.assert_uint_eq(test_u16_mul_u64(2, 3), 6)
    ut.assert_uint_eq(test_u16_mul_u64(UINT16_MAX, UINT8_MAX), 16711425)
    ut.assert_uint_eq(test_u16_mul_u64(UINT16_MAX, UINT16_MAX), 4294836225)
}

// -----------------------------------------------------------------------------
// uint16 / uint32 and uint16 % uint32
// -----------------------------------------------------------------------------

@test
func test_ut_u16_div_u32() {
    ut.assert_uint_eq(test_u16_div_u32(0, 1), 0)
    ut.assert_uint_eq(test_u16_div_u32(1, 1), 1)
    ut.assert_uint_eq(test_u16_div_u32(1, 2), 0)
    ut.assert_uint_eq(test_u16_div_u32(UINT16_MAX, 1), UINT16_MAX)
    ut.assert_uint_eq(test_u16_div_u32(UINT16_MAX, UINT8_MAX), 257)
    ut.assert_uint_eq(test_u16_div_u32(UINT16_MAX, 65536), 0)
    ut.assert_uint_eq(test_u16_div_u32(UINT16_MAX, UINT32_MAX), 0)
}

@test
func test_ut_u16_mod_u32() {
    ut.assert_uint_eq(test_u16_mod_u32(0, 1), 0)
    ut.assert_uint_eq(test_u16_mod_u32(7, 3), 1)
    ut.assert_uint_eq(test_u16_mod_u32(UINT16_MAX, UINT8_MAX), 0)
    ut.assert_uint_eq(test_u16_mod_u32(UINT16_MAX, 256), 255)
    ut.assert_uint_eq(test_u16_mod_u32(UINT16_MAX, UINT16_MAX), 0)
    ut.assert_uint_eq(test_u16_mod_u32(UINT16_MAX, UINT32_MAX), UINT16_MAX)
}

// -----------------------------------------------------------------------------
// uint16 with signed operands: the signed domain wins, result type is `int`
// -----------------------------------------------------------------------------

@test
func test_ut_u16_add_i8() {
    ut.assert(test_u16_add_i8(UINT16_MIN, 0) == 0)
    ut.assert(test_u16_add_i8(1, 1) == 2)
    ut.assert(test_u16_add_i8(0, -1) == -1)
    ut.assert(test_u16_add_i8(0, INT8_MIN) == INT8_MIN)
    ut.assert(test_u16_add_i8(UINT16_MAX, -1) == 65534)
    ut.assert(test_u16_add_i8(UINT16_MAX, INT8_MIN) == 65407)
    ut.assert(test_u16_add_i8(UINT16_MAX, INT8_MAX) == 65662)
}

@test
func test_ut_u16_mod_i16() {
    ut.assert(test_u16_mod_i16(0, 1) == 0)
    ut.assert(test_u16_mod_i16(7, 3) == 1)
    ut.assert(test_u16_mod_i16(UINT16_MAX, 1) == 0)
    ut.assert(test_u16_mod_i16(UINT16_MAX, INT16_MAX) == 1)
    ut.assert(test_u16_mod_i16(32768, INT16_MIN) == 0)
    ut.assert(test_u16_mod_i16(UINT16_MAX, INT16_MIN) == 32767)
}

@test
func test_ut_u16_add_i32() {
    ut.assert(test_u16_add_i32(UINT16_MIN, 0) == 0)
    ut.assert(test_u16_add_i32(1, -1) == 0)
    ut.assert(test_u16_add_i32(0, INT32_MIN) == INT32_MIN)
    ut.assert(test_u16_add_i32(0, INT32_MAX) == INT32_MAX)
    ut.assert(test_u16_add_i32(UINT16_MAX, INT32_MAX) == 2147549182)
    ut.assert(test_u16_add_i32(UINT16_MAX, INT32_MIN) == -2147418113)
}

@test
func test_ut_u16_div_i64() {
    ut.assert(test_u16_div_i64(0, 1) == 0)
    ut.assert(test_u16_div_i64(1, 1) == 1)
    ut.assert(test_u16_div_i64(UINT16_MAX, 1) == UINT16_MAX)
    ut.assert(test_u16_div_i64(UINT16_MAX, -1) == -65535)
    ut.assert(test_u16_div_i64(UINT16_MAX, 65536) == 0)
    ut.assert(test_u16_div_i64(UINT16_MAX, INT64_MAX) == 0)
    ut.assert(test_u16_div_i64(UINT16_MAX, INT64_MIN) == 0)
}
