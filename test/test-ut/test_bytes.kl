// --- known failures (recorded; keep commented out until fixed) ---
//
// 1) `~` / unary `-` on a uint operand is still typed uint at compile time,
//    so comparing it directly with a negative literal fails to compile
//    (runtime value is int: print(~c) outputs -98; the int(...) wrappers
//    in test_bitnot_* above are the workaround):
// @test
// func test_bitnot_uint_typed_compare() {
//     let c = b"a"[0]
//     ut.assert(~c == -98)             // error: Value -98 overflows 'uint64' range
//     ut.assert(~uint8(255) == -256)   // error: Value -256 overflows 'uint64' range
//     ut.assert(~uint32(1) == -2)      // error: Value -2 overflows 'uint64' range
//     ut.assert(-c == -97)             // error: Value -97 overflows 'uint64' range
// }
//
// 2) uint8(negative/out-of-range constant) cast checking is inconsistent.
//    Direct forms are rejected at compile time (diagnostics visible via
//    `koalac --cgen`; `koala` run path only prints "compilation failed"):
//      print(uint8(300))    // error: constant integer overflow in cast: cannot cast from int64 to uint8
//      print(uint8(-256))   // error: constant integer overflow in cast: cannot cast negative int64 to uint8
//      print(uint8(-10))    // same error as above
//    but the same negative constant slips through the var-assign + bit-not
//    constant-folding path, storing -10 into a uint8 var:
