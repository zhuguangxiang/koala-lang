// RUN: koala %s --test

import "std/ut"

@test
func test_init_zero() {
    let bs = bytes(10)
    ut.assert_eq(bs.len(), 10)
    for i in range(bs.len()) {
        ut.assert_int_eq(bs[i], 0)
    }
}

@test
func test_empty() {
    let bs = bytes(10)
    ut.assert_false(bs.empty())
    let empty_bs = bytes(0)
    ut.assert_true(empty_bs.empty())
}

@test
func test_index_access() {
    let bs = bytes(10)

    for i in range(bs.len()) {
        bs[i] = uint8(96 + i)
    }

    for i in range(bs.len()) {
        ut.assert_int_eq(bs[i], 96 + i)
    }

    bs[0] = 0xFF
    bs[1] = 0x00
    bs[2] = 0xAB
    ut.assert_int_eq(bs[0], 0xFF)
    ut.assert_int_eq(bs[1], 0x00)
    ut.assert_int_eq(bs[2], 0xAB)
}

@test_expect_panic("bytes index out of range")
func test_index_set_error() {
    let bs = bytes(10)
    bs[10] = 42
}

@test_expect_panic("bytes index out of range")
func test_index_get_error() {
    let bs = bytes(10)
    print(bs[10])
}

@test
func test_index_count() {
    let bs = bytes(10)
    for i in range(bs.len()) {
        bs[i] = uint8(i % 256)
    }

    for i in range(bs.len()) {
        ut.assert_eq(bs.index(uint8(i % 256)), i)
        ut.assert_eq(bs.count(uint8(i % 256)), 1)
    }
}

@test
func test_view() {
    let bs = bytes(10)
    for i in range(bs.len()) {
        bs[i] = uint8(96 + i)
    }

    let v = bs.view(3, 6)
    ut.assert_eq(v.len(), 3)
    v[0] = 68
    ut.assert_int_eq(bs[3], 68)
    ut.assert_int_eq(v[0], 68)
}

@test
func test_content_equality() {
    // == / != compare length and content, not object identity.
    let a = "abc".to_bytes()
    let b = "abc".to_bytes()
    let c = "abd".to_bytes()
    let d = "ab".to_bytes()

    ut.assert_eq(a, a) // same object
    ut.assert_eq(a, b) // equal content, distinct objects
    ut.assert_ne(a, c) // different content
    ut.assert_ne(a, d) // different length
    ut.assert_ne(a, c)
    ut.assert_ne(a, d)

    // views compare by the bytes they reference
    ut.assert_eq(a.view(0, 2), d)
    ut.assert_eq(a.view(1, 3), "bc".to_bytes())
    ut.assert_ne(a.view(0, 2), a.view(1, 3))
}

@test
func test_content_hash() {
    // Equal content must produce identical hashes (Hashable contract).
    let a = "abc".to_bytes()
    let b = "abc".to_bytes()
    ut.assert_eq(a.hash(), b.hash())
    ut.assert_eq(a.hash(), a.view(0, 3).hash())
}

@test
func test_seq_for() {
    let bs = bytes(10)
    for i in range(bs.len()) {
        bs[i] = uint8(96 + i)
    }

    var i = 0
    for b in bs {
        ut.assert_int_eq(b, 96 + i)
        i += 1
    }
}

@test
func test_iter_call() {
    let bs = bytes(10)
    for i in range(bs.len()) {
        bs[i] = uint8(96 + i)
    }

    let it = bs.iter()
    var i = 0
    while let v = it.next() {
        ut.assert_int_eq(v, 96 + i)
        i += 1
    }
}

@test
func test_rev_iter_call() {
    let bs = bytes(10)
    for i in range(bs.len()) {
        bs[i] = uint8(96 + i)
    }

    let it = bs.reversed()
    var i = bs.len() - 1
    while let v = it.next() {
        ut.assert_int_eq(v, 96 + i)
        i -= 1
    }
}

@test
func test_bytes_literal() {
    let b = b"hello"
    ut.assert_eq(b.len(), 5)
    ut.assert_int_eq(b[0], 'h')

    let b2 = bytes(10)
    ut.assert_eq(b2.len(), 10)
    b2.copy(b)
    b2[b.len():b2.len()].copy(b)
    ut.assert_eq(b2[0:b.len()], b)
    ut.assert_eq(b2[b.len():b2.len()], b)
    ut.assert_ne(b2.len(), b.len())
}

@test
func test_bytes_literal_empty() {
    let b = b""
    ut.assert_eq(b.len(), 0)
    ut.assert(b.empty())
    ut.assert_eq(b, b"")
    ut.assert_ne(b, b"x")
}

@test
func test_bytes_literal_escapes() {
    // \\, \" and \xHH each produce a single byte
    let b = b"a\\b\"c\x41\x7e"
    ut.assert_eq(b.len(), 7)
    ut.assert_int_eq(b[1], 0x5C)
    ut.assert_int_eq(b[3], 0x22)
    ut.assert_int_eq(b[5], 0x41)
    ut.assert_int_eq(b[6], 0x7E)

    // high bytes stay raw, no UTF-8 re-encoding
    let hi = b"\xff\x80\x7f"
    ut.assert_eq(hi.len(), 3)
    ut.assert_int_eq(hi[0], 255)
    ut.assert_int_eq(hi[1], 128)
    ut.assert_int_eq(hi[2], 127)
}

@test
func test_bytes_literal_equality() {
    ut.assert_eq(b"abc", b"abc")
    ut.assert_ne(b"abc", b"abd")
    ut.assert_ne(b"abc", b"ab")
    ut.assert_ne(b"ab", b"abc")

    // a literal equals a mutable byte array with the same content
    let m = bytes(4)
    m.fill(uint8(65))
    ut.assert_eq(m, b"AAAA")
    m[0] = uint8(66)
    ut.assert_ne(m, b"AAAA")
    ut.assert_eq(m, b"BAAA")
}

@test
func test_bytes_literal_index_slice() {
    let b = b"hello"
    ut.assert_int_eq(b[0], 'h')
    ut.assert_int_eq(b[4], 'o')
    ut.assert_eq(b[1:3], b"el")
    ut.assert_eq(b[0:b.len()], b)
    ut.assert_eq(b[0:0], b"")
    ut.assert_eq(b"koala".view(0, 2), b"ko")
}

@test
func test_bytes_literal_copy() {
    let src = b"koala"
    let dst = bytes(5)
    let n = dst.copy(src)
    ut.assert_eq(n, 5)
    ut.assert_eq(dst, src)
    ut.assert_eq(dst, b"koala")
}

@test
func test_bytes_literal_str_roundtrip() {
    ut.assert_eq(b"hello".to_str(), "hello")
    ut.assert_eq(b"".to_str(), "")
    ut.assert_eq("hello".to_bytes(), b"hello")
    ut.assert_eq("".to_bytes(), b"")
}

@test
func test_bytes_literal_iter() {
    var sum = 0
    for v in b"abc" {
        sum += v
    }
    ut.assert_eq(sum, 294)

    var n = 0
    var first = 0
    for v in b"xyz".reversed() {
        if n == 0 {
            first = v
        }
        n += 1
    }
    ut.assert_eq(n, 3)
    ut.assert(first == 'z')
}

func echo_bytes(a bytes) bytes { return a }

@test
func test_bytes_literal_param() {
    ut.assert_eq(echo_bytes(b"arg"), b"arg")
    ut.assert_eq(echo_bytes(b""), b"")
}


@test
func test_iter() {
    let bs = bytes(10)
    for i in range(bs.len()) {
        bs[i] = uint8(96 + i)
    }

    var i = 0
    for b in bs.iter() {
        ut.assert_int_eq(96 + i, b)
        i += 1
    }
}

@test
func test_rev_iter() {
    let bs = bytes(10)
    for i in range(bs.len()) {
        bs[i] = uint8(96 + i)
    }

    var i = bs.len() - 1
    for b in bs.reversed() {
        ut.assert_int_eq(96 + i, b)
        i -= 1
    }
}

var g = b"abc"

@test
func test_global_literal() {
    ut.assert_eq(g.len(), 3)
    ut.assert_int_eq(g[0], 97)
    ut.assert_int_eq(g[1], 98)
    ut.assert_int_eq(g[2], 99)

    g = b"def"
    ut.assert_eq(g.len(), 3)
    ut.assert_int_eq(g[0], 100)
    ut.assert_int_eq(g[1], 101)
    ut.assert_int_eq(g[2], 102)
}

@test
func test_special_bytes() {
    ut.assert_eq(b"\n".len(), 1)
    ut.assert_int_eq(b"\n"[0], 10)
    ut.assert_eq(b"\t".len(), 1)
    ut.assert_int_eq(b"\t"[0], 9)
    ut.assert_eq(b"\r".len(), 1)
    ut.assert_int_eq(b"\r"[0], 13)
    ut.assert_eq(b"\"".len(), 1)
    ut.assert_int_eq(b"\""[0], 34)
    ut.assert_eq(b"\\".len(), 1)
    ut.assert_int_eq(b"\\"[0], 92)

    ut.assert_eq(b"你好".len(), 6)
    ut.assert(b"你好" == b"\xe4\xbd\xa0\xe5\xa5\xbd")
    ut.assert_int_eq(b"你好"[0], 0xE4)
    ut.assert_int_eq(b"你好"[5], 0xBD)

    let bs = b"\x00\xff"
    ut.assert_eq(bs.len(), 2)
    ut.assert_int_eq(bs[0], 0)
    ut.assert_int_eq(bs[1], 255)
}

@test
func test_bytes_empty() {
    let bs = b""
    ut.assert_eq(bs.len(), 0)
}

@test
func test_bytes_contains() {
    let bs = b"abc"
    ut.assert( 'a' in bs)
    ut.assert( 'b' in bs)
    ut.assert( 'c' in bs)
    ut.assert_false('d' in bs)

    ut.assert(97 in bs)
    ut.assert(98 in bs)
    ut.assert(99 in bs)
    ut.assert(!(100 in bs))
    ut.assert_false(100 in bs)
}

@test
func test_bytes_misc() {
    let x = int(b"a"[0])
    ut.assert_int_eq(x, 97)
    ut.assert_int_eq(x + 1, 98)
    ut.assert_int_eq(x - 1, 96)
    ut.assert_int_eq(x * 2, 194)
    ut.assert_int_eq(x / 2, 48)
    ut.assert_int_eq(x % 2, 1)
    ut.assert_int_eq(-x, -97)
    ut.assert_int_eq(~x, ~97)
    // ut.assert_int_eq(x & 0xff, 97)
    ut.assert_int_eq(x | 1, 97 | 1)
    ut.assert_int_eq(x ^ 1, 97 ^ 1)

    let y = b"a"[0]
    ut.assert_eq(y, uint8(97))
    ut.assert_eq(y + 1, uint8(98))
    ut.assert_eq(y - 1, uint8(96))
    ut.assert_eq(y * 2, uint8(194))
    ut.assert_eq(y / 2, uint8(48))
    ut.assert_eq(y % 2, uint8(1))
    // unary - / ~ on uint8 yield int at runtime (old wrap-around
    // expectations uint8(159)/uint8(~97) never held, see known failures below)
    ut.assert_eq(int(-y), -97)
    ut.assert_eq(int(~y), -98)
    ut.assert_eq(y & 0xff, uint8(97))
    ut.assert_eq(y | 1, uint8(97 | 1))
    ut.assert_eq(y ^ 1, uint8(97 ^ 1))
}

// --- regression tests: literal bytes / int(uint8) / bit-not fixes ---

let gn = b"\x00\xff"
let gu = b"你好"
let gt = b"\n\t"

@test
func test_global_literal_special() {
    // top-level bytes literals: NUL data, non-ASCII raw bytes, escapes
    ut.assert_eq(gn.len(), 2)
    ut.assert_int_eq(gn[0], 0)
    ut.assert_int_eq(gn[1], 255)
    ut.assert_eq(gu.len(), 6)
    ut.assert(gu == b"\xe4\xbd\xa0\xe5\xa5\xbd")
    ut.assert_int_eq(gu[0], 0xE4)
    ut.assert_int_eq(gu[5], 0xBD)
    ut.assert_eq(gt.len(), 2)
    ut.assert_int_eq(gt[0], 10)
    ut.assert_int_eq(gt[1], 9)
}

@test
func test_int_uint8_cmp() {
    // int(uint8) comparisons: ==/!=/</>/<=/>= against immediates and vars
    let x = int(b"a"[0])
    ut.assert(x == 97)
    ut.assert(x != 98)
    ut.assert(x < 100)
    ut.assert(x > 96)
    ut.assert(x <= 97)
    ut.assert(x >= 97)
    ut.assert_false(x == 98)
    ut.assert_false(x >= 98)
    let y = 98
    ut.assert(x != y)
    ut.assert(x < y)
    ut.assert_eq(x == 97, true)
    ut.assert_eq(x != 98, true)
}

@test
func test_int_uint8_arith() {
    let x = int(b"a"[0])
    ut.assert_eq(x + 1, 98)
    ut.assert_eq(1 + x, 98)
    ut.assert_eq(x - 1, 96)
    let y = 1
    ut.assert_eq(x + y, 98)
    ut.assert_eq(x - y, 96)
    ut.assert_eq(x << 1, 194)
    var s = 0
    let bs = b"abc"
    for i in range(bs.len()) {
        s = s + bs[i]
    }
    ut.assert_eq(s, 294)
}

@test
func test_bitnot_runtime() {
    // ~ on runtime int values (int(uint8) and arithmetic results)
    let x = int(b"a"[0])
    ut.assert_eq(~x, -98)
    ut.assert_eq(~x + 1, -97)
    ut.assert_eq(~(x + 2), -100)
    ut.assert_eq(~~x, 97)
    // ~ / unary - on a runtime raw uint8 yield int
    let c = b"a"[0]
    ut.assert_eq(int(~c), -98)
    ut.assert_eq(int(-c), -97)
}

