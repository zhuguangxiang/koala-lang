// RUN: koala --test %s

import "std/ut"

@should_panic("assertion failed: 1 != 2")
func test_assert_eq_should_fail() {
    ut.assert_eq(1, 2)
}

@should_panic("assertion failed: 5 < 1 is false")
func test_assert_lt_should_fail() {
    ut.assert_lt(5, 1)
}

@should_panic("assertion failed: |1 - 2| = 1 > 1e-09")
func test_assert_close_should_fail() {
    ut.assert_float_close(1.0, 2.0)
}

@intrinsic
func foo() str {}

@native
func bar() str {}

@should_panic("unreachable code executed")
func test_foo_should_fail() {
    foo()
}

@should_panic("func 'bar' in 'test_ut_fail' is not implemented!")
func test_bar_should_fail() {
    bar()
}

@should_panic
func test_panic_without_expected_message() {
    panic("expected any panic")
}

@should_panic("")
func test_panic_with_empty_expected_message() {
    panic("expected any panic")
}
