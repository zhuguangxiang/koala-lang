// RUN: koala %s --test

import "std/ut"

@test_expect_panic("assertion failed: 1 != 2")
func test_assert_eq_should_fail() {
    ut.assert_eq(1, 2)
}

@test_expect_panic("assertion failed: 5 < 1 is false")
func test_assert_lt_should_fail() {
    ut.assert_lt(5, 1)
}

@test_expect_panic("assertion failed: |1 - 2| = 1 > 1.0000000000000001e-09")
func test_assert_close_should_fail() {
    ut.assert_close(1.0, 2.0)
}
