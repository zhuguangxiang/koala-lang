// RUN: koala --test %s

func test_u32_to_u32(n uint32) uint32 { return n }

// Lossless unsigned widening: no explicit cast needed

func test_u32_to_u64(n uint32) uint64 { return n }

// Lossless signed widening: no explicit cast needed
//
// The whole uint32 range fits int64.

func test_u32_to_i64(n uint32) int64 { return n }

// Explicit conversion required:
//
// unsigned narrowing cannot be implicit.

func test_u32_to_u8(n uint32) uint8 { return uint8(n) }

func test_u32_to_u16(n uint32) uint16 { return uint16(n) }

// Explicit conversion required:
//
// uint32 does not fit int8 / int16 / int32, so signed narrowing needs a cast.

func test_u32_to_i8(n uint32) int8 { return int8(n) }

func test_u32_to_i16(n uint32) int16 { return int16(n) }

func test_u32_to_i32(n uint32) int32 { return int32(n) }

// Arithmetic over unsigned operands only: both are promoted to uint64,
// so the result type is uint64 and underflow wraps at UINT64_MAX.

func test_u32_add_u8(n uint32, m uint8) uint64 { return n + m }

func test_u32_add_u16(n uint32, m uint16) uint64 { return n + m }

func test_u32_add_u32(n uint32, m uint32) uint64 { return n + m }

func test_u32_sub_u64(n uint32, m uint64) uint64 { return n - m }

func test_u32_mul_u32(n uint32, m uint32) uint64 { return n * m }

func test_u32_div_u64(n uint32, m uint64) uint64 { return n / m }

func test_u32_mod_u16(n uint32, m uint16) uint64 { return n % m }

// Arithmetic with any signed operand: the whole expression is promoted to
// int64, so the result type is `int`. uint32 fits int64, hence this is lossless.

func test_u32_add_i8(n uint32, m int8) int { return n + m }

func test_u32_mod_i16(n uint32, m int16) int { return n % m }

func test_u32_add_i32(n uint32, m int32) int { return n + m }

func test_u32_div_i64(n uint32, m int64) int { return n / m }

import "std/ut"

// -----------------------------------------------------------------------------
// Conversion tests
// -----------------------------------------------------------------------------

@test
func test_ut_u32_to_u32() {
    ut.assert(test_u32_to_u32(UINT32_MIN) == UINT32_MIN)
    ut.assert(test_u32_to_u32(1) == 1)
    ut.assert(test_u32_to_u32(INT32_MAX) == INT32_MAX)
    ut.assert(test_u32_to_u32(2147483648) == 2147483648)
    ut.assert(test_u32_to_u32(UINT32_MAX) == UINT32_MAX)
}

@test
func test_ut_u32_to_u64() {
    ut.assert_uint_eq(test_u32_to_u64(UINT32_MIN), UINT64_MIN)
    ut.assert_uint_eq(test_u32_to_u64(1), 1)
    ut.assert_uint_eq(test_u32_to_u64(INT32_MAX), INT32_MAX)
    ut.assert_uint_eq(test_u32_to_u64(2147483648), 2147483648)
    ut.assert_uint_eq(test_u32_to_u64(UINT32_MAX), UINT32_MAX)
}

@test
func test_ut_u32_to_i64() {
    ut.assert(test_u32_to_i64(UINT32_MIN) == INT64_MIN - INT64_MIN)
    ut.assert(test_u32_to_i64(1) == 1)
    ut.assert(test_u32_to_i64(INT32_MAX) == INT32_MAX)
    ut.assert(test_u32_to_i64(2147483648) == 2147483648)
    ut.assert(test_u32_to_i64(UINT32_MAX) == 4294967295)
}

// Explicit uint32 -> uint8 / uint16: the low bits are kept (wrap mode).

@test
func test_ut_u32_to_u8() {
    ut.assert(test_u32_to_u8(UINT32_MIN) == UINT8_MIN)
    ut.assert(test_u32_to_u8(1) == 1)
    ut.assert(test_u32_to_u8(UINT8_MAX) == UINT8_MAX)
    ut.assert(test_u32_to_u8(256) == 0)
    ut.assert(test_u32_to_u8(0x01010101) == 1)
    ut.assert(test_u32_to_u8(UINT32_MAX) == UINT8_MAX)
}

@test
func test_ut_u32_to_u16() {
    ut.assert(test_u32_to_u16(UINT32_MIN) == UINT16_MIN)
    ut.assert(test_u32_to_u16(1) == 1)
    ut.assert(test_u32_to_u16(UINT16_MAX) == UINT16_MAX)
    ut.assert(test_u32_to_u16(65536) == 0)
    ut.assert(test_u32_to_u16(0x01010101) == 257)
    ut.assert(test_u32_to_u16(UINT32_MAX) == UINT16_MAX)
}

// Explicit uint32 -> signed: same bits, reinterpreted.

@test
func test_ut_u32_to_i8() {
    ut.assert(test_u32_to_i8(UINT32_MIN) == INT8_MIN + 128)
    ut.assert(test_u32_to_i8(1) == 1)
    ut.assert(test_u32_to_i8(INT8_MAX) == INT8_MAX)
    ut.assert(test_u32_to_i8(128) == INT8_MIN)
    ut.assert(test_u32_to_i8(UINT8_MAX) == -1)
    ut.assert(test_u32_to_i8(256) == 0)
    ut.assert(test_u32_to_i8(UINT32_MAX) == -1)
}

@test
func test_ut_u32_to_i16() {
    ut.assert(test_u32_to_i16(UINT32_MIN) == INT16_MIN + 32768)
    ut.assert(test_u32_to_i16(1) == 1)
    ut.assert(test_u32_to_i16(INT16_MAX) == INT16_MAX)
    ut.assert(test_u32_to_i16(32768) == INT16_MIN)
    ut.assert(test_u32_to_i16(UINT16_MAX) == -1)
    ut.assert(test_u32_to_i16(65536) == 0)
    ut.assert(test_u32_to_i16(UINT32_MAX) == -1)
}

@test
func test_ut_u32_to_i32() {
    ut.assert(test_u32_to_i32(UINT32_MIN) == INT32_MIN + 2147483648)
    ut.assert(test_u32_to_i32(1) == 1)
    ut.assert(test_u32_to_i32(INT32_MAX) == INT32_MAX)
    ut.assert(test_u32_to_i32(2147483648) == INT32_MIN)
    ut.assert(test_u32_to_i32(4294967294) == -2)
    ut.assert(test_u32_to_i32(UINT32_MAX) == -1)
}

// -----------------------------------------------------------------------------
// uint32 + uint8 / uint16 / uint32: unsigned domain, result uint64
// -----------------------------------------------------------------------------

@test
func test_ut_u32_add_u8() {
    ut.assert_uint_eq(test_u32_add_u8(UINT32_MIN, UINT8_MIN), UINT32_MIN)
    ut.assert_uint_eq(test_u32_add_u8(1, 1), 2)
    ut.assert_uint_eq(test_u32_add_u8(0x01010101, UINT8_MAX), 16843264)
    ut.assert_uint_eq(test_u32_add_u8(UINT32_MAX, 1), 4294967296)
    ut.assert_uint_eq(test_u32_add_u8(UINT32_MAX, UINT8_MAX), 4294967550)
}

@test
func test_ut_u32_add_u16() {
    ut.assert_uint_eq(test_u32_add_u16(UINT32_MIN, UINT16_MIN), UINT32_MIN)
    ut.assert_uint_eq(test_u32_add_u16(1, 1), 2)
    ut.assert_uint_eq(test_u32_add_u16(UINT32_MAX, 1), 4294967296)
    ut.assert_uint_eq(test_u32_add_u16(UINT32_MAX, UINT16_MAX), 4295032830)
}

@test
func test_ut_u32_add_u32() {
    ut.assert_uint_eq(test_u32_add_u32(UINT32_MIN, UINT32_MIN), UINT32_MIN)
    ut.assert_uint_eq(test_u32_add_u32(1, 1), 2)
    ut.assert_uint_eq(test_u32_add_u32(2147483648, 2147483648), 4294967296)
    ut.assert_uint_eq(test_u32_add_u32(UINT32_MAX, 1), 4294967296)
    ut.assert_uint_eq(test_u32_add_u32(UINT32_MAX, UINT32_MAX), 8589934590)
}

// -----------------------------------------------------------------------------
// uint32 - uint64
//
// Both operands are promoted to uint64, so underflow wraps at UINT64_MAX.
// -----------------------------------------------------------------------------

@test
func test_ut_u32_sub_u64() {
    ut.assert_uint_eq(test_u32_sub_u64(UINT32_MAX, UINT64_MIN), UINT32_MAX)
    ut.assert_uint_eq(test_u32_sub_u64(UINT32_MAX, UINT32_MAX), 0)
    ut.assert_uint_eq(test_u32_sub_u64(UINT32_MAX, 1), 4294967294)

    ut.assert_uint_eq(test_u32_sub_u64(1, 2), UINT64_MAX)
    ut.assert_uint_eq(test_u32_sub_u64(0, 1), UINT64_MAX)
    ut.assert_uint_eq(test_u32_sub_u64(0, UINT64_MAX), 1)
    ut.assert_uint_eq(test_u32_sub_u64(UINT32_MAX, UINT64_MAX), 4294967296)
}

// -----------------------------------------------------------------------------
// uint32 * uint32: products beyond UINT32_MAX stay exact in uint64
// -----------------------------------------------------------------------------

@test
func test_ut_u32_mul_u32() {
    ut.assert_uint_eq(test_u32_mul_u32(UINT32_MIN, UINT32_MAX), UINT32_MIN)
    ut.assert_uint_eq(test_u32_mul_u32(1, UINT32_MAX), UINT32_MAX)
    ut.assert_uint_eq(test_u32_mul_u32(2, 3), 6)
    ut.assert_uint_eq(test_u32_mul_u32(65536, 65536), 4294967296)
    ut.assert_uint_eq(test_u32_mul_u32(0x01010101, UINT8_MAX), UINT32_MAX)
    ut.assert_uint_eq(test_u32_mul_u32(UINT32_MAX, UINT32_MAX), 18446744065119617025)
}

// -----------------------------------------------------------------------------
// uint32 / uint64 and uint32 % uint16
// -----------------------------------------------------------------------------

@test
func test_ut_u32_div_u64() {
    ut.assert_uint_eq(test_u32_div_u64(0, 1), 0)
    ut.assert_uint_eq(test_u32_div_u64(1, 1), 1)
    ut.assert_uint_eq(test_u32_div_u64(1, 2), 0)
    ut.assert_uint_eq(test_u32_div_u64(UINT32_MAX, 1), UINT32_MAX)
    ut.assert_uint_eq(test_u32_div_u64(UINT32_MAX, UINT8_MAX), 16843009)
    ut.assert_uint_eq(test_u32_div_u64(UINT32_MAX, 65536), 65535)
    ut.assert_uint_eq(test_u32_div_u64(UINT32_MAX, UINT32_MAX), 1)
    ut.assert_uint_eq(test_u32_div_u64(UINT32_MAX, UINT64_MAX), 0)
}

@test
func test_ut_u32_mod_u16() {
    ut.assert_uint_eq(test_u32_mod_u16(0, 1), 0)
    ut.assert_uint_eq(test_u32_mod_u16(7, 3), 1)
    ut.assert_uint_eq(test_u32_mod_u16(65536, UINT16_MAX), 1)
    ut.assert_uint_eq(test_u32_mod_u16(UINT32_MAX, UINT8_MAX), 0)
    ut.assert_uint_eq(test_u32_mod_u16(UINT32_MAX, UINT16_MAX), 0)
}

// -----------------------------------------------------------------------------
// uint32 with signed operands: the signed domain wins, result type is `int`
// -----------------------------------------------------------------------------

@test
func test_ut_u32_add_i8() {
    ut.assert(test_u32_add_i8(UINT32_MIN, 0) == 0)
    ut.assert(test_u32_add_i8(1, 1) == 2)
    ut.assert(test_u32_add_i8(0, -1) == -1)
    ut.assert(test_u32_add_i8(0, INT8_MIN) == INT8_MIN)
    ut.assert(test_u32_add_i8(UINT32_MAX, -1) == 4294967294)
    ut.assert(test_u32_add_i8(UINT32_MAX, INT8_MIN) == 4294967167)
    ut.assert(test_u32_add_i8(UINT32_MAX, INT8_MAX) == 4294967422)
}

@test
func test_ut_u32_mod_i16() {
    ut.assert(test_u32_mod_i16(0, 1) == 0)
    ut.assert(test_u32_mod_i16(7, 3) == 1)
    ut.assert(test_u32_mod_i16(65535, INT16_MAX) == 1)
    ut.assert(test_u32_mod_i16(32768, INT16_MIN) == 0)
    ut.assert(test_u32_mod_i16(UINT32_MAX, INT16_MAX) == 3)
    ut.assert(test_u32_mod_i16(UINT32_MAX, INT16_MIN) == 32767)
}

@test
func test_ut_u32_add_i32() {
    ut.assert(test_u32_add_i32(UINT32_MIN, 0) == 0)
    ut.assert(test_u32_add_i32(1, -1) == 0)
    ut.assert(test_u32_add_i32(0, INT32_MIN) == INT32_MIN)
    ut.assert(test_u32_add_i32(0, INT32_MAX) == INT32_MAX)
    ut.assert(test_u32_add_i32(UINT32_MAX, INT32_MAX) == 6442450942)
    ut.assert(test_u32_add_i32(UINT32_MAX, INT32_MIN) == INT32_MAX)
}

@test
func test_ut_u32_div_i64() {
    ut.assert(test_u32_div_i64(0, 1) == 0)
    ut.assert(test_u32_div_i64(1, 1) == 1)
    ut.assert(test_u32_div_i64(UINT32_MAX, 1) == UINT32_MAX)
    ut.assert(test_u32_div_i64(UINT32_MAX, -1) == -4294967295)
    ut.assert(test_u32_div_i64(UINT32_MAX, 65536) == 65535)
    ut.assert(test_u32_div_i64(UINT32_MAX, INT64_MAX) == 0)
    ut.assert(test_u32_div_i64(UINT32_MAX, INT64_MIN) == 0)
}
