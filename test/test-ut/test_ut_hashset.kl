// update
// ---------------------------------------------------------------------------

@test
func test_hashset_update_from_list() {
    let s = hashset[int]()
    s.add(1)
    s.update([2, 3, 4])
    ut.assert_eq(s.len(), 4)
    ut.assert_true(1 in s)
    ut.assert_true(2 in s)
    ut.assert_true(3 in s)
    ut.assert_true(4 in s)
}

@test
func test_hashset_update_from_hashset() {
    let a = hashset[str]()
    a.add("x")
    a.add("y")

    let b = hashset[str]()
    b.add("y")
    b.add("z")

    a.update(b)
    ut.assert_eq(a.len(), 3)
    ut.assert_true("x" in a)
    ut.assert_true("y" in a)
    ut.assert_true("z" in a)
    // b is untouched
    ut.assert_eq(b.len(), 2)
}

@test
func test_hashset_update_from_range() {
    let s = hashset[int]()
    s.update(range(5))
    ut.assert_eq(s.len(), 5)
    for i in range(5) {
        ut.assert_true(i in s)
    }
}

@test
func test_hashset_update_duplicates_dedup() {
    let s = hashset[int]()
    s.add(1)
    s.update([1, 2, 2, 3, 3, 3])
    ut.assert_eq(s.len(), 3)
    ut.assert_true(1 in s)
    ut.assert_true(2 in s)
    ut.assert_true(3 in s)
}

// ---------------------------------------------------------------------------
// __bitor__  (self | other)
// ---------------------------------------------------------------------------

@test
func test_hashset_bitor_basic() {
    let a = hashset[int]()
    a.add(1)
    a.add(2)

    let b = hashset[int]()
    b.add(2)
    b.add(3)

    let c = a | b
    ut.assert_eq(c.len(), 3)
    ut.assert_true(1 in c)
    ut.assert_true(2 in c)
    ut.assert_true(3 in c)
}

@test
func test_hashset_bitor_empty_self() {
    let a = hashset[int]()
    let b = hashset[int]()
    b.add(1)
    b.add(2)

    let c = a | b
    ut.assert_eq(c.len(), 2)
    ut.assert_true(1 in c)
    ut.assert_true(2 in c)
}

@test
func test_hashset_bitor_empty_other() {
    let a = hashset[int]()
    a.add(1)
    a.add(2)
    let b = hashset[int]()

    let c = a | b
    ut.assert_eq(c.len(), 2)
    ut.assert_true(1 in c)
    ut.assert_true(2 in c)
}

@test
func test_hashset_bitor_self_unchanged() {
    let a = hashset[str]()
    a.add("x")
    let b = hashset[str]()
    b.add("y")

    let c = a | b
    // a and b are not mutated
    ut.assert_eq(a.len(), 1)
    ut.assert_true("x" in a)
    ut.assert_false("y" in a)
    ut.assert_eq(b.len(), 1)
    // c has both
    ut.assert_eq(c.len(), 2)
}

// ---------------------------------------------------------------------------
// __bitand__  (self & other)
// ---------------------------------------------------------------------------

@test
func test_hashset_bitand_basic() {
    let a = hashset[int]()
    a.add(1)
    a.add(2)
    a.add(3)

    let b = hashset[int]()
    b.add(2)
    b.add(3)
    b.add(4)

    let c = a & b
    ut.assert_eq(c.len(), 2)
    ut.assert_true(2 in c)
    ut.assert_true(3 in c)
    ut.assert_false(1 in c)
    ut.assert_false(4 in c)
}

@test
func test_hashset_bitand_disjoint() {
    let a = hashset[int]()
    a.add(1)
    a.add(2)
    let b = hashset[int]()
    b.add(3)
    b.add(4)

    let c = a & b
    ut.assert_eq(c.len(), 0)
    ut.assert_true(c.empty())
}

@test
func test_hashset_bitand_subset() {
    let a = hashset[int]()
    a.add(1)
    a.add(2)
    let b = hashset[int]()
    b.add(1)
    b.add(2)
    b.add(3)

    let c = a & b
    ut.assert_eq(c.len(), 2)
    ut.assert_true(1 in c)
    ut.assert_true(2 in c)
}

@test
func test_hashset_bitand_self_unchanged() {
    let a = hashset[str]()
    a.add("x")
    a.add("y")
    let b = hashset[str]()
    b.add("y")
    b.add("z")

    let c = a & b
    ut.assert_eq(a.len(), 2)
    ut.assert_eq(b.len(), 2)
    ut.assert_eq(c.len(), 1)
    ut.assert_true("y" in c)
}

