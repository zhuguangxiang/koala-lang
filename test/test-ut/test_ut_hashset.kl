}

@test
func test_hashset_is_superset_false() {
    let a = hashset[int]()
    a.add(1)
    a.add(2)

    let b = hashset[int]()
    b.add(1)
    b.add(2)
    b.add(99)

    ut.assert_false(a.is_superset(b))
}

@test
func test_hashset_is_superset_of_empty() {
