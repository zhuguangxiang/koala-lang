// __sub__  (self - other)
// ---------------------------------------------------------------------------

@test
func test_hashset_sub_basic() {
    let a = hashset[int]()
    a.add(1)
    a.add(2)
    a.add(3)

    let b = hashset[int]()
    b.add(2)
    b.add(3)
    b.add(4)

    let c = a - b
    ut.assert_eq(c.len(), 1)
    ut.assert_true(1 in c)
    ut.assert_false(2 in c)
    ut.assert_false(3 in c)
}

@test
func test_hashset_sub_disjoint() {
    let a = hashset[int]()
    a.add(1)
    a.add(2)
    let b = hashset[int]()
    b.add(3)
    b.add(4)

    let c = a - b
    ut.assert_eq(c.len(), 2)
    ut.assert_true(1 in c)
    ut.assert_true(2 in c)
}

@test
func test_hashset_sub_empty_other() {
    let a = hashset[int]()
    a.add(1)
    a.add(2)
    let b = hashset[int]()

    let c = a - b
    ut.assert_eq(c.len(), 2)
    ut.assert_true(1 in c)
    ut.assert_true(2 in c)
}

@test
func test_hashset_sub_self_unchanged() {
    let a = hashset[str]()
    a.add("x")
    a.add("y")
    let b = hashset[str]()
    b.add("x")

    let c = a - b
    ut.assert_eq(a.len(), 2)   // a not mutated
    ut.assert_eq(b.len(), 1)   // b not mutated
    ut.assert_eq(c.len(), 1)
    ut.assert_true("y" in c)
    ut.assert_false("x" in c)
}

// ---------------------------------------------------------------------------
// set algebra — cross-type sources
// ---------------------------------------------------------------------------

@test
func test_hashset_algebra_with_list() {
    let a = hashset[int]()
    a.add(1)
    a.add(2)
    a.add(3)

    // bitor with list source (Sequence path)
    let u = a | [3, 4, 5]
    ut.assert_eq(u.len(), 5)
    for i in range(1, 6) {
        ut.assert_true(i in u)
    }

    // bitand with list source
    let i = a & [2, 3, 99]
    ut.assert_eq(i.len(), 2)
    ut.assert_true(2 in i)
    ut.assert_true(3 in i)

    // sub with list source
    let d = a - [1, 3]
    ut.assert_eq(d.len(), 1)
    ut.assert_true(2 in d)
}

@test
func test_hashset_algebra_str_keys() {
    let a = hashset[str]()
    a.add("apple")
    a.add("banana")
    a.add("cherry")

    let b = hashset[str]()
    b.add("banana")
    b.add("date")

    let u = a | b
    ut.assert_eq(u.len(), 4)
    ut.assert_true("apple" in u)
    ut.assert_true("banana" in u)
    ut.assert_true("cherry" in u)
    ut.assert_true("date" in u)

    let i = a & b
    ut.assert_eq(i.len(), 1)
    ut.assert_true("banana" in i)

    let d = a - b
    ut.assert_eq(d.len(), 2)
    ut.assert_true("apple" in d)
    ut.assert_true("cherry" in d)
    ut.assert_false("banana" in d)
}

