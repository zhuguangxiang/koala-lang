// RUN: koala %s --test

import "std/ut"

// A user class used as a hashset element with value semantics. Every Koala
// class auto-injects default __eq__/hash (identity semantics), so a value-
// semantic element must override BOTH so that equal values collide on the
// same bucket and compare equal inside the bucket chain — the equal-values-
// same-hash contract. Without the explicit hash() override, hashset lookups
// with an equivalent-but-distinct instance would miss.
class Point {
    let x int
    let y int

    func __init__(_x int, _y int) {
        x = _x
        y = _y
    }

    func __eq__(rhs Point) bool {
        return x == rhs.x && y == rhs.y
    }

    func __ne__(rhs Point) bool {
        return x != rhs.x || y != rhs.y
    }

    func hash() int {
        return x * 31 + y
    }
}

// A user class WITHOUT __eq__/hash override — falls back to identity
// semantics, so two structurally-equal instances are distinct elements.
class Tag {
    let name str

    func __init__(n str) { name = n }
}

// ---------------------------------------------------------------------------
// Construction / basic state
// ---------------------------------------------------------------------------

@test
func test_hashset_init_empty_int() {
    let s = hashset[int]()
    ut.assert_eq(s.len(), 0)
    ut.assert_true(s.empty())
}

@test
func test_hashset_init_empty_str() {
    let s = hashset[str]()
    ut.assert_eq(s.len(), 0)
    ut.assert_true(s.empty())
}

@test
func test_hashset_init_empty_float() {
    let s = hashset[float]()
    ut.assert_eq(s.len(), 0)
    ut.assert_true(s.empty())
}

@test
func test_hashset_init_empty_bool() {
    let s = hashset[bool]()
    ut.assert_eq(s.len(), 0)
    ut.assert_true(s.empty())
}

// ---------------------------------------------------------------------------
// add — return value semantics
// ---------------------------------------------------------------------------

@test
func test_hashset_add_first_returns_true() {
    let s = hashset[int]()
    ut.assert_true(s.add(1))
    ut.assert_eq(s.len(), 1)
}

@test
func test_hashset_add_duplicate_returns_false() {
    let s = hashset[int]()
    ut.assert_true(s.add(42))
    ut.assert_false(s.add(42))
    ut.assert_false(s.add(42))
    ut.assert_eq(s.len(), 1)
}

@test
func test_hashset_add_multiple_unique() {
    let s = hashset[str]()
    ut.assert_true(s.add("a"))
    ut.assert_true(s.add("b"))
    ut.assert_true(s.add("c"))
    ut.assert_eq(s.len(), 3)
    ut.assert_false(s.empty())
}

@test
func test_hashset_add_idempotent_len_stable() {
    let s = hashset[int]()
    ut.assert_true(s.add(7))
    ut.assert_false(s.add(7))
    ut.assert_false(s.add(7))
    // Repeat adds never change len.
    for i in range(5) {
        s.add(7)
    }
    ut.assert_eq(s.len(), 1)
}

// ---------------------------------------------------------------------------
// len / empty transitions
// ---------------------------------------------------------------------------

@test
func test_hashset_len_grows_with_unique_adds() {
    let s = hashset[int]()
    ut.assert_eq(s.len(), 0)
    for i in range(10) {
        s.add(i)
    }
    ut.assert_eq(s.len(), 10)
    ut.assert_false(s.empty())
}

@test
func test_hashset_len_stable_on_duplicate_adds() {
    let s = hashset[int]()
    for i in range(10) {
        s.add(i)
    }
    // Re-add the same 10 elements; len must not move.
    for i in range(10) {
        ut.assert_false(s.add(i))
    }
    ut.assert_eq(s.len(), 10)
}

@test
func test_hashset_empty_flips_after_first_add() {
    let s = hashset[str]()
    ut.assert_true(s.empty())
    s.add("x")
    ut.assert_false(s.empty())
}

// ---------------------------------------------------------------------------
// __contains__
// ---------------------------------------------------------------------------

@test
func test_hashset_contains_empty_always_false() {
    let s = hashset[str]()
    ut.assert_false("" in s)
    ut.assert_false("anything" in s)

    let t = hashset[int]()
    ut.assert_false(0 in t)
    ut.assert_false(-1 in t)
}

@test
func test_hashset_contains_str_present_and_missing() {
    let s = hashset[str]()
    s.add("apple")
    s.add("pear")

    ut.assert_true("apple" in s)
    ut.assert_true("pear" in s)
    ut.assert_false("orange" in s)
    ut.assert_false("" in s)
    ut.assert_false("Apple" in s)   // case-sensitive
}

@test
func test_hashset_contains_int_present_and_missing() {
    let s = hashset[int]()
    s.add(1)
    s.add(2)
    s.add(3)

    ut.assert_true(1 in s)
    ut.assert_true(2 in s)
    ut.assert_true(3 in s)
    ut.assert_false(0 in s)
    ut.assert_false(4 in s)
    ut.assert_false(-1 in s)
}

@test
func test_hashset_contains_int_negative_and_zero() {
    let s = hashset[int]()
    s.add(0)
    s.add(-1)
    s.add(-9223372036854775808)   // int64 min
    s.add(9223372036854775807)    // int64 max

    ut.assert_true(0 in s)
    ut.assert_true(-1 in s)
    ut.assert_true(-9223372036854775808 in s)
    ut.assert_true(9223372036854775807 in s)
    ut.assert_false(1 in s)
    ut.assert_eq(s.len(), 4)
}

@test
func test_hashset_contains_float() {
    let s = hashset[float]()
    s.add(1.5)
    s.add(-0.25)
    s.add(3.0)

    ut.assert_true(1.5 in s)
    ut.assert_true(-0.25 in s)
    ut.assert_true(3.0 in s)
    ut.assert_false(0.0 in s)
    ut.assert_false(1.6 in s)
}

@test
func test_hashset_contains_bool() {
    let s = hashset[bool]()
    ut.assert_true(s.add(true))
    ut.assert_true(s.add(false))
    ut.assert_eq(s.len(), 2)

    ut.assert_true(true in s)
    ut.assert_true(false in s)

    // Duplicates collapse via the bool fast-path.
    ut.assert_false(s.add(true))
    ut.assert_false(s.add(false))
    ut.assert_eq(s.len(), 2)
}

@test
func test_hashset_contains_after_duplicate_add() {
    let s = hashset[str]()
    s.add("k")
    s.add("k")
    s.add("k")
    ut.assert_true("k" in s)
    ut.assert_eq(s.len(), 1)
}

// ---------------------------------------------------------------------------
// eq fast-path coverage: int widths
// ---------------------------------------------------------------------------

@test
func test_hashset_int8_dedup() {
    let s = hashset[int8]()
    ut.assert_true(s.add(int8(1)))
    ut.assert_true(s.add(int8(2)))
    ut.assert_false(s.add(int8(1)))
    ut.assert_eq(s.len(), 2)
    ut.assert_true(int8(1) in s)
    ut.assert_true(int8(2) in s)
    ut.assert_false(int8(3) in s)
    ut.assert_true(s.add(int8(-128)))
    ut.assert_true(s.add(int8(127)))
    ut.assert_false(s.add(int8(-128)))
    ut.assert_eq(s.len(), 4)
}

@test
func test_hashset_int16_dedup() {
    let s = hashset[int16]()
    s.add(int16(1000))
    s.add(int16(-1000))
    ut.assert_false(s.add(int16(1000)))
    ut.assert_eq(s.len(), 2)
    ut.assert_true(int16(1000) in s)
    ut.assert_true(int16(-1000) in s)
    ut.assert_false(int16(0) in s)
}

@test
func test_hashset_int32_dedup() {
    let s = hashset[int32]()
    s.add(int32(100000))
    s.add(int32(-100000))
    ut.assert_false(s.add(int32(100000)))
    ut.assert_eq(s.len(), 2)
    ut.assert_true(int32(100000) in s)
    ut.assert_false(int32(200000) in s)
}

@test
func test_hashset_int64_dedup() {
    let s = hashset[int64]()
    s.add(int64(1))
    s.add(int64(2))
    ut.assert_false(s.add(int64(1)))
    ut.assert_eq(s.len(), 2)
    ut.assert_true(int64(1) in s)
    ut.assert_false(int64(3) in s)
}

// ---------------------------------------------------------------------------
// eq fast-path coverage: uint widths
// ---------------------------------------------------------------------------

@test
func test_hashset_uint8_dedup() {
    let s = hashset[uint8]()
    ut.assert_true(s.add(uint8(0)))
    ut.assert_true(s.add(uint8(255)))
    ut.assert_false(s.add(uint8(0)))
    ut.assert_false(s.add(uint8(255)))
    ut.assert_eq(s.len(), 2)
    ut.assert_true(uint8(0) in s)
    ut.assert_true(uint8(255) in s)
    ut.assert_false(uint8(128) in s)
}

@test
func test_hashset_uint16_dedup() {
    let s = hashset[uint16]()
    s.add(uint16(65535))
    s.add(uint16(0))
    ut.assert_false(s.add(uint16(65535)))
    ut.assert_eq(s.len(), 2)
    ut.assert_true(uint16(65535) in s)
    ut.assert_false(uint16(1) in s)
}

@test
func test_hashset_uint32_dedup() {
    let s = hashset[uint32]()
    s.add(uint32(4294967295))
    s.add(uint32(1))
    ut.assert_false(s.add(uint32(4294967295)))
    ut.assert_eq(s.len(), 2)
    ut.assert_true(uint32(1) in s)
    ut.assert_false(uint32(2) in s)
}

@test
func test_hashset_uint64_dedup() {
    let s = hashset[uint64]()
    s.add(uint64(1))
    s.add(uint64(18446744073709551615))
    ut.assert_false(s.add(uint64(1)))
    ut.assert_eq(s.len(), 2)
    ut.assert_true(uint64(18446744073709551615) in s)
    ut.assert_false(uint64(0) in s)
}

// ---------------------------------------------------------------------------
// eq fast-path coverage: float widths
// ---------------------------------------------------------------------------

@test
func test_hashset_float32_dedup() {
    let s = hashset[float32]()
    ut.assert_true(s.add(float32(1.5)))
    ut.assert_true(s.add(float32(-2.25)))
    ut.assert_false(s.add(float32(1.5)))
    ut.assert_eq(s.len(), 2)
    ut.assert_true(float32(1.5) in s)
    ut.assert_true(float32(-2.25) in s)
    ut.assert_false(float32(0.0) in s)
}

@test
func test_hashset_float64_dedup() {
    let s = hashset[float64]()
    s.add(float64(3.14159))
    s.add(float64(-0.0))
    s.add(float64(0.0))
    // -0.0 == 0.0 numerically, so the second add of the pair collapses.
    ut.assert_eq(s.len(), 2)
    ut.assert_true(float64(3.14159) in s)
    ut.assert_false(s.add(float64(3.14159)))
}

// ---------------------------------------------------------------------------
// eq fast-path coverage: bool (at most two distinct elements)
// ---------------------------------------------------------------------------

@test
func test_hashset_bool_max_two_elements() {
    let s = hashset[bool]()
    ut.assert_true(s.add(false))
    ut.assert_true(s.add(true))
    ut.assert_false(s.add(false))
    ut.assert_false(s.add(true))
    ut.assert_eq(s.len(), 2)
}

// ---------------------------------------------------------------------------
// eq via kl_call_eq: str keys
// ---------------------------------------------------------------------------

@test
func test_hashset_str_dedup() {
    let s = hashset[str]()
    ut.assert_true(s.add("hello"))
    ut.assert_true(s.add("world"))
    ut.assert_false(s.add("hello"))
    ut.assert_false(s.add("world"))
    ut.assert_true(s.add(""))
    ut.assert_eq(s.len(), 3)

    ut.assert_true("hello" in s)
    ut.assert_true("" in s)
    ut.assert_false("HELLO" in s)
    ut.assert_false("hell" in s)
}

// ---------------------------------------------------------------------------
// eq via kl_call_eq: class key WITH __eq__/hash override
// ---------------------------------------------------------------------------

@test
func test_hashset_class_key_value_eq_and_hash() {
    let s = hashset[Point]()
    ut.assert_true(s.add(Point(0, 0)))
    ut.assert_true(s.add(Point(1, 1)))
    ut.assert_true(s.add(Point(1, 2)))
    ut.assert_eq(s.len(), 3)

    // Structurally-equal-but-distinct instances must be treated as duplicates.
    ut.assert_false(s.add(Point(0, 0)))
    ut.assert_false(s.add(Point(1, 1)))
    ut.assert_eq(s.len(), 3)
}

@test
func test_hashset_class_key_dedup_by_value() {
    let s = hashset[Point]()
    s.add(Point(1, 2))
    s.add(Point(1, 3))
    s.add(Point(2, 2))
    s.add(Point(5, 6))

    ut.assert_eq(s.len(), 4)
    ut.assert_true(Point(1, 2) in s)
    ut.assert_true(Point(1, 3) in s)
    ut.assert_true(Point(2, 2) in s)
    ut.assert_true(Point(5, 6) in s)
    ut.assert_false(Point(0, 0) in s)
    ut.assert_false(Point(2, 1) in s)
}

// ---------------------------------------------------------------------------
// eq via identity: class key WITHOUT override
// ---------------------------------------------------------------------------

@test
func test_hashset_class_key_identity_no_override() {
    let s = hashset[Tag]()
    let a = Tag("x")
    let b = Tag("x")   // structurally identical, distinct instance

    ut.assert_true(s.add(a))
    // Identity semantics: b is a different element even though name matches.
    ut.assert_true(s.add(b))
    ut.assert_eq(s.len(), 2)

    ut.assert_true(a in s)
    ut.assert_true(b in s)
    ut.assert_false(Tag("x") in s)   // a third distinct instance

    // Re-adding the same instance collapses.
    ut.assert_false(s.add(a))
    ut.assert_false(s.add(b))
    ut.assert_eq(s.len(), 2)
}

// ---------------------------------------------------------------------------
// Scale
// ---------------------------------------------------------------------------

@test
func test_hashset_many_unique_int_adds() {
    let s = hashset[int]()
    for i in range(1000) {
        ut.assert_true(s.add(i))
    }
    ut.assert_eq(s.len(), 1000)
    ut.assert_false(s.empty())

    for i in range(1000) {
        ut.assert_true(i in s)
    }
    ut.assert_false(1000 in s)
    ut.assert_false(-1 in s)
}

@test
func test_hashset_many_duplicate_adds() {
    let s = hashset[int]()
    ut.assert_true(s.add(99))
    for i in range(100) {
        ut.assert_false(s.add(99))
    }
    ut.assert_eq(s.len(), 1)
    ut.assert_true(99 in s)
}

// ---------------------------------------------------------------------------
// remove — return value semantics
// ---------------------------------------------------------------------------

@test
func test_hashset_remove_present_returns_true() {
    let s = hashset[str]()
    s.add("a")
    s.add("b")
    s.add("c")

    ut.assert_true(s.remove("b"))
    ut.assert_eq(s.len(), 2)
    ut.assert_false("b" in s)
    ut.assert_true("a" in s)
    ut.assert_true("c" in s)
}

@test
func test_hashset_remove_absent_returns_false() {
    let s = hashset[int]()
    s.add(1)
    s.add(2)

    ut.assert_false(s.remove(3))
    ut.assert_false(s.remove(0))
    ut.assert_false(s.remove(-1))
    ut.assert_eq(s.len(), 2)
}

@test
func test_hashset_remove_from_empty_returns_false() {
    let s = hashset[str]()
    ut.assert_false(s.remove("anything"))
    ut.assert_false(s.remove(""))
    ut.assert_eq(s.len(), 0)
    ut.assert_true(s.empty())
}

@test
func test_hashset_remove_idempotent_second_returns_false() {
    let s = hashset[int]()
    s.add(42)

    ut.assert_true(s.remove(42))
    ut.assert_false(s.remove(42))
    ut.assert_false(s.remove(42))
    ut.assert_eq(s.len(), 0)
}

@test
func test_hashset_remove_all_one_by_one() {
    let s = hashset[str]()
    s.add("x")
    s.add("y")
    s.add("z")

    ut.assert_true(s.remove("x"))
    ut.assert_true(s.remove("y"))
    ut.assert_true(s.remove("z"))

    ut.assert_eq(s.len(), 0)
    ut.assert_true(s.empty())
    ut.assert_false("x" in s)
}

// ---------------------------------------------------------------------------
// remove — type coverage (same eq fast-paths as add / __contains__)
// ---------------------------------------------------------------------------

@test
func test_hashset_remove_str() {
    let s = hashset[str]()
    s.add("hello")
    s.add("world")
    s.add("")

    ut.assert_true(s.remove("hello"))
    ut.assert_true(s.remove(""))
    ut.assert_false(s.remove("HELLO"))   // case-sensitive miss
    ut.assert_false(s.remove("hell"))     // prefix miss
    ut.assert_eq(s.len(), 1)
    ut.assert_true("world" in s)
}

@test
func test_hashset_remove_int_widths() {
    let s8 = hashset[int8]()
    s8.add(int8(-128))
    s8.add(int8(127))
    ut.assert_true(s8.remove(int8(-128)))
    ut.assert_false(s8.remove(int8(-128)))
    ut.assert_eq(s8.len(), 1)

    let s16 = hashset[int16]()
    s16.add(int16(1000))
    ut.assert_true(s16.remove(int16(1000)))
    ut.assert_eq(s16.len(), 0)

    let s32 = hashset[int32]()
    s32.add(int32(-100000))
    ut.assert_true(s32.remove(int32(-100000)))
    ut.assert_eq(s32.len(), 0)

    let s64 = hashset[int64]()
    s64.add(int64(9223372036854775807))
    ut.assert_true(s64.remove(int64(9223372036854775807)))
    ut.assert_eq(s64.len(), 0)
}

@test
func test_hashset_remove_float() {
    let s32 = hashset[float32]()
    s32.add(float32(1.5))
    s32.add(float32(-2.25))
    ut.assert_true(s32.remove(float32(1.5)))
    ut.assert_false(s32.remove(float32(1.5)))
    ut.assert_eq(s32.len(), 1)
    ut.assert_true(float32(-2.25) in s32)

    // -0.0 and +0.0 collapse after the floatobj.c hash/eq normalization:
    // adding one and removing the other must succeed.
    let s64 = hashset[float64]()
    ut.assert_true(s64.add(float64(-0.0)))
    ut.assert_false(s64.add(float64(0.0)))   // duplicate under IEEE ==
    ut.assert_eq(s64.len(), 1)
    ut.assert_true(s64.remove(float64(0.0)))
    ut.assert_eq(s64.len(), 0)
    ut.assert_false(float64(-0.0) in s64)
}

@test
func test_hashset_remove_bool() {
    let s = hashset[bool]()
    s.add(true)
    s.add(false)
    ut.assert_eq(s.len(), 2)

    ut.assert_true(s.remove(true))
    ut.assert_false(s.remove(true))
    ut.assert_eq(s.len(), 1)
    ut.assert_false(true in s)
    ut.assert_true(false in s)

    ut.assert_true(s.remove(false))
    ut.assert_eq(s.len(), 0)
    ut.assert_true(s.empty())
}

@test
func test_hashset_remove_class_key_value_eq() {
    let s = hashset[Point]()
    s.add(Point(1, 2))
    s.add(Point(3, 4))
    s.add(Point(5, 6))

    // Remove by an equal-but-distinct instance: must hit via user __eq__
    // + hash override.
    ut.assert_true(s.remove(Point(3, 4)))
    ut.assert_eq(s.len(), 2)
    ut.assert_false(Point(3, 4) in s)
    ut.assert_true(Point(1, 2) in s)
    ut.assert_true(Point(5, 6) in s)

    // Second removal of the same value misses.
    ut.assert_false(s.remove(Point(3, 4)))
    ut.assert_eq(s.len(), 2)
}

// ---------------------------------------------------------------------------
// add / remove interleaved
// ---------------------------------------------------------------------------

@test
func test_hashset_add_remove_readd() {
    let s = hashset[int]()
    ut.assert_true(s.add(7))
    ut.assert_eq(s.len(), 1)

    ut.assert_true(s.remove(7))
    ut.assert_eq(s.len(), 0)

    // Re-adding the same value is a fresh insert.
    ut.assert_true(s.add(7))
    ut.assert_eq(s.len(), 1)
    ut.assert_true(7 in s)
}

@test
func test_hashset_remove_contains_consistency() {
    let s = hashset[str]()
    s.add("k")
    ut.assert_true("k" in s)

    s.remove("k")
    ut.assert_false("k" in s)

    // Containment flips back after re-add.
    s.add("k")
    ut.assert_true("k" in s)
}

// ---------------------------------------------------------------------------
// clear
// ---------------------------------------------------------------------------

@test
func test_hashset_clear_empty_noop() {
    let s = hashset[int]()
    s.clear()
    ut.assert_eq(s.len(), 0)
    ut.assert_true(s.empty())
    // Clearing twice is also a no-op.
    s.clear()
    ut.assert_eq(s.len(), 0)
}

@test
func test_hashset_clear_non_empty() {
    let s = hashset[str]()
    s.add("a")
    s.add("b")
    s.add("c")
    ut.assert_eq(s.len(), 3)

    s.clear()

    ut.assert_eq(s.len(), 0)
    ut.assert_true(s.empty())
    ut.assert_false("a" in s)
    ut.assert_false("b" in s)
    ut.assert_false("c" in s)
}

@test
func test_hashset_clear_then_reuse() {
    let s = hashset[int]()
    s.add(1)
    s.add(2)
    s.clear()

    // Post-clear the set must be fully usable: hashmap_init has been
    // reinstalled, so add / contains / remove / len all work again.
    ut.assert_true(s.add(10))
    ut.assert_true(s.add(20))
    ut.assert_false(s.add(10))
    ut.assert_eq(s.len(), 2)
    ut.assert_true(10 in s)
    ut.assert_true(20 in s)
    ut.assert_false(1 in s)   // pre-clear elements stay gone
    ut.assert_true(s.remove(10))
    ut.assert_eq(s.len(), 1)
}

@test
func test_hashset_clear_twice() {
    let s = hashset[int]()
    s.add(1)
    s.clear()
    s.clear()
    ut.assert_eq(s.len(), 0)
    ut.assert_true(s.empty())
}

// ---------------------------------------------------------------------------
// remove / clear at scale
// ---------------------------------------------------------------------------

@test
func test_hashset_remove_many_elements() {
    let s = hashset[int]()
    for i in range(1000) {
        s.add(i)
    }
    ut.assert_eq(s.len(), 1000)

    // Remove the first half; each removal must report true exactly once.
    for i in range(500) {
        ut.assert_true(s.remove(i))
    }
    ut.assert_eq(s.len(), 500)

    // Removed elements are gone; the surviving half is untouched.
    for i in range(500) {
        ut.assert_false(i in s)
        ut.assert_false(s.remove(i))   // second removal misses
    }
    for i in range(500, 1000) {
        ut.assert_true(i in s)
    }
}

@test
func test_hashset_clear_large_set() {
    let s = hashset[int]()
    for i in range(1000) {
        s.add(i)
    }
    ut.assert_eq(s.len(), 1000)

    s.clear()

    ut.assert_eq(s.len(), 0)
    ut.assert_true(s.empty())
    for i in range(1000) {
        ut.assert_false(i in s)
    }
}

// ---------------------------------------------------------------------------
// to_list
// ---------------------------------------------------------------------------
// hashset iteration order is unspecified — every assertion below is
// order-agnostic (length, membership, no-duplicates via a rebuild set).

@test
func test_hashset_to_list_empty() {
    let s = hashset[int]()
    let lst = s.to_list()
    ut.assert_eq(lst.len(), 0)
}

@test
func test_hashset_to_list_len_matches() {
    let s = hashset[int]()
    s.add(1)
    s.add(2)
    s.add(3)

    let lst = s.to_list()
    ut.assert_eq(lst.len(), 3)
    ut.assert_eq(lst.len(), s.len())

    // Every element of the list is present in the set.
    for v in lst {
        ut.assert_true(v in s)
    }
}

@test
func test_hashset_to_list_no_duplicates() {
    let s = hashset[str]()
    s.add("a")
    s.add("b")
    s.add("c")
    // Add duplicates: still 3 unique elements.
    s.add("a")
    s.add("b")

    let lst = s.to_list()
    ut.assert_eq(lst.len(), 3)

    // Rebuild a hashset from the list; if the list had duplicates, the
    // rebuilt set would be smaller than the list length only when it
    // matches — here we assert they equal exactly.
    let back = hashset[str]()
    for v in lst {
        back.add(v)
    }
    ut.assert_eq(back.len(), lst.len())
}

@test
func test_hashset_to_list_all_elements_present() {
    let s = hashset[int]()
    s.add(10)
    s.add(20)
    s.add(30)
    s.add(40)

    let lst = s.to_list()
    ut.assert_eq(lst.len(), 4)

    // Every element of the set appears in the list (via list __contains__).
    ut.assert_true(10 in lst)
    ut.assert_true(20 in lst)
    ut.assert_true(30 in lst)
    ut.assert_true(40 in lst)
}

@test
func test_hashset_to_list_reflects_mutation() {
    let s = hashset[int]()
    s.add(1)
    s.add(2)
    s.add(3)
    let lst1 = s.to_list()
    ut.assert_eq(lst1.len(), 3)

    // Mutate the set; a fresh to_list must reflect the change.
    s.remove(2)
    s.add(99)
    let lst2 = s.to_list()
    ut.assert_eq(lst2.len(), 3)
    ut.assert_true(1 in lst2)
    ut.assert_true(3 in lst2)
    ut.assert_true(99 in lst2)
    ut.assert_false(2 in lst2)

    // The earlier snapshot is a copy, not a live view.
    ut.assert_eq(lst1.len(), 3)
    ut.assert_true(2 in lst1)
    ut.assert_false(99 in lst1)

    // clear() empties subsequent to_list.
    s.clear()
    let lst3 = s.to_list()
    ut.assert_eq(lst3.len(), 0)
}

@test
func test_hashset_to_list_str() {
    let s = hashset[str]()
    s.add("apple")
    s.add("banana")
    s.add("")

    let lst = s.to_list()
    ut.assert_eq(lst.len(), 3)
    ut.assert_true("apple" in lst)
    ut.assert_true("banana" in lst)
    ut.assert_true("" in lst)
}

@test
func test_hashset_to_list_class_key() {
    let s = hashset[Point]()
    s.add(Point(1, 2))
    s.add(Point(3, 4))
    // Duplicate by value (user __eq__) — still 2 unique.
    s.add(Point(1, 2))

    let lst = s.to_list()
    ut.assert_eq(lst.len(), 2)

    // Order-agnostic membership check via equal-by-value instances.
    ut.assert_true(Point(1, 2) in lst)
    ut.assert_true(Point(3, 4) in lst)
}

@test
func test_hashset_to_list_scale() {
    let s = hashset[int]()
    for i in range(1000) {
        s.add(i)
    }

    let lst = s.to_list()
    ut.assert_eq(lst.len(), 1000)

    // No duplicates: rebuilding a hashset from the list preserves size.
    let back = hashset[int]()
    for v in lst {
        back.add(v)
    }
    ut.assert_eq(back.len(), 1000)

    // Every original element made it through.
    for i in range(1000) {
        ut.assert_true(i in lst)
    }
}

// ---------------------------------------------------------------------------
// HashSetIter — __init__ / has_next / next / next_strict
// ---------------------------------------------------------------------------
// Iteration order is unspecified; all assertions below are order-agnostic.
// Panic paths (step <= 0, next_strict at exhaustion) are implemented in C
// but not exercised here because ut has no assert_panic helper.

@test
func test_hashset_iter_empty_set() {
    let s = hashset[int]()
    let it = s.iter()
    ut.assert_false(it.has_next())
    ut.assert_true(it.next() == nil)
}

@test
func test_hashset_iter_for_loop_visits_all() {
    let s = hashset[str]()
    s.add("a")
    s.add("b")
    s.add("c")

    // for-in lowers to iter() + has_next + next under the hood.
    let collected = hashset[str]()
    var count = 0
    for v in s {
        collected.add(v)
        count = count + 1
    }

    ut.assert_eq(count, 3)
    ut.assert_eq(collected.len(), 3)
    ut.assert_true("a" in collected)
    ut.assert_true("b" in collected)
    ut.assert_true("c" in collected)
}

@test
func test_hashset_iter_has_next_next_strict_protocol() {
    let s = hashset[int]()
    s.add(10)
    s.add(20)
    s.add(30)

    let it = s.iter()
    let collected = hashset[int]()
    while it.has_next() {
        collected.add(it.next_strict())
    }

    ut.assert_eq(collected.len(), 3)
    ut.assert_true(10 in collected)
    ut.assert_true(20 in collected)
    ut.assert_true(30 in collected)
    ut.assert_false(it.has_next())
}

@test
func test_hashset_iter_next_returns_nil_at_end() {
    let s = hashset[int]()
    s.add(1)
    s.add(2)

    let it = s.iter()
    // Drain via next() — two non-nil results, then nil.
    var seen = 0
    while it.next() != nil {
        seen = seen + 1
    }
    ut.assert_eq(seen, 2)
    ut.assert_false(it.has_next())
    // Extra calls stay nil (idempotent exhaustion).
    ut.assert_true(it.next() == nil)
    ut.assert_true(it.next() == nil)
}

@test
func test_hashset_iter_if_let_unwrap() {
    let s = hashset[str]()
    s.add("only")

    let it = s.iter()
    if let v = it.next() {
        ut.assert_eq(v, "only")
    } else {
        ut.assert_true(false)   // unreachable
    }
    // Second unwrap falls into else.
    if let v = it.next() {
        ut.assert_true(false)   // unreachable
    } else {
        ut.assert_true(true)
    }
}

@test
func test_hashset_iter_str_key() {
    let s = hashset[str]()
    s.add("apple")
    s.add("banana")
    s.add("cherry")
    s.add("date")

    let collected = hashset[str]()
    for v in s {
        collected.add(v)
    }
    ut.assert_eq(collected.len(), 4)
    ut.assert_true("apple" in collected)
    ut.assert_true("banana" in collected)
    ut.assert_true("cherry" in collected)
    ut.assert_true("date" in collected)
}

@test
func test_hashset_iter_class_key() {
    let s = hashset[Point]()
    s.add(Point(1, 2))
    s.add(Point(3, 4))
    // Value-duplicate: not a new element.
    s.add(Point(1, 2))

    let it = s.iter()
    var count = 0
    while it.has_next() {
        let p = it.next_strict()
        // Each yielded Point must be one of the two originals by value.
        ut.assert_true(p == Point(1, 2) || p == Point(3, 4))
        count = count + 1
    }
    ut.assert_eq(count, 2)
}

@test
func test_hashset_iter_scale() {
    let s = hashset[int]()
    for i in range(1000) {
        s.add(i)
    }

    let it = s.iter()
    let back = hashset[int]()
    var count = 0
    while it.has_next() {
        back.add(it.next_strict())
        count = count + 1
    }

    ut.assert_eq(count, 1000)
    ut.assert_eq(back.len(), 1000)
    for i in range(1000) {
        ut.assert_true(i in back)
    }
}

