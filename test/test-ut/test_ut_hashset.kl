    ut.assert_true(b.is_subset(a))
}

@test
func test_hashset_is_subset_false() {
    let a = hashset[int]()
    a.add(1)
    a.add(2)
    a.add(99)

    let b = hashset[int]()
    b.add(1)
    b.add(2)
    b.add(3)

    ut.assert_false(a.is_subset(b))
}

@test
func test_hashset_is_subset_empty_is_subset_of_any() {
    let empty = hashset[int]()
    let b = hashset[int]()
    b.add(1)

    ut.assert_true(empty.is_subset(b))
    ut.assert_true(empty.is_subset(empty))
}

@test
func test_hashset_is_subset_list_source() {
    let a = hashset[int]()
    a.add(2)
    a.add(3)

    // Sequence path: materialize list into temp hashset internally.
    ut.assert_true(a.is_subset([1, 2, 3, 4]))
    ut.assert_false(a.is_subset([1, 2, 4]))
}

