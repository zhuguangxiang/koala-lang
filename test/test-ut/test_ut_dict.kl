// ---------------------------------------------------------------------------
// reversed() Iterator[(K, V)]
// ---------------------------------------------------------------------------

@test
func test_dict_reversed_has_next_next() {
    let d = dict[int, str]()
    d[10] = "a"
    d[20] = "b"
    d[30] = "c"

    let it = d.reversed(1)
    ut.assert_true(it.has_next())
    let kv1 = it.next_strict()
    ut.assert_eq(kv1[0], 30)
    ut.assert_eq(kv1[1], "c")
    let kv2 = it.next_strict()
    ut.assert_eq(kv2[0], 20)
    ut.assert_eq(kv2[1], "b")
    ut.assert_true(it.has_next())
    let kv3 = it.next_strict()
    ut.assert_eq(kv3[0], 10)
    ut.assert_eq(kv3[1], "a")
    ut.assert_false(it.has_next())
}

@test
func test_dict_reversed_next_nil_when_exhausted() {
    let d = dict[str, int]()
    d["x"] = 1

    let it = d.reversed(1)
    if let kv = it.next() {
        ut.assert_eq(kv[0], "x")
        ut.assert_eq(kv[1], 1)
    } else {
        ut.assert_true(false, "expected a pair")
    }
    ut.assert_true(it.next() == nil)
    ut.assert_false(it.has_next())
}

@test
func test_dict_reversed_empty() {
    let d = dict[int, int]()
    let it = d.reversed(1)
    ut.assert_false(it.has_next())
    ut.assert_true(it.next() == nil)
}

@test
func test_dict_reversed_step() {
    let d = dict[int, int]()
    for i in range(5) { d[i] = i * 10 }

    let it = d.reversed(2)
    let kv1 = it.next_strict()
    ut.assert_eq(kv1[0], 4)
    ut.assert_eq(kv1[1], 40)
    let kv2 = it.next_strict()
    ut.assert_eq(kv2[0], 2)
    ut.assert_eq(kv2[1], 20)
    let kv3 = it.next_strict()
    ut.assert_eq(kv3[0], 0)
    ut.assert_eq(kv3[1], 0)
    ut.assert_false(it.has_next())
}

@test
func test_dict_reversed_for_in_reverse_order() {
    let d = dict[str, int]()
    d["b"] = 2
    d["a"] = 1
    d["c"] = 3

    let ks = list[str]()
    let vs = list[int]()
    for kv in d.reversed() {
        ks.append(kv[0])
        vs.append(kv[1])
    }
    ut.assert_eq(ks.len(), 3)
    ut.assert_eq(vs.len(), 3)
    ut.assert_eq(ks[0], "c")
    ut.assert_eq(vs[0], 3)
    ut.assert_eq(ks[1], "a")
    ut.assert_eq(vs[1], 1)
    ut.assert_eq(ks[2], "b")
    ut.assert_eq(vs[2], 2)
}

