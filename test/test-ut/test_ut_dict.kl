@test
func test_dict_reversed_after_replace_no_reorder() {
    let d = dict[str, int]()
    d["a"] = 1
    d["b"] = 2
    d["a"] = 99   // replace value, key order unchanged

    let ks = list[str]()
    let vs = list[int]()
    for kv in d.reversed() {
        ks.append(kv[0])
        vs.append(kv[1])
    }
    ut.assert_eq(ks.len(), 2)
    ut.assert_eq(ks[0], "b")
    ut.assert_eq(vs[0], 2)
    ut.assert_eq(ks[1], "a")
    ut.assert_eq(vs[1], 99)
}

@test
func test_dict_iter_after_replace_no_reorder() {
