// ---------------------------------------------------------------------------
// values() Iterable[V]
// ---------------------------------------------------------------------------

@test
func test_dict_values_iter_has_next_next() {
    let d = dict[int, str]()
    d[10] = "a"
    d[20] = "b"
    d[30] = "c"

    let it = d.values().iter(1)
    ut.assert_true(it.has_next())
    ut.assert_eq(it.next_strict(), "a")
    ut.assert_eq(it.next_strict(), "b")
    ut.assert_true(it.has_next())
    ut.assert_eq(it.next_strict(), "c")
    ut.assert_false(it.has_next())
}

@test
func test_dict_values_iter_next_nil_when_exhausted() {
    let d = dict[str, int]()
    d["x"] = 1

    let it = d.values().iter(1)
    if let v = it.next() {
        ut.assert_eq(v, 1)
    } else {
        ut.assert_true(false, "expected a value")
    }
    ut.assert_true(it.next() == nil)
    ut.assert_false(it.has_next())
}

@test
func test_dict_values_iter_empty() {
    let d = dict[int, int]()
    let it = d.values().iter(1)
    ut.assert_false(it.has_next())
    ut.assert_true(it.next() == nil)
}

@test
func test_dict_values_iter_step() {
    let d = dict[int, int]()
    for i in range(5) { d[i] = i * 10 }

    let it = d.values().iter(2)
    ut.assert_eq(it.next_strict(), 0)
    ut.assert_eq(it.next_strict(), 20)
    ut.assert_eq(it.next_strict(), 40)
    ut.assert_false(it.has_next())
}

