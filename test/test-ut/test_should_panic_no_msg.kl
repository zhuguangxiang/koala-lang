// RUN: koala --test %s

import "std/ut"

// @should_panic without message: accepts any panic
@should_panic
func test_should_panic_any_message() {
    panic("whatever message")
}

@should_panic
func test_should_panic_from_assert() {
    ut.assert_eq(1, 3) // this will panic with assertion message
}

// @should_panic with specific message
@should_panic("expected error")
func test_should_panic_specific_message() {
    panic("expected error")
}
