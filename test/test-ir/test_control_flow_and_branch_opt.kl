// RUN: koalac %s --cgen --fusion --tail-call --dump=code | filecheck %s

func test_const_if_folding(n int) int {
    let a = 10
    if a > 5 {
        return n + 1
    } else {
        return n + 100
    }
}

// CHECK-LABEL: @test_const_if_folding[0,1]:
// CHECK: int.add_imm r0, r0, #1
// CHECK: ret r0

func test_branch_rpo_layout(n int) int {
    var r = 0
    if n > 0 {
        r = 1
    } else {
        r = 2
    }
    return r
}

// CHECK-LABEL: @test_branch_rpo_layout[2,7]:
// CHECK: load_int_imm r1, ti=0xb, #0
// CHECK: jmp_int_le_imm r0, #0, 2
// CHECK: load_int_imm r1, ti=0xb, #1
// CHECK: jmp 1
// CHECK: load_int_imm r1, ti=0xb, #2
// CHECK: ret r1

func test_nested_jump_threading(n int) int {
    if n > 0 {
        if n > 10 {
            return 1
        }
    }
    return 0
}

// CHECK-LABEL: @test_nested_jump_threading[8,11]:
// CHECK: jmp_int_le_imm r0, #0, 2
// CHECK: jmp_int_le_imm r0, #10, 1
// CHECK: ret_int_imm ti=0xb, #1
// CHECK: ret_int_imm ti=0xb, #0

func test_phi_precursor_merge(n int) int {
    var x = 0
    if n > 100 {
        x = 1
    }
    return x
}

// CHECK-LABEL: @test_phi_precursor_merge[12,15]:
// CHECK: load_int_imm r1, ti=0xb, #0
// CHECK: jmp_int_le_imm r0, #100, 1
// CHECK: load_int_imm r1, ti=0xb, #1
// CHECK: ret r1

func test_logic_short_circuit(a int, b int) bool {
    if a > 0 && b > 0 {
        return true
    }
    return false
}

