// RUN: koalac %s --opt --dump=ir | filecheck %s

var g = 100
let f = g + 1
let h = f + 101

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@__init__] ---
// CHECK-LABEL: func @__init__()
// CHECK: global_set @g int64, 100 int64
// CHECK: %0 = global_get @g int64
// CHECK: %1 = add %0 int64, 1 int64
// CHECK: global_set @f int64, %1 int64
// CHECK: %2 = global_get @f int64
// CHECK: %3 = add %2 int64, 101 int64
// CHECK: global_set @h int64, %3 int64
// CHECK: ret void

func foo() {
    var a = 100
    let b = a + 1
    print(a, b)

    if (b > 3) {
        print("a = ", a)
    }

    if (g > 3) {
        print("g = ", g)
    }

    if (h > 3) {
        print("h = ", h)
    }

    if (f > 3) {
        print("f = ", f)
    }

    print(a + b + 1)
    print(b + 1)
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@foo] ---
// CHECK-LABEL: func @foo()
// CHECK: call @print [path = 'std/builtin']
// CHECK: %9 = build_intern @tuple, 'h = ' str, %8 int64
// CHECK: call @print [path = 'std/builtin']

func bar(v int) int {
    let a = v
    let b = a * 2
    return b
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@bar] ---
// CHECK-LABEL: func @bar(%v int64)
// CHECK: %0 = mul %v int64, 2 int64
// CHECK: ret %0 int64
