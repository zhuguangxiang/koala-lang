// RUN: koalac %s --lsra --dump=vreg | filecheck %s

func test_reuse(a int) int {
    let b = a + 10
    let c = b + 20
    let d = c + 30
    return d
}

// CHECK-LABEL: =============== LSRA @test_reuse ===============
// CHECK: %a: range: [0, 1) reg: 0
// CHECK: %0: range: [1, 2) reg: 0
// CHECK: %1: range: [2, 3) reg: 0
// CHECK: %2: range: [3, 4) reg: 0

// CHECK: 0: [R0] param %a
// CHECK: %bb0(entry)[idx:0,pos:1-4]
// CHECK: [R[[REG:[0-9]+]]] %1 = int.add_imm
// CHECK: [R[[REG]]] %2 = int.add_imm

func test_interference(n int) int {
    var a = n + 1
    var b = n + 2
    var c = a + b
    return c
}

// TODO:
// =============== LSRA @test_interference ===============
// %n: range: [0, 2) reg: 0
// %0: range: [1, 3) reg: 1
// %1: range: [2, 3) reg: 0
// %2: range: [3, 4) reg: 0

// 0: [R0] param %n
// %bb0(entry)[idx:0,pos:1-4]
// 1: [R1] %0 = int.add_imm
// 2: [R0] %1 = int.add_imm
// 3: [R0] %2 = int.add
// 4: [...] ret %2

func test_while(n int) {
    var i = 0
    while (i < n) {
        i = i + 1
    }
}

// CHECK-LABEL: =============== LSRA @test_while ===============
// CHECK: %n: range: [0, 9) reg: 0
// CHECK: %i: range: [1, 9) reg: 1
// CHECK: %0: range: [3, 4) reg: 2
// CHECK: %1: range: [5, 6) reg: 2
// CHECK: %2: range: [7, 8) reg: 2

// CHECK: 1: [R1] %i = local int64
// CHECK: 2: [...] load_int_imm %i int64, 0 int64
// CHECK: 3: [R2] %0 = int.cmp_ge_imm %n int64, 0 int64
// CHECK: 4: [...] branch %0 bool, label %bb1, label %bb2
// CHECK: 5: [R2] %1 = int.add_imm %i int64, 1 int64
// CHECK: 6: [...] move %i int64, %1 int64
// CHECK: 7: [R2] %2 = int.cmp_lt %i int64, %n int64
// CHECK: 8: [...] branch %2 bool, label %bb1, label %bb2

func test_while2(n int) {
    var i = 0
    while (i < n) {
        print(i + 10)
        i = i + 1
    }
}

// CHECK-LABEL: =============== LSRA @test_while2 ===============

// CHECK: %n: range: [0, 16) reg: 0
// CHECK: %i: range: [1, 16) reg: 1
// CHECK: %0: range: [3, 4) reg: 2
// CHECK: %5: range: [12, 13) reg: 2
// CHECK: %6: range: [14, 15) reg: 2

// CHECK: 1: [R1] %i = local int64
// CHECK: 2: [...] load_int_imm %i int64, 0 int64
// CHECK: 3: [R2] %0 = int.cmp_ge_imm %n int64, 0 int64
// CHECK: 4: [...] branch %0 bool, label %bb1, label %bb2

// CHECK: 5: [R3] %1 = int.add_imm %i int64, 10 int64
// CHECK: 11: [...] call @print [path = 'std/builtin'], 3
// CHECK: 12: [R2] %5 = int.add_imm %i int64, 1 int64
// CHECK: 13: [...] move %i int64, %5 int64
// CHECK: 14: [R2] %6 = int.cmp_lt %i int64, %n int64
// CHECK: 15: [...] branch %6 bool, label %bb1, label %bb2
// CHECK: [BACK-EDGE] bb1(while-body) -> bb1(while-body) (Target POS: 5)

func test_nested_loop(n int) {
    var i = 0
    while (i < n) {
        var j = 0
        while (j < i) {
            print(j)
            j = j + 1
        }
        i = i + 1
    }
}

// CHECK-LABEL: =============== LSRA @test_nested_loop ===============
// CHECK: %n: range: [0, 25) reg: 0
// CHECK: %i: range: [1, 25) reg: 1
// CHECK: %0: range: [3, 4) reg: 2
// CHECK: %j: range: [5, 21) reg: 2
// CHECK: %1: range: [7, 8) reg: 3

// CHECK: 1: [R1] %i = local int64
// CHECK: 2: [...] load_int_imm %i int64, 0 int64
// CHECK: 3: [R2] %0 = int.cmp_ge_imm %n int64, 0 int64
// CHECK: 4: [...] branch %0 bool, label %bb1, label %bb4
// CHECK: 5: [R2] %j = local int64
// CHECK: 6: [...] load_int_imm %j int64, 0 int64
// CHECK: 7: [R3] %1 = int.cmp_ge_imm %i int64, 0 int64
// CHECK: 8: [...] branch %1 bool, label %bb2, label %bb3
// CHECK: 9: [R4] %2 = local int64
// CHECK: 10: [...] move %2 int64, %j int64

func test_diamond(c bool, a int) int {
    if (c) {
        var b = a + 1
        print(b)
    } else {
        let d = a + 2
        print(d)
    }
    return a
}

// CHECK-LABEL: =============== LSRA @test_diamond ===============

// CHECK: %c: range: [0, 1) reg: 0
// CHECK: %a: range: [0, 20) reg: 1
// CHECK: %0: range: [2, 4) reg: 0

// CHECK: 1: [...] branch %c bool, label %bb1, label %bb2

// CHECK: 2: [R0] %0 = int.add_imm %a int64, 1 int64
// CHECK: 3: [R2] %b = local int64        [fixedslot = 0(next) -> R2]
// CHECK: 4: [...] move %b int64, %0 int64
// CHECK: 10: [...] call @print [path = 'std/builtin'], 3
// CHECK: 11: [...] jmp label %bb3

// CHECK: 12: [R2] %4 = int.add_imm %a int64, 2 int64        [fixedslot = 0(next) -> R2]
// CHECK: 18: [...] call @print [path = 'std/builtin'], 3
// CHECK: 19: [...] jmp label %bb3
