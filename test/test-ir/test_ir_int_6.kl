// RUN: koalac %s --cgen --int-trap --dump=no-opt-ir,lir,code | filecheck %s

func test_int_1() int8 {
    let n = -100
    let v = n + 50
    return int8(v)
}

func test_int_2(n int8) int8 {
    var sum = 0

    var i = 0;
    while i < 100 {
        i = i + 1
        sum = sum + n
    }

    return int8(sum)
}

func main() {
    let n int8 = 100
    print(test_int_2(110))
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @test_int_1() int8
// CHECK: %1 = cast %v int64 to int8
// CHECK: ret %1 int8

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @test_int_2(%n int8) int8
// CHECK: %2 = cast %n int8 to int64
// CHECK: %3 = add %sum int64, %2 int64
// CHECK: %5 = cast %sum int64 to int8
// CHECK: ret %5 int8

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK: %n = local [immutable] int8
// CHECK: move %n int8, 100 int8
// CHECK: %0 = call @test_int_2 [const], 110 int8

// CHECK-LABEL: --- IR Dump After isel [@test_int_1] ---
// CHECK-LABEL: func @test_int_1() int8
// CHECK: ret_int_imm -50 int8

// CHECK-LABEL: --- IR Dump After isel [@test_int_2] ---
// CHECK-LABEL: func @test_int_2(%n int8) int8
// CHECK: %1 = cast %n int8 to int64
// CHECK: %2 = int.add %sum int64, %1 int64
// CHECK: %4 = int.cast %sum int64 to int8
// CHECK: ret %4 int8

// CHECK-LABEL: --- IR Dump After isel [@main] ---
// CHECK-LABEL: func @main()
// CHECK: %0 = local int8        [fixedslot = 0(next)]
// CHECK: load_int_imm %0 int8, 110 int8
// CHECK: %1 = call @test_int_2 [const], nargs=1        [fixedslot = 0(next)]

// CHECK-LABEL: ====== Linearization @test_int_2(start_pc: 1, insns: 9) ======
// CHECK: int.cast r0, r1, ti=0x8, mode=0
// CHECK: ret r0

// CHECK-LABEL: ====== Linearization @main(start_pc: 10, insns: 9) ======
// CHECK: load_int_imm r0, ti=0x8, #110
