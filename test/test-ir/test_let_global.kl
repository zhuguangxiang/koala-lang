// RUN: koalac %s --opt --dump=ir | filecheck %s

let i = 10
let j = i + 1

print(i, j)

func foo() str { return "hello" }

let s = foo()

let l = [1, 2, 3]

let l2 = list(1,2,30)

let v = int(100)

let t = tuple(10, 20)

let t2 = (10, 20, 30)

var v2 = 123

print(v + 123, v2)

let list_str = list("a", "b", "c")

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@__init__] ---
// CHECK-LABEL: func @__init__()
// CHECK: set_global @j int64, 11 int64
// CHECK: call @print [ext = true, path = 'std/builtin'], 10 int64, 11 int64
// CHECK: %1 = get_global @v2 int64
// CHECK: call @print [ext = true, path = 'std/builtin'], 223 int64, %1 int64
// CHECK: set_global @list_str list<u>, list['a', 'b', 'c'] list

func bar() int {
    var a = j
    return a
}

// CHECK-LABEL: --- IR Dump After const-copy-prop (Iter 1) [@bar] ---
// CHECK-LABEL: func @bar() int64
// CHECK: %0 = get_global @j int64
// CHECK: %a = local int64
// CHECK: move %a int64, 11 int64
// CHECK: ret 11 int64

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@bar] ---
// CHECK-LABEL: func @bar() int64
// CHECK: ret 11 int64
