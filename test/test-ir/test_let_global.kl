// RUN: koalac %s --opt --dump=ir | filecheck %s

let i = 10
let j = i + 1

print(i, j)

func foo() str { return "hello" }

let s = foo()

let l = [1, 2, 3]

let l2 = list(1,2,30)

let v = int(100)

let t = tuple(10, 20)

let t2 = (10, 20, 30)

var v2 = 123

print(v + 123, v2)

let list_str = list("a", "b", "c")

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@__init__] ---
// CHECK-LABEL: func @__init__()
// CHECK: global_set @j int64, 11 int64
// a list is mutable: built afresh, never a constant
// CHECK: %2 = build_intern @list, 1 int64, 2 int64, 3 int64
// CHECK: global_set @l std/builtin.list[int64], %2 std/builtin.list[int64]
// CHECK: %3 = build_intern @list, 1 int64, 2 int64, 30 int64
// CHECK: global_set @l2 std/builtin.list[int64], %3 std/builtin.list[int64]
// an immutable tuple stays a constant
// CHECK: global_set @t2 std/builtin.tuple[int64, int64, int64], tuple(10, 20, 30) std/builtin.tuple[int64, int64, int64]
// CHECK: %4 = global_get @v2 int64
// CHECK: %6 = build_intern @list, 'a' str, 'b' str, 'c' str
// CHECK: global_set @list_str std/builtin.list[str], %6 std/builtin.list[str]

func bar() int {
    var a = j
    return a
}

// CHECK-LABEL: --- IR Dump After const-copy-prop (Iter 1) [@bar] ---
// CHECK-LABEL: func @bar() int64
// CHECK: %0 = global_get @j int64
// CHECK: %a = local int64
// CHECK: move %a int64, 11 int64
// CHECK: ret 11 int64

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@bar] ---
// CHECK-LABEL: func @bar() int64
// CHECK: ret 11 int64
