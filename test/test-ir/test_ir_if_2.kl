// RUN: koalac %s --opt --dump=ir | filecheck %s

func foo() {
    let i = 10
    let j = i + 1
    let k = j + 3
    print(k)
    let b = j > 10

    if j < 10 {
        print(i)
    } else {
        var k = j + 2
        print(j, k)
        if k > 12 {
            print("k is greater than 12", i)
        } else {
            print("k is not greater than 12", b)
        }
    }

    if j < 10 {
        print("j is less than 10")
    } else if j == 10 {
        print("j is equal to 10")
    } else {
        print("j is greater than 10")
    }

    let unsued = "hello"
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@foo] ---
// CHECK-LABEL: func @foo()
// CHECK: call @print [path = 'std/builtin']
// CHECK: call @print [path = 'std/builtin']
// CHECK: call @print [path = 'std/builtin']
// CHECK: call @print [path = 'std/builtin', const]
// CHECK: ret void

func test_nested(a int, b int) {
    if (a > 10) {
        print("Level 1")
    } else if (b > 20) {
        print("Level 2")
    } else {
        print("Level 3")
    }
    print("Done")
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@test_nested] ---
// CHECK-LABEL: func @test_nested(%a int64, %b int64)
// CHECK: call @print [path = 'std/builtin', const]
// CHECK: jmp label %bb3
// CHECK: call @print [path = 'std/builtin', const]
// CHECK: ret void
// CHECK: call @print [path = 'std/builtin', const]
// CHECK: call @print [path = 'std/builtin', const]
