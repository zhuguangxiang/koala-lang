// RUN: koalac %s --irgen --dump=no-opt-ir | filecheck %s

enum A {
    X,
    Y = 5,
}

func from_param(a A) list[A] {
    return list[A](a)
}

func from_params(a A, b A) list[A] {
    return list[A](a, b)
}

func from_optional(a A?) list[A?] {
    return list[A?](a)
}

func empty_list() list[A] {
    return list[A]()
}

func empty_optional_list() list[A?] {
    return list[A?]()
}

func empty_nested_list() list[list[A]] {
    return list[list[A]]()
}

func nested_from_param(items list[A]) list[list[A]] {
    return list[list[A]](items)
}

func nested_from_value(a A) list[list[A]] {
    return list[list[A]](list[A](a))
}

func nested_optional_items(items list[A?]) list[list[A?]] {
    return list[list[A?]](items)
}

func optional_inner_list(items list[A]?) list[list[A]?] {
    return list[list[A]?](items)
}

func tuple_from_params(a A, b A?) list[(A, A?)] {
    return list[(A, A?)]((a, b))
}

// CHECK-LABEL: func @from_param(%a int64) std/builtin.list<j> {
// CHECK: build_intern @list, %a int64
// CHECK: ret {{%[^ ]+}} std/builtin.list<j>

// CHECK-LABEL: func @from_params(%a int64, %b int64) std/builtin.list<j> {
// CHECK: build_intern @list, %a int64, %b int64
// CHECK: ret {{%[^ ]+}} std/builtin.list<j>

// CHECK-LABEL: func @from_optional(%a int64?) std/builtin.list<j?> {
// CHECK: build_intern @list, %a int64?
// CHECK: ret {{%[^ ]+}} std/builtin.list<j?>

// CHECK-LABEL: func @empty_list() std/builtin.list<j> {
// CHECK: build_intern @list
// CHECK: ret {{%[^ ]+}} std/builtin.list<j>

// CHECK-LABEL: func @empty_optional_list() std/builtin.list<j?> {
// CHECK: build_intern @list
// CHECK: ret {{%[^ ]+}} std/builtin.list<j?>

// CHECK-LABEL: func @empty_nested_list() std/builtin.list<Lstd/builtin.list<j>;> {
// CHECK: build_intern @list
// CHECK: ret {{%[^ ]+}} std/builtin.list<Lstd/builtin.list<j>;>

// CHECK-LABEL: func @nested_from_param(%items std/builtin.list<j>) std/builtin.list<Lstd/builtin.list<j>;> {
// CHECK: build_intern @list, %items std/builtin.list<j>
// CHECK: ret {{%[^ ]+}} std/builtin.list<Lstd/builtin.list<j>;>

// CHECK-LABEL: func @nested_from_value(%a int64) std/builtin.list<Lstd/builtin.list<j>;> {
// CHECK: build_intern @list, %a int64
// CHECK: build_intern @list, {{%[^ ]+}} std/builtin.list<j>
// CHECK: ret {{%[^ ]+}} std/builtin.list<Lstd/builtin.list<j>;>

// CHECK-LABEL: func @nested_optional_items(%items std/builtin.list<j?>) std/builtin.list<Lstd/builtin.list<j?>;> {
// CHECK: build_intern @list, %items std/builtin.list<j?>
// CHECK: ret {{%[^ ]+}} std/builtin.list<Lstd/builtin.list<j?>;>

// CHECK-LABEL: func @optional_inner_list(%items std/builtin.list<j>?) std/builtin.list<Lstd/builtin.list<j>;?> {
// CHECK: build_intern @list, %items std/builtin.list<j>?
// CHECK: ret {{%[^ ]+}} std/builtin.list<Lstd/builtin.list<j>;?>

// CHECK-LABEL: func @tuple_from_params(%a int64, %b int64?) std/builtin.list<Lstd/builtin.tuple<jj?>;> {
// CHECK: build_intern @tuple, %a int64, %b int64?
// CHECK: build_intern @list, {{%[^ ]+}} std/builtin.tuple<jj?>
// CHECK: ret {{%[^ ]+}} std/builtin.list<Lstd/builtin.tuple<jj?>;>
