// RUN: koalac %s --opt --dump=ir | filecheck %s
//
// A map literal is always `build_intern @map, ...` (a dict is mutable, so it
// is never a const-pool entry; see test_map_literal.kl). None of the 5 opt
// passes (const-copy-prop, normalize, lvn, cfg-bb-opt, dce) folds it back into
// a constant; this file locks that in.
//
// Intended limits (the same as for list literals):
//   * opt never folds a build_intern whose operands all became constants
//     after propagation back into the const pool;
//   * a build_intern whose result is unused (the object does not escape, the
//     allocation is not observable) is removed by dce.

func const_map() dict[int, int] {
    let m = {1: 2, 3: 4}
    return m
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@const_map] ---
// CHECK: %0 = build_intern @map, 1 int64, 2 int64, 3 int64, 4 int64
// CHECK-NOT: dict[
// CHECK: move %m std/builtin.dict<jj>, %0 std/builtin.dict<jj>
// CHECK: ret %m std/builtin.dict<jj>

func build_map(x int) dict[int, int] {
    let m = {1: x}
    return m
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@build_map] ---
// CHECK: %0 = build_intern @map, 1 int64, %x int64
// CHECK-NOT: dict[
// CHECK: ret %m std/builtin.dict<jj>

// the map built in each branch is kept, cfg-bb-opt neither merges nor drops it
func branches(x bool) dict[int, int] {
    var m = {1: 2}
    if x {
        m = {3: 4}
    }
    return m
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@branches] ---
// CHECK: %bb0(entry):
// CHECK: %0 = build_intern @map, 1 int64, 2 int64
// CHECK: move %m std/builtin.dict<jj>, %0 std/builtin.dict<jj>
// CHECK: %bb1(if-then):
// CHECK: %1 = build_intern @map, 3 int64, 4 int64
// CHECK: move %m std/builtin.dict<jj>, %1 std/builtin.dict<jj>
// CHECK: %bb2(if-end):
// CHECK: ret %m std/builtin.dict<jj>

// after const propagation turns %k into 1, every operand is a constant, but
// it stays build_intern @map: a dict is mutable, so each evaluation builds one.
func prop_key() dict[int, int] {
    let k = 1
    let m = {k: 2}
    return m
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@prop_key] ---
// CHECK: %0 = build_intern @map, 1 int64, 2 int64
// CHECK-NOT: dict[
// CHECK: ret %m std/builtin.dict<jj>

func dead_map(x int) int {
    let m = {1: x}
    return 0
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@dead_map] ---
// CHECK-NEXT: func @dead_map(%x int64) int64 {
// CHECK-NEXT: %bb0(entry):
// CHECK-NEXT: ret 0 int64
// CHECK-NEXT: }
