// RUN: koalac %s --opt --dump=ir | filecheck %s

while true {
    break
    print("Ghost")
}
print("End")

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@__init__] ---
// CHECK-LABEL: func @__init__()
// CHECK: call @print [path = 'std/builtin'] [const]
// CHECK: ret void

func foo() {
    var i = 0

    while i < 10 {
        if i == 5 {
            i = i + 2
            continue
            print("Never here")
        }
        i = i + 1
    }
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@foo] ---
// CHECK-LABEL: func @foo()
// CHECK: %i = local int64
// CHECK: move %i int64, 0 int64
// CHECK: jmp label %bb1

// CHECK: %0 = cmplt %i int64, 10 int64
// CHECK: branch %0 bool, label %bb2, label %bb3

// CHECK: %1 = cmpeq %i int64, 5 int64
// CHECK: branch %1 bool, label %bb4, label %bb5

// CHECK: ret void

// CHECK: %2 = add %i int64, 2 int64
// CHECK: move %i int64, %2 int64
// CHECK: jmp label %bb1

// CHECK: %3 = add %i int64, 1 int64
// CHECK: move %i int64, %3 int64
// CHECK: %4 = cmplt %i int64, 10 int64
// CHECK: branch %4 bool, label %bb2, label %bb3


func test_dead_block(n int) int {
    if (n > 10) {
        return 100
        print("I am a ghost")
    }

    while (true) {
        break
        var x = 200
        print(x)
    }

    return 0
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@test_dead_block] ---
// CHECK-LABEL: func @test_dead_block(%n int64) int64
// CHECK: %0 = cmpgt %n int64, 10 int64
// CHECK: branch %0 bool, label %bb1, label %bb2
// CHECK: ret 100 int64
// CHECK: ret 0 int64

func test_if_false() {
    var a = 10
    if (false) {
        a = 1 + 2
        print(a)
    }
    print(a)
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@test_if_false] ---
// CHECK-LABEL: func @test_if_false()
// CHECK: call @print [path = 'std/builtin']
// CHECK: ret void

func instant_break() {
    while (true) {
        break
    }
    print("Safe")
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@instant_break] ---
// CHECK-LABEL: func @instant_break()
// CHECK: call @print [path = 'std/builtin'] [const]
// CHECK: ret void

func double_loop() {
    var i = 0
    while (i < 2) {
        var j = 0
        while (j < 2) {
            j = j + 1
            if (j == 1) {
                continue
            }
            print("inner", j)
        }
        i = i + 1
        print("outer", i)
    }
}

// func @double_loop() <NO-TYPE> {
// %entry:
//     %i = local int64
//     move %i int64, 0 int64
//     jmp label %bb0

// %bb0(while-cond):                               ;; preds = %entry, %bb5
//     %0 = cmplt %i int64, 2 int64
//     branch %0 bool, label %bb1, label %bb2

// %bb1(while-body):                               ;; preds = %bb0
//     %j = local int64
//     move %j int64, 0 int64
//     jmp label %bb3

// %bb2(while-end):                                ;; preds = %bb0
//     ret void

// %bb3(while-cond):                               ;; preds = %bb1, %bb6, %bb4
//     %1 = cmplt %j int64, 2 int64
//     branch %1 bool, label %bb4, label %bb5

// %bb4(while-body):                               ;; preds = %bb3
//     %2 = add %j int64, 1 int64
//     move %j int64, %2 int64
//     %3 = cmpeq %j int64, 1 int64
//     branch %3 bool, label %bb3, label %bb6

// %bb5(while-end):                                ;; preds = %bb3
//     %4 = add %i int64, 1 int64
//     move %i int64, %4 int64
//     call @print [path = 'std/builtin']
//     jmp label %bb0

// %bb6(if-else):                                  ;; preds = %bb4
//     call @print [path = 'std/builtin']
//     jmp label %bb3
// }

func break_shadow() {
    var x = 100
    while (true) {
        break
        x = 200
        print(x)
    }
    print("Out")
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@break_shadow] ---
// CHECK-LABEL: func @break_shadow()
// CHECK: call @print [path = 'std/builtin'] [const]
// CHECK: ret void

func logic_continue() {
    var i = 0
    while (i < 10) {
        i = i + 1
        if (false) {
            continue
        }
        print(i)
    }
}

// func @logic_continue() <NO-TYPE> {
// %entry:
//     %i = local int64
//     move %i int64, 0 int64
//     jmp label %bb0

// %bb0(while-cond):                               ;; preds = %entry, %bb1
//     %0 = cmplt %i int64, 10 int64
//     branch %0 bool, label %bb1, label %bb2

// %bb1(while-body):                               ;; preds = %bb0
//     %1 = add %i int64, 1 int64
//     move %i int64, %1 int64
//     call @print [path = 'std/builtin'], %i int64
//     jmp label %bb0

// %bb2(while-end):                                ;; preds = %bb0
//     ret void
// }

func nested_break(n int) {
    var i = 0
    while (i < n) {
        if (i == 5) {
            break
        }
        i = i + 1
    }
    print("Done", i)
}

// func @nested_break(%n int64) <NO-TYPE> {
//   %entry:
//         %i = local int64
//         move %i int64, 0 int64
//         jmp label %bb0

//   %bb0(while-cond):                               ;; preds = %entry, %bb3
//         %0 = cmplt %i int64, %n int64
//         branch %0 bool, label %bb1, label %bb2

//   %bb1(while-body):                               ;; preds = %bb0
//         %1 = cmpeq %i int64, 5 int64
//         branch %1 bool, label %bb2, label %bb3

//   %bb2(while-end):                                ;; preds = %bb0, %bb1
//         call @print [path = 'std/builtin'], 'Done' str, %i int64
//         ret void

//   %bb3(if-else):                                  ;; preds = %bb1
//         %3 = add %i int64, 1 int64
//         move %i int64, %3 int64
//         jmp label %bb0
//   }

