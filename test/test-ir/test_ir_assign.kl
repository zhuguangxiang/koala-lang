// RUN: koalac %s --opt --dump=ir | filecheck %s

var c = 100
c = 200
print(c)

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@__init__] ---
// CHECK-LABEL: func @__init__()
// CHECK: set_global @c int64, 100 int64
// CHECK: set_global @c int64, 200 int64
// CHECK: %0 = get_global @c int64
// CHECK: call @print [ext = true, path = 'std/builtin']
// CHECK: ret void


func foo() {
    var x = 10
    if (c > 150) {
        x = 20
        print(x)
    } else {
        x = 30
        print(x)
    }
    print(x)
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@foo] ---
// CHECK-LABEL: func @foo()
// CHECK: %x = local int64
// CHECK: move %x int64, 10 int64
// CHECK: %0 = get_global @c int64
// CHECK: %1 = cmpgt %0 int64, 150 int64
// CHECK: branch %1 bool, label %bb1, label %bb2
// CHECK: move %x int64, 20 int64
// CHECK: call @print [ext = true, path = 'std/builtin']
// CHECK: move %x int64, 30 int64
// CHECK: call @print [ext = true, path = 'std/builtin']
// CHECK: call @print [ext = true, path = 'std/builtin']
