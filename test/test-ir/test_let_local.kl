// RUN: koalac %s --opt --dump=ir | filecheck %s

func bar() str { return "hello" }

func foo() int {
    let i = 10
    let j = i + 1

    let l = [1, 2, 3]

    let l2 = list(1,2,30)

    let v = int(100)

    let t = tuple(10, 20)

    let t2 = (10, 20, 30)

    let ret = bar()

    var x = 10

    x + 1

    return j
}

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@foo] ---
// CHECK-LABEL: func @foo() int64
// CHECK: %0 = new @list
// CHECK: call @list::__init__ [path = 'std/builtin'], %0 list, tuple(1, 2, 30) tuple<jjj>
// CHECK: %1 = new @tuple
// CHECK: call @tuple::__init__ [path = 'std/builtin'], %1 tuple, tuple(10, 20) tuple<jj>
// CHECK: %2 = call @bar
// CHECK-NOT: local
// CHECK-NOT: move
// CHECK: ret 11 int64
