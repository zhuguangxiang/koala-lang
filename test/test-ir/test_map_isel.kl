// RUN: koalac %s --isel --dump=lir | filecheck %s
//
// isel lowering of map literals:
//   * a map is mutable, so even an all-constant map is never a const-pool
//     entry: irgen emits `new @dict` + `call @dict:__init__` + one `seq.set`
//     per entry, and isel lowers each entry the normal way (the value loaded
//     into a register, then stored). A constant key folds into `seq.set_imm`;
//   * the dict self is passed to __init__ in fixedslot 0;
//   * a nested map ({x: {1: 2}}) is built first, then used as an operand.

func const_map() dict[int, int] {
    let m = {1: 2, 3: 4}
    return m
}

// CHECK-LABEL: --- IR Dump After isel [@const_map] ---
// CHECK: %0 = new @std/builtin.dict[int64, int64]
// CHECK: call @dict:__init__ [path = 'std/builtin'], nargs=1
// CHECK: load_int_imm %2 int64, 2 int64
// CHECK: seq.set_imm %0 std/builtin.dict[int64, int64], 1 int64, %2 int64
// CHECK: load_int_imm %3 int64, 4 int64
// CHECK: seq.set_imm %0 std/builtin.dict[int64, int64], 3 int64, %3 int64
// CHECK: move %m std/builtin.dict[int64, int64], %0 std/builtin.dict[int64, int64]
// CHECK: ret %m std/builtin.dict[int64, int64]

func empty_map() dict[int, int] {
    let m dict[int, int] = {:}
    return m
}

// CHECK-LABEL: --- IR Dump After isel [@empty_map] ---
// CHECK: %0 = new @std/builtin.dict[int64, int64]
// CHECK: call @dict:__init__ [path = 'std/builtin'], nargs=1
// CHECK: move %m std/builtin.dict[int64, int64], %0 std/builtin.dict[int64, int64]

func build_map(x int) dict[int, int] {
    let m = {1: x}
    return m
}

// a variable value is used directly, no argument slot is materialized for it
// CHECK-LABEL: --- IR Dump After isel [@build_map] ---
// CHECK: %0 = new @std/builtin.dict[int64, int64]
// CHECK: call @dict:__init__ [path = 'std/builtin'], nargs=1
// CHECK: seq.set_imm %0 std/builtin.dict[int64, int64], 1 int64, %x int64
// CHECK: move %m std/builtin.dict[int64, int64], %0 std/builtin.dict[int64, int64]

func mixed(x int) dict[int, dict[int, int]] {
    let m = {x: {1: 2}}
    return m
}

// CHECK-LABEL: --- IR Dump After isel [@mixed] ---
// CHECK: %0 = new @std/builtin.dict[int64, int64]
// CHECK: seq.set_imm %0 std/builtin.dict[int64, int64], 1 int64, %2 int64
// CHECK: %3 = new @std/builtin.dict[int64, std/builtin.dict[int64, int64]]
// CHECK: seq.set %3 std/builtin.dict[int64, std/builtin.dict[int64, int64]], %x int64, %0 std/builtin.dict[int64, int64]
