// RUN: koalac %s --isel --dump=lir | filecheck %s
//
// isel lowering of map literals (the same as for lists):
//   * a map is mutable, so even an all-constant map is never a const-pool
//     entry: irgen emits `build_intern @map` and isel lowers it the normal
//     way, each key/value loaded into consecutive argument slots
//     (fixedslot = 0, 1, ...) in the order k0, v0, k1, v1, ...; tag and nargs
//     are encoded in the tag:8 / nargs:8 fields of FORMAT_RTagImm, and
//     `INTERN_MAP` (= 4) is passed through as is;
//   * a nested map ({x: {1: 2}}) is built first, then used as an operand.

func const_map() dict[int, int] {
    let m = {1: 2, 3: 4}
    return m
}

// CHECK-LABEL: --- IR Dump After isel [@const_map] ---
// CHECK: load_int_imm %0 int64, 1 int64
// CHECK: load_int_imm %3 int64, 4 int64
// CHECK: %4 = build_intern @map, nargs=4
// CHECK: move %m std/builtin.dict[int64, int64], %4 std/builtin.dict[int64, int64]
// CHECK: ret %m std/builtin.dict[int64, int64]

func empty_map() dict[int, int] {
    let m dict[int, int] = {:}
    return m
}

// CHECK-LABEL: --- IR Dump After isel [@empty_map] ---
// CHECK: %0 = build_intern @map
// CHECK: move %m std/builtin.dict[int64, int64], %0 std/builtin.dict[int64, int64]

func build_map(x int) dict[int, int] {
    let m = {1: x}
    return m
}

// CHECK-LABEL: --- IR Dump After isel [@build_map] ---
// CHECK: %0 = local int64
// CHECK: load_int_imm %0 int64, 1 int64
// CHECK: %1 = local int64
// CHECK: move %1 int64, %x int64
// CHECK: %2 = build_intern @map, nargs=2
// CHECK: move %m std/builtin.dict[int64, int64], %2 std/builtin.dict[int64, int64]

func mixed(x int) dict[int, dict[int, int]] {
    let m = {x: {1: 2}}
    return m
}

// CHECK-LABEL: --- IR Dump After isel [@mixed] ---
// CHECK: %2 = build_intern @map, nargs=2        [fixedslot = 1(next)]
// CHECK: move %3 int64, %x int64
// CHECK: %4 = build_intern @map, nargs=2
