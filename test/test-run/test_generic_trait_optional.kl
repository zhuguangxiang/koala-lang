// RUN: koala %s ++ --dump=no-opt-ir | filecheck %s

// a trait 'Maybe[T]' with 'T' bound to an optional type: 'T? (T = int?)' is 'int?'

trait Maybe[T] {
    func get() T?
    func put(v T)
}

class Cell[T] : Maybe[T] {
    var o T?
    func __init__() { o = nil }
    pub func get() T? = o
    pub func put(v T) { o = v }
}

class IntCell : Maybe[int?] {
    var o int?
    func __init__() { o = nil }
    pub func get() int? = o
    pub func put(v int?) { o = v }
}

func read[T](m Maybe[T]) T? = m.get()

func run() {
    let c = Cell[int?]()
    let m Maybe[int?] = c
    print(m.get() ?? 1)
    m.put(2)
    print(m.get() ?? 1)
    print(c.get() ?? 1)
    m.put(nil)
    print(m.get())

    let ic = IntCell()
    let im Maybe[int?] = ic
    im.put(4)
    print(im.get() ?? 0)
    im.put(nil)

    print(read[int?](im) ?? 6)
    print(read[int?](c) ?? 7)

    let s Maybe[str?] = Cell[str?]()
    s.put("x")
    print(s.get() ?? "y")
}

run()

