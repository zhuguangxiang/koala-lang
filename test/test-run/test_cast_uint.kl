// RUN: koala %s | filecheck %s

// ---------- uint8 source ----------

func test_u8_to_i8(n uint8) int8 { return int8(n) }
func test_u8_to_u16(n uint8) uint16 { return uint16(n) }
func test_u8_to_u32(n uint8) uint32 { return uint32(n) }
func test_u8_to_u64(n uint8) uint64 { return uint64(n) }

// ---------- uint16 source ----------

func test_u16_to_i8(n uint16) int8 { return int8(n) }
func test_u16_to_i16(n uint16) int16 { return int16(n) }
func test_u16_to_u8(n uint16) uint8 { return uint8(n) }
func test_u16_to_u32(n uint16) uint32 { return uint32(n) }
func test_u16_to_u64(n uint16) uint64 { return uint64(n) }

// ---------- uint32 source ----------

func test_u32_to_i8(n uint32) int8 { return int8(n) }
func test_u32_to_i16(n uint32) int16 { return int16(n) }
func test_u32_to_i32(n uint32) int32 { return int32(n) }
func test_u32_to_u8(n uint32) uint8 { return uint8(n) }
func test_u32_to_u16(n uint32) uint16 { return uint16(n) }
func test_u32_to_u64(n uint32) uint64 { return uint64(n) }

// ---------- uint64 source ----------

func test_u64_to_i8(n uint64) int8 { return int8(n) }
func test_u64_to_i16(n uint64) int16 { return int16(n) }
func test_u64_to_i32(n uint64) int32 { return int32(n) }
func test_u64_to_i64(n uint64) int64 { return int64(n) }
func test_u64_to_u8(n uint64) uint8 { return uint8(n) }
func test_u64_to_u16(n uint64) uint16 { return uint16(n) }
func test_u64_to_u32(n uint64) uint32 { return uint32(n) }

// ---------- uint -> float ----------

func test_u8_to_f16(n uint8) float16 { return float16(n) }
func test_u8_to_f32(n uint8) float32 { return float32(n) }
func test_u8_to_f64(n uint8) float64 { return float64(n) }
func test_u16_to_f16(n uint16) float16 { return float16(n) }
func test_u16_to_f32(n uint16) float32 { return float32(n) }
func test_u16_to_f64(n uint16) float64 { return float64(n) }
func test_u32_to_f16(n uint32) float16 { return float16(n) }
func test_u32_to_f32(n uint32) float32 { return float32(n) }
func test_u32_to_f64(n uint32) float64 { return float64(n) }
func test_u64_to_f16(n uint64) float16 { return float16(n) }
func test_u64_to_f32(n uint64) float32 { return float32(n) }
func test_u64_to_f64(n uint64) float64 { return float64(n) }

func main() {
    // --- uint8 -> int8 (wrap) ---
    print(test_u8_to_i8(200))
    print(test_u8_to_i8(100))
    print(test_u8_to_i8(127))
    print(test_u8_to_i8(128))
    print(test_u8_to_i8(255))

    // --- uint8 widening ---
    print(test_u8_to_u16(200))
    print(test_u8_to_u32(200))
    print(test_u8_to_u64(200))

    // --- uint16 -> int8/int16 (wrap) ---
    print(test_u16_to_i8(200))
    print(test_u16_to_i16(40000))
    print(test_u16_to_i16(100))

    // --- uint16 -> uint8 (narrowing) ---
    print(test_u16_to_u8(300))
    print(test_u16_to_u8(255))
    print(test_u16_to_u8(256))

    // --- uint16 widening ---
    print(test_u16_to_u32(40000))
    print(test_u16_to_u64(40000))

    // --- uint32 -> int8/int16/int32 (wrap) ---
    print(test_u32_to_i8(200))
    print(test_u32_to_i16(40000))
    print(test_u32_to_i32(3000000000))

    // --- uint32 -> uint8/uint16 (narrowing) ---
    print(test_u32_to_u8(300))
    print(test_u32_to_u16(70000))

    // --- uint32 widening ---
    print(test_u32_to_u64(3000000000))

    // --- uint64 -> int8 (wrap) ---
    print(test_u64_to_i8(200))
    print(test_u64_to_i8(100))
    print(test_u64_to_i8(255))
    print(test_u64_to_i8(127))
    print(test_u64_to_i8(128))

    // --- uint64 -> int16 (wrap) ---
    print(test_u64_to_i16(40000))
    print(test_u64_to_i16(100))

    // --- uint64 -> int32 (wrap) ---
    print(test_u64_to_i32(3000000000))

    // --- uint64 -> int64 (wrap) ---
    print(test_u64_to_i64(10000000000000000000))

    // --- uint64 -> uint8 (narrowing) ---
    print(test_u64_to_u8(300))
    print(test_u64_to_u8(255))
    print(test_u64_to_u8(256))

    // --- uint64 -> uint16 (narrowing) ---
    print(test_u64_to_u16(70000))
    print(test_u64_to_u16(65535))
    print(test_u64_to_u16(65536))

    // --- uint64 -> uint32 (narrowing) ---
    print(test_u64_to_u32(5000000000))

    // --- uint8 -> float ---
    print(test_u8_to_f16(200))
    print(test_u8_to_f32(200))
    print(test_u8_to_f64(200))

    // --- uint16 -> float ---
    print(test_u16_to_f16(1000))
    print(test_u16_to_f32(50000))
    print(test_u16_to_f64(50000))

    // --- uint32 -> float ---
    print(test_u32_to_f16(1000))
    print(test_u32_to_f32(100000))
    print(test_u32_to_f64(100000))

    // --- UINT32_MAX -> float32/float64 ---
    print(test_u32_to_f32(4294967295))
    print(test_u32_to_f64(4294967295))

    // --- uint64 -> float ---
    print(test_u64_to_f16(1000))
    print(test_u64_to_f32(100000))
    print(test_u64_to_f64(100000))

    // --- UINT64_MAX -> float64 ---
    print(test_u64_to_f64(18446744073709551615))

    // --- UINT64_MAX -> float16 ---
    print(test_u64_to_f16(18446744073709551615))
}

// uint8 -> int8
// CHECK: -56
// CHECK: 100
// CHECK: 127
// CHECK: -128
// CHECK: -1
// uint8 widen
// CHECK: 200
// CHECK: 200
// CHECK: 200
// uint16 -> int
// CHECK: -56
// CHECK: -25536
// CHECK: 100
// uint16 -> uint8
// CHECK: 44
// CHECK: 255
// CHECK: 0
// uint16 widen
// CHECK: 40000
// CHECK: 40000
// uint32 -> int
// CHECK: -56
// CHECK: -25536
// CHECK: -1294967296
// uint32 -> uint
// CHECK: 44
// CHECK: 4464
// uint32 widen
// CHECK: 3000000000
// uint64 -> int8
// CHECK: -56
// CHECK: 100
// CHECK: -1
// CHECK: 127
// CHECK: -128
// uint64 -> int16
// CHECK: -25536
// CHECK: 100
// uint64 -> int32
// CHECK: -1294967296
// uint64 -> int64
// CHECK: -8446744073709551616
// uint64 -> uint8
// CHECK: 44
// CHECK: 255
// CHECK: 0
// uint64 -> uint16
// CHECK: 4464
// CHECK: 65535
// CHECK: 0
// uint64 -> uint32
// CHECK: 705032704
// uint8 -> float
// CHECK: 200
// CHECK: 200
// CHECK: 200
// uint16 -> float
// CHECK: 1000
// CHECK: 50000
// CHECK: 50000
// uint32 -> float
// CHECK: 1000
// CHECK: 100000
// CHECK: 100000
// UINT32_MAX -> float
// CHECK: 4294967296
// CHECK: 4294967295
// uint64 -> float
// CHECK: 1000
// CHECK: 100000
// CHECK: 100000
// UINT64_MAX -> float64
// CHECK: 1.8446744073709552e+19
// UINT64_MAX -> float16
// CHECK: inf
