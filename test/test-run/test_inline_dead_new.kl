// RUN: koala %s ++ --dump=vreg | filecheck %s

// 'new' is kept although its uses are inlined away, it still gets a register

class Foo {
    func get() int { return 1 }
}

func run() {
    let foo = Foo()
    print(foo.get())
}

run()

// CHECK: =============== LSRA @run ===============
// CHECK-EMPTY:
// CHECK-NEXT: --- Intervals ---
// CHECK-EMPTY:
// CHECK-NEXT: %0: range: [1, 2) reg: 0
// CHECK-EMPTY:
// CHECK-NEXT: --- Timeline & Registers ---
// CHECK-EMPTY:
// CHECK-EMPTY:
// CHECK-NEXT: %bb0(entry)[idx:0,pos:1-10]:
// CHECK-NEXT:    1: [R0] %0 = new @test_inline_dead_new.Foo
// CHECK-NEXT:    2: [R1] %1 = local int64        [fixedslot = 0(next) -> R1]
// CHECK-NEXT:    3: [...] load_int_imm %1 int64, 1 int64
// CHECK-NEXT:    4: [R1] %2 = build_intern @tuple, nargs=1        [fixedslot = 0(next) -> R1]
// CHECK-NEXT:    5: [R2] %3 = local str        [fixedslot = 1(next) -> R2]
// CHECK-NEXT:    6: [...] loadk %3 str, ' ' str
// CHECK-NEXT:    7: [R3] %4 = local str        [fixedslot = 2(next) -> R3]
// CHECK-NEXT:    8: [...] loadk %4 str, '\n' str
// CHECK-NEXT:    9: [...] call @print [path = 'std/prelude'], nargs=3
// CHECK-NEXT:   10: [...] ret void
// CHECK-EMPTY:
// CHECK-NEXT: --- Max Register(local + call-args) ---
// CHECK-NEXT: Max registers needed: 1 + 3

// CHECK: 1
