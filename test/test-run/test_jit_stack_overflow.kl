// RUN: koala %s ++ --no-inline 2>&1 | filecheck %s
// RUN: env KOALA_JIT=0 koala %s ++ --no-inline 2>&1 | filecheck %s
// RUN: sh -c 'ulimit -s 512; exec env KOALA_JIT=0 koala "$1" ++ --no-inline' _ %s 2>&1 | filecheck %s
// RUN: env KOALA_JIT_THRESHOLD=100 koala %s ++ --no-inline 2>&1 | filecheck %s
// Direct self recursion raises "stack overflow" (VM or native stack) in both
// interpreter and JIT; the repeated traceback lines collapse.

func depth(n int) int {
    if n == 0 { return 0 }
    return depth(n - 1) + 1
}

func main() {
    print(depth(10000000))
}

// CHECK: Traceback (most recent call last):
// CHECK-NEXT:   File "{{.*}}test_jit_stack_overflow.kl", line 10, in depth
// CHECK-NEXT:     return depth(n - 1) + 1
// CHECK-NEXT:   File "{{.*}}test_jit_stack_overflow.kl", line 10, in depth
// CHECK-NEXT:     return depth(n - 1) + 1
// CHECK-NEXT:   File "{{.*}}test_jit_stack_overflow.kl", line 10, in depth
// CHECK-NEXT:     return depth(n - 1) + 1
// CHECK-NEXT:   [Previous line repeated {{[0-9]+}} more times]
// CHECK-NEXT:   File "{{.*}}test_jit_stack_overflow.kl", line 14, in main
// CHECK: Error: stack overflow
