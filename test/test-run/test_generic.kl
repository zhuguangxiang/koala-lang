// RUN: koala %s | filecheck %s

import "test_pkg/pkg1" as z

class Foo[T] {
    var value T

    func __init__(_value T) {
        value = _value
    }

    func set_value(_value T) {
        value = _value
    }

    func get_value() T {
        return value
    }
}

func main() {
    let foo = Foo[int](42)

    print(foo.get_value())
    foo.set_value(100)
    print(foo.get_value())

    print(foo.value)
    foo.value = 200
    print(foo.value)

    let foo2 = Foo[str]("hello")
    print(foo2.get_value())
    foo2.set_value("world")
    print(foo2.get_value())

    let foo3 = Foo(1)
    print(foo3.get_value())
    print(foo3.value)

    let bar = z.BAR[int](42)
    print(bar.get_value())
    bar.set_value(100)
    print(bar.get_value())

    let bar2 = z.BAR("hello")
    print(bar2.get_value())
    bar2.set_value("world")
    print(bar2.get_value())
}

// CHECK: 42
// CHECK: 100
// CHECK: 100
// CHECK: 200
// CHECK: hello
// CHECK: world
// CHECK: 1
// CHECK: 1
// CHECK: 42
// CHECK: 100
// CHECK: hello
// CHECK: world
