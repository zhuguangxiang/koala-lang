// RUN: koala %s | filecheck %s
// A str is a sequence of characters (Manual, "The string type is `str`"; std/builtin/str.kl: "str
// operates at the character level"). At run time len(), indexing and iteration went by byte:
// "考拉".len() was 6, s[0] the first byte of 考, and `for c in s` gave six broken pieces.

func main() {
    let s = "考拉"
    print(s.len(), s[0], s[1])

    var parts = list[str]()
    for c in s { parts.append(c) }
    print(parts.len(), parts[0], parts[1])

    print("a考b".index("b"), "a考b".substr(1, 2))
}

// CHECK: 2 考 拉
// CHECK-NEXT: 2 考 拉
// CHECK-NEXT: 2 考
