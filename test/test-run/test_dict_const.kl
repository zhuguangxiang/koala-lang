// RUN: koala %s ++ --dump=no-opt-ir,code | filecheck %s
//
// Two identical all-constant map literals must not share one object: a dict
// is mutable, so each literal gets its own `new @dict` + `__init__` + `seq.set`
// (never a const pool entry), otherwise mutating one would be visible through
// the other.
func main() {
    let a = {1: 2, 3: 4}
    let b = {1: 2, 3: 4}
    print(a)
    print(b)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK: %0 = new @std/builtin.dict[int64, int64]
// CHECK: call @dict:__init__ [path = 'std/builtin'], %0 std/builtin.dict[int64, int64]
// CHECK: seq.set %0 std/builtin.dict[int64, int64], 1 int64, 2 int64
// CHECK: seq.set %0 std/builtin.dict[int64, int64], 3 int64, 4 int64
// CHECK: %a = local [immutable] std/builtin.dict[int64, int64]
// CHECK: move %a std/builtin.dict[int64, int64], %0 std/builtin.dict[int64, int64]
// CHECK: %1 = new @std/builtin.dict[int64, int64]
// CHECK: call @dict:__init__ [path = 'std/builtin'], %1 std/builtin.dict[int64, int64]
// CHECK: seq.set %1 std/builtin.dict[int64, int64], 1 int64, 2 int64
// CHECK: seq.set %1 std/builtin.dict[int64, int64], 3 int64, 4 int64
// CHECK: %b = local [immutable] std/builtin.dict[int64, int64]
// CHECK: move %b std/builtin.dict[int64, int64], %1 std/builtin.dict[int64, int64]
// CHECK: ret void

// Two separate allocations into different registers: the literals were not
// folded together.
// CHECK-LABEL: @main[0,28]:
// CHECK: new r0, #0
// CHECK: new r1, #0

// CHECK-LABEL: Constant Pool:
// CHECK-NEXT: [000] str     = " "
// CHECK-NEXT: [001] str     = "\n"
// CHECK-NOT: dict(

// CHECK:{1: 2, 3: 4}
// CHECK:{1: 2, 3: 4}