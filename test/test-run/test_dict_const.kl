// RUN: koala %s ++ --dump=no-opt-ir,code | filecheck %s
//
// Two identical all-constant map literals must not share one object: a dict
// is mutable, so each literal is its own `build_intern @map` (never a const
// pool entry), otherwise mutating one would be visible through the other.
func main() {
    let a = {1: 2, 3: 4}
    let b = {1: 2, 3: 4}
    print(a)
    print(b)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK: %0 = build_intern @map, 1 int64, 2 int64, 3 int64, 4 int64
// CHECK: %a = local [immutable] std/builtin.dict<jj>
// CHECK: move %a std/builtin.dict<jj>, %0 std/builtin.dict<jj>
// CHECK: %1 = build_intern @map, 1 int64, 2 int64, 3 int64, 4 int64
// CHECK: %b = local [immutable] std/builtin.dict<jj>
// CHECK: move %b std/builtin.dict<jj>, %1 std/builtin.dict<jj>
// CHECK-NOT: dict[
// CHECK: ret void

// Two separate build_intern: the literals were not folded together.
// CHECK-LABEL: @main[0,24]:
// CHECK: build_intern r0, @map, #4
// CHECK-NEXT: move r1, r0
// CHECK: build_intern r0, @map, #4
// CHECK-NEXT: move r2, r0

// CHECK-LABEL: Constant Pool:
// CHECK-NEXT: [000] str     = " "
// CHECK-NEXT: [001] str     = "\n"
// CHECK-NOT: dict(

// CHECK:{1: 2, 3: 4}
// CHECK:{1: 2, 3: 4}