// RUN: koala %s 2>&1 | filecheck %s

class Foo {
    let msg = "hello"

    func __init__(m str) {
        msg = m
    }

    func hello() {
        print(msg)
    }

    static func bar() str {
        return "world"
    }

    static func baz(f Foo) str {
        return f.msg
    }
}

func main() {
    let f = Foo("hello...")
    f.hello()
    print(Foo.bar())
    print(Foo.baz(f))
}

// CHECK: hello...
// CHECK: world
// CHECK: hello...
