// RUN: koala %s | filecheck %s

import "test_pkg/pkg1" as z

link "pkg1_native"

class Foo : z.Animal {

    func fly(name str, age int) str {
        print(name, age)
        return "Foo is flying"
    }

    @native
    func swim(name str, age int) str {}
}

func main() {
    let an z.Animal = Foo()
    z.test_pkg_foo(an)
    print(an.swim("Dolphin", 5))
}

// CHECK: test_pkg_foo_func is called
// CHECK: Eagle 3
// CHECK: <Dolphin is swimming, age 5>
