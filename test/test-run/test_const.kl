// RUN: koala %s ++ --dump=no-opt-ir,ir | filecheck %s

import "test_pkg/pkg1" as zz

const NAME = "Jerry"
pub const AGE = 30

func main() {
	print("Name:", NAME)
	print("Age:", AGE)
	print("PI:", zz.PI)
	print("E:", zz.E)
	print("GREETING:", zz.GREETING)
	print("GOLDEN_RATIO:", zz.GOLDEN_RATIO)
	print("INT64_MIN:", zz.INT64_MIN)
	print("INT64_MAX:", zz.INT64_MAX)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// a const of this module is read as its literal, like an imported one: no global_get
// CHECK-LABEL: func @main() <NO-TYPE> {
// CHECK-NOT: global_get
// CHECK: call @print [path = 'std/prelude', const], tuple('Name:', 'Jerry') std/builtin.tuple[str, str]
// CHECK: call @print [path = 'std/prelude', const], tuple('Age:', 30) std/builtin.tuple[str, int64]
// CHECK: call @print [path = 'std/prelude', const], tuple('PI:', 3.141590) std/builtin.tuple[str, float64]
// CHECK: call @print [path = 'std/prelude', const], tuple('E:', 2.718280) std/builtin.tuple[str, float64]
// CHECK: call @print [path = 'std/prelude', const], tuple('GREETING:', 'Hello') std/builtin.tuple[str, str]
// CHECK: call @print [path = 'std/prelude', const], tuple('GOLDEN_RATIO:', 1.618030) std/builtin.tuple[str, float64]
// CHECK: call @print [path = 'std/prelude', const], tuple('INT64_MIN:', -9223372036854775808) std/builtin.tuple[str, int64]
// CHECK: call @print [path = 'std/prelude', const], tuple('INT64_MAX:', 9223372036854775807) std/builtin.tuple[str, int64]

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @__init__() <NO-TYPE> {
// CHECK: global_set @NAME str, 'Jerry' str
// CHECK: global_set @AGE int64, 30 int64

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@__init__] ---
// CHECK-LABEL: func @__init__() <NO-TYPE> {
// CHECK: %bb0(entry):
// CHECK: }

// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 1) [@main] ---
// CHECK-LABEL: func @main() <NO-TYPE> {
// CHECK: call @print [path = 'std/prelude', const], tuple('Name:', 'Jerry') std/builtin.tuple[str, str]
// CHECK: call @print [path = 'std/prelude', const], tuple('Age:', 30) std/builtin.tuple[str, int64]
// CHECK: call @print [path = 'std/prelude', const], tuple('PI:', 3.141590) std/builtin.tuple[str, float64]
// CHECK: call @print [path = 'std/prelude', const], tuple('E:', 2.718280) std/builtin.tuple[str, float64]
// CHECK: call @print [path = 'std/prelude', const], tuple('GREETING:', 'Hello') std/builtin.tuple[str, str]
// CHECK: call @print [path = 'std/prelude', const], tuple('GOLDEN_RATIO:', 1.618030) std/builtin.tuple[str, float64]
// CHECK: call @print [path = 'std/prelude', const], tuple('INT64_MIN:', -9223372036854775808) std/builtin.tuple[str, int64]
// CHECK: call @print [path = 'std/prelude', const], tuple('INT64_MAX:', 9223372036854775807) std/builtin.tuple[str, int64]

// CHECK: Name: Jerry
// CHECK: Age: 30
// CHECK: PI: 3.14159
// CHECK: E: 2.71828
// CHECK: GREETING: Hello
// CHECK: GOLDEN_RATIO: 1.61803
// CHECK: INT64_MIN: -9223372036854775808
// CHECK: INT64_MAX: 9223372036854775807
