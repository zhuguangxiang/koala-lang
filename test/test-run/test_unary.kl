// RUN: koala %s | filecheck %s

func nb(b bool) bool { return !b }

// ---------- unary on a param ----------

// func neg_i8(n int8) int8 { return -n }
// func neg_i16(n int16) int16 { return -n }
// func neg_i32(n int32) int32 { return -n }
// func neg_i64(n int64) int64 { return -n }

// func pos_i8(n int8) int8 { return +n }
// func pos_i16(n int16) int16 { return +n }
// func pos_i32(n int32) int32 { return +n }
// func pos_i64(n int64) int64 { return +n }

// func neg_f16(n float16) float16 { return -n }
// func neg_f32(n float32) float32 { return -n }
// func neg_f64(n float64) float64 { return -n }

// func pos_f16(n float16) float16 { return +n }
// func pos_f32(n float32) float32 { return +n }
// func pos_f64(n float64) float64 { return +n }

// func bnot_i8(n int8) int8 { return ~n }
// func bnot_i16(n int16) int16 { return ~n }
// func bnot_i32(n int32) int32 { return ~n }
// func bnot_i64(n int64) int64 { return ~n }

// func bnot_u8(n uint8) uint8 { return ~n }
// func bnot_u16(n uint16) uint16 { return ~n }
// func bnot_u32(n uint32) uint32 { return ~n }
// func bnot_u64(n uint64) uint64 { return ~n }

func main() {
    // --- literal ---
    print(-5)
    print(+5)
    print(-1.5)
    print(+1.5)

    // --- ! on a param ---
    print(nb(true))
    print(nb(false))

    // --- ! on a literal ---
    // print(!true)   // expect: false
    // print(!false)  // expect: true

    // --- ! on a let ---
    // let t bool = true
    // print(!t)  // expect: false

    // --- - on a param ---
    // print(neg_i8(5))        // expect: -5
    // print(neg_i16(1000))    // expect: -1000
    // print(neg_i32(100000))  // expect: -100000
    // print(neg_i64(100000))  // expect: -100000

    // --- + on a param ---
    // print(pos_i8(5))        // expect: 5
    // print(pos_i16(1000))    // expect: 1000
    // print(pos_i32(100000))  // expect: 100000
    // print(pos_i64(100000))  // expect: 100000

    // --- - on a float param ---
    // print(neg_f16(1.5))  // expect: -1.5
    // print(neg_f32(1.5))  // expect: -1.5
    // print(neg_f64(1.5))  // expect: -1.5

    // --- + on a float param ---
    // print(pos_f16(1.5))  // expect: 1.5
    // print(pos_f32(1.5))  // expect: 1.5
    // print(pos_f64(1.5))  // expect: 1.5

    // --- ~ on a literal ---
    // print(~0)   // expect: -1
    // print(~5)   // expect: -6
    // print(~-1)  // expect: 0

    // --- ~ on an int param ---
    // print(bnot_i8(5))   // expect: -6
    // print(bnot_i16(5))  // expect: -6
    // print(bnot_i32(5))  // expect: -6
    // print(bnot_i64(5))  // expect: -6

    // --- ~ on a uint param ---
    // print(bnot_u8(5))   // expect: 250
    // print(bnot_u16(5))  // expect: 65530
    // print(bnot_u32(5))  // expect: 4294967290
    // print(bnot_u64(5))  // expect: 18446744073709551610
}

// literal
// CHECK: -5
// CHECK: 5
// CHECK: -1.5
// CHECK: 1.5
// ! on a param
// CHECK: false
// CHECK: true
