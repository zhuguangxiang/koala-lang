// RUN: koala %s | filecheck %s
// RUN: env KOALA_JIT=0 koala %s ++ --no-inline | filecheck %s
// RUN: koalac %s --irgen --dump=no-opt-ir | filecheck %s --check-prefix=IR
// RUN: koalac %s --opt --dump=ir | filecheck %s --check-prefix=OPT

// '-' and '~' return what `__neg__` / `__bitnot__` declare in std/builtin/number.kl:
// int8..int32 and uint8..uint32 give int64 (like their binary operators), int64 gives int64,
// uint64 has only `~` (uint64), floats give float64. '+' keeps the type.

func nb(b bool) bool { return !b }

func neg_i8(n int8) int { return -n }
func neg_i16(n int16) int { return -n }
func neg_i32(n int32) int { return -n }
func neg_i64(n int64) int { return -n }

func pos_i8(n int8) int8 { return +n }
func pos_i16(n int16) int16 { return +n }
func pos_i32(n int32) int32 { return +n }
func pos_i64(n int64) int64 { return +n }

func neg_f32(n float32) float { return -n }
func neg_f64(n float64) float { return -n }
func pos_f32(n float32) float32 { return +n }
func pos_f64(n float64) float64 { return +n }

func bnot_i8(n int8) int { return ~n }
func bnot_i16(n int16) int { return ~n }
func bnot_i32(n int32) int { return ~n }
func bnot_i64(n int64) int { return ~n }

func bnot_u8(n uint8) int { return ~n }
func bnot_u16(n uint16) int { return ~n }
func bnot_u32(n uint32) int { return ~n }
func bnot_u64(n uint64) uint { return ~n }
func neg_u8(n uint8) int { return -n }

// folded by const-copy-prop in the promoted type
func const_bnot() int {
    let x int8 = 5
    return ~x
}
func const_neg() int {
    let x uint8 = 1
    return -x
}

func main() {
    // literal
    print(-5, +5, -1.5, +1.5)
    print(!true, !false, ~0, ~5, ~-1, -(-3), ~~5, !!true)

    // ! on a param and a let
    let t bool = true
    print(nb(true), nb(false), !t)

    // - and + on a param
    print(neg_i8(5), neg_i16(1000), neg_i32(100000), neg_i64(100000))
    print(neg_i8(-128), neg_i16(-32768), neg_i32(-2147483648))
    print(pos_i8(5), pos_i16(1000), pos_i32(100000), pos_i64(100000))
    print(neg_f32(1.5), neg_f64(1.5), pos_f32(1.5), pos_f64(1.5))

    // ~ on a param
    print(bnot_i8(5), bnot_i16(5), bnot_i32(5), bnot_i64(5), bnot_i8(-128))
    print(bnot_u8(5), bnot_u16(5), bnot_u32(5), bnot_u64(5))
    print(neg_u8(1))

    // on a local
    var i8 int8 = -128
    var u8 uint8 = 0
    print(-i8, ~i8, ~u8)
    let r1 = ~u8
    let r2 = -i8
    var u64 uint64 = 5
    let r3 = ~u64
    var f32 float32 = 1.5
    let r4 = -f32
    print(typeof(r1), typeof(r2), typeof(r3), typeof(r4))
    print(const_bnot(), const_neg())
}

// CHECK: -5 5 -1.5 1.5
// CHECK-NEXT: false true -1 -6 0 3 5 true
// CHECK-NEXT: false true false
// CHECK-NEXT: -5 -1000 -100000 -100000
// CHECK-NEXT: 128 32768 2147483648
// CHECK-NEXT: 5 1000 100000 100000
// CHECK-NEXT: -1.5 -1.5 1.5 1.5
// CHECK-NEXT: -6 -6 -6 -6 127
// CHECK-NEXT: -6 -6 -6 18446744073709551610
// CHECK-NEXT: -1
// CHECK-NEXT: 128 127 -1
// CHECK-NEXT: <class 'int64'> <class 'int64'> <class 'uint64'> <class 'float64'>
// CHECK-NEXT: -6 -1

// IR-LABEL: func @neg_i8(%n int8) int64 {
// IR: %0 = cast %n int8 to int64
// IR-NEXT: %1 = neg %0 int64
// IR-NEXT: ret %1 int64
// IR-LABEL: func @pos_i8(%n int8) int8 {
// IR-NEXT: %bb0(entry):
// IR-NEXT: ret %n int8
// IR-LABEL: func @neg_f32(%n float32) float64 {
// IR: %0 = cast %n float32 to float64
// IR-NEXT: %1 = neg %0 float64
// IR-LABEL: func @bnot_i8(%n int8) int64 {
// IR: %0 = cast %n int8 to int64
// IR-NEXT: %1 = not %0 int64
// IR-LABEL: func @bnot_u8(%n uint8) int64 {
// IR: %0 = cast %n uint8 to int64
// IR-NEXT: %1 = not %0 int64
// IR-LABEL: func @bnot_u64(%n uint64) uint64 {
// IR-NEXT: %bb0(entry):
// IR-NEXT: %0 = not %n uint64

// OPT-LABEL: func @const_bnot() int64 {
// OPT: ret -6 int64
// OPT-LABEL: func @const_neg() int64 {
// OPT: ret -1 int64
