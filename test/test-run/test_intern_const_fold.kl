// RUN: koala %s ++ --dump=no-opt-ir,ir,lir,code | filecheck %s
//
// An all-constant `build_intern @map/@list` is folded into a const-pool `loadk`
// by isel. The window only opens after opt: ir-gen still sees a variable operand
// here (`{1: x}` with `let x = 2`), and the pass that copies the constant into
// the operand rewrites the operand but not the opcode, so the node reaches isel
// as a `build_intern`. Folding late also lets klr_const_map() merge a duplicated
// key that ir-gen never saw. dict/list get one const entry per literal because
// they are mutable; a duplicated map key is merged, whereas a list is stored in
// order. `@tuple` is not folded yet (TODO in isel), so `(1, 2)` still goes
// through `build_intern` at runtime.
func main() {
    let x = 2
    let d = {1: x, 3: 4, 1: 5}
    print(d)

    let t = (1, x)
    print(t)

    let l = [1, x]
    print(l)

    let l2 = [1, x, 1]
    print(l2)
}

// ir-gen emits build_intern and keeps the variable operand.
// CHECK: --- IR Dump After ir-gen(no-opt) ---
// CHECK: func @main()
// CHECK: %0 = build_intern @map, 1 int64, %x int64, 3 int64, 4 int64, 1 int64, 5 int64
// CHECK: %2 = build_intern @tuple, 1 int64, %x int64
// CHECK: %4 = build_intern @list, 1 int64, %x int64
// CHECK: %6 = build_intern @list, 1 int64, %x int64, 1 int64

// opt copies the constant into the operand but leaves the opcode alone: the
// literals are now all-constant and still build_intern.
// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@main] ---
// CHECK: %0 = build_intern @map, 1 int64, 2 int64, 3 int64, 4 int64, 1 int64, 5 int64
// CHECK: %2 = build_intern @tuple, 1 int64, 2 int64
// CHECK: %4 = build_intern @list, 1 int64, 2 int64
// CHECK: %6 = build_intern @list, 1 int64, 2 int64, 1 int64

// isel folds the map and both lists into a `loadk` of a const-pool template.
// The duplicated map key `1` is merged onto the last occurrence, like the
// runtime dict overwrite. Tuples are not folded yet, so `(1, 2)` is still packed
// at runtime: its two constants are materialised and handed to
// `build_intern @tuple`.
// CHECK-LABEL: --- IR Dump After isel [@main] ---
// CHECK: loadk %0 std/builtin.dict<jj>, dict[1: 5, 3: 4] std/builtin.dict<jj>
// CHECK: load_int_imm %4 int64, 1 int64
// CHECK: load_int_imm %5 int64, 2 int64
// CHECK: %6 = build_intern @tuple, nargs=2
// CHECK: loadk %10 std/builtin.list<j>, list[1, 2] std/builtin.list<j>
// CHECK: loadk %14 std/builtin.list<j>, list[1, 2, 1] std/builtin.list<j>
// The remaining build_interns are print's varargs packing.
// CHECK-NOT: build_intern @map
// CHECK-NOT: build_intern @list
// CHECK: build_intern @tuple, nargs=1
// CHECK: ret void

// No map/list literal reaches the bytecode as build_intern any more.
// CHECK-LABEL: @main[0,29]:
// Both lists are one `loadk` each: #8 is `[1, 2]`, #9 is `[1, 2, 1]`.
// CHECK: loadk r0, #8
// CHECK: loadk r0, #9
// CHECK-NOT: build_intern r{{[0-9]+}}, @map
// CHECK-NOT: build_intern r{{[0-9]+}}, @list
// CHECK: ret_void

// Each folded literal owns one const-pool entry; tuples have none. The two lists
// get separate slots even though `[1, 2]` is a prefix of `[1, 2, 1]`: a literal
// never shares a template with another one.
// CHECK-LABEL: Constant Pool:
// CHECK: [004] dict(2):
// CHECK: [008] list(2):
// CHECK: [009] list(3):
// CHECK: [0] int64   = 1
// CHECK: [1] int64   = 2
// CHECK: [2] int64   = 1

// CHECK:{1: 5, 3: 4}
// CHECK:(1, 2)
// CHECK:[1, 2]
// CHECK:[1, 2, 1]