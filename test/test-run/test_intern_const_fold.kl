// RUN: koala %s ++ --dump=no-opt-ir,ir,lir,code | filecheck %s
//
// An all-constant `build_intern @map/@list` is NOT folded into the const pool:
// a dict or list is mutable, so it must be built afresh on every evaluation.
// ir-gen sees a variable operand here (`{1: x}` with `let x = 2`), and opt
// copies the constant into the operand, so the node reaches isel as a
// `build_intern` whose operands are all constants; isel lowers it the normal
// way (each operand loaded, then the object built), and no dict or list ends
// up in the const pool. A duplicated map key is merged by the runtime dict.
// `@tuple` is not folded either, so `(1, 2)` goes through `build_intern` too.
func main() {
    let x = 2
    let d = {1: x, 3: 4, 1: 5}
    print(d)

    let t = (1, x)
    print(t)

    let l = [1, x]
    print(l)

    let l2 = [1, x, 1]
    print(l2)
}

// ir-gen emits build_intern and keeps the variable operand.
// CHECK: --- IR Dump After ir-gen(no-opt) ---
// CHECK: func @main()
// CHECK: %0 = build_intern @map, 1 int64, %x int64, 3 int64, 4 int64, 1 int64, 5 int64
// CHECK: %2 = build_intern @tuple, 1 int64, %x int64
// CHECK: %4 = build_intern @list, 1 int64, %x int64
// CHECK: %6 = build_intern @list, 1 int64, %x int64, 1 int64

// opt copies the constant into the operand but leaves the opcode alone: the
// literals are now all-constant and still build_intern.
// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@main] ---
// CHECK: %0 = build_intern @map, 1 int64, 2 int64, 3 int64, 4 int64, 1 int64, 5 int64
// CHECK: %2 = build_intern @tuple, 1 int64, 2 int64
// CHECK: %4 = build_intern @list, 1 int64, 2 int64
// CHECK: %6 = build_intern @list, 1 int64, 2 int64, 1 int64

// isel keeps every build_intern: the constants are loaded into the argument
// slots and the map / tuple / lists are built at run time; the duplicated map
// key `1` is still in the operands.
// CHECK-LABEL: --- IR Dump After isel [@main] ---
// CHECK: load_int_imm %0 int64, 1 int64
// CHECK: load_int_imm %4 int64, 1 int64
// CHECK: load_int_imm %5 int64, 5 int64
// CHECK: %6 = build_intern @map, nargs=6
// CHECK: %12 = build_intern @tuple, nargs=2
// CHECK: %18 = build_intern @list, nargs=2
// CHECK: %25 = build_intern @list, nargs=3
// CHECK-NOT: loadk %{{[0-9]+}} std/builtin.list
// CHECK-NOT: loadk %{{[0-9]+}} std/builtin.dict
// CHECK: ret void

// The bytecode builds each literal with build_intern.
// CHECK-LABEL: @main[0,40]:
// CHECK: build_intern r0, @map, #6
// CHECK: build_intern r1, @tuple, #2
// CHECK: build_intern r0, @list, #2
// CHECK: build_intern r0, @list, #3
// CHECK: ret_void

// No dict or list in the const pool: only print's separators.
// CHECK-LABEL: Constant Pool:
// CHECK-NEXT: [000] str     = " "
// CHECK-NEXT: [001] str     = "\n"
// CHECK-NOT: dict(
// CHECK-NOT: list(
// CHECK-LABEL: Import Table:

// CHECK:{1: 5, 3: 4}
// CHECK:(1, 2)
// CHECK:[1, 2]
// CHECK:[1, 2, 1]