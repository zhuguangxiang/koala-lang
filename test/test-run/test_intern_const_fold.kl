// RUN: koala %s ++ --dump=no-opt-ir,ir,lir,code | filecheck %s
//
// An all-constant dict / list literal is NOT folded into the const pool: both
// are mutable, so they must be built afresh on every evaluation. ir-gen sees a
// variable operand here (`{1: x}` with `let x = 2`), and opt copies the constant
// into the operand, so the entries reach isel as all-constant `seq.set`s; isel
// lowers them the normal way (each value loaded, then stored), and no dict or
// list ends up in the const pool. A duplicated map key is merged by the runtime
// dict. `@tuple` is not folded either, so `(1, 2)` goes through `build_tuple`.
func main() {
    let x = 2
    let d = {1: x, 3: 4, 1: 5}
    print(d)

    let t = (1, x)
    print(t)

    let l = [1, x]
    print(l)

    let l2 = [1, x, 1]
    print(l2)
}

// ir-gen emits new + __init__ + seq.set for the dict and keeps the variable operand.
// CHECK: --- IR Dump After ir-gen(no-opt) ---
// CHECK: func @main()
// CHECK: %0 = new @std/builtin.dict[int64, int64]
// CHECK: call @dict:__init__ [path = 'std/builtin'], %0 std/builtin.dict[int64, int64]
// CHECK: seq.set %0 std/builtin.dict[int64, int64], 1 int64, %x int64
// CHECK: seq.set %0 std/builtin.dict[int64, int64], 3 int64, 4 int64
// CHECK: seq.set %0 std/builtin.dict[int64, int64], 1 int64, 5 int64
// CHECK: %2 = build_tuple, 1 int64, %x int64
// CHECK: %4 = new @std/builtin.list[int64]
// CHECK: call @list:__init__ [path = 'std/builtin'], %4 std/builtin.list[int64], 1 int64, %x int64
// CHECK: %6 = new @std/builtin.list[int64]
// CHECK: call @list:__init__ [path = 'std/builtin'], %6 std/builtin.list[int64], 1 int64, %x int64, 1 int64

// opt copies the constant into the operands but leaves the opcodes alone: the
// entries are now all-constant and still built at run time.
// CHECK-LABEL: --- IR Dump After dead-code-elimination (Iter 2) [@main] ---
// CHECK: %0 = new @std/builtin.dict[int64, int64]
// CHECK: seq.set %0 std/builtin.dict[int64, int64], 1 int64, 2 int64
// CHECK: seq.set %0 std/builtin.dict[int64, int64], 3 int64, 4 int64
// CHECK: seq.set %0 std/builtin.dict[int64, int64], 1 int64, 5 int64
// CHECK: %2 = build_tuple, 1 int64, 2 int64
// CHECK: %4 = new @std/builtin.list[int64]
// CHECK: call @list:__init__ [path = 'std/builtin'], %4 std/builtin.list[int64], 1 int64, 2 int64
// CHECK: %6 = new @std/builtin.list[int64]
// CHECK: call @list:__init__ [path = 'std/builtin'], %6 std/builtin.list[int64], 1 int64, 2 int64, 1 int64

// isel keeps the dict construction: the values are loaded into registers and
// stored with seq.set_imm at run time; the duplicated map key `1` is still
// there. The tuple stays build_tuple, each list is `new` + `call @list:__init__`.
// CHECK-LABEL: --- IR Dump After isel [@main] ---
// CHECK: %0 = new @std/builtin.dict[int64, int64]
// CHECK: call @dict:__init__ [path = 'std/builtin'], nargs=1
// CHECK: load_int_imm %2 int64, 2 int64
// CHECK: seq.set_imm %0 std/builtin.dict[int64, int64], 1 int64, %2 int64
// CHECK: load_int_imm %4 int64, 5 int64
// CHECK: seq.set_imm %0 std/builtin.dict[int64, int64], 1 int64, %4 int64
// CHECK: %10 = build_tuple, nargs=2
// CHECK: %14 = new @std/builtin.list[int64]
// CHECK: call @list:__init__ [path = 'std/builtin'], nargs=3
// CHECK: %21 = new @std/builtin.list[int64]
// CHECK: call @list:__init__ [path = 'std/builtin'], nargs=4
// CHECK-NOT: loadk %{{[0-9]+}} std/builtin.list
// CHECK-NOT: loadk %{{[0-9]+}} std/builtin.dict
// CHECK: ret void

// The bytecode builds the dict with `new` + `__init__` + seq.set_imm, the tuple
// with build_tuple, and each list with `new` + `call @list:__init__`.
// CHECK-LABEL: @main[0,49]:
// CHECK: new r0, #0
// CHECK: seq.set_imm r0, r1, #1
// CHECK: build_tuple r2, #2
// CHECK: new r0, #1
// CHECK: call flg=0, #3
// CHECK: new r0, #1
// CHECK: call flg=0, #4
// CHECK: ret_void

// No dict or list in the const pool: only print's separators.
// CHECK-LABEL: Constant Pool:
// CHECK-NEXT: [000] str     = " "
// CHECK-NEXT: [001] str     = "\n"
// CHECK-NOT: dict(
// CHECK-NOT: list(
// CHECK-LABEL: Import Table:

// CHECK:{1: 5, 3: 4}
// CHECK:(1, 2)
// CHECK:[1, 2]
// CHECK:[1, 2, 1]
