// RUN: koala %s --dump=no-opt-ir | filecheck %s

class BAR {
    var x = 100
    var y = "BAR"
}

class Point {
    var x int
    var y int
    let z int = 10

    func __init__(_x int, _y int) {
        x = _x
        y = _y
    }

    func area() (int, int, int) {
        return (x, y, x * y)
    }
}

func main() {
    let p = Point(1, 2)
    let b = BAR()
    print(b, b.x, b.y)
    print(p, p.x, p.y, p.z)
    print(range(100, 200))
    let r = range(1, 2, 3)
    print(r)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @Point::__init__(%self Point, %_x int64, %_y int64) <NO-TYPE> {
// CHECK: %bb0(entry):
// CHECK: set_field %self Point, z(index=2), 10 int64
// CHECK: set_field %self Point, x(index=0), %_x int64
// CHECK: set_field %self Point, y(index=1), %_y int64
// CHECK: ret void

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @Point::area(%self Point) tuple<jjj> {
// CHECK: %bb0(entry):
// CHECK: %0 = get_field %self Point, x(index=0)
// CHECK: %1 = get_field %self Point, y(index=1)
// CHECK: %2 = get_field %self Point, x(index=0)
// CHECK: %3 = get_field %self Point, y(index=1)
// CHECK: %4 = mul %2 int64, %3 int64
// CHECK: %5 = build_intern @tuple, %0 int64, %1 int64, %4 int64
// CHECK: ret %5 tuple<jjj>

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main() <NO-TYPE> {
// CHECK: %bb0(entry):
// CHECK: %0 = new @Point
// CHECK: call @Point::__init__, %0 Point, 1 int64, 2 int64
// CHECK: %p = local [immutable] Point
// CHECK: move %p Point, %0 Point
// CHECK: %1 = new @BAR
// CHECK: call @BAR::__init__, %1 BAR
// CHECK: %b = local [immutable] BAR
// CHECK: move %b BAR, %1 BAR
// CHECK: %2 = get_field %b BAR, x(index=0)
// CHECK: %3 = get_field %b BAR, y(index=1)
// CHECK: %4 = build_intern @tuple, %b BAR, %2 int64, %3 str
// CHECK: call @print [path = 'std/builtin'], %4 tuple<LBAR;ju>, ' ' str, '\n' str
// CHECK: %5 = get_field %p Point, x(index=0)
// CHECK: %6 = get_field %p Point, y(index=1)
// CHECK: %7 = get_field %p Point, z(index=2)
// CHECK: %8 = build_intern @tuple, %p Point, %5 int64, %6 int64, %7 int64
// CHECK: call @print [path = 'std/builtin'], %8 tuple<LPoint;jjj>, ' ' str, '\n' str
// CHECK: call @print [path = 'std/builtin', const], tuple(range(100, 200, 1)) tuple<Lrange;>
// CHECK: ret void

// CHECK: <BAR object at 0x{{[0-9a-f]+}}> 100 BAR
// CHECK: <Point object at 0x{{[0-9a-f]+}}> 1 2 10
// CHECK: range(100, 200, 1)
// CHECK: range(1, 2, 3)
