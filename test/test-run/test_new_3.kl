// RUN: koala %s --dump=no-opt-ir --package-name=z | filecheck %s

class BAR {
    var x = 100
    var y = "BAR"
}

class Point {
    var x int
    var y int
    let z int = 10

    func __init__(_x int, _y int) {
        x = _x
        y = _y
    }

    func area() (int, int, int) {
        return (x, y, x * y)
    }
}

func main() {
    let p = Point(1, 2)
    let b = BAR()
    print(b, b.x, b.y)
    print(p, p.x, p.y, p.z)
    print(range(100, 200))
    let r = range(1, 2, 3)
    print(r)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @Point:__init__(%self z.Point, %_x int64, %_y int64) <NO-TYPE> {
// CHECK: %bb0(entry):
// CHECK: set_field %self z.Point, z(index=2), 10 int64
// CHECK: set_field %self z.Point, x(index=0), %_x int64
// CHECK: set_field %self z.Point, y(index=1), %_y int64
// CHECK: ret void

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @Point:area(%self z.Point) std/builtin.tuple<jjj> {
// CHECK: %bb0(entry):
// CHECK: %0 = get_field %self z.Point, x(index=0)
// CHECK: %1 = get_field %self z.Point, y(index=1)
// CHECK: %2 = get_field %self z.Point, x(index=0)
// CHECK: %3 = get_field %self z.Point, y(index=1)
// CHECK: %4 = mul %2 int64, %3 int64
// CHECK: %5 = build_intern @tuple, %0 int64, %1 int64, %4 int64
// CHECK: ret %5 std/builtin.tuple<jjj>

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK: %bb0(entry):
// CHECK: %0 = new @z.Point
// CHECK: call @Point:__init__, %0 z.Point, 1 int64, 2 int64
// CHECK: %p = local [immutable] z.Point
// CHECK: move %p z.Point, %0 z.Point
// CHECK: %1 = new @z.BAR
// CHECK: call @BAR:__init__, %1 z.BAR
// CHECK: %b = local [immutable] z.BAR
// CHECK: move %b z.BAR, %1 z.BAR
// CHECK: %2 = get_field %b z.BAR, x(index=0)
// CHECK: %3 = get_field %b z.BAR, y(index=1)
// CHECK: %4 = build_intern @tuple, %b z.BAR, %2 int64, %3 str
// CHECK: call @print [path = 'std/builtin'], %4 std/builtin.tuple<Lz.BAR;ju>, ' ' str, '\n' str
// CHECK: %5 = get_field %p z.Point, x(index=0)
// CHECK: %6 = get_field %p z.Point, y(index=1)
// CHECK: %7 = get_field %p z.Point, z(index=2)
// CHECK: %8 = build_intern @tuple, %p z.Point, %5 int64, %6 int64, %7 int64
// CHECK: call @print [path = 'std/builtin'], %8 std/builtin.tuple<Lz.Point;jjj>, ' ' str, '\n' str
// CHECK: call @print [path = 'std/builtin', const], tuple(range(100, 200, 1)) std/builtin.tuple<Lstd/builtin.range;>
// CHECK: ret void

// CHECK: <z.BAR object at 0x{{[0-9a-f]+}}> 100 BAR
// CHECK: <z.Point object at 0x{{[0-9a-f]+}}> 1 2 10
// CHECK: range(100, 200, 1)
// CHECK: range(1, 2, 3)
