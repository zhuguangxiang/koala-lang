// RUN: koala %s | filecheck %s
// The ';' of the last statement before '}' may be left out.

func ret_last() int { print("ret"); return 1 }

func main() {
    var i = 10
    let ln = [1, 2, 3]
    var n = 0
    loop {
        n += 1
        if n > 3 { break }
        if ln.len() == 3 { i += 1; continue }
    }
    print(i)

    var x = 0
    var y = 0
    { x = 1; y = 2 }
    print(x, y)

    { print("a"); print("b") }
    print(ret_last())

    for v in ln { if v == 2 { print("two"); break } }
}

// CHECK: 13
// CHECK-NEXT: 1 2
// CHECK-NEXT: a
// CHECK-NEXT: b
// CHECK-NEXT: ret
// CHECK-NEXT: 1
// CHECK-NEXT: two
// CHECK-NOT: {{.}}
