// RUN: koala %s ++ --dump=lir | filecheck %s

// 'x!' with 'var x' being nil: nil is not propagated into the unwrapping cast,
// nil_check panics at runtime, opt warns it

func var_nil() {
    var x str? = nil
    print(x!.upper())
}

var_nil()

// var_nil() is inlined into __init__, where it is warned again
// CHECK: test_const_unwrap_var_nil.kl:8:11:
// CHECK-SAME: forced unwrap ('!') of a nil value
// CHECK-NEXT: test_const_unwrap_var_nil.kl:8:11:
// CHECK-SAME: forced unwrap ('!') of a nil value
// CHECK-NEXT: --- IR Dump After isel [@__init__] ---
// CHECK-NEXT: func @__init__() <NO-TYPE> {
// CHECK-NEXT: %bb0(entry):
// CHECK-NEXT: %var_nil.x = local str?
// CHECK-NEXT: load_tag %var_nil.x str?, nil
// CHECK-NEXT: %0 = nil_check %var_nil.x str? to str        [fixedslot = 0(next)]
// CHECK-NEXT: %1 = call @str:upper [path = 'std/builtin'], nargs=1        [fixedslot = 0(next)]
// CHECK-NEXT: %2 = build_intern @tuple, nargs=1        [fixedslot = 0(next)]
// CHECK-NEXT: %3 = local str        [fixedslot = 1(next)]
// CHECK-NEXT: loadk %3 str, ' ' str
// CHECK-NEXT: %4 = local str        [fixedslot = 2(next)]
// CHECK-NEXT: loadk %4 str, '\n' str
// CHECK-NEXT: call @print [path = 'std/prelude'], nargs=3
// CHECK-NEXT: ret void
// CHECK-NEXT: }

// CHECK: func @var_nil() <NO-TYPE> {
// CHECK-NEXT: %bb0(entry):
// CHECK-NEXT: %x = local str?
// CHECK-NEXT: load_tag %x str?, nil
// CHECK-NEXT: %0 = nil_check %x str? to str        [fixedslot = 0(next)]
// CHECK-NEXT: %1 = call @str:upper [path = 'std/builtin'], nargs=1        [fixedslot = 0(next)]
// CHECK-NEXT: %2 = build_intern @tuple, nargs=1        [fixedslot = 0(next)]
// CHECK-NEXT: %3 = local str        [fixedslot = 1(next)]
// CHECK-NEXT: loadk %3 str, ' ' str
// CHECK-NEXT: %4 = local str        [fixedslot = 2(next)]
// CHECK-NEXT: loadk %4 str, '\n' str
// CHECK-NEXT: call @print [path = 'std/prelude'], nargs=3
// CHECK-NEXT: ret void
// CHECK-NEXT: }
// CHECK-EMPTY:
// CHECK-NEXT: Failure in func 'var_nil'
// CHECK-EMPTY:
// CHECK-NEXT: Traceback (most recent call last):
// CHECK-NEXT: test_const_unwrap_var_nil.kl", line 8, in var_nil
// CHECK-NEXT: print(x!.upper())
// CHECK-NEXT: test_const_unwrap_var_nil.kl", line 11, in __init__
// CHECK-NEXT: var_nil()
// CHECK-EMPTY:
// CHECK-NEXT: Error: forced unwrap (`!`) of a nil value
