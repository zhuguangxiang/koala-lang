// RUN: koala %s --dump=no-opt-ir --package-name=z | filecheck %s

class ListNode {
    let value int
    var next ListNode?

    func __init__(_value int) {
        value = _value
        next = nil
    }

    func show() {
        print(value)
    }
}

class List {
    var head ListNode?
    var total int = 0

    func __init__() {
        head = nil
    }

    func append(value int) {
        total = total + 1
        let node = ListNode(value)

        if head == nil {
            head = node
        } else {
            var it ListNode? = head
            var prev = it
            while it != nil {
                prev = it
                it = it.next
            }

            if prev != nil {
                prev.next = node
            }
        }
    }

    func append2(value int) {
        total = total + 1
        let node = ListNode(value)

        if head == nil {
            head = node
        } else {
            var curr = head
            while curr.next != nil {
                curr = curr.next!
            }
            curr.next = node
        }
    }

    func append3(value int) {
        total = total + 1
        let node = ListNode(value)

        if head == nil {
            head = node
        } else {
            var curr = head.next
            var prev = head
            while curr != nil {
                prev = curr
                curr = curr.next
            }
            prev.next = node
        }
    }

    func append4(value int) {
        total = total + 1
        let node = ListNode(value)

        if head == nil {
            head = node
        } else {
            var curr = head
            while let next = curr.next {
                curr = next
            }
            curr.next = node
        }
    }

    func add_head(value int) {
        total = total + 1
        let node = ListNode(value)
        if head != nil {
            node.next = head
        }
        head = node
    }

    func index(idx int) int? {
        var curr = head
        var i = 0
        while curr != nil {
            if i == idx {
                return curr.value
            }
            curr = curr.next
            i += 1
        }
        return nil
    }

    func show() {
        var curr = head
        while curr != nil {
            curr.show()
            curr = curr.next
        }
    }

}

func main() {
    let l = List()
    for i in range(0, 10) {
        l.append4(i)
    }
    l.show()
    print("Total: ", l.total)
    print("Index 5: ", l.index(5))
    print("Index 20: ", l.index(20))
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @List:append4(%self z.List, %value int64)

// CHECK-LABEL: %bb4(while-cond):
// CHECK: %next = local z.ListNode
// CHECK: %8 = get_field %curr z.ListNode, next(index=1)
// CHECK: move %next z.ListNode, %8 z.ListNode?
// CHECK: %9 = cmpne %8 z.ListNode?, none
// CHECK: branch %9 bool, label %bb5, label %bb6

// CHECK-LABEL: %bb5(while-body):
// CHECK: move %curr z.ListNode, %next z.ListNode
// CHECK: %10 = get_field %curr z.ListNode, next(index=1)
// CHECK: move %next z.ListNode, %10 z.ListNode?
// CHECK: %11 = cmpne %10 z.ListNode?, none
// CHECK: branch %11 bool, label %bb5, label %bb6

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @List:index(%self z.List, %idx int64) int64?
// CHECK-LABEL: %bb3(while-end):
// CHECK: ret none
// CHECK-LABEL: %bb4(if-then):
// CHECK: %3 = cast %curr z.ListNode? to z.ListNode
// CHECK: %4 = get_field %3 z.ListNode, value(index=0)
// CHECK: ret %4 int64

// CHECK: Total:  10
// CHECK: Index 5:  5
// CHECK: Index 20:  none
