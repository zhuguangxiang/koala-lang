// RUN: koala %s --dump=no-opt-ir | filecheck %s

class ListNode {
    let value int
    var next ListNode?

    func __init__(_value int) {
        value = _value
        next = null
    }

    func show() {
        print(value)
    }
}

class List {
    var head ListNode?
    var total int = 0

    func __init__() {
        head = null
    }

    func append(value int) {
        total = total + 1
        let node = ListNode(value)

        if head == null {
            head = node
        } else {
            var it ListNode? = head
            var prev = it
            while it != null {
                prev = it
                it = it.next
            }

            if prev != null {
                prev.next = node
            }
        }
    }

    func append2(value int) {
        total = total + 1
        let node = ListNode(value)

        if head == null {
            head = node
        } else {
            var curr = head
            while curr.next != null {
                curr = curr.next!
            }
            curr.next = node
        }
    }

    func append3(value int) {
        total = total + 1
        let node = ListNode(value)

        if head == null {
            head = node
        } else {
            var curr = head.next
            var prev = head
            while curr != null {
                prev = curr
                curr = curr.next
            }
            prev.next = node
        }
    }

    func append4(value int) {
        total = total + 1
        let node = ListNode(value)

        if head == null {
            head = node
        } else {
            var curr = head
            while let next = curr.next {
                curr = next
            }
            curr.next = node
        }
    }

    func add_head(value int) {
        total = total + 1
        let node = ListNode(value)
        if head != null {
            node.next = head
        }
        head = node
    }

    func index(idx int) int? {
        var curr = head
        var i = 0
        while curr != null {
            if i == idx {
                return curr.value
            }
            curr = curr.next
            i += 1
        }
        return null
    }

    func show() {
        var curr = head
        while curr != null {
            curr.show()
            curr = curr.next
        }
    }

}

func main() {
    let l = List()
    for i in range(0, 10) {
        l.append4(i)
    }
    l.show()
    print("Total: ", l.total)
    print("Index 5: ", l.index(5))
    print("Index 20: ", l.index(20))
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @List::append4(%self List, %value int64)

// CHECK-LABEL: %bb4(while-cond):
// CHECK: %next = local ListNode?
// CHECK: %9 = get_field %curr ListNode, next(index=1)
// CHECK: move %next ListNode?, %9 ListNode?
// CHECK: %10 = cmpne %next ListNode?, none
// CHECK: branch %10 bool, label %bb5, label %bb6

// CHECK-LABEL: %bb5(while-body):
// CHECK: move %curr ListNode, %next ListNode?
// CHECK: %11 = get_field %curr ListNode, next(index=1)
// CHECK: move %next ListNode?, %11 ListNode?
// CHECK: %12 = cmpne %next ListNode?, none
// CHECK: branch %12 bool, label %bb5, label %bb6

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @List::index(%self List, %idx int64) int64?
// CHECK-LABEL: %bb3(while-end):
// CHECK: ret none
// CHECK-LABEL: %bb4(if-then):
// CHECK: %3 = cast %curr ListNode? to ListNode
// CHECK: %4 = get_field %3 ListNode, value(index=0)
// CHECK: ret %4 int64

// CHECK: Total:  10
// CHECK: Index 5:  5
// CHECK: Index 20:  none
