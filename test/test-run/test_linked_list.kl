// RUN: koala %s --dump=no-opt-ir | filecheck %s

class ListNode {
    let value int
    var next ListNode?

    func __init__(_value int) {
        value = _value
        next = null
    }

    func show() {
        print(value)
    }
}

class List {
    var head ListNode?
    var total int = 0

    func __init__() {
        head = null
    }

    func append(value int) {
        total = total + 1
        let node = ListNode(value)

        if head == null {
            head = node
        } else {
            var it ListNode? = head
            var prev = it
            while it != null {
                prev = it
                it = it.next
            }

            if prev != null {
                prev.next = node
            }

            // var curr = head
            // while curr.next != null {
            //     curr = curr.next!
            // }
            // curr.next = node
        }
    }

    func add_head(value int) {
        total = total + 1
        let node = ListNode(value)
        if head != null {
            node.next = head
        }
        head = node
    }

    func index(idx int) int? {
        var curr = head
        var i = 0
        while curr != null {
            if i == idx {
                return curr.value
            }
            curr = curr.next
            i += 1
        }
        return null
    }

    func show() {
        var curr = head
        while curr != null {
            curr.show()
            curr = curr.next
        }
    }
}

func main() {
    let l = List()
    for i in range(0, 10) {
        l.append(i)
    }
    l.show()
    print("Total: ", l.total)
    print("Index 5: ", l.index(5))
    print("Index 20: ", l.index(20))
}


// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @List::index(%self List, %idx int64) int64?
// CHECK-LABEL: %bb3(while-end):
// CHECK: ret none
// CHECK-LABEL: %bb4(if-then):
// CHECK: %3 = cast %curr ListNode? to ListNode
// CHECK: %4 = get_field %3 ListNode, value(index=0)
// CHECK: ret %4 int64

// CHECK: Total:  10
// CHECK: Index 5:  5
// CHECK: Index 20:  none
