// RUN: mkdir -p %t.dir && koalac %S/../inputs/function_values_dep.kl --cgen --write-klc --package-name=function_values_dep -o %t.dir/function_values_dep.klc
// RUN: env KOALA_PATH=%t.dir:%S/../../libs/std/dist:%S/../../libs/koala/dist:%S/.. koalac %s --cgen --write-klc -o %t.dir/main.klc
// RUN: env KOALA_PATH=%t.dir:%S/../../libs/std/dist:%S/../../libs/koala/dist:%S/.. koala %t.dir/main.klc | filecheck %s

import "function_values_dep"

func twice(x int) int { return x * 2 }

func main() {
    let f = function_values_dep.increment
    print(f(2))
    print(function_values_dep.apply(twice, 4))
    print(function_values_dep.get_callback()(5))
    print(function_values_dep.get_increment()(9))
    print(function_values_dep.callback(6))
    function_values_dep.callback = twice
    print(function_values_dep.callback(7))
}

// CHECK: 3
// CHECK-NEXT: 8
// CHECK-NEXT: 6
// CHECK-NEXT: 10
// CHECK-NEXT: 7
// CHECK-NEXT: 14
