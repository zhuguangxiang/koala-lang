// RUN: koala %s | filecheck %s
// RUN: koalac %s --irgen --dump=no-opt-ir | filecheck %s --check-prefix=IR
// RUN: koalac %s --opt --dump=ir | filecheck %s --check-prefix=OPT

// irgen emits every '!' as lnot; const-copy-prop folds `!!x` to x and `!(a < b)`
// to `a >= b`, but not for floats: when a or b is NaN both are false.

func check_eq_1(v int?) bool { return !(v == nil) }
func check_eq_2(v int?) bool { return !!(v == nil) }
func check_eq_3(v int?) bool { return !!!(v == nil) }
func check_ne_1(a int, b int) bool { return !(a != b) }
func check_lt_1(a int, b int) bool { return !(a < b) }
func check_le_1(a int, b int) bool { return !(a <= b) }
func check_gt_1(a int, b int) bool { return !(a > b) }
func check_ge_1(a int, b int) bool { return !(a >= b) }
func check_plain_bool(flag bool) bool { return !flag }
func check_plain_bool_double(flag bool) bool { return !!flag }

func flt_lt_1(a float, b float) bool { return !(a < b) }
func flt_le_1(a float, b float) bool { return !(a <= b) }
func flt_gt_1(a float, b float) bool { return !(a > b) }
func flt_ge_1(a float, b float) bool { return !(a >= b) }
func flt_eq_1(a float, b float) bool { return !(a == b) }
func flt_lt_3(a float, b float) bool { return !!!(a < b) }

// the comparison is used twice, it must not be flipped
func shared(a int, b int) bool {
    let c = a < b
    return !c == c
}

func main() {
    print(check_eq_1(nil), check_eq_2(nil), check_eq_3(nil), check_ne_1(1, 2))
    print(check_lt_1(5, 10), check_le_1(5, 5), check_gt_1(10, 5), check_ge_1(10, 10))
    print(check_plain_bool(true), check_plain_bool_double(true))

    var nan = 0.0 / 0.0
    print(flt_lt_1(nan, 1.0), flt_le_1(1.0, nan), flt_gt_1(nan, nan), flt_ge_1(1.0, nan))
    print(flt_eq_1(nan, nan), flt_lt_3(nan, 1.0))
    print(flt_lt_1(1.0, 2.0), flt_ge_1(2.0, 1.0), flt_eq_1(1.0, 1.0))
    print(shared(1, 2), shared(2, 1))
}

// CHECK: false true false false
// CHECK-NEXT: false false false false
// CHECK-NEXT: false true
// CHECK-NEXT: true true true true
// CHECK-NEXT: true true
// CHECK-NEXT: false false false
// CHECK-NEXT: false false

