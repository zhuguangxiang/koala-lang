// RUN: koala %s ++ --dump=no-opt-ir,code | filecheck %s
//
// A duplicated key in a map literal is merged at run time: a dict is mutable,
// so a map literal is always `new @dict` + `__init__` + one `seq.set` per entry
// (never a const-pool entry) and keeps every key/value pair of the source,
// duplicates included. The runtime dict inserts them in order: the first
// occurrence keeps its position and the value of the last occurrence wins.
// Keys compare with the runtime rule in _dict_entry_eq_(): floats with `==`,
// so 0.0 and -0.0 are the same key while NaN never equals itself; tuples and
// ranges by their items.
func main() {
    let d = {1: "a", 2: "b", 1: "c"}
    print(d)

    let e = {"x": 1, "y": 2, "x": 3}
    print(e)

    let f = {1: "a", 1.5: "f", 2: "b", 1: "c"}
    print(f)

    let g = {1.5: "a", 2.5: "b", 1.5: "c"}
    print(g)

    let h = {0.0: "a", -0.0: "b"}
    print(h)

    let t = {(1, 2): "a", (3, 4): "b", (1, 2): "c"}
    print(t)

    let r = {range(0, 3, 1): "a", range(0, 5, 1): "b", range(0, 3, 1): "c"}
    print(r)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK: %0 = new @std/builtin.dict[int64, str]
// CHECK: seq.set %0 std/builtin.dict[int64, str], 1 int64, 'a' str
// CHECK: seq.set %0 std/builtin.dict[int64, str], 2 int64, 'b' str
// CHECK: seq.set %0 std/builtin.dict[int64, str], 1 int64, 'c' str
// CHECK: %2 = new @std/builtin.dict[str, int64]
// CHECK: seq.set %2 std/builtin.dict[str, int64], 'x' str, 1 int64
// CHECK: seq.set %2 std/builtin.dict[str, int64], 'y' str, 2 int64
// CHECK: seq.set %2 std/builtin.dict[str, int64], 'x' str, 3 int64
// CHECK: %4 = new @std/builtin.dict[any, str]
// CHECK: seq.set %4 std/builtin.dict[any, str], 1 int64, 'a' str
// CHECK: seq.set %4 std/builtin.dict[any, str], 1.500000 float64, 'f' str
// CHECK: seq.set %4 std/builtin.dict[any, str], 2 int64, 'b' str
// CHECK: seq.set %4 std/builtin.dict[any, str], 1 int64, 'c' str
// CHECK: %6 = new @std/builtin.dict[float64, str]
// CHECK: seq.set %6 std/builtin.dict[float64, str], 1.500000 float64, 'a' str
// CHECK: seq.set %6 std/builtin.dict[float64, str], 2.500000 float64, 'b' str
// CHECK: seq.set %6 std/builtin.dict[float64, str], 1.500000 float64, 'c' str
// CHECK: %8 = new @std/builtin.dict[float64, str]
// CHECK: seq.set %8 std/builtin.dict[float64, str], 0.000000 float64, 'a' str
// CHECK: seq.set %8 std/builtin.dict[float64, str], -0.000000 float64, 'b' str
// CHECK: %10 = new @std/builtin.dict[std/builtin.tuple[int64, int64], str]
// CHECK: seq.set %10 std/builtin.dict[std/builtin.tuple[int64, int64], str], tuple(1, 2) std/builtin.tuple[int64, int64], 'a' str
// CHECK: seq.set %10 std/builtin.dict[std/builtin.tuple[int64, int64], str], tuple(3, 4) std/builtin.tuple[int64, int64], 'b' str
// CHECK: seq.set %10 std/builtin.dict[std/builtin.tuple[int64, int64], str], tuple(1, 2) std/builtin.tuple[int64, int64], 'c' str
// CHECK: %12 = new @std/builtin.dict[std/builtin.range, str]
// CHECK: seq.set %12 std/builtin.dict[std/builtin.range, str], range(0, 3, 1) std/builtin.range, 'a' str
// CHECK: seq.set %12 std/builtin.dict[std/builtin.range, str], range(0, 5, 1) std/builtin.range, 'b' str
// CHECK: seq.set %12 std/builtin.dict[std/builtin.range, str], range(0, 3, 1) std/builtin.range, 'c' str
// CHECK: ret void

// Seven separate dict allocations of 3, 3, 4, 3, 2, 3 and 3 entries (21 seq.set
// in total): no key is merged at compile time.
// CHECK-LABEL: @main[0,127]:
// CHECK: new r0, #0
// CHECK: new r0, #0
// CHECK: new r0, #0
// CHECK: new r0, #0
// CHECK: new r0, #0
// CHECK: new r0, #0
// CHECK: new r0, #0

// CHECK-LABEL: Constant Pool:
// CHECK-NOT: dict(
// CHECK-LABEL: Import Table:

// the runtime merges the duplicated keys
// CHECK:{1: c, 2: b}
// CHECK:{x: 3, y: 2}
// CHECK:{1: c, 1.5: f, 2: b}
// CHECK:{1.5: c, 2.5: b}
// CHECK:{0: b}
// CHECK:{(1, 2): c, (3, 4): b}
// CHECK:{range(0, 3, 1): c, range(0, 5, 1): b}