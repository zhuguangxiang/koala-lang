// RUN: koala %s ++ --dump=no-opt-ir,code | filecheck %s
//
// A duplicated key in a map literal is merged at run time: a dict is mutable,
// so a map literal is always `build_intern @map` (never a const-pool entry)
// and keeps every key/value pair of the source, duplicates included. The
// runtime dict inserts them in order: the first occurrence keeps its position
// and the value of the last occurrence wins. Keys compare with the runtime
// rule in _dict_entry_eq_(): floats with `==`, so 0.0 and -0.0 are the same
// key while NaN never equals itself; tuples and ranges by their items.
func main() {
    let d = {1: "a", 2: "b", 1: "c"}
    print(d)

    let e = {"x": 1, "y": 2, "x": 3}
    print(e)

    let f = {1: "a", 1.5: "f", 2: "b", 1: "c"}
    print(f)

    let g = {1.5: "a", 2.5: "b", 1.5: "c"}
    print(g)

    let h = {0.0: "a", -0.0: "b"}
    print(h)

    let t = {(1, 2): "a", (3, 4): "b", (1, 2): "c"}
    print(t)

    let r = {range(0, 3, 1): "a", range(0, 5, 1): "b", range(0, 3, 1): "c"}
    print(r)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK: %0 = build_intern @map, 1 int64, 'a' str, 2 int64, 'b' str, 1 int64, 'c' str
// CHECK: %2 = build_intern @map, 'x' str, 1 int64, 'y' str, 2 int64, 'x' str, 3 int64
// CHECK: %4 = build_intern @map, 1 int64, 'a' str, 1.500000 float64, 'f' str, 2 int64, 'b' str, 1 int64, 'c' str
// CHECK: %6 = build_intern @map, 1.500000 float64, 'a' str, 2.500000 float64, 'b' str, 1.500000 float64, 'c' str
// CHECK: %8 = build_intern @map, 0.000000 float64, 'a' str, -0.000000 float64, 'b' str
// CHECK: %10 = build_intern @map, tuple(1, 2) std/builtin.tuple[int64, int64], 'a' str, tuple(3, 4) std/builtin.tuple[int64, int64], 'b' str, tuple(1, 2) std/builtin.tuple[int64, int64], 'c' str
// CHECK: %12 = build_intern @map, range(0, 3, 1) std/builtin.range, 'a' str, range(0, 5, 1) std/builtin.range, 'b' str, range(0, 3, 1) std/builtin.range, 'c' str
// CHECK: ret void

// Seven build_intern of 3, 3, 4, 3, 2, 3 and 3 entries (6, 6, 8, 6, 4, 6 and
// 6 operands): no key is merged at compile time.
// CHECK-LABEL: @main[0,91]:
// CHECK: build_intern r0, @map, #6
// CHECK: build_intern r0, @map, #6
// CHECK: build_intern r0, @map, #8
// CHECK: build_intern r0, @map, #6
// CHECK: build_intern r0, @map, #4
// CHECK: build_intern r0, @map, #6
// CHECK: build_intern r0, @map, #6

// CHECK-LABEL: Constant Pool:
// CHECK-NOT: dict(
// CHECK-LABEL: Import Table:

// the runtime merges the duplicated keys
// CHECK:{1: c, 2: b}
// CHECK:{x: 3, y: 2}
// CHECK:{1: c, 1.5: f, 2: b}
// CHECK:{1.5: c, 2.5: b}
// CHECK:{0: b}
// CHECK:{(1, 2): c, (3, 4): b}
// CHECK:{range(0, 3, 1): c, range(0, 5, 1): b}