// RUN: koala %s --dump=code | filecheck %s

func to_f64(n int64) float64 {
    return float(n)
}

func main() {
    let i = 42
    print(to_f64(i))        // wrap: 42      | trap: OK (exact integer)

    print(float(7))         // wrap: 7       | trap: OK (exact integer)
    print(float(-3))        // wrap: -3      | trap: OK (exact integer)

    var u uint64 = 100
    print(float(u))         // wrap: 100     | trap: OK (exact integer)

    // int64 -> float64 -> float32 narrowing
    print(float32(float(100)))
    // wrap: 100            | trap: OK (100 fits exactly in float32)

    // same-type constructor is a no-op
    let d = 2.5
    print(float64(d))       // wrap: 2.5     | trap: OK (float64 → float64 no-op)
}

// CHECK-LABEL: ====== Linearization @to_f64(start_pc: 0, insns: 2) ======
// CHECK: int_to_float r0, r0, ti=0x13, mode=1

// CHECK: 42
// CHECK: 7
// CHECK: -3
// CHECK: 100
// CHECK: 100
// CHECK: 2.5
