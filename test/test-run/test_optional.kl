// RUN: koala %s --dump=no-opt-ir,lir,code | filecheck %s

func show(cond bool, msg str?) {
    if !cond {
        if msg == null {
            print("msg is null:", "no message")
        } else {
            print("msg:", msg)
        }
    }
}

func foo(v int?) int {
    return v!
}

func main() {
    let n int? = null
    show(false, "math is broken")
    show(false, null)
    show(true, "subtraction is broken")
    print(foo(null))
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @show(%cond bool, %msg str?)
// CHECK: %bb0(entry):
// CHECK: %0 = lnot %cond bool
// CHECK: branch %0 bool, label %bb1, label %bb2

// CHECK: %bb5(if-else):
// CHECK: %2 = cast %msg str? to str
// CHECK: %3 = build_intern @tuple, 'msg:' str, %2 str
// CHECK: call @print [path = 'std/builtin'], %3 std/builtin.tuple<uu>

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @foo(%v int64?) int64 {
// CHECK: %bb0(entry):
// CHECK: %0 = cast %v int64? to int64
// CHECK: ret %0 int64

// CHECK-LABEL: --- IR Dump After isel [@show] ---
// CHECK-LABEL: func @show(%cond bool, %msg str?)
// CHECK: %bb0(entry):
// CHECK: branch %cond bool, label %bb2, label %bb1

// CHECK-LABEL: @show[0,15]:
// CHECK: jmp_ref_ne_null r1, 6

// CHECK-LABEL: @foo[16,16]:
// CHECK: ret r0

// CHECK: msg: math is broken
// CHECK: msg is null: no message
// CHECK: none
