// CHECK: 1000
// CHECK: -1000
// CHECK: 1000
// CHECK: -1000
// CHECK: 1000
// CHECK: -1000
// int32 -> float
// CHECK: 1000
// CHECK: -1000
// CHECK: 100000
// CHECK: 100000
