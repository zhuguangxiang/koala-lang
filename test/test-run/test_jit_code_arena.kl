func all(x int) int {
    var s = 0
    s = s + f0(x)
    s = s + f1(x)
    s = s + f2(x)
    s = s + f3(x)
    s = s + f4(x)
    s = s + f5(x)
    s = s + f6(x)
    s = s + f7(x)
    s = s + f8(x)
    s = s + f9(x)
    s = s + f10(x)
    s = s + f11(x)
    s = s + f12(x)
    s = s + f13(x)
    s = s + f14(x)
    s = s + f15(x)
    s = s + f16(x)
    s = s + f17(x)
    s = s + f18(x)
    s = s + f19(x)
    s = s + f20(x)
    s = s + f21(x)
    s = s + f22(x)
    s = s + f23(x)
    s = s + f24(x)
    s = s + f25(x)
    s = s + f26(x)
    s = s + f27(x)
    s = s + f28(x)
    s = s + f29(x)
    s = s + f30(x)
    s = s + f31(x)
    s = s + f32(x)
    s = s + f33(x)
    s = s + f34(x)
    s = s + f35(x)
    s = s + f36(x)
    s = s + f37(x)
    s = s + f38(x)
    s = s + f39(x)
    return s
}

func main() {
    var t = 0
    var i = 0
    while i < 3 {
        t = t + fdiv(i + 7, 1) + all(i) + big(i)
        i = i + 1
    }
    // the first functions again, after everything else was written
    print(t, f0(7), f39(7), all(5), big(9))
    print(fdiv(1, 0))
    print("not reached")
}

