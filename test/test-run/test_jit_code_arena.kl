// RUN: koala %s ++ --no-inline 2>&1 | filecheck %s
// RUN: env KOALA_JIT=0 koala %s ++ --no-inline 2>&1 | filecheck %s
// RUN: env KOALA_JIT_THRESHOLD=1 koala %s ++ --no-inline 2>&1 | filecheck %s
// RUN: env KOALA_JIT_CODE_CHUNK=4096 KOALA_JIT_THRESHOLD=1 koala %s ++ --no-inline 2>&1 | filecheck %s
// RUN: env KOALA_JIT_STATS=1 KOALA_JIT_THRESHOLD=1 koala %s ++ --no-inline 2>&1 | filecheck %s --check-prefix=PACK
// RUN: env KOALA_JIT_STATS=1 KOALA_JIT_CODE_CHUNK=4096 KOALA_JIT_THRESHOLD=1 koala %s ++ --no-inline 2>&1 | filecheck %s --check-prefix=SPLIT
// JIT code arena (DESIGN §16): compiled functions are packed into shared
// chunks instead of one mapping each. Small functions share pages (PACK), and
// with 4KB chunks (SPLIT) the code spans many chunks, `big` needs a chunk of
// its own, and functions compiled earlier must stay executable after later
// code is written next to them.

// compiled first; its error epilogue (the end of its code) is followed
// directly by the next function's code
func fdiv(x int, y int) int {
    return x / y
}
func f0(x int) int { return x * 2 + 0 }
func f1(x int) int { return x * 3 + 1 }
func f2(x int) int { return x * 4 + 2 }
func f3(x int) int { return x * 5 + 3 }
func f4(x int) int { return x * 6 + 4 }
func f5(x int) int { return x * 7 + 5 }
func f6(x int) int { return x * 8 + 6 }
func f7(x int) int { return x * 9 + 7 }
func f8(x int) int { return x * 10 + 8 }
func f9(x int) int { return x * 11 + 9 }
func f10(x int) int { return x * 12 + 10 }
func f11(x int) int { return x * 13 + 11 }
func f12(x int) int { return x * 14 + 12 }
func f13(x int) int { return x * 15 + 13 }
func f14(x int) int { return x * 16 + 14 }
func f15(x int) int { return x * 17 + 15 }
func f16(x int) int { return x * 18 + 16 }
func f17(x int) int { return x * 19 + 17 }
func f18(x int) int { return x * 20 + 18 }
func f19(x int) int { return x * 21 + 19 }
func f20(x int) int { return x * 22 + 20 }
func f21(x int) int { return x * 23 + 21 }
func f22(x int) int { return x * 24 + 22 }
func f23(x int) int { return x * 25 + 23 }
func f24(x int) int { return x * 26 + 24 }
func f25(x int) int { return x * 27 + 25 }
func f26(x int) int { return x * 28 + 26 }
func f27(x int) int { return x * 29 + 27 }
func f28(x int) int { return x * 30 + 28 }
func f29(x int) int { return x * 31 + 29 }
func f30(x int) int { return x * 32 + 30 }
func f31(x int) int { return x * 33 + 31 }
func f32(x int) int { return x * 34 + 32 }
func f33(x int) int { return x * 35 + 33 }
func f34(x int) int { return x * 36 + 34 }
func f35(x int) int { return x * 37 + 35 }
func f36(x int) int { return x * 38 + 36 }
func f37(x int) int { return x * 39 + 37 }
func f38(x int) int { return x * 40 + 38 }
func f39(x int) int { return x * 41 + 39 }

// > 4KB of machine code: larger than a 4KB chunk
func big(n int) int {
    var s = n
    s = (s * 3 + 0) % 1000003
    s = (s * 4 + 1) % 1000003
