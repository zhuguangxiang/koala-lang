// RUN: koala %s --dump=code,no-opt-ir | filecheck %s

trait Debug {
    func show()
}

trait Flyable[T] : Debug {
    func fly() T
}

trait Walkable {
    func walk() str
}

trait WalkableFlyable[T] : Flyable[T] & Walkable & Debug {
    func walk_and_fly()
}

class Foo : Flyable[str] & Walkable & WalkableFlyable[str] {

    let debug Debug = Bar(10, 20)

    func fly() str {
        return "Flying!"
    }

    func walk() str {
        print(fly())
        debug.show()
        return "Walking!"
    }

    func show() {
        print("This is a Foo instance.")
    }

    func walk_and_fly() {
        print(walk(), fly())
    }
}

func show_debug_info(d Debug) {
    d.show()
}

class Bar : Debug {
    var x int
    var y int

    func __init__(_x int, _y int) {
        x = _x
        y = _y
    }

    func show() {
        print(x, y)
    }
}

func new_foo() Foo {
    return Foo()
}

func new_debug() Debug {
    return Bar(3, 4)
}

func main() {
    var bar = Bar(1, 2)
    bar.show()

    var foo = Foo()
    foo.show()

    let s Debug = bar
    s.show()

    let f Walkable = foo
    print(f.walk())

    show_debug_info(s)
    show_debug_info(foo)

    var f2 Flyable[str] = Foo()
    print(f2.fly())
    f2.show()

    var d Debug = new_foo()
    d.show()

    d = new_debug()
    d.show()

    let d2 Debug = f2
    d2.show()

    let l = [1, 2, 3]
    let a any = l
    print(a)

    let a2 any = foo
    print(a2)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()

// CHECK: %a2 = local [immutable] any
// CHECK: move %a2 any, %foo Foo

// CHECK-LABEL: @main[17,98]:

// CHECK: make_intf r0, r0, #1
// CHECK: upcast_intf r4, r1, #1

// CHECK: 1 2
// CHECK: This is a Foo instance.
// CHECK: 1 2
// CHECK: Flying!
// CHECK: 10 20
// CHECK: Walking!
// CHECK: 1 2
// CHECK: This is a Foo instance.
// CHECK: Flying!
// CHECK: This is a Foo instance.
// CHECK: This is a Foo instance.
// CHECK: 3 4
// CHECK: This is a Foo instance.
// CHECK: [1, 2, 3]

