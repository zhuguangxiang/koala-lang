// RUN: koala %s --dump=no-opt-ir | filecheck %s

class Foo {}

func foo(x int) int {
    return x
}

func main() {
    let x = foo(1)
    let l = list[int](1,2,3,x)
    let l2 = list[int](1,2,3)
    let l3 = list(4,5,6)

    print(l[3], l2[2], l3[1])
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main() <NO-TYPE> {
// CHECK-LABEL: %bb0(entry):
// CHECK: %0 = call @foo [const], 1 int64
// CHECK: %x = local [immutable] int64
// CHECK: move %x int64, %0 int64
// CHECK: %1 = build_intern @list, 1 int64, 2 int64, 3 int64, %x int64
// CHECK: %l = local [immutable] list<j>
// CHECK: move %l list<j>, %1 list<j>
// CHECK: %l2 = local [immutable] list<j>
// CHECK: move %l2 list<j>, list[1, 2, 3] list<j>
// CHECK: %l3 = local [immutable] list<j>
// CHECK: move %l3 list<j>, list[4, 5, 6] list

// CHECK: %2 = seq_get %l list<j>, 3 int64
// CHECK: %3 = seq_get %l2 list<j>, 2 int64
// CHECK: %4 = seq_get %l3 list<j>, 1 int64

// CHECK: 1 3 5
