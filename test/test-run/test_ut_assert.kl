// RUN: koala %s --test | filecheck %s

import "std/ut"

@test
func test_bool_assertions() {
    ut.assert(true)
    ut.assert_true(10 > 5)
    ut.assert_false(5 > 10)
    print("bool assertions passed")
}

@test
func test_eq_ne_assertions() {
    ut.assert_eq(10, 10)
    ut.assert_ne(10, 20)
    print("eq/ne assertions passed")
}

@test
func test_order_assertions() {
    ut.assert_lt(5, 10)
    ut.assert_le(5, 5)
    ut.assert_gt(10, 5)
    ut.assert_ge(10, 10)
    print("order assertions passed")
}

@test
func test_close_assertion() {
    ut.assert_close(0.1 + 0.2, 0.3, 1e-6)
    print("close assertion passed")
}

// CHECK: bool assertions passed
// CHECK: eq/ne assertions passed
// CHECK: order assertions passed
// CHECK: close assertion passed
