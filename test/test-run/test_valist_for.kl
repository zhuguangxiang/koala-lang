// RUN: koala %s ex2.toml | filecheck %s

func hello(a int, args ...) {
    for v in args {
        print(v)
    }
}

import "std/sys"

func main() {
	hello(1,2,"hello", true)
	print([1,2,3].len())

	let lst = sys.args()
	print(lst, lst[1], lst.len())
}

// CHECK: 2
// CHECK: hello
// CHECK: true
// CHECK: 3
// CHECK: [{{.*}}test_valist_for.kl, ex2.toml] ex2.toml 2
