// RUN: koala %s ++ --dump=no-opt-ir | filecheck %s
// The first access to a field of a class from another package is a store. The IR value of an
// external field is created lazily; only the load path created it, so the store path asserted in
// emit_ir_dot. No field below is loaded before it is stored.

import "test_pkg/pkg_field" as pkg

func main() {
    let r = pkg.Rec()
    r.b = "changed"
    r.a = 42
    r.show()
    print(r.a, r.b)

    let c = pkg.Cell[int](5)
    c.value = 9
    c.show()
    print(c.value)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK: set_field %r test_pkg/pkg_field.Rec, b(index=3), 'changed' str
// CHECK: set_field %r test_pkg/pkg_field.Rec, a(index=1), 42 int64
// CHECK: get_field %r test_pkg/pkg_field.Rec, a(index=1)
// CHECK: get_field %r test_pkg/pkg_field.Rec, b(index=3)
// CHECK: set_field %c test_pkg/pkg_field.Cell[int64], value(index=1), 9 int64
// CHECK: get_field %c test_pkg/pkg_field.Cell[int64], value(index=1)

// CHECK: hidden: 100 a: 42 hidden2: secret b: changed
// CHECK-NEXT: 42 changed
// CHECK-NEXT: count: 7 value: 9
// CHECK-NEXT: 9
