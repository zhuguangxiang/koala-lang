// test Printable
// func intf_str[T : Printable](a T) str {
//     return a.__str__()
// }

func main() {
    print(intf_eq(true, true))
    print(intf_eq(true, false))
    print(intf_ne(true, false))
    print(intf_ne(false, false))

    // TODO: how to make_intf or upcast_intf etc.
