// RUN: koala %s | filecheck %s

// test Equatable
func intf_eq[T : Equatable](a T, b T) bool {
    return a == b
}

// test Equatable
func intf_ne[T : Equatable](a T, b T) bool {
    return a != b
}

// test Hashable
// func intf_hash[T : Hashable](a T, b T) bool {
//     return a.__hash__() == b.__hash__()
