// RUN: koala --test %s | filecheck %s
// Runtime @mock capability. A stub must replace the target everywhere it is
// dispatched, not only at the test module's own import site:
//   - a directly imported function (os.getenv)               -> "local" mock
//   - free->free chain inside an external package            -> checkout/add_fee
//   - method->method chain                                   -> Cart.total/subtotal
//   - free function -> method                                -> cart_subtotal
//   - a directly imported method                             -> Cart.subtotal
//   - trait (itable) dispatch -> method                      -> Pricer.price/quote
// The real callees return x + 1; every int stub returns 100. pkg_shop is built
// with --no-inline so the internal chains stay real, mockable calls.

import "std/ut"
import "std/os"
import "test_pkg/pkg_shop"

@mock("os.getenv")
func getenv_stub(key str) str? {
    if key == "MOCK_KEY" { return "mocked" }
    return nil
}

@mock("pkg_shop.add_fee")
func add_fee_stub(x int) int { return 100 }

@mock("pkg_shop.Cart.subtotal")
func subtotal_stub(c pkg_shop.Cart, x int) int { return 100 }

@test
func test_mock_local_import() {
    let v = os.getenv("MOCK_KEY")
    if v != nil {
        ut.assert_eq(v, "mocked")
    } else {
        ut.assert(false, "stub should return non-nil")
    }
    ut.assert(os.getenv("OTHER") == nil)
}

@test
func test_mock_free_func_chain() {
    // checkout -> add_fee (stub), both inside pkg_shop
    ut.assert_eq(pkg_shop.checkout(1), 100)
}

@test
func test_mock_method_chain() {
    let cart = pkg_shop.Cart()
    // total -> subtotal (stub)
    ut.assert_eq(cart.total(1), 100)
}

@test
func test_mock_free_to_method() {
    let cart = pkg_shop.Cart()
    ut.assert_eq(pkg_shop.cart_subtotal(cart, 1), 100)
}

@test
func test_mock_method_import() {
    let cart = pkg_shop.Cart()
    ut.assert_eq(cart.subtotal(1), 100)
}

@test
func test_mock_interface_dispatch() {
    let cart = pkg_shop.Cart()
    let p pkg_shop.Pricer = cart
    // itable -> Cart.price -> subtotal (stub)
    ut.assert_eq(p.price(1), 100)
    ut.assert_eq(pkg_shop.quote(cart, 1), 100)
}

// CHECK: 6 passed, 0 failed
// CHECK: All tests passed.