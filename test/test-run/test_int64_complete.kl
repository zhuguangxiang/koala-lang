// RUN: koala %s | filecheck %s

// test __add__
func add(a int64, b int64) int64 {
    return a + b
}

// test __sub__
func sub(a int64, b int64) int64 {
    return a - b
}

// test __mul__
func mul(a int64, b int64) int64 {
    return a * b
}

// test __div__
func div(a int64, b int64) int64 {
    return a / b
}

// test __mod__
func mod(a int64, b int64) int64 {
    return a % b
}

// test __neg__
// func neg(a int64) int64 {
//     return -a
// }

// test __shl__
func lsh(a int64, b int64) int64 {
    return a << b
}

// test __shr__
func rsh(a int64, b int64) int64 {
    return a >> b
}

// test __bitand__
func bitand(a int64, b int64) int64 {
    return a & b
}

// test __bitor__
func bitor(a int64, b int64) int64 {
    return a | b
}

// test __bitxor__
func bitxor(a int64, b int64) int64 {
    return a ^ b
}

// test __bitnot__
// func bitnot(a int64) int64 {
//     return ~a
// }

// test __gt__
func gt(a int64, b int64) bool {
    return a > b
}

// test __ge__
func ge(a int64, b int64) bool {
    return a >= b
}

// test __lt__
func lt(a int64, b int64) bool {
    return a < b
}

// test __le__
func le(a int64, b int64) bool {
    return a <= b
}

// test __eq__
func eq(a int64, b int64) bool {
    return a == b
}

// test __ne__
func ne(a int64, b int64) bool {
    return a != b
}

// test __iadd__ __isub__ __imul__ __idiv__ __imod__
// test __ishl__ __ishr__ __ibitand__ __ibitor__ __ibitxor__
func inplace() int64 {
    var v int64 = 10
    v += 5
    v -= 3
    v *= 2
    v /= 4
    v %= 5
    // v <<= 3
    // v >>= 1
    // v &= 6
    // v |= 1
    // v ^= 3
    return v
}

func main() {
    print(add(3, 5))
    print(add(3, -5))
    print(add(7, 8))

    print(sub(5, 3))
    print(sub(3, 11))
    print(sub(-2, -7))

    print(mul(3, 5))
    print(mul(3, -5))

    print(div(7, 2))
    print(div(-7, 2))
    print(div(7, -2))

    print(mod(7, 3))
    print(mod(-7, 3))

    // print(neg(5))
    // print(neg(-5))

    print(lsh(3, 2))
    print(rsh(16, 2))
    print(rsh(-16, 2))

    print(bitand(12, 10))
    print(bitor(12, 10))
    print(bitxor(12, 10))
    // print(bitnot(0))
    // print(bitnot(5))

    print(gt(5, 3))
    print(gt(3, 5))
    print(ge(5, 5))
    print(ge(4, 5))
    print(lt(3, 5))
    print(lt(5, 3))
    print(le(5, 5))
    print(le(6, 5))
    print(eq(5, 5))
    print(eq(5, 6))
    print(ne(5, 6))
    print(ne(5, 5))

    print(inplace())

    // print(int64(42))
    // print(int64(uint64(9)))
    // print(int64("255"))
    // print(int64("ff", base=16))
    // print(int64("101", base=2))
    // print(int64(7.9))

    // print((3).pow(4))
    // print((2).pow(0))
    // print((-5).abs())
    // print((5).abs())
    // print((5).to_float())
    // print((-5).to_float())
    // print((3).min(7))
    // print((3).max(7))

    print(hash(5) == hash(5))
    print(hash(4) == hash(5))
    print(str(5))
    print(str(-5))
}

