// RUN: koala %s | filecheck %s

func sum(n int, acc int) int {
    if n == 0 { return acc }
    return sum(n - 1, acc + n)
}

print(sum(100, 0))

func ack(m int, n int) int {
    if m == 0 { return n + 1 }

    if n == 0 { return ack(m - 1, 1) }

    return ack(m - 1, ack(m, n - 1))
}

print(ack(2, 10))

// CHECK: 5050
// CHECK: 23
