// RUN: koala %s ++ --dump=no-opt-ir | filecheck %s

// 'T?' with 'T' bound to an optional type is not nested, 'T? (T = int?)' is 'int?'

class Box[T] {
    var v T
    var o T?
    func __init__(v T) { self.v = v; self.o = nil }
    func get() T { return self.v }
    func get_o() T? { return self.o }
    func set_o(v T) { self.o = v }
}

func or_nil[T](x T, flag bool) T? {
    if flag { return x }
    return nil
}

class Foo {
    var n int
    func __init__(n int) { self.n = n }
}

// 'T' bound to a non-interned optional, the result type of 'as'
func run_as() {
    var a any = Foo(4)
    var b = Box(a as Foo)
    print(b.get()!.n)
    print(or_nil(a as Foo, true)!.n)
    var c = Box(a as str)
    print(c.get() ?? "nil")
}

func run() {
    var i = Box[int?](nil)
    print(i.get_o() ?? 8)
    print(i.get() ?? 9)
    i.set_o(5)
    print(i.get_o() ?? 8)

    var j = Box[int?](3)
    print(j.get_o() ?? 7)
    j.set_o(nil)
    print(j.get_o())

    var s = Box[str?]("a")
    s.set_o("b")
    print(s.get_o() ?? "c")

    let n int? = 6
    print(or_nil[int?](n, true) ?? 0)
    print(or_nil[int?](n, false) ?? 0)
}

run()
run_as()

// CHECK: --- IR Dump After ir-gen(no-opt) ---
// CHECK: func @Box:get_o(%self test_generic_nested_optional.Box[Box:T]) Box:T? {
// CHECK-NEXT: %bb0(entry):
// CHECK-NEXT: %0 = get_field %self test_generic_nested_optional.Box[Box:T], o(index=1)
// CHECK-NEXT: ret %0 Box:T?
// CHECK-NEXT: }

// CHECK: func @run_as() <NO-TYPE> {
// CHECK-NEXT: %bb0(entry):
// CHECK-NEXT: %0 = new @test_generic_nested_optional.Foo
// CHECK-NEXT: call @Foo:__init__, %0 test_generic_nested_optional.Foo, 4 int64
// CHECK-NEXT: %a = local any
// CHECK-NEXT: move %a any, %0 test_generic_nested_optional.Foo
// CHECK-NEXT: %1 = as %a any, test_generic_nested_optional.Foo
// CHECK-NEXT: %2 = new @test_generic_nested_optional.Box[test_generic_nested_optional.Foo?]
// CHECK-NEXT: call @Box:__init__, %2 test_generic_nested_optional.Box[test_generic_nested_optional.Foo?], %1 test_generic_nested_optional.Foo?
// CHECK-NEXT: %b = local test_generic_nested_optional.Box[test_generic_nested_optional.Foo?]
// CHECK-NEXT: move %b test_generic_nested_optional.Box[test_generic_nested_optional.Foo?], %2 test_generic_nested_optional.Box[test_generic_nested_optional.Foo?]
// CHECK-NEXT: %3 = call @Box:get, %b test_generic_nested_optional.Box[test_generic_nested_optional.Foo?]
// CHECK-NEXT: %4 = cast %3 test_generic_nested_optional.Foo? to test_generic_nested_optional.Foo
// CHECK-NEXT: %5 = get_field %4 test_generic_nested_optional.Foo, n(index=0)
// CHECK-NEXT: %6 = build_intern @tuple, %5 int64
// CHECK-NEXT: call @print [path = 'std/prelude'], %6 std/builtin.tuple[int64], ' ' str, '\n' str
// CHECK-NEXT: %7 = as %a any, test_generic_nested_optional.Foo
// CHECK-NEXT: %8 = call @or_nil, %7 test_generic_nested_optional.Foo?, true bool
// CHECK-NEXT: %9 = cast %8 test_generic_nested_optional.Foo? to test_generic_nested_optional.Foo
// CHECK-NEXT: %10 = get_field %9 test_generic_nested_optional.Foo, n(index=0)
// CHECK-NEXT: %11 = build_intern @tuple, %10 int64
// CHECK-NEXT: call @print [path = 'std/prelude'], %11 std/builtin.tuple[int64], ' ' str, '\n' str
// CHECK-NEXT: %12 = as %a any, str
// CHECK-NEXT: %13 = new @test_generic_nested_optional.Box[str?]
// CHECK-NEXT: call @Box:__init__, %13 test_generic_nested_optional.Box[str?], %12 str?
// CHECK-NEXT: %c = local test_generic_nested_optional.Box[str?]
// CHECK-NEXT: move %c test_generic_nested_optional.Box[str?], %13 test_generic_nested_optional.Box[str?]
// CHECK-NEXT: %14 = call @Box:get, %c test_generic_nested_optional.Box[str?]
// CHECK-NEXT: %coalesce = local str
// CHECK-NEXT: %15 = cmpne %14 str?, nil
// CHECK-NEXT: branch %15 bool, label %bb1, label %bb2
// CHECK-EMPTY:
// CHECK-NEXT: %bb1(coalesce-unwrap):                          ;; preds = %bb0
// CHECK-NEXT: %16 = cast %14 str? to str
// CHECK-NEXT: move %coalesce str, %16 str
// CHECK-NEXT: jmp label %bb3
// CHECK-EMPTY:
// CHECK-NEXT: %bb2(coalesce-rhs):                             ;; preds = %bb0
// CHECK-NEXT: move %coalesce str, 'nil' str
// CHECK-NEXT: jmp label %bb3
// CHECK-EMPTY:
// CHECK-NEXT: %bb3(coalesce-end):                             ;; preds = %bb1, %bb2
// CHECK-NEXT: %17 = build_intern @tuple, %coalesce str
// CHECK-NEXT: call @print [path = 'std/prelude'], %17 std/builtin.tuple[str], ' ' str, '\n' str
// CHECK-NEXT: ret void
// CHECK-NEXT: }

