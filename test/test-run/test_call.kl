// RUN: koala --dump=no-opt-ir,lir %s | filecheck %s

func hello(name str) str {
    return name
}

func world(name str) str {
    return name
}

func foo(n int) {
    var i = 0
    var x = 5 + n
    while i < n {
        print(x)
        i = i + 1
    }
}

func main() {
    let s = "zhangsan"
    let s2 = "wangwu"
    print(hello(s), world(s2))
    foo(3)
}

// CHECK-LABEL: --- IR Dump After isel [@main] ---
// CHECK-LABEL: func @main()
// hello() and world() are inlined, their args are placed directly into the tuple slots
// CHECK: %0 = local str        [fixedslot = 0(next)]
// CHECK-NEXT: loadk %0 str, 'zhangsan' str
// CHECK-NEXT: %1 = local str        [fixedslot = 1(next)]
// CHECK-NEXT: loadk %1 str, 'wangwu' str
// CHECK-NEXT: %2 = build_intern @tuple, nargs=2        [fixedslot = 0(next)]
// CHECK-NEXT: %3 = local str        [fixedslot = 1(next)]
// CHECK-NEXT: loadk %3 str, ' ' str
// CHECK-NEXT: %4 = local str        [fixedslot = 2(next)]
// CHECK-NEXT: loadk %4 str, '\n' str
// CHECK-NEXT: call @print [path = 'std/prelude'], nargs=3
// CHECK-NOT: call @hello
// CHECK-NOT: call @world
// CHECK: call @foo [const], nargs=1
// CHECK: ret void

// CHECK: zhangsan wangwu
// CHECK: 8
// CHECK: 8
// CHECK: 8
