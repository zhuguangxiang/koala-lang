// RUN: koala %s --dump=no-opt-ir --package-name=z | filecheck %s

import "test_pkg/pkg1" as zz

class ListNode[T] {
    let value T
    var next ListNode[T]?

    func __init__(_value T) {
        value = _value
        next = null
    }

    func show() {
        print(value)
    }
}

class List[T] {
    var head ListNode[T]?
    var total int = 0

    func __init__() {
        head = null
    }

    func append(value T) {
        total = total + 1
        let node = ListNode(value)

        if head == null {
            head = node
        } else {
            var it ListNode[T]? = head
            var prev = it
            while it != null {
                prev = it
                it = it.next
            }

            if prev != null {
                prev.next = node
            }
        }
    }

    func append2(value T) {
        total = total + 1
        let node = ListNode(value)

        if head == null {
            head = node
        } else {
            var curr = head
            while curr.next != null {
                curr = curr.next!
            }
            curr.next = node
        }
    }

    func append3(value T) {
        total = total + 1
        let node = ListNode(value)

        if head == null {
            head = node
        } else {
            var curr = head.next
            var prev = head
            while curr != null {
                prev = curr
                curr = curr.next
            }
            prev.next = node
        }
    }

    func append4(value T) {
        total = total + 1
        let node = ListNode(value)

        if head == null {
            head = node
        } else {
            var curr = head
            while let next = curr.next {
                curr = next
            }
            curr.next = node
        }
    }

    func add_head(value T) {
        total = total + 1
        let node = ListNode(value)
        if head != null {
            node.next = head
        }
        head = node
    }

    func index(idx int) T? {
        var curr = head
        var i = 0
        while curr != null {
            if i == idx {
                return curr.value
            }
            curr = curr.next
            i += 1
        }
        return null
    }

    func show() {
        var curr = head
        while curr != null {
            curr.show()
            curr = curr.next
        }
    }

}

func main() {
    let l = List[int]()
    for i in range(0, 10) {
        l.append4(i)
    }
    l.show()
    print("Total: ", l.total)
    print("Index 5: ", l.index(5))
    print("Index 20: ", l.index(20))


    let l2 = List[zz.Point]()
    for i in range(0, 10) {
        l2.append4(zz.Point(i, i))
    }
    l2.show()
    print("Total: ", l2.total)
    print("Index 5: ", l2.index(5))
    print("Index 20: ", l2.index(20))
}

// CHECK: Total:  10
// CHECK: Index 5:  5
// CHECK: Index 20:  none

// CHECK: Total:  10
// CHECK: Index 5:  <Point object at 0x{{[0-9a-f]+}}>
// CHECK: Index 20:  none
