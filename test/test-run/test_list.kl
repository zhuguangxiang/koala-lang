// RUN: koala %s --dump=no-opt-ir,code | filecheck %s

func new_list(x int) list[int] {
    let l = [100, 200]
    l.append(x)
    return l
}

func main() {
    let l0 = []
    print(l0)

    let l = [1, 2, 3]
    print("length of l:", l.__len__())
    l.append(4)
    print(l)
    // print("length of l:", len(l))
    print("length of l:", l.__len__())

    let t = (1, 2, null)
    print(t)

    let l2 = new_list(300)
    print(l2)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK: %l0 = local [immutable] list<o>
// CHECK: move %l0 list<o>, list[] list<o>
// CHECK: %0 = build_intern @tuple, %l0 list<o>
// CHECK: call @print [path = 'std/builtin'], %0 tuple<Llist<o>;>, ' ' str, '\n' str
// CHECK: %l = local [immutable] list<j>
// CHECK: move %l list<j>, list[1, 2, 3] list<j>
// CHECK: %1 = call @list::__len__ [path = 'std/builtin'], %l list<j>
// CHECK: %2 = build_intern @tuple, 'length of l:' str, %1 int64
// CHECK: call @print [path = 'std/builtin'], %2 tuple<uj>, ' ' str, '\n' str
// CHECK: call @list::append [path = 'std/builtin'], %l list<j>, 4 int64
// CHECK: %3 = build_intern @tuple, %l list<j>
// CHECK: call @print [path = 'std/builtin'], %3 tuple<Llist<j>;>, ' ' str, '\n' str
// CHECK: %4 = call @list::__len__ [path = 'std/builtin'], %l list<j>
// CHECK: %5 = build_intern @tuple, 'length of l:' str, %4 int64
// CHECK: call @print [path = 'std/builtin'], %5 tuple<uj>, ' ' str, '\n' str
// CHECK: %t = local [immutable] tuple<jj_?>
// CHECK: move %t tuple<jj_?>, tuple(1, 2, none) tuple<jj_?>
// CHECK: %6 = build_intern @tuple, %t tuple<jj_?>
// CHECK: call @print [path = 'std/builtin'], %6 tuple<Ltuple<jj_?>;>, ' ' str, '\n' str
// CHECK: ret void

