// RUN: koala %s ++ --dump=no-opt-ir,code | filecheck %s

func new_list(x int) list[int] {
    let l = [100, 200]
    l.append(x)
    return l
}

func main() {
    let l0 = []
    print(l0)

    let l = [1, 2, 3]
    print("length of l:", l.len())
    l.append(4)
    print(l)
    print("length of l:", l.len())

    let t = (1, 2, nil)
    print(t)

    let l2 = new_list(300)
    print(l2)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK: %bb0(entry):
// CHECK: %0 = build_intern @list
// CHECK: %l0 = local [immutable] std/builtin.list[any]
// CHECK: move %l0 std/builtin.list[any], %0 std/builtin.list[any]
// CHECK: %1 = build_intern @tuple, %l0 std/builtin.list[any]
// CHECK: call @print [path = 'std/prelude'], %1 std/builtin.tuple[std/builtin.list[any]], ' ' str, '\n' str
// CHECK: %2 = build_intern @list, 1 int64, 2 int64, 3 int64
// CHECK: %l = local [immutable] std/builtin.list[int64]
// CHECK: move %l std/builtin.list[int64], %2 std/builtin.list[int64]
// CHECK: %3 = call @list:len [path = 'std/builtin'], %l std/builtin.list[int64]
// CHECK: %4 = build_intern @tuple, 'length of l:' str, %3 int64
// CHECK: call @print [path = 'std/prelude'], %4 std/builtin.tuple[str, int64], ' ' str, '\n' str
// CHECK: call @list:append [path = 'std/builtin'], %l std/builtin.list[int64], 4 int64
// CHECK: %5 = build_intern @tuple, %l std/builtin.list[int64]
// CHECK: call @print [path = 'std/prelude'], %5 std/builtin.tuple[std/builtin.list[int64]], ' ' str, '\n' str
// CHECK: %6 = call @list:len [path = 'std/builtin'], %l std/builtin.list[int64]
// CHECK: %7 = build_intern @tuple, 'length of l:' str, %6 int64
// CHECK: call @print [path = 'std/prelude'], %7 std/builtin.tuple[str, int64], ' ' str, '\n' str
// CHECK: %t = local [immutable] std/builtin.tuple[int64, int64, _?]
// CHECK: move %t std/builtin.tuple[int64, int64, _?], tuple(1, 2, nil) std/builtin.tuple[int64, int64, _?]
// CHECK: %8 = build_intern @tuple, %t std/builtin.tuple[int64, int64, _?]
// CHECK: call @print [path = 'std/prelude'], %8 std/builtin.tuple[std/builtin.tuple[int64, int64, _?]], ' ' str, '\n' str
// CHECK: %9 = call @new_list [const], 300 int64
// CHECK: %l2 = local [immutable] std/builtin.list[int64]
// CHECK: move %l2 std/builtin.list[int64], %9 std/builtin.list[int64]
// CHECK: %10 = build_intern @tuple, %l2 std/builtin.list[int64]
// CHECK: call @print [path = 'std/prelude'], %10 std/builtin.tuple[std/builtin.list[int64]], ' ' str, '\n' str
// CHECK: ret void

// CHECK-LABEL: @main[9,64]:
// CHECK: build_intern r0, @list, #0
// CHECK: move r2, r0
// CHECK: build_intern r2, @tuple, #1
// CHECK: loadk r3, #0
// CHECK: loadk r4, #1
// CHECK: call flg=0, #3
// CHECK: data (func_index=3(imported))
// CHECK: load_int_imm r2, ti=0xb, #1
// CHECK: load_int_imm r3, ti=0xb, #2
// CHECK: load_int_imm r4, ti=0xb, #3
// CHECK: build_intern r0, @list, #3
// CHECK: move r1, r0
// CHECK: move r2, r1
// CHECK: call flg=0, r3, #1
// CHECK: data (func_index=4(imported))
// CHECK: loadk r2, #2
// CHECK: build_intern r2, @tuple, #2
// CHECK: loadk r3, #0
// CHECK: loadk r4, #1
// CHECK: call flg=0, #3
// CHECK: data (func_index=3(imported))
// CHECK: move r2, r1
// CHECK: load_int_imm r3, ti=0xb, #4
// CHECK: call flg=0, #2
// CHECK: data (func_index=2(imported))
// CHECK: move r2, r1
// CHECK: build_intern r2, @tuple, #1
// CHECK: loadk r3, #0
// CHECK: loadk r4, #1
// CHECK: call flg=0, #3
// CHECK: data (func_index=3(imported))
// CHECK: move r2, r1
// CHECK: call flg=0, r3, #1
// CHECK: data (func_index=4(imported))
// CHECK: loadk r2, #2
// CHECK: build_intern r2, @tuple, #2
// CHECK: loadk r3, #0
// CHECK: loadk r4, #1
// CHECK: call flg=0, #3
// CHECK: data (func_index=3(imported))
// CHECK: loadk r2, #6
// CHECK: build_intern r2, @tuple, #1
// CHECK: loadk r3, #0
// CHECK: loadk r4, #1
// CHECK: call flg=0, #3
// CHECK: data (func_index=3(imported))
// CHECK: load_int_imm r2, ti=0xb, #300
// CHECK: call flg=0, r0, #1
// CHECK: data (func_index=0(local))
// CHECK: move r2, r0
// CHECK: build_intern r2, @tuple, #1
// CHECK: loadk r3, #0
// CHECK: loadk r4, #1
// CHECK: call flg=0, #3
// CHECK: data (func_index=3(imported))
// CHECK: ret_void

// CHECK-LABEL: Constant Pool:
// CHECK: [000] str     = " "
// CHECK: [001] str     = "\n"
// CHECK: [002] str     = "length of l:"
// CHECK: [003] int64   = 1
// CHECK: [004] int64   = 2
// CHECK: [005] nil
// CHECK: [006] tuple(3):
// CHECK:     [0] int64   = 1
// CHECK:     [1] int64   = 2
// CHECK:     [2] nil

// CHECK-LABEL: Import Table:
// CHECK: [000] method std/builtin::list::append, slot_index: 2
// CHECK: [001] func   std/prelude::print, slot_index: 3
// CHECK: [002] method std/builtin::list::len, slot_index: 4

// CHECK:[]
// CHECK:length of l: 3
// CHECK:[1, 2, 3, 4]
// CHECK:length of l: 4
// CHECK:(1, 2, nil)
// CHECK:[100, 200, 300]
