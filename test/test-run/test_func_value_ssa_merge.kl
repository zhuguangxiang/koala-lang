// RUN: koala %s | filecheck %s
// RUN: koala %s ++ --ssa | filecheck %s
//
// Function values merging across control flow. A function symbol is a
// constant-like IR value (module-level, no definition point), so an if
// expression, a loop back-edge or '??' may merge it into a phi: de-ssa copies
// it on the edge it arrives by and isel lowers the copy to load_func.
// Regression for the 'append_phi_operand' / 'ir_cast' panics on such merges.

type IntFn = func(int) int

func twice(v int) int { return v * 2 }
func other(v int) int { return v + 2 }

var maybe IntFn? = nil

// A function symbol merging with nil: SCCP must treat the symbol as BOTTOM
// (varying), not TOP, or meet(TOP, nil) folds the phi to nil.
func nil_check(c bool) bool {
    let f IntFn? = if c { twice } else { nil }
    return f == nil
}

func not_nil(c bool) int {
    let f IntFn? = if c { twice } else { nil }
    if f != nil { return 1 }
    return 0
}

func loop_nil(n int) bool {
    var f IntFn? = nil
    var i = 0
    while i < n { f = twice; i = i + 1 }
    return f == nil
}

func fallback(c bool) int {
    let f IntFn? = if c { twice } else { nil }
    let g IntFn = f ?? other
    return g(3)
}

func pick(c bool) IntFn {
    // mixed lambda / named branches, through a return
    return if c { {|x int| x + 10} } else { twice }
}

func main() {
    // lambdas as both if-expression branches
    let v1 IntFn = if true { {|x int| x + 1} } else { {|x int| x} }
    print(v1(1))

    // named functions as both branches
    let v2 IntFn = if true { twice } else { other }
    print(v2(1))

    // the same function in both branches: the phi collapses to a direct call
    let v3 IntFn = if true { twice } else { twice }
    print(v3(3))

    // a function variable reassigned in a loop: back-edge phi
    var f4 IntFn = twice
    var i = 0
    while i < 2 { f4 = other; i = i + 1 }
    print(f4(1))

    // '??' with a function rhs, named and lambda
    let v5 IntFn = maybe ?? twice
    print(v5(1))
    let v6 IntFn = maybe ?? {|x int| x * 3}
    print(v6(3))

    let v7 = pick(true)
    print(v7(3))
    let v8 = pick(false)
    print(v8(3))

    // an else-if chain
    let v9 IntFn = if false { twice } else if true { {|x| x + 10} } else { twice }
    print(v9(3))

    // a nested if expression inside a loop: phi of phis
    var f10 IntFn = twice
    var j = 0
    while j < 2 {
        f10 = if j == 0 { {|x int| x + 100} } else { twice }
        j = j + 1
    }
    print(f10(3))

    // merged function values stored into a list, then called
    let fns list[IntFn] = [v7, v8]
    print(fns[0](1))
    print(fns[1](1))

    // function / nil merges: comparisons and '??' must not fold to nil
    print(nil_check(true))
    print(nil_check(false))
    print(not_nil(true))
    print(not_nil(false))
    print(loop_nil(3))
    print(loop_nil(0))
    print(fallback(true))
    print(fallback(false))
}

// CHECK: 2
// CHECK-NEXT: 2
// CHECK-NEXT: 6
// CHECK-NEXT: 3
// CHECK-NEXT: 2
// CHECK-NEXT: 9
// CHECK-NEXT: 13
// CHECK-NEXT: 6
// CHECK-NEXT: 13
// CHECK-NEXT: 6
// CHECK-NEXT: 11
// CHECK-NEXT: 2
// CHECK-NEXT: false
// CHECK-NEXT: true
// CHECK-NEXT: 1
// CHECK-NEXT: 0
// CHECK-NEXT: false
// CHECK-NEXT: true
// CHECK-NEXT: 6
// CHECK-NEXT: 5
