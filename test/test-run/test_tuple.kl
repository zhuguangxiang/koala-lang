// CHECK: call flg=1, #1
// CHECK: data (import_index=0)
// CHECK: loadk r1, #6
// CHECK: call flg=1, r0, #1
// CHECK: data (import_index=0)
// CHECK: move r2, r0
// CHECK: loadk r1, #6
// CHECK: build_intern r1, @tuple, #2
// CHECK: loadk r2, #7
// CHECK: loadk r3, #8
