// RUN: koala %s ++ --dump=no-opt-ir,code | filecheck %s

func foo(x int, y int, z (int, int)) (int, int, int, int, (int, int)) {
    return (x, y, x + y, x - y, (x * y, x / y))
}

func main() {

    let t = (1,2,3)
    let l = t.to_list()

    let t1 = (1, "a", true)
    let l1 = t1.to_list()
    print(t1, l1)

    let t2 = foo(4, 5, (6, 7))
    print(t2)
    let t3 = (t, t2, 6)
    print(t, t2, t3)
}


// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK-LABEL: %bb0(entry):
// CHECK: %t = local [immutable] std/builtin.tuple[int64, int64, int64]
// CHECK: move %t std/builtin.tuple[int64, int64, int64], tuple(1, 2, 3) std/builtin.tuple[int64, int64, int64]
// CHECK: %0 = call @tuple:to_list [path = 'std/builtin'], %t std/builtin.tuple[int64, int64, int64]
// CHECK: %l = local [immutable] std/builtin.list[int64]
// CHECK: move %l std/builtin.list[int64], %0 std/builtin.list[int64]
// CHECK: %t1 = local [immutable] std/builtin.tuple[int64, str, bool]
// CHECK: move %t1 std/builtin.tuple[int64, str, bool], tuple(1, 'a', true) std/builtin.tuple[int64, str, bool]
// CHECK: %1 = call @tuple:to_list [path = 'std/builtin'], %t1 std/builtin.tuple[int64, str, bool]
// CHECK: %l1 = local [immutable] std/builtin.list[any]
// CHECK: move %l1 std/builtin.list[any], %1 std/builtin.list[any]
// CHECK: %2 = build_intern @tuple, %t1 std/builtin.tuple[int64, str, bool], %l1 std/builtin.list[any]
// CHECK: call @print [path = 'std/prelude'], %2 std/builtin.tuple[std/builtin.tuple[int64, str, bool], std/builtin.list[any]], ' ' str, '\n' str
// CHECK: %3 = call @foo [const], 4 int64, 5 int64, tuple(6, 7) std/builtin.tuple[int64, int64]
// CHECK: %t2 = local [immutable] std/builtin.tuple[int64, int64, int64, int64, std/builtin.tuple[int64, int64]]
// CHECK: move %t2 std/builtin.tuple[int64, int64, int64, int64, std/builtin.tuple[int64, int64]], %3 std/builtin.tuple[int64, int64, int64, int64, std/builtin.tuple[int64, int64]]
// CHECK: %4 = build_intern @tuple, %t2 std/builtin.tuple[int64, int64, int64, int64, std/builtin.tuple[int64, int64]]
// CHECK: call @print [path = 'std/prelude'], %4 std/builtin.tuple[std/builtin.tuple[int64, int64, int64, int64, std/builtin.tuple[int64, int64]]], ' ' str, '\n' str
// CHECK: %5 = build_intern @tuple, %t std/builtin.tuple[int64, int64, int64], %t2 std/builtin.tuple[int64, int64, int64, int64, std/builtin.tuple[int64, int64]], 6 int64
// CHECK: %t3 = local [immutable] std/builtin.tuple[std/builtin.tuple[int64, int64, int64], std/builtin.tuple[int64, int64, int64, int64, std/builtin.tuple[int64, int64]], int64]
// CHECK: move %t3 std/builtin.tuple[std/builtin.tuple[int64, int64, int64], std/builtin.tuple[int64, int64, int64, int64, std/builtin.tuple[int64, int64]], int64], %5 std/builtin.tuple[std/builtin.tuple[int64, int64, int64], std/builtin.tuple[int64, int64, int64, int64, std/builtin.tuple[int64, int64]], int64]

// CHECK-LABEL: @main[9,47]:
// CHECK: loadk r1, #3
// CHECK: call flg=0, #1
// CHECK: data (func_index=2(imported))
// CHECK: loadk r1, #6
// CHECK: call flg=0, r0, #1
// CHECK: data (func_index=2(imported))
// CHECK: move r2, r0
// CHECK: loadk r1, #6
// CHECK: build_intern r1, @tuple, #2
// CHECK: loadk r2, #7
// CHECK: loadk r3, #8
// CHECK: call flg=0, #3
// CHECK: data (func_index=3(imported))
// CHECK: load_int_imm r1, ti=0xb, #20
// CHECK: load_int_imm r2, ti=0xb, #0
// CHECK: build_intern r5, @tuple, #2
// CHECK: load_int_imm r1, ti=0xb, #4
// CHECK: load_int_imm r2, ti=0xb, #5
// CHECK: load_int_imm r3, ti=0xb, #9
// CHECK: load_int_imm r4, ti=0xb, #-1
// CHECK: build_intern r0, @tuple, #5

// CHECK-LABEL: Import Table:
// CHECK: [000] method std/builtin::tuple::to_list
// CHECK: [001] func   std/prelude::print

