// RUN: koala %s --dump=no-opt-ir,code | filecheck %s

func foo(x int, y int, z (int, int)) (int, int, int, int, (int, int)) {
    return (x, y, x + y, x - y, (x * y, x / y))
}

func main() {

    let t = (1,2,3)
    let l = t.to_list()

    let t1 = (1, "a", true)
    let l1 = t1.to_list()
    print(t1, l1)

    let t2 = foo(4, 5, (6, 7))
    print(t2)
    let t3 = (t, t2, 6)
    print(t, t2, t3)
}


// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK-LABEL: %bb0(entry):
// CHECK: %t = local [immutable] std/builtin.tuple<jjj>
// CHECK: move %t std/builtin.tuple<jjj>, tuple(1, 2, 3) std/builtin.tuple<jjj>
// CHECK: %0 = call @tuple::to_list [path = 'std/builtin'], %t std/builtin.tuple<jjj>
// CHECK: %l = local [immutable] std/builtin.list<j>
// CHECK: move %l std/builtin.list<j>, %0 std/builtin.list<j>
// CHECK: %t1 = local [immutable] std/builtin.tuple<juz>
// CHECK: move %t1 std/builtin.tuple<juz>, tuple(1, 'a', true) std/builtin.tuple<juz>
// CHECK: %1 = call @tuple::to_list [path = 'std/builtin'], %t1 std/builtin.tuple<juz>
// CHECK: %l1 = local [immutable] std/builtin.list<o>
// CHECK: move %l1 std/builtin.list<o>, %1 std/builtin.list<j>
// CHECK: %2 = build_intern @tuple, %t1 std/builtin.tuple<juz>, %l1 std/builtin.list<o>
// CHECK: call @print [path = 'std/builtin'], %2 std/builtin.tuple<Lstd/builtin.tuple<juz>;Lstd/builtin.list<o>;>, ' ' str, '\n' str
// CHECK: %3 = call @foo [const], 4 int64, 5 int64, tuple(6, 7) std/builtin.tuple<jj>
// CHECK: %t2 = local [immutable] std/builtin.tuple<jjjjLstd/builtin.tuple<jj>;>
// CHECK: move %t2 std/builtin.tuple<jjjjLstd/builtin.tuple<jj>;>, %3 std/builtin.tuple<jjjjLstd/builtin.tuple<jj>;>
// CHECK: %4 = build_intern @tuple, %t2 std/builtin.tuple<jjjjLstd/builtin.tuple<jj>;>
// CHECK: call @print [path = 'std/builtin'], %4 std/builtin.tuple<Lstd/builtin.tuple<jjjjLstd/builtin.tuple<jj>;>;>, ' ' str, '\n' str
// CHECK: %5 = build_intern @tuple, %t std/builtin.tuple<jjj>, %t2 std/builtin.tuple<jjjjLstd/builtin.tuple<jj>;>, 6 int64
// CHECK: %t3 = local [immutable] std/builtin.tuple<Lstd/builtin.tuple<jjj>;Lstd/builtin.tuple<jjjjLstd/builtin.tuple<jj>;>;j>
// CHECK: move %t3 std/builtin.tuple<Lstd/builtin.tuple<jjj>;Lstd/builtin.tuple<jjjjLstd/builtin.tuple<jj>;>;j>, %5 std/builtin.tuple<Lstd/builtin.tuple<jjj>;Lstd/builtin.tuple<jjjjLstd/builtin.tuple<jj>;>;j>

// CHECK-LABEL: @main[9,44]:
