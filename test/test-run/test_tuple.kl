// RUN: koala %s --dump=no-opt-ir,code | filecheck %s

func foo(x int, y int, z (int, int)) (int, int, int, int, (int, int)) {
    return (x, y, x + y, x - y, (x * y, x / y))
}

func main() {

    let t = (1,2,3)
    let l = t.to_list()

    let t1 = (1, "a", true)
    let l1 = t1.to_list()
    print(t1, l1)

    let t2 = foo(4, 5, (6, 7))
    print(t2)
    let t3 = (t, t2, 6)
    print(t, t2, t3)
}


// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK-LABEL: %bb0(entry):
// CHECK: %t = local [immutable] tuple<jjj>
// CHECK: move %t tuple<jjj>, tuple(1, 2, 3) tuple<jjj>
// CHECK: %0 = call @tuple::to_list [path = 'std/builtin'], %t tuple<jjj>
// CHECK: %l = local [immutable] list<j>
// CHECK: move %l list<j>, %0 list<j>
// CHECK: %t1 = local [immutable] tuple<juz>
// CHECK: move %t1 tuple<juz>, tuple(1, 'a', true) tuple<juz>
// CHECK: %1 = call @tuple::to_list [path = 'std/builtin'], %t1 tuple<juz>
// CHECK: %l1 = local [immutable] list<o>
// CHECK: move %l1 list<o>, %1 list<j>
// CHECK: %2 = build_intern @tuple, %t1 tuple<juz>, %l1 list<o>
// CHECK: call @print [path = 'std/builtin'], %2 tuple<Ltuple<juz>;Llist<o>;>, ' ' str, '\n' str
// CHECK: %3 = call @foo [const], 4 int64, 5 int64, tuple(6, 7) tuple<jj>
// CHECK: %t2 = local [immutable] tuple<jjjjLtuple<jj>;>
// CHECK: move %t2 tuple<jjjjLtuple<jj>;>, %3 tuple<jjjjLtuple<jj>;>
// CHECK: %4 = build_intern @tuple, %t2 tuple<jjjjLtuple<jj>;>
// CHECK: call @print [path = 'std/builtin'], %4 tuple<Ltuple<jjjjLtuple<jj>;>;>, ' ' str, '\n' str
// CHECK: %5 = build_intern @tuple, %t tuple<jjj>, %t2 tuple<jjjjLtuple<jj>;>, 6 int64
// CHECK: %t3 = local [immutable] tuple<Ltuple<jjj>;Ltuple<jjjjLtuple<jj>;>;j>
// CHECK: move %t3 tuple<Ltuple<jjj>;Ltuple<jjjjLtuple<jj>;>;j>, %5 tuple<Ltuple<jjj>;Ltuple<jjjjLtuple<jj>;>;j>
// CHECK: %6 = build_intern @tuple, %t tuple<jjj>, %t2 tuple<jjjjLtuple<jj>;>, %t3 tuple<Ltuple<jjj>;Ltuple<jjjjLtuple<jj>;>;j>
// CHECK: call @print [path = 'std/builtin'], %6 tuple<Ltuple<jjj>;Ltuple<jjjjLtuple<jj>;>;Ltuple<Ltuple<jjj>;Ltuple<jjjjLtuple<jj>;>;j>;>, ' ' str, '\n' str
// CHECK: ret void

// CHECK-LABEL: @main[9,44]:
// CHECK: loadk r1, #3
// CHECK: call flg=1, #1
// CHECK: data (import_index=0)
// CHECK: loadk r1, #6
// CHECK: call flg=1, r0, #1
// CHECK: data (import_index=0)
// CHECK: move r2, r0
// CHECK: loadk r1, #6
// CHECK: build_intern r1, @tuple, #2
// CHECK: loadk r2, #7
// CHECK: loadk r3, #8
// CHECK: call flg=1, #3
// CHECK: data (import_index=1)
// CHECK: load_int_imm r1, ti=0xb, #4
// CHECK: load_int_imm r2, ti=0xb, #5


