// RUN: koala %s | filecheck %s

class Node {
    var value int
    var left Node?
    var right Node?

    func __init__(_value int) {
        value = _value
        left = nil
        right = nil
    }
}

class Tree {
    var root Node?

    func __init__() {
        root = nil
    }

    func insert(_val int) {
        if root == nil {
            root = Node(_val)
            return
        }

        var n Node? = root
        while let x = n {
            if _val < x.value {
                if x.left == nil {
                    x.left = Node(_val)
                    return
                }
                n = x.left
            } else if (_val > x.value) {
                if x.right == nil {
                    x.right = Node(_val)
                    return
                }
                n = x.right
            } else {
                return
            }
        }
    }

    func contains(_val int) bool {
        var n = root

        while let x = n {
            if _val < x.value {
                n = x.left
            } else if _val > x.value {
                n = x.right
            } else {
                return true
            }
        }

        return false
    }

    func show() {
        let stack = list[Node]()

        if (root != nil) {
            stack.append(root)
        }

        while len(stack) > 0 {
            let x = stack.pop(0)
            print(x.value, end=' ')
            if let v = x.left {
                stack.append(v)
            }
            if let v = x.right {
                stack.append(v)
            }
        }
        print('')
    }
}

func main() {
    var tree = Tree()
    tree.insert(5)
    tree.insert(3)
    tree.insert(7)
    tree.insert(1)
    tree.insert(4)
    tree.show()
}

// CHECK: 5 3 7 1 4
