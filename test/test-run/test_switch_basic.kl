// RUN: koala %s | filecheck %s

// switch basics: int (multi-pattern, negative, default), exhaustive enum and bool (no
// default), string with default, and a const case label. The subject is evaluated once.

enum Color { RED, GREEN, BLUE }

func classify(x int) int {
    switch x {
        case 1: return 10
        case 2, 3: return 20
        case -1: return 30
        case _: return -1
    }
}

func color_name(c Color) str {
    switch c {
        case Color.RED: return "red"
        case Color.GREEN: return "green"
        case Color.BLUE: return "blue"
    }
}

func yes_no(b bool) str {
    switch b {
        case true: return "yes"
        case false: return "no"
    }
}

func str_tag(s str) int {
    switch s {
        case "a": return 1
        case "bb": return 2
        case _: return 0
    }
}

const TEN = 10
func const_tag(x int) int {
    switch x {
        case TEN: return 1
        case _: return 0
    }
}

func main() {
    print(classify(1), classify(2), classify(3), classify(-1), classify(9))
    // CHECK: 10 20 20 30 -1
    print(color_name(Color.RED), color_name(Color.GREEN), color_name(Color.BLUE))
    // CHECK: red green blue
    print(yes_no(true), yes_no(false))
    // CHECK: yes no
    print(str_tag("a"), str_tag("bb"), str_tag("zzz"))
    // CHECK: 1 2 0
    print(const_tag(10), const_tag(7))
    // CHECK: 1 0
}
