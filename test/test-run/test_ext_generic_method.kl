// RUN: koala %s | filecheck %s
// Generic methods of classes from another package. Loading the klc asserted in
// fixup_type_spec: the owner of a method's type parameter was looked up only among the
// package's top-level symbols, where the method is not, and where a function of the same
// name may be.

import "test_pkg/pkg_generic_method" as pkg

func main() {
    let b = pkg.Box()
    print(b.pass(1), b.pass("koala"))
    print(b.same(3, 3), b.same("a", "b"))
    print(b.wrap(3).len(), b.twice("k").len())
    print(pkg.Box.make(7))
    print(pkg.pass(1))

    let p = pkg.Cell[int](5).pair("x")
    print(p[0], p[1])

    // Type args written out or inferred, for methods, functions and the constructor.
    print(b.pass[int](1), b.pass[str]("s"))
    print(pkg.Box.make[int](7))
    print(b.wrap[str]("w")[0])
    print(pkg.Bag().pass(1).len(), pkg.Bag().pass[int](1).len())
    print(pkg.ident[int](3), pkg.ident("i"))
    let c = pkg.Cell(5)
    let d = pkg.Cell[int](6)
    print(c.pair[str]("x")[0], c.pair("y")[1], d.pair[str]("z")[0])
}

// CHECK: 1 koala
// CHECK-NEXT: true false
// CHECK-NEXT: 1 2
// CHECK-NEXT: 7
// CHECK-NEXT: 2
// CHECK-NEXT: 5 x
// CHECK-NEXT: 1 s
// CHECK-NEXT: 7
// CHECK-NEXT: w
// CHECK-NEXT: 1 1
// CHECK-NEXT: 3 i
// CHECK-NEXT: 5 y 6
