// RUN: koala %s | filecheck %s
// RUN: env KOALA_JIT=0 koala %s | filecheck %s
//
// bytes has two deliberately different renderings:
//
//   fmt     -- what `print` uses -- is a display form. It escapes every byte
//              and never stops early, so embedded NULs stay visible.
//   to_str  decodes the entire sequence as UTF-8, including NULs, replacing
//           invalid bytes with U+FFFD.

func main() {
    // ---------------------------------------------------------------
    // fmt: display form, all bytes, escaped
    // ---------------------------------------------------------------

    // printable bytes are shown as-is
    print(b"hello")

    // an embedded NUL is escaped, not treated as a terminator
    print(b"AB\x00CD")

    // a leading NUL survives too
    print(b"\x00\x01\x02")

    // a zero-filled buffer shows every byte it owns
    print(bytes(3))

    // quote and backslash are escaped, so the dump can be read back
    print(b"a\"b\\c")

    // newline and tab use short escapes: a dump never spans several lines
    print(b"a\nb\tc")

    // non-ASCII bytes use the uppercase \xNN convention
    print(b"\xff\xfe")

    // past 64 bytes only the head is printed and the real size is appended,
    // so a shortened value can never be mistaken for a short one
    print(bytes(65))

    // ---------------------------------------------------------------
    // to_str: decode the complete sequence, including NUL
    // ---------------------------------------------------------------

    // no NUL inside: every byte is converted
    print("s=" + b"hello".to_str())

    // Embedded, leading, and trailing NULs survive a round trip.
    print(b"AB\x00CD".to_str().to_bytes().to_hex())
    print("n=" + str(b"AB\x00CD".to_str().len()))
    print(b"\x00AB\x00".to_str().to_bytes().to_hex())
    print("n=" + str(b"\x00\x01\x02".to_str().len()))
    print("n=" + str(bytes(64).to_str().len()))

    // A view decodes only its own bytes, even with NULs and invalid UTF-8.
    print(b"xA\x00\xe4\xbd\xa0\xffZy".view(1, 8).to_str().to_bytes().to_hex())
    print(b"\xff\x00\xfe".to_str().to_bytes().to_hex())
}

// fmt: every byte, escaped, single line
// CHECK: b"hello"
// CHECK: b"AB\x00CD"
// CHECK: b"\x00\x01\x02"
// CHECK: b"\x00\x00\x00"
// CHECK: b"a\"b\\c"
// CHECK: b"a\nb\tc"
// CHECK: b"\xFF\xFE"
// CHECK: (65 bytes)

// to_str: NULs are preserved and invalid UTF-8 is replaced
// CHECK: s=hello
// CHECK-NEXT: 4142004344
// CHECK-NEXT: n=5
// CHECK-NEXT: 00414200
// CHECK-NEXT: n=3
// CHECK-NEXT: n=64
// CHECK-NEXT: 4100e4bda0efbfbd5a
// CHECK-NEXT: efbfbd00efbfbd
