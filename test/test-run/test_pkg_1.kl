// RUN: koala %s --dump=no-opt-ir | filecheck %s

import "test_pkg/pkg1_1" as zz

class Bar {
    func bar() {
        print("Bar is bar")
    }
}

class Foo : zz.Fly {
     func fly() str {
         return "Foo is flying"
     }

    func bar() Bar {
        return Bar()
    }
}

func new_foo() Foo {
    return Foo()
}

func main() {
    zz.hello()
    let foo2 = zz.Foo()
    foo2.bar()

    let bar2 = Bar()
    bar2.bar()

    let foo = new_foo()
    print(foo.fly())

    let bar = foo.bar()
    bar.bar()

    let p = zz.Point(1,2)
    p.show()

    let fly zz.Fly = foo
    print(fly.fly())
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @main()
// CHECK: call @hello [path = 'test_pkg/pkg1']
// CHECK: %0 = new @test_pkg/pkg1.Foo
// CHECK: call @Foo:__init__ [path = 'test_pkg/pkg1'], %0 test_pkg/pkg1.Foo
// CHECK: %8 = call @test_pkg/pkg1.Fly:fly [intf-index = 0], %fly test_pkg/pkg1.Fly

// CHECK: Hello from pkg1
// CHECK: bar
// CHECK: Bar is bar
// CHECK: Foo is flying
// CHECK: Bar is bar
// CHECK: Point(1, 2)
// CHECK: Foo is flying
