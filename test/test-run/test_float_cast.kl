// RUN: koala %s ++ --dump=lir | filecheck %s

func test_float(n float16) float32 {
    return float32(n + 1.5)
}

func main() {
    let a = test_float(1.0)
    print(a)

    let f float16 = 1.5
    let g float32 = float32(f)
    print(g)
}

// CHECK-LABEL: --- IR Dump After isel [@test_float] ---
// CHECK-LABEL: func @test_float(%n float16) float32
// CHECK: %0 = cast %n float16 to float64
// CHECK: %1 = local [immutable] float64
// CHECK: loadk %1 float64, 1.500000 float64
// CHECK: %2 = float.add %0 float64, %1 float64
// CHECK: %3 = float.cast %2 float64 to float32
// CHECK: ret %3 float32

// CHECK-LABEL: --- IR Dump After isel [@main] ---
// CHECK-LABEL: func @main()
// test_float(1.0) is inlined and folded to a float32 constant
// CHECK-NOT: call @test_float
// CHECK: %0 = local float32        [fixedslot = 0(next)]
// CHECK-NEXT: loadk %0 float32, 2.500000 float32
// CHECK: %4 = local float32        [fixedslot = 0(next)]
// CHECK-NEXT: loadk %4 float32, 1.500000 float32

// CHECK: 2.5
// CHECK: 1.5
