// RUN: koala %s --dump=no-opt-ir,code | filecheck %s

func foo(x list[int], out list[int]) {
    for v in x {
        out.append(v)
    }
}

func new_list() list[int] {
    return [1,2,3]
}

func main() {
    let l = [1,2,3,4]
    let out = list[int]()
    foo(l, out)

    for v in new_list() {
        out.append(v)
    }

    for v in [1,2,3] {
        out.append(v)
    }

    print(out)
}

// CHECK-LABEL: --- IR Dump After ir-gen(no-opt) ---
// CHECK-LABEL: func @foo(%x std/builtin.list<j>, %out std/builtin.list<j>)
// CHECK: %bb0(entry):
// CHECK: jmp label %bb1

// CHECK: %bb1(loop-header):                              ;; preds = %bb0
// CHECK: %seq.index = local int64
// CHECK: %0 = len %x std/builtin.list<j>
// CHECK: move %seq.index int64, 0 int64
// CHECK: jmp label %bb2

// CHECK: %bb2(loop-cond):                                ;; preds = %bb1, %bb4
// CHECK: %1 = cmpge %seq.index int64, %0 int64
// CHECK: branch %1 bool, label %bb5, label %bb3

// CHECK: %bb3(loop-body):                                ;; preds = %bb2
// CHECK: %v = local int64
// CHECK: %2 = seq.get %x std/builtin.list<j>, %seq.index int64
// CHECK: move %v int64, %2 int64
// CHECK: call @list:append [path = 'std/builtin'], %out std/builtin.list<j>, %v int64
// CHECK: jmp label %bb4

// CHECK: %bb4(loop-cond-incr):                           ;; preds = %bb3
// CHECK: %3 = add %seq.index int64, 1 int64
// CHECK: move %seq.index int64, %3 int64
// CHECK: jmp label %bb2

// CHECK: %bb5(loop-end):                                 ;; preds = %bb2
// CHECK: ret void


// CHECK-LABEL: @foo[0,10]:
// CHECK: len r3, r0
// CHECK: load_int_imm r2, ti=0xb, #0
// CHECK: jmp_int_lt r2, r3, 1
// CHECK: ret_void
// CHECK: seq.get r4, r0, r2
// CHECK: move r6, r4
// CHECK: move r5, r1
// CHECK: call flg=0, #2
// CHECK: data (func_index=3(imported))
// CHECK: int.add_imm r2, r2, #1
// CHECK: jmp -9

// CHECK: [1, 2, 3, 4, 1, 2, 3, 1, 2, 3]
