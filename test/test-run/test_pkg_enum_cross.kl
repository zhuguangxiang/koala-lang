// RUN: koala %s | filecheck %s

import "test_pkg/enum_cross_indirect" as zz
import "test_pkg/enum_cross" as yy

func main() {
    let proto yy.Proto = yy.Proto.TCP
    let echoed yy.Proto = yy.echo(proto)
    if echoed == yy.Proto.TCP {
        print("cross-package enum")
    }

    let max_value = yy.Proto.MAX
    let raw int = max_value
    print(raw)

    // a class field whose type is an enum, persisted in the package .klc
    let h = yy.Holder(yy.Proto.TCP, "x")
    print(h.proto.name())
    print(h.is_tcp())
    let m = yy.make_holder(yy.Proto.MAX)
    print(yy.holder_proto(m).name())

    // enum is indrectly.
    print(zz.fn(yy.Proto.TCP))
}

// CHECK: cross-package enum
// CHECK: 9223372036854775807
// CHECK: TCP
// CHECK: true
// CHECK: MAX
// CHECK: true
