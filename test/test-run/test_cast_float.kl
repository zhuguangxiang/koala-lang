// RUN: koala %s | filecheck %s

// ---------- float -> float narrowing ----------

func test_f64_to_f32(n float64) float32 { return float32(n) }
func test_f64_to_f16(n float64) float16 { return float16(n) }
func test_f32_to_f16(n float32) float16 { return float16(n) }

// ---------- float widening ----------

func test_f16_to_f32(n float16) float32 { return float32(n) }
func test_f16_to_f64(n float16) float64 { return float64(n) }
func test_f32_to_f64(n float32) float64 { return float64(n) }

// ---------- float -> int/uint ----------

func test_f64_to_i8(n float64) int8 { return int8(n) }
func test_f64_to_i16(n float64) int16 { return int16(n) }
func test_f64_to_i32(n float64) int32 { return int32(n) }
func test_f64_to_i64(n float64) int64 { return int64(n) }
func test_f64_to_u8(n float64) uint8 { return uint8(n) }
func test_f64_to_u16(n float64) uint16 { return uint16(n) }
func test_f64_to_u32(n float64) uint32 { return uint32(n) }
func test_f64_to_u64(n float64) uint64 { return uint64(n) }
func test_f32_to_i8(n float32) int8 { return int8(n) }
func test_f32_to_i16(n float32) int16 { return int16(n) }
func test_f32_to_i32(n float32) int32 { return int32(n) }
func test_f32_to_i64(n float32) int64 { return int64(n) }
func test_f32_to_u8(n float32) uint8 { return uint8(n) }
func test_f32_to_u16(n float32) uint16 { return uint16(n) }
func test_f32_to_u32(n float32) uint32 { return uint32(n) }
func test_f32_to_u64(n float32) uint64 { return uint64(n) }
func test_f16_to_i8(n float16) int8 { return int8(n) }
func test_f16_to_i16(n float16) int16 { return int16(n) }
func test_f16_to_i32(n float16) int32 { return int32(n) }
func test_f16_to_i64(n float16) int64 { return int64(n) }
func test_f16_to_u8(n float16) uint8 { return uint8(n) }
func test_f16_to_u16(n float16) uint16 { return uint16(n) }
func test_f16_to_u32(n float16) uint32 { return uint32(n) }
func test_f16_to_u64(n float16) uint64 { return uint64(n) }

func main() {
    // --- float64 -> float32 narrowing ---
    print(test_f64_to_f32(3.14159265358979))
    print(test_f64_to_f32(0.0))
    print(test_f64_to_f32(-1.5))

    // --- float64 -> float16 narrowing ---
    print(test_f64_to_f16(1.2345678901234567))
    print(test_f64_to_f16(0.0))
    print(test_f64_to_f16(-1.5))

    // --- float32 -> float16 narrowing ---
    print(test_f32_to_f16(1.5))

    // --- float16 -> float32 widening ---
    print(test_f16_to_f32(1.5))

    // --- float16 -> float64 widening ---
    print(test_f16_to_f64(1.5))

    // --- float32 -> float64 widening ---
    print(test_f32_to_f64(3.14))

    // --- float64 -> int ---
    print(test_f64_to_i8(100.7))
    print(test_f64_to_i8(-100.7))
    print(test_f64_to_i16(1000.7))
    print(test_f64_to_i16(-1000.7))
    print(test_f64_to_i32(100000.7))
    print(test_f64_to_i32(-100000.7))
    print(test_f64_to_i64(100000.7))
    print(test_f64_to_i64(-100000.7))

    // --- float64 -> uint ---
    print(test_f64_to_u8(200.7))
    print(test_f64_to_u16(50000.7))
    print(test_f64_to_u32(100000.7))
    print(test_f64_to_u64(100000.7))

    // --- float32 -> int ---
    print(test_f32_to_i8(100.7))
    print(test_f32_to_i8(-100.7))
    print(test_f32_to_i16(1000.7))
    print(test_f32_to_i16(-1000.7))
    print(test_f32_to_i32(100000.7))
    print(test_f32_to_i32(-100000.7))
    print(test_f32_to_i64(100000.7))
    print(test_f32_to_i64(-100000.7))

    // --- float32 -> uint ---
    print(test_f32_to_u8(200.7))
    print(test_f32_to_u16(50000.7))
    print(test_f32_to_u32(100000.7))
    print(test_f32_to_u64(100000.7))

    // --- float16 -> int ---
    print(test_f16_to_i8(100.5))
    print(test_f16_to_i8(-100.5))
    print(test_f16_to_i16(1000.5))
    print(test_f16_to_i16(-1000.5))
    print(test_f16_to_i32(1000.5))
    print(test_f16_to_i32(-1000.5))
    print(test_f16_to_i64(1000.5))
    print(test_f16_to_i64(-1000.5))

    // --- float16 -> uint ---
    print(test_f16_to_u8(100.5))
    print(test_f16_to_u16(1000.5))
    print(test_f16_to_u32(1000.5))
    print(test_f16_to_u64(1000.5))

    // --- -0.0 ---
    print(test_f64_to_i64(-0.0))
    print(test_f64_to_u64(-0.0))

    // --- negative float -> uint ---
    print(test_f64_to_u8(-1.5))
    print(test_f64_to_u16(-1.5))
    print(test_f64_to_u32(-1.5))
    print(test_f64_to_u64(-1.5))
    print(test_f32_to_u8(-1.5))
    print(test_f32_to_u16(-1.5))
    print(test_f32_to_u32(-1.5))
    print(test_f32_to_u64(-1.5))
    print(test_f16_to_u8(-1.5))
    print(test_f16_to_u16(-1.5))
    print(test_f16_to_u32(-1.5))
    print(test_f16_to_u64(-1.5))

    // --- out-of-range (inf) ---
    print(test_f64_to_i64(1.0e19))
    print(test_f64_to_i64(-1.0e19))
    let pinf float64 = 1.0e400
    let ninf float64 = -1.0e400
    print(test_f64_to_i8(pinf))
    print(test_f64_to_i64(pinf))
    print(test_f64_to_u64(pinf))
    print(test_f64_to_i64(ninf))
    print(test_f64_to_u64(ninf))

    // --- NaN ---
    print(test_f64_to_i64(pinf - pinf))
    print(test_f64_to_u64(pinf - pinf))
}

// float64 -> float32
// CHECK: 3.1415927410125732
// CHECK: 0
// CHECK: -1.5
// float64 -> float16
// CHECK: 1.234375
// CHECK: 0
// CHECK: -1.5
// float32 -> float16
// CHECK: 1.5
// float16 -> float32
// CHECK: 1.5
// float16 -> float64
// CHECK: 1.5
// float32 -> float64
// CHECK: 3.1400000000000001
// float64 -> int
// CHECK: 100
// CHECK: -100
// CHECK: 1000
// CHECK: -1000
// CHECK: 100000
// CHECK: -100000
// CHECK: 100000
// CHECK: -100000
// float64 -> uint
// CHECK: 200
// CHECK: 50000
// CHECK: 100000
// CHECK: 100000
// float32 -> int
// CHECK: 100
// CHECK: -100
// CHECK: 1000
// CHECK: -1000
// CHECK: 100000
// CHECK: -100000
// CHECK: 100000
// CHECK: -100000
// float32 -> uint
// CHECK: 200
// CHECK: 50000
// CHECK: 100000
// CHECK: 100000
// float16 -> int
// CHECK: 100
// CHECK: -100
// CHECK: 1000
// CHECK: -1000
// CHECK: 1000
// CHECK: -1000
// CHECK: 1000
// CHECK: -1000
// float16 -> uint
// CHECK: 100
// CHECK: 1000
// CHECK: 1000
// CHECK: 1000
// -0.0
// CHECK: 0
// CHECK: 0
// negative float -> uint saturates to 0
// CHECK: 0
// CHECK: 0
// CHECK: 0
// CHECK: 0
// CHECK: 0
// CHECK: 0
// CHECK: 0
// CHECK: 0
// CHECK: 0
// CHECK: 0
// CHECK: 0
// CHECK: 0
// out-of-range saturates, then wraps to the dst width
// CHECK: 9223372036854775807
// CHECK: -9223372036854775808
// CHECK: -1
// CHECK: 9223372036854775807
// CHECK: -1
// CHECK: -9223372036854775808
// CHECK: 0
// NaN
// CHECK: 0
// CHECK: 0
