// RUN: koala %s | filecheck %s
// A function without a declared return type takes it from an `= expr` body. A block body is
// statements only: `{ expr }` returns nothing, its value is dropped (test-kl/
// test_block_body_errors.kl).

func eq_nil(v str?) = if v == nil { 0 } else { v.len() }
func inc(a int) = a + 1
func hello() = "hi"
func size(s str) = s.len()
func pair(a int) = [a, a]
func maybe(c bool) = if c { 1 } else { nil }
func none() = nil
func or_none(v str?) = v ?? "none"
func positive(a int) = a > 0
func block_body(a int) { print(a * 3) }
func id[T](x T) = x

// a call of a function defined later, as a statement, keeps working
func run() { later() }
func later() { print("later") }

// with a declared return type, recursion and later functions are fine
func fact(n int) int = if n <= 1 { 1 } else { n * fact(n - 1) }
func first() int = second() + 1
func second() int = 1

class Rect {
    let w int
    let h int
    func __init__(_w int, _h int) { w = _w; h = _h }
    pub func area() = w * h
}

func main() {
    print(eq_nil("abc"), eq_nil(nil))
    print(inc(1), hello(), size("ab"), pair(2))
    print(maybe(true), maybe(false), none(), or_none(nil))
    if positive(1) { print("pos") }
    block_body(2)
    print(id(5), id("s"))
    run()
    print(fact(5), first())
    print(Rect(2, 3).area())
}

// CHECK: 3 0
// CHECK-NEXT: 2 hi 2 [2, 2]
// CHECK-NEXT: 1 nil nil none
// CHECK-NEXT: pos
// CHECK-NEXT: 6
// CHECK-NEXT: 5 s
// CHECK-NEXT: later
// CHECK-NEXT: 120 2
// CHECK-NEXT: 6
// CHECK-NOT: {{.}}
