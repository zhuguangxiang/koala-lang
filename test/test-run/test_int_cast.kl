// RUN: koala %s ++ --dump=lir | filecheck %s

func test_int_cast(n int16) uint32 {
    return uint32(n)
}

func test_int_wrap(n int) int8 {
    return int8(n)
}

func test_u32_max() uint32 {
    return 4294967295
}

func main() {
    let x = test_int_cast(123)
    print(x + 1 == 124)
    print(x == 123)

    let y = 300
    print(test_int_wrap(y))

    print(test_int_cast(-1))
    print(test_int_wrap(-1))
    print(test_int_wrap(127))
    print(test_int_wrap(128))
    let m = test_u32_max()
    print(m)
    print(m + 1 == 0)
    print(m > 0)
}

// CHECK: %0 = int.cast %n int16 to uint32
// CHECK: %0 = int.cast %n int64 to int8
// the callees are inlined into main: in-range casts of constants are folded,
// out-of-range ones are left to the runtime cast
// CHECK-LABEL: func @main()
// CHECK-NOT: call @test_
// CHECK: load_tag %0 bool, true bool
// CHECK: %1 = build_intern @tuple, nargs=1
// CHECK: load_tag %4 bool, true bool
// CHECK: load_int_imm %8 int64, 300 int64
// CHECK-NEXT: %9 = int.cast %8 int64 to int8
// CHECK: load_int_imm %13 int16, -1 int16
// CHECK-NEXT: %14 = int.cast %13 int16 to uint32
// CHECK: load_int_imm %18 int8, -1 int8
// CHECK: load_int_imm %22 int8, 127 int8
// CHECK: load_int_imm %26 int64, 128 int64
// CHECK-NEXT: %27 = int.cast %26 int64 to int8
// CHECK: loadk %31 uint32, 4294967295 uint32
// CHECK: load_tag %35 bool, false bool
// CHECK: load_tag %39 bool, true bool
// CHECK-NOT: call @test_
// CHECK: ret void
// CHECK: true
// CHECK: true
// CHECK: 44
// CHECK: 4294967295
// CHECK: -1
// CHECK: 127
// CHECK: -128
// CHECK: 4294967295
// CHECK: false
// CHECK: true

/*
panic: int64 → int8 cast overflow (300 not in [-128, 127])
Aborted (core dumped)
