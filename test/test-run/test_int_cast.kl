// RUN: koala %s --dump=lir | filecheck %s

func test_int_cast(n int16) uint32 {
    return uint32(n)
}

func test_int_wrap(n int) int8 {
    return int8(n)
}

func test_u32_max() uint32 {
    return 4294967295
}

func main() {
    let x = test_int_cast(123)
    print(x + 1 == 124)
    print(x == 123)

    let y = 300
    print(test_int_wrap(y))

    print(test_int_cast(-1))
    print(test_int_wrap(-1))
    print(test_int_wrap(127))
    print(test_int_wrap(128))
    let m = test_u32_max()
    print(m)
    print(m + 1 == 0)
    print(m > 0)
}

// CHECK: %0 = int.cast %n int16 to uint32
// CHECK: %0 = int.cast %n int64 to int8
// CHECK: load_int_imm %0 int16, 123 int16
// CHECK: %2 = cast %1 uint32 to int64
// CHECK: %3 = int.add_imm %2 int64, 1 int64
// CHECK: %4 = int.eq_imm %3 int64, 124 int64
// CHECK: %5 = build_intern @tuple, nargs=1
// CHECK: %8 = cast %1 uint32 to int64
// CHECK: %9 = int.eq_imm %8 int64, 123 int64
// CHECK: true
// CHECK: true
// CHECK: 44
// CHECK: 4294967295
// CHECK: -1
// CHECK: 127
// CHECK: -128
// CHECK: 4294967295
// CHECK: false
// CHECK: true

