// RUN: koala --test %s

import "std/ut"

@bench(warmup=2, runs=10)
func test_bench_sum() {
    var sum = 0
    var i = 0
    while i < 1000 {
        sum = sum + i
        i = i + 1
    }
}

@bench(warmup=1, runs=5)
func test_bench_multiply() {
    var result = 1
    var i = 1
    while i < 100 {
        result = result * 2
        i = i + 1
    }
}

@bench(runs=3)
func test_bench_fibonacci() {
    var a = 0
    var b = 1
    var i = 0
    while i < 30 {
        let temp = a + b
        a = b
        b = temp
        i = i + 1
    }
}
