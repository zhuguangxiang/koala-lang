// RUN: koalac %s | filecheck %s

class Bar {
    func bar() int {
        return 10
    }

    func get_id() int? { return 42 }
}

class Foo {
    func __init__() {}

    func foo() Bar? {
        return null
    }

    func test1() int { return 1; }

    func test2() int? { return 1; }

    func bar() int = 1111
}

let foo = Foo()
foo.foo().bar()
// CHECK: optional cannot use dot operator.

func fn1(f1 Foo?) int {

    var f = f1

    if (f == null) { return 0 }

    {
        f = null
    }

    if (f == null) { return 1 }

    return f.bar()
}

func fn2(f1 Foo?) int {
    if let f = f1 {
        f = f1
        // CHECK-NEXT: cannot assign to immutable variable 'f'
        return f.bar()
    } else {
        f
        // CHECK-NEXT: 'f' is not found
        return 0
    }

    let f2 = Foo()

    if let v = f2.foo() {
        return v.bar()
    } else {
        v
        // CHECK-NEXT: 'v' is not found
        return 0
    }

    if let f1 = f1 {
        return f1.bar()
    } else {
        return 0
    }
}

func fn3(f Foo) {
    if let id = f.foo()?.get_id() {
        id + 1
        id = 100
        // CHECK-NEXT: cannot assign to immutable variable 'id'
    }
}

// CHECK-NOT: {{.}}
