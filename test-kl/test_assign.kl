// RUN: koalac %s | filecheck %s

func foo() int? {
    return 42
}

let a = 10
a = 20
// CHECK: cannot assign to immutable variable 'a'
a = null
// CHECK-NEXT: cannot assign to immutable variable 'a'
a = foo()
// CHECK-NEXT: cannot assign to immutable variable 'a'

var b = 30
b = 40
b = true
// CHECK-NEXT: Types of two sides are not matched.
// CHECK-NEXT: lhs: int64 =/= rhs: bool
b = "hello"
// CHECK-NEXT: Types of two sides are not matched.
// CHECK-NEXT: lhs: int64 =/= rhs: str
b = 1.2
// CHECK-NEXT: Types of two sides are not matched.
// CHECK-NEXT: lhs: int64 =/= rhs: float64
b = null
// CHECK-NEXT: Cannot assign null to non-nullable type.
// CHECK-NEXT: lhs: int64 =/= rhs: _?
b = foo()
// CHECK-NEXT: Types of two sides are not matched.
// CHECK-NEXT: lhs: int64 =/= rhs: int64?

let c int? = 100
c = 200
// CHECK-NEXT: cannot assign to immutable variable 'c'
c = null
// CHECK-NEXT: cannot assign to immutable variable 'c'
c = foo()
// CHECK-NEXT: cannot assign to immutable variable 'c'

var d int? = null
d = 300
d = null
d = false
// CHECK-NEXT: Types of two sides are not matched.
// CHECK-NEXT: lhs: int64? =/= rhs: bool
d = foo()

func fn1(v1 int?, v2 int) {
    v1 = 10
    // CHECK-NEXT: cannot assign to immutable variable 'v1'
    v2 = 100
    // CHECK-NEXT: cannot assign to immutable variable 'v2'

    var v3 = 20

    if v2 > 0 {
        v3 = v2
    } else {
        v3 = null
        // CHECK-NEXT: Cannot assign null to non-nullable type.
        // CHECK-NEXT: lhs: int64 =/= rhs: _?
        v3 = v1
        // CHECK-NEXT: Types of two sides are not matched.
        // CHECK-NEXT: lhs: int64 =/= rhs: int64?
    }

    var v4 int? = null
    if v2 < 0 {
        v4 = v2
    } else {
        v4 = 100
    }
    v4 = null
}

class Foo {
    var a = 100
    let b = 200
    var v int? = 100

    func __init__() {}

    func foo() Foo? {
        return Foo()
    }
}

func fn2(v1 int?, v2 int) {
    let v3 = 0

    if v1 != null {
        v3 = v2
        // CHECK-NEXT: cannot assign to immutable variable 'v3'
    }

    var v4 int? = null
    if v4 != null {
        v4 = v2
        v4 + 2
        v4 = null
        v4 + 3
        // CHECK-NEXT: optional type cannot be used with '+' operator.
        if v4 != null {
            v4 + 100
        }
        v4 + 200
        // CHECK-NEXT: optional type cannot be used with '+' operator.
    } else {
        v4 + 300
        // CHECK-NEXT: optional type cannot be used with '+' operator when value is null.
    }
    v4 = 100
    v4 + 400
    // CHECK-NEXT: optional type cannot be used with '+' operator.

    if v4 == null { return }

    v4 + 500
    v4 = null
    v4 + 600
    // CHECK-NEXT: optional type cannot be used with '+' operator.

    let v5 int? = null
    if v5 != null {
        v5 + 700
        v5 = 800
        // CHECK-NEXT: cannot assign to immutable variable 'v5'
    }
    v5 + 900
    // CHECK-NEXT: optional type cannot be used with '+' operator.

    let foo = Foo()
    foo.a = 300
    foo.b = 400
    // CHECK-NEXT: cannot assign to immutable variable 'b'

    foo.v = null
    foo.v = foo.b

    let foo2 = foo.foo()
    foo2.a
    // CHECK-NEXT: optional cannot use dot operator.
    foo2!.a

    if foo2 != null {
        foo2.a
    }

    var f1 = Foo()
    var f2 = f1
    if f1.v != null {
        f2.v = null
        f1.v + 1
        // CHECK-NEXT: optional type cannot be used with '+' operator.
        f1.v! + 2
    }

    let tmp = f1.v
    if tmp != null {
        tmp + 1
        tmp! + 2
        // CHECK-NEXT: bang operator applied on non-nullable variable('tmp').
    }

    let tmp2 = 10
    tmp2!
    // CHECK-NEXT: only optional type can use bang operator.
}

// CHECK-NOT: {{.}}
