// RUN: koalac %s | filecheck %s

func fn1(v1 int?) {
    if v1 != null {
        v1 + 123
    }

    v1 + 200
    // CHECK: optional type cannot be used with '+' operator.
}

func fn2(v1 int?) {
    if v1 != null {
        v1 + 123

        let v2 int? = null

        if (v2 == null) {
            v2 + 456
            // CHECK-NEXT: optional type cannot be used with '+' operator when value is null.
        }

        v1 + 456

        v2 + 789
        // CHECK-NEXT: optional type cannot be used with '+' operator.
    }

    v1 + 200
    // CHECK-NEXT: optional type cannot be used with '+' operator.
}

func fn3(v1 int?) {
    if v1 == null {
        return
    }

    v1 + 100
}

func fn4(v int?) int {
    if null != v {
        return 1
    } else {
        return 0
    }

    if null != v { return 1 }

    v + 1
    // CHECK-NEXT: optional type cannot be used with '+' operator when value is null.

    null != v

    return 100
}

func fn5(v1 int?) {
    if v1 != null {
        v1 + 123

        let v2 int? = null
        if (v2 == null) {
            return
        }

        v1 + 456
        v2 + 789
    }

    v1 + 200
    // CHECK-NEXT: optional type cannot be used with '+' operator.
}

func fn6(v1 int?) {
    if v1 != null {
        v1 + 123

        let v2 int? = null
        {
            if (v2 == null) {
                return
            }

            v1 + 456
        }
        v2 + 789
        // CHECK-NEXT: optional type cannot be used with '+' operator.

    }

    v1 + 200
    // CHECK-NEXT: optional type cannot be used with '+' operator.
}

func fn7(v1 int) {
    let v2 int? = null
    if (v1 > 0) {
        if (v2 == null) { return }
    }
    v2 + 1
    // CHECK-NEXT: optional type cannot be used with '+' operator.
}

func fn8(v1 int?, v2 int?) {
    if (v1 == null) { return }
    // Shadow Scope A (v1: int)
    if (v2 == null) { return }
    // Shadow Scope B (v1: int, v2: int)
    v1 + v2
}

func fn9() {
    let v2 int? = null
    {
        {
            if (v2 == null) { return }
        }
        v2 + 1
        // CHECK-NEXT: optional type cannot be used with '+' operator.
    }
    v2 + 1
    // CHECK-NEXT: optional type cannot be used with '+' operator.
}

// func fn10(v int?) {
//     if !(v != null) { // 嵌套取反
//         return
//     }
//     v + 1 // 这里能认出来是 int 吗？
// }

func fn11(v int?) int {
    if (v == null) {
        return 1
        v + 1 // dead code
    }

    v + 1
}

func fn12(v int?) int {
    if (v == null) {
        {
            return 1 // The return is inside a naked block
        }

        v + 2 // // dead code
    }

    v + 1
}

func fn13(v int?) int {
    if (v == null) {
        return 1
        v + 1 // // dead code
    }

    v + 1

    if (v == null) {
        // CHECK-NEXT: cannot compare non-optional type with optional type for '==' operator.
        {
            return 1 // The return is inside a naked block
        }

        v + 2 // dead code
    }
}

