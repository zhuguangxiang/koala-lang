// RUN: koalac %s 2>&1 | filecheck %s

trait Fly {
    func fly() str
}

trait Swim[U] {
    func swim(u U) str
}

class Bar {
}

class Baz2[int] : Fly & Swim[int] {
}

// CHECK: expected type-parameter decl-list.

class Baz1 : Bar & Fly & Swim {
}

// CHECK-NEXT: 'Bar' is not trait, only trait can be used as base
// CHECK-NEXT: Type argument mismatch: 'Swim' expects 1 argument(s), but 0 were provided

class Baz[T] : Fly & Swim[T] {

    var value T

    func __init__(v T) {
    }

    func hello(s str) Baz[T] {
    }

    func fly() str {
        // return "I'm flying!"
    }

    func swim(u T) str {
        // return "I'm swimming with " + to_str(u)
    }
}

class Baz2 : Fly[int] & Swim[int] {
}

// CHECK-NEXT: Type argument mismatch: 'Fly' expects 0 argument(s), but 1 were provided

let b1 Baz[int] = Baz[int](100)
let v = b1.value
let v2 int = b1.value

let r = b1.hello("world")
let r2 = r.fly()
let r3 = r.swim(200)
let r3_1 = r.swim("test")
// CHECK-NEXT: argument type is not compatible.

let fly Fly = r
let r4 = fly.fly()

let swim Swim[int] = r
let r5 = swim.swim(300)
let r6 = swim.swim("hello")
// CHECK-NEXT: argument type is not compatible.

class Baz3 : Fly & Swim[int] {
}

let b2 = Baz[T]()

// CHECK-NEXT: 'T' is not found

trait Animal {
    func sound() str
}

class Dog : Animal {
    var name str

    func __init__(name str) {
    }

    func sound() str {
        // return "Woof!"
    }
}

let a1 Animal = Dog("Buddy")
let s = a1.sound() + " and more."

let d1 Dog = Dog("Max")
let s2 = d1.sound()

trait A {
    func f() int
}

trait B[T] {
    func g() int
}

trait C[T] : A & B[T] {
    func h() int
}

class D : B[int] & C[int] {
    func __init__() {
    }

    func f() int {
        // return 1
    }

    func g() int {
        // return 2
    }

    func h() int {
        // return 3
    }
}

let d = D()
let c C[int] = d
let b B[int] = d
let a A = d

let bb B[int] = c
let aa A = c

let aa1 A = b
// CHECK-NEXT: Types of two sides are not matched.
// CHECK-NEXT: lhs: A =/= rhs: _Z1Bj

let bb1 B[int] = a
// CHECK-NEXT: Types of two sides are not matched.
// CHECK-NEXT: lhs: _Z1Bj =/= rhs: A

// CHECK-NOT: {{.}}
