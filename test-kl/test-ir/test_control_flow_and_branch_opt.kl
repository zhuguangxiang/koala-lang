// RUN: koalac %s --cgen --fusion --tail-call --dump=code | filecheck %s

func test_const_if_folding(n int) int {
    let a = 10
    if a > 5 {
        return n + 1
    } else {
        return n + 100
    }
}

// CHECK-LABEL: @test_const_if_folding[0,1]:
// CHECK: {{[0-9]+}}:  06000001   int.add_imm r0, r0, #1
// CHECK: {{[0-9]+}}:  5B000000   ret r0

func test_branch_rpo_layout(n int) int {
    var r = 0
    if n > 0 {
        r = 1
    } else {
        r = 2
    }
    return r
}

// CHECK-LABEL: @test_branch_rpo_layout[2,7]:
// CHECK: {{[0-9]+}}:  02010000   load_int_imm r1, #0
// CHECK: {{[0-9]+}}:  4C000002   jmp_int_le_imm r0, #0, 2
// CHECK: {{[0-9]+}}:  02010001   load_int_imm r1, #1
// CHECK: {{[0-9]+}}:  42000001   jmp 1
// CHECK: {{[0-9]+}}:  02010002   load_int_imm r1, #2
// CHECK: {{[0-9]+}}:  5B000001   ret r1

func test_nested_jump_threading(n int) int {
    if n > 0 {
        if n > 10 {
            return 1
        }
    }
    return 0
}

// CHECK-LABEL: @test_nested_jump_threading[8,11]:
// CHECK: {{[0-9]+}}:  4C000002   jmp_int_le_imm r0, #0, 2
// CHECK: {{[0-9]+}}:  4C000A01   jmp_int_le_imm r0, #10, 1
// CHECK: {{[0-9]+}}:  5C000001   ret_int_imm #1
// CHECK: {{[0-9]+}}:  5C000000   ret_int_imm #0

func test_phi_precursor_merge(n int) int {
    var x = 0
    if n > 100 {
        x = 1
    }
    return x
}

// CHECK-LABEL: @test_phi_precursor_merge[12,15]:
// CHECK: {{[0-9]+}}:  02010000   load_int_imm r1, #0
// CHECK: {{[0-9]+}}:  4C006401   jmp_int_le_imm r0, #100, 1
// CHECK: {{[0-9]+}}:  02010001   load_int_imm r1, #1
// CHECK: {{[0-9]+}}:  5B000001   ret r1

func test_logic_short_circuit(a int, b int) bool {
    if a > 0 && b > 0 {
        return true
    }
    return false
}

// TODO: verify that short-circuiting of logical AND is correctly implemented in the generated code
// CHECK-LABEL: @test_logic_short_circuit[16,21]:
// CHECK: {{[0-9]+}}:  22000000   int.cmpgt_imm r0, r0, #0
// CHECK: {{[0-9]+}}:  22010100   int.cmpgt_imm r1, r1, #0
// CHECK: {{[0-9]+}}:  3F000001   land r0, r0, r1
// CHECK: {{[0-9]+}}:  44000001   jmp_false r0, 1
// CHECK: {{[0-9]+}}:  5D00FFFF   ret_tag #-1
// CHECK: {{[0-9]+}}:  5D00FFFF   ret_tag #-1
