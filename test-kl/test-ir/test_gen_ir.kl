// RUN: koalac %s | filecheck %s

let i = 10
let j = i + 1

print(i, j)

func foo() str { return "hello" }

let s = foo()

let l = [1, 2, 3]

let l2 = list(1,2,30)

let v = int(100)

let t = tuple(10, 20)

// CHECK: global @i int64
// CHECK: global @j int64
// CHECK: func @__init__() {
// CHECK: %entry:
// CHECK:   store @i int64, 10 int64
// CHECK:   [[REG_I:%.*]] = load @i int64
// CHECK:   [[REG_ADD:%.*]] = add [[REG_I]] int64, 1 int64
// CHECK:   store @j int64, [[REG_ADD]] int64
// CHECK: }
