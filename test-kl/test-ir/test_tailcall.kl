// RUN: koalac %s --cgen --fusion --tail-call --dump=code | filecheck %s

func sum(n int, acc int) int {
    if n == 0 { return acc }
    return sum(n - 1, acc + n)
}

print(sum(100000000, 0))

func ack(m int, n int) int {
    if m == 0 { return n + 1 }

    if n == 0 { return ack(m - 1, 1) }

    return ack(m - 1, ack(m, n - 1))
}

print(ack(3, 11))

// CHECK-LABEL: ====== Emitted Bytecode (insns: 36) ======

