// RUN: koalac %s --isel --dump=opt-ir,lir | filecheck %s

func foo(n int) int {
    let a = 500
    let b = n + a + 1
    var c = b + 2
    c = c + 3
    return c
}

func fib(n int) int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

// CHECK-LABEL: --- IR Dump After isel [@fib] ---
// CHECK-LABEL: func @fib(%n int64) int64
// CHECK: %bb0(entry):
// CHECK: %0 = int.cmp_lt_imm %n int64, 2 int64
// CHECK: branch %0 bool, label %bb1, label %bb2
// CHECK: %bb1(if-then):
// CHECK: ret %n int64
// CHECK: %bb2(if-end):
// CHECK: %1 = int.sub_imm %n int64, 1 int64
// CHECK: %2 = call @fib, 1
// CHECK: %3 = int.sub_imm %n int64, 2 int64
// CHECK: %4 = call @fib, 1
// CHECK: %5 = int.add %2 int64, %4 int64
// CHECK: ret %5 int64

func test_while(n int) {
    var i = 0
    while i < n {
        i = i + 1
    }
}

// CHECK-LABEL: --- IR Dump After isel [@test_while] ---
// CHECK-LABEL: func @test_while(%n int64)
// CHECK: %bb0(entry):
// CHECK: %i = local int64
// CHECK: load_int_imm %i int64, 0 int64
// CHECK: jmp label %bb1
// CHECK: %bb1(while-cond):
// CHECK: %0 = int.cmp_lt %i int64, %n int64
// CHECK: branch %0 bool, label %bb2, label %bb3
// CHECK: %bb2(while-body):
// CHECK: %1 = int.add_imm %i int64, 1 int64
// CHECK: move %i int64, %1 int64
// CHECK: jmp label %bb1
// CHECK: %bb3(while-end):
// CHECK: ret void

func test_nested_loop(n int) {
    var i = 0
    while (i < n) {
        var j = 0
        while (j < i) {
            print(j)
            j = j + 1
        }
        i = i + 1
    }
}

// CHECK-LABEL: --- IR Dump After isel [@test_nested_loop] ---
// CHECK-LABEL: func @test_nested_loop(%n int64)

// CHECK: %i = local int64
// CHECK: load_int_imm %i int64, 0 int64
// CHECK: jmp label %bb1

// CHECK: %0 = int.cmp_lt %i int64, %n int64
// CHECK: branch %0 bool, label %bb2, label %bb3


// CHECK: %j = local int64
// CHECK: load_int_imm %j int64, 0 int64
// CHECK: jmp label %bb4

// CHECK: ret void

// CHECK: %1 = int.cmp_lt %j int64, %i int64
// CHECK: branch %1 bool, label %bb5, label %bb6

// CHECK: %2 = local int64
// CHECK: move %2 int64, %j int64
// CHECK: call @print [path = 'std/builtin'], 1
// CHECK: %3 = int.add_imm %j int64, 1 int64
// CHECK: move %j int64, %3 int64
// CHECK: jmp label %bb4

// CHECK: %4 = int.add_imm %i int64, 1 int64
// CHECK: move %i int64, %4 int64
// CHECK: jmp label %bb1

var b = true

func foo2() {
    if b {
        print("true")
    } else {
        print("false")
    }
}

// CHECK-LABEL: --- IR Dump After isel [@foo2] ---
// CHECK-LABEL: func @foo2()

// CHECK: %0 = get_global @b bool
// CHECK: branch %0 bool, label %bb1, label %bb2

// CHECK: %1 = local str
// CHECK: loadk %1 str, 'true' str
// CHECK: call @print [path = 'std/builtin'] [const], 1
// CHECK: jmp label %bb3

// CHECK: %2 = local str
// CHECK: loadk %2 str, 'false' str
// CHECK: call @print [path = 'std/builtin'] [const], 1
// CHECK: jmp label %bb3

// CHECK: ret void

func bar(n int) int {
    var v = 10 < 20
    if v {
        return 1
    } else {
        return 0
    }
}

// CHECK-LABEL: --- IR Dump After isel [@bar] ---
// CHECK-LABEL: func @bar(%n int64) int64
// CHECK: ret_int_imm 1 int64

func bar2(n int) {
}

// CHECK-LABEL: --- IR Dump After isel [@bar2] ---
// CHECK-LABEL: func @bar2(%n int64)
// CHECK: ret void
