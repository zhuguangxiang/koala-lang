// RUN: koalac %s --cgen --dump=code | filecheck %s

func foo(n int) int {
    let a = 500
    let b = n + a + 1
    var c = b + 2
    c = c + 3
    return c
}

// CHECK-LABEL: ====== Linearization @foo(start_pc: 0, insns: 8) ======
// CHECK: {{[0-9]+}}:  load_int_imm r1, ti=0xb, #500
// CHECK: {{[0-9]+}}:  int.add r0, r0, r1
// CHECK: {{[0-9]+}}:  int.add_imm r0, r0, #1
// CHECK: {{[0-9]+}}:  int.add_imm r0, r0, #2
// CHECK: {{[0-9]+}}:  move r1, r0
// CHECK: {{[0-9]+}}:  int.add_imm r0, r1, #3
// CHECK: {{[0-9]+}}:  move r1, r0
// CHECK: {{[0-9]+}}:  ret r0


func fib(n int) int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

// CHECK-LABEL: ====== Linearization @fib(start_pc: 8, insns: 11) ======
// CHECK: {{[0-9]+}}:  int.cmplt_imm r1, r0, #2
// CHECK: {{[0-9]+}}:  jmp_false r1, 1              ;; -> %bb-1(if-end)
// CHECK: {{[0-9]+}}:  ret r0
// CHECK: {{[0-9]+}}:  int.sub_imm r2, r0, #1
// CHECK: {{[0-9]+}}:  call flg=0, r1, #1
// CHECK: {{[0-9]+}}:  data
// CHECK: {{[0-9]+}}:  int.sub_imm r2, r0, #2
// CHECK: {{[0-9]+}}:  call flg=0, r0, #1
// CHECK: {{[0-9]+}}:  data
// CHECK: {{[0-9]+}}:  int.add r0, r1, r0
// CHECK: {{[0-9]+}}:  ret r0

func test_while(n int) {
    var i = 0
    while i < n {
        i = i + 1
    }
}

// CHECK-LABEL: ====== Linearization @test_while(start_pc: 19, insns: 7) ======
// CHECK: %bb-1(entry):
// CHECK: {{[0-9]+}}:  load_int_imm r1, ti=0xb, #0
// CHECK: {{[0-9]+}}:  int.cmpge_imm r2, r0, #0
// CHECK: {{[0-9]+}}:  jmp_false r2, 3              ;; -> %bb-1(while-end)

// CHECK: %bb-1(while-body):
// CHECK: {{[0-9]+}}:  int.add_imm r1, r1, #1
// CHECK: {{[0-9]+}}:  int.cmplt r2, r1, r0
// CHECK: {{[0-9]+}}:  jmp_true r2, -3              ;; -> %bb-1(while-body)

// CHECK: %bb-1(while-end):
// CHECK: {{[0-9]+}}:  ret_void

func test_nested_loop(n int) {
    var i = 0
    while (i < n) {
        var j = 0
        while (j < i) {
            print(j)
            j = j + 1
        }
        i = i + 1
    }
}

// CHECK-LABEL: ====== Linearization @test_nested_loop(start_pc: 26, insns: 16) ======

// CHECK: %bb-1(entry):
// CHECK: {{[0-9]+}}:  load_int_imm r1, ti=0xb, #0
// CHECK: {{[0-9]+}}:  int.cmpge_imm r2, r0, #0
// CHECK: {{[0-9]+}}:  jmp_false r2, 12             ;; -> %bb-1(while-end)

// CHECK: %bb-1(while-body):
// CHECK: {{[0-9]+}}:  load_int_imm r2, ti=0xb, #0
// CHECK: {{[0-9]+}}:  int.cmpge_imm r3, r1, #0
// CHECK: {{[0-9]+}}:  jmp_false r3, 6              ;; -> %bb-1(while-end)

// CHECK: %bb-1(while-body):
// CHECK: {{[0-9]+}}:  move r4, r2
// CHECK: {{[0-9]+}}:  call flg=1, #1
// CHECK: {{[0-9]+}}:  data
// CHECK: {{[0-9]+}}:  int.add_imm r2, r2, #1
// CHECK: {{[0-9]+}}:  int.cmplt r3, r2, r1
// CHECK: {{[0-9]+}}:  jmp_true r3, -6              ;; -> %bb-1(while-body)

// CHECK: %bb-1(while-end):
// CHECK: {{[0-9]+}}:  int.add_imm r1, r1, #1
// CHECK: {{[0-9]+}}:  int.cmplt r2, r1, r0
// CHECK: {{[0-9]+}}:  jmp_true r2, -12             ;; -> %bb-1(while-body)

// CHECK: %bb-1(while-end):
// CHECK: {{[0-9]+}}:  ret_void


