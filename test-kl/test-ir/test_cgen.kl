func fib(n int) int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

// CHECK-LABEL: --- IR Dump After isel-pass (Iter 1) [@fib] ---

func test_while(n int) {
    var i = 0
    while i < n {
        i = i + 1
    }
}

func test_nested_loop(n int) {
    var i = 0
    while (i < n) {
        var j = 0
        while (j < i) {
            print(j)
            j = j + 1
        }
        i = i + 1
    }
}

