// RUN: koalac %s --cgen --dump=cgen | filecheck %s

func foo(n int) int {
    let a = 500
    let b = n + a + 1
    var c = b + 2
    c = c + 3
    return c
}

// CHECK-LABEL: ====== Linearization @foo(start_pc: 1, insns: 6) ======
// CHECK: 1:  load_int_imm r1, #500
// CHECK: 2:  int.add r0, r0, r1
// CHECK: 3:  int.add_imm r0, r0, #1
// CHECK: 4:  int.add_imm r0, r0, #2
// CHECK: 5:  int.add_imm r0, r0, #3
// CHECK: 6:  ret r0


func fib(n int) int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

// CHECK-LABEL: ====== Linearization @fib(start_pc: 7, insns: 11) ======
// CHECK: 7:  int.cmplt_imm r1, r0, #2
// CHECK: 8:  jmp_false r1, 1              ;; -> %bb-1(if-end)
// CHECK: 9:  ret r0
// CHECK: 10:  int.sub_imm r2, r0, #1
// CHECK: 11:  call flg=0, r1, #1
// CHECK: 12:  data
// CHECK: 13:  int.sub_imm r2, r0, #2
// CHECK: 14:  call flg=0, r0, #1
// CHECK: 15:  data
// CHECK: 16:  int.add r0, r1, r0
// CHECK: 17:  ret r0

func test_while(n int) {
    var i = 0
    while i < n {
        i = i + 1
    }
}

// CHECK-LABEL: ====== Linearization @test_while(start_pc: 18, insns: 8) ======
// CHECK: %bb-1(entry):
// CHECK: 18:  load_int_imm r1, #0
// CHECK: 19:  jmp 0                        ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-cond):
// CHECK: 20:  int.cmplt r2, r1, r0
// CHECK: 21:  jmp_false r2, 3              ;; -> %bb-1(while-end)

// CHECK: %bb-1(while-body):
// CHECK: 22:  int.add_imm r2, r1, #1
// CHECK: 23:  move r1, r2
// CHECK: 24:  jmp -5                       ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-end):
// CHECK: 25:  ret_void

func test_nested_loop(n int) {
    var i = 0
    while (i < n) {
        var j = 0
        while (j < i) {
            print(j)
            j = j + 1
        }
        i = i + 1
    }
}

// CHECK-LABEL: ====== Linearization @test_nested_loop(start_pc: 26, insns: 18) ======

// CHECK: %bb-1(entry):
// CHECK: 26:  load_int_imm r1, #0
// CHECK: 27:  jmp 0                        ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-cond):
// CHECK: 28:  int.cmplt r2, r1, r0
// CHECK: 29:  jmp_false r2, 13             ;; -> %bb-1(while-end)

// CHECK: %bb-1(while-body):
// CHECK: 30:  load_int_imm r2, #0
// CHECK: 31:  jmp 0                        ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-cond):
// CHECK: 32:  int.cmplt r3, r2, r1
// CHECK: 33:  jmp_false r3, 6              ;; -> %bb-1(while-end)

// CHECK: %bb-1(while-body):
// CHECK: 34:  move r4, r2
// CHECK: 35:  call flg=1, #1
// CHECK: 36:  data
// CHECK: 37:  int.add_imm r3, r2, #1
// CHECK: 38:  move r2, r3
// CHECK: 39:  jmp -8                       ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-end):
// CHECK: 40:  int.add_imm r2, r1, #1
// CHECK: 41:  move r1, r2
// CHECK: 42:  jmp -15                      ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-end):
// CHECK: 43:  ret_void


