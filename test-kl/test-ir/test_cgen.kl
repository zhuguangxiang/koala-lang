func bar(n int) int {
    var v = 10 < 20
    if v {
        return 1
    } else {
        return 0
    }
}

func bar2(n int) {
}


func test_add(n int) int {
    var a = 500
    var b = n + a + 1
    return b
}

// CHECK-LABEL: ====== Linearization @test_add(start_pc: 55, insns: 5) ======

// CHECK: 55:  data
// CHECK: 56:  load_int_imm r1, #500
// CHECK: 57:  int.add r0, r0, r1
// CHECK: 58:  int.add_imm r0, r0, #1
// CHECK: 59:  ret r0

func test_big_int(n int) int {
    var a = 66000
    var b = n + a + 1
    var c = b + 2
    var d = c + 3
    return d
}
// CHECK-LABEL: ====== Linearization @test_big_int(start_pc: 60, insns: 7) ======
// CHECK: 60:  data
// CHECK: 61:  loadk r1, #0
// CHECK: 62:  int.add r0, r0, r1
// CHECK: 63:  int.add_imm r0, r0, #1
// CHECK: 64:  int.add_imm r0, r0, #2
// CHECK: 65:  int.add_imm r0, r0, #3
// CHECK: 66:  ret r0

func test_call(n int) int {
    var v = 10 < 20
    if v {
        return test_add(66000)
    } else {
        return test_add(20)
    }
}
// CHECK-LABEL: ====== Linearization @test_call(start_pc: 67, insns: 5) ======
// CHECK: 67:  data
// CHECK: 68:  push_const #0
// CHECK: 69:  call flg=0, r0, #1
// CHECK: 70:  data
// CHECK: 71:  ret r0

