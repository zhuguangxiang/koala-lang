//         print("true")
//     } else {
//         print("false")
//     }
// }

func bar(n int) int {
    var v = 10 < 20
    if v {
        return 1
    } else {
        return 0
    }
}

func bar2(n int) {
}


func test_add(n int) int {
    var a = 500
    var b = n + a + 1
    return b
}

// CHECK-LABEL: ====== Linearization @test_add(start_pc: 46, insns: 4) ======

// CHECK: %bb-1(entry):
// CHECK: 46:  load_int_imm r1, #500
// CHECK: 47:  int.add r0, r0, r1
// CHECK: 48:  int.add_imm r0, r0, #1
// CHECK: 49:  ret r0

func test_big_int(n int) int {
    var a = 66000
    var b = n + a + 1
    var c = b + 2
    var d = c + 3
    return d
}

// CHECK-LABEL: ====== Linearization @test_big_int(start_pc: 50, insns: 6) ======

// CHECK: %bb-1(entry):
// CHECK: 50:  loadk r1, #0
// CHECK: 51:  int.add r0, r0, r1
// CHECK: 52:  int.add_imm r0, r0, #1
// CHECK: 53:  int.add_imm r0, r0, #2
// CHECK: 54:  int.add_imm r0, r0, #3
// CHECK: 55:  ret r0

func test_call(n int) int {
    var v = 10 < 20
    if v {
        return test_add(66000)
    } else {
        return test_add(20)
    }
}
// CHECK-LABEL: ====== Linearization @test_call(start_pc: 56, insns: 4) ======

// CHECK: %bb-1(entry):
// CHECK: 56:  loadk r1, #0
// CHECK: 57:  call flg=0, r0, #1
// CHECK: 58:  data
// CHECK: 59:  ret r0

// CHECK-LABEL: ====== Emitted Bytecode (insns: 60) ======

