// RUN: koalac %s --cgen --dump=cgen | filecheck %s

func foo(n int) int {
    let a = 500
    let b = n + a + 1
    var c = b + 2
    c = c + 3
    return c
}

// CHECK-LABEL: ====== Linearization @foo(start_pc: 2, insns: 7) ======
// CHECK: 2:  data
// CHECK: 3:  load_int_imm r1, #500
// CHECK: 4:  int.add r0, r0, r1
// CHECK: 5:  int.add_imm r0, r0, #1
// CHECK: 6:  int.add_imm r0, r0, #2
// CHECK: 7:  int.add_imm r0, r0, #3
// CHECK: 8:  ret r0


func fib(n int) int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

// CHECK-LABEL: ====== Linearization @fib(start_pc: 9, insns: 14) ======
// CHECK: 9:  data
// CHECK: 10:  int.cmplt_imm r1, r0, #2
// CHECK: 11:  jmp_false r1, 1
// CHECK: 12:  ret r0
// CHECK: 13:  int.sub_imm r1, r0, #1
// CHECK: 14:  push r1
// CHECK: 15:  call flg=0, r1, #1
// CHECK: 16:  data
// CHECK: 17:  int.sub_imm r0, r0, #2
// CHECK: 18:  push r0
// CHECK: 19:  call flg=0, r0, #1
// CHECK: 20:  data
// CHECK: 21:  int.add r0, r1, r0
// CHECK: 22:  ret r0

func test_while(n int) {
    var i = 0
    while i < n {
        i = i + 1
    }
}

// CHECK-LABEL: ====== Linearization @test_while(start_pc: 23, insns: 9) ======
// CHECK: 23:  data
// CHECK: 24:  load_int_imm r1, #0
// CHECK: 25:  jmp 0
// CHECK: 26:  int.cmplt r2, r1, r0
// CHECK: 27:  jmp_false r2, 3
// CHECK: 28:  int.add_imm r2, r1, #1
// CHECK: 29:  move r1, r2
// CHECK: 30:  jmp -5
// CHECK: 31:  ret_void

func test_nested_loop(n int) {
    var i = 0
    while (i < n) {
        var j = 0
        while (j < i) {
            print(j)
            j = j + 1
        }
        i = i + 1
    }
}

// CHECK-LABEL: ====== Linearization @test_nested_loop(start_pc: 32, insns: 19) ======

// CHECK: 32:  data
// CHECK: 33:  load_int_imm r1, #0
// CHECK: 34:  jmp 0

// CHECK: %bb-1(while-cond):
// CHECK: 35:  int.cmplt r2, r1, r0
// CHECK: 36:  jmp_false r2, 13

// CHECK: %bb-1(while-body):
// CHECK: 37:  load_int_imm r2, #0
// CHECK: 38:  jmp 0

// CHECK: %bb-1(while-cond):
// CHECK: 39:  int.cmplt r3, r2, r1
// CHECK: 40:  jmp_false r3, 6

// CHECK: %bb-1(while-body):
// CHECK: 41:  push r2
// CHECK: 42:  call flg=1, #1
// CHECK: 43:  data
// CHECK: 44:  int.add_imm r3, r2, #1
// CHECK: 45:  move r2, r3
// CHECK: 46:  jmp -8

// CHECK: %bb-1(while-end):
// CHECK: 47:  int.add_imm r2, r1, #1
// CHECK: 48:  move r1, r2
// CHECK: 49:  jmp -15

// CHECK: %bb-1(while-end):
// CHECK: 50:  ret_void


