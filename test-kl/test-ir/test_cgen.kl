// RUN: koalac %s --cgen --dump=cgen | filecheck %s

func foo(n int) int {
    let a = 500
    let b = n + a + 1
    var c = b + 2
    c = c + 3
    return c
}

// CHECK-LABEL: ====== Linearization @foo(start_pc: 1, insns: 6) ======
// CHECK: 1:  load_int_imm r1, #500
// CHECK: 2:  int.add r0, r0, r1
// CHECK: 3:  int.add_imm r0, r0, #1
// CHECK: 4:  int.add_imm r0, r0, #2
// CHECK: 5:  int.add_imm r0, r0, #3
// CHECK: 6:  ret r0


func fib(n int) int {
    if n < 2 { return n }
    return fib(n - 1) + fib(n - 2)
}

// CHECK-LABEL: ====== Linearization @fib(start_pc: 7, insns: 13) ======
// CHECK: 7:  int.cmplt_imm r1, r0, #2
// CHECK: 8:  jmp_false r1, 1              ;; -> %bb-1(if-end)
// CHECK: 9:  ret r0
// CHECK: 10:  int.sub_imm r1, r0, #1
// CHECK: 11:  push r1
// CHECK: 12:  call flg=0, r1, #1
// CHECK: 13:  data
// CHECK: 14:  int.sub_imm r0, r0, #2
// CHECK: 15:  push r0
// CHECK: 16:  call flg=0, r0, #1
// CHECK: 17:  data
// CHECK: 18:  int.add r0, r1, r0
// CHECK: 19:  ret r0

func test_while(n int) {
    var i = 0
    while i < n {
        i = i + 1
    }
}

// CHECK-LABEL: ====== Linearization @test_while(start_pc: 20, insns: 8) ======
// CHECK: %bb-1(entry):
// CHECK: 20:  load_int_imm r1, #0
// CHECK: 21:  jmp 0                        ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-cond):
// CHECK: 22:  int.cmplt r2, r1, r0
// CHECK: 23:  jmp_false r2, 3              ;; -> %bb-1(while-end)

// CHECK: %bb-1(while-body):
// CHECK: 24:  int.add_imm r2, r1, #1
// CHECK: 25:  move r1, r2
// CHECK: 26:  jmp -5                       ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-end):
// CHECK: 27:  ret_void

func test_nested_loop(n int) {
    var i = 0
    while (i < n) {
        var j = 0
        while (j < i) {
            print(j)
            j = j + 1
        }
        i = i + 1
    }
}

// CHECK-LABEL: ====== Linearization @test_nested_loop(start_pc: 28, insns: 18) ======

// CHECK: %bb-1(entry):
// CHECK: 28:  load_int_imm r1, #0
// CHECK: 29:  jmp 0                        ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-cond):
// CHECK: 30:  int.cmplt r2, r1, r0
// CHECK: 31:  jmp_false r2, 13             ;; -> %bb-1(while-end)

// CHECK: %bb-1(while-body):
// CHECK: 32:  load_int_imm r2, #0
// CHECK: 33:  jmp 0                        ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-cond):
// CHECK: 34:  int.cmplt r3, r2, r1
// CHECK: 35:  jmp_false r3, 6              ;; -> %bb-1(while-end)

// CHECK: %bb-1(while-body):
// CHECK: 36:  push r2
// CHECK: 37:  call flg=1, #1
// CHECK: 38:  data
// CHECK: 39:  int.add_imm r3, r2, #1
// CHECK: 40:  move r2, r3
// CHECK: 41:  jmp -8                       ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-end):
// CHECK: 42:  int.add_imm r2, r1, #1
// CHECK: 43:  move r1, r2
// CHECK: 44:  jmp -15                      ;; -> %bb-1(while-cond)

// CHECK: %bb-1(while-end):
// CHECK: 45:  ret_void


