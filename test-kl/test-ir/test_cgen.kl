func bar(n int) int {
    var v = 10 < 20
    if v {
        return 1
    } else {
        return 0
    }
}

func bar2(n int) {
}


func test_add(n int) int {
    var a = 500
    var b = n + a + 1
    return b
}

// CHECK-LABEL: ====== Linearization @test_add(start_pc: 44, insns: 4) ======

// CHECK: %bb-1(entry):
// CHECK: {{[0-9]+}}:  load_int_imm r1, ti=0xb, #500
// CHECK: {{[0-9]+}}:  int.add r0, r0, r1
// CHECK: {{[0-9]+}}:  int.add_imm r0, r0, #1
// CHECK: {{[0-9]+}}:  ret r0

func test_big_int(n int) int {
    var a = 66000
    var b = n + a + 1
    var c = b + 2
    var d = c + 3
    return d
}

func test_call(n int) int {
    var v = 10 < 20
    if v {
        return test_add(66000)
    } else {
        return test_add(20)
    }
}
// CHECK-LABEL: ====== Linearization @test_call(start_pc: 55, insns: 4) ======

