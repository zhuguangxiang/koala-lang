// RUN: koalac %s --opt --dump=opt-ir | filecheck %s

let i = 10
let j = i + 1

print(i, j)

func foo() str { return "hello" }

let s = foo()

let l = [1, 2, 3]

let l2 = list(1,2,30)

let v = int(100)

let t = tuple(10, 20)

let t2 = (10, 20, 30)

var v2 = 123

print(v + 123, v2)

let list_str = list("a", "b", "c")

// CHECK-LABEL: func @__init__()
// CHECK: set_global @j int64, 11 int64
// CHECK: call @print [ext = true, path = 'std/builtin'], 10 int64, 11 int64
// CHECK: %2 = get_global @v2 int64
// CHECK: call @print [ext = true, path = 'std/builtin'], 223 int64, %2 int64
// CHECK: set_global @list_str list<u>, list['a', 'b', 'c'] list
