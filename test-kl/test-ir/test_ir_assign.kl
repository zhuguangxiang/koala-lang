// RUN: koalac %s | filecheck %s

var c = 100
c = 200
print(c)

// CHECK-LABEL: func @__init__()
// CHECK: set_global @c int64, 100 int64
// CHECK: set_global @c int64, 200 int64
// CHECK: %0 = get_global @c int64
// CHECK: call @print [ext = true, path = 'std/builtin'], %0 int64
// CHECK: ret void


func foo() {
    var x = 10
    if (c > 150) {
        x = 20
        print(x)
    } else {
        x = 30
        print(x)
    }
    print(x)
}

// CHECK-LABEL: func @foo()
// CHECK: %x = local int64
// CHECK: move %x int64, 10 int64
// CHECK: %0 = get_global @c int64
// CHECK: %1 = cmpgt %0 int64, 150 int64
// CHECK: branch %1 bool, label %bb0, label %bb1
// CHECK: move %x int64, 20 int64
// CHECK: call @print [ext = true, path = 'std/builtin'], 20 int64
// CHECK: move %x int64, 30 int64
// CHECK: call @print [ext = true, path = 'std/builtin'], 30 int64
// CHECK: call @print [ext = true, path = 'std/builtin'], %x int64
