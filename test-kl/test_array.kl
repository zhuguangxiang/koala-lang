
tuple[...](1)
tuple(1,2)

// func fn1() {
//     let a = [1, 2, 3]
//     a[0] = 10
// }

let t (...) = (1,2,3)
let t2 (...int) = (1,2,3)
let t3 (...int) = tuple([1,2,3])
let t4 (...int) = tuple((1,2,3))

class array[T, const DIMS (...int)] : Seq[T] {

    pub func __init__(args ...T) {}

    pub func foo(arg ...T) T {}
}

class tuple[...T] : Seq[T] {
    pub let length int

    pub func __init__(args ...T) {}
}

// tuple[int, int](1,2)
// tuple[int, int]([1,2])
// tuple[int, int]((1,2))

