// class array[T, const DIMS ...int] : Seq[T] {

//     @native(kl_array_init)
//     pub func __init__(args Iterable[T]) {}

//     @intrinsic
//     pub func __get_item__[infer U](index ...(int | range)) U {}

//     @intrinsic
//     pub func __set_item__(index ...(int | range), value any) {}
// }

class tuple[infer T] : Seq[T] {

    @native(kl_tuple_init)
    pub func __init__(args Iterable[T]) {}

    @intrinsic
    pub func __get_item__[infer U](index int) U {}

    @native(kl_tuple_contains)
    pub func __contains__(v T) bool {}

    @native(kl_tuple_tolist)
    pub func to_list() list[T] {}

    @native(kl_tuple_iterator)
    pub func __iter__() Iterator[T] {}

    @native(kl_tuple_length)
    pub func __len__() int {}

    @native(kl_tuple_to_str)
    pub func __str__() str {}

    @native(kl_tuple_eq)
    pub func __eq__(other any) bool {}

    @native(kl_tuple_hash)
    pub func __hash__() int {}

    @native(kl_tuple_index)
    pub func index(v T) int {}

    @native(kl_tuple_count)
    pub func count(v T) int {}
}

// @intrinsic
// pub func build_tuple[infer T](args ...) tuple[T] {}

var t tuple[int, float]
// len(t) // 调用 __len__，返回 int
let v = t.__get_item__(2) // v 的类型是 int
let v1 = t.__contains__(42) // v1 的类型是 bool
let v2 = t.to_list() // v2 的类型是 list[int]
let v3 = t.index(42) // v3 的类型是 int


var t1 tuple[int, int]
// len(t) // 调用 __len__，返回 int
let v4 = t1.__get_item__(10) // v 的类型是 int
let v5 = t1.__contains__(42) // v1 的类型是 bool
let v6 = t1.to_list() // v2 的类型是 list[int]
let v7 = t1.index(42) // v3 的类型是 int

