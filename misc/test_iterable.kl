/// An Iterator represents a position in a sequence of elements.
/// It provides a safe way to traverse collections through a check-then-act pattern.
pub trait Iterator[T] {
    /// Return True if the iteration has more elements, False otherwise.
    /// This method must be checked before every call to `__next__()`.
    func __has_next__() bool

    /// Return the next item from the iterator.
    ///
    /// PRECONDITION: `__has_next__()` must return True before calling this method.
    /// If called when `__has_next__()` is False, it will trigger an panic.
    func __next__() T
}

/// The Iterable trait is the basis for all objects that can be looped over.
/// It provides lazy functional operators for efficient data processing.
pub trait Iterable[T] {
    /// Return a new iterator object to begin a traversal of the elements.
    func __iter__() Iterator[T]

    /// Return a lazy filter object that yields items for which `f` returns True.
    ///
    /// Example:
    ///   func is_even(x int) bool = x % 2 == 0  // Named function (Assignment style)
    ///   let nums = list[int](1, 2, 3, 4)
    ///   let evens = nums.filter(is_even)       // Lazy: no computation yet
    // func filter(f func(T) bool) Iterable[T]

    /// Return a lazy map object that yields items transformed by `f`.
    ///
    /// Example with Anonymous Function:
    ///   let nums = list[int](1, 2, 3)
    ///   let doubled = nums.map(func(x int) int {
    ///       return x * 2                       // Anonymous (Block style)
    ///   })
    // func map[R](f func(T) R) Iterable[R]

    /// Eagerly reduce the elements of the iterable to a single value using `f`.
    ///
    /// Example:
    ///   let nums = list[int](1, 2, 3, 4)
    ///   let sum = nums.reduce(0, func(acc int, x int) int {
    ///       return acc + x
    ///   })
    ///   // sum = 10
    // func reduce[U](initial U, f func(U, T) U) U
}
