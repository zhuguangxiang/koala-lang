// Differential test for the baseline JIT (v1).
// Every function below uses only int64 ops on the JIT whitelist and prints a
// result, so running with KOALA_JIT=0 vs JIT-enabled must produce identical
// output.

func f_arith(a int, b int) int {
    var r = a + b
    r = r - b
    r = r * b
    r = r + a
    r = r + 10
    r = r - 3
    r = r * 2
    return r
}

func f_bitwise(a int, b int) int {
    var r = a & b
    r = r | b
    r = r ^ a
    r = r & 255
    r = r | 16
    r = r ^ 8
    return r
}

func f_divmod(a int, b int) int {
    var q = a / b
    var m = a % b
    var q2 = a / 3
    var m2 = a % 3
    return q + m + q2 + m2
}

func f_shift(a int) int {
    var r = a << 3
    r = r >> 2
    r = r << 1
    r = r >> 1
    return r
}

func f_unary(a int) int {
    var n = -a
    var t = ~a
    return n + t
}

func f_cmp(a int, b int) int {
    var c = 0
    if a < b { c = c + 1 }
    if a <= b { c = c + 2 }
    if a > b { c = c + 4 }
    if a >= b { c = c + 8 }
    if a == b { c = c + 16 }
    if a != b { c = c + 32 }
    return c
}

func f_cmpbool(a int, b int) int {
    var t1 = a < b
    var t2 = a == b
    var t3 = a >= b
    var t4 = a != 0
    var c = 0
    if t1 { c = c + 1 }
    if t2 { c = c + 2 }
    if t3 { c = c + 4 }
    if t4 { c = c + 8 }
    return c
}

func f_loop(n int) int {
    var s = 0
    var i = 0
    while i < n {
        s = s + i
        i = i + 1
    }
    return s
}

func f_logic(a int, b int) int {
    var c = 0
    if a > 0 && b > 0 { c = c + 1 }
    if a > 0 || b > 0 { c = c + 2 }
    return c
}

func f_retimm() int {
    return 12345
}

func f_retneg() int {
    return -7
}

func f_void() {
    var x = 1
    x = x + 1
}

func main() {
    print(f_arith(7, 3))
    print(f_bitwise(200, 100))
    print(f_divmod(100, 7))
    print(f_shift(5))
    print(f_unary(42))
    print(f_cmp(3, 5))
    print(f_cmp(5, 3))
    print(f_cmp(4, 4))
    print(f_cmpbool(3, 5))
    print(f_cmpbool(5, 5))
    print(f_loop(1000))
    print(f_logic(1, 2))
    print(f_logic(-1, 2))
    print(f_logic(-1, -2))
    print(f_retimm())
    print(f_retneg())
    f_void()
}