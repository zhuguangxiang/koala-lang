func main() {
    // KL 的强类型推导：T 被识别为 Bird，V 为 int
    // 假设我们有一个实现了 Seq 的具体类 BirdSquad
    if squad = get_squad().as(Seq[Bird, int]) {
        let other_squad = get_other_squad()!

        // 隐式调用 __concat__，点语法狂飙
        let total = squad.__concat__(other_squad)
        print("Total birds in formation: " + total.__str__())
    }
}
