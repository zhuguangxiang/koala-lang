import "std/sys"

let ok = 1
print(ok)

print(sys.version)
print(sys.path)

import "std/time"
print(time.now())

func test() {
    let d1 = time.Duration(1000)
    let d2 = time.Duration.from_secs(1)
    print(d1, d2)
}

let t1 = time.now()
test()
time.sleep(time.Duration.from_secs(2))
let t2 = time.now()
print("duration(ms):", t2.diff(t1).to_ms())

import "std/fs"
import "std/io"

let f = fs.open("test3.txt", "w")
sys.stdout = io.BufWriter(f)
print("hello world to file")
f.close()
print("hello world to file after close()")

sys.stdout = io.BufWriter(sys._stdout)
print("hello world to console")
