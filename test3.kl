func main() {
    let node = TensorNode(7, 0.95)

    // 3. 点模式与符号化链路
    if res = node.as(Computable)?.compute(1.1) {
        print("Result: " + res.abc())
    } else {
        print("Compute failed or type mismatch")
    }

    // 4. 强力解包抛异常 (不可捕获)
    let final_val = node.value!
}

func hello(x int | str) {
    // 1. 初始状态：x 是联合类型，只能调用 any 共有方法（如 str()）

    if x.is(int) {
        // 2. 编译器魔法：在此块内，x 自动影子化为 int
        // 你可以狂飙 int 的特有运算
        print("Got an integer: " + (x + 1).__str__())
    } else {
        // 3. 编译器推导：既然不是 int，那在 KL 的闭环逻辑里它一定是 str
        // 此时 x 影子化为 str
        print("Got a string: " + x.upper())
    }
}

