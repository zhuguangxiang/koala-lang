import "std/sys"
import "koala/wombat" as wb

const VERSION = "0.5.0"

/// `wombat` command line entry point.
pub func main() {
    let argv = sys.args()
    let code = dispatch(argv)
    if code != 0 { sys.exit(code) }
}

func dispatch(argv list[str]) int {
    let argc = len(argv)
    if argc == 0 {
        print_brief_help()
        return 0
    }

    let cmd = argv[0]

    if cmd == "help" || cmd == "-h" || cmd == "--help" {
        if argc >= 2 {
            print_command_help(argv[1])
        } else {
            print_full_help()
        }
        return 0
    }

    if cmd == "version" || cmd == "-V" || cmd == "--version" {
        print("wombat " + VERSION)
        return 0
    }

    if cmd == "new"   { return cmd_new(argv)   }
    if cmd == "build" { return cmd_build(argv) }
    if cmd == "check" { return cmd_check(argv) }
    if cmd == "run"   { return cmd_run(argv)   }
    if cmd == "test"  { return cmd_test(argv)  }
    if cmd == "fmt"   { return cmd_fmt(argv)   }
    if cmd == "doc"   { return cmd_doc(argv)   }
    if cmd == "clean" { return cmd_clean(argv) }

    printf("wombat: unknown command '{}'\n", cmd)
    print("Run `wombat help` for usage.")
    return 2
}

func print_brief_help() {
    print("wombat " + VERSION + " — build system & package manager")
    print("")
    print("Usage: wombat <command> [options]")
    print("")
    print("Common commands:")
    print("  new        Create a workspace or package")
    print("  build      Compile the current workspace or package")
    print("  check      Check without producing artifacts")
    print("  test       Run tests for the current workspace or package")
    print("  fmt        Format source code")
    print("  doc        Generate documentation")
    print("  clean      Remove build artifacts")
    print("")
    print("Run `wombat help <command>` for details.")
}

func print_full_help() {
    print_brief_help()
    print("")
    print("See also:")
    print("  wombat help <command>  Show options for one command")
    print("  wombat version         Print the wombat version")
}

func print_command_help(name str) {
    if name == "build" {
        print("Usage: wombat build [dir] [options]")
        print("")
        print("Options:")
        print("  -o, --output <dir>      Output directory (default: ./dist)")
        print("")
        print("When <dir> contains __ws__.toml the whole workspace is")
        print("built; when it contains __pkg__.toml only that package")
        print("is built. <dir> defaults to the current directory.")
        return
    }

    if name == "test" {
        print("Usage: wombat test [dir]")
        print("")
        print("When <dir> contains __ws__.toml every package is tested;")
        print("when it contains __pkg__.toml only that package is tested.")
        print("<dir> defaults to the current directory.")
        return
    }

    if name == "new" {
        print("Usage: wombat new <name>")
        print("")
        print("Creates a workspace when the current directory has no")
        print("__ws__.toml, otherwise creates a package inside it.")
        return
    }

    if name == "check" {
        print("Usage: wombat check [dir]")
        print("")
        print("Parses and type-checks without producing artifacts.")
        return
    }

    if name == "fmt" {
        print("Usage: wombat fmt [dir]")
        print("")
        print("Formats every `.kl` file in the workspace or package.")
        return
    }

    if name == "doc" {
        print("Usage: wombat doc [dir]")
        print("")
        print("Generates documentation for the workspace or package.")
        return
    }

    if name == "clean" {
        print("Usage: wombat clean [dir]")
        print("")
        print("Removes the output directory (default: ./dist).")
        return
    }

    print_full_help()
}

/// Options shared by `build` and `test`.
class BuildOptions {
    var path = "."
    var output = "./dist"
}

/// Parse `[dir]` and, when `allow_output` is true, `-o/--output`.
///
/// `argv[0]` is the subcommand name and is skipped. Unknown options
/// are reported instead of being silently ignored.
func parse_build_options(argv list[str], opts BuildOptions, allow_output bool) str {
    var idx = 0
    var pending = ""
    var err = ""

    for a in argv {
        idx += 1
        if idx == 1 { continue }

        if pending != "" {
            if pending == "-o" { opts.output = a }
            pending = ""
            continue
        }

        if a == "-o" || a == "--output" {
            if !allow_output {
                if err.empty() {
                    err = "unknown option '" + a + "'"
                }
            } else {
                pending = "-o"
            }
        } else if a.starts_with("-") && a.len() > 1 {
            if err.empty() {
                err = "unknown option '" + a + "'"
            }
        } else {
            opts.path = a
        }
    }

    if !err.empty() { return err }

    if pending != "" {
        return pending + " requires a value"
    }
    return ""
}

/// `wombat build [dir] [-o DIR]`
func cmd_build(argv list[str]) int {
    let opts = BuildOptions()
    let err = parse_build_options(argv, opts, true)
    if !err.empty() {
        printf("wombat build: {}\n", err)
        return 2
    }
    return wb.build_all(opts.path, opts.output)
}

/// `wombat test [dir]`
func cmd_test(argv list[str]) int {
    let opts = BuildOptions()
    let err = parse_build_options(argv, opts, false)
    if !err.empty() {
        printf("wombat test: {}\n", err)
        return 2
    }
    return wb.test_all(opts.path)
}

/// `wombat new <name>`
func cmd_new(argv list[str]) int {
    let argc = len(argv)

    if argc < 2 {
        print("wombat new: missing name")
        print("Usage: wombat new <name>")
        return 2
    }

    if argc > 2 {
        printf("wombat new: unexpected argument '{}'\n", argv[2])
        return 2
    }

    return wb.new_auto(argv[1])
}

