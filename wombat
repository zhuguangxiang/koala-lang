/// `wombat` command line entry point.
///
/// The CLI is deliberately thin: it parses argv, prints user-facing
/// diagnostics, and dispatches to one handler per subcommand. All real
/// work lives in the library packages so that IDEs and CI can call the
/// same code without spawning a process.
///
/// Exit codes: 0 success, 1 build/runtime failure, 2 usage error.
pub func main() {
    let argv = sys.args()
    let code = dispatch(argv)
    if code != 0 { sys.exit(code) }
}

/// Route the first user argument to its handler.
///
/// `argv` is the argument list *after* the program name, i.e.
/// `wombat build -p core` arrives as ["build", "-p", "core"] and bare
/// `wombat` arrives as []. If `sys.args()` ever includes the program
/// name, only this function and the option index in
/// `parse_build_options` / `cmd_new` need to shift.
func dispatch(argv list[str]) int {
    // Bare `wombat` prints short help and exits 0, matching cargo.
    // No side effects: never trigger a build by accident.
    if argv.len() == 0 {
        print_brief_help()
        return 0
    }

    let cmd = argv[0]

    if cmd == "help" || cmd == "-h" || cmd == "--help" {
        if argv.len() >= 2 {
            print_command_help(argv[1])
        } else {
            print_full_help()
        }
        return 0
    }

    if cmd == "version" || cmd == "-V" || cmd == "--version" {
        print("wombat 0.1.0")
        return 0
    }

    if cmd == "new"   { return cmd_new(argv)   }
    if cmd == "build" { return cmd_build(argv) }
    if cmd == "check" { return cmd_check(argv) }
    if cmd == "run"   { return cmd_run(argv)   }
    if cmd == "test"  { return cmd_test(argv)  }
    if cmd == "fmt"   { return cmd_fmt(argv)   }
    if cmd == "lint"  { return cmd_lint(argv)  }
    if cmd == "doc"   { return cmd_doc(argv)   }
    if cmd == "add"   { return cmd_add(argv)   }
    if cmd == "clean" { return cmd_clean(argv) }

    print("wombat: unknown command '" + cmd + "'")
    print("Run `wombat help` for usage.")
    return 2
}

/// Print the short help shown for bare `wombat`.
///
/// Kept short on purpose: the first screen must fit a typical terminal.
/// Once `workspace` is wired in, this should also print the detected
/// members and default-members below the command list.
func print_brief_help() {
    print("wombat 0.1.0 — build system & package manager")
    print("")
    print("Usage: wombat <command> [options]")
    print("")
    print("Common commands:")
    print("  new        Create a new package or workspace")
    print("  build      Compile the current package")
    print("  check      Check without producing binaries (fast)")
    print("  run        Build and run")
    print("  test       Run tests")
    print("  fmt        Format source code")
    print("  lint       Static analysis")
    print("  doc        Generate documentation")
    print("  add        Add a dependency")
    print("  clean      Remove build artifacts")
    print("")
    print("Run `wombat help <command>` for details.")
}

/// Print the full command list, shown by `wombat help`.
func print_full_help() {
    print_brief_help()
    print("")
    print("See also:")
    print("  wombat help <command>  Show options for one command")
    print("  wombat version         Print the wombat version")
}

/// Print per-command help. Fallback to the full help on unknown names.
func print_command_help(name str) {
    if name == "build" || name == "check" {
        print("Usage: wombat " + name + " [options]")
        print("")
        print("Options:")
        print("  -p, --package <name>    Select one package in the workspace")
        print("      --workspace         Build every workspace member")
        print("      --target <triple>   Cross-compile for a target triple")
        print("  -j, --jobs <n>          Parallel build jobs (0 = auto)")
        print("      --release           Build with the release profile")
        print("      --all-targets       Also build tests and benches")
        print("      --src <dir>         Workspace root (default: .)")
        print("  -o, --output <dir>      Output directory (default: ./dist)")
        return
    }

    if name == "test" {
        print("Usage: wombat test [options]")
        print("")
        print("Options:")
        print("  -p, --package <name>    Select one package in the workspace")
        print("      --workspace         Test every workspace member")
        print("      --src <dir>         Workspace root (default: .)")
        print("")
        print("Run `wombat build` first to refresh the `.klc` artifacts")
        print("that tests import.")
        return
    }

    if name == "new" {
        print("Usage: wombat new <package|workspace> <name> [options]")
        print("")
        print("Options:")
        print("      --lib               Create a library package")
        print("      --path <dir>        Place the package in <dir>")
        print("      --vcs <kind>        git (default) or none")
        print("      --edition <year>    Set the package edition")
        return
    }

    print_full_help()
}

/// Options shared by the build-family commands.
class BuildOptions {
    var release = false
    var workspace = false
    var all_targets = false
    var package = ""
    var target = ""
    var jobs = 0
    var path = "."
    var output = "./dist"
}

/// `wombat build [--src DIR] [-o DIR] [--release] [-p PKG] [--workspace]`
func cmd_build(argv list[str]) int {
    let opts = BuildOptions()
    let err = parse_build_options(argv, opts)
    if !err.empty() {
        print("wombat build: " + err)
        return 2
    }
    return wb.build_all(opts.path, opts.output)
}

