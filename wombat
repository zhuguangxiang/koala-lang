/// `wombat test [--src DIR] [-p PKG] [--workspace]`
///
/// Does not build. Run `wombat build` first so the `.klc` artifacts
/// that tests import are up to date on `KOALA_PATH`.
func cmd_test(argv list[str]) int {
    let opts = BuildOptions()
    let err = parse_build_options(argv, opts)
    if !err.empty() {
        print("wombat test: " + err)
        return 2
    }
    return wt.test_all(opts.path)
}

/// Parse build-family options starting at argv[1].
///
/// Iterates with `for ... in` instead of `argv.len()` + `argv[i]`.
/// On some runtimes `len()` reports the underlying capacity rather
/// than the number of iterable elements, which caused
/// `list index out of range` on `wombat build` (no options).
///
/// Options that take a value (`-p`, `--target`, `-j`, `-o`, `--src`)
/// set `pending` and consume the next element on the following
/// iteration.
func parse_build_options(argv list[str], opts BuildOptions) str {
    var idx = 0
    var pending = ""
    var err = ""

    for a in argv {
        idx += 1
        // Skip argv[0], the subcommand name itself.
        if idx == 1 {
            continue
        }

        // Consume the value of the previous option.
        if pending != "" {
            if pending == "-p" {
                opts.package = a
            } else if pending == "--target" {
                opts.target = a
            } else if pending == "-j" {
                opts.jobs = a.to_int()
            } else if pending == "-o" {
                opts.output = a
            } else if pending == "--src" {
                opts.path = a
            }
            pending = ""
            continue
        }

        if a == "--release" {
            opts.release = true
        } else if a == "--workspace" {
            opts.workspace = true
        } else if a == "--all-targets" {
            opts.all_targets = true
        } else if a == "-p" || a == "--package" {
            pending = "-p"
        } else if a == "--target" {
            pending = "--target"
        } else if a == "-j" || a == "--jobs" {
            pending = "-j"
        } else if a == "-o" || a == "--output" {
            pending = "-o"
        } else if a == "--src" {
            pending = "--src"
        } else if a.starts_with("-") && a.len() > 1 {
            if err.empty() {
                err = "unknown option '" + a + "'"
            }
        } else {
            opts.path = a
        }
    }

    if !err.empty() {
        return err
    }
    if pending != "" {
        return pending + " requires a value"
    }
    return ""
}

/// Options for `wombat new`.
class NewOptions {
    var path = ""
    var lib = false
    var workspace = false
    var vcs = "git"
    var edition = ""
}

/// `wombat new <package|workspace> <name> [options]`
func cmd_new(argv list[str]) int {
    if argv.len() < 2 {
        print("wombat new: missing kind or name")
        print("Usage: wombat new <package|workspace> <name>")
        return 2
    }

    let kind = argv[1]
    if kind != "package" && kind != "workspace" {
        print("wombat new: expected 'package' or 'workspace', got '" + kind + "'")
        return 2
    }

    if argv.len() < 3 {
        print("wombat new " + kind + ": missing name")
        return 2
    }

    let name = argv[2]
    let opts = NewOptions()
    opts.workspace = (kind == "workspace")

    var i = 3
    while i < argv.len() {
        let a = argv[i]
        if a == "--lib" {
            opts.lib = true
        } else if a == "--path" {
            i += 1
            if i >= argv.len() {
                print("wombat new: --path requires a directory")
                return 2
            }
            opts.path = argv[i]
        } else if a == "--vcs" {
            i += 1
            if i >= argv.len() {
                print("wombat new: --vcs requires a value")
                return 2
            }
            opts.vcs = argv[i]
        } else if a == "--edition" {
            i += 1
            if i >= argv.len() {
                print("wombat new: --edition requires a value")
                return 2
            }
            opts.edition = argv[i]
        } else if a.starts_with("-") {
            print("wombat new: unknown option '" + a + "'")
            return 2
        } else {
            print("wombat new: unexpected argument '" + a + "'")
            return 2
        }
        i += 1
    }

    // return scaffold.new_project(name, opts)
    return 0
}

