/*!
The 'io' module of koala standard library
This module includes 'io' related variables and functions.
*/

public trait AutoClosable {
    public func close()
}

public trait Writer : AutoClosable {
    public func write(bs bytes) int

    @native(kl_write_str)
    public func write_str(s str) int {}

    public func flush()
}

public trait Reader : AutoClosable {
    public func read(bs bytes, sz int = -1) int
}

public trait Seeker {
    public func seek() int
}

public class BufferedReader : Reader & Seeker & Iterable[bytes] {

    @native(kl_new_buf_reader)
    public static func __new__(r Reader) BufferedReader {}

    @native(kl_buf_read_until)
    public func read_until(sep int) bytes {}

    @native(kl_buf_read_line)
    public func read_line() bytes? {}

    public func read(bs bytes, sz int = -1) int {}

    public func read_byte() int {}

    public func skip(n int) int {}

    @native(kl_buf_iter)
    public func __iter__() Iterator[bytes] {}

    @native(kl_buf_seek)
    public func seek() int {}

    @native(kl_buf_close)
    public func close() {}
}

public class BufferedWriter : Writer & Seeker {

    @native(kl_new_buf_writer)
    public static func __new__(r Writer) BufferedWriter {}

    @native(kl_buf_write)
    public func write(bs bytes) int {}

    @native(kl_buf_seek)
    public func seek() int {}

    @native(kl_buf_flush)
    public func flush() {}

    @native(kl_buf_close)
    public func close() {}
}

public class File : Reader & Writer & Seeker {

    @native(io_new_file)
    public static func __new__(path_or_fd str | int) File? {}

    @native(kl_file_read)
    public func read(bs bytes, sz int = -1) int {}

    @native(kl_file_write)
    public func write(bs bytes) int {}

    @native(kl_file_seek) {}
    public func seek() int

    @native(kl_file_flush)
    public func flush() {}

    @native(kl_file_close)
    public func close() {}
}

class StringReader : Reader {
    public static func __new__(s str) StringReader {}
    public func read(bs bytes, sz int = -1) int {}
}

class BytesReader : Reader {
    public static func __new__(bs bytes) BytesReader {}
    public func read(bs bytes, sz int = -1) int {}
}

class BytesWriter : Writer {
    public static func __new__(bs bytes) BytesWriter {}
    public func write(bs bytes) int {}
    public func flush()
}
