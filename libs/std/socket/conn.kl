/// Connected socket trait and its three implementations.
///
/// `Conn` is the uniform contract for every connected socket. It
/// inherits `read` from `io.Reader` and `write` / `write_str` /
/// `flush` from `io.Writer`. The I/O trait contracts apply: `read`
/// returns 0 on EOF, `write` returns the byte count (a short write
/// is a failure), and a closed or broken descriptor panics.
///
/// The semantics of `read` / `write` depend on `socket_type()`. TCP's
/// `write` loops until every byte is written; UDP and raw `write` one
/// complete datagram. Every I/O method loops on EINTR and treats any
/// other failure as fatal. The blocking sockets this package creates
/// never return EAGAIN, so the loop only needs the EINTR retry; a
/// coroutine-backed socket would surface EAGAIN as IO_WOULDBLOCK, and
/// the suspension hook would go on that branch.
///
/// `read_exact` and `read_to_end` are declared as pure virtuals on the
/// trait and implemented in each concrete class: Koala traits do not
/// support default method bodies. When they do, the bodies move up to
/// `Conn` and the per-class duplication goes away.
///
/// The Koala side never sees errno. Every sys_* failure is translated
/// to an IO_* status inside the VM; `_last_io_status()` reads the
/// current one, and `_take_io_error()` reads and clears the pending
/// SO_ERROR. The `IO_*` constants come from `result.kl`.

import "std/io"

/// Uniform contract for connected sockets.
pub trait Conn : io.Reader & io.Writer & io.Closable {
    /// Local address of the socket.
    func local_addr() SocketAddr

    /// Remote address of the socket.
    func remote_addr() SocketAddr

    /// Transport kind; one of the `SOCKTYPE_*` constants.
    func socket_type() int

    /// Set read timeout in milliseconds. 0 clears it.
    func set_read_timeout(ms int) bool

    /// Set write timeout in milliseconds. 0 clears it.
    func set_write_timeout(ms int) bool

    /// Switch between blocking and non-blocking mode.
    func set_blocking(blocking bool) bool

    /// Fetch and clear the pending socket error (SO_ERROR).
    ///
    /// Returns nil when there is no pending error.
    func take_error() int?

    /// Read exactly `n` bytes. Returns nil on EOF or short read.
    func read_exact(n int) bytes?

    /// Read until EOF and return everything.
    func read_to_end() bytes?
}

/// An established TCP connection.
///
/// Use `conn as TcpConn` to reach the TCP-specific options
/// (`set_nodelay`, `set_keepalive`, `shutdown_write`, `peek`, ...).
pub class TcpConn : Conn {
    let _fd int
    var _local SocketAddr? = nil
    var _remote SocketAddr? = nil

    /// Wrap a file descriptor.
    ///
    /// Prefer `dial` or `Listener.accept()` over calling this directly.
    func __init__(fd int) { _fd = fd }

    pub func local_addr() SocketAddr {
        if _local == nil { _local = _getsockname(_fd) }
        return _local!
    }

    pub func remote_addr() SocketAddr {
        if _remote == nil {
            let peer = _getpeername(_fd) else { return _zero_addr() }
            _remote = peer
        }
        return _remote!
    }

    pub func socket_type() int { return SOCKTYPE_TCP }

    pub func read(bs bytes) int {
        loop {
            let r = sys_recv(_fd, bs, 0)
            if r >= 0 { return r }
            if _last_io_status() == IO_INTERRUPTED { continue }
            panic("TcpConn.read: syscall failed")
        }
    }

    pub func write(bs bytes) int {
        let n = bs.len()
        var total = 0
        while total < n {
            let r = sys_send(_fd, bs[total:n], 0)
            if r > 0 {
                total += r
                continue
            }
            if _last_io_status() == IO_INTERRUPTED { continue }
            panic("TcpConn.write: syscall failed")
        }
        return total
    }

    pub func write_str(s str) int { return write(s.to_bytes()) }

    pub func flush() {}

    pub func close() { _close(_fd) }

    pub func set_read_timeout(ms int) bool { return _set_read_timeout(_fd, ms) }

    pub func set_write_timeout(ms int) bool { return _set_write_timeout(_fd, ms) }

    pub func set_blocking(blocking bool) bool { return _set_blocking(_fd, blocking) }

    pub func take_error() int? { return _take_io_error(_fd) }

    /// Read exactly `n` bytes. Returns nil on EOF or short read.
    pub func read_exact(n int) bytes? {
        let scratch = bytes(n)
        var got = 0
        while got < n {
            let r = read(scratch[got:n])
            if r == 0 { return nil }
            got += r
        }
        return scratch
    }

    /// Read until EOF and return everything.
    pub func read_to_end() bytes? {
        let buf = Buffer(4096)
        let scratch = bytes(4096)
        loop {
            let r = read(scratch)
            if r == 0 { return buf.to_bytes() }
            buf.write(scratch[0:r])
        }
    }

    /// Enable or disable TCP_NODELAY.
    pub func set_nodelay(on bool) bool {
        return sys_setsockopt_int(_fd, IP_PROTO_TCP, TCP_NODELAY, on.to_int()) == 0
    }

    /// Query the current TCP_NODELAY setting.
    pub func nodelay() bool? {
        let v = sys_getsockopt_int(_fd, IP_PROTO_TCP, TCP_NODELAY)
        if v < 0 { return nil }
        return v != 0
    }

    /// Enable or disable TCP keepalive.
    pub func set_keepalive(on bool) bool {
        return sys_setsockopt_int(_fd, SOL_SOCKET, SO_KEEPALIVE, on.to_int()) == 0
    }

    /// Set the keepalive idle interval in seconds.
    pub func set_keepalive_period(seconds int) bool {
        return sys_setsockopt_int(_fd, IP_PROTO_TCP, TCP_KEEPIDLE, seconds) == 0
    }

    /// Set the IP time-to-live of outgoing packets.
    pub func set_ttl(ttl int) bool {
        return sys_setsockopt_int(_fd, IP_PROTO_IP, IP_TTL, ttl) == 0
    }

    /// Half-close the write side.
    pub func shutdown_write() bool { return sys_shutdown(_fd, SHUT_WR) == 0 }

    /// Half-close the read side.
    pub func shutdown_read() bool { return sys_shutdown(_fd, SHUT_RD) == 0 }

    /// Peek at the next bytes without consuming them.
    ///
    /// Returns the number of bytes peeked, 0 if the peer has closed, or
    /// -1 on error. Unlike `read`, a failure does not panic: peeking is
    /// a best-effort operation and the caller decides whether to retry.
    pub func peek(bs bytes) int {
        return sys_recv(_fd, bs, MSG_PEEK)
    }
}

/// A UDP socket.
///
/// Before `connect()` it is used through `recv_from` / `send_to`;
/// after `connect()` it also supports `read` / `write` against the
/// default peer.
pub class UdpConn : Conn {
    let _fd int
    var _local SocketAddr? = nil
    var _remote SocketAddr? = nil

    /// Wrap a file descriptor.
    ///
    /// Prefer `dial` or `listen_packet` over calling this directly.
    func __init__(fd int) { _fd = fd }

    pub func local_addr() SocketAddr {
        if _local == nil { _local = _getsockname(_fd) }
        return _local!
    }

    pub func remote_addr() SocketAddr {
        if _remote == nil {
            let peer = _getpeername(_fd) else { return _zero_addr() }
            _remote = peer
        }
        return _remote!
    }

    pub func socket_type() int { return SOCKTYPE_UDP }

    pub func read(bs bytes) int {
        loop {
            let r = sys_recv(_fd, bs, 0)
            if r >= 0 { return r }
            if _last_io_status() == IO_INTERRUPTED { continue }
            panic("UdpConn.read: syscall failed")
        }
    }

    pub func write(bs bytes) int {
        let r = sys_send(_fd, bs, 0)
        if r > 0 { return r }
        panic("UdpConn.write: syscall failed")
    }

    pub func write_str(s str) int { return write(s.to_bytes()) }

    pub func flush() {}

    pub func close() { _close(_fd) }

    pub func set_read_timeout(ms int) bool { return _set_read_timeout(_fd, ms) }

    pub func set_write_timeout(ms int) bool { return _set_write_timeout(_fd, ms) }

    pub func set_blocking(blocking bool) bool { return _set_blocking(_fd, blocking) }

    pub func take_error() int? { return _take_io_error(_fd) }

    /// Read exactly `n` bytes. Returns nil on EOF or short read.
    pub func read_exact(n int) bytes? {
        let scratch = bytes(n)
        var got = 0
        while got < n {
            let r = read(scratch[got:n])
            if r == 0 { return nil }
            got += r
        }
        return scratch
    }

    /// Read until EOF and return everything.
    pub func read_to_end() bytes? {
        let buf = Buffer(4096)
        let scratch = bytes(4096)
        loop {
            let r = read(scratch)
            if r == 0 { return buf.to_bytes() }
            buf.write(scratch[0:r])
        }
    }

    /// Receive one datagram into `buf`.
    ///
    /// `buf` is a writable `bytes` that must be large enough to hold the
    /// incoming datagram; a datagram longer than `buf` is truncated.
    /// `bytes(65535)` covers every possible UDP datagram. On success the
    /// first `RecvFromResult.n()` bytes of `buf` hold this datagram —
    /// anything after that is leftover from a previous call and must be
    /// ignored. On failure `buf` is left unchanged. The caller supplies
    /// the buffer so that a server loop can reuse one allocation across
    /// packets.
    pub func recv_from(buf bytes) RecvFromResult {
        let (n, peer) = sys_recvfrom(_fd, buf, 0)
        if n >= 0 { return RecvFromResult(IO_OK, n, peer, "") }
        return RecvFromResult(_last_io_status(), 0, nil, "")
    }

    /// Peek at the next datagram without consuming it.
    ///
    /// The datagram stays in the kernel queue and will be returned again
    /// by the next `recv_from`. The same buffer-size rules as `recv_from`
    /// apply: `buf` must be large enough for the datagram, and only the
    /// first `RecvFromResult.n()` bytes are meaningful.
    pub func peek_from(buf bytes) RecvFromResult {
        let (n, peer) = sys_recvfrom(_fd, buf, MSG_PEEK)
        if n >= 0 { return RecvFromResult(IO_OK, n, peer, "") }
        return RecvFromResult(_last_io_status(), 0, nil, "")
    }

    /// Send one datagram to `addr`.
    pub func send_to(bs bytes, addr SocketAddr) SendResult {
        let r = sys_sendto(_fd, bs, addr, 0)
        if r >= 0 { return SendResult(IO_OK, r, "") }
        return SendResult(_last_io_status(), 0, "")
    }

    /// Set the default peer.
    ///
    /// Afterwards, `read` / `write` operate on it without an explicit
    /// address.
    pub func connect(addr SocketAddr) bool {
        if sys_connect(_fd, addr) != 0 { return false }
        _remote = addr
        return true
    }

    /// Enable or disable sending to broadcast addresses.
    pub func set_broadcast(on bool) bool {
        return sys_setsockopt_int(_fd, SOL_SOCKET, SO_BROADCAST, on.to_int()) == 0
    }

    /// Set the IP time-to-live of outgoing packets.
    pub func set_ttl(ttl int) bool {
        return sys_setsockopt_int(_fd, IP_PROTO_IP, IP_TTL, ttl) == 0
    }
}

/// A raw IP socket.
///
/// `send_to` takes an `IpAddr` because raw sockets have no ports.
/// `recv_payload` strips the IP header; `recv_raw` keeps it.
pub class RawConn : Conn {
    let _fd int
    let _proto int
    var _local SocketAddr? = nil

    /// Wrap a file descriptor.
    ///
    /// Prefer `dial` over calling this directly.
    func __init__(fd int, proto int) {
        _fd = fd
        _proto = proto
    }

    pub func local_addr() SocketAddr {
        if _local == nil { _local = _getsockname(_fd) }
        return _local!
    }

    /// Raw sockets have no fixed peer; this always returns 0.0.0.0:0.
    pub func remote_addr() SocketAddr { return _zero_addr() }

    pub func socket_type() int { return SOCKTYPE_RAW }

    pub func read(bs bytes) int {
        loop {
            let r = sys_recv(_fd, bs, 0)
            if r >= 0 { return r }
            if _last_io_status() == IO_INTERRUPTED { continue }
            panic("RawConn.read: syscall failed")
        }
    }

    pub func write(bs bytes) int {
        // `write` has no well-defined meaning for raw sockets; use
        // `send_to`. Panicking here makes the misuse visible at once
        // instead of silently dropping data.
        panic("RawConn.write: use send_to")
    }

    pub func write_str(s str) int { panic("RawConn.write_str: use send_to") }

    pub func flush() {}

    pub func close() { _close(_fd) }

    pub func set_read_timeout(ms int) bool { return _set_read_timeout(_fd, ms) }

    pub func set_write_timeout(ms int) bool { return _set_write_timeout(_fd, ms) }

    pub func set_blocking(blocking bool) bool { return _set_blocking(_fd, blocking) }

    pub func take_error() int? { return _take_io_error(_fd) }

    /// Read exactly `n` bytes. Returns nil on EOF or short read.
    pub func read_exact(n int) bytes? {
        let scratch = bytes(n)
        var got = 0
        while got < n {
            let r = read(scratch[got:n])
            if r == 0 { return nil }
            got += r
        }
        return scratch
    }

    /// Read until EOF and return everything.
    pub func read_to_end() bytes? {
        let buf = Buffer(4096)
        let scratch = bytes(4096)
        loop {
            let r = read(scratch)
            if r == 0 { return buf.to_bytes() }
            buf.write(scratch[0:r])
        }
    }

    /// Send a raw packet to `ip`.
    pub func send_to(bs bytes, ip IpAddr) int? {
        let r = _send_to_ip_from(_fd, bs, ip)
        if r >= 0 { return r }
        return nil
    }

    /// Receive a raw packet into `buf`, stripping the IP header.
    ///
    /// `buf` must be large enough for the packet including the IP header
    /// (which is removed before returning). `bytes(65535)` covers every
    /// possible IPv4 packet. On success the first `RecvPayloadResult.n()`
    /// bytes of `buf` hold the payload — anything after that is leftover
    /// from a previous call. On failure `buf` is left unchanged.
    pub func recv_payload(buf bytes) RecvPayloadResult {
        let (n, addr) = _recv_payload_into(_fd, buf, 1)
        if n >= 0 { return RecvPayloadResult(IO_OK, n, addr, "") }
        return RecvPayloadResult(_last_io_status(), 0, nil, "")
    }

    /// Receive a raw packet into `buf`, keeping the IP header.
    ///
    /// Same buffer-size rules as `recv_payload`; the difference is that
    /// the IP header stays in `buf`, so `RecvPayloadResult.n()` is the
    /// full packet length.
    pub func recv_raw(buf bytes) RecvPayloadResult {
        let (n, addr) = _recv_payload_into(_fd, buf, 0)
        if n >= 0 { return RecvPayloadResult(IO_OK, n, addr, "") }
        return RecvPayloadResult(_last_io_status(), 0, nil, "")
    }

    /// Set the IP time-to-live of outgoing packets.
    pub func set_ttl(ttl int) bool {
        return sys_setsockopt_int(_fd, IP_PROTO_IP, IP_TTL, ttl) == 0
    }

    /// Set the SO_RCVBUF size in bytes.
    pub func set_recv_buffer_size(n int) bool {
        return sys_setsockopt_int(_fd, SOL_SOCKET, SO_RCVBUF, n) == 0
    }

    /// Set the SO_SNDBUF size in bytes.
    pub func set_send_buffer_size(n int) bool {
        return sys_setsockopt_int(_fd, SOL_SOCKET, SO_SNDBUF, n) == 0
    }
}

// Close `fd`. Negative descriptors are ignored so that a second call
// to close() is harmless.
func _close(fd int) {
    if fd >= 0 { sys_close(fd) }
}

// Set or clear the O_NONBLOCK flag on `fd`.
func _set_blocking(fd int, blocking bool) bool {
    let flags = sys_fcntl(fd, F_GETFL, 0)
    if flags < 0 { return false }
    if blocking { return sys_fcntl(fd, F_SETFL, flags & ~O_NONBLOCK) >= 0 }
    return sys_fcntl(fd, F_SETFL, flags | O_NONBLOCK) >= 0
}

// Set SO_RCVTIMEO to `ms` milliseconds. 0 clears it.
func _set_read_timeout(fd int, ms int) bool {
    return sys_setsockopt_timeout(fd, SO_RCVTIMEO, ms) == 0
}

// Set SO_SNDTIMEO to `ms` milliseconds. 0 clears it.
func _set_write_timeout(fd int, ms int) bool {
    return sys_setsockopt_timeout(fd, SO_SNDTIMEO, ms) == 0
}

// Return a 0.0.0.0:0 address, used where a socket has no meaningful
// local or remote address (raw sockets, unconnected UDP).
func _zero_addr() SocketAddr {
    return SocketAddr(IpAddr.from_v4(Ipv4Addr(bytes(4))), 0)
}

//
// Native functions
//
// The declarations below are the FFI boundary for this file. Each one
// is provided by the VM; the call shapes are chosen so that every
// parameter and return value is a Koala type. Pointer arithmetic and
// sockaddr encoding stay entirely inside the VM.
//

/// Receive into `bs`. On success returns the number of bytes received
/// (0 on EOF); returns -1 on error.
@native
func sys_recv(fd int, bs bytes, flags int) int {}

/// Send `bs`. Returns the number of bytes accepted by the kernel, or
/// -1 on error.
@native
func sys_send(fd int, bs bytes, flags int) int {}

/// Receive a datagram into `bs`. The kernel fills the first `n` bytes
/// of `bs`; the caller reads them back as `bs[0:n]`. Returns the byte
/// count and the source address, or -1 and nil on error.
@native
func sys_recvfrom(fd int, bs bytes, flags int) (int, SocketAddr?) {}

/// Send a datagram to a specific address.
@native
func sys_sendto(fd int, bs bytes, addr SocketAddr, flags int) int {}

/// Connect a socket to a remote address. Returns 0 on success, -1 on
/// error.
@native
func sys_connect(fd int, addr SocketAddr) int {}

/// Close a file descriptor. Returns 0 on success.
@native
func sys_close(fd int) int {}

/// Manipulate file descriptor flags. Returns the old or new flag
/// value, or -1 on error.
@native
func sys_fcntl(fd int, cmd int, arg int) int {}

/// Shut down part of a full-duplex connection. Returns 0 on success.
@native
func sys_shutdown(fd int, how int) int {}

/// Set an integer-valued socket option. Returns 0 on success.
@native
func sys_setsockopt_int(fd int, level int, name int, val int) int {}

/// Set a millisecond timeout option (SO_RCVTIMEO / SO_SNDTIMEO).
/// Returns 0 on success.
@native
func sys_setsockopt_timeout(fd int, name int, ms int) int {}

/// Get an integer-valued socket option. Returns the value, or -1 on
/// error.
@native
func sys_getsockopt_int(fd int, level int, name int) int {}

/// Return the local address of `fd`.
@native
func _getsockname(fd int) SocketAddr {}

/// Return the peer address of `fd`, or nil if it has none.
@native
func _getpeername(fd int) SocketAddr? {}

/// Send a raw packet to `ip`.
@native
func _send_to_ip_from(fd int, bs bytes, ip IpAddr) int {}

/// Receive a raw packet into `bs`. `strip` = 1 drops the IP header
/// in place with memmove; `strip` = 0 keeps it. Returns the payload
/// length (after stripping, if requested) and the source address, or
/// -1 and nil on error.
@native
func _recv_payload_into(fd int, bs bytes, strip int) (int, IpAddr?) {}

/// Return the `IO_*` status corresponding to the last system-call
/// failure.
///
/// Called immediately after a `sys_*` function returns a negative
/// value, before any other system call can overwrite errno. The VM
/// owns the platform-specific errno table, so Koala code never sees
/// errno values directly.
@native
func _last_io_status() int {}

/// Read and clear the pending socket error (SO_ERROR), mapped to an
/// `IO_*` status.
///
/// Returns nil when there is no pending error, or when the query
/// itself failed.
@native
func _take_io_error(fd int) int? {}
