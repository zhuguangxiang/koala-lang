//
// Name-based tests
//
// These reach /etc/hosts or a live resolver. They are kept in a
// separate section so they can be excluded together in environments
// without network access.
//

@test
func test_resolve_localhost() {
    // localhost is present in /etc/hosts on essentially every Linux
    // system, so this does not need a working DNS resolver.
    let r = so.resolve("localhost")
    let addrs = r.addrs()
    ut.assert_eq(r.status(), so.DNS_OK)
    ut.assert_true(len(addrs) > 0)

    // Every returned address must be a loopback address.
    for ip in addrs {
        ut.assert_true(ip.is_loopback())
    }
}

@test
func test_resolve_localhost_v4() {
    let r = so.resolve("127.0.0.1")
    let addrs = r.addrs()
    ut.assert_eq(r.status(), so.DNS_OK)
    ut.assert_eq(len(addrs), 1)
    ut.assert_eq(addrs[0].to_str(), "127.0.0.1")
}
