@test
func test_resolve_baidu() {
    let r = so.resolve("baidu.com")
    let addrs = r.addrs()
    // print(addrs)
    ut.assert_eq(r.status(), so.DNS_OK)
    ut.assert_true(len(addrs) > 0)

    // Whatever the address is, it must survive a round trip through
    // to_str / parse.
    for ip in addrs {
        let text = ip.to_str()
        let back = so.IpAddr.parse(text)
        ut.assert_true(back != nil)
        ut.assert_true(back! == ip)
    }
}

@test
func test_resolve_localhost_via_hosts() {
    // localhost is in /etc/hosts on essentially every Linux system,
    // so this does not depend on a resolver, but it exercises the
    // getaddrinfo path end to end.
    let r = so.resolve("localhost")
    let addrs = r.addrs()
    ut.assert_eq(r.status(), so.DNS_OK)
    ut.assert_true(len(addrs) > 0)
    for ip in addrs {
        ut.assert_true(ip.is_loopback())
    }
}

