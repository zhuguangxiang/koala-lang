/// Top-level entry points for `std/socket`.
///
/// Four entry points:
///
///   - `dial(url, spec, options?)`      — TCP / UDP / Raw unified client
///   - `listen(url, options?)`          — TCP server
///   - `listen_packet(url, options?)`   — UDP server
///   - `resolve(host)`                  — DNS resolution
///

link "koala"

import "std/os"

/// Connect to the remote specified by `url`.
///
/// `url` accepts "host:port" or "[v6]:port"; domain names are resolved
/// internally. `spec` selects the transport:
///
///   - `SocketTypeSpec.tcp()`:       full handshake, returns `TcpConn`
///   - `SocketTypeSpec.udp()`:       bind an ephemeral port and set peer
///   - `SocketTypeSpec.raw(proto)`:  open a raw socket; url port must be 0
///
/// Returns nil on any failure: bad url, DNS failure, socket creation
/// failure, bind failure, or connect failure.
