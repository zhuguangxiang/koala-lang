/// Resolve `host` to a list of IP addresses.
///
/// Never returns nil; failure is expressed through the result status.
/// On success `addrs()` is non-empty.
pub func resolve(host str) ResolveResult {
    let (status, addrs, msg) = _resolve(host)
    return ResolveResult(status, addrs, msg)
}

/// Native DNS resolution.
///
/// Returns `(status, addrs, message)`: `status` is one of the `DNS_*`
/// constants, `addrs` is non-empty when `status` is `DNS_OK`, and
/// `message` carries a human-readable description on failure.
@native
func _resolve(host str) (int, list[IpAddr], str) {}
