// RUN: koala --test %s

import "std/ut"
from "std/itertools" import repeat, Repeat, take, zip, map, enumerate

func double(x int) int { return x * 2 }

func repeat_count[T](v T, n int) int {
    var c = 0
    for x in repeat(v, n) { c = c + 1 }
    return c
}

// ==================== Finite repetition ====================

@test
func test_finite() {
    let got = list[int]()
    for v in repeat(7, 3) { got.append(v) }
    ut.assert_eq(got.len(), 3)
    ut.assert_eq(got[0], 7)
    ut.assert_eq(got[2], 7)
}

@test
func test_finite_str() {
    var got = ""
    for v in repeat("x", 2) { got = got + v }
    ut.assert_eq(got, "xx")
}

@test
func test_zero() {
    let r = repeat(9, 0)
    ut.assert_false(r.has_next())
    ut.assert_true(r.next() == nil)
    var n = 0
    for v in r { n = n + 1 }
    ut.assert_eq(n, 0)
}

@test
func test_one() {
    let r = repeat(5, 1)
    ut.assert_true(r.has_next())
    ut.assert_eq(r.next_strict(), 5)
    ut.assert_true(r.next() == nil)
}

@test
func test_while_let_finite() {
    let r = repeat(7, 3)
    var n = 0
    while let v = r.next() {
        ut.assert_eq(v, 7)
        n = n + 1
    }
    ut.assert_eq(n, 3)
}

// ==================== Infinite repetition ====================

@test
func test_infinite_has_next() {
    let r = repeat(1)
    ut.assert_true(r.has_next())
    r.next_strict()
    r.next_strict()
    ut.assert_true(r.has_next())
}

@test
func test_infinite_next_never_nil() {
    let r = repeat(1)
    ut.assert_true(r.next() != nil)
    ut.assert_true(r.next() != nil)
}

@test
func test_infinite_take() {
    let got = list[int]()
    for v in take(repeat(0), 4) { got.append(v) }
    ut.assert_eq(got.len(), 4)
    ut.assert_eq(got[3], 0)
}

// ==================== Iterator protocol ====================

@test
func test_has_next_idempotent() {
    let r = repeat(7, 2)
    ut.assert_true(r.has_next())
    ut.assert_true(r.has_next())
    ut.assert_eq(r.next_strict(), 7)
    ut.assert_true(r.has_next())
    ut.assert_eq(r.next_strict(), 7)
    ut.assert_false(r.has_next())
    ut.assert_false(r.has_next())
}

@test
func test_next_after_exhaustion() {
    let r = repeat(7, 1)
    ut.assert_eq(r.next_strict(), 7)
    ut.assert_true(r.next() == nil)
    ut.assert_true(r.next() == nil)
    ut.assert_false(r.has_next())
}

@test
func test_iter_returns_self() {
    let r = repeat(7, 3)
    ut.assert_eq(r.next_strict(), 7)
    let again = r.iter()
    ut.assert_eq(again.next_strict(), 7)
    ut.assert_eq(r.next_strict(), 7)
    ut.assert_true(r.next() == nil)
}

@test
func test_trait_assignment() {
    let it Iterator[int] = repeat(1, 3)
    ut.assert_eq(it.next_strict(), 1)
    ut.assert_true(it.has_next())
}

@test
func test_nullable_value() {
    let r = repeat[int?](nil, 2)
    ut.assert_true(r.has_next())
    ut.assert_true(r.next_strict() == nil)
    ut.assert_true(r.has_next())
    ut.assert_true(r.next_strict() == nil)
    ut.assert_false(r.has_next())
}

@test
func test_generic_context() {
    ut.assert_eq(repeat_count(5, 3), 3)
    ut.assert_eq(repeat_count("a", 2), 2)
    ut.assert_eq(repeat_count(5, 0), 0)
}

@test
func test_fmt() {
    let r = repeat(1, 2)
    ut.assert_eq(format("{}", r), "Repeat")
}

// ==================== Composition ====================

@test
func test_zip_repeat() {
    var n = 0
    for (z, x) in zip(repeat(0), [1, 2, 3]) {
        ut.assert_eq(z, 0)
        ut.assert_eq(x, n + 1)
        n = n + 1
    }
    ut.assert_eq(n, 3)
}

@test
func test_map_repeat() {
    let got = list[int]()
    for v in take(map(repeat(2), double), 3) { got.append(v) }
    ut.assert_eq(got.len(), 3)
    ut.assert_eq(got[0], 4)
    ut.assert_eq(got[2], 4)
}

@test
func test_enumerate_repeat() {
    var n = 0
    for (i, v) in enumerate(repeat(5, 3)) {
        ut.assert_eq(i, n)
        ut.assert_eq(v, 5)
        n = n + 1
    }
    ut.assert_eq(n, 3)
}

// ==================== Error branches ====================

@should_panic("No more elements in Repeat")
func test_next_strict_exhausted() {
    let r = repeat(7, 1)
    r.next_strict()
    r.next_strict()
}

@should_panic("repeat count must be non-negative")
func test_negative_count() {
    repeat(7, -1)
}

@should_panic("Repeat does not support step != 1")
func test_iter_step_unsupported() {
    let r = repeat(7, 2)
    r.iter(2)
}