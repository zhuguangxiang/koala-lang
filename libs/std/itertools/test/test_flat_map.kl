// RUN: koala --test %s

import "std/ut"
from "std/itertools" import flat_map, FlatMapIter, take, filter, map, enumerate

func words(s str) Iterable[str] { return s.split(" ") }
func dup(x int) Iterable[int] { return [x, x] }
func single(x int) Iterable[int] { return [x] }
func empty_inner(x int) Iterable[int] { return list[int]() }
func even_only(x int) Iterable[int] {
    if x % 2 == 0 { return [x] }
    return list[int]()
}
func to_strs(x int) Iterable[str] { return [format("{}", x)] }
func with_nil(x int) Iterable[int?] {
    let l = list[int?]()
    l.append(x)
    l.append(nil)
    return l
}

class CountingSource : Iterable[int] {
    var pulls int
    var limit int
    func __init__(n int) { pulls = 0; limit = n }
    func iter(step = 1) Iterator[int] { return CountingIter(self) }
}
class CountingIter : Iterator[int] {
    let src CountingSource
    var cursor int
    func __init__(s CountingSource) { src = s; cursor = 0 }
    func has_next() bool = cursor < src.limit
    func next_strict() int {
        if !has_next() { panic("CountingIter exhausted") }
        src.pulls = src.pulls + 1
        let v = cursor
        cursor = cursor + 1
        return v
    }
    func next() int? { if !has_next() { return nil }; return next_strict() }
}

func flat_count[T, U](xs Iterable[T], fn func(T) Iterable[U]) int {
    var n = 0
    for v in flat_map(xs, fn) { n = n + 1 }
    return n
}

// ==================== Basic flattening ====================

@test
func test_basic() {
    let got = list[str]()
    for w in flat_map(["a b", "c d"], words) { got.append(w) }
    ut.assert_eq(got.len(), 4)
    ut.assert_eq(got[0], "a")
    ut.assert_eq(got[3], "d")
}

@test
func test_dup() {
    let got = list[int]()
    for v in flat_map([1, 2], dup) { got.append(v) }
    ut.assert_eq(got.len(), 4)
    ut.assert_eq(got[0], 1)
    ut.assert_eq(got[1], 1)
    ut.assert_eq(got[2], 2)
    ut.assert_eq(got[3], 2)
}

@test
func test_empty_inner() {
    let f = flat_map([1, 2, 3], empty_inner)
    ut.assert_false(f.has_next())
    ut.assert_true(f.next() == nil)
    var n = 0
    for v in f { n = n + 1 }
    ut.assert_eq(n, 0)
}

@test
func test_mixed_empty_inner() {
    let got = list[int]()
    for v in flat_map([1, 2, 3, 4], even_only) { got.append(v) }
    ut.assert_eq(got.len(), 2)
    ut.assert_eq(got[0], 2)
    ut.assert_eq(got[1], 4)
}

@test
func test_empty_source() {
    let f = flat_map(list[str](), words)
    ut.assert_false(f.has_next())
    ut.assert_true(f.next() == nil)
}

@test
func test_single_inner() {
    let got = list[int]()
    for v in flat_map([1, 2, 3], single) { got.append(v) }
    ut.assert_eq(got.len(), 3)
    ut.assert_eq(got[2], 3)
}

@test
func test_type_change() {
    let got = list[str]()
    for s in flat_map([1, 2], to_strs) { got.append(s) }
    ut.assert_eq(got.len(), 2)
    ut.assert_eq(got[0], "1")
    ut.assert_eq(got[1], "2")
}

// ==================== Iterator protocol ====================

@test
func test_while_let() {
    let f = flat_map([1, 2], dup)
    var n = 0
    while let v = f.next() {
        n = n + 1
    }
    ut.assert_eq(n, 4)
}

@test
func test_has_next_idempotent() {
    let f = flat_map([1, 2], single)
    ut.assert_true(f.has_next())
    ut.assert_true(f.has_next())
    ut.assert_eq(f.next_strict(), 1)
    ut.assert_true(f.has_next())
    ut.assert_eq(f.next_strict(), 2)
    ut.assert_false(f.has_next())
    ut.assert_false(f.has_next())
}

@test
func test_next_after_exhaustion() {
    let f = flat_map([1], single)
    ut.assert_eq(f.next_strict(), 1)
    ut.assert_true(f.next() == nil)
    ut.assert_true(f.next() == nil)
    ut.assert_false(f.has_next())
}

@test
func test_iter_returns_self() {
    let f = flat_map([1, 2], dup)
    ut.assert_eq(f.next_strict(), 1)
    let again = f.iter()
    ut.assert_eq(again.next_strict(), 1)
    ut.assert_eq(f.next_strict(), 2)
    ut.assert_eq(f.next_strict(), 2)
    ut.assert_true(f.next() == nil)
}

@test
func test_trait_assignment() {
    let it Iterator[str] = flat_map(["a b"], words)
    ut.assert_eq(it.next_strict(), "a")
    ut.assert_eq(it.next_strict(), "b")
    ut.assert_false(it.has_next())
}

@test
func test_generic_context() {
    ut.assert_eq(flat_count([1, 2], dup), 4)
    ut.assert_eq(flat_count(["a b", "c"], words), 3)
    ut.assert_eq(flat_count(list[int](), dup), 0)
}

@test
func test_fmt() {
    let f = flat_map([1], dup)
    ut.assert_eq(format("{}", f), "FlatMapIter")
}

// ==================== Laziness ====================

@test
func test_lazy_source_pulls() {
    let src = CountingSource(3)
    let f = flat_map(src, dup)
    ut.assert_eq(src.pulls, 0)
    ut.assert_true(f.has_next())
    ut.assert_eq(src.pulls, 1)  // only first source element pulled
    ut.assert_eq(f.next_strict(), 0)
    ut.assert_eq(f.next_strict(), 0)
    ut.assert_eq(src.pulls, 1)  // still within first inner
    ut.assert_true(f.has_next())
    ut.assert_eq(src.pulls, 2)  // advanced to second source element
}

// ==================== Nullable output ====================

@test
func test_nullable_output() {
    let f = flat_map([1, 2], with_nil)  // 1, nil, 2, nil
    ut.assert_true(f.has_next())
    ut.assert_eq(f.next_strict()!, 1)
    ut.assert_true(f.has_next())
    ut.assert_true(f.next_strict() == nil)
    ut.assert_true(f.has_next())
    ut.assert_eq(f.next_strict()!, 2)
    ut.assert_true(f.has_next())
    ut.assert_true(f.next_strict() == nil)
    ut.assert_false(f.has_next())
}

// ==================== Composition ====================

@test
func test_take_flat_map() {
    let got = list[int]()
    for v in take(flat_map([1, 2, 3], dup), 3) { got.append(v) }
    ut.assert_eq(got.len(), 3)
    ut.assert_eq(got[2], 2)
}

@test
func test_filter_flat_map() {
    let got = list[int]()
    for v in filter(flat_map([1, 2], dup), { |x int| x > 1 }) { got.append(v) }
    ut.assert_eq(got.len(), 2)
    ut.assert_eq(got[0], 2)
    ut.assert_eq(got[1], 2)
}

@test
func test_enumerate_flat_map() {
    var n = 0
    for (i, v) in enumerate(flat_map([1, 2], dup)) {
        ut.assert_eq(i, n)
        n = n + 1
    }
    ut.assert_eq(n, 4)
}

@test
func test_map_flat_map() {
    let got = list[int]()
    for v in map(flat_map([1, 2], dup), { |x int| x * 10 }) { got.append(v) }
    ut.assert_eq(got.len(), 4)
    ut.assert_eq(got[0], 10)
    ut.assert_eq(got[3], 20)
}

// ==================== Error branches ====================

@should_panic("No more elements in FlatMapIter")
func test_next_strict_exhausted() {
    let f = flat_map([1], single)
    f.next_strict()
    f.next_strict()
}

@should_panic("FlatMapIter does not support step != 1")
func test_iter_step_unsupported() {
    let f = flat_map([1, 2], dup)
    f.iter(2)
}