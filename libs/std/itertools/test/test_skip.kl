// RUN: koala --test %s

import "std/ut"
from "std/itertools" import skip, Skip, take, enumerate

class CountingSource : Iterable[int] {
    var pulls int
    var limit int
    func __init__(n int) { pulls = 0; limit = n }
    func iter(step = 1) Iterator[int] { return CountingIter(self) }
}
class CountingIter : Iterator[int] {
    let src CountingSource
    var cursor int
    func __init__(s CountingSource) { src = s; cursor = 0 }
    func has_next() bool = cursor < src.limit
    func next_strict() int {
        if !has_next() { panic("CountingIter exhausted") }
        src.pulls = src.pulls + 1
        let v = cursor
        cursor = cursor + 1
        return v
    }
    func next() int? { if !has_next() { return nil }; return next_strict() }
}

func after_two[T](xs Iterable[T]) int {
    var n = 0
    for x in skip(xs, 2) { n = n + 1 }
    return n
}

// ==================== Skipping ====================

@test
func test_n_less_than_len() {
    let got = list[int]()
    for x in skip([1, 2, 3, 4], 2) { got.append(x) }
    ut.assert_eq(got.len(), 2)
    ut.assert_eq(got[0], 3)
    ut.assert_eq(got[1], 4)
}

@test
func test_n_zero() {
    let got = list[int]()
    for x in skip([1, 2, 3], 0) { got.append(x) }
    ut.assert_eq(got.len(), 3)
    ut.assert_eq(got[0], 1)
}

@test
func test_n_equals_len() {
    let s = skip([1, 2, 3], 3)
    ut.assert_false(s.has_next())
    ut.assert_true(s.next() == nil)
}

@test
func test_n_greater_than_len() {
    let s = skip([1, 2], 10)
    ut.assert_false(s.has_next())
    ut.assert_true(s.next() == nil)
    var n = 0
    for x in s { n = n + 1 }
    ut.assert_eq(n, 0)
}

@test
func test_empty_source() {
    let s = skip(list[int](), 3)
    ut.assert_false(s.has_next())
    ut.assert_true(s.next() == nil)
}

@test
func test_str_source() {
    var got = ""
    for c in skip("abcd", 2) { got = got + c }
    ut.assert_eq(got, "cd")
}

// ==================== Iterator protocol ====================

@test
func test_while_let() {
    let s = skip([1, 2, 3, 4], 2)
    var n = 0
    while let x = s.next() {
        ut.assert_eq(x, n + 3)
        n = n + 1
    }
    ut.assert_eq(n, 2)
}

@test
func test_has_next_idempotent() {
    let s = skip([1, 2, 3, 4], 2)
    ut.assert_true(s.has_next())
    ut.assert_true(s.has_next())
    ut.assert_eq(s.next_strict(), 3)
    ut.assert_true(s.has_next())
    ut.assert_eq(s.next_strict(), 4)
    ut.assert_false(s.has_next())
}

@test
func test_next_after_exhaustion() {
    let s = skip([1, 2, 3], 2)
    ut.assert_eq(s.next_strict(), 3)
    ut.assert_true(s.next() == nil)
    ut.assert_true(s.next() == nil)
}

@test
func test_iter_returns_self() {
    let s = skip([1, 2, 3, 4], 1)
    ut.assert_eq(s.next_strict(), 2)
    let again = s.iter()
    ut.assert_eq(again.next_strict(), 3)
    ut.assert_eq(s.next_strict(), 4)
    ut.assert_true(s.next() == nil)
}

@test
func test_trait_assignment() {
    let it Iterator[int] = skip([1, 2, 3], 1)
    ut.assert_eq(it.next_strict(), 2)
    ut.assert_true(it.has_next())
}

@test
func test_generic_context() {
    ut.assert_eq(after_two([1, 2, 3, 4, 5]), 3)
    ut.assert_eq(after_two([1, 2]), 0)
    ut.assert_eq(after_two(list[int]()), 0)
}

@test
func test_fmt() {
    let s = skip([1, 2, 3], 2)
    ut.assert_eq(format("{}", s), "Skip(to_skip=2)")
    s.has_next()
    ut.assert_eq(format("{}", s), "Skip(to_skip=0)")
}

// ==================== Laziness ====================

@test
func test_skips_then_yields() {
    let src = CountingSource(5)
    let got = list[int]()
    for x in skip(src, 2) { got.append(x) }
    ut.assert_eq(got.len(), 3)
    ut.assert_eq(got[0], 2)
    ut.assert_eq(got[1], 3)
    ut.assert_eq(got[2], 4)
    ut.assert_eq(src.pulls, 5)
}

// ==================== Composition ====================

@test
func test_take_skip() {
    let got = list[int]()
    for x in take(skip([1, 2, 3, 4, 5], 1), 2) { got.append(x) }
    ut.assert_eq(got.len(), 2)
    ut.assert_eq(got[0], 2)
    ut.assert_eq(got[1], 3)
}

@test
func test_skip_skip() {
    let got = list[int]()
    for x in skip(skip([1, 2, 3, 4, 5], 1), 1) { got.append(x) }
    ut.assert_eq(got.len(), 3)
    ut.assert_eq(got[0], 3)
}

@test
func test_enumerate_skip() {
    var n = 0
    for (i, x) in enumerate(skip([10, 20, 30], 1)) {
        ut.assert_eq(i, n)
        ut.assert_eq(x, (n + 2) * 10)
        n = n + 1
    }
    ut.assert_eq(n, 2)
}

// ==================== Error branches ====================

@should_panic("No more elements in Skip")
func test_next_strict_exhausted() {
    let s = skip([1], 0)
    s.next_strict()
    s.next_strict()
}

@should_panic("skip count must be non-negative")
func test_negative_count() {
    skip([1, 2], -1)
}

@should_panic("Skip does not support step != 1")
func test_iter_step_unsupported() {
    let s = skip([1, 2, 3], 1)
    s.iter(2)
}