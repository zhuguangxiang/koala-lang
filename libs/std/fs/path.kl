import "std/os"

/// The `Path` class represents a structural filesystem path.
///
/// It treats paths as clean logical objects rather than raw strings,
/// automatically handling platform-specific separators (\ for Windows, / for Unix).
pub class Path : ToString {

    /// The internal string representation of the path.
    let path str

    /// Create a new `Path` from a string representation.
    pub func __init__(p str) { path = p }

    /// Return the final component of the path (e.g., returns "file.kl" for "/a/b/file.kl").
    /// If the path ends in a separator, returns the directory name.
    pub func name() str {
        if path.empty() { return "" }

        // Remove trailing separators to get a clean path (e.g., "/a/b/" -> "/a/b")
        var p = path
        while (p.ends_with("/") || p.ends_with("\\")) && p.len() > 1 {
            p = p.view(0, p.len() - 1)
        }

        // Split the path into components using "/" as the separator,
        // after normalizing Windows-style backslashes.
        let parts = p.replace("\\", "/").split("/")
        if parts.len() > 0 { return parts[parts.len() - 1] }
        return p
    }

    /// Return the file extension without the leading dot (e.g., returns "kl" for "file.kl").
    /// Returns an empty string if no extension exists.
    pub func ext() str {
        let n = name()
        let dot_idx = n.rindex(".")
        // Ensure the dot exists and is not the first character of the filename
        // (e.g., ".gitignore" has no ext)
        if dot_idx > 0 { return n.view(dot_idx + 1, n.len()) }
        return ""
    }

    /// Return the pure filename without its extension (e.g., returns "file" for "file.kl").
    pub func stem() str {
        let n = name()
        let dot_idx = n.rindex(".")
        if dot_idx > 0 { return n.view(0, dot_idx) }
        return n
    }

    /// Return a new `Path` object representing the parent directory.
    /// Returns self if the path is already the root directory.
    pub func parent() Path {
        if path.empty() || path == "/" || path == "\\" { return self }

        // Normalize slashes to safely compute the rightmost segment division
        let p_norm = path.replace("\\", "/")
        var last_slash = p_norm.rindex("/")

        // Handle path strings trailing with an implicit slash (e.g., "/a/b/")
        if last_slash == p_norm.len() - 1 && p_norm.len() > 1 {
            let chopped = p_norm.view(0, p_norm.len() - 1)
            last_slash = chopped.rindex("/")
        }

        if last_slash == -1 {
            // Relative paths without slashes (e.g. "main.kl") resolve to current working directory "."
            return Path(".")
        }

        if last_slash == 0 {
            // Direct child element under the root filesystem scope (e.g., "/config.toml" -> "/")
            return Path("/")
        }

        // Leverage zero-allocation view streaming to extract parent segments cleanly
        return Path(path.view(0, last_slash))
    }

    /// Return true if the path is absolute.
    /// (e.g., starts with "/" on Unix or "C:\" on Windows).
    pub func is_absolute() bool {
        if path.empty() { return false }
        if path.starts_with("/") || path.starts_with("\\") { return true }

        // Parse platform-aware Windows drive letters explicitly (e.g., "C:/" or "D:\")
        if path.len() >= 3 {
            let drive = path.view(0, 2)
            let sep = path.view(2, 3)
            if drive.ends_with(":") && (sep == "/" || sep == "\\") {
                return true
            }
        }
        return false
    }

    /// Return a normalized version of the path.
    /// Eliminates redundant separators and up-level references (e.g., "a//b", "a/./b", "a/b/../c" -> "a/c").
    pub func normalize() Path {
        if path.empty() { return Path(".") }

        let is_abs = is_absolute()
        let segments = path.replace("\\", "/").split("/")
        let stack = list[str]()

        // Segments are kept as they are: spaces are valid in file names.
        for seg in segments {
            if seg.empty() || seg == "." { continue }

            if seg == ".." {
                if stack.len() > 0 && stack[stack.len() - 1] != ".." {
                    stack.pop(stack.len() - 1)
                } else if !is_abs {
                    stack.append("..")
                }
            } else {
                stack.append(seg)
            }
        }

        // Reassemble segments back into a unified normalized string representation
        var res = ""
        if is_abs { res = "/" }

        var first = true
        for item in stack {
            if !first { res = res + "/" }
            res = res + item
            first = false
        }

        if res.empty() { return Path(".") }
        return Path(res)
    }

    /// Return an absolute version of the path by lexically expanding relative tokens.
    pub func absolute() Path {
        if is_absolute() { return normalize() }
        // Resolve against the real process working directory (getcwd), not the
        // possibly-unset or stale PWD environment variable.
        return Path(os.getcwd()).cat(path).normalize()
    }

    /// Return the components of the path, without empty and `.` components.
    ///
    /// An absolute path starts with its root (`"/"`, or a drive like `"C:/"`).
    /// `..` is kept: this is lexical, use `normalize` first to fold it.
    ///
    /// Example:
    ///     fs.Path("/usr//lib/./x.so").parts()   // ["/", "usr", "lib", "x.so"]
    ///     fs.Path("a/../b").parts()             // ["a", "..", "b"]
    pub func parts() list[str] {
        let res = list[str]()
        var rest = path.replace("\\", "/")
        if is_absolute() {
            if rest.starts_with("/") {
                res.append("/")
                rest = rest.view(1, rest.len())
            } else {
                // drive root such as "C:/"
                res.append(rest.view(0, 3))
                rest = rest.view(3, rest.len())
            }
        }
        for seg in rest.split("/") {
            if seg.empty() || seg == "." { continue }
            res.append(seg)
        }
        return res
    }

    /// Return a new path with the final component replaced by `new_name`.
    ///
    /// Panic if the path has no final component (empty, `"."`, `".."` or a
    /// root), or if `new_name` is empty or contains a separator.
    ///
    /// Example:
    ///     fs.Path("src/main.kl").with_name("util.kl")   // Path("src/util.kl")
    pub func with_name(new_name str) Path {
        let n = name()
        if n.empty() || n == "." || n == ".." { panic("Path.with_name: '" + path + "' has no name") }
        // `in` binds looser than `||` in Koala, hence the parentheses
        if new_name.empty() || ("/" in new_name) || ("\\" in new_name) {
            panic("Path.with_name: invalid name '" + new_name + "'")
        }
        let p = parent()
        if p.to_str() == "." { return Path(new_name) }
        return p.cat(new_name)
    }

    /// Return a new path with the extension replaced by `new_ext`, given
    /// without the leading dot (as `ext` returns it); an empty `new_ext`
    /// removes the extension.
    ///
    /// Panic as `with_name` does, or if `new_ext` starts with a dot.
    ///
    /// Example:
    ///     fs.Path("src/main.kl").with_ext("klc")   // Path("src/main.klc")
    ///     fs.Path("a.tar.gz").with_ext("")         // Path("a.tar")
    pub func with_ext(new_ext str) Path {
        if new_ext.starts_with(".") { panic("Path.with_ext: give '" + new_ext + "' without the leading dot") }
        if new_ext.empty() { return with_name(stem()) }
        return with_name(stem() + "." + new_ext)
    }

    /// Return true if the path matches the shell `pattern`, compared from the right.
    ///
    /// A relative pattern matches the last components of the path, one
    /// pattern part per component; an absolute pattern must match the whole
    /// path. Each part is a shell pattern: `*` (any characters), `?` (one
    /// character) and `[...]` (one character of a set); a component starting
    /// with `.` is matched only by a part starting with `.`. Purely lexical.
    ///
    /// Panic if `pattern` is empty.
    ///
    /// Example:
    ///     fs.Path("/a/b/c.kl").match("*.kl")    // true
    ///     fs.Path("/a/b/c.kl").match("b/*.kl")  // true
    ///     fs.Path("/a/b/c.kl").match("/*.kl")   // false
    ///
    /// See: `fs.glob`.
    pub func match(pattern str) bool {
        let pp = Path(pattern)
        let pat = pp.parts()
        if pat.len() == 0 { panic("Path.match: empty pattern") }
        let mine = parts()
        if pp.is_absolute() {
            if pat.len() != mine.len() { return false }
        } else if pat.len() > mine.len() {
            return false
        }

        let off = mine.len() - pat.len()
        var i = 0
        while i < pat.len() {
            if !_fnmatch(pat[i], mine[off + i]) { return false }
            i = i + 1
        }
        return true
    }

    /// Return the path with a leading `~` replaced by the home directory:
    /// `~` alone or `~/...`. Any other path (also `~user/...`) is returned as
    /// is, and so is a `~` path when the home directory is unknown.
    ///
    /// Example:
    ///     fs.Path("~/.config/koala").expand_user()   // Path("/home/me/.config/koala")
    ///
    /// See: `os.home_dir`.
    pub func expand_user() Path {
        if path != "~" && !path.starts_with("~/") { return self }
        let home = os.home_dir() else { return self }
        if path == "~" { return Path(home) }
        return Path(home).cat(path.view(2, path.len()))
    }

    /// Return this path relative to `base`.
    ///
    /// Purely lexical: both paths are normalized first and symbolic links are
    /// not resolved; the same path gives `Path(".")`. An absolute path is never
    /// relative to a relative one, or the other way round: that gives nil.
    ///
    /// When the path is not below `base`, return nil, or with `walk_up` the
    /// path through their common prefix with `..` steps (like Python's
    /// `os.path.relpath`). `walk_up` cannot step out of a `..` left in `base`
    /// after normalizing (e.g. base `../x`): that gives nil too.
    ///
    /// Example:
    ///     fs.Path("/a/b/c.kl").relative_to("/a")              // Path("b/c.kl")
    ///     fs.Path("/a/b").relative_to("/x")                   // nil
    ///     fs.Path("/a/b").relative_to("/a/x/y", true)         // Path("../../b")
    pub func relative_to(base Path | str, walk_up = false) Path? {
        var b = Path(".")
        if base is str {
            b = Path(base)
        } else if base is Path {
            b = base
        } else {
            unreachable()
        }
        if is_absolute() != b.is_absolute() { return nil }

        let mine = normalize().parts()
        let theirs = b.normalize().parts()

        // the common prefix
        var i = 0
        while i < mine.len() && i < theirs.len() && mine[i] == theirs[i] {
            i = i + 1
        }
        if i < theirs.len() && !walk_up { return nil }

        let rest = list[str]()
        var k = i
        while k < theirs.len() {
            if theirs[k] == ".." { return nil } // cannot walk out of an unknown name
            rest.append("..")
            k = k + 1
        }
        while i < mine.len() {
            rest.append(mine[i])
            i = i + 1
        }
        if rest.empty() { return Path(".") }
        return Path("/".join(rest))
    }

    /// Return the ancestors of the path, nearest first: for `/a/b/c` that is
    /// `/a/b`, `/a`, `/`; for `a/b/c` it is `a/b`, `a`, `.`. Purely lexical,
    /// on the normalized path.
    ///
    /// Example:
    ///     for p in fs.Path("src/fs/path.kl").parents() { print(p) }
    pub func parents() list[Path] {
        let res = list[Path]()
        var p = normalize()
        var up = p.parent()
        while up != p {
            res.append(up)
            p = up
            up = p.parent()
        }
        return res
    }

    /// Return a new path with the stem (the name without its extension)
    /// replaced by `new_stem`; the extension is kept.
    ///
    /// Panic as `with_name` does.
    ///
    /// Example:
    ///     fs.Path("src/main.kl").with_stem("util")   // Path("src/util.kl")
    ///     fs.Path("a.tar.gz").with_stem("b")         // Path("b.gz")
    pub func with_stem(new_stem str) Path {
        let e = ext()
        if e.empty() { return with_name(new_stem) }
        return with_name(new_stem + "." + e)
    }

    /// Return every extension of the final component, without the dots, in
    /// order (e.g. `["tar", "gz"]` for `a.tar.gz`). A leading dot is not an
    /// extension, so `.bashrc` has none.
    ///
    /// See: `ext`, `stem`.
    pub func suffixes() list[str] {
        let res = list[str]()
        var n = name()
        while n.starts_with(".") { n = n.view(1, n.len()) }
        let pieces = n.split(".")
        var i = 1
        while i < pieces.len() {
            if !pieces[i].empty() { res.append(pieces[i]) }
            i = i + 1
        }
        return res
    }

    /// Return the current working directory as a `Path`.
    ///
    /// See: `os.getcwd`.
    pub static func cwd() Path {
        return Path(os.getcwd())
    }

    /// Return the home directory as a `Path`, or nil if it is unknown.
    ///
    /// See: `os.home_dir`, `expand_user`.
    pub static func home() Path? {
        let h = os.home_dir() else { return nil }
        return Path(h)
    }

    /// Convert the path to its string form.
    ///
    /// This returns the path itself without adding a display-oriented wrapper.
    pub func to_str() str { return path }

    /// Format the path for display.
    ///
    /// The display form includes the `Path(...)` wrapper.
    pub func fmt(f Formatter) { f.write_fmt("Path({})", path) }

    /// Compare two paths for equality (Equatable[Path] trait).
    pub func __eq__(rhs Path) bool { return path == rhs.path }

    /// Compare two paths for inequality.
    pub func __ne__(rhs Path) bool { return path != rhs.path }

    /// Connect a new path segment or another Path to the current one.
    ///
    /// Returns a brand new Path object, allowing fluent method chaining.
    /// Thanks to Koala's union type support, it effortlessly accepts str or Path.
    ///
    /// Example:
    ///     let p = fs.Path("abc").cat("def").cat("ok")
    pub func cat(segment Path | str) Path {
        var next_part = ""

        if segment is str {
            next_part = segment
        } else if segment is Path {
            next_part = segment.to_str()
        } else {
            unreachable()
        }

        if next_part.empty() { return self }

        let has_tail_sep = path.ends_with("/") || path.ends_with("\\")
        let has_head_sep = next_part.starts_with("/") || next_part.starts_with("\\")

        var joint = path
        if !has_tail_sep && !has_head_sep && !path.empty() {
            joint = joint + "/"
        }

        return Path(joint + next_part).normalize()
    }

    /// Return the hash code of the current path.
    pub func hash() int { return path.hash() }
}
