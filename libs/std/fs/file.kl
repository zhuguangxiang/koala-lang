
import "std/io"

pub class File : io.Reader & io.Writer & io.Seeker & io.Closable {

    pub let path str?
    pub let mode str

    @native
    pub func read(bs bytes) int {}

    @native
    pub func write(bs bytes) int {}

    @native
    pub func seek(offset int, whence int) int {}

    @native
    pub func close() {}

    /// raw file is not flushable, so it's empty
    pub func flush() {}
}
