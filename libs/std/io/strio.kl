
pub class StringIO : Reader & Seeker {

    let buf bytes
    var pos int

    pub func __init__(s str) {
        buf = s.to_bytes()
        pos = 0
    }

    pub func read(bs bytes) int {
        let available = len(buf) - pos
        if (available <= 0) { return 0; }

        let n = min(available, len(bs))
        bs.copy(buf, pos, pos + n)
        // pos += n
        pos = pos + n
        return n
    }

    // @native
    pub func seek(offset int, whence int) int {}
}
