
pub class BufferedReader : Reader {

    @native
    pub func __init__(inner Reader, buf_size = 8192) {}

    @native
    pub func read_until(buf bytes, delim uint8) int {}

    @native
    pub func read_line(buf bytes) int {}

    @native
    pub func read(bs bytes) int {}

    @native
    pub func lines() Lines {}
}


pub class BufferedWriter : Writer {

    @native
    pub func __init__(inner Writer, buf_size = 8192) {}

    @native
    pub func write(bs bytes) int {}

    @native
    pub func flush() {}
}
