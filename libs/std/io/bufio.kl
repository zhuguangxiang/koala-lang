
pub class BufReader : Reader {
    let inner Reader
    let buf bytes
    var start int
    var end int

    pub func __init__(_inner Reader, buf_size = 8192) {
        inner = _inner
        buf = bytes(buf_size)
        start = 0
        end = 0
    }

    pub func read(out bytes) int {
        if start >= end {
            start = 0
            end = inner.read(buf)
            if end <= 0 {
                return end
            }
        }

        let avail = end - start
        let n = min(avail, len(out))
        let _end = start + n

        out.copy(buf, start, _end);
        // start += n
        start = _end
        return n
    }

    pub func avail() int {
        return end - start
    }
}

pub class BufWriter : Writer {
    let inner Writer
    let buf bytes
    var pos int

    pub func __init__(_inner Writer, buf_size = 8192) {
        inner = _inner
        buf = bytes(buf_size)
        pos = 0
    }

    func _flush() {
        if pos > 0 {
            inner.write(buf.view(0, pos))
            pos = 0
        }
    }

    pub func write(data bytes) int {
        let data_len = len(data)
        let buf_len = len(buf)

        if data_len >= buf_len {
            _flush()
            return inner.write(data)
        }

        if pos + data_len > buf_len {
            _flush()
        }

        let n = buf.view(pos).copy(data)
        // pos += n
        pos = pos + n
        return n
    }

    pub func flush() {
        _flush()
        inner.flush()
    }
}
