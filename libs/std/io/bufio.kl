
pub class BufReader : Reader {
    let inner Reader
    let buf bytes
    var start int
    var end int

    pub func __init__(_inner Reader, size = 8192) {
        inner = _inner
        buf = bytes(size)
        start = 0
        end = 0
    }

    pub func read(out bytes) int {
        if start >= end && fill() <= 0 {
            return 0
        }

        let avail = end - start
        let n = min(avail, len(out))
        let _end = start + n

        out.copy(buf, start, _end);
        // start += n
        start = _end
        return n
    }

    pub func avail() int {
        return end - start
    }

    pub func peek(n int) bytes {
        let avail = end - start

        if avail <= 0 && fill() <= 0 {
            return bytes(0)
        }

        let take = min(n, end - start)
        return buf.view(start, start + take)
    }

    pub func discard(n int) int {
        let avail = end - start

        if avail <= 0 && fill() <= 0 {
            return 0
        }

        let take = min(n, end - start)
        // start += take
        start = start + take
        return take
    }

    func fill() int {
        start = 0
        let _end = inner.read(buf)
        end = _end
        return _end
    }

    @native
    pub func read_until(out ByteBuf, delim uint8) int {}
}

pub class BufWriter : Writer {
    let inner Writer
    let buf bytes
    var pos int

    pub func __init__(_inner Writer, buf_size = 8192) {
        inner = _inner
        buf = bytes(buf_size)
        pos = 0
    }

    func _flush() {
        if pos > 0 {
            inner.write(buf.view(0, pos))
            pos = 0
        }
    }

    pub func write(data bytes) int {
        let data_len = len(data)
        let buf_len = len(buf)

        if data_len >= buf_len {
            _flush()
            return inner.write(data)
        }

        if pos + data_len > buf_len {
            _flush()
        }

        let n = buf.view(pos).copy(data)
        // pos += n
        pos = pos + n
        return n
    }

    pub func flush() {
        _flush()
        inner.flush()
    }
}
