

link "koala_std_native"

func min(a int, b int) int {
    if a < b {
        return a
    } else {
        return b
    }
}

pub func buf_write(w BufWriter, data bytes) int {
    let n = w.write(data)
    return n
}

pub func buf_write_str(w BufWriter, data str) int {
    let n = w.write(data.to_bytes())
    return n
}

pub func buf_flush(w BufWriter) {
    w.flush()
}
