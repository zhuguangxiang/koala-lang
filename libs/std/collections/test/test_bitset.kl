@should_panic("BitSet size mismatch: 8 vs 10")
func test_bitand_size_mismatch() {
    let a = co.BitSet(8)
    let b = co.BitSet(10)
    let c = a & b
    print(c)
}

// ==================== to_bytes / from_bytes ====================

@test
func test_to_bytes_empty() {
    let bs = co.BitSet(16)
    let data = bs.to_bytes()
    ut.assert_eq(data.len(), 2)
    ut.assert_int_eq(data[0], 0)
    ut.assert_int_eq(data[1], 0)
}

@test
func test_to_bytes_with_bits() {
    let bs = co.BitSet(16)
    bs.set(0)
    bs.set(7)
    bs.set(8)
    bs.set(15)
    let data = bs.to_bytes()
    ut.assert_eq(data.len(), 2)
    ut.assert_int_eq(data[0], 0x81)  // bits 0 and 7
    ut.assert_int_eq(data[1], 0x81)  // bits 8 and 15
}

@test
func test_from_bytes() {
    let data = bytes(2)
    data[0] = 0xFF
    data[1] = 0x0F
    let bs = co.BitSet.from_bytes(data)
    ut.assert_eq(bs.size(), 16)
    for i in range(8) {
        ut.assert_true(bs.test(i))
    }
    for i in range(8, 12) {
        ut.assert_true(bs.test(i))
    }
    for i in range(12, 16) {
        ut.assert_false(bs.test(i))
    }
}

@test
func test_roundtrip_bytes() {
    let original = co.BitSet(32)
    original.set(0)
    original.set(10)
    original.set(20)
    original.set(31)

    let data = original.to_bytes()
    let restored = co.BitSet.from_bytes(data)

    ut.assert_eq(restored.size(), original.size())
    ut.assert_eq(restored.count(), original.count())
    ut.assert_true(restored.test(0))
    ut.assert_true(restored.test(10))
    ut.assert_true(restored.test(20))
    ut.assert_true(restored.test(31))
    ut.assert_false(restored.test(1))
    ut.assert_false(restored.test(15))
}

// ==================== fmt ====================

@test
func test_fmt_small() {
    let bs = co.BitSet(8)
    bs.set(0)
    bs.set(7)
    let f = Formatter()
    bs.fmt(f)
    let s = f.result()
    ut.assert("nbits=8" in s)
    ut.assert("bits=10000001" in s)
}

@test
func test_fmt_truncated() {
    let bs = co.BitSet(100)
    bs.set(0)
    bs.set(50)
    let f = Formatter()
    bs.fmt(f)
    let s = f.result()
    ut.assert("nbits=100" in s)
    ut.assert("..." in s)
}

// ==================== dump ====================

@test
func test_dump_format() {
    let bs = co.BitSet(40)
    bs.set(0)
    bs.set(8)
    bs.set(16)
    bs.set(24)
    bs.set(32)
    let s = bs.dump()
    // Should have newlines and spaces
    ut.assert("\n" in s)
    ut.assert(" " in s)
}

@test
func test_dump_small() {
    let bs = co.BitSet(8)
    bs.set(0)
    bs.set(7)
    let s = bs.dump()
    ut.assert("10000001" in s)
}
