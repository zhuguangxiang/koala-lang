
import "std/io"
import "std/fs"
import "std/os"

pub let version = __KOALA_VERSION__
pub let build = __KOALA_BUILD_HASH__
pub let date = __KOALA_BUILD_DATE__

let _stdin = fs.open(0)
let _stdout = fs.open(1)
let _stderr = fs.open(2)

pub var stdin = io.BufReader(_stdin)
pub var stdout = io.BufWriter(_stdout)
pub var stderr = io.BufWriter(_stderr)

pub let argv = os.args()

pub let path = ["./"]

func __init__() {
    path.extend(os.getenv("KOALA_PATH").split(":"))
}
