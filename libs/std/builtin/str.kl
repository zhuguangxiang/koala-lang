pub class str : Sequence[str] {

    @native
    pub func __init__(s str) {}

    @native
    pub func __len__() int {}

    @native
    pub func __getitem__(index any) str {}

    @native
    pub func find(sub str) int {}

    @native
    pub func substr(start int, length int) str {}

    @native
    pub func to_int() int {}

    @native
    pub func to_float() float64 {}

    @native
    pub func format(args ...) str {}

    @native
    pub func __add__(rhs any) str {}

    @native
    pub func __eq__(rhs str) bool {}

    @native
    pub func __ne__(rhs str) bool {}

    @native
    pub func join(seq Sequence[str]) str {}

    @native
    pub func to_bytes() bytes {}

    @native
    pub func split(sep = " ") list[str] {}
}
