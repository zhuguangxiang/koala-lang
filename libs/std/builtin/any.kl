/// The 'any' trait is the root trait of all other classes and traits.
/// All functions are implemented by internal, and everyone can use them.
pub trait any {
    /// The hash function is used to calculate the hash value of an object.
    @native(kl_any_hash)
    func __hash__() int {}

    /// The equality function is used to compare two objects for equality.
    @native(kl_any_eq)
    func __eq__(rhs any) bool {}

    /// The string function is used to convert an object to a string.
    @native(kl_any_str)
    func __str__() str {}
}
