/// Base trait for all collections.
/// Represents a group of objects, known as its elements.
pub trait Collection[T] : Iterable[T] {
    /// Return the number of items in the collection.
    func __len__() int

    /// Return True if the collection is empty, False otherwise.
    func empty() bool
}

// A Sequence is a read-only, indexable collection of elements.
///
/// This trait is the standard internal type for variadic arguments (...T).
/// It provides random access and searching capabilities without modification.
pub trait Sequence[T] : Collection[T] {

    /// Get the item at the specified index.
    ///
    /// PRECONDITION: 0 <= index < __len__().
    /// Raising an IndexError (Panic) if the index is out of range.
    func __getitem__(index int) T

    /// Return a shallow copy of a portion of the sequence defined by the slice.
    func __getslice__(r slice) Sequence[T]

    /// Return True if the sequence contains the specified value `v`.
    /// This is typically an O(n) operation.
    func __contains__(v T) bool

    /// Return the first index of `value`.
    /// Return -1 if the value is not present.
    func index(value T) int

    /// Return the number of occurrences of `value` in the sequence.
    func count(value T) int
}

/// A MutableSequence is an ordered collection that supports modification.
///
/// It extends the Sequence trait by adding methods to update, insert,
/// and remove elements, such as those found in a dynamic list.
pub trait MutableSequence[T] : Sequence[T] {
    /// Set the item at the specified index to `value`.
    ///
    /// PRECONDITION: 0 <= index < __len__().
    func __setitem__(index int, value T)

    /// Replace a slice of the sequence with elements from the iterable `val`.
    /// This may change the length of the sequence.
    func __setslice__(r slice, val Iterable[T])

    /// Append a new item with `value` to the end of the sequence.
    func append(value T)

    /// Extend the sequence by appending all items from the iterable `items`.
    func extend(items Iterable[T])

    /// Insert a new item with `value` at the given `index`.
    /// Elements at or after the index are shifted to the right.
    func insert(index int, value T)

    /// Remove the first occurrence of `value` from the sequence.
    /// Raise ValueError (Panic) if the value is not present.
    func remove(value T)

    /// Remove and return the item at the given `index`.
    /// If no index is specified, removes and returns the last item (-1).
    func pop(index int = -1) T

    /// Remove all items from the sequence, leaving it empty.
    func clear()
}

/// A Map is an object that maps keys to values.
/// A map cannot contain duplicate keys; each key can map to at most one value.
pub trait Map[K, V] : Collection[(K, V)] {
    /// Return True if the map contains a mapping for the specified key.
    func __contains__(key K) bool

    /// Return the value to which the specified key is mapped.
    func __getsub__(key K) V

    /// Associate the specified value with the specified key in this map.
    func __setsub__(key K, value V)

    /// Return a dynamic view of all keys in the map.
    func keys() Sequence[K]

    /// Return a dynamic view of all values in the map.
    func values() Sequence[V]

    /// Return a dynamic view of all key-value pairs (tuples) in the map.
    func items() Sequence[(K, V)]

    /// Remove the mapping for a key from this map if it is present.
    /// Raise Exception if key is not present.
    func remove(key K) V

    /// Remove the key and return its value.
    /// If key is not found, return default_value.
    func remove_or(key K, default_value V) V

    /// Return the value for key if key is in the map, else raise Exception.
    func get(key K) V

    /// Return the value for key if key is in the map, else return default_value.
    func get_or(key K, default_value V) V
}

/// A collection that contains no duplicate elements.
/// Models the mathematical set abstraction.
pub trait Set[T] : Collection[T] {
    /// Return True if the set contains the specified element.
    func __contains__(v T) bool

    /// Add an element to the set.
    /// Return True if the element was not already present.
    func add(v T) bool

    /// Add all elements from the iterable to the set.
    func extend(items Iterable[T])

    /// Remove an element from the set. Return True if the element was present.
    func remove(v T) bool

    /// Remove all elements from the set.
    func clear()

    /// Return a new set with elements from the set and all others.
    func union(other Iterable[T]) Set[T]

    /// Return a new set with elements common to the set and all others.
    func intersect(other Iterable[T]) Set[T]

    /// Return a new set with elements in the set that are not in the others.
    func diff(other Iterable[T]) Set[T]
}
