/// Buffer is a mutable, growable byte buffer.
///
/// Examples
///
/// ```kl
/// let buffer = Buffer()
/// buffer.write_str("Hello, ")
/// buffer.write_str("Koala!")
/// print(buffer.to_str())
/// ```
pub class Buffer : MutableSequence[uint8] {
    /// Create an empty buffer with an optional initial capacity.
    @native
    pub func __init__(capacity = 256) {}

    /// Return an iterator over a snapshot of the buffer's bytes, advancing by
    /// `step` bytes each turn. The snapshot is taken at construction, so
    /// mutating the buffer during traversal is safe.
    pub func iter(step = 1) Iterator[uint8] {
        return BytesIter(to_bytes(), step)
    }

    /// Append a single byte to the end of the buffer.
    @native
    pub func write_byte(b uint8) {}

    /// Append the UTF-8 encoded bytes of `s` to the buffer.
    @native
    pub func write_str(s str) {}

    /// Append raw bytes to the end of the buffer.
    @native
    pub func write(b bytes) {}

    /// Return the byte at `index` (0-based).
    ///
    /// Panic if `index` is out of range.
    @native
    pub func __getitem__(index int) uint8 {}

    /// Set the byte at `index` (0-based) to `value`.
    ///
    /// Overwrites an existing byte only; it never grows the buffer.
    /// Panic if `index` is out of range.
    @native
    pub func __setitem__(index int, value uint8) {}

    /// Return true if the buffer contains the byte `item`.
    @native
    pub func __contains__(item uint8) bool {}

    /// Return the first index of `value` in `[start, end)`.
    /// If `end` is `-1`, the search extends to the end of the buffer.
    /// Return `-1` if the value is not present.
    @native
    pub func index(value uint8, start = 0, end = -1) int {}

    /// Return the number of occurrences of `value` in `[start, end)`.
    /// If `end` is `-1`, the search extends to the end of the buffer.
    @native
    pub func count(value uint8, start = 0, end = -1) int {}

    /// Remove and return the item at the given `index`.
    ///
    /// If no index is specified, removes and returns the last item (`index = -1`).
    /// Bytes after `index` shift left and the capacity is unchanged, so popping
    /// the last item is O(1). Panic if `index` is out of range.
    @native
    pub func pop(index = -1) uint8 {}

    /// Append a byte `value` to the end of the buffer.
    pub func append(value uint8) { write_byte(value) }

    /// Extend the buffer by appending all bytes from `items`.
    @native
    pub func extend(items Iterable[uint8]) {}

    /// Insert a byte `value` at the given `index`, shifting the bytes at and
    /// after `index` one position to the right. `index` may equal `len()` to
    /// append at the end. Panic if `index` is out of range `[0, len()]`.
    @native
    pub func insert(index int, value uint8) {}

    /// Remove the first occurrence of `value` from the buffer.
    /// Panic if `value` is not present.
    @native
    pub func remove(value uint8) {}

    /// Decode the buffered content as UTF-8 and return a new `str`.
    ///
    /// Panic if the buffered bytes are not valid UTF-8.
    @native
    pub func to_str() str {}

    /// Return a view of the buffered content as `bytes`.
    @native
    pub func to_bytes() bytes {}

    /// Return the current number of bytes in the buffer.
    @native
    pub func len() int {}

    /// Return true if the buffer contains no bytes.
    pub func empty() bool { return len() == 0 }

    /// Clear the buffer, resetting its length to zero.
    ///
    /// The buffer can be reused without reducing its capacity.
    @native
    pub func clear() {}
}
