/// An exception object represents a raised exception.
/// Once raised, it cannot be caught and must be resolved.
/// The func `panic` is the only way to raise it.
///
/// See: `panic`
pub class Exception {

    /// Private: User should not directly instantiate this class.
    /// Use the `panic` function to raise an exception.
    func __init__() {}
}
