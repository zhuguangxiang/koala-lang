/// An Iterator represents the state of an ongoing traversal of elements.
///
/// It provides two complementary access patterns:
/// - Option-style iteration via `next()`
/// - Check-then-act iteration via `has_next()` + `next_strict()`
///
/// The iterator never rewinds and never allocates; it is a forward-only traversal state machine.
pub trait Iterator[T] {
    /// Return true if the iterator has more elements.
    ///
    /// This method must be checked before calling `next_strict()`.
    ///
    /// Semantics:
    /// - true  → the next call to `next_strict()` will return a valid `T`
    /// - false → the iterator is exhausted
    func has_next() bool

    /// Return the next element from the iterator.
    ///
    /// PRECONDITION:
    /// - `has_next()` must return true before calling this method.
    ///
    /// If the iterator is exhausted, this method will panic.
    ///
    /// Semantics:
    /// - Always returns a real element of type `T`
    /// - Never returns `nil`
    ///
    /// Recommended usage:
    /// - Use together with `has_next()` for clean, non-Option iteration:
    ///
    ///     while it.has_next() {
    ///         let v = it.next_strict()   // v: T
    ///     }
    func next_strict() T

    /// Return the next element wrapped in an Option (`T?`).
    ///
    /// Semantics:
    /// - nil → iterator exhausted
    /// - v   → next element is `v` (may be nil if `T` is nullable)
    ///
    /// This method is safe to call at any time. It never panics.
    ///
    /// Recommended usage:
    /// - Use `while let v = it.next()` when `T` is non-nullable.
    /// - Avoid `while let` when `T` is nullable (`T?`), because `v == nil`
    ///   will prematurely terminate the loop.
    func next() T?
}

/// The Iterable trait is the basis for all objects that can be iterated over.
///
/// It provides a way to create an iterator for traversing elements.
pub trait Iterable[T] {
    /// Return a new iterator for traversing the elements.
    ///
    /// `step` specifies the number of elements to advance on each iteration.
    func iter(step = 1) Iterator[T]
}
