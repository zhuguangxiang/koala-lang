    }

    /// Return an iterator for the range.
    @native(kl_range_iter)
    pub func __iter__() Iterator[int] {}

    /// Return the number of occurrences of value in the range.
    ///
    /// Since all values in a range are unique, this returns 1 if the value
    /// is present (via __contains__), otherwise 0.
    pub func count(value int) int {
        // Return 1 if value is in the range, otherwise 0
