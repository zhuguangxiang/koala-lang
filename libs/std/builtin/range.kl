/// A range represents an immutable sequence of integers.
///
/// It is commonly used for looping a specific number of times in for loops.
/// Since it implements Sequence, it supports O(1) length and indexing.
pub class range : Sequence[int] {
    /// The starting value of the range (inclusive).
    pub let start int
    /// The boundary value of the range (exclusive).
    pub let stop int
    /// The interval between each number in the sequence.
    pub let step int

    /// Initialize a range from start (inclusive) to stop (exclusive).
    @native(kl_range_init)
    pub func __init__(_start int, _end int, _step int = 1) {}

    /// Return the number of elements in the range. O(1).
    pub func __len__() int {
        // if (this.step > 0 && this.start < this.stop) {
        //     return (this.stop - this.start - 1) / this.step + 1
        // } else if (this.step < 0 && this.start > this.stop) {
        //     return (this.start - this.stop - 1) / (-this.step) + 1
        // }
        return 0
    }

    /// Get the integer at the specified index. O(1).
    pub func __getitem__(index int) int {
        // Precondition check and calculation: start + index * step
    }

    /// Return a new range that is a sub-slice of the current range. O(1).
    pub func __getslice__(r slice) range {
        // Returns a new range object with adjusted start/stop/step
    }

    /// Return True if the specified item is part of the range.
    ///
    /// This is an O(1) operation using arithmetic checks:
    /// 1. Check if item is within [start, stop)
    /// 2. Check if (item - start) % step == 0
    pub func __contains__(item int) bool {
        // Check if item is in the range using arithmetic and bounds checking
    }

    /// Return an iterator for the range.
    @native(kl_range_iter)
    pub func __iter__() Iterator[int] {}

    /// Return the number of occurrences of value in the range.
    ///
    /// Since all values in a range are unique, this returns 1 if the value
    /// is present (via __contains__), otherwise 0.
    pub func count(value int) int {
        // Return 1 if value is in the range, otherwise 0
    }

    /// Return the index of `value` within the range.
    ///
    /// This function performs an O(1) arithmetic check:
    ///     - First, it verifies that `value` lies within the range bounds,
    ///       taking the sign of `step` into account.
    ///     - Then, it checks whether (value - start) is an exact multiple of `step`.
    ///     - If both conditions hold, the index is:
    ///         index = (value - start) / step
    ///
    /// If `value` is not present in the range, returns -1.
    ///
    @native(kl_range_index)
    pub func index(value int) int {}

    /// Return the string representation of the range.
    ///
    /// The returned format is:
    ///     "range(start, stop, step)"
    ///
    /// This is an O(1) operation. All fields are printed directly without
    /// materializing the sequence.
    ///
    /// Examples:
    ///     range(0, 5, 1)   → "range(0, 5, 1)"
    ///     range(10, 0, -2) → "range(10, 0, -2)"
    ///
    /// Note:
    ///     - No panic is triggered when the range is empty.
    ///
    @native(kl_range_str)
    pub func __str__() str {}

}
