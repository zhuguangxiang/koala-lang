/// A range represents an immutable sequence of integers.
///
/// It is commonly used for looping a specific number of times in for loops.
/// Since it implements Sequence, it supports O(1) length and indexing.
pub class range : Sequence[int] {

    /// Initialize a range from start (inclusive) to stop (exclusive).
    @native(kl_range_init)
    pub func __init__(start int, end int, step int = 1) {}

    /// Return the number of elements in the range. O(1).
    func __len__() int {
        // if (this.step > 0 && this.start < this.stop) {
        //     return (this.stop - this.start - 1) / this.step + 1
        // } else if (this.step < 0 && this.start > this.stop) {
        //     return (this.start - this.stop - 1) / (-this.step) + 1
        // }
        return 0
    }

    /// Get the integer at the specified index. O(1).
    func __getitem__(index int) int {
        // Precondition check and calculation: start + index * step
    }

    /// Return a new range that is a sub-slice of the current range. O(1).
    func __getslice__(r range) Sequence[int] {
        // Returns a new range object with adjusted start/stop/step
    }

    /// Return an iterator for the range.
    @native(kl_range_iter)
    pub func __iter__() Iterator[int] {}
}
