pub class list[T] : Seq[T] {

    @native(kl_list_init)
    pub func __init__() {}

    @native(kl_list_len)
    pub func __len__() int {}

    @native(kl_list_get_item)
    pub func __getitem__(index int) T {}

    @native(kl_list_set_item)
    pub func __setitem__(index int, value T) {}

    @native(kl_list_concat)
    pub func __concat__(seq Seq[T]) list[T] {}

    @native(kl_list_append)
    pub func append(item T) {}
}
