//     pub func has_next() bool {
//         return it_a.has_next() && it_b.has_next()
//     }

//     pub func next() (T, U) {
//         if it_a.has_next() && it_b.has_next() {
//             return (it_a.next(), it_b.next())
//         } else {
//             panic("No more elements in Zip")
//         }
