// Specialized explicit implementation for zipping two iterables into an iterator of tuple pairs.

// pub class Zip[T, U] : Iterator[(T, U)] {
//     let it_a Iterator[T]
//     let it_b Iterator[U]

//     pub func __init__(_a Iterable[T], _b Iterable[U]) {
//         it_a = iter(_a)
//         it_b = iter(_b)
