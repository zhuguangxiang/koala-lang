
pub class Duration {
    let ns int

    pub func __init__(_ns int) {
        ns = _ns
    }

    // Duration + Duration → Duration
    pub func __add__(d Duration) Duration {
        return Duration(ns + d.ns)
    }

    // Duration - Duration → Duration
    pub func __sub__(d Duration) Duration {
        return Duration(ns - d.ns)
    }

    // Duration * int → Duration
    pub func __mul__(n int) Duration {
        return Duration(ns * n)
    }

    // Duration / int → Duration
    pub func __div__(n int) Duration {
        return Duration(ns / n)
    }

    // constructors
    pub static func from_secs(s int) Duration {
        return Duration(s * 1_000_000_000)
    }

    pub static func from_millis(ms int) Duration {
        return Duration(ms * 1_000_000)
    }

    pub static func from_micros(us int) Duration {
        return Duration(us * 1_000)
    }

    pub static func from_nanos(ns int) Duration {
        return Duration(ns)
    }

    pub func to_ns() int64 { return ns }

    pub func to_ms() int64 { return ns / 1_000_000 }

    pub func to_secs() int64 { return ns / 1_000_000_000 }

    pub func __str__() str {
        if ns >= 1_000_000_000 {
            let s = ns / 1_000_000_000
            return format("{}s", s)
        }
        if ns >= 1_000_000 {
            let ms = ns / 1_000_000
            return format("{}ms", ms)
        }
        if ns >= 1_000 {
            let us = ns / 1_000
            return format("{}us", us)
        }
        return format("{}ns", ns)
    }

    pub func __eq__(d Duration) bool {
        return ns == d.ns
    }

    pub func __ne__(d Duration) bool {
        return ns != d.ns
    }
}
