/*!
# Module: builtin

This module contains the built-in types and functions of the Koala standard library.
Most of them are native C implementations and are automatically imported.
*/

/**
The 'object' class is the base class of all other classes and
has some basic functions like java/kotlin. All functions are implemented by runtime.

usage:

```koala
let o = object()
```

The example creates an object. The base object has very less functions, so it's useless.
*/

public class object {

    @native(object_hash)
    public func __hash__() int {}

    @native(object_equals)
    public func __eq__(rhs object) bool {}

    @native(object_str)
    public func __str__() str {}
}

public trait Iterator[T] {
    func __has_next__() bool
    func __next__() T
}

public trait Iterable[T] {
    func __iter__() Iterator[T]
}

/**
Print `objs` to the stream file, separated by `sep` and followed by `end`.

All non-keyword arguments are converted to string and written to stream,
separated by `sep` and followed by `end`. The default `file` is `sys.stdout` stream.
*/
@native(builtin_print)
public func print(objs ..., sep = ' ', end = '\n') {}

public trait Indexable[T] {
    func __len__() int
    func __getitem__(index object) T
    func __setitem__(index object, v T)
}

public trait Seq[T] : Indexable[T] {
    func __len__() int
    func __contains__(v T) bool
    func __concat__(seq Seq[T]) Seq[T]
    func __repeat__(count int) Seq[T]
}

public trait Number[T] {
    func __add__(rhs T) T
    func __sub__(rhs T) T
    func __mul__(rhs T) T
    func __div__(rhs T) T
    func __mod__(rhs T) T
    func __lsh__(rhs T) T
    func __rsh__(rhs T) T
    func __and__(rhs T) T
    func __or__(rhs T) T
    func __xor__(rhs T) T
}

public final class str : Seq[str] {

    @native(kl_str_len)
    func __len__() int {}

    @native(kl_str_get_item)
    func __getitem__(index object) str {}

    @native(kl_str_concat)
    func __concat__(seq Seq[str]) str {}
}

public final class list[T] : Seq[T] {

    @native(kl_list_len)
    func __len__() int {}

    @native(kl_list_get_item)
    func __getitem__(index object) T {}

    @native(kl_list_concat)
    func __concat__(seq Seq[T]) list[T] {}
}

public final class int8 : Number[int8] {
}

public final class int16 : Number[int16] {
}

public final class int32 : Number[int32] {
    @intrinsic
    func __add__(rhs int32) int32 {}
}

public final class int64 : Number[int64] {
    // the 'x' canbe int or string
    // the 'base' is used when 'x' is string
    @native(kl_int64_init)
    public func __init__(x int | str, base = 10) {}

    @intrinsic
    func __add__(rhs int64) int64 {}
}

public final class uint8 : Number[uint8] {
}

public final class uint16 : Number[uint16] {
}

public final class uint32 : Number[uint32] {
    @intrinsic
    func __add__(rhs uint32) uint32 {}
}

public final class uint64 : Number[uint64] {
    @intrinsic
    func __add__(rhs uint64) uint64 {}
}

public final class float16 : Number[float16] {
    @intrinsic
    func __add__(rhs float16) float16 {}
}

public final class float32 : Number[float32] {
    @intrinsic
    func __add__(rhs float32) float32 {}
}

public final class float64 : Number[float64] {
    @intrinsic
    func __add__(rhs float64) float64 {}
}

public final class bool {
}

public final class type {
    @native(kl_type_call)
    public func __call__(o object) type {}
}

public final class range : Iterable[int] {

    @native(kl_range_init)
    public func __init__(start int, end int, step int = 1) {}

    @native(kl_range_iter)
    public func __iter__() Iterator[int] {}
}
