/*!
# Module: builtin

This module contains the built-in types and functions of the Koala standard library.
Most of them are native C implementations and are automatically imported.
*/

/**
The 'any' trait is the root trait of all other classes and traits.
All functions are implemented by runtime and inserted into vtable automatically.
*/

pub trait any {

    @native(kl_any_hash)
    func __hash__() int {}

    @native(kl_any_eq)
    func __eq__(rhs any) bool {}

    @native(kl_any_str)
    func __str__() str {}
}

pub trait Iterator[T] {
    func __has_next__() bool
    func __next__() T
}

pub trait Iterable[T] {
    func __iter__() Iterator[T]
}

pub trait Indexable[T] {
    func __len__() int
    func __getitem__(index any) T
    func __setitem__(index any, v T)
}

pub trait Seq[T] : Indexable[T] {
    func __contains__(v T) bool
    func __concat__(seq Seq[T]) Seq[T]
    func __repeat__(count int) Seq[T]
}

pub trait Number[T] {
    func __add__(rhs T) T
    func __sub__(rhs T) T
    func __mul__(rhs T) T
    func __div__(rhs T) T
    func __mod__(rhs T) T
    func __lsh__(rhs T) T
    func __rsh__(rhs T) T
    func __and__(rhs T) T
    func __or__(rhs T) T
    func __xor__(rhs T) T
}

pub class str : Seq[str] {

    @native(kl_str_len)
    pub func __len__() int {}

    @native(kl_str_get_item)
    pub func __getitem__(index any) str {}

    @native(kl_str_concat)
    pub func __concat__(seq Seq[str]) str {}

    @native(kl_str_repeat)
    pub func __repeat__(count int) str {}

    @native(kl_str_find)
    pub func find(sub str) int {}

    @native(kl_str_substr)
    pub func substr(start int, length int) str {}

    @native(kl_str_to_int)
    pub func to_int() int {}

    @native(kl_str_to_float)
    pub func to_float() float64 {}

    @native(kl_str_format)
    pub func format(fmt str, args ...) str {}

    @native(kl_str_init)
    pub func __init__(s str) {}

    @native(kl_str_add)
    pub func __add__(rhs str) str {}
}

pub class list[T] : Seq[T] {

    @native(kl_list_init)
    pub func __init__() {}

    @native(kl_list_len)
    pub func __len__() int {}

    @native(kl_list_get_item)
    pub func __getitem__(index any) T {}

    @native(kl_list_concat)
    pub func __concat__(seq Seq[T]) list[T] {}

    @native(kl_list_add)
    pub func add(item T) {}
}

pub class dict[K, V] : Indexable[V] {

    @native(kl_dict_len)
    pub func __len__() int {}

    @native(kl_dict_get_item)
    pub func __getitem__(index any) V {}

    @native(kl_dict_set_item)
    pub func __setitem__(index any, v V) {}
}

pub class int8 : Number[int8] {
}

pub class int16 : Number[int16] {
}

pub class int32 : Number[int32] {
    @intrinsic
    pub func __add__(rhs int32) int32 {}
}

pub class int64 : Number[int64] {
    // the 'x' canbe int or string
    // the 'base' is used when 'x' is string
    @native(kl_int64_init)
    pub func __init__(x int | str, base = 10) {}

    @intrinsic
    pub func __add__(rhs int64) int64 {}

    @intrinsic
    pub func __gt__(rhs int64) bool {}

    @intrinsic
    pub func __ge__(rhs int64) bool {}

    @intrinsic
    pub func __lt__(rhs int64) bool {}

    @intrinsic
    pub func __le__(rhs int64) bool {}

    @intrinsic
    pub func __eq__(rhs int64) bool {}

    @intrinsic
    pub func __neq__(rhs int64) bool {}

    @intrinsic
    pub func __iadd__(rhs int64) int64 {}
}

pub class uint8 : Number[uint8] {
}

pub class uint16 : Number[uint16] {
}

pub class uint32 : Number[uint32] {
    @intrinsic
    pub func __add__(rhs uint32) uint32 {}
}

pub class uint64 : Number[uint64] {
    @intrinsic
    pub func __add__(rhs uint64) uint64 {}
}

pub class float16 : Number[float16] {
    @intrinsic
    pub func __add__(rhs float16) float16 {}
}

pub class float32 : Number[float32] {
    @intrinsic
    pub func __add__(rhs float32) float32 {}
}

pub class float64 : Number[float64] {
    @intrinsic
    pub func __add__(rhs float64) float64 {}
}

pub class bool {
}

pub class type {

    @native(kl_type_init)
    pub func __init__(o any) {}

    @native(kl_type_call)
    pub func __call__(o any) type {}
}

pub class range : Iterable[int] {

    @native(kl_range_init)
    pub func __init__(start int, end int, step int = 1) {}

    @native(kl_range_iter)
    pub func __iter__() Iterator[int] {}
}


/**
Print `objs` to the stream file, separated by `sep` and followed by `end`.

All non-keyword arguments are converted to string and written to stream,
separated by `sep` and followed by `end`. The default `file` is `sys.stdout` stream.
*/
@native(builtin_print)
pub func print(objs ..., sep = ' ', end = '\n') {}
