/// Pipeline batches typed Cmds and runs them over one Conn.
///
/// Write path: write_commands encodes every command into the Conn's
/// BufWriter, then flush pushes the batch out in one syscall.
///
/// Read path: receive one Result per command, in submission order. If any
/// receive fails with ERR_IO, the remaining commands are filled with the
/// same ERR_IO so every Cmd has a defined result. On any failure the Conn
/// is discarded rather than released: a partially read batch leaves the
/// stream in an unknown state.
pub class Pipeline {
    /// Client that owns the pool this pipeline borrows from.
    let _client Client

    /// Pending commands, in submission order.
    let _cmds = list[Cmd]()

    /// Create an empty pipeline bound to `client`.
    pub func __init__(client Client) {
        _client = client
    }

    /// Append one command to the batch.
    pub func add(cmd Cmd) {
        _cmds.add(cmd)
    }

    /// Submit the batch: write, flush, read one Result per command.
    pub func exec() {
        if _cmds.len() == 0 { return }

        if let conn = _client.acquire() {
            _run(conn)
        } else {
            print("redis: connection unavailable")
        }
    }

    /// Execute the batch on `conn`, releasing it on success and discarding
    /// it on any failure.
    func _run(conn Conn) {
        conn.write_commands(_cmds)
        conn.flush()

        var broken = false
        for cmd in _cmds {
            let r = conn.receive()
            cmd.set_result(r)
            if r.err == ERR_IO {
                broken = true
            }
        }

        if broken {
            _client.discard(conn)
        } else {
            _client.release(conn)
        }
    }
}
