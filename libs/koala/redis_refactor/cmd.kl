/// Cmd is implemented by every typed Redis command.
pub trait Cmd {
    /// command id, e.g. "GET", "CLIENT" or "SETNAME"
    func id() str

    /// Argument words that follow the command name on the wire.
    func args() list[str]

    /// Store the decoded reply; called by the pipeline.
    func set_result(r Result)

    /// Return the stored reply; zero value before set_result() runs.
    func result() Result
}

// ---------- command ids ----------

// generic
pub let CMD_DEL    = "DEL"
pub let CMD_EXISTS = "EXISTS"
pub let CMD_EXPIRE = "EXPIRE"
pub let CMD_TTL    = "TTL"

// string
pub let CMD_GET  = "GET"
pub let CMD_SET  = "SET"
pub let CMD_INCR = "INCR"
pub let CMD_MGET = "MGET"

// list
pub let CMD_LPUSH  = "LPUSH"
pub let CMD_RPUSH  = "RPUSH"
pub let CMD_LLEN   = "LLEN"
pub let CMD_LRANGE = "LRANGE"
pub let CMD_LPOP   = "LPOP"

// connection
pub let CMD_PING   = "PING"
pub let CMD_ECHO   = "ECHO"
pub let CMD_CLIENT = "CLIENT"

// transactions (Phase 2)
pub let CMD_MULTI   = "MULTI"
pub let CMD_EXEC    = "EXEC"
pub let CMD_DISCARD = "DISCARD"
pub let CMD_WATCH   = "WATCH"
