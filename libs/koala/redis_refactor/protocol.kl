import "std/io"

/// Encode a command as a RESP array of bulk strings.
///
/// ```
/// ("PING",   [])                 -->  *1\r\n$4\r\nPING\r\n
/// ("GET",    ["foo"])            -->  *2\r\n$3\r\nGET\r\n$3\r\nfoo\r\n
/// ("SET",    ["foo", "bar"])     -->  *3\r\n$3\r\nSET\r\n$3\r\nfoo\r\n$3\r\nbar\r\n
/// ("MGET",   ["a", "b"])         -->  *3\r\n$4\r\nMGET\r\n$1\r\na\r\n$1\r\nb\r\n
/// ("CLIENT", ["ID"])             -->  *2\r\n$6\r\nCLIENT\r\n$2\r\nID\r\n
/// ("CLIENT", ["SETNAME", "app"]) -->  *3\r\n$6\r\nCLIENT\r\n$7\r\nSETNAME\r\n$3\r\napp\r\n
/// ```
///
/// Arguments
/// - `id`:   The command word, e.g. "GET" or "CLIENT".
/// - `args`: The argument words that follow `id`. For sub-commands like
///   CLIENT SETNAME, the sub-command word is args[0].
///
/// Returns
/// The complete command frame as bytes, ready to write to a connection.
pub func encode(id str, args list[str]) bytes {
    let buf = Buffer()

    buf.write_byte('*')

    let total = 1 + args.len()
    buf.write_str(str(total))

    buf.write_str("\r\n")

    _write_bulk(buf, id)

    for a in args { _write_bulk(buf, a) }

    return buf.to_bytes()
}

/// Append one bulk-string frame to `buf`.
func _write_bulk(buf Buffer, s str) {
    buf.write_byte('$')
    buf.write_str(str(s.len()))
    buf.write_str("\r\n")
    buf.write_str(s)
    buf.write_str("\r\n")
}

/// Parse one RESP2 reply from `br`.
///
/// The five RESP2 reply types map to:
/// - `+` -> Result.ok(str)
/// - `-` -> Result.error(code, msg); the server error is data, not a panic
/// - `:` -> Result.ok(int)
/// - `$` -> Result.ok(str), or Result.ok(NilValue()) for `$-1`
/// - `*` -> Result.ok(list[any]), or Result.ok(NilValue()) for `*-1`
///
/// Wire-level failures (EOF, truncated frame, unknown type byte) become
/// `Result.error(ERR_IO, "")` or `Result.error(ERR_PROTOCOL, "")`.
pub func decode(br io.BufReader) Result {
    let t = br.read_byte()
    if t < 0 { return Result.error(ERR_IO, "") }

    let line = Buffer()
    if br.read_line(line) < 0 {
        return Result.error(ERR_IO, "")
    }

    let body = line.to_str().remove_suffix("\r")

    if t == '+' {
        return Result.ok(body)
    }

    if t == '-' {
        return _err_from_server(body)
    }

    if t == ':' {
        return Result.ok(body.to_int())
    }

    if t == '$' {
        let n = body.to_int()
        if n < 0 {
            return Result.ok(NilValue())
        }

        let buf = bytes(n)
        if io.read_exact(br, buf) != n {
            return Result.error(ERR_IO, "")
        }

        let crlf = bytes(2)
        if io.read_exact(br, crlf) != 2 {
            return Result.error(ERR_PROTOCOL, "")
        }
        return Result.ok(buf.to_str())
    }

    if t == '*' {
        let n = body.to_int()
        if n < 0 {
            return Result.ok(NilValue())
        }

        let items = []
        var i = 0
        while i < n {
            let sub = decode(br)
            if sub.err != ERR_NOERR {
                return sub
            }

            items.append(sub.val)
            i = i + 1
        }
        return Result.ok(items)
    }

    return Result.error(ERR_PROTOCOL, "")
}

/// Classify a server error reply by its first word.
///
/// "WRONGTYPE ..." -> ERR_WRONGTYPE, "NOAUTH ..." -> ERR_NOAUTH,
/// anything else -> ERR_SERVER. The raw message is kept in `errmsg`.
func _err_from_server(msg str) Result {
    let sp = msg.index(" ")
    var prefix = msg
    if sp >= 0 {
        prefix = msg.substr(0, sp)
    }

    if prefix == "WRONGTYPE" {
        return Result.error(ERR_WRONGTYPE, msg)
    }

    if prefix == "NOAUTH" {
        return Result.error(ERR_NOAUTH, msg)
    }

    return Result.error(ERR_SERVER, msg)
}
