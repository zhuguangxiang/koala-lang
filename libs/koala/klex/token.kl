/// One token of Koala source.
///
/// `kind` is the terminal symbol, `lexeme` the exact source text it covers
/// (empty for a semicolon inserted at a newline or at the end of input).
/// `line` and `col` are 1-based and count bytes, as the compiler's scanner
/// does; `offset` is the 0-based byte offset of the token's first byte.
///
/// `value` is the decoded payload of a literal, nil for everything else:
///
/// - `STRING_LITERAL`, `CHAR_LITERAL`, `BYTES_LITERAL`: the text between the
///   quotes with `\"` `\n` `\t` `\r` `\\` and `\xNN` escapes resolved. A text
///   block (`"""..."""`) keeps its content verbatim.
/// - `INT_LITERAL`, `FLOAT_LITERAL`: the numeric text with `_` separators
///   removed, the sign kept, the `0b`/`0o` prefix dropped and `0x` kept, as
///   the compiler normalizes it before parsing.
pub class Token {
    pub let kind TokenKind
    pub let lexeme str
    pub let value str?
    pub let line int
    pub let col int
    pub let offset int

    pub func __init__(kind TokenKind, lexeme str, value str?, line int, col int, offset int) {
        self.kind = kind
        self.lexeme = lexeme
        self.value = value
        self.line = line
        self.col = col
        self.offset = offset
    }

    /// Whether this is a semicolon the lexer inserted rather than one written
    /// in the source.
    pub func is_inserted_semi() bool {
        return kind == TokenKind.SEMI && lexeme.len() == 0
    }

    /// Whether this token is trivia — whitespace, a newline, a comment or an
    /// unrecognized byte — produced only by the raw lexer mode.
    pub func is_trivia() bool {
        switch kind {
            case TokenKind.WS: return true
            case TokenKind.NEWLINE: return true
            case TokenKind.LINE_COMMENT: return true
            case TokenKind.BLOCK_COMMENT: return true
            case TokenKind.UNKNOWN: return true
            case _: return false
        }
    }
}