/// The kind of a Koala token, mirroring the terminal symbols of
/// `src/parser/koala.l`. Keyword spellings that share a terminal in the
/// compiler share a kind here too: `uint`/`uint64` -> `UINT64`, `int`/`int64`
/// -> `INT64`, `float`/`float64` -> `FLOAT64`, `str` -> `STRING`,
/// `dict` -> `MAP`, `hashset` -> `SET`, `pub` -> `PUBLIC`, `nil` -> `NONE`.
///
/// `SEMI` covers both a written `;` and a semicolon the lexer inserts at a
/// newline or at the end of input; an inserted one has an empty `lexeme`.
pub enum TokenKind {
    // keywords
    FROM,
    IMPORT,
    LINK,
    CONST,
    LET,
    VAR,
    FUNC,
    FUNC_LPAREN,
    CLASS,
    TRAIT,
    ENUM,
    IF,
    ELSE,
    WHILE,
    LOOP,
    FOR,
    WITH,
    SWITCH,
    CASE,
    BREAK,
    CONTINUE,
    RETURN,
    IN,
    AS,
    IS,
    PUBLIC,
    INFER,
    STATIC,
    SELF,
    TRUE,
    FALSE,
    NONE,
    UINT8,
    UINT16,
    UINT32,
    UINT64,
    INT8,
    INT16,
    INT32,
    INT64,
    FLOAT16,
    FLOAT32,
    FLOAT64,
    BFLOAT16,
    BOOL,
    STRING,
    BYTES,
    ANY,
    LIST,
    MAP,
    SET,
    TUPLE,
    TYPE,
    RANGE,
    ARRAY,

    // identifiers and literals
    ID,
    CONST_PLACEHOLDER,
    INT_LITERAL,
    FLOAT_LITERAL,
    STRING_LITERAL,
    CHAR_LITERAL,
    BYTES_LITERAL,

    // operators and punctuation
    LAMBDA_START,
    LAMBDA_START_OR,
    AND,
    OR,
    NOT,
    EQ,
    NE,
    GE,
    LE,
    PLUS_ASSIGN,
    MINUS_ASSIGN,
    MULT_ASSIGN,
    DIV_ASSIGN,
    MOD_ASSIGN,
    AND_ASSIGN,
    OR_ASSIGN,
    XOR_ASSIGN,
    SHL_ASSIGN,
    SHR_ASSIGN,
    DOTDOTDOT,
    L_SHIFT,
    R_SHIFT,
    OPT_DOT,
    BANG_DOT,
    COALESCE,
    QUESTION,
    AT,
    PLUS,
    MINUS,
    STAR,
    SLASH,
    PERCENT,
    AMP,
    PIPE,
    TILDE,
    CARET,
    COLON,
    COMMA,
    SEMI,
    DOT,
    ASSIGN,
    UNDERSCORE,
    LPAREN,
    RPAREN,
    LBRACKET,
    RBRACKET,
    LBRACE,
    RBRACE,
    GT,
    LT,

    // trivia: produced only by the raw lexer mode (Lexer(src, raw=true)); the
    // compiler stream drops these. WS is a run of space/tab/CR (no newline);
    // NEWLINE is a single '\n'; LINE_COMMENT covers // # /// up to but not
    // including the newline; BLOCK_COMMENT covers /* ... */ verbatim and may
    // span lines; UNKNOWN is a byte the scanner cannot recognize, kept so the
    // raw stream stays lossless.
    WS,
    NEWLINE,
    LINE_COMMENT,
    BLOCK_COMMENT,
    UNKNOWN,
    // End of input. Never produced by the lexer itself; `koala/kparse`
    // synthesizes one so trailing trivia always has a token to hang on.
    EOF,
}