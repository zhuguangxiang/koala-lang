import "std/ut"
import "koala/klex"

func _toks(src str) list[klex.Token] {
    let toks = klex.tokenize(src)
    ut.assert_true(toks != nil)
    return toks!
}

@test
func test_string_escapes() {
    let ts = _toks("\"hi\\n\\t\\r\\\\\\\"\\x41\"")
    ut.assert_eq(ts[0].kind.name(), "STRING_LITERAL")
    ut.assert_eq(ts[0].value!, "hi\n\t\r\\\"A")
}

@test
func test_unknown_escape() {
    // an unknown escape keeps its backslash and the next byte literally
    let ts = _toks("\"a\\qb\"")
    ut.assert_eq(ts[0].value!, "a\\qb")
    // a bad \x is not an escape either
    let ts2 = _toks("\"\\xZZ\"")
    ut.assert_eq(ts2[0].value!, "\\xZZ")
}

@test
func test_char_and_bytes() {
    let c = _toks("'c'")
    ut.assert_eq(c[0].kind.name(), "CHAR_LITERAL")
    ut.assert_eq(c[0].value!, "c")
    let e = _toks("'\\n'")
    ut.assert_eq(e[0].value!, "\n")
    let b = _toks("b\"by\\x42\"")
    ut.assert_eq(b[0].kind.name(), "BYTES_LITERAL")
    ut.assert_eq(b[0].lexeme, "b\"by\\x42\"")
    ut.assert_eq(b[0].value!, "byB")
    // 'b' not followed by a quote is an identifier
    let id = _toks("b")
    ut.assert_eq(id[0].kind.name(), "ID")
}

@test
func test_text_block() {
    let ts = _toks("\"\"\"raw\ntext\\n\"\"\"")
    ut.assert_eq(ts[0].kind.name(), "STRING_LITERAL")
    // raw: the newline is kept and \n is NOT an escape here
    ut.assert_eq(ts[0].value!, "raw\ntext\\n")
    ut.assert_eq(ts[0].line, 1)
    // the token after it is on line 2
    let ts2 = _toks("\"\"\"a\nb\"\"\" x")
    ut.assert_eq(ts2[1].line, 2)
    // empty text block
    let ts3 = _toks("\"\"\"\"\"\"")
    ut.assert_eq(ts3[0].value!, "")
}

@test
func test_empty_string() {
    let ts = _toks("\"\"")
    ut.assert_eq(ts[0].kind.name(), "STRING_LITERAL")
    ut.assert_eq(ts[0].value!, "")
}

@test
func test_raw_newline_warning() {
    // a raw newline in a quoted literal is dropped from the value, warned
    let lex = klex.Lexer("\"a\nb\"")
    let t = lex.next_token()!
    ut.assert_eq(t.kind.name(), "STRING_LITERAL")
    ut.assert_eq(t.value!, "ab")
    ut.assert_eq(lex.warnings().len(), 1)
    ut.assert_eq(lex.error(), "")
}

@test
func test_unterminated() {
    ut.assert_true(klex.tokenize("\"abc") == nil)
    ut.assert_true(klex.tokenize("'a") == nil)
    ut.assert_true(klex.tokenize("b\"abc") == nil)
    ut.assert_true(klex.tokenize("\"\"\"abc") == nil)
    let lex = klex.Lexer("\"abc")
    ut.assert_true(lex.next_token() == nil)
    ut.assert_true(lex.error().len() > 0)
    // every later call also returns nil
    ut.assert_true(lex.next_token() == nil)
}