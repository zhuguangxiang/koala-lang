import "std/ut"
import "koala/klex"

func _names(src str) list[str] {
    let toks = klex.tokenize(src)
    ut.assert_true(toks != nil)
    let out = list[str]()
    for t in toks! { out.append(t.kind.name()) }
    return out
}

func _eq(got list[str], want list[str]) {
    ut.assert_eq(got.len(), want.len())
    for i in range(want.len()) { ut.assert_eq(got[i], want[i]) }
}

@test
func test_line_comments() {
    _eq(_names("x // note\ny"), ["ID", "SEMI", "ID", "SEMI"])
    _eq(_names("x # note\ny"), ["ID", "SEMI", "ID", "SEMI"])
    // a line comment leaves the newline to end the statement
    _eq(_names("return // note\n"), ["RETURN", "SEMI"])
    // a comment alone is nothing
    _eq(_names("// only a comment"), [])
}

@test
func test_block_comments() {
    _eq(_names("x /* note */ y"), ["ID", "ID", "SEMI"])
    // a block comment may span lines; no semicolon is inserted inside it
    _eq(_names("x /* a\nb */ y"), ["ID", "ID", "SEMI"])
    _eq(_names("/* only */"), [])
}

@test
func test_comment_positions() {
    let ts = klex.tokenize("x /* a\nb */ y")!
    ut.assert_eq(ts[0].line, 1)
    ut.assert_eq(ts[1].line, 2)
    ut.assert_eq(ts[1].col, 6)
}

@test
func test_unterminated_block_comment() {
    ut.assert_true(klex.tokenize("x /* never closed") == nil)
    let lex = klex.Lexer("/* open")
    ut.assert_true(lex.next_token() == nil)
    ut.assert_true(lex.error().len() > 0)
}

@test
func test_unknown_byte_warning() {
    // an unrecognized byte is skipped and warned, scanning continues
    let lex = klex.Lexer("a\x01b")
    let ts = list[klex.Token]()
    while let t = lex.next_token() { ts.append(t) }
    ut.assert_eq(lex.error(), "")
    ut.assert_eq(lex.warnings().len(), 1)
    ut.assert_eq(ts[0].kind.name(), "ID")
    ut.assert_eq(ts[0].lexeme, "a")
    ut.assert_eq(ts[1].kind.name(), "ID")
    ut.assert_eq(ts[1].lexeme, "b")
}