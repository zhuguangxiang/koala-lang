// The tokens of a lexer up to its end of input, as iterating the lexer.
class _Tokens : Iterator[Token] {
    let _lexer Lexer
    var _next Token? = nil
    var _ready bool = false
    var _done bool = false

    func __init__(lexer Lexer) {
        _lexer = lexer
    }

    pub func has_next() bool {
        _fetch()
        return _ready
    }

    pub func next_strict() Token {
        _fetch()
        if !_ready { panic("klex: no more tokens") }
        _ready = false
        return _next!
    }

    pub func next() Token? {
        _fetch()
        if !_ready { return nil }
        _ready = false
        return _next
    }

    func _fetch() {
        if _ready || _done { return }
        let token = _lexer.next_token()
        if token == nil {
            _done = true
            return
        }
        _next = token
        _ready = true
    }
}