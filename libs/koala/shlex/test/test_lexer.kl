@test
func test_lexer_8() {
    // punctuation_chars="|"
    let text = "a|b||c d;e"
    let lex = shlex.shlex(text, punctuation_chars="|")
    let want = ["a", "|", "b", "||", "c", "d", ";", "e"]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 1)
}

@test
func test_lexer_9() {
    // posix escapes and quotes
    let text = "a\\ b \"c\\\"d\" 'e\\f' \"g\\h\" i\"j k\"l"
    let lex = shlex.shlex(text, posix=true)
    let want = ["a b", "c\"d", "e\\f", "g\\h", "ij kl"]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 1)
}

@test
func test_lexer_10() {
    // non-posix keeps quotes
    let text = "'a b'\"c\" d'e'"
    let lex = shlex.shlex(text)
    let want = ["'a b'", "\"c\"", "d'e'"]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 1)
}

@test
func test_lexer_11() {
    // posix empty quotes
    let text = "'' \"\" x''"
    let lex = shlex.shlex(text, posix=true)
    let want = ["", "", "x"]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 1)
}

@test
func test_lexer_12() {
    // lines and comments
    let text = "one # c1\ntwo\n\nthree # c2\n"
    let lex = shlex.shlex(text, posix=true)
    let want = ["one", "two", "three"]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 5)
}

@test
func test_lexer_13() {
    // unclosed quote
    let text = "a 'b"
    let lex = shlex.shlex(text, posix=true)
    ut.assert_true(_tokens(lex) == nil)
    ut.assert_eq(lex.error(), "No closing quotation")
}

@test
func test_lexer_14() {
    // trailing escape
    let text = "a b\\"
    let lex = shlex.shlex(text, posix=true)
    ut.assert_true(_tokens(lex) == nil)
    ut.assert_eq(lex.error(), "No escaped character")
}

@test
func test_lexer_15() {
    // unclosed quote, non-posix
    let text = "a \"b"
    let lex = shlex.shlex(text)
    ut.assert_true(_tokens(lex) == nil)
    ut.assert_eq(lex.error(), "No closing quotation")
}

@test
func test_lexer_16() {
    // custom wordchars, commenters, quotes
    let text = "a-b.c ;comment\n|q x| #d e+f"
    let lex = shlex.shlex(text)
    lex.wordchars += "-."
    lex.commenters = ";"
    lex.quotes = "|"
    let want = ["a-b.c", "|q x|", "#", "d", "e", "+", "f"]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 2)
}

@test
func test_lexer_17() {
    // posix without escapes
    let text = "a\\b \"c\\\"d"
    let lex = shlex.shlex(text, posix=true)
    lex.escape = ""
    let want = ["a", "\\", "b", "c\\d"]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 1)
}

@test
func test_lexer_18() {
    // eof, posix(), punctuation_chars(), the default attributes
    let lex = shlex.shlex("x", posix=false, punctuation_chars=false)
    ut.assert_eq(lex.eof!, "")
    ut.assert_eq(lex.posix(), false)
    ut.assert_eq(lex.punctuation_chars(), "")
    let chars = "abcdfeghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
    ut.assert_eq(lex.wordchars, chars)
    ut.assert_eq(lex.commenters, "#")
    ut.assert_eq(lex.whitespace, " \t\r\n")
    ut.assert_eq(lex.quotes, "'\"")
    ut.assert_eq(lex.escape, "\\")
    ut.assert_eq(lex.escapedquotes, "\"")
    ut.assert_false(lex.whitespace_split)
    ut.assert_true(lex.state! == " ")
    ut.assert_eq(lex.lineno, 1)
    ut.assert_true(lex.source == nil)
}

@test
func test_lexer_19() {
    // eof, posix(), punctuation_chars(), the default attributes
    let lex = shlex.shlex("x", posix=false, punctuation_chars=true)
    ut.assert_eq(lex.eof!, "")
    ut.assert_eq(lex.posix(), false)
    ut.assert_eq(lex.punctuation_chars(), "();<>|&")
    let chars = "abcdfeghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_~-./*?="
    ut.assert_eq(lex.wordchars, chars)
    ut.assert_eq(lex.commenters, "#")
    ut.assert_eq(lex.whitespace, " \t\r\n")
    ut.assert_eq(lex.quotes, "'\"")
    ut.assert_eq(lex.escape, "\\")
    ut.assert_eq(lex.escapedquotes, "\"")
    ut.assert_false(lex.whitespace_split)
    ut.assert_true(lex.state! == " ")
    ut.assert_eq(lex.lineno, 1)
    ut.assert_true(lex.source == nil)
}

