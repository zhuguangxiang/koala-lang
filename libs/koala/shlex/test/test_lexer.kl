// Generated from CPython 3.14.4's shlex: every expected value below is what
// Python returns for the same input.

import "std/ut"
import "std/fs"
import "std/io"
import "koala/shlex"


func _check(got list[str]?, want list[str]) {
    ut.assert_true(got != nil)
    let tokens = got!
    ut.assert_eq(tokens.len(), want.len())
    for i in range(want.len()) {
        ut.assert_eq(tokens[i], want[i])
    }
}


// The tokens of `lex` up to its eof; nil on a lexing error.
func _tokens(lex shlex.shlex) list[str]? {
    let out = list[str]()
    for token in lex { out.append(token) }
    if lex.error().len() > 0 { return nil }
    return out
}

@test
func test_lexer_1() {
    // non-posix default
    let text = "a+b c=d \"q x\" 's' #c\nnext -o=v 1.5 x_y é"
    let lex = shlex.shlex(text)
    let want = [
        "a", "+", "b", "c", "=", "d", "\"q x\"", "'s'", "next", "-", "o", "=", "v", "1", ".", "5",
        "x_y", "é",
    ]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 2)
}

@test
func test_lexer_2() {
    // posix
    let text = "a+b c=d \"q x\" 's' #c\nnext -o=v 1.5 x_y é"
    let lex = shlex.shlex(text, posix=true)
    let want = [
        "a", "+", "b", "c", "=", "d", "q x", "s", "next", "-", "o", "=", "v", "1", ".", "5", "x_y",
        "é",
    ]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 2)
}

@test
func test_lexer_3() {
    // non-posix, whitespace_split
    let text = "a+b c=d \"q x\" 's' #c\nnext -o=v 1.5 x_y é"
    let lex = shlex.shlex(text)
    lex.whitespace_split = true
    let want = ["a+b", "c=d", "\"q x\"", "'s'", "next", "-o=v", "1.5", "x_y", "é"]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 2)
}

@test
func test_lexer_4() {
    // posix, whitespace_split
    let text = "a+b c=d \"q x\" 's' #c\nnext -o=v 1.5 x_y é"
    let lex = shlex.shlex(text, posix=true)
    lex.whitespace_split = true
    let want = ["a+b", "c=d", "q x", "s", "next", "-o=v", "1.5", "x_y", "é"]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 2)
}

@test
func test_lexer_5() {
    // punctuation_chars=true
    let text = "a && b; c|d (e) >f g>>h ~/x.py *.c a=1"
    let lex = shlex.shlex(text, punctuation_chars=true)
    let want = [
        "a", "&&", "b", ";", "c", "|", "d", "(", "e", ")", ">", "f", "g", ">>", "h", "~/x.py",
        "*.c", "a=1",
    ]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 1)
}

@test
func test_lexer_6() {
    // punctuation_chars=true, posix
    let text = "a && b; c|d (e) >f g>>h ~/x.py *.c a=1"
    let lex = shlex.shlex(text, posix=true, punctuation_chars=true)
    let want = [
        "a", "&&", "b", ";", "c", "|", "d", "(", "e", ")", ">", "f", "g", ">>", "h", "~/x.py",
        "*.c", "a=1",
    ]
    _check(_tokens(lex), want)
    ut.assert_eq(lex.lineno, 1)
}

@test
func test_lexer_7() {
    // punctuation_chars=true, whitespace_split
    let text = "a && b; c|d (e) >f g>>h ~/x.py *.c a=1"
    let lex = shlex.shlex(text, punctuation_chars=true)
    lex.whitespace_split = true
    let want = [
        "a", "&&", "b", ";", "c", "|", "d", "(", "e", ")", ">", "f", "g", ">>", "h", "~/x.py",
