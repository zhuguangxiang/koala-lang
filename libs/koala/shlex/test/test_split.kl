// Generated from CPython 3.14.4's shlex: every expected value below is what
// Python returns for the same input.

import "std/ut"
import "koala/shlex"


func _check(got list[str]?, want list[str]) {
    ut.assert_true(got != nil)
    let tokens = got!
    ut.assert_eq(tokens.len(), want.len())
    for i in range(want.len()) {
        ut.assert_eq(tokens[i], want[i])
    }
}

@test
func test_split_1() {
    // 'a b c'
    let want = ["a", "b", "c"]
    _check(shlex.split("a b c"), want)
}

@test
func test_split_2() {
    // '  a   b  '
    let want = ["a", "b"]
    _check(shlex.split("  a   b  "), want)
}

@test
func test_split_3() {
    // ''
    let want = list[str]()
    _check(shlex.split(""), want)
}

@test
func test_split_4() {
    // '   '
    let want = list[str]()
    _check(shlex.split("   "), want)
}

@test
func test_split_5() {
    // 'add "buy milk" -p 1'
    let want = ["add", "buy milk", "-p", "1"]
    _check(shlex.split("add \"buy milk\" -p 1"), want)
}

@test
func test_split_6() {
    // "a 'b c' d"
    let want = ["a", "b c", "d"]
    _check(shlex.split("a 'b c' d"), want)
}

@test
func test_split_7() {
    // 'a\\ b'
    let want = ["a b"]
    _check(shlex.split("a\\ b"), want)
}

@test
func test_split_8() {
    // '"say \\"hi\\""'
    let want = ["say \"hi\""]
    _check(shlex.split("\"say \\\"hi\\\"\""), want)
}

@test
func test_split_9() {
    // 'x"y z"w'
    let want = ["xy zw"]
    _check(shlex.split("x\"y z\"w"), want)
}

@test
func test_split_10() {
