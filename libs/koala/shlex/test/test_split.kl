@test
func test_split_77() {
    // '"abc'
    ut.assert_true(shlex.split("\"abc") == nil)
}

@test
func test_split_78() {
    // "'abc"
    ut.assert_true(shlex.split("'abc") == nil)
}

@test
func test_split_79() {
    // 'abc\\'
    ut.assert_true(shlex.split("abc\\") == nil)
}

@test
func test_split_80() {
    // 'a "b'
    ut.assert_true(shlex.split("a \"b") == nil)
}

@test
func test_split_81() {
    // '"a\\'
    ut.assert_true(shlex.split("\"a\\") == nil)
}
