import "std/ut"
import "koala/redis"

@test
func test_empty() {
    let resp = redis.Response()
    ut.assert_true(resp.empty())
    ut.assert_eq(resp.len(), 0)
    ut.assert_true(resp.first() == nil)
    ut.assert_eq(resp.replies().len(), 0)
}

@test
func test_add_and_access() {
    let resp = redis.Response()
    resp.add(redis.StatusReply("OK"))
    resp.add(redis.IntReply(7))

    ut.assert_eq(resp.len(), 2)

    let first = resp.reply(0)
    ut.assert_true(first is redis.StatusReply)
    if first is redis.StatusReply {
        ut.assert_eq(first.value, "OK")
    }

    let second = resp.reply(1)
    ut.assert_true(second is redis.IntReply)
    if second is redis.IntReply {
        ut.assert_eq(second.value, 7)
    }

    ut.assert_true(resp.first() != nil)
}

@test
func test_replies_is_copy() {
    let resp = redis.Response()
    resp.add(redis.NilReply())

    let replies = resp.replies()
    replies.append(redis.IntReply(1))
    ut.assert_eq(resp.len(), 1)
}
