/// The root trait of all RESP2 reply values.
///
/// A reply is one of: status, bulk string, integer, nil, or array. The
/// concrete classes make the value tree type-safe without an `any` escape
/// hatch: an array's elements are themselves `Reply` instances. Errors are
/// not replies — they travel in `Result.err` as an integer code.
pub trait Reply {}

/// A simple-string reply, e.g. `+OK\r\n`.
pub class StatusReply : Reply {
    /// The status text without the leading `+` or the trailing CRLF.
    pub let value str

    /// Create a status reply holding `_value`.
    pub func __init__(_value str) {
        value = _value
    }
}

/// A bulk-string reply, e.g. `$3\r\nfoo\r\n`.
pub class BulkReply : Reply {
    /// The string content without the length header or the trailing CRLF.
    pub let value str

    /// Create a bulk reply holding `_value`.
    pub func __init__(_value str) {
        value = _value
    }
}

/// An integer reply, e.g. `:42\r\n`.
pub class IntReply : Reply {
    /// The integer value.
    pub let value int

    /// Create an integer reply holding `_value`.
    pub func __init__(_value int) {
        value = _value
    }
}

/// A nil reply, i.e. `$-1\r\n` for a missing bulk string or
/// `*-1\r\n` for a missing array.
pub class NilReply : Reply {
    pub func __init__() {}
}

/// An array reply, e.g. `*2\r\n$1\r\na\r\n$1\r\nb\r\n`.
pub class ArrayReply : Reply {
    /// The elements in wire order. Elements may be nested arrays.
    pub let items list[Reply]

    pub func __init__() {
        items = list[Reply]()
    }
}
