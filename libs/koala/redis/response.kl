/// An ordered sequence of replies received for one `Request`.
///
/// The server answers in request order, and a request with N commands
/// produces N replies, so `len()` of a response matches `len()` of the
/// request it was read for. Individual replies keep their concrete
/// type; `Response` only groups them.
///
/// Typed accessors are intentionally absent: the caller inspects the
/// concrete `Reply` class, and RedisClient wraps the common cases.
pub class Response {
    /// The replies in server order.
    let _replies list[Reply]

    pub func __init__() {
        _replies = list[Reply]()
    }

    /// Append one reply. Used by the client while draining a request.
    pub func add(reply Reply) {
        _replies.append(reply)
    }

    /// Return the number of replies.
    pub func len() int {
        return _replies.len()
    }

    /// Return true when no reply has been collected.
    pub func empty() bool {
        return _replies.len() == 0
    }

    /// Return the reply at `index`. Panics when out of range.
    pub func reply(index int) Reply {
        return _replies[index]
    }

    /// Return the first reply, or nil when the response is empty.
    pub func first() Reply? {
        if _replies.len() == 0 {
            return nil
        }
        return _replies[0]
    }

    /// Return a copy of all replies in server order.
    pub func replies() list[Reply] {
        return _replies.copy()
    }
}
