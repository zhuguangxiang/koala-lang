/// An ordered sequence of commands sent to the server in one request.
///
/// `Request` is the unit of the client/transport boundary: even a
/// single command travels as a one-command request. Encoding concatenates
/// each command frame, so a multi-command request is a pipeline and the
/// server answers with exactly `len()` replies, in order.
///
/// Transactions (MULTI/EXEC) are deliberately not modelled here yet;
/// when they land they can compose a `Request` instead of changing it.
pub class Request {
    /// The commands in wire order.
    let _commands list[Command]

    pub func __init__() {
        _commands = list[Command]()
    }

    /// Append one command and return `self` so calls chain.
    pub func add(cmd Command) Request {
        _commands.append(cmd)
        return self
    }

    /// Build a command from a word list and append it.
    pub func add_words(words list[str]) Request {
        return add(Command.from_words(words))
    }

    /// Return the number of commands, which is also the number of
    /// replies the server will send for this request.
    pub func len() int {
        return _commands.len()
    }

    /// Return true when the request holds no commands.
    pub func empty() bool {
        return _commands.len() == 0
    }

    /// Return a copy of the commands in wire order.
    pub func commands() list[Command] {
        return _commands.copy()
    }

    /// Encode every command frame back to back.
    ///
    /// The result is one bytes value so the caller can hand the whole
    /// request to a single write.
    pub func to_bytes() bytes {
        let buf = Buffer()
        for cmd in _commands {
            buf.write(cmd.to_bytes())
        }
        return buf.to_bytes()
    }
}
