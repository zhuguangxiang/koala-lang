// ---------- error codes ----------

pub let ERR_NOERR     int = 0
pub let ERR_SERVER    int = 1
pub let ERR_WRONGTYPE int = 2
pub let ERR_NOAUTH    int = 3
pub let ERR_IO        int = 4
pub let ERR_TIMEOUT   int = 5
pub let ERR_PROTOCOL  int = 6
pub let ERR_NOEXEC    int = 7

// ---------- code -> messages ----------

let error_msg = [
    "",                        // 0 NOERR
    "server error",            // 1 SERVER
    "wrong kind of value",     // 2 WRONGTYPE
    "authentication required", // 3 NOAUTH
    "io error",                // 4 IO
    "timeout",                 // 5 TIMEOUT
    "protocol error",          // 6 PROTOCOL
    "command not executed",    // 7 NOEXEC
]

/// Result holds the outcome of one Redis command: an integer error code
/// for the program to branch on, a human-readable message, and the reply
/// value. `err` is checked first; only then is `val` meaningful.
pub class Result {
    /// Decoded reply value; NilReply() when the server replied nil or when
    /// an error occurred.
    pub var val Reply = NilReply()
    /// Error code, one of ERR_*. ERR_NOERR means success.
    pub var err int = ERR_NOEXEC
    /// Human-readable error message; empty on success.
    pub var errmsg str = error_msg[ERR_NOEXEC]

    /// Zero result of a command that has not run: a nil reply and ERR_NOEXEC.
    pub func __init__() {}

    /// Successful result carrying a reply value.
    pub static func ok(v Reply) Result {
        let r = Result()
        r.val = v
        r.err = ERR_NOERR
        r.errmsg = ""
        return r
    }

    /// Failed result. If `msg` is empty, the default message for `code` is used.
    pub static func error(code int, msg str) Result {
        let r = Result()
        r.err = code
        if msg.len() > 0 {
            r.errmsg = msg
        } else {
            r.errmsg = error_msg[code]
        }
        return r
    }
}
