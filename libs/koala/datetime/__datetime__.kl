/// Date and time types with a Python-like API, implemented in pure Koala.
///
/// This package provides `Date` (a calendar date in the proleptic Gregorian
/// calendar), `Time` (a time of day with nanosecond resolution) and `DateTime`
/// (a date and time in UTC), plus the calendar helpers `is_leap_year` and
/// `days_in_month`. Timezone support lands in a later increment.
///
/// Every type conforms to `ToString` and `Printable`, so its two string forms
/// differ on purpose (mirroring Python `str()` vs `repr()`):
///   - `to_str()` / `str(x)` gives the raw, canonical ISO 8601 text;
///   - `fmt()` (used by `print(x)` and `format("{}", x)`) gives the display
///     form, wrapped in the type name.
///
/// `DateTime` bridges to `std/time`: `now()`, `to_instant()`, `from_instant()`
/// and `add(time.Duration)` interoperate with `time.Instant` / `time.Duration`.
///
/// Example:
///     let d = datetime.Date(2026, 10, 24)
///     print(d)                      // Date(2026-10-24)   (fmt: display)
///     print(d.to_str())             // 2026-10-24         (to_str: raw ISO)
///     print(d.weekday())            // 5 (Saturday)
///     print(d.add_days(7).to_str()) // 2026-10-31
///
///     let t = datetime.Time(13, 30, 45)
///     print(t.to_str())             // 13:30:45
///
///     let dt = datetime.DateTime(2026, 10, 24, 13, 30, 45)
///     print(dt)                     // DateTime(2026-10-24T13:30:45)
///     print(dt.to_str())            // 2026-10-24T13:30:45
