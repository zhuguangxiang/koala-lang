import "std/fs"

/// A named IANA timezone (e.g. `America/New_York`, `Asia/Shanghai`), loaded
/// from the operating system's zoneinfo database (`/usr/share/zoneinfo`).
///
/// This is the named-zone layer (like Python's `zoneinfo.ZoneInfo`, Go's
/// `time.LoadLocation`): it reads the system's TZif files and resolves the
/// UTC offset for a given instant, including daylight-saving transitions.
/// No tzdata is bundled — the OS provides it (Linux/macOS).
///
/// `ZoneInfo` resolves offsets; convert a [`DateTime`] into the zone with
/// [`DateTime.in_zone`]. The result is a fixed-offset snapshot of that
/// instant (the offset correct for the instant, DST included); retaining the
/// named zone for DST-aware arithmetic across transitions is a later step.
///
/// Note: this reads the TZif 32-bit block, covering roughly 1901–2038.
///
/// Examples
///
/// ```kl
/// let ny = datetime.ZoneInfo("America/New_York")
/// let utc = datetime.DateTime(2026, 7, 1, 12, 0, 0)   // summer (EDT, -04:00)
/// print(utc.in_zone(ny).to_str())                     // 2026-07-01T08:00:00-04:00
/// ```
pub class ZoneInfo {

    /// The IANA zone name (e.g. `Asia/Shanghai`).
    pub let name str

    let transitions list[int]
    let trans_type list[int]
    let offsets list[int]

    /// Load the named zone from the system zoneinfo database.
    /// Panic if the zone file cannot be read or is not a TZif file.
    pub func __init__(name str) {
        self.name = name
        let data = fs.read_all("/usr/share/zoneinfo/" + name, 1_000_000)
        if data.len() < 44 { panic("datetime.ZoneInfo: not a TZif file: " + name) }
        if data[0] != uint8('T') || data[1] != uint8('Z') || data[2] != uint8('i') || data[3] != uint8('f') {
            panic("datetime.ZoneInfo: bad TZif magic: " + name)
        }
        transitions = list[int]()
        trans_type = list[int]()
        offsets = list[int]()
        // TZif header counts (big-endian int32): leapcnt@28, timecnt@32,
        // typecnt@36, charcnt@40. Data block starts at byte 44.
        let timecnt = be_i32(data, 32)
        let typecnt = be_i32(data, 36)
        var pos = 44
        var i = 0
        while i < timecnt {
            transitions.append(be_i32(data, pos))
            pos = pos + 4
            i = i + 1
        }
        i = 0
        while i < timecnt {
            trans_type.append(int(data[pos]))
            pos = pos + 1
            i = i + 1
        }
        i = 0
        while i < typecnt {
            offsets.append(be_i32(data, pos))
            pos = pos + 6
            i = i + 1
        }
        if offsets.len() == 0 { panic("datetime.ZoneInfo: no offset types: " + name) }
    }

    /// Return the UTC offset in seconds for the given instant (Unix nanos),
    /// accounting for daylight-saving transitions.
    pub func offset_at(epoch_nanos int) int {
        var secs = epoch_nanos / NANOS_PER_SEC
        if epoch_nanos % NANOS_PER_SEC < 0 { secs = secs - 1 }
        var lo = 0
        var hi = transitions.len() - 1
        var idx = -1
        while lo <= hi {
            let mid = (lo + hi) / 2
            if transitions[mid] <= secs {
                idx = mid
                lo = mid + 1
            } else {
                hi = mid - 1
            }
        }
        if idx < 0 { return offsets[0] }
        return offsets[trans_type[idx]]
    }

    /// Return the fixed [`TimeZone`] in effect at the given instant.
    pub func timezone_at(epoch_nanos int) TimeZone {
        return TimeZone.of_seconds(offset_at(epoch_nanos))
    }

    /// Return the current date and time in this zone.
    pub func now() DateTime {
        return DateTime.now().in_zone(self)
    }

    /// Return the zone name (ToString).
    pub func to_str() str { return name }

    /// Format for display (Printable): `ZoneInfo(America/New_York)`.
    pub func fmt(f Formatter) {
        f.write_fmt("ZoneInfo({})", name)
    }
}

/// Read a big-endian signed 32-bit integer from `b` at `pos`, sign-extended.
func be_i32(b bytes, pos int) int {
    let v = (int(b[pos]) << 24) | (int(b[pos + 1]) << 16) | (int(b[pos + 2]) << 8) | int(b[pos + 3])
    if v >= 2147483648 { return v - 4294967296 }
    return v
}