/// A DB-API 2.0 interface for SQLite databases.
///
/// This package follows CPython's `sqlite3` module: the names, the
/// parameters, the defaults and the behaviour are Python's wherever Koala
/// allows it.
///
///     sqlite3.connect(database, timeout, isolation_level,   ->  Connection?
///                     cached_statements, uri)
///     conn.cursor() / execute / executemany / executescript
///     conn.commit() / rollback() / close()
///     cur.execute(sql, params, named)                        ->  Cursor?
///     cur.fetchone() / fetchmany(size) / fetchall()          ->  Row? / list[Row]?
///     cur.rowcount / lastrowid / description / arraysize
///     row[0] / row["name"] / row.keys() / len(row)
///
/// Where Koala differs - no exceptions, rows are `Row`, `named=` for named
/// parameters, a few attributes as methods - is listed on `Connection`.
/// What is not supported yet is in `docs/Koala_TODO.md` §85.
///
/// The SQLite engine is vendored unmodified in `native/sqlite3/` (see
/// `native/sqlite3/VERSION`) and built into `libkoala_sqlite3.so`, so no
/// system libsqlite3 is required.

/// Native symbols for this package live in `libkoala_sqlite3.so`.
link "koala_sqlite3"

/// The version of the SQLite library, as "3.54.1".
pub let sqlite_version = sqlite_libversion()

/// `sqlite_version` as numbers, as (3, 54, 1).
pub let sqlite_version_info = _version_info(sqlite_version)

// sqlite3_open_v2 flags.
const _OPEN_READWRITE = 2
const _OPEN_CREATE = 4
const _OPEN_URI = 64

/// Open a connection to the database file `database`, created when it does
/// not exist; `":memory:"` opens a database in memory. As in Python:
///
/// - `timeout` is how many seconds a statement waits for a lock held by
///   another connection before it fails with SQLITE_BUSY.
/// - `isolation_level` is "" (the default, as "DEFERRED"), "DEFERRED",
///   "IMMEDIATE" or "EXCLUSIVE", or nil for autocommit. Unless it is nil,
///   an INSERT, UPDATE, DELETE or REPLACE opens a transaction with
///   `BEGIN <isolation_level>` when none is open; `commit()` ends it.
/// - `cached_statements` is how many compiled statements the connection
///   keeps for reuse.
/// - `uri` reads `database` as a URI, as "file:app.db?mode=ro".
///
/// Returns nil when the database cannot be opened. Panics on an
/// `isolation_level` Python rejects.
pub func connect(database str, timeout float = 5.0, isolation_level str? = "",
                 cached_statements int = 128, uri bool = false) Connection? {
    let level = _isolation_level_of(isolation_level)

    var flags = _OPEN_READWRITE | _OPEN_CREATE
    if uri { flags = flags | _OPEN_URI }
    let timeout_ms = int(timeout * 1000.0)

    let db = db_open(database, flags, timeout_ms)
    if db == 0 { return nil }
    return Connection(db, level, cached_statements)
}

// `level` in upper case, as CPython keeps it. Panics on a level CPython
// refuses with a ValueError.
func _isolation_level_of(level str?) str? {
    if let name = level {
        let upper = name.upper()
        if upper == "" || upper == "DEFERRED" || upper == "IMMEDIATE" || upper == "EXCLUSIVE" {
            return upper
        }
        panic("sqlite3: isolation_level string must be '', 'DEFERRED', 'IMMEDIATE', or " +
              "'EXCLUSIVE'")
    }
    return nil
}

func _version_info(version str) (int, int, int) {
    let parts = version.split(".")
    return (parts[0].to_int(), parts[1].to_int(), parts[2].to_int())
}

// SQLite result codes, under the names CPython's `sqlite3` module exports
// them (Python 3.11 and later). The values are those of the vendored
// `sqlite3.h`, primary codes first, then the extended ones.
//
// `Connection.sqlite_errorcode()` returns one of them; an extended code
// keeps its primary code in the low 8 bits, so
// `code & 0xff == SQLITE_CONSTRAINT` matches every constraint failure.

pub const SQLITE_OK = 0
pub const SQLITE_ERROR = 1
pub const SQLITE_INTERNAL = 2
pub const SQLITE_PERM = 3
pub const SQLITE_ABORT = 4
pub const SQLITE_BUSY = 5
pub const SQLITE_LOCKED = 6
