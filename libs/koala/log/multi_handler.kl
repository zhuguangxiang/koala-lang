/// MultiHandler fans one formatted line out to several handlers.
///
/// Level filtering is done by `Logger`, not here: by the time
/// `write` is called the line has already been accepted. Every child
/// receives the same string.
pub class MultiHandler : Handler {
    let handlers list[Handler]

    /// Construct a MultiHandler over `_handlers`.
    pub func __init__(_handlers list[Handler]) {
        handlers = _handlers
    }

    /// Write `s` to every child handler.
    pub func write(s str) {
        for h in handlers { h.write(s) }
    }
}
