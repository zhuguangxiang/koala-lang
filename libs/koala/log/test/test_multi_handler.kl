import "std/ut"
import "koala/log"

/// A Handler that counts how many lines it was asked to write.
class CountingHandler : log.Handler {
    pub var calls int

    pub func __init__() {
        calls = 0
    }

    pub func write(s str) {
        calls = calls + 1
    }
}

@test
func test_fanout_writes_to_all_children() {
    let a = CountingHandler()
    let b = CountingHandler()

    let hs = list[log.Handler]()
    hs.append(a)
    hs.append(b)
    let mh = log.MultiHandler(hs)

    mh.write("x\n")
    ut.assert_eq(a.calls, 1)
    ut.assert_eq(b.calls, 1)

    mh.write("y\n")
    ut.assert_eq(a.calls, 2)
    ut.assert_eq(b.calls, 2)
}

@test
func test_empty_multi_handler_writes_nothing() {
    let hs = list[log.Handler]()
    let mh = log.MultiHandler(hs)

    mh.write("x\n")     // no children, no effect, no panic
    ut.assert_true(true)
}

@test
func test_multi_handler_through_logger() {
    let a = CountingHandler()
    let b = CountingHandler()

    let hs = list[log.Handler]()
    hs.append(a)
    hs.append(b)
    let mh = log.MultiHandler(hs)

    let l = log.Logger(mh, log.TextFormatter(), log.INFO)

    l.info("x")         // enabled by Logger, fanned out
    ut.assert_eq(a.calls, 1)
    ut.assert_eq(b.calls, 1)

    l.debug("y")        // filtered by Logger, neither child sees it
    ut.assert_eq(a.calls, 1)
    ut.assert_eq(b.calls, 1)
}
