import "std/ut"
import "koala/log"

/// A Handler that counts how many lines it was asked to write.
class CountingHandler : log.Handler {
    pub var calls int

    pub func __init__() {
        calls = 0
    }

    pub func write(s str) {
        calls = calls + 1
    }
}

@test
func test_default_logger_is_created() {
    log.get_default()
    ut.assert_true(true)
}

@test
func test_set_default_routes_package_calls() {
    let saved = log.get_default()

    let h = CountingHandler()
    log.set_default(log.Logger(h, log.TextFormatter(), log.TRACE))

    log.info("a")
    log.warn("b")
    ut.assert_eq(h.calls, 2)

    // Restore whatever was installed before this test.
    log.set_default(saved)
}

@test
func test_package_level_fast_path() {
    let saved = log.get_default()

    let h = CountingHandler()
    log.set_default(log.Logger(h, log.TextFormatter(), log.ERROR))

    log.info("a")   // filtered by Logger level
    log.error("b")  // written
    ut.assert_eq(h.calls, 1)

    // Restore whatever was installed before this test.
    log.set_default(saved)
}
