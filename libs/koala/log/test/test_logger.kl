import "std/ut"
import "koala/log"

/// A Handler that records every line it is asked to write.
class MockHandler : log.Handler {
    pub let lines list[str]

    pub func __init__() {
        lines = list[str]()
    }

    pub func write(s str) {
        lines.append(s)
    }
}

/// A Formatter that wraps the message in angle brackets, so the test
/// can tell formatted output apart from the raw message.
class MockFormatter : log.Formatter {
    pub func __init__() {}

    pub func format(r log.Record) str {
        return "<" + r.msg + ">"
    }
}

@test
func test_below_level_is_skipped() {
    let h = MockHandler()
    let l = log.Logger(h, MockFormatter(), log.WARN)
    l.info("x")                       // INFO < WARN
    ut.assert_eq(h.lines.len(), 0)
}

@test
func test_at_level_is_written() {
    let h = MockHandler()
    let l = log.Logger(h, MockFormatter(), log.INFO)
    l.info("hello")
    ut.assert_eq(h.lines.len(), 1)
    ut.assert_eq(h.lines[0], "<hello>")
}

@test
func test_above_level_is_written() {
    let h = MockHandler()
    let l = log.Logger(h, MockFormatter(), log.INFO)
    l.error("boom")
    ut.assert_eq(h.lines.len(), 1)
    ut.assert_eq(h.lines[0], "<boom>")
}

@test
func test_set_level() {
    let h = MockHandler()
    let l = log.Logger(h, MockFormatter(), log.WARN)

    l.info("a")                       // filtered
    ut.assert_eq(h.lines.len(), 0)

    l.set_level(log.DEBUG)
    l.info("b")                       // now passes
    ut.assert_eq(h.lines.len(), 1)
    ut.assert_eq(h.lines[0], "<b>")
}

@test
func test_level_methods_route() {
    let h = MockHandler()
    let l = log.Logger(h, MockFormatter(), log.TRACE)

    l.trace("a")
    l.debug("b")
    l.info("c")
    l.warn("d")
    l.error("e")
    l.fatal("f")

    ut.assert_eq(h.lines.len(), 6)
    ut.assert_eq(h.lines[0], "<a>")
    ut.assert_eq(h.lines[1], "<b>")
    ut.assert_eq(h.lines[2], "<c>")
    ut.assert_eq(h.lines[3], "<d>")
    ut.assert_eq(h.lines[4], "<e>")
    ut.assert_eq(h.lines[5], "<f>")
}
