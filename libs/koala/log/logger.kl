/// Logger is the front end: it holds a Handler, a Formatter and a
/// minimum level. A record is formatted and passed to the handler
/// only when its level is at or above the minimum.
pub class Logger {
    let _handler Handler
    let _fmt Formatter
    var _level int
    var attrs list[Attr]?

    pub func __init__(handler Handler, fmt Formatter, level int = INFO) {
        _handler = handler
        _fmt = fmt
        _level = level
    }

    /// Set the minimum level.
    pub func set_level(level int) { _level = level }

    /// Get the minimum level.
    pub func get_level() int { return _level }

    /// Get the attributes.
    pub func get_attrs() list[Attr]? { return attrs }

    /// Set the attributes. These are attached to every record emitted by this logger.
    pub func set_attrs(xs list[Attr]?) { attrs = xs }

    /// Emit a record at `lv`, or skip it when below the minimum.
    pub func log(lv int, msg str) {
        if lv < _level { return }
        let text = _fmt.format(Record(lv, msg, attrs));
        _handler.write(text)
    }

    pub func trace(msg str) { log(TRACE, msg) }
    pub func debug(msg str) { log(DEBUG, msg) }
    pub func info(msg str)  { log(INFO,  msg) }
    pub func warn(msg str)  { log(WARN,  msg) }
    pub func error(msg str) { log(ERROR, msg) }
    pub func fatal(msg str) { log(FATAL, msg) }
}
