// RUN: koala --test %s

// Unit tests for the extended math functions (gcd/lcm/factorial/comb/perm,
// angle conversion, and floating-point helpers).

import "std/ut"
import "koala/math"

// ==================== Constants ====================

@test
func test_tau() {
    ut.assert_float_close(math.TAU, 2.0 * math.PI, 1e-15)
    ut.assert_float_close(math.TAU, 6.283185307179586, 1e-15)
}

// ==================== gcd / lcm ====================

@test
func test_gcd_basic() {
    ut.assert_eq(math.gcd(12, 18), 6)
    ut.assert_eq(math.gcd(18, 12), 6)
    ut.assert_eq(math.gcd(7, 13), 1)
    ut.assert_eq(math.gcd(100, 10), 10)
}

@test
func test_gcd_zero_and_negative() {
    ut.assert_eq(math.gcd(0, 0), 0)
    ut.assert_eq(math.gcd(0, 5), 5)
    ut.assert_eq(math.gcd(5, 0), 5)
    ut.assert_eq(math.gcd(-12, 18), 6)
    ut.assert_eq(math.gcd(12, -18), 6)
    ut.assert_eq(math.gcd(-12, -18), 6)
}

@test
func test_lcm_basic() {
    ut.assert_eq(math.lcm(4, 6), 12)
    ut.assert_eq(math.lcm(3, 5), 15)
    ut.assert_eq(math.lcm(7, 7), 7)
}

@test
func test_lcm_zero_and_negative() {
    ut.assert_eq(math.lcm(0, 5), 0)
    ut.assert_eq(math.lcm(5, 0), 0)
    ut.assert_eq(math.lcm(-4, 6), 12)
    ut.assert_eq(math.lcm(4, -6), 12)
}

// ==================== factorial / comb / perm ====================

@test
func test_factorial() {
    ut.assert_eq(math.factorial(0), 1)
    ut.assert_eq(math.factorial(1), 1)
    ut.assert_eq(math.factorial(5), 120)
    ut.assert_eq(math.factorial(10), 3628800)
    ut.assert_eq(math.factorial(20), 2432902008176640000)
}

@test
func test_comb() {
    ut.assert_eq(math.comb(5, 2), 10)
    ut.assert_eq(math.comb(5, 0), 1)
    ut.assert_eq(math.comb(5, 5), 1)
    ut.assert_eq(math.comb(10, 3), 120)
    ut.assert_eq(math.comb(5, 6), 0)
    ut.assert_eq(math.comb(5, -1), 0)
}

@test
func test_comb_symmetry() {
    ut.assert_eq(math.comb(8, 3), math.comb(8, 5))
    ut.assert_eq(math.comb(20, 7), math.comb(20, 13))
}

@test
func test_perm() {
    ut.assert_eq(math.perm(5, 2), 20)
    ut.assert_eq(math.perm(5, 0), 1)
    ut.assert_eq(math.perm(5, 5), 120)
    ut.assert_eq(math.perm(5, 6), 0)
    ut.assert_eq(math.perm(5, -1), 0)
}

// ==================== Angle conversion ====================

@test
func test_degrees() {
    ut.assert_float_close(math.degrees(math.PI), 180.0, 1e-12)
    ut.assert_float_close(math.degrees(math.PI / 2.0), 90.0, 1e-12)
    ut.assert_float_close(math.degrees(0.0), 0.0, 1e-12)
}

@test
func test_radians() {
    ut.assert_float_close(math.radians(180.0), math.PI, 1e-12)
    ut.assert_float_close(math.radians(90.0), math.PI / 2.0, 1e-12)
    ut.assert_float_close(math.radians(0.0), 0.0, 1e-12)
}

@test
func test_angle_roundtrip() {
    ut.assert_float_close(math.radians(math.degrees(1.234)), 1.234, 1e-12)
}

// ==================== isclose ====================

@test
func test_isclose() {
    ut.assert_true(math.isclose(1.0, 1.0))
    ut.assert_true(math.isclose(1.0, 1.0 + 1e-10))
    ut.assert_false(math.isclose(1.0, 2.0))
    ut.assert_false(math.isclose(1.0, 1.1))
}

@test
func test_isclose_abs_tol() {
    ut.assert_false(math.isclose(0.0, 1e-10))
    ut.assert_true(math.isclose(0.0, 1e-10, 1e-9, 1e-9))
}

@test
func test_isclose_inf_nan() {
    ut.assert_true(math.isclose(math.INF, math.INF))
    ut.assert_false(math.isclose(math.INF, 1.0))
    ut.assert_false(math.isclose(math.NAN, math.NAN))
    ut.assert_false(math.isclose(math.NAN, 1.0))
}

// ==================== trunc / fmod ====================

@test
func test_trunc() {
    ut.assert_float_eq(math.trunc(3.7), 3.0)
    ut.assert_float_eq(math.trunc(-3.7), -3.0)
    ut.assert_float_eq(math.trunc(0.0), 0.0)
    ut.assert_float_eq(math.trunc(5.0), 5.0)
    ut.assert_float_eq(math.trunc(-5.0), -5.0)
}

@test
func test_fmod() {
    ut.assert_float_close(math.fmod(5.5, 2.0), 1.5, 1e-12)
    ut.assert_float_close(math.fmod(-5.5, 2.0), -1.5, 1e-12)
    ut.assert_float_close(math.fmod(5.5, -2.0), 1.5, 1e-12)
    ut.assert_float_close(math.fmod(6.0, 3.0), 0.0, 1e-12)
}

// ==================== hypot / cbrt / exp2 ====================

@test
func test_hypot() {
    ut.assert_float_close(math.hypot(3.0, 4.0), 5.0, 1e-12)
    ut.assert_float_close(math.hypot(0.0, 0.0), 0.0, 1e-12)
    ut.assert_float_close(math.hypot(1.0, 1.0), math.sqrt(2.0), 1e-12)
}

@test
func test_cbrt() {
    ut.assert_float_close(math.cbrt(27.0), 3.0, 1e-12)
    ut.assert_float_close(math.cbrt(-8.0), -2.0, 1e-12)
    ut.assert_float_close(math.cbrt(0.0), 0.0, 1e-12)
    ut.assert_float_close(math.cbrt(1.0), 1.0, 1e-12)
}

@test
func test_exp2() {
    ut.assert_float_close(math.exp2(10.0), 1024.0, 1e-9)
    ut.assert_float_close(math.exp2(0.0), 1.0, 1e-12)
    ut.assert_float_close(math.exp2(-1.0), 0.5, 1e-12)
}

// ==================== log1p / expm1 ====================

@test
func test_log1p() {
    ut.assert_float_close(math.log1p(0.0), 0.0, 1e-12)
    ut.assert_float_close(math.log1p(math.E - 1.0), 1.0, 1e-12)
    ut.assert_float_close(math.log1p(1.0), math.log(2.0), 1e-12)
}

@test
func test_expm1() {
    ut.assert_float_close(math.expm1(0.0), 0.0, 1e-12)
    ut.assert_float_close(math.expm1(1.0), math.E - 1.0, 1e-12)
}

// ==================== Error branches ====================

@should_panic("math.factorial: negative input")
func test_factorial_negative() {
    math.factorial(-1)
}

@should_panic("math.factorial: overflow")
func test_factorial_overflow() {
    math.factorial(21)
}

@should_panic("math.fmod: zero divisor")
func test_fmod_zero() {
    math.fmod(1.0, 0.0)
}

@should_panic("math.log1p: domain error")
func test_log1p_domain() {
    math.log1p(-2.0)
}