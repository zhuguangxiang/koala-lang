import "std/fs"
import "koala/zlib"

/// Store the member as it is: no compression.
pub const ZIP_STORED = 0

/// Compress the member with DEFLATE, the format `koala/zlib` implements.
pub const ZIP_DEFLATED = 8

/// BZIP2. Declared for parity with CPython; using it panics.
pub const ZIP_BZIP2 = 12

/// LZMA. Declared for parity with CPython; using it panics.
pub const ZIP_LZMA = 14

/// Signature of a local file header: "PK\3\4".
const SIG_LOCAL = 0x04034b50

/// Signature of a central directory header: "PK\1\2".
const SIG_CENTRAL = 0x02014b50

/// Signature of the end-of-central-directory record: "PK\5\6".
const SIG_EOCD = 0x06054b50

/// Bytes in a local file header, before the name and the extra field.
const LOCAL_LEN = 30

/// Bytes in a central directory header, before its three variable fields.
const CENTRAL_LEN = 46

/// Bytes in an end-of-central-directory record, before the comment.
const EOCD_LEN = 22

/// Bytes a `str` takes when a header stores it: CPython writes UTF-8 and sets
/// the "language encoding" flag bit for anything outside ASCII.
func name_len(s str) int {
    return s.to_bytes().len()
}

/// The last path component of `path`, used when `write()` gets no `arcname`.
func base_name(path str) str {
    var i = path.len() - 1
    while i >= 0 {
        if path[i] == "/" { return path.substr(i + 1, path.len()) }
        i -= 1
    }
    return path
}

/// Ensure that `path` exists and is a directory, creating the missing parts.
func make_dirs(path str) {
    if path.len() == 0 { return }
    if fs.exists(path) { return }
    var i = 1
    while i <= path.len() {
        if i == path.len() || path[i] == "/" {
            let part = path.substr(0, i)
            if part.len() > 0 && !fs.exists(part) { fs.mkdir(part) }
        }
        i += 1
    }
}

func rd_u16(b bytes, off int) int {
    return int(b[off]) | (int(b[off + 1]) << 8)
}

func rd_u32(b bytes, off int) int {
    return int(b[off]) | (int(b[off + 1]) << 8) | (int(b[off + 2]) << 16) |
           (int(b[off + 3]) << 24)
}

func wr_u16(buf Buffer, v int) {
    buf.write_byte(uint8(v & 0xff))
    buf.write_byte(uint8((v >> 8) & 0xff))
}

func wr_u32(buf Buffer, v int) {
    wr_u16(buf, v & 0xffff)
    wr_u16(buf, (v >> 16) & 0xffff)
}

/// The MS-DOS time field for a `(year, month, day, hour, minute, second)`
/// tuple: hours, minutes and two-second units, packed.
func dos_time(date_time (int, int, int, int, int, int)) int {
    let (_, _, _, hour, minute, second) = date_time
    return (hour << 11) | (minute << 5) | (second / 2)
}

/// The MS-DOS date field for a `(year, month, day, hour, minute, second)`
/// tuple: years since 1980, month and day, packed.
func dos_date(date_time (int, int, int, int, int, int)) int {
    let (year, month, day, _, _, _) = date_time
    return ((year - 1980) << 9) | (month << 5) | day
}

/// Unpack the MS-DOS time and date fields into Python's six-tuple.
func from_dos(t int, d int) (int, int, int, int, int, int) {
    let year = ((d >> 9) & 0x7f) + 1980
    let month = (d >> 5) & 0x0f
    let day = d & 0x1f
    let hour = (t >> 11) & 0x1f
    let minute = (t >> 5) & 0x3f
    let second = (t & 0x1f) * 2
    return (year, month, day, hour, minute, second)
}

/// Offset of the end-of-central-directory record, or -1 when `data` is not a
/// ZIP archive.
///
/// The record is at the very end apart from the archive comment, so the search
/// walks backwards from the last possible position - the same approach
/// CPython's `_EndRecData` takes.
func find_eocd(data bytes) int {
    if data.len() < EOCD_LEN { return -1 }
    var i = data.len() - EOCD_LEN
    while i >= 0 {
        if rd_u32(data, i) == SIG_EOCD { return i }
        i -= 1
    }
    return -1
}

/// One member of an archive: Python's `zipfile.ZipInfo`.
///
/// The attribute names are Python's (`filename`, `date_time`, `compress_type`,
/// `comment`, `extra`, `create_system`, `create_version`, `extract_version`,
/// `flag_bits`, `volume`, `internal_attr`, `external_attr`, `header_offset`,
/// `CRC`, `compress_size`, `file_size`, `orig_filename`) and they are fields,
/// not methods.
///
/// The two constructor parameters are spelled `arcname` and `dt` rather than
/// Python's `filename` and `date_time`: Koala rejects a parameter that shadows
/// a field name. Positional calls read the same as in Python.
pub class ZipInfo {
    /// The member name inside the archive, `/`-separated.
    pub var filename str

    /// `(year, month, day, hour, minute, second)` in local time.
    pub var date_time (int, int, int, int, int, int)

    /// `ZIP_STORED`, `ZIP_DEFLATED` or another `ZIP_*` constant.
    pub var compress_type int

    /// The member's comment, empty unless an archive carries one.
    pub var comment bytes

    /// The "extra field" bytes, empty unless an archive carries them.
    pub var extra bytes

    /// 0 for MS-DOS, 3 for Unix - what created the member.
    pub var create_system int

    /// The version of the creating tool, as a two-byte packed value.
    pub var create_version int

    /// The version needed to extract the member.
    pub var extract_version int

    /// The general purpose bit flags, e.g. 0x800 for a UTF-8 name.
    pub var flag_bits int

    /// The volume number the member starts on.
    pub var volume int

    /// Internal file attributes.
    pub var internal_attr int

    /// External file attributes, Unix mode in the high sixteen bits.
    pub var external_attr int

    /// Offset of the member's local header in the archive.
    pub var header_offset int

    /// The CRC-32 of the uncompressed data; Python spells it `CRC`.
    pub var CRC int

    /// The compressed size in bytes.
    pub var compress_size int

    /// The uncompressed size in bytes.
    pub var file_size int

    /// The name as stored, before UTF-8 decoding; Python's `orig_filename`.
    pub var orig_filename str

    /// Create a member. `dt` defaults to 1980-01-01 00:00:00, the same tuple
    /// Python uses, because ZIP cannot represent anything earlier.
    pub func __init__(arcname = "NoName", dt (int, int, int, int, int, int)? = nil) {
        filename = arcname
        orig_filename = arcname
        date_time = dt ?? (1980, 1, 1, 0, 0, 0)
        compress_type = ZIP_STORED
        comment = bytes(0)
        extra = bytes(0)
        create_system = 3
        create_version = 20
        extract_version = 20
        flag_bits = 0
        volume = 0
        internal_attr = 0
        external_attr = 0
        header_offset = 0
        CRC = 0
        compress_size = 0
        file_size = 0
    }

    /// True when the member name ends in `/`, which is how ZIP records a
    /// directory.
    pub func is_dir() bool {
        if filename.len() == 0 { return false }
        return filename[filename.len() - 1] == "/"
    }
}

/// The central directory of `data`, one `ZipInfo` per member.
///
/// The central directory is the authoritative index in a ZIP archive: it
/// carries the name, the sizes, the CRC and the offset of every local header,
/// which is why both `namelist()` and `infolist()` come straight from here.
func read_central(data bytes) list[ZipInfo] {
    let infos = list[ZipInfo]()
    let eocd = find_eocd(data)
    if eocd < 0 { panic("zipfile: File is not a zip file") }

    let count = rd_u16(data, eocd + 10)
    var off = rd_u32(data, eocd + 16)
    var i = 0
    while i < count {
        if off + CENTRAL_LEN > data.len() {
            panic("zipfile: Bad magic number for central directory")
        }
        if rd_u32(data, off) != SIG_CENTRAL {
            panic("zipfile: Bad magic number for central directory")
        }

        let info = ZipInfo()
        info.create_version = rd_u16(data, off + 4)
        info.create_system = (rd_u16(data, off + 4) >> 8) & 0xff
        info.extract_version = rd_u16(data, off + 6)
        info.flag_bits = rd_u16(data, off + 8)
        info.compress_type = rd_u16(data, off + 10)
        info.date_time = from_dos(rd_u16(data, off + 12), rd_u16(data, off + 14))
        info.CRC = rd_u32(data, off + 16)
        info.compress_size = rd_u32(data, off + 20)
        info.file_size = rd_u32(data, off + 24)
        let nlen = rd_u16(data, off + 28)
        let elen = rd_u16(data, off + 30)
        let clen = rd_u16(data, off + 32)
        info.volume = rd_u16(data, off + 34)
        info.internal_attr = rd_u16(data, off + 36)
        info.external_attr = rd_u32(data, off + 38)
        info.header_offset = rd_u32(data, off + 42)

        let name_at = off + CENTRAL_LEN
        info.filename = data.view(name_at, name_at + nlen).to_str()
        info.orig_filename = info.filename
        if elen > 0 { info.extra = data.view(name_at + nlen, name_at + nlen + elen) }
        if clen > 0 {
            info.comment = data.view(name_at + nlen + elen, name_at + nlen + elen + clen)
        }

        infos.append(info)
        off = name_at + nlen + elen + clen
        i += 1
    }
    return infos
}

/// The compressed bytes of `info`, located through its local file header.
func member_payload(data bytes, info ZipInfo) bytes {
    let off = info.header_offset
    if off + LOCAL_LEN > data.len() {
        panic("zipfile: Bad magic number for file header")
    }
    if rd_u32(data, off) != SIG_LOCAL {
        panic("zipfile: Bad magic number for file header")
    }
    let start = off + LOCAL_LEN + rd_u16(data, off + 26) + rd_u16(data, off + 28)
    if start + info.compress_size > data.len() {
        panic("zipfile: Truncated file header")
    }
    return data.view(start, start + info.compress_size)
}

/// Index of the last `/` in `s`, or -1.
func last_slash(s str) int {
    var i = s.len() - 1
    while i >= 0 {
        if s[i] == "/" { return i }
        i -= 1
    }
    return -1
}

/// The "version made by" field of a central directory header: the creating
/// system in the high byte and the tool version in the low one - the layout
/// APPNOTE.TXT defines, and the reason Python's archives report system 3
/// (Unix) while ours start out the same way.
func made_by(info ZipInfo) int {
    return ((info.create_system & 0xff) << 8) | (info.create_version & 0xff)
}

/// A ZIP archive: Python's `zipfile.ZipFile`.
///
/// `mode` is `"r"` (read, the default), `"w"` (write a new archive), `"x"`
/// (write, and refuse to overwrite) or `"a"` (append: the members already
/// there are kept). Reading happens immediately; writing only touches the disk
/// in `close()`.
///
/// `filename` and `comment` are fields, like Python's attributes. `mode` is a
/// method here because it is also a constructor parameter, and Koala rejects a
/// parameter that shadows a field.
pub class ZipFile {
    /// The archive's path; Python's `ZipFile.filename`.
    pub let filename str

    /// The archive comment, stored in the end-of-central-directory record.
    pub var comment bytes

    var _mode str
    var _compression int
    var _compresslevel int
    var _infos list[ZipInfo]
    var _blobs list[bytes]
    var _raw bytes
    var _closed bool

    /// Open a ZIP archive.
    ///
    /// `compression` is the default compression for members written without an
    /// explicit choice, `compresslevel` the DEFLATE level (`nil` means the
    /// engine default, which is what Python does).
    ///
    /// Panics with `"zipfile: File is not a zip file"` when a file opened for
    /// reading is not an archive, the wording CPython's `BadZipFile` uses.
    pub func __init__(file str, mode = "r", compression = ZIP_STORED,
                      allowZip64 = true, compresslevel int? = nil) {
        if mode != "r" && mode != "w" && mode != "x" && mode != "a" {
            panic(format("zipfile: mode must be 'r', 'w', 'x' or 'a', not '{}'", mode))
        }
        if mode == "x" && fs.exists(file) {
            panic(format("zipfile: File exists: '{}'", file))
        }
        filename = file
        _mode = mode
        _compression = compression
        _compresslevel = compresslevel ?? -1
        comment = bytes(0)
        _infos = list[ZipInfo]()
        _blobs = list[bytes]()
        _raw = bytes(0)
        _closed = false

        if mode == "r" || mode == "a" {
            _raw = fs.read_all(file, -1)
            let eocd = find_eocd(_raw)
            if eocd < 0 { panic("zipfile: File is not a zip file") }
            _infos = read_central(_raw)
            let clen = rd_u16(_raw, eocd + 20)
            if clen > 0 { comment = _raw.view(eocd + EOCD_LEN, eocd + EOCD_LEN + clen) }

            // Appending rewrites the archive from these compressed blobs, so
            // the members already there survive the round trip unchanged.
            if mode == "a" {
                for info in _infos {
                    _blobs.append(member_payload(_raw, info))
                }
            }
        }
    }

    /// The mode string this archive was opened with; Python's `ZipFile.mode`.
    pub func mode() str {
        return _mode
    }

    /// The member names, in the order the central directory lists them.
    pub func namelist() list[str] {
        let out = list[str]()
        for info in _infos {
            out.append(info.filename)
        }
        return out
    }

    /// Every member's `ZipInfo`, as a fresh list.
    pub func infolist() list[ZipInfo] {
        let out = list[ZipInfo]()
        for info in _infos {
            out.append(info)
        }
        return out
    }

    /// The `ZipInfo` of `name`.
    ///
    /// Panics with Python's `KeyError` wording when the archive has no such
    /// member.
    pub func getinfo(name str) ZipInfo {
        for info in _infos {
            if info.filename == name { return info }
        }
        panic(format("zipfile: \"There is no item named '{}' in the archive\"", name))
    }

    /// The uncompressed bytes of `name`; Python's `ZipFile.read()`.
    ///
    /// `pwd` is accepted for signature parity but encryption is not supported,
    /// so passing anything but `nil` panics.
    pub func read(name str, pwd bytes? = nil) bytes {
        if _mode != "r" && _mode != "a" {
            panic("zipfile: read() needs a file opened for reading")
        }
        if pwd != nil {
            panic("zipfile: encrypted members are not supported")
        }
        let info = getinfo(name)
        let raw = member_payload(_raw, info)
        var data = raw
        if info.compress_type == ZIP_DEFLATED {
            data = zlib.decompress(raw, -15)
        } else if info.compress_type != ZIP_STORED {
            panic(format("zipfile: that compression method ({}) is not supported",
                         info.compress_type))
        }
        // Unlike Python, the CRC is checked here rather than in an optional
        // step: a corrupt member is a corrupt read.
        let got = zlib.crc32(data)
        if got != info.CRC {
            panic(format("zipfile: Bad CRC-32 for file '{}'", info.filename))
        }
        return data
    }

    /// Compress `data` and record it as a member.
    ///
    /// `arcname` is a `ZipInfo` when the member's metadata matters, or a
    /// `str` member name; `data` may be `bytes` or `str` (encoded UTF-8).
    /// `compress_type` and `compresslevel` override the archive defaults, as
    /// they do in Python.
    pub func writestr(arcname ZipInfo | str, data bytes | str,
                      compress_type int? = nil, compresslevel int? = nil) {
        if _mode != "w" && _mode != "x" && _mode != "a" {
            panic("zipfile: writestr() needs a file opened for writing")
        }

        var info = ZipInfo()
        var given_meta = false
        if arcname is ZipInfo {
            info = arcname
            given_meta = true
        } else if arcname is str {
            info = ZipInfo(arcname)
        } else {
            unreachable()
        }

        var payload = bytes(0)
        if data is bytes {
            payload = data
        } else if data is str {
            payload = data.to_bytes()
        } else {
            unreachable()
        }

        var ct = info.compress_type
        if !given_meta { ct = _compression }
        if compress_type != nil { ct = compress_type }

        var level = compresslevel ?? _compresslevel
        if level < 0 { level = 6 }

        var stored = payload
        if ct == ZIP_DEFLATED {
            stored = zlib.compress(payload, level, -15)
        } else if ct != ZIP_STORED {
            panic(format("zipfile: that compression method ({}) is not supported", ct))
        }

        info.compress_type = ct
        info.CRC = zlib.crc32(payload)
        info.file_size = payload.len()
        info.compress_size = stored.len()
        if name_len(info.filename) > 0xffff {
            panic("zipfile: member name is too long")
        }
        if info.file_size > 0xffffffff || info.compress_size > 0xffffffff {
            panic("zipfile: ZIP64 is not supported")
        }

        _infos.append(info)
        _blobs.append(stored)
    }

    /// Read the file `path` and record it; Python's `ZipFile.write()`.
    ///
    /// The first parameter is spelled `path` rather than Python's `filename`
    /// because `filename` is this archive's own attribute - Koala rejects a
    /// parameter that shadows a field. Positional calls are unaffected.
    /// `arcname` defaults to the file's base name, and `compress_type` /
    /// `compresslevel` override the archive defaults.
    pub func write(path str, arcname = "", compress_type int? = nil,
                   compresslevel int? = nil) {
        let data = fs.read_all(path, -1)
        var name = arcname
        if name.len() == 0 { name = base_name(path) }
        writestr(ZipInfo(name), data, compress_type, compresslevel)
    }

    /// Extract one member to `path` and return the file it wrote.
    ///
    /// Directories in the member name are created, as Python does.
    pub func extract(member str, path = "") str {
        let info = getinfo(member)
        var full = info.filename
        if path.len() > 0 { full = format("{}/{}", path, info.filename) }
        if info.is_dir() {
            make_dirs(full)
            return full
        }
        let cut = last_slash(full)
        if cut > 0 { make_dirs(full.substr(0, cut)) }
        if !fs.write_bytes(full, read(member)) {
            panic(format("zipfile: failed to write '{}'", full))
        }
        return full
    }

    /// Extract every member (`members` limits it to those names).
    pub func extractall(path = "", members list[str]? = nil) {
        if members == nil {
            for info in _infos {
                extract(info.filename, path)
            }
        } else {
            for name in members {
                extract(name, path)
            }
        }
    }

    /// Print a table of the archive's contents, like Python's `printdir()`.
    pub func printdir() {
        print("File Name                                             Modified             Size")
        for info in _infos {
            let (year, month, day, hour, minute, second) = info.date_time
            print(format("{}\t{}-{}-{} {}:{}:{}\t{}", info.filename, year, month, day,
                         hour, minute, second, info.file_size))
        }
    }

    /// The name of the first member whose CRC-32 does not match, or nil when
    /// they all check out; Python's `testzip()`.
    pub func testzip() str? {
        for info in _infos {
            let raw = member_payload(_raw, info)
            var data = raw
            if info.compress_type == ZIP_DEFLATED {
                data = zlib.decompress(raw, -15)
            }
            if zlib.crc32(data) != info.CRC { return info.filename }
        }
        return nil
    }

    /// Write the archive out (write modes) or release it (read modes).
    ///
    /// In `"w"`, `"x"` and `"a"` mode this is where the local headers, the
    /// member data, the central directory and the end-of-central-directory
    /// record are laid down. Calling it twice does nothing, which replaces
    /// Python's `with` statement.
    pub func close() {
        if _closed { return }
        _closed = true
        if _mode == "r" { return }

        let body = Buffer()
        var i = 0
        while i < _infos.len() {
            let info = _infos[i]
            let blob = _blobs[i]
            let name = info.filename.to_bytes()
            info.header_offset = body.len()
            wr_u32(body, SIG_LOCAL)
            wr_u16(body, info.extract_version)
            wr_u16(body, info.flag_bits)
            wr_u16(body, info.compress_type)
            wr_u16(body, dos_time(info.date_time))
            wr_u16(body, dos_date(info.date_time))
            wr_u32(body, info.CRC)
            wr_u32(body, info.compress_size)
            wr_u32(body, info.file_size)
            wr_u16(body, name.len())
            wr_u16(body, info.extra.len())
            body.write(name)
            body.write(info.extra)
            body.write(blob)
            i += 1
        }

        let cd_start = body.len()
        i = 0
        while i < _infos.len() {
            let info = _infos[i]
            let name = info.filename.to_bytes()
            wr_u32(body, SIG_CENTRAL)
            wr_u16(body, made_by(info))
            wr_u16(body, info.extract_version)
            wr_u16(body, info.flag_bits)
            wr_u16(body, info.compress_type)
            wr_u16(body, dos_time(info.date_time))
            wr_u16(body, dos_date(info.date_time))
            wr_u32(body, info.CRC)
            wr_u32(body, info.compress_size)
            wr_u32(body, info.file_size)
            wr_u16(body, name.len())
            wr_u16(body, info.extra.len())
            wr_u16(body, info.comment.len())
            wr_u16(body, info.volume)
            wr_u16(body, info.internal_attr)
            wr_u32(body, info.external_attr)
            wr_u32(body, info.header_offset)
            body.write(name)
            body.write(info.extra)
            body.write(info.comment)
            i += 1
        }
        let cd_size = body.len() - cd_start

        wr_u32(body, SIG_EOCD)
        wr_u16(body, 0)
        wr_u16(body, 0)
        wr_u16(body, _infos.len())
        wr_u16(body, _infos.len())
        wr_u32(body, cd_size)
        wr_u32(body, cd_start)
        wr_u16(body, comment.len())
        body.write(comment)

        if !fs.write_bytes(filename, body.to_bytes()) {
            panic(format("zipfile: failed to write '{}'", filename))
        }
    }
}

/// True when `source` (a path, or the archive bytes) is a ZIP archive;
/// Python's `zipfile.is_zipfile()`.
///
/// Like Python, a path that does not exist is not an error: it is simply not
/// an archive.
pub func is_zipfile(source str | bytes) bool {
    // Each branch narrows the union with its own `is`, the idiom `std/fs`
    // uses for `Path | str`: no `as`, no bang operator.
    if source is str {
        if !fs.exists(source) { return false }
        return find_eocd(fs.read_all(source, -1)) >= 0
    } else if source is bytes {
        return find_eocd(source) >= 0
    } else {
        unreachable()
    }
}