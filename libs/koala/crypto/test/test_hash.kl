import "std/ut"
import "koala/crypto" as cr

@test
func test_sha1_abc() {
    ut.assert_eq(cr.sha1("abc".to_bytes()).to_hex(),
        "a9993e364706816aba3e25717850c26c9cd0d89d")
}

@test
func test_sha224_abc() {
    ut.assert_eq(cr.sha224("abc".to_bytes()).to_hex(),
        "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7")
}

@test
func test_sha256_abc() {
    ut.assert_eq(cr.sha256("abc".to_bytes()).to_hex(),
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
}

@test
func test_sha384_abc() {
    ut.assert_eq(cr.sha384("abc".to_bytes()).to_hex(),
        "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed" +
        "8086072ba1e7cc2358baeca134c825a7")
}

@test
func test_sha512_abc() {
    ut.assert_eq(cr.sha512("abc".to_bytes()).to_hex(),
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a" +
        "2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
}

@test
func test_sha3_224_abc() {
    ut.assert_eq(cr.sha3_224("abc".to_bytes()).to_hex(),
        "e642824c3f8cf24ad09234ee7d3c766fc9a3a5168d0c94ad73b46fdf")
}

@test
func test_sha3_256_abc() {
    ut.assert_eq(cr.sha3_256("abc".to_bytes()).to_hex(),
        "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")
}

@test
func test_sha3_384_abc() {
    ut.assert_eq(cr.sha3_384("abc".to_bytes()).to_hex(),
        "ec01498288516fc926459f58e2c6ad8df9b473cb0fc08c2596da7cf0e49be4b2" +
        "98d88cea927ac7f539f1edf228376d25")
}

@test
func test_sha3_512_abc() {
    ut.assert_eq(cr.sha3_512("abc".to_bytes()).to_hex(),
        "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e" +
        "10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0")
}

@test
func test_md5_abc() {
    ut.assert_eq(cr.md5("abc".to_bytes()).to_hex(),
        "900150983cd24fb0d6963f7d28e17f72")
}

@test
func test_sha256_empty() {
    ut.assert_eq(cr.sha256(bytes(0)).to_hex(),
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
}
