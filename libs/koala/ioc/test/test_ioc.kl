// RUN: koala --test %s

// Unit tests for the ioc package (libs/koala/ioc). Each test uses its own
// component class so the global container's state never couples the tests.

import "std/ut"
import "std/gc"
import "koala/ioc"

class Counter {
    var n int
    pub func __init__() { self.n = 0 }
    pub func bump() int { self.n = self.n + 1; return self.n }
}

class GcCounter {
    var n int
    pub func __init__() { self.n = 0 }
    pub func bump() int { self.n = self.n + 1; return self.n }
}

class Repo {
    var name str
    pub func __init__() { self.name = "users" }
    pub func table() str { return self.name }
}

class Box[T] {
    var v T
    pub func __init__() {}
}

class NeedsArg {
    var x int
    pub func __init__(x int) { self.x = x }
}

class Service {
    var tag str
    pub func __init__() { self.tag = "svc" }
    pub func label() str { return self.tag }
}

// The first get runs __init__ and caches the instance; later gets return the
// same object, and re-registering the type is a no-op.
@test
func test_singleton_cache() {
    ioc.register(Counter)

    let a = (ioc.get(Counter) as Counter)!
    ut.assert_eq(a.bump(), 1)

    let b = (ioc.get(Counter) as Counter)!
    ut.assert_eq(b.bump(), 2)
    ut.assert_eq(a.n, 2)

    ioc.register(Counter)
    let c = (ioc.get(Counter) as Counter)!
    ut.assert_eq(c.bump(), 3)
}

// A cached singleton is a GC root: it survives collections and is returned
// unchanged afterwards.
@test
func test_survives_gc() {
    ioc.register(GcCounter)

    let a = (ioc.get(GcCounter) as GcCounter)!
    ut.assert_eq(a.bump(), 1)

    gc.collect()
    gc.collect()

    let b = (ioc.get(GcCounter) as GcCounter)!
    ut.assert_eq(b.bump(), 2)
    ut.assert_eq(a.n, 2)
}

// Distinct components resolve to distinct singletons, each with its own
// __init__ state.
@test
func test_multiple_components() {
    ioc.register(Repo)
    let r = (ioc.get(Repo) as Repo)!
    ut.assert_eq(r.table(), "users")
}

// A component can be registered and resolved through typeof(x), not just a
// class literal: both are `type` values.
@test
func test_typeof_component() {
    let seed = Service()
    ioc.register(typeof(seed))
    let s = (ioc.get(typeof(seed)) as Service)!
    ut.assert_eq(s.label(), "svc")
}

// A generic class cannot be a component: its open template has no concrete
// layout to instantiate.
@should_panic("ioc: generic class 'Box' is not supported as a component")
func test_generic_rejected() {
    ioc.register(Box)
}

// A component must be constructible with no arguments; the container only
// calls __init__(self).
@should_panic("ioc: component 'NeedsArg' must have a no-argument __init__")
func test_param_ctor_rejected() {
    ioc.register(NeedsArg)
}