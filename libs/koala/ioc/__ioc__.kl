link "koala_ioc"

/// A minimal inversion-of-control container.
///
/// Register a class as a component, then resolve it by type. Components are
/// singletons: the container creates one instance per type (running its
/// `__init__`) on first use and caches it for the rest of the program.
///
///     import "koala/ioc"
///
///     ioc.register(Counter)
///     let c = (ioc.get(Counter) as Counter)!
///
/// `get` returns `any`, so cast the result back to the component type and
/// unwrap with `!` before calling its methods.

/// Register a class as a managed component. Registering the same type twice is
/// a no-op. The argument must be a type value (a class name or `typeof(x)`).
@native
pub func register(tp type) {}

/// Resolve the singleton instance of a registered component, creating it (and
/// running its `__init__`) on first use. Returns the cached instance afterwards.
/// Panics if the type was never registered. Cast the result back, e.g.
/// `(ioc.get(Counter) as Counter)!`.
@native
pub func get(tp type) any {}