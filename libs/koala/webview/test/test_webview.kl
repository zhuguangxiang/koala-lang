import "std/ut"
import "std/fs"
import "koala/webview"

// These tests need no display: they exercise the native library load, the
// module constants and the pure-Koala template helpers. Window lifecycle
// (create/run/destroy, poll/eval_sync) needs a graphical session and is
// covered by the manual example, not here, so the suite stays runnable
// headless.

@test
func test_version() {
    ut.assert(webview.version == "0.1.0")
}

@test
func test_hint_constants() {
    ut.assert(webview.HINT_NONE == 0)
    ut.assert(webview.HINT_MIN == 1)
    ut.assert(webview.HINT_MAX == 2)
    ut.assert(webview.HINT_FIXED == 3)
}

// ==================== render_template ====================

@test
func test_render_basic() {
    let vars dict[str, any] = {"title": "Hi"}
    ut.assert(webview.render_template("<h1>{{title}}</h1>", vars) == "<h1>Hi</h1>")
}

@test
func test_render_multiple_and_repeated_keys() {
    let vars dict[str, any] = {"a": "X", "b": "Y"}
    ut.assert(webview.render_template("{{a}}-{{b}}-{{a}}", vars) == "X-Y-X")
}

@test
func test_render_whitespace_in_braces() {
    let vars dict[str, any] = {"name": "ok"}
    ut.assert(webview.render_template("{{ name }}", vars) == "ok")
}

@test
func test_render_adjacent_placeholders() {
    let vars dict[str, any] = {"a": "1", "b": "2"}
    ut.assert(webview.render_template("{{a}}{{b}}", vars) == "12")
}

@test
func test_render_non_string_values() {
    let vars dict[str, any] = {"n": 42, "f": 1.5, "ok": true}
    ut.assert(webview.render_template("{{n}}/{{f}}/{{ok}}", vars) == "42/1.5/true")
}

@test
func test_render_no_placeholder() {
    ut.assert(webview.render_template("plain text", dict[str, any]()) == "plain text")
}

@test
func test_render_empty_text() {
    ut.assert(webview.render_template("", dict[str, any]()) == "")
}

@test
func test_render_raw_insertion() {
    // Values are inserted verbatim: no HTML escaping, no rescanning.
    let v1 dict[str, any] = {"v": "<b>&</b>"}
    let v2 dict[str, any] = {"v": "{{x}}"}
    ut.assert(webview.render_template("{{v}}", v1) == "<b>&</b>")
    ut.assert(webview.render_template("{{v}}", v2) == "{{x}}")
}

@test
func test_render_text_around_placeholders() {
    let vars dict[str, any] = {"k": "-"}
    ut.assert(webview.render_template("a{{k}}b{{k}}c", vars) == "a-b-c")
}

@should_panic("render_template: missing key 'nope'")
func test_render_missing_key() {
    webview.render_template("{{nope}}", dict[str, any]())
}

@should_panic("render_template: unclosed '{{' at index 6")
func test_render_unclosed() {
    let vars dict[str, any] = {"name": "x"}
    webview.render_template("hello {{name", vars)
}

@should_panic("render_template: empty placeholder key at index 0")
func test_render_empty_key() {
    webview.render_template("{{}}", dict[str, any]())
}

@should_panic("render_template: empty placeholder key at index 0")
func test_render_whitespace_key() {
    webview.render_template("{{   }}", dict[str, any]())
}

@should_panic("render_template: invalid key 'a-b'")
func test_render_invalid_key() {
    let vars dict[str, any] = {"a-b": "x"}
    webview.render_template("{{a-b}}", vars)
}

// ==================== load_template ====================

@test
func test_load_template_roundtrip() {
    let path = "/tmp/koala_webview_tpl_test.html"
    let vars dict[str, any] = {"msg": "hello"}
    ut.assert(fs.write_str(path, "<p>{{msg}}</p>"))
    ut.assert(webview.load_template(path, vars) == "<p>hello</p>")
    ut.assert(fs.remove(path))
}

@test
func test_load_template_default_vars() {
    let path = "/tmp/koala_webview_tpl_test2.html"
    ut.assert(fs.write_str(path, "static"))
    ut.assert(webview.load_template(path) == "static")
    ut.assert(fs.remove(path))
}

@should_panic("webview: template file not found: /tmp/koala_webview_no_such_file.html")
func test_load_template_missing_file() {
    webview.load_template("/tmp/koala_webview_no_such_file.html")
}