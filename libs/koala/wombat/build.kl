import "std/os"
import "std/fs"
import "koala/toml"

/// A package in the workspace.
class Package {
    var name = ""
    var dir_name = ""
    var file = ""
    var is_file = false
    var test = "test"
    var version = "0.1.0"
    var files = list[str]()
    var excludes = list[str]()
    var deps = list[str]()
    var natives = list[str]()
    var compiler = ""
    var options = list[str]()
    var native_name = ""
    var native_compiler = ""
    var native_sources = list[str]()
    var native_link = list[str]()
    var native_includes = list[str]()
    var native_cflags = list[str]()
    var native_ldflags = list[str]()
}

/// One workspace-level native library from a `[[native]]` entry in
/// `__ws__.toml`.
///
/// `packages` lists the packages that share this `.so`. After loading,
/// `name` is appended to each listed package's `natives`
/// (deduplicated), so the package build checks the shared library
/// without the user listing it again in `__pkg__.toml`.
class WorkspaceNative {
    var name = ""
    var compiler = ""
    var packages = list[str]()
    var sources = list[str]()
    var includes = list[str]()
    var cflags = list[str]()
    var ldflags = list[str]()
    var linkage = list[str]()
}

/// The workspace being built.
class Workspace {
    var name = ""
    var version = "0.1.0"
    var root = "."
    var packages = list[Package]()
    var natives = list[WorkspaceNative]()
}

/// Everything needed to compile one native library. Shared by
/// `build_native` (package) and `build_workspace_native` (workspace)
/// so `build_one_native` takes a single argument.
class NativeSpec {
    var name = ""
    var compiler = ""
    var base_dir = ""
    var out_dir = ""
    var sources = list[str]()
    var includes = list[str]()
    var cflags = list[str]()
    var ldflags = list[str]()
    var linkage = list[str]()
}

/// Load a workspace or a single package and build it.
pub func build_all(src_dir str, output_dir str) int {
    let src_abs = fs.Path(src_dir).absolute().to_str()

    print("🚀 Wombat Build Started...")

    let ws = load_workspace_or_package(src_abs)
    if ws.packages.len() == 0 {
        print("wombat build: no packages to build")
        return 1
    }

    let base = fs.Path(ws.root).cat(ws.packages[0].dir_name).to_str()
    var out = output_dir
    if !fs.Path(out).is_absolute() {
        if ws.packages.len() == 1 && !fs.exists(fs.Path(ws.root).cat("__ws__.toml").to_str()) {
            out = fs.Path(base).cat(out).to_str()
        } else {
            out = fs.Path(ws.root).cat(out).to_str()
        }
    }
    let out_abs = fs.Path(out).absolute().to_str()

    if fs.exists(fs.Path(ws.root).cat("__ws__.toml").to_str()) {
        printf("🏗  Building Workspace: {} (v{})\n", ws.name, ws.version)
    } else {
        printf("🏗  Building Package: {} (v{})\n", ws.name, ws.version)
    }

    return build_workspace(ws, out_abs)
}

/// Load a workspace if `__ws__.toml` exists, or a single-package
/// workspace if `__pkg__.toml` exists instead.
func load_workspace_or_package(root str) Workspace {
    if fs.exists(fs.Path(root).cat("__ws__.toml").to_str()) {
        return load_workspace(root)
    }
    if fs.exists(fs.Path(root).cat("__pkg__.toml").to_str()) {
        return load_single_package(root)
    }
    print("wombat build: no __ws__.toml or __pkg__.toml found")
    printf("  expected one of: {}/__ws__.toml, {}/__pkg__.toml\n", root, root)
    return Workspace()
}

/// Build a workspace-like structure from a single package directory.
func load_single_package(pkg_dir str) Workspace {
    let ws = Workspace()
    ws.root = fs.Path(pkg_dir).parent().to_str()

    let dir_name = fs.Path(pkg_dir).name()
    let pkg = load_package(ws.root, dir_name)
    if pkg.name.empty() {
        return ws
    }

    pkg.deps = list[str]()

    ws.name = pkg.name
    ws.version = pkg.version
    ws.packages.append(pkg)
    return ws
}

/// Read a string field, returning "" when absent.
func toml_str(tbl toml.Table, key str) str {
    if key in tbl {
        return (tbl.get(key) as toml.String)!.value
    }
    return ""
}

/// Read a string-array field.
func toml_str_list(tbl toml.Table, key str) list[str] {
    let out = list[str]()
    if key in tbl {
        let arr = (tbl.get(key) as toml.Array)!
        for item in arr.value {
            out.append((item as toml.String)!.value)
        }
    }
    return out
}

/// Join `xs` with `sep`, or "None" if empty.
func join_or_none(xs list[str], sep str) str {
    if xs.len() == 0 { return "None" }
    let buf = Buffer()
    var first = true
    for x in xs {
        if !first { buf.write_str(sep) }
        buf.write_str(x)
        first = false
    }
    return buf.to_str()
}

/// Parse one `[[native]]` entry into a `WorkspaceNative`.
func load_workspace_native(entry toml.Table) WorkspaceNative {
    let wn = WorkspaceNative()
    wn.name = toml_str(entry, "name")
    wn.compiler = toml_str(entry, "compiler")
    wn.packages = toml_str_list(entry, "packages")
    wn.sources = toml_str_list(entry, "sources")
    wn.includes = toml_str_list(entry, "includes")
    wn.cflags = toml_str_list(entry, "cflags")
    wn.ldflags = toml_str_list(entry, "ldflags")
    wn.linkage = toml_str_list(entry, "link")
    return wn
}

/// Load `<root>/__ws__.toml`, every workspace-level `[[native]]`,
/// every directory package listed in `packages`, and every
/// single-file package listed in `[[package]]`.
///
/// `[[native]].packages` lists the packages that share each `.so`;
/// after loading, every listed package gets the `.so` name appended
/// to its `natives` (deduplicated).
func load_workspace(root str) Workspace {
    let ws = Workspace()
    ws.root = root

    let ws_path = fs.Path(root).cat("__ws__.toml").to_str()
    if !fs.exists(ws_path) {
        print("wombat build: no __ws__.toml found")
        printf("  expected: {}\n", ws_path)
        return ws
    }

    let root_tbl = toml.parse_file(ws_path)
    if !("workspace" in root_tbl) {
        printf("wombat build: missing [workspace] table in {}\n", ws_path)
        return ws
    }
    let sec = (root_tbl.get("workspace") as toml.Table)!

    ws.name = toml_str(sec, "name")
    let ver = toml_str(sec, "version")
    if !ver.empty() { ws.version = ver }

    for dir_name in toml_str_list(sec, "packages") {
        let pkg = load_package(root, dir_name)
        if pkg.name.empty() {
            printf("wombat build: missing [package] name in {}\n",
                   fs.Path(root).cat(dir_name).cat("__pkg__.toml").to_str())
            return ws
        }
        ws.packages.append(pkg)
    }

    if "package" in root_tbl {
        let files_arr = (root_tbl.get("package") as toml.Array)!
        for entry in files_arr.value {
            if !(entry is toml.Table) { continue }
            let pkg = load_inline_package(entry, ws.name)
            if pkg.name.empty() { return ws }
            ws.packages.append(pkg)
        }
    }

    // `[[native]]`: multiple workspace-level native libraries.
    // A single `[native]` table is also accepted for compatibility.
    if "native" in root_tbl {
        let native_val = root_tbl.get("native")
        if native_val is toml.Array {
            for entry in native_val.value {
                if entry is toml.Table {
                    ws.natives.append(load_workspace_native(entry))
                }
            }
        } else if native_val is toml.Table {
            ws.natives.append(load_workspace_native(native_val))
        }
    }

    // Link every workspace native to the packages that share it.
    for wn in ws.natives {
        if wn.name.empty() { continue }
        for pkg_name in wn.packages {
            let pkg = find_package(ws, pkg_name)
            if pkg.name.empty() { continue }
            if !(wn.name in pkg.natives) {
                pkg.natives.append(wn.name)
            }
        }
    }

    return ws
}

/// Read `<root>/<dir_name>/__pkg__.toml`.
func load_package(root str, dir_name str) Package {
    let pkg = Package()
    pkg.dir_name = dir_name
    pkg.is_file = false

    let pkg_path = fs.Path(root).cat(dir_name).cat("__pkg__.toml").to_str()
    if !fs.exists(pkg_path) {
        printf("wombat build: package config not found: {}\n", pkg_path)
        return pkg
    }

    let root_tbl = toml.parse_file(pkg_path)
    if !("package" in root_tbl) {
        printf("wombat build: missing [package] table in {}\n", pkg_path)
        return pkg
    }
    let sec = (root_tbl.get("package") as toml.Table)!

    pkg.name = toml_str(sec, "name")
    let t = toml_str(sec, "test")
    if !t.empty() { pkg.test = t }
    let ver = toml_str(sec, "version")
    if !ver.empty() { pkg.version = ver }
    pkg.compiler = toml_str(sec, "compiler")

    pkg.files = toml_str_list(sec, "files")
    pkg.excludes = toml_str_list(sec, "excludes")
    pkg.deps = toml_str_list(sec, "dependencies")
    pkg.natives = toml_str_list(sec, "natives")
    pkg.options = toml_str_list(sec, "options")

    if "native" in root_tbl {
        let nsec = (root_tbl.get("native") as toml.Table)!
        pkg.native_name = toml_str(nsec, "name")
        pkg.native_compiler = toml_str(nsec, "compiler")
        pkg.native_sources = toml_str_list(nsec, "sources")
        pkg.native_link = toml_str_list(nsec, "link")
        pkg.native_includes = toml_str_list(nsec, "includes")
        pkg.native_cflags = toml_str_list(nsec, "cflags")
        pkg.native_ldflags = toml_str_list(nsec, "ldflags")

        if !pkg.native_name.empty() {
            var found = false
            for n in pkg.natives {
                if n == pkg.native_name {
                    found = true
                    break
                }
            }
            if !found {
                pkg.natives.append(pkg.native_name)
            }
        }
    }

    return pkg
}

/// Build a `Package` from one `[[package]]` entry in `__ws__.toml`.
func load_inline_package(entry toml.Table, ws_name str) Package {
    let pkg = Package()
    pkg.is_file = true

    pkg.file = toml_str(entry, "file")
    if pkg.file.empty() {
        print("wombat build: [[package]] entry missing 'file'")
        return pkg
    }
    if pkg.file.starts_with("/") || pkg.file.index("..") != -1 {
        printf("wombat build: [[package]] file '{}' must be relative and stay inside the workspace\n",
               pkg.file)
        return pkg
    }

    pkg.name = toml_str(entry, "name")
    if pkg.name.empty() {
        printf("wombat build: [[package]] entry for file '{}' is missing 'name'\n",
               pkg.file)
        return pkg
    }

    let prefix = ws_name + "/"
    if pkg.name.starts_with(prefix) {
        pkg.dir_name = pkg.name.substr(prefix.len(), pkg.name.len())
    } else {
        pkg.dir_name = pkg.name
    }

    let ver = toml_str(entry, "version")
    if !ver.empty() { pkg.version = ver }
    pkg.compiler = toml_str(entry, "compiler")

    pkg.deps = toml_str_list(entry, "dependencies")
    pkg.natives = toml_str_list(entry, "natives")
    pkg.options = toml_str_list(entry, "options")

    return pkg
}

func find_package(ws Workspace, name str) Package {
    for pkg in ws.packages {
        if pkg.name == name { return pkg }
    }
    return Package()
}

/// Topological sort by `dependencies`. Empty on cycle.
func topo_sort(pkgs list[Package]) list[str] {
    let order = list[str]()
    let done = list[str]()

    while order.len() < pkgs.len() {
        var progressed = false
        for pkg in pkgs {
            if pkg.name in done { continue }
            var ready = true
            for dep in pkg.deps {
                if !(dep in done) {
                    ready = false
                    break
                }
            }
            if ready {
                order.append(pkg.name)
                done.append(pkg.name)
                progressed = true
            }
        }
        if !progressed {
            return list[str]()
        }
    }
    return order
}

func print_dep_map(ws Workspace) {
    print("")
    print("📦 Subpackage Dependency Mapping:")
    for pkg in ws.packages {
        printf("  ▪ [{}] -> Dependencies: {}\n",
               pkg.name, join_or_none(pkg.deps, ", "))
    }
}

func print_order(ws Workspace, order list[str]) {
    print("")
    print("📋 Calculated Compilation Order:")

    let buf = Buffer()
    var first = true
    for name in order {
        let pkg = find_package(ws, name)
        if !first { buf.write_str(" -> ") }
        if pkg.is_file {
            buf.write_str(pkg.file)
        } else {
            buf.write_str(pkg.dir_name)
        }
        first = false
    }
    printf("  {}\n", buf.to_str())
    print("")
}

func check_natives(pkg Package, ws Workspace, output_dir str) int {
    if pkg.natives.len() == 0 { return 0 }

    let ws_name = fs.Path(ws.root).name()

    let search = list[str]()
    search.append(fs.Path(output_dir).cat(ws_name).to_str())
    if pkg.is_file {
        search.append(fs.Path(ws.root).cat(fs.Path(pkg.file).parent()).cat("native").to_str())
    } else {
        search.append(fs.Path(ws.root).cat(pkg.dir_name).cat("native").to_str())
    }
    search.append("/usr/lib")
    search.append("/usr/local/lib")
    search.append("/lib")

    let ld = os.getenv("LD_LIBRARY_PATH")
    if ld != nil {
        if !ld.empty() {
            for dir in ld.split(":") {
                search.append(dir)
            }
        }
    }

    for native in pkg.natives {
        if native == pkg.native_name { continue }

        let filename = "lib" + native + ".so"
        var found = false
        for dir in search {
            let full = fs.Path(dir).cat(filename).to_str()
            if fs.exists(full) {
                printf("🔍 Found required native library: {}\n", full)
                found = true
                break
            }
        }
        if !found {
            printf("wombat build: package {} requires native library '{}' but it cannot be found\n",
                   pkg.name, filename)
            return 1
        }
    }
    return 0
}

/// Build one native library.
///
/// Relative `sources` / `includes` are resolved against
/// `spec.base_dir`. `lib<spec.name>.so` lands in `spec.out_dir`.
/// Compiler precedence: `CC` environment variable > `spec.compiler`
/// > `cc`.
func build_one_native(spec NativeSpec) int {
    let out = fs.Path(spec.out_dir).cat("lib" + spec.name + ".so").to_str()

    for src in spec.sources {
        var full = src
        if !full.starts_with("/") {
            full = fs.Path(spec.base_dir).cat(src).to_str()
        }
        if !fs.exists(full) {
            printf("❌️ wombat build: native source not found: {}\n\n", full)
            return 1
        }
    }

    var compiler = spec.compiler
    if compiler.empty() { compiler = "cc" }
    let cc = os.getenv("CC")
    if cc != nil {
        if !cc.empty() { compiler = cc }
    }

    let buf = Buffer()
    buf.write_str(compiler)
    buf.write_str(" -shared -fPIC")

    for f in spec.cflags {
        buf.write_str(" ")
        buf.write_str(f)
    }

    buf.write_str(" -I ")
    buf.write_str(fs.Path(spec.base_dir).cat("native").to_str())

    for inc in spec.includes {
        var full = inc
        if !full.starts_with("/") {
            full = fs.Path(spec.base_dir).cat(inc).to_str()
        }
        buf.write_str(" -I ")
        buf.write_str(full)
    }

    buf.write_str(" -o ")
    buf.write_str(out)

    for src in spec.sources {
        var full = src
        if !full.starts_with("/") {
            full = fs.Path(spec.base_dir).cat(src).to_str()
        }
        buf.write_str(" ")
        buf.write_str(full)
    }

    for f in spec.ldflags {
        buf.write_str(" ")
        buf.write_str(f)
    }

    for lib in spec.linkage {
        buf.write_str(" -l")
        buf.write_str(lib)
    }

    let cmd = buf.to_str()
    printf("🚀 Running: {}\n", cmd)

    let full = "mkdir -p " + spec.out_dir + " && " + cmd
    let rc = os.system(full)
    if rc != 0 {
        printf("❌️ Failed artifact: {}\n\n", out)
        return 1
    }
    printf("✅ Generated artifact: {}\n\n", out)
    return 0
}

/// Build `<output_dir>/<ws_name>/lib<native_name>.so` for a package.
func build_native(pkg Package, ws Workspace, output_dir str) int {
    if pkg.native_name.empty() { return 0 }

    var pkg_dir = ""
    if pkg.is_file {
        pkg_dir = fs.Path(ws.root).cat(fs.Path(pkg.file).parent()).to_str()
    } else {
        pkg_dir = fs.Path(ws.root).cat(pkg.dir_name).to_str()
    }

    let ws_name = fs.Path(ws.root).name()

    let spec = NativeSpec()
    spec.name = pkg.native_name
    spec.compiler = pkg.native_compiler
    spec.base_dir = pkg_dir
    spec.out_dir = fs.Path(output_dir).cat(ws_name).to_str()
    spec.sources = pkg.native_sources
    spec.includes = pkg.native_includes
    spec.cflags = pkg.native_cflags
    spec.ldflags = pkg.native_ldflags
    spec.linkage = pkg.native_link

    return build_one_native(spec)
}

/// Build every workspace-level `[[native]]`.
///
/// `sources` / `includes` are resolved against the workspace root.
/// Returns 1 if any library fails; individual errors are printed by
/// `build_one_native`.
func build_workspace_native(ws Workspace, output_dir str) int {
    if ws.natives.len() == 0 { return 0 }

    let ws_name = fs.Path(ws.root).name()
    let out_dir = fs.Path(output_dir).cat(ws_name).to_str()

    var any_failed = false
    for wn in ws.natives {
        if wn.name.empty() { continue }

        let spec = NativeSpec()
        spec.name = wn.name
        spec.compiler = wn.compiler
        spec.base_dir = ws.root
        spec.out_dir = out_dir
        spec.sources = wn.sources
        spec.includes = wn.includes
        spec.cflags = wn.cflags
        spec.ldflags = wn.ldflags
        spec.linkage = wn.linkage

        if build_one_native(spec) != 0 {
            any_failed = true
        }
    }
    if any_failed { return 1 }
    return 0
}

/// Artifact path: `<pkg.name>.klc`.
func artifact_rel(ws Workspace, pkg Package) str {
    return pkg.name + ".klc"
}

/// Source path: `<ws>/<dir>` for a directory package, `<ws>/<file>`
/// for a single-file package.
func src_rel(ws Workspace, pkg Package) str {
    let ws_name = fs.Path(ws.root).name()
    if pkg.is_file {
        return ws_name + "/" + pkg.file
    }
    return ws_name + "/" + pkg.dir_name
}

func build_cmd(pkg Package, ws Workspace, output_dir str) str {
    let out = fs.Path(output_dir).cat(artifact_rel(ws, pkg)).to_str()

    let buf = Buffer()
    if !pkg.compiler.empty() {
        buf.write_str(pkg.compiler)
        for opt in pkg.options {
            buf.write_str(" ")
            buf.write_str(opt)
        }
        buf.write_str(" -o ")
        buf.write_str(out)
    } else {
        buf.write_str("koala -c -o ")
        buf.write_str(out)
        for opt in pkg.options {
            buf.write_str(" ")
            buf.write_str(opt)
        }
    }
    buf.write_str(" --package-name=")
    buf.write_str(pkg.name)
    buf.write_str(" ")
    buf.write_str(src_rel(ws, pkg))
    return buf.to_str()
}

/// Compile every package in dependency order.
///
/// Order:
///   1. every workspace-level `[[native]]`
///   2. per package:
///      a. koala: `koala -c` produces `<pkg>.klc`
///      b. native: package `[native]` then `check_natives`
///
/// A failure in one stage is recorded but does not skip the other
/// stages or later packages. Every failure is printed at the end; the
/// function returns 1 if anything failed.
func build_workspace(ws Workspace, output_dir str) int {
    let order = topo_sort(ws.packages)
    if order.len() != ws.packages.len() {
        print("wombat build: circular dependency detected")
        return 1
    }

    print_dep_map(ws)
    print_order(ws, order)

    let out_entry = output_dir + "/"
    let old_path = os.getenv("KOALA_PATH")
    var koala_path = out_entry
    if old_path != nil {
        if !old_path.empty() {
            koala_path = out_entry + ":" + old_path
        }
    }
    printf("🌐 Dynamic KOALA_PATH set to: {}\n", koala_path)
    print("")

    let ws_parent = fs.Path(ws.root).parent().to_str()

    let failed_pkgs = list[str]()
    let failed_stages = list[str]()

    // All workspace-level natives first.
    if build_workspace_native(ws, output_dir) != 0 {
        failed_pkgs.append(ws.name)
        failed_stages.append("ws-native")
    }

    for name in order {
        let pkg = find_package(ws, name)

        // 1. koala: build `<pkg>.klc`.
        let sub = build_cmd(pkg, ws, output_dir)
        let out = fs.Path(output_dir).cat(artifact_rel(ws, pkg)).to_str()
        let parent = fs.Path(out).parent().to_str()

        let full = "cd " + ws_parent +
                   " && mkdir -p " + parent +
                   " && KOALA_PATH=" + koala_path + " " + sub

        printf("🚀 Running: {}\n", sub)
        let rc2 = os.system(full)
        if rc2 != 0 {
            printf("❌️ Failed artifact: {}\n\n", out)
            failed_pkgs.append(pkg.name)
            failed_stages.append("koala")
        } else {
            printf("✅ Generated artifact: {}\n\n", out)
        }

        // 2. native: build and check the package's own C library.
        var native_failed = false
        if !pkg.native_name.empty() {
            if build_native(pkg, ws, output_dir) != 0 {
                native_failed = true
            }
        }
        if !native_failed && pkg.natives.len() > 0 {
            if check_natives(pkg, ws, output_dir) != 0 {
                native_failed = true
            }
        }
        if native_failed {
            failed_pkgs.append(pkg.name)
            failed_stages.append("native")
        }
    }

    let total_failed = failed_pkgs.len()
    if total_failed == 0 {
        printf("wombat build: {} package(s) built\n", order.len().to_str())
        return 0
    }

    printf("wombat build: {} package(s), {} failure(s)\n",
           order.len().to_str(), total_failed.to_str())

    var i = 0
    while i < total_failed {
        printf("  ❌️ {}: {}\n", failed_pkgs[i], failed_stages[i])
        i += 1
    }
    return 1
}
