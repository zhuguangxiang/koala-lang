import "std/os"
import "std/fs"

/// Walk up from `start` until a directory containing `__ws__.toml` is
/// found. Returns "" when none.
func find_ws_root(start str) str {
    var dir = fs.Path(start).absolute()
    while true {
        let d = dir.to_str()
        if fs.exists(fs.Path(d).cat("__ws__.toml").to_str()) {
            return d
        }
        let parent = dir.parent()
        if parent.to_str() == d {
            return ""
        }
        dir = parent
    }
    return ""
}

/// If `name` matches a package in the workspace at `ws_root`, return
/// `<ws_root>/dist/<ws_name>/<name>.klc`. Otherwise return "".
func resolve_ws_package(ws_root str, name str) str {
    if "/" in name {
    // TODO: add this conviently method.
    // if name.contains("/") {
        return ""
    }
    let pkg_dir = fs.Path(ws_root).cat(name).to_str()
    if !fs.exists(fs.Path(pkg_dir).cat("__pkg__.toml").to_str()) {
        return ""
    }
    let ws_name = fs.Path(ws_root).name()
    let out = fs.Path(ws_root).cat("dist").cat(ws_name).cat(name + ".klc").to_str()
    if !fs.exists(out) {
        return ""
    }
    return out
}

/// `wombat run <target> [args...]`
///
/// `<target>` resolution order:
///
/// 1. `<target>.kl` / `<target>.klc` as given.
/// 2. If `<target>` is a package name in the current workspace, the
///    built artifact `<ws>/dist/<ws>/<target>.klc`.
/// 3. `<target>.klc`, then `<target>.kl` in the current directory.
///
/// Extra arguments are forwarded to the program unchanged and end up
/// in the program's `sys.args()`.
///
/// For a workspace target, `KOALA_PATH` and `LD_LIBRARY_PATH` are
/// prepended for the child process:
///
///   KOALA_PATH      = <ws>/dist/:<old>
///   LD_LIBRARY_PATH = <ws>/dist/<ws_name>:<old>
///
/// so the program can import `.klc` files and load native `.so` files
/// built by `wombat build` without the caller setting either by hand.
///
/// `no_jit` adds `KOALA_JIT=0` for the program. Without it `KOALA_JIT`
/// is left as the caller had it, so an exported value still applies.
pub func run(target str, args list[str], no_jit bool = false) int {
    var file = target

    if !target.ends_with(".kl") && !target.ends_with(".klc") {
        let ws_root = find_ws_root(".")
        var resolved = ""
        if ws_root.len() > 0 {
            resolved = resolve_ws_package(ws_root, target)
        }
        if resolved.len() > 0 {
            file = resolved
        } else {
            let klc = target + ".klc"
            let kl = target + ".kl"
            if fs.exists(klc) {
                file = klc
            } else if fs.exists(kl) {
                file = kl
            } else {
                printf("wombat run: cannot find '{}', '{}', or a package named '{}'\n",
                       klc, kl, target)
                return 1
            }
        }
    }

    let buf = Buffer()

    let dist = find_dist_dir(fs.Path(file).parent().to_str())
    if dist.len() > 0 {
        let old = os.getenv("KOALA_PATH")
        var kp = dist + "/"
        if old != nil {
            if old.len() > 0 {
                kp = kp + ":" + old
            }
        }
        buf.write_str("KOALA_PATH=")
        quote_arg(buf, kp)
        buf.write_byte(' ')
    }

    let ws_root = find_ws_root(fs.Path(file).parent().to_str())
    if ws_root.len() > 0 {
        let ws_name = fs.Path(ws_root).name()
        let lib_dir = fs.Path(ws_root).cat("dist").cat(ws_name).to_str()

        let old = os.getenv("LD_LIBRARY_PATH")
        var lp = lib_dir
        if old != nil {
            if old.len() > 0 {
                lp = lp + ":" + old
            }
        }
        buf.write_str("LD_LIBRARY_PATH=")
        quote_arg(buf, lp)
        buf.write_byte(' ')
    }

    if no_jit {
        buf.write_str("KOALA_JIT=0 ")
    }

    buf.write_str("koala ")
    quote_arg(buf, file)
    for a in args {
        buf.write_byte(' ')
        quote_arg(buf, a)
    }

    let rc = os.system(buf.to_str())
    if rc < 0 { return 1 }
    return (rc >> 8) & 0xFF
}

/// Walk up from `start` until a directory containing `__ws__.toml` or
/// `__pkg__.toml` is found, then return its `dist/` directory.
func find_dist_dir(start str) str {
    var dir = fs.Path(start).absolute()
    while true {
        let d = dir.to_str()
        if fs.exists(fs.Path(d).cat("__ws__.toml").to_str()) ||
           fs.exists(fs.Path(d).cat("__pkg__.toml").to_str()) {
            return fs.Path(d).cat("dist").to_str()
        }
        let parent = dir.parent()
        if parent.to_str() == d {
            return ""
        }
        dir = parent
    }
    return ""
}

/// Append `s` to `buf`, wrapped in single quotes if it contains
/// characters the shell would otherwise split or interpret.
func quote_arg(buf Buffer, s str) {
    var need = false
    let bs = s.to_bytes()
    var i = 0
    while i < bs.len() {
        let b = bs[i]
        if b == ' ' || b == '\t' || b == '\n' ||
           b == '\'' || b == '"' || b == '$' || b == '\\' ||
           b == '&' || b == ';' || b == '|' || b == '(' || b == ')' ||
           b == '<' || b == '>' || b == '*' || b == '?' || b == '[' {
            need = true
            break
        }
        i += 1
    }
    if !need {
        buf.write_str(s)
        return
    }
    buf.write_byte('\'')
    i = 0
    while i < bs.len() {
        let b = bs[i]
        if b == '\'' {
            buf.write_str("'\\''")
        } else {
            buf.write_byte(b)
        }
        i += 1
    }
    buf.write_byte('\'')
}
