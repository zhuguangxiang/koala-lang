import "std/ut"
import "koala/tui"

// Layout tests run against a fixed 24x80 screen, so they do not depend on
// the size of the terminal the test runner happens to use.

@test
func test_fixed_from_top() {
    let l = tui.Layout(tui.Screen(24, 80))
    let a = l.fixed(3)
    ut.assert(a.row == 1 && a.height == 3 && a.col == 1 && a.width == 80)
    let b = l.fixed(1)
    ut.assert(b.row == 4 && b.height == 1)
}

@test
func test_fixed_bottom() {
    let l = tui.Layout(tui.Screen(24, 80))
    let a = l.fixed_bottom(2)
    ut.assert(a.row == 23 && a.height == 2)
    let b = l.fixed_bottom(1)
    ut.assert(b.row == 22 && b.height == 1)
}

@test
func test_elastic_single() {
    let l = tui.Layout(tui.Screen(24, 80))
    let e = l.elastic()
    ut.assert(e.row == 1 && e.height == 24)
    let f = l.fixed(2)
    ut.assert(f.row == 1 && f.height == 2)
    ut.assert(e.row == 3 && e.height == 22)
    let g = l.fixed_bottom(1)
    ut.assert(g.row == 24 && g.height == 1)
    ut.assert(e.row == 3 && e.height == 21)
}

@test
func test_elastic_share() {
    let l = tui.Layout(tui.Screen(24, 80))
    let e1 = l.elastic()
    let e2 = l.elastic()
    ut.assert(e1.row == 1 && e1.height == 12)
    ut.assert(e2.row == 13 && e2.height == 12)
}

@test
func test_elastic_remainder() {
    let l = tui.Layout(tui.Screen(24, 80))
    let f = l.fixed(3)          // leaves a band of 21 rows
    let e1 = l.elastic()
    let e2 = l.elastic()
    ut.assert(f.row == 1 && f.height == 3)
    ut.assert(e1.row == 4 && e1.height == 10)
    ut.assert(e2.row == 14 && e2.height == 11)
}

@test
func test_interleaved() {
    let l = tui.Layout(tui.Screen(24, 80))
    let e1 = l.elastic()
    let f1 = l.fixed(2)
    let e2 = l.elastic()
    let f2 = l.fixed_bottom(1)
    ut.assert(f1.row == 1 && f1.height == 2)
    ut.assert(f2.row == 24 && f2.height == 1)
    // the band is rows 3..23 = 21: share 10, the last gets 11
    ut.assert(e1.row == 3 && e1.height == 10)
    ut.assert(e2.row == 13 && e2.height == 11)
}

@should_panic("tui: layout: not enough rows")
func test_fixed_overflow() {
    let l = tui.Layout(tui.Screen(24, 80))
    l.fixed(25)
}

@should_panic("tui: layout: not enough rows")
func test_fixed_bottom_overflow() {
    let l = tui.Layout(tui.Screen(24, 80))
    l.fixed_bottom(25)
}

@should_panic("tui: layout: not enough rows")
func test_combined_overflow() {
    let l = tui.Layout(tui.Screen(24, 80))
    l.fixed(24)
    l.fixed(1)
}

@should_panic("tui: layout: fixed height must be >= 1")
func test_fixed_zero() {
    let l = tui.Layout(tui.Screen(24, 80))
    l.fixed(0)
}
