import "std/ut"
import "koala/tui"

// A forced size keeps these tests deterministic no matter what terminal
// (if any) the test runner uses.

@test
func test_screen_forced_size() {
    let s = tui.Screen(24, 80)
    ut.assert(s.rows() == 24)
    ut.assert(s.columns() == 80)
}

@test
func test_screen_defaults_positive() {
    let s = tui.Screen()
    ut.assert(s.rows() >= 1)
    ut.assert(s.columns() >= 1)
}

@test
func test_screen_default_surface() {
    let s = tui.Screen(0, 0)
    if s.is_tty() {
        // on a tty the real terminal size wins
        ut.assert(s.rows() >= 1)
        ut.assert(s.columns() >= 1)
    } else {
        // 24x80 is the fallback when the size is not detectable
        ut.assert(s.rows() == 24)
        ut.assert(s.columns() == 80)
    }
}

@test
func test_screen_owns_a_layout() {
    let s = tui.Screen(24, 80)
    let l = tui.Layout(s)
    let r = l.elastic()
    ut.assert(r.row == 1 && r.height == 24 && r.width == 80)
}
