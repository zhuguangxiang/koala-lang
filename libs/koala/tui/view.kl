/// A viewport of text lines in a `Rect`: an append-only transcript whose
/// window shows the tail by default (follow mode), like a chat log or a
/// build output pane. Lines wider than the rect are not wrapped or cut.
///
/// `render` gives the visible lines of the current frame; the app draws
/// them with `Screen.write`.
pub class View {
    var rect Rect
    let lines list[str]
    var _follow bool
    var _top int

    pub func __init__(_rect Rect) {
        rect = _rect
        lines = list[str]()
        _follow = true
        _top = 0
    }

    /// Re-attach the view to a new rect, after the app re-cuts its layout
    /// (a terminal resize, a chrome change). In follow mode the window jumps
    /// to the tail of the new rect; otherwise it keeps its position, clamped
    /// to the new tail.
    pub func set_rect(r Rect) {
        rect = r
        if _follow {
            _to_tail()
        } else {
            let m = _max_top()
            if _top > m { _top = m }
        }
    }

    /// Append one line. In follow mode the window slides to the tail.
    pub func append(line str) {
        lines.append(line)
        if _follow { _to_tail() }
    }

    /// Append `s` split into lines.
    pub func append_str(s str) {
        for l in s.split("\n") { append(l) }
    }

    /// Remove every line and show the empty window.
    pub func clear() {
        lines.clear()
        _top = 0
    }

    /// Turn follow mode on or off. Off, the window stays where manual
    /// scrolling left it; on, it jumps back to the tail.
    pub func follow(on bool) {
        _follow = on
        if _follow { _to_tail() }
    }

    /// True when the window follows the tail.
    pub func is_following() bool { return _follow }

    /// True when the window shows the tail: everything appended so far is
    /// visible (or the view is empty).
    pub func at_tail() bool { return _top == _max_top() }

    /// The number of lines in the view.
    pub func line_count() int { return lines.len() }

    /// Move the window up `n` lines (towards older lines) and leave follow
    /// mode. Clamps at the top.
    pub func scroll_up(n int) {
        if n <= 0 { return }
        _follow = false
        _top -= n
        if _top < 0 { _top = 0 }
    }

    /// Move the window down `n` lines (towards the tail) and leave follow
    /// mode. Clamps at the tail.
    pub func scroll_down(n int) {
        if n <= 0 { return }
        _follow = false
        _top += n
        let max = _max_top()
        if _top > max { _top = max }
    }

    /// The visible lines of the window, oldest first, at most `rect.height`
    /// of them.
    pub func render() list[str] {
        let out = list[str]()
        let end = _top + rect.height
        var i = _top
        while i < lines.len() && i < end {
            out.append(lines[i])
            i += 1
        }
        return out
    }

    // The first visible index when the window shows the tail.
    func _max_top() int {
        let m = lines.len() - rect.height
        if m < 0 { return 0 }
        return m
    }

    func _to_tail() {
        _top = _max_top()
    }
}
