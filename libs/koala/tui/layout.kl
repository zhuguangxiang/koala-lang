/// A rectangle of the screen: its first row and column (1-based), its
/// height in rows and width in columns.
///
/// Rects come from `Layout`; the layout owns the `row` and `height` of
/// elastic rects and re-sizes them as more rows are added, so read those
/// fields live rather than copying them.
pub class Rect {
    pub let col int
    pub let width int
    pub var row int
    pub var height int

    pub func __init__(_row int, _col int, _height int, _width int) {
        row = _row
        col = _col
        height = _height
        width = _width
    }
}

/// Cut the screen into rows, top to bottom: `fixed` takes exact rows from
/// the top, `fixed_bottom` takes exact rows from the bottom, and the
/// elastic rows share the band left in the middle (each gets the same
/// number, the last elastic gets the remainder too). Calls may interleave;
/// every call re-fits the elastic rows, so an elastic rect's row and height
/// are live.
///
/// Panics when a fixed row does not fit.
pub class Layout {
    let screen Screen
    var _top int
    var _bottom int
    let _elastics list[Rect]

    pub func __init__(_screen Screen) {
        screen = _screen
        _top = 1
        _bottom = screen.rows()
        _elastics = list[Rect]()
    }

    /// Take the next `height` rows from the top and return them.
    pub func fixed(height int) Rect {
        if height < 1 { panic("tui: layout: fixed height must be >= 1") }
        if _top + height - 1 > _bottom { panic("tui: layout: not enough rows") }
        let r = Rect(_top, 1, height, screen.columns())
        _top += height
        _fit()
        return r
    }

    /// Take the next `height` rows from the bottom and return them.
    pub func fixed_bottom(height int) Rect {
        if height < 1 { panic("tui: layout: fixed height must be >= 1") }
        if _bottom - height + 1 < _top { panic("tui: layout: not enough rows") }
        let r = Rect(_bottom - height + 1, 1, height, screen.columns())
        _bottom -= height
        _fit()
        return r
    }

    /// Add an elastic row sharing the middle band with the other elastic
    /// rows. Its row and height are live: later calls re-fit it.
    pub func elastic() Rect {
        let r = Rect(_top, 1, 0, screen.columns())
        _elastics.append(r)
        _fit()
        return r
    }

    // Give the elastic rows their share of the band between `_top` and
    // `_bottom`: the same number each, the remainder to the last.
    func _fit() {
        let n = _elastics.len()
        if n == 0 { return }
        let band = _bottom - _top + 1
        var share = band / n
        if share < 0 { share = 0 }
        var row = _top
        var i = 0
        while i < n {
            var h = share
            if i == n - 1 { h = band - share * (n - 1) }
            let r = _elastics[i]
            r.row = row
            r.height = h
            row += h
            i += 1
        }
    }
}
