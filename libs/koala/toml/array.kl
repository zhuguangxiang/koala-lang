/// A TOML array value.
///
/// Elements are stored as `Value`, so strings, integers, floats and
/// booleans may be mixed freely.
pub class Array : Value {
    /// The elements of the array.
    pub let value = list[Value]()

    pub func __init__() {}

    /// Append all values from `values` to the end of the array.
    pub func extend(values Iterable[Value]) {
        value.extend(values)
    }

    /// Serialize to `[elem, elem, ...]`, recursively.
    ///
    /// Elements are joined with `", "`. Mixed types are allowed, matching
    /// what the parser accepts.
    pub func to_toml() str {
        let buf = Buffer()
        buf.write_str("[")
        var first = true
        for elem in value {
            if !first { buf.write_str(", ") }
            buf.write_str(elem.to_toml())
            first = false
        }
        buf.write_str("]")
        return buf.to_str()
    }

    /// Append a value to the end of the array.
    pub func add(v Value) {
        value.append(v)
    }

    /// Return the number of elements.
    pub func len() int {
        return value.len()
    }

    /// Return the value at `idx`. Panic if `idx` is out of range.
    pub func get(idx int) Value {
        return value[idx]
    }

    /// Return the string element at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not a String.
    pub func get_str(idx int) str {
        return (get(idx) as String)!.value
    }

    /// Return the integer element at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not an Integer.
    pub func get_int(idx int) int {
        return (get(idx) as Integer)!.value
    }

    /// Return the float element at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not a Float.
    pub func get_float(idx int) float {
        return (get(idx) as Float)!.value
    }

    /// Return the boolean element at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not a Boolean.
    pub func get_bool(idx int) bool {
        return (get(idx) as Boolean)!.value
    }

    /// Return the table at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not a Table.
    pub func get_table(idx int) Table {
        return (get(idx) as Table)!
    }

    /// Return the array at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not an Array.
    pub func get_array(idx int) Array {
        return (get(idx) as Array)!
    }

    /// Format the elements for display.
    pub func fmt(f Formatter) {
        value.fmt(f)
    }
}
