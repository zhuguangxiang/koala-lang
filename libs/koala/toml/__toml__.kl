/// Parse the TOML file at `path` and return its root table.
///
/// See [`Parser`](#parser) for the supported TOML subset.
///
/// Errors
///
/// Panic if the file cannot be opened, or if its content is not valid
/// TOML within the supported subset.
pub func parse_file(path str) Table {
    let f = open(path, "r")!

    // Read the whole file in chunks; `read` returns 0 at EOF and a
    // negative value on error.
    let chunk = bytes(8192)
    let acc = Buffer(8192)

    loop {
        let n = f.read(chunk)
        if n <= 0 { break } // stop on EOF (0) or read error (negative)
        acc.write(chunk.view(0, n))
    }

    f.close()

    return parse_str(acc.to_str())
}

/// Parse the TOML text `s` and return its root table.
///
/// See [`Parser`](#parser) for the supported TOML subset.
pub func parse_str(s str) Table {
    let parser = Parser(s.splitlines())
    return parser.parse()
}

/// Serialize `root` to TOML text.
///
/// Scalar keys are emitted first, then nested tables as `[name]`
/// sections. Dotted headers are used for nested tables. Arrays of
/// tables are emitted as repeated `[[name]]` blocks.
///
/// The leading newline produced before the first section header is
/// stripped so the output starts directly with the header.
pub func dump(root Table) str {
    let buf = Buffer()
    dump_table(buf, root, "")
    let s = buf.to_str()
    if s.starts_with("\n") {
        return s.substr(1, s.len())
    }
    return s
}

/// Write `tbl` into `buf`.
///
/// Emit order:
/// 1. Scalar values and non-table arrays, under the current section.
/// 2. Nested tables as `[a.b]`.
/// 3. Arrays of tables as repeated `[[a.b]]` blocks.
func dump_table(buf Buffer, tbl Table, prefix str) {
    let keys = tbl.keys()

    // Scalar values and plain arrays first, so they land under the
    // current section.
    for k in keys {
        let v = tbl.get(k)
        if v is Table { continue }
        if v is Array {
            if is_array_of_tables(v) { continue }
        }
        buf.write_str(k)
        buf.write_str(" = ")
        buf.write_str(v.to_toml())
        buf.write_str("\n")
    }

    // Nested tables and arrays of tables as separate sections.
    for k in keys {
        let v = tbl.get(k)

        var full = k
        if prefix.len() > 0 {
            full = prefix + "." + k
        }

        if v is Table {
            buf.write_str("\n[")
            buf.write_str(full)
            buf.write_str("]\n")
            dump_table(buf, v, full)
            continue
        }

        if v is Array {
            if !is_array_of_tables(v) { continue }
            for elem in v.value {
                if elem is Table {
                    buf.write_str("\n[[")
                    buf.write_str(full)
                    buf.write_str("]]\n")
                    dump_table(buf, elem, full)
                }
            }
        }
    }
}

/// Return true when `arr` is non-empty and every element is a
/// `Table`. An empty array is treated as a plain array, not an
/// array of tables, so `packages = []` round-trips as `packages = []`.
func is_array_of_tables(arr Array) bool {
    if arr.value.len() == 0 { return false }
    for elem in arr.value {
        if !(elem is Table) { return false }
    }
    return true
}
