/// A TOML float value.
pub class TomFloat : TomValue {
    /// The float content.
    pub let value float

    /// Create a float value holding `_value`.
    pub func __init__(_value float) {
        value = _value
    }

    /// Write the decimal representation to `f`.
    pub func fmt(f Formatter) {
        f.write_str(str(value))
    }
}
