/// A TOML table value: an ordered mapping from string keys to values.
pub class Table : Value {
    /// The key-value mappings, in insertion order.
    pub let data = dict[str, Value]()

    pub func __init__() {}

    /// Associate `value` with `key`, replacing an existing mapping.
    pub func add(key str, value Value) {
        data[key] = value
    }

    /// Return the value mapped to `key`. Panic if `key` is not present.
    pub func get(key str) Value {
        return data[key]
    }

    /// Return the string value mapped to `key`.
    ///
    /// Panic if `key` is not present or if the value is not a String.
    pub func get_str(key str) str {
        return (get(key) as String)!.value
    }

    /// Return the integer value mapped to `key`.
    ///
    /// Panic if `key` is not present or if the value is not an Integer.
    pub func get_int(key str) int {
        return (get(key) as Integer)!.value
    }

    /// Return the float value mapped to `key`.
    ///
    /// Panic if `key` is not present or if the value is not a Float.
    pub func get_float(key str) float {
        return (get(key) as Float)!.value
    }

    /// Return the boolean value mapped to `key`.
    ///
    /// Panic if `key` is not present or if the value is not a Boolean.
    pub func get_bool(key str) bool {
        return (get(key) as Boolean)!.value
    }

    /// Return the table mapped to `key`.
    ///
    /// Panic if `key` is not present or if the value is not a Table.
    pub func get_table(key str) Table {
        return (get(key) as Table)!
    }

    /// Return the array mapped to `key`.
    ///
    /// Panic if `key` is not present or if the value is not an Array.
    pub func get_array(key str) Array {
        return (get(key) as Array)!
    }

    /// Return true if the table contains a mapping for `key`.
    pub func __contains__(key str) bool {
        return key in data
    }

    /// Create a subtable under `key` and return it.
    pub func add_table(key str) Table {
        let sub = Table()
        data[key] = sub
        return sub
    }

    /// Merge all mappings from `data` into the table.
    pub func update(data dict[str, Value]) {
        self.data.update(data)
    }

    /// Return the keys in insertion order.
    pub func keys() list[str] {
        let out = list[str]()
        for k in data.keys() {
            out.append(k)
        }
        return out
    }

    /// Format the mappings for display.
    pub func fmt(f Formatter) {
        data.fmt(f)
    }
}
