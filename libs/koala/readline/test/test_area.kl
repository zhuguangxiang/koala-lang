// The multi-row input area, the per-key hook and `fit_text`, through a
// MemoryTerminal.

import "std/ut"
import "std/fs"
import "koala/readline"

func _area_line(keys str) str? {
    let term = readline.MemoryTerminal(keys)
    let editor = readline.Editor(term)
    editor.set_input_area(1, 1, 80, 3)
    return editor.readline("> ")
}

@test
func test_ctrl_j_starts_a_row() {
    // Ctrl-J inserts a newline, Enter submits the whole text
    ut.assert_eq(_area_line("ab\x0acd\r")!, "ab\ncd")
}

@test
func test_enter_submits_all_rows() {
    // Enter does not split the rows
    ut.assert_eq(_area_line("a\x0ab\x0ac\r")!, "a\nb\nc")
}

@test
func test_lf_still_accepts_single_row() {
    // without an input area, LF accepts, as readline
    let term = readline.MemoryTerminal("ab\n")
    ut.assert_eq(readline.Editor(term).readline("> ")!, "ab")
}

@test
func test_up_moves_a_visual_row() {
    // Up to the row above, the same column clamped, then insert
    ut.assert_eq(_area_line("ab\x0acd\x1b[AX\r")!, "abX\ncd")
}

@test
func test_up_at_the_first_row_shows_history() {
    // Up at the first row leaves the area: previous history
    let term = readline.MemoryTerminal("ab\x0acd\x1b[A\x1b[A\r")
    let editor = readline.Editor(term)
    editor.add_history("prev")
    editor.set_input_area(1, 1, 80, 3)
    ut.assert_eq(editor.readline("> ")!, "prev")
}

@test
func test_ctrl_a_stops_at_the_row() {
    // C-a on the second row goes to the start of that row
    ut.assert_eq(_area_line("ab\x0acd\x01X\r")!, "ab\nXcd")
}

@test
func test_ctrl_e_stops_at_the_row() {
    // C-e on the first row goes to the end of that row
    ut.assert_eq(_area_line("ab\x0acd\x1b[A\x01\x05X\r")!, "abX\ncd")
}

@test
func test_home_stops_at_the_row() {
    // Home on the first row goes to the start of that row
    ut.assert_eq(_area_line("ab\x0acd\x1b[A\x1b[HX\r")!, "Xab\ncd")
}

@test
func test_kill_line_stops_at_the_row() {
    // C-a C-k on the second row kills it, joining nothing
    ut.assert_eq(_area_line("ab\x0acd\x01\x0b\r")!, "ab\n")
}

@test
func test_backspace_joins_rows() {
    // Backspace at the start of the second row deletes the newline
    ut.assert_eq(_area_line("ab\x0a\x7fX\r")!, "abX")
}

@test
func test_paste_keeps_newlines() {
    // a paste of several lines goes in whole, no submit
    ut.assert_eq(_area_line("a\x1b[200~b\nc\x1b[201~d\r")!, "ab\ncd")
}

@test
func test_wrapping_draws_two_rows() {
    // with width 6 the text after the prompt wraps to the second row
    let term = readline.MemoryTerminal("abcdefgh\r")
    let editor = readline.Editor(term)
    editor.set_input_area(1, 1, 6, 3)
    ut.assert_eq(editor.readline("> ")!, "abcdefgh")
    let out = term.output()
    ut.assert_true("\x1b[1;1H> abcd" in out)
    ut.assert_true("\x1b[2;1Hefgh" in out)
}

@test
func test_ctrl_c_returns_empty_without_newline() {
    // ^C drops the line; no newline is drawn below the area
    let term = readline.MemoryTerminal("ab\x03")
    let editor = readline.Editor(term)
    editor.set_input_area(1, 1, 80, 3)
    ut.assert_eq(editor.readline("> ")!, "")
    ut.assert_true("^C" in term.output())
}

// A key hook that keeps what it saw; it consumes the key whose bytes are
// `consume_seq` ("" for none).
class _Recorder : readline.KeyHook {
    var names list[str]
    var seqs list[str]
    let consume_seq str

    func __init__(_consume_seq str) {
        names = list[str]()
        seqs = list[str]()
        consume_seq = _consume_seq
    }

    func call(name str, seq str) bool {
        names.append(name)
        seqs.append(seq)
        return consume_seq != "" && seq == consume_seq
    }
}

@test
func test_key_hook_sees_unknown_keys() {
    // Page Up arrives as an unknown key; false lets the editor go on
    let term = readline.MemoryTerminal("ab\x1b[5~cd\r")
    let editor = readline.Editor(term)
    let hook = _Recorder("")
    editor.set_key_hook(hook)
    ut.assert_eq(editor.readline("> ")!, "abcd")
    ut.assert_eq(hook.names.len(), 6)
    ut.assert_eq(hook.names[2], "unknown")
    ut.assert_eq(hook.seqs[2], "\x1b[5~")
}

@test
func test_key_hook_can_consume_a_key() {
    // true: the editor runs nothing for the key and does not redraw
    let term = readline.MemoryTerminal("ab\x1b[5~cd\r")
    let editor = readline.Editor(term)
    let hook = _Recorder("\x1b[5~")
    editor.set_key_hook(hook)
    ut.assert_eq(editor.readline("> ")!, "abcd")
    ut.assert_eq(hook.names[2], "unknown")
}

@test
func test_fit_text() {
    ut.assert_eq(readline.fit_text("abcdef", 4), "abcd")
    ut.assert_eq(readline.fit_text("你好ab", 4), "你好")
    ut.assert_eq(readline.fit_text("ab", 4), "ab  ")
    ut.assert_eq(readline.fit_text("", 2), "  ")
}

@test
func test_width() {
    ut.assert_eq(readline.width("abc"), 3)
    ut.assert_eq(readline.width("你好"), 4)
    ut.assert_eq(readline.width("\x1b[31mred\x1b[0m"), 3)
    ut.assert_eq(readline.width("a\x01\x1b[31m\x02b"), 2)
}

@test
func test_wrap_text_ascii() {
    let lines = readline.wrap_text("abcdef", 4)
    ut.assert_eq(lines.len(), 2)
    ut.assert_eq(lines[0], "abcd")
    ut.assert_eq(lines[1], "ef")
}

@test
func test_wrap_text_cjk() {
    let lines = readline.wrap_text("你好ab", 4)
    ut.assert_eq(lines.len(), 2)
    ut.assert_eq(lines[0], "你好")
    ut.assert_eq(lines[1], "ab")
    // never split a wide character across rows
    let lines2 = readline.wrap_text("你好", 1)
    ut.assert_eq(lines2.len(), 2)
    ut.assert_eq(lines2[0], "你")
    ut.assert_eq(lines2[1], "好")
}

@test
func test_wrap_text_newline_and_empty() {
    let lines = readline.wrap_text("a\nb", 80)
    ut.assert_eq(lines.len(), 2)
    ut.assert_eq(lines[0], "a")
    ut.assert_eq(lines[1], "b")
    let empty = readline.wrap_text("", 10)
    ut.assert_eq(empty.len(), 1)
    ut.assert_eq(empty[0], "")
}

@test
func test_wrap_text_keeps_ansi() {
    let lines = readline.wrap_text("\x1b[31mabcdef\x1b[0m", 4)
    ut.assert_eq(lines.len(), 2)
    ut.assert_eq(lines[0], "\x1b[31mabcd")
    ut.assert_eq(lines[1], "ef\x1b[0m")
    // every visible character survives the wrap
    ut.assert_eq(readline.width(lines[0]) + readline.width(lines[1]), 6)
}

@test
func test_wrap_text_expands_tabs() {
    let lines = readline.wrap_text("a\tb", 80)
    ut.assert_eq(lines.len(), 1)
    ut.assert_eq(lines[0], "a    b")
}

@test
func test_wrap_text_hard_breaks_long_words() {
    let lines = readline.wrap_text("abcdefghij", 3)
    ut.assert_eq(lines.len(), 4)
    ut.assert_eq(lines[0], "abc")
    ut.assert_eq(lines[1], "def")
    ut.assert_eq(lines[2], "ghi")
    ut.assert_eq(lines[3], "j")
}

@test
func test_wrap_text_prefers_spaces() {
    let lines = readline.wrap_text("hello world", 6)
    ut.assert_eq(lines.len(), 2)
    ut.assert_eq(lines[0], "hello")
    ut.assert_eq(lines[1], "world")
    // a URL has no spaces, so it is hard-broken
    let url = "https://example.com/a/very/long/path"
    let parts = readline.wrap_text(url, 10)
    var back = ""
    for part in parts {
        ut.assert_true(readline.width(part) <= 10)
        back += part
    }
    ut.assert_eq(back, url)
}

@test
func test_pad_text_never_cuts() {
    ut.assert_eq(readline.pad_text("ab", 4), "ab  ")
    ut.assert_eq(readline.pad_text("abcdef", 4), "abcdef")
    ut.assert_eq(readline.pad_text("你好", 4), "你好")
    // a wide character in a one-column area cannot be cut: it overflows
    ut.assert_eq(readline.pad_text("你", 1), "你")
}

@test
func test_shrunk_text_blanks_area_rows() {
    // "ab\ncd" fills two rows; deleting "cd" and the newline leaves the
    // second row blank, not stale
    let term = readline.MemoryTerminal("ab\x0acd\x7f\x7f\x7f")
    let editor = readline.Editor(term)
    editor.set_input_area(1, 1, 80, 3)
    ut.assert_eq(editor.readline("> ")!, "ab")
    let out = term.output()
    let last = out.rindex("\x1b[2;1H")
    ut.assert_true(last >= 0)
    ut.assert_true(out.substr(last + 8).starts_with("  "))
}

// A hook that writes a marker where it drew and consumes Page Up, to prove
// the area is drawn again after it.
class _MarkerHook : readline.KeyHook {
    let term readline.MemoryTerminal

    func __init__(_term readline.MemoryTerminal) {
        term = _term
    }

    func call(name str, seq str) bool {
        if seq == "\x1b[5~" {
            term.write("\x1b[9;9HMARK")
            return true
        }
        return false
    }
}

@test
func test_consumed_key_still_redraws_area() {
    // the hook draws elsewhere and returns true; the area is drawn again
    // and the cursor put back in it
    let term = readline.MemoryTerminal("ab\x1b[5~cd\r")
    let editor = readline.Editor(term)
    editor.set_input_area(1, 1, 80, 3)
    editor.set_key_hook(_MarkerHook(term))
    ut.assert_eq(editor.readline("> ")!, "abcd")
    let out = term.output()
    let mark = out.rindex("MARK")
    let redrawn = out.rindex("\x1b[1;5H")
    ut.assert_true(mark >= 0 && redrawn > mark)
}

class _Comp : readline.Completer {
    func complete(text str, state int) str? {
        let m = ["abc", "abd"]
        if state < m.len() && m[state].starts_with(text) { return m[state] }
        return nil
    }
}

class _ListHook : readline.DisplayMatchesHook {
    var matches list[str]

    func __init__() {
        matches = list[str]()
    }

    func display(substitution str, matches_ list[str], longest int) {
        matches = matches_
    }
}

@test
func test_completion_goes_to_hook_in_area() {
    // no rows under the area: the third Tab goes to the display hook, not
    // readline's column listing
    let term = readline.MemoryTerminal("a\t\t\t\r")
    let editor = readline.Editor(term)
    editor.set_input_area(1, 1, 80, 3)
    editor.parse_and_bind("tab: complete")
    editor.set_completer(_Comp())
    let hook = _ListHook()
    editor.set_completion_display_matches_hook(hook)
    ut.assert_eq(editor.readline("> ")!, "ab")
    ut.assert_eq(hook.matches.len(), 2)
    ut.assert_eq(hook.matches[0], "abc")
    ut.assert_true(!("\r\n" in term.output()))
}

@test
func test_completion_without_hook_beeps_in_area() {
    // no hook: the third Tab just beeps, nothing is drawn under the area
    let term = readline.MemoryTerminal("a\t\t\t\r")
    let editor = readline.Editor(term)
    editor.set_input_area(1, 1, 80, 3)
    editor.parse_and_bind("tab: complete")
    editor.set_completer(_Comp())
    ut.assert_eq(editor.readline("> ")!, "ab")
    ut.assert_true(!("\r\n" in term.output()))
}

@test
func test_history_file_skips_multirow_lines() {
    let path = "/tmp/koala_readline_test_area_history.txt"
    let editor = readline.Editor(readline.MemoryTerminal(""))
    editor.add_history("one")
    editor.add_history("two\nlines")
    editor.add_history("three")
    ut.assert_true(editor.write_history_file(path))
    ut.assert_eq(fs.read_str(path), "one\nthree\n")
}
