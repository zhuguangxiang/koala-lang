/// A JSON null value.
pub class Null : Value {
    pub func __init__() {}

    /// Write `null` to `f`.
    pub func fmt(f Formatter) {
        f.write_str("null")
    }

    /// Serialize to `null`.
    pub func to_json() str = "null"
}
