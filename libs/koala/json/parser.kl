/// The deepest nesting level the parser accepts, counting each object and
/// each array. Real-world JSON stays far below this; the limit exists so that
/// a hostile document raises instead of running the process out of stack.
const MAX_DEPTH = 64

/// A recursive descent parser for JSON.
///
/// The parser walks over the bytes of the source text, so the multi-byte
/// UTF-8 sequences of a string are copied unchanged.
///
/// Supported syntax:
/// - objects: `{"key":value,...}`
/// - arrays: `[value,...]`
/// - strings: double-quoted, with the `\uXXXX` escape and the surrogate
///   pairs
/// - numbers: integers and floats, with an optional fraction and an
///   optional exponent
/// - literals: `true`, `false` and `null`
/// - whitespace: space, tab, carriage return and line feed
pub class Parser {
    let src str
    var pos = 0
    var depth = 0

    /// True once a syntax error has been met. Parsing never panics on a
    /// syntax error, it only records the first message here, so that a
    /// caller can choose between [`parse`](#parse) and
    /// [`try_parse`](#try_parse).
    var failed = false

    /// The message of the first syntax error, empty if none.
    var err_msg = ""

    /// Create a parser for the source text `src`.
    pub func __init__(src str) {
        self.src = src
    }

    /// Return true once a syntax error has been met.
    pub func is_failed() bool = failed

    /// Return the message of the first syntax error, or an empty string
    /// if the parse succeeded.
    pub func error_message() str = err_msg

    /// Parse the whole source text and return the root value.
    ///
    /// Errors
    ///
    /// Panic if the source text is not valid JSON. Use
    /// [`try_parse`](#try_parse) to get `nil` instead.
    pub func parse() Value {
        let v = try_parse()
        if failed {
            panic(err_msg)
        }
        return v!
    }

    /// Parse the whole source text and return the root value, or `nil`
    /// if the source text is not valid JSON.
    ///
    /// The message of the first syntax error is kept, see
    /// [`error_message`](#error_message).
    pub func try_parse() Value? {
        skip_ws()
        if failed {
            return nil
        }
        let v = parse_value()
        skip_ws()
        if !failed && pos < src.len() {
            fail("Unexpected trailing content in JSON input")
        }
        if failed {
            return nil
        }
        return v
    }

    /// Record `msg` as the message of the first syntax error.
    func fail(msg str) {
        if !failed {
            failed = true
            err_msg = msg
        }
    }

    /// Parse one value at the current position.
    ///
    /// Returns [`Null`](#null) once a syntax error has been met, the
    /// error itself is recorded by [`fail`](#fail).
    func parse_value() Value {
        if failed {
            return Null()
        }
        if pos >= src.len() {
            fail("Unexpected end of JSON input")
            return Null()
        }

        let ch = src[pos]
        if ch == "{" {
            enter_nested()
            if failed {
                return Null()
            }
            let obj = parse_object()
            depth -= 1
            return obj
        }
        if ch == "[" {
            enter_nested()
            if failed {
                return Null()
            }
            let arr = parse_array()
            depth -= 1
            return arr
        }
        if ch == "\"" {
            return String(parse_string())
        }
        if ch == "t" {
            expect_word("true")
            return Boolean(true)
        }
        if ch == "f" {
            expect_word("false")
            return Boolean(false)
        }
        if ch == "n" {
            expect_word("null")
            return Null()
        }
        return parse_number()
    }

    /// Parse a `{...}` object at the current position.
    ///
    /// Returns the pairs read so far once a syntax error has been met.
    func parse_object() Object {
        let obj = Object()
        pos += 1 // consume the '{'

        skip_ws()
        if pos < src.len() && src[pos] == "}" {
            pos += 1
            return obj
        }

        var done = false
        while !done {
            skip_ws()
            if pos >= src.len() {
                fail("Unexpected end of JSON input")
                return obj
            }
            if src[pos] != "\"" {
                fail("Expected a string key in JSON object")
                return obj
            }
            let key = parse_string()
            if failed {
                return obj
            }

            skip_ws()
            if pos >= src.len() {
                fail("Unexpected end of JSON input")
                return obj
            }
            if src[pos] != ":" {
                fail("Expected ':' after a key in JSON object")
                return obj
            }
            pos += 1

            skip_ws()
            let value = parse_value()
            if failed {
                return obj
            }
            obj.add(key, value)

            skip_ws()
            if pos >= src.len() {
                fail("Unexpected end of JSON input")
                return obj
            }
            let ch = src[pos]
            if ch == "," {
                pos += 1
            } else if ch == "}" {
                pos += 1
                done = true
            } else {
                fail("Expected ',' or '}' in JSON object")
                return obj
            }
        }
        return obj
    }

    /// Parse a `[...]` array at the current position.
    ///
    /// Returns the elements read so far once a syntax error has been met.
    func parse_array() Array {
        let arr = Array()
        pos += 1 // consume the '['

        skip_ws()
        if pos < src.len() && src[pos] == "]" {
            pos += 1
            return arr
        }

        var done = false
        while !done {
            skip_ws()
            let value = parse_value()
            if failed {
                return arr
            }
            arr.add(value)

            skip_ws()
            if pos >= src.len() {
                fail("Unexpected end of JSON input")
                return arr
            }
            let ch = src[pos]
            if ch == "," {
                pos += 1
            } else if ch == "]" {
                pos += 1
                done = true
            } else {
                fail("Expected ',' or ']' in JSON array")
                return arr
            }
        }
        return arr
    }

    /// Parse a double-quoted string at the current position.
    ///
    /// Returns the text read so far once a syntax error has been met.
    func parse_string() str {
        pos += 1 // consume the opening quote

        let buf = Buffer()
        var done = false
        while !done && !failed {
            if pos >= src.len() {
                fail("Unterminated string in JSON input")
                break
            }

            let ch = src[pos]
            if ch == "\"" {
                pos += 1
                done = true
            } else if ch == "\\" {
                pos += 1
                parse_escape(buf)
            } else {
                if ch < " " {
                    fail("Unescaped control character in JSON string")
                    break
                }
                buf.write_str(ch)
                pos += 1
            }
        }
        return buf.to_str()
    }

    /// Parse the escape sequence at the current position and write the
    /// decoded text to `buf`.
    func parse_escape(buf Buffer) {
        if failed {
            return
        }
        if pos >= src.len() {
            fail("Unexpected end of JSON input")
            return
        }

        let ch = src[pos]
        pos += 1
        if ch == "\"" {
            buf.write_str("\"")
        } else if ch == "\\" {
            buf.write_str("\\")
        } else if ch == "/" {
            buf.write_str("/")
        } else if ch == "b" {
            buf.write_byte('\x08')
        } else if ch == "f" {
            buf.write_byte('\x0c')
        } else if ch == "n" {
            buf.write_byte('\n')
        } else if ch == "r" {
            buf.write_byte('\r')
        } else if ch == "t" {
            buf.write_byte('\t')
        } else if ch == "u" {
            parse_unicode_escape(buf)
        } else {
            fail("Invalid escape sequence in JSON string")
        }
    }

    /// Parse a `\uXXXX` escape sequence at the current position and write
    /// the decoded text to `buf`.
    ///
    /// A high surrogate must be followed by a low surrogate, so that the
    /// pair is decoded as a single code point above the basic plane.
    func parse_unicode_escape(buf Buffer) {
        let unit = parse_hex4()
        if failed {
            return
        }
        if unit >= 0xD800 && unit <= 0xDBFF {
            // A high surrogate, the low surrogate must follow.
            if pos + 1 >= src.len() || src[pos] != "\\" || src[pos + 1] != "u" {
                fail("Invalid surrogate pair in JSON string")
                return
            }
            pos += 2
            let low = parse_hex4()
            if failed {
                return
            }
            if low < 0xDC00 || low > 0xDFFF {
                fail("Invalid surrogate pair in JSON string")
                return
            }
            write_codepoint(buf, 0x10000 + (unit - 0xD800) * 0x400 + (low - 0xDC00))
        } else if unit >= 0xDC00 && unit <= 0xDFFF {
            // A low surrogate without a high surrogate.
            fail("Invalid surrogate pair in JSON string")
        } else {
            write_codepoint(buf, unit)
        }
    }

    /// Parse the four hexadecimal digits of a `\uXXXX` escape sequence at
    /// the current position.
    func parse_hex4() int {
        var value = 0
        var i = 0
        while i < 4 && !failed {
            if pos >= src.len() {
                fail("Unexpected end of JSON input")
                return -1
            }
            let digit = hex_value(src[pos])
            if digit < 0 {
                fail("Invalid \\u escape in JSON string")
                return -1
            }
            value = value * 16 + digit
            pos += 1
            i += 1
        }
        return value
    }

    /// Return the numeric value of the hexadecimal digit `ch`, or `-1` if
    /// `ch` is not a hexadecimal digit.
    func hex_value(ch str) int {
        let digits = "0123456789abcdefABCDEF"
        let index = digits.index(ch)
        if index < 0 {
            return -1
        }
        if index < 16 {
            return index
        }
        return index - 6
    }

    /// Write the UTF-8 encoding of the code point `cp` to `buf`.
    func write_codepoint(buf Buffer, cp int) {
        if cp < 0x80 {
            buf.write_byte(uint8(cp))
        } else if cp < 0x800 {
            buf.write_byte(uint8(0xC0 | (cp >> 6)))
            buf.write_byte(uint8(0x80 | (cp & 0x3F)))
        } else if cp < 0x10000 {
            buf.write_byte(uint8(0xE0 | (cp >> 12)))
            buf.write_byte(uint8(0x80 | ((cp >> 6) & 0x3F)))
            buf.write_byte(uint8(0x80 | (cp & 0x3F)))
        } else {
            buf.write_byte(uint8(0xF0 | (cp >> 18)))
            buf.write_byte(uint8(0x80 | ((cp >> 12) & 0x3F)))
            buf.write_byte(uint8(0x80 | ((cp >> 6) & 0x3F)))
            buf.write_byte(uint8(0x80 | (cp & 0x3F)))
        }
    }

    /// Parse a JSON number at the current position.
    ///
    /// A number without a fraction and without an exponent is an integer,
    /// otherwise it is a float.
    func parse_number() Value {
        let start = pos

        if pos < src.len() && src[pos] == "-" {
            pos += 1
        }

        // The integer part is either a single '0' or a non-zero digit
        // followed by more digits.
        if pos >= src.len() || !is_digit(src[pos]) {
            fail("Invalid JSON number")
            return Null()
        }
        if src[pos] == "0" {
            pos += 1
        } else {
            while pos < src.len() && is_digit(src[pos]) {
                pos += 1
            }
        }

        var is_float = false

        // The optional fraction.
        if pos < src.len() && src[pos] == "." {
            is_float = true
            pos += 1
            if pos >= src.len() || !is_digit(src[pos]) {
                fail("Invalid JSON number")
                return Null()
            }
            while pos < src.len() && is_digit(src[pos]) {
                pos += 1
            }
        }

        // The optional exponent.
        if pos < src.len() && (src[pos] == "e" || src[pos] == "E") {
            is_float = true
            pos += 1
            if pos < src.len() && (src[pos] == "+" || src[pos] == "-") {
                pos += 1
            }
            if pos >= src.len() || !is_digit(src[pos]) {
                fail("Invalid JSON number")
                return Null()
            }
            while pos < src.len() && is_digit(src[pos]) {
                pos += 1
            }
        }

        let text = src.substr(start, pos)
        if is_float {
            return Float(text.to_float())
        }
        return Integer(text.to_int())
    }

    /// Count one more level of object or array nesting.
    ///
    /// Records a syntax error if the nesting would go deeper than
    /// `MAX_DEPTH`, so that a hostile document cannot run the process out
    /// of stack.
    func enter_nested() {
        depth += 1
        if depth > MAX_DEPTH {
            fail("JSON nesting too deep")
        }
    }

    /// Skip the whitespace at the current position.
    func skip_ws() {
        var done = false
        while !done {
            if pos >= src.len() {
                done = true
            } else {
                let ch = src[pos]
                if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
                    pos += 1
                } else {
                    done = true
                }
            }
        }
    }

    /// Return true if `ch` is a decimal digit.
    func is_digit(ch str) bool {
        return ch >= "0" && ch <= "9"
    }

    /// Consume the literal `word` at the current position.
    func expect_word(word str) {
        let end = pos + word.len()
        if end > src.len() || src.substr(pos, end) != word {
            fail("Invalid JSON literal")
            return
        }
        pos = end
    }
}
