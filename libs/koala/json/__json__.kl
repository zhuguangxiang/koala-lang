/// Parse the JSON file at `path` and return its root value.
///
/// See [`Parser`](#parser) for the supported JSON syntax.
///
/// Errors
///
/// Panic if the file cannot be opened, or if its content is not valid
/// JSON.
pub func parse_file(path str) Value {
    let f = open(path, "r")!

    // Read the whole file in chunks; `read` returns 0 at EOF and a
    // negative value on error.
    let chunk = bytes(8192)
    let acc = Buffer(8192)

    loop {
        let n = f.read(chunk)
        if n <= 0 { break } // stop on EOF (0) or read error (negative)
        acc.write(chunk.view(0, n))
    }

    f.close()

    return parse_str(acc.to_str())
}

/// Parse the JSON text `s` and return its root value.
///
/// See [`Parser`](#parser) for the supported JSON syntax.
///
/// Errors
///
/// Panic if `s` is not valid JSON.
pub func parse_str(s str) Value {
    let parser = Parser(s)
    return parser.parse()
}

/// Parse the JSON text `s` and return its root as an [`Object`](#object).
///
/// Errors
///
/// Panic if `s` is not valid JSON, or if its root is not an object.
pub func parse_object(s str) Object {
    let v = parse_str(s)
    if v is Object {
        return v
    }
    panic("json.parse_object: root is " + value_type_name(v) + ", expected Object")
}

/// Parse the JSON text `s` and return its root as an [`Array`](#array).
///
/// Errors
///
/// Panic if `s` is not valid JSON, or if its root is not an array.
pub func parse_array(s str) Array {
    let v = parse_str(s)
    if v is Array {
        return v
    }
    panic("json.parse_array: root is " + value_type_name(v) + ", expected Array")
}

/// Parse the JSON text `s` and return its root as an [`Object`](#object).
///
/// Python-style name for [`parse_object`](#parse_object): a JSON object
/// maps to a Python `dict`. The result is a concrete `Object`, so no
/// `as` cast or `!` unwrap is needed before indexing it.
///
/// Errors
///
/// Panic if `s` is not valid JSON, or if its root is not an object.
pub func parse_dict(s str) Object = parse_object(s)

/// Parse the JSON text `s` and return its root as an [`Array`](#array).
///
/// Python-style name for [`parse_array`](#parse_array): a JSON array
/// maps to a Python `list`. The result is a concrete `Array`, so no
/// `as` cast or `!` unwrap is needed before indexing it.
///
/// Errors
///
/// Panic if `s` is not valid JSON, or if its root is not an array.
pub func parse_list(s str) Array = parse_array(s)

/// Serialize `v` to JSON text.
///
/// The output is compact by default. A positive `indent` produces a
/// pretty-printed text, where every nested level is indented by that
/// many spaces.
///
/// Example
///
/// ```kl
/// print(json.dump(json.parse_str("{\"a\":[1,2]}")))
/// print(json.dump(json.parse_str("{\"a\":[1,2]}"), 2))
/// ```
pub func dump(v Value, indent = 0) str {
    if indent <= 0 {
        return v.to_json()
    }

    let buf = Buffer()
    write_value(buf, v, indent, 0)
    return buf.to_str()
}

/// Parse the JSON text `s` and return its root value (alias of
/// [`parse_str`](#parse_str), named after Python's `json.loads`).
pub func loads(s str) Value = parse_str(s)

/// Parse the JSON file at `path` and return its root value (alias of
/// [`parse_file`](#parse_file), named after Python's `json.load`).
pub func load(path str) Value = parse_file(path)

/// Parse the JSON file at `path` and return its root as an
/// [`Object`](#object).
///
/// Like [`load`](#load), but narrows the root to a concrete `Object`, so
/// no `as` cast or `!` unwrap is needed before indexing it.
///
/// Errors
///
/// Panic if the file cannot be opened, if its content is not valid JSON,
/// or if its root is not an object.
pub func load_dict(path str) Object {
    let v = parse_file(path)
    if v is Object {
        return v
    }
    panic("json.load_dict: root is " + value_type_name(v) + ", expected Object")
}

/// Parse the JSON file at `path` and return its root as an
/// [`Array`](#array).
///
/// Like [`load`](#load), but narrows the root to a concrete `Array`, so
/// no `as` cast or `!` unwrap is needed before indexing it.
///
/// Errors
///
/// Panic if the file cannot be opened, if its content is not valid JSON,
/// or if its root is not an array.
pub func load_list(path str) Array {
    let v = parse_file(path)
    if v is Array {
        return v
    }
    panic("json.load_list: root is " + value_type_name(v) + ", expected Array")
}

/// Serialize `v` to JSON text (alias of [`dump`](#dump), named after
/// Python's `json.dumps`).
pub func dumps(v Value, indent = 0) str = dump(v, indent)

/// Serialize `v` to JSON text and write it to the file at `path`,
/// like Python's `json.dump(v, fp)`.
///
/// Panic if the file cannot be opened for writing.
pub func dump_file(v Value, path str, indent = 0) {
    let f = open(path, "w")!
    f.write_str(dump(v, indent))
    f.close()
}

/// Return the concrete type name of `v`, for use in type-error messages.
func value_type_name(v Value) str {
    switch v {
        case is Object: return "Object"
        case is Array: return "Array"
        case is String: return "String"
        case is Integer: return "Integer"
        case is Float: return "Float"
        case is Boolean: return "Boolean"
        case is Null: return "Null"
        case _: return "Value"
    }
}

/// Write the value `v` to `buf`.
func write_value(buf Buffer, v Value, indent int, level int) {
    if v is Object {
        write_object(buf, v, indent, level)
    } else if v is Array {
        write_array(buf, v, indent, level)
    } else {
        buf.write_str(v.to_json())
    }
}

/// Write the object `obj` to `buf`.
func write_object(buf Buffer, obj Object, indent int, level int) {
    if obj.len() == 0 {
        buf.write_str("{}")
        return
    }

    buf.write_str("{")
    var first = true
    for k in obj.keys() {
        if !first {
            buf.write_str(",")
        }
        first = false
        write_break(buf, indent, level + 1)
        buf.write_str(quote(k))
        buf.write_str(": ")
        write_value(buf, obj[k], indent, level + 1)
    }
    write_break(buf, indent, level)
    buf.write_str("}")
}

/// Write the array `arr` to `buf`.
func write_array(buf Buffer, arr Array, indent int, level int) {
    if arr.len() == 0 {
        buf.write_str("[]")
        return
    }

    buf.write_str("[")
    var first = true
    for elem in arr.value {
        if !first {
            buf.write_str(",")
        }
        first = false
        write_break(buf, indent, level + 1)
        write_value(buf, elem, indent, level + 1)
    }
    write_break(buf, indent, level)
    buf.write_str("]")
}

/// Write a line break followed by the indentation of the level `level`.
func write_break(buf Buffer, indent int, level int) {
    buf.write_str("\n")

    let count = level * indent
    var i = 0
    while i < count {
        buf.write_str(" ")
        i += 1
    }
}
