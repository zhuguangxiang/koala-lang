// RUN: koala %s --test

import "koala/json"
import "std/ut"

// ---------------------------------------------------------------------------
// arrays
// ---------------------------------------------------------------------------

@test
func test_parse_empty_array() {
    let arr = json.parse_array("[]")
    ut.assert_eq(arr.len(), 0)
}

@test
func test_parse_integer_array() {
    let arr = json.parse_array("[1,2,3]")
    ut.assert_eq(arr.len(), 3)
    ut.assert_eq(arr.get_int(0), 1)
    ut.assert_eq(arr.get_int(2), 3)
}

@test
func test_parse_mixed_array() {
    let arr = json.parse_array("[1,\"two\",3.5,true,null]")
    ut.assert_eq(arr.len(), 5)
    ut.assert_eq(arr.get_int(0), 1)
    ut.assert_eq(arr.get_str(1), "two")
    ut.assert_float_close(arr.get_float(2), 3.5)
    ut.assert_true(arr.get_bool(3))
    ut.assert_true(arr[4] is json.Null)
}

@test
func test_parse_nested_array() {
    let arr = json.parse_array("[[1,2],[3]]")
    ut.assert_eq(arr.len(), 2)
    let inner = arr.get_array(0)
    ut.assert_eq(inner.len(), 2)
    ut.assert_eq(inner.get_int(1), 2)
}

@test
func test_parse_array_of_objects() {
    let arr = json.parse_array("[{\"a\":1},{\"b\":2}]")
    ut.assert_eq(arr.len(), 2)
    let first = arr.get_object(0)
    ut.assert_eq(first.get_int("a"), 1)
}

@test
func test_parse_array_ignores_whitespace() {
    let arr = json.parse_array("[\n  1,\n  2\n]")
    ut.assert_eq(arr.len(), 2)
    ut.assert_eq(arr.get_int(0), 1)
    ut.assert_eq(arr.get_int(1), 2)
}

// ---------------------------------------------------------------------------
// list-style access: indexing, setitem, iteration, append/pop
// ---------------------------------------------------------------------------

@test
func test_array_index_and_set() {
    let arr = json.parse_array("[1,2]")
    ut.assert_true(arr[0] is json.Integer)
    arr[0] = json.Integer(9)
    ut.assert_eq(arr.get_int(0), 9)
}

@test
func test_array_iterate() {
    let arr = json.parse_array("[1,2,3]")
    var sum = 0
    for v in arr {
        if v is json.Integer { sum += v.value }
    }
    ut.assert_eq(sum, 6)
}

@test
func test_array_append_pop() {
    let arr = json.Array()
    arr.append(json.Integer(1))
    arr.append(json.Integer(2))
    ut.assert_eq(arr.len(), 2)
    let last = arr.pop()
    ut.assert_true(last is json.Integer)
    ut.assert_eq(arr.len(), 1)
}

// ---------------------------------------------------------------------------
// building arrays
// ---------------------------------------------------------------------------

@test
func test_build_array() {
    let arr = json.Array()
    arr.add(json.Integer(1))
    arr.add(json.String("two"))
    ut.assert_eq(arr.len(), 2)
    ut.assert_eq(arr.get_int(0), 1)
}

@test
func test_extend_into_empty_array() {
    let arr = json.Array()
    let src = list[json.Value]()
    src.append(json.Integer(1))
    src.append(json.String("two"))
    arr.extend(src)
    ut.assert_eq(arr.len(), 2)
    ut.assert_eq(arr.get_int(0), 1)
    ut.assert_eq(arr.get_str(1), "two")
}

// ---------------------------------------------------------------------------
// errors
// ---------------------------------------------------------------------------

@should_panic("Expected ',' or ']' in JSON array")
func test_parse_array_requires_comma_panics() {
    let v = json.parse_str("[1 2]")
}

@should_panic("Invalid JSON number")
func test_parse_array_rejects_trailing_comma_panics() {
    let v = json.parse_str("[1,2,]")
}

@should_panic("Unexpected end of JSON input")
func test_parse_unterminated_array_panics() {
    let v = json.parse_str("[1,2")
}

// ---------------------------------------------------------------------------
// nesting depth
// ---------------------------------------------------------------------------

@test
func test_parse_nesting_at_the_limit() {
    var text = "1"
    var i = 0
    while i < 64 {
        text = "[" + text + "]"
        i += 1
    }
    var cur = json.parse_str(text)
    var j = 0
    while j < 64 {
        let arr = (cur as json.Array)!
        cur = arr[0]
        j += 1
    }
    let n = (cur as json.Integer)!
    ut.assert_eq(n.value, 1)
}

@should_panic("JSON nesting too deep")
func test_parse_nesting_past_the_limit_panics() {
    var text = "1"
    var i = 0
    while i < 65 {
        text = "[" + text + "]"
        i += 1
    }
    let v = json.parse_str(text)
}

@should_panic("JSON nesting too deep")
func test_parse_nesting_past_the_limit_panics_in_object() {
    var text = "1"
    var i = 0
    while i < 33 {
        text = "[" + text + "]"
        text = "{\"k\":" + text + "}"
        i += 1
    }
    let v = json.parse_str(text)
}

// ---------------------------------------------------------------------------
// parse_list: Python-style name, concrete Array, no as/! needed
// ---------------------------------------------------------------------------

@test
func test_parse_list_direct_index() {
    let arr = json.parse_list("[1,2,3]")
    arr[0] = json.Integer(9)
    ut.assert_eq(arr.get_int(0), 9)
    ut.assert_eq(arr.len(), 3)
}

@should_panic("json.parse_array: root is Object, expected Array")
func test_parse_list_wrong_root_panics() {
    let arr = json.parse_list("{\"a\":1}")
}

