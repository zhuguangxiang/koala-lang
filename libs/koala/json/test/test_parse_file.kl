// RUN: koala %s --test

import "koala/json"
import "std/fs"
import "std/ut"

@test
func test_parse_file() {
    let path = "/tmp/kl_json_test.json"
    let content = "{\"name\":\"koala\",\"port\":8080}"
    fs.write_str(path, content)

    let obj = (json.parse_file(path) as json.Object)!
    ut.assert_eq(obj.get_str("name"), "koala")
    ut.assert_eq(obj.get_int("port"), 8080)

    fs.remove(path)
}

@test
func test_parse_file_with_nested_values() {
    let path = "/tmp/kl_json_test.json"
    let content = "{\"nums\":[1,2,3],\"nested\":{\"flag\":true}}\n"
    fs.write_str(path, content)

    let obj = (json.parse_file(path) as json.Object)!
    let nums = obj.get_array("nums")
    ut.assert_eq(nums.len(), 3)

    let nested = obj.get_object("nested")
    ut.assert_true(nested.get_bool("flag"))

    fs.remove(path)
}

@test
func test_parse_file_matches_parse_str() {
    let path = "/tmp/kl_json_test.json"
    let content = "{\"nums\":[1,2,3],\"flag\":true}\n"
    fs.write_str(path, content)

    let from_file = json.parse_file(path)
    let from_str = json.parse_str(content)
    ut.assert_eq(json.dump(from_file), json.dump(from_str))

    fs.remove(path)
}

@test
func test_dump_file_round_trip() {
    let path = "/tmp/kl_json_dump_test.json"
    let obj = json.parse_object("{\"a\":[1,2],\"b\":\"x\"}")
    json.dump_file(obj, path)

    let again = (json.parse_file(path) as json.Object)!
    ut.assert_eq(json.dump(again), json.dump(obj))

    fs.remove(path)
}

@test
func test_loads_dumps_aliases() {
    let v = json.loads("{\"a\":1}")
    ut.assert_eq(json.dumps(v), "{\"a\":1}")
}

@should_panic
func test_parse_file_missing_panics() {
    let v = json.parse_file("/tmp/kl_json_no_such_file.json")
}

@test
func test_load_dict_direct() {
    let path = "/tmp/kl_json_load_dict.json"
    fs.write_str(path, "{\"port\":8080}")
    let obj = json.load_dict(path)
    obj["port"] = json.Integer(9090)
    ut.assert_eq(obj.get_int("port"), 9090)
    fs.remove(path)
}

@test
func test_load_list_direct() {
    let path = "/tmp/kl_json_load_list.json"
    fs.write_str(path, "[1,2,3]")
    let arr = json.load_list(path)
    arr[0] = json.Integer(9)
    ut.assert_eq(arr.get_int(0), 9)
    fs.remove(path)
}

@should_panic("json.load_dict: root is Array, expected Object")
func test_load_dict_wrong_root_panics() {
    let path = "/tmp/kl_json_load_dict_bad.json"
    fs.write_str(path, "[1,2]")
    let obj = json.load_dict(path)
}

@should_panic("json.load_list: root is Object, expected Array")
func test_load_list_wrong_root_panics() {
    let path = "/tmp/kl_json_load_list_bad.json"
    fs.write_str(path, "{\"a\":1}")
    let arr = json.load_list(path)
}

