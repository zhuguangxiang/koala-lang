// RUN: koala %s --test

import "koala/json"
import "std/ut"

// ---------------------------------------------------------------------------
// objects
// ---------------------------------------------------------------------------

@test
func test_parse_empty_object() {
    let obj = json.parse_object("{}")
    ut.assert_eq(obj.len(), 0)
    var n = 0
    for k in obj.keys() { n += 1 }
    ut.assert_eq(n, 0)
}

@test
func test_parse_flat_object() {
    let obj = json.parse_object("{\"name\":\"koala\",\"port\":8080}")
    ut.assert_eq(obj.len(), 2)
    ut.assert_eq(obj.get_str("name"), "koala")
    ut.assert_eq(obj.get_int("port"), 8080)
}

@test
func test_parse_object_contains_key() {
    let obj = json.parse_object("{\"a\":1}")
    ut.assert_true("a" in obj)
    ut.assert_false("b" in obj)
}

@test
func test_parse_object_keeps_key_order() {
    let obj = json.parse_object("{\"b\":1,\"a\":2,\"c\":3}")
    let keys = list[str]()
    for k in obj.keys() { keys.append(k) }
    ut.assert_eq(keys.len(), 3)
    ut.assert_eq(keys[0], "b")
    ut.assert_eq(keys[1], "a")
    ut.assert_eq(keys[2], "c")
}

@test
func test_parse_nested_object() {
    let obj = json.parse_object("{\"server\":{\"host\":\"localhost\",\"port\":8080}}")
    let server = obj.get_object("server")
    ut.assert_eq(server.get_str("host"), "localhost")
    ut.assert_eq(server.get_int("port"), 8080)
}

@test
func test_parse_object_with_mixed_values() {
    let obj = json.parse_object("{\"s\":\"x\",\"i\":1,\"f\":1.5,\"b\":true,\"n\":null}")
    ut.assert_eq(obj.get_str("s"), "x")
    ut.assert_eq(obj.get_int("i"), 1)
    ut.assert_float_close(obj.get_float("f"), 1.5)
    ut.assert_true(obj.get_bool("b"))
    ut.assert_true(obj["n"] is json.Null)
}

@test
func test_parse_object_duplicate_key_keeps_last() {
    let obj = json.parse_object("{\"a\":1,\"a\":2}")
    ut.assert_eq(obj.len(), 1)
    ut.assert_eq(obj.get_int("a"), 2)
}

@test
func test_parse_object_ignores_whitespace() {
    let obj = json.parse_object("{\n  \"a\" : 1 ,\n  \"b\" : 2\n}")
    ut.assert_eq(obj.len(), 2)
    ut.assert_eq(obj.get_int("a"), 1)
    ut.assert_eq(obj.get_int("b"), 2)
}

// ---------------------------------------------------------------------------
// dict-style access: indexing, optional get, get_or, iteration
// ---------------------------------------------------------------------------

@test
func test_object_index_get() {
    let obj = json.parse_object("{\"a\":1}")
    ut.assert_true(obj["a"] is json.Integer)
    let v = obj["a"]
    if v is json.Integer { ut.assert_eq(v.value, 1) }
}

@test
func test_object_get_optional() {
    let obj = json.parse_object("{\"a\":1}")
    ut.assert_true(obj.get("a") != nil)
    ut.assert_true(obj.get("missing") == nil)
}

@test
func test_object_get_or_default() {
    let obj = json.parse_object("{\"a\":1}")
    let d = json.Integer(99)
    let got = obj.get_or("missing", d)
    ut.assert_true(got is json.Integer)
    if got is json.Integer { ut.assert_eq(got.value, 99) }
}

@test
func test_object_iterate_values() {
    let obj = json.parse_object("{\"a\":1,\"b\":2}")
    var sum = 0
    for v in obj.values() {
        if v is json.Integer { sum += v.value }
    }
    ut.assert_eq(sum, 3)
}

@test
func test_object_iterate_items() {
    let obj = json.parse_object("{\"a\":1,\"b\":2}")
    var keys = ""
    for (k, v) in obj.items() { keys += k }
    ut.assert_eq(keys, "ab")
}

// ---------------------------------------------------------------------------
// building objects
// ---------------------------------------------------------------------------

@test
func test_build_object() {
    let obj = json.Object()
    obj["name"] = json.String("koala")
    obj["port"] = json.Integer(8080)
    ut.assert_eq(obj.len(), 2)
    ut.assert_true("name" in obj)
    ut.assert_eq(obj.get_str("name"), "koala")
}

@test
func test_build_object_replaces_value() {
    let obj = json.Object()
    obj.add("a", json.Integer(1))
    obj.add("a", json.Integer(2))
    ut.assert_eq(obj.len(), 1)
    ut.assert_eq(obj.get_int("a"), 2)
}

// ---------------------------------------------------------------------------
// errors
// ---------------------------------------------------------------------------

@should_panic("Expected a string key in JSON object")
func test_parse_object_requires_string_key_panics() {
    let v = json.parse_str("{1:2}")
}

@should_panic("Expected ':' after a key in JSON object")
func test_parse_object_requires_colon_panics() {
    let v = json.parse_str("{\"a\" 1}")
}

@should_panic("Expected ',' or '}' in JSON object")
func test_parse_object_requires_comma_panics() {
    let v = json.parse_str("{\"a\":1 \"b\":2}")
}

@should_panic("Unexpected end of JSON input")
func test_parse_unterminated_object_panics() {
    let v = json.parse_str("{\"a\":1")
}

// ---------------------------------------------------------------------------
// parse_dict: Python-style name, concrete Object, no as/! needed
// ---------------------------------------------------------------------------

@test
func test_parse_dict_direct_index() {
    let obj = json.parse_dict("{\"port\":8080}")
    obj["port"] = json.Integer(9090)
    ut.assert_eq(obj.get_int("port"), 9090)
}

@should_panic("json.parse_object: root is Array, expected Object")
func test_parse_dict_wrong_root_panics() {
    let obj = json.parse_dict("[1,2]")
}

