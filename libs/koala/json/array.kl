/// A JSON array value.
///
/// Elements are stored as `Value`, so strings, integers, floats,
/// booleans, nulls, objects and arrays may be mixed freely.
///
/// It implements `MutableSequence[Value]`, so it supports list-style
/// access: `arr[i]`, `arr[i] = v`, `append`, `for x in arr`, `len(arr)`.
pub class Array : Value & MutableSequence[Value] {
    /// The elements of the array.
    pub let value = list[Value]()

    pub func __init__() {}

    /// Return an iterator over the elements, advancing by `step`.
    pub func iter(step = 1) Iterator[Value] = value.iter(step)

    /// Return the number of elements.
    pub func len() int = value.len()

    /// Return true if the array contains `v`.
    pub func __contains__(v Value) bool = v in value

    /// Return the element at `idx`. Panic if `idx` is out of range.
    pub func __getitem__(idx int) Value = value[idx]

    /// Return the first index of `v` in `[start, end)`, or -1 if absent.
    pub func index(v Value, start = 0, end = -1) int = value.index(v, start, end)

    /// Return the number of occurrences of `v` in `[start, end)`.
    pub func count(v Value, start = 0, end = -1) int = value.count(v, start, end)

    /// Set the element at `idx` to `v`. Panic if `idx` is out of range.
    pub func __setitem__(idx int, v Value) {
        value[idx] = v
    }

    /// Append `v` to the end of the array.
    pub func append(v Value) {
        value.append(v)
    }

    /// Append `v` to the end of the array (alias of `append`).
    pub func add(v Value) {
        value.append(v)
    }

    /// Append all values from `values` to the end of the array.
    pub func extend(values Iterable[Value]) {
        value.extend(values)
    }

    /// Insert `v` at `idx`, shifting later elements to the right.
    pub func insert(idx int, v Value) {
        value.insert(idx, v)
    }

    /// Remove the first occurrence of `v`. Panic if `v` is not present.
    pub func remove(v Value) {
        value.remove(v)
    }

    /// Remove and return the element at `idx` (default: the last one).
    pub func pop(idx = -1) Value = value.pop(idx)

    /// Remove all elements, leaving the array empty.
    pub func clear() {
        value.clear()
    }

    /// Return the string element at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not a String.
    pub func get_str(idx int) str {
        let v = value[idx]
        if v is String {
            return v.value
        }
        panic("json.Array.get_str: index " + str(idx) + " is " + value_type_name(v) + ", expected String")
    }

    /// Return the integer element at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not an Integer.
    pub func get_int(idx int) int {
        let v = value[idx]
        if v is Integer {
            return v.value
        }
        panic("json.Array.get_int: index " + str(idx) + " is " + value_type_name(v) + ", expected Integer")
    }

    /// Return the float element at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not a Float.
    pub func get_float(idx int) float {
        let v = value[idx]
        if v is Float {
            return v.value
        }
        panic("json.Array.get_float: index " + str(idx) + " is " + value_type_name(v) + ", expected Float")
    }

    /// Return the boolean element at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not a Boolean.
    pub func get_bool(idx int) bool {
        let v = value[idx]
        if v is Boolean {
            return v.value
        }
        panic("json.Array.get_bool: index " + str(idx) + " is " + value_type_name(v) + ", expected Boolean")
    }

    /// Return the object element at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not an Object.
    pub func get_object(idx int) Object {
        let v = value[idx]
        if v is Object {
            return v
        }
        panic("json.Array.get_object: index " + str(idx) + " is " + value_type_name(v) + ", expected Object")
    }

    /// Return the array element at `idx`.
    ///
    /// Panic if `idx` is out of range or if the element is not an Array.
    pub func get_array(idx int) Array {
        let v = value[idx]
        if v is Array {
            return v
        }
        panic("json.Array.get_array: index " + str(idx) + " is " + value_type_name(v) + ", expected Array")
    }

    /// Format the elements for display.
    pub func fmt(f Formatter) {
        value.fmt(f)
    }

    /// Serialize to a JSON array, e.g. `[1,"two",true]`.
    pub func to_json() str {
        let buf = Buffer()
        buf.write_str("[")
        var first = true
        for elem in value {
            if !first {
                buf.write_str(",")
            }
            first = false
            buf.write_str(elem.to_json())
        }
        buf.write_str("]")
        return buf.to_str()
    }
}
