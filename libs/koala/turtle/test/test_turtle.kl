import "std/ut"
import "koala/turtle"

// These tests exercise the turtle state machine only: no done()/update() is
// called, so no SDL window is opened and the suite runs headless. Rendering
// is covered by the manual demo, not here.

func near(a float, b float) bool {
    var d = a - b
    if d < 0.0 { d = -d }
    return d < 0.001
}

@test
func test_initial_state() {
    let t = turtle.Turtle()
    ut.assert(near(t.xcor(), 0.0))
    ut.assert(near(t.ycor(), 0.0))
    ut.assert(near(t.heading(), 0.0))
    ut.assert(t.isdown())
}

@test
func test_forward() {
    let t = turtle.Turtle()
    t.forward(100.0)
    ut.assert(near(t.xcor(), 100.0))
    ut.assert(near(t.ycor(), 0.0))
}

@test
func test_turn_then_forward() {
    let t = turtle.Turtle()
    t.left(90.0)
    t.forward(100.0)
    ut.assert(near(t.xcor(), 0.0))
    ut.assert(near(t.ycor(), 100.0))
    ut.assert(near(t.heading(), 90.0))
}

@test
func test_right_turn() {
    let t = turtle.Turtle()
    t.left(90.0)
    t.right(90.0)
    ut.assert(near(t.heading(), 0.0))
}

@test
func test_pen_up_down() {
    let t = turtle.Turtle()
    t.penup()
    ut.assert(!t.isdown())
    t.pendown()
    ut.assert(t.isdown())
}

@test
func test_goto() {
    let t = turtle.Turtle()
    t.goto(30.0, 40.0)
    ut.assert(near(t.xcor(), 30.0))
    ut.assert(near(t.ycor(), 40.0))
}

@test
func test_setheading() {
    let t = turtle.Turtle()
    t.setheading(180.0)
    ut.assert(near(t.heading(), 180.0))
}

@test
func test_home() {
    let t = turtle.Turtle()
    t.forward(50.0)
    t.left(45.0)
    t.home()
    ut.assert(near(t.xcor(), 0.0))
    ut.assert(near(t.ycor(), 0.0))
    ut.assert(near(t.heading(), 0.0))
}

@test
func test_backward() {
    let t = turtle.Turtle()
    t.backward(100.0)
    ut.assert(near(t.xcor(), -100.0))
    ut.assert(near(t.ycor(), 0.0))
}