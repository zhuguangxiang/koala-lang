/// An HTTP/1.1 request: method, URL, ordered headers, and body.
///
/// Headers are kept as an ordered list rather than a map so the wire
/// format is deterministic and caller-controlled, which makes the
/// serialized bytes easy to assert against in tests.
///
/// `Host` is added from the URL unless the caller already set it, so a
/// request always carries exactly one `Host` field (RFC 7230 §5.4).
/// `Content-Length` is added when the body is non-empty and the caller
/// has not already set it.

import "std/socket" as so

pub class Request {
    let _method str
    let _url Url
    let _headers list[list[str]]
    let _body bytes

    pub func __init__(method str, url Url, headers list[list[str]], body bytes) {
        _method = method
        _url = url
        _headers = headers
        _body = body
    }

    pub func method() str { return _method }
    pub func url() Url { return _url }
    pub func body() bytes { return _body }
    pub func headers() list[list[str]] { return _headers }

    /// Header lookup, case-insensitive. Returns the first matching
    /// value, or nil when absent. The read side of `header`; a handler
    /// uses it to see what the client sent.
    pub func header_value(name str) str? {
        return _header_value(_headers, name)
    }

    /// Build a GET request with no body and no extra headers.
    pub static func get(url Url) Request {
        return Request("GET", url, list[list[str]](), bytes(0))
    }

    /// Build a POST request with `body` and an octet-stream content type.
    pub static func post(url Url, body bytes) Request {
        let r = Request("POST", url, list[list[str]](), body)
        r.header("Content-Type", "application/octet-stream")
        return r
    }

    /// Parse a complete request from the bytes a client sent: the
    /// receiving counterpart of `to_bytes`.
    ///
    /// `data` must hold the whole message, sized by Content-Length or
    /// chunked encoding. Returns nil on a malformed request line, head,
    /// or authority. The request target becomes `url().path()`, and the
    /// Host field supplies the authority when the target is origin-form.
    pub static func parse(data bytes) Request? {
        let parser = _Parser.request()
        if parser == nil { return nil }
        let req = _parse_request(parser, data)
        parser.close()
        return req
    }

    /// Set a header, replacing the value of an existing field with the
    /// same name. Comparison is case-insensitive as HTTP requires, so
    /// `Content-Length` and `content-length` name the same field.
    pub func header(name str, value str) {
        var i = 0
        while i < _headers.len() {
            if _header_name_eq(_headers[i][0], name) {
                _headers[i][1] = value
                return
            }
            i += 1
        }
        let pair = list[str]()
        pair.append(name)
        pair.append(value)
        _headers.append(pair)
    }

    /// Serialize this request to the exact bytes sent over the wire.
    ///
    /// The output is `METHOD path HTTP/1.1\r\n`, the `Host` field (from
    /// the URL unless the caller set one), every user header in
    /// insertion order, `Content-Length` when applicable, a blank line,
    /// and the body.
    pub func to_bytes() bytes {
        let buf = Buffer()
        buf.write_str(_method)
        buf.write_str(" ")
        buf.write_str(_url.path())
        buf.write_str(" HTTP/1.1\r\n")

        if !_has_header("Host") {
            _write_field(buf, "Host", _url.host_header())
        }
        var i = 0
        while i < _headers.len() {
            _write_field(buf, _headers[i][0], _headers[i][1])
            i += 1
        }
        if _body.len() > 0 && !_has_header("Content-Length") {
            _write_field(buf, "Content-Length", str(_body.len()))
        }

        buf.write_str("\r\n")
        buf.write(_body)
        return buf.to_bytes()
    }

    func _has_header(name str) bool {
        var i = 0
        while i < _headers.len() {
            if _header_name_eq(_headers[i][0], name) { return true }
            i += 1
        }
        return false
    }
}

// Append one header field line, `name: value` with a trailing CRLF.
func _write_field(buf Buffer, name str, value str) {
    buf.write_str(name)
    buf.write_str(": ")
    buf.write_str(value)
    buf.write_str("\r\n")
}

// Compare two header names ignoring ASCII case (RFC 7230 §3.2). Folding
// through `lower()` keeps the comparison in native code; walking the
// bytes from Koala is an order of magnitude slower.
func _header_name_eq(a str, b str) bool {
    if a.len() != b.len() { return false }
    return a.lower() == b.lower()
}

// ---------------------------------------------------------------------
// Server-side request parsing
// ---------------------------------------------------------------------

// Parse one whole request. Nil on a parse error or a message cut short.
func _parse_request(parser _Parser, data bytes) Request? {
    let n = parser.feed(data, _STATE_COMPLETE)
    if n < 0 { return nil }
    if parser.state() < _STATE_COMPLETE {
        if !parser.finish() { return nil }
    }
    return _request_of(parser)
}

// The request `parser` has parsed. Valid once its state is COMPLETE.
// Shared with the server, which feeds a connection piece by piece.
func _request_of(parser _Parser) Request? {
    let headers = parser.headers()
    let url = _target_url(parser.url(), _header_value(headers, "Host"))
    if let u = url {
        return Request(parser.method(), u, headers, parser.take_body())
    }
    return nil
}

// The Url for a request target (RFC 7230 §5.3). Absolute-form carries
// its own authority; origin-form "/path" and asterisk-form "*" take it
// from the Host field. A target with no authority at all still parses,
// so an HTTP/1.0 client that sends no Host is not rejected.
func _target_url(target str, host str?) Url? {
    if target.len() == 0 { return nil }
    if target.starts_with("http://") || target.starts_with("https://") {
        return Url.parse(target)
    }

    var authority = ""
    if let h = host { authority = h }
    if authority.len() == 0 { return Url("http", "", 80, target) }

    let (h, p) = so.split_host_port(authority) else {
        // No port: the field names the host alone. A colon that
        // split_host_port rejected is a malformed authority.
        if authority.index(":") >= 0 { return nil }
        return Url("http", authority, 80, target)
    }
    return Url("http", h, p, target)
}

// First value of `name`, case-insensitive. Nil when absent.
func _header_value(headers list[list[str]], name str) str? {
    var i = 0
    while i < headers.len() {
        if _header_name_eq(headers[i][0], name) { return headers[i][1] }
        i += 1
    }
    return nil
}
