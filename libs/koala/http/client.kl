import "std/socket" as so
import "koala/tls"

/// An HTTP client.
///
/// The equivalent of Go's http.Client, minus the policy fields that
/// are not needed yet: no redirect following, no cookie store, no
/// per-request timeout. `do` is the one core method; `get` / `post`
/// are the conveniences.
///
/// Zero value is usable: every call dials its own connection, since
/// there is no pool. A `Client` exists so callers can hold one and so
/// the policy fields have a home when they land.
///
/// `options` configures TLS for every request this client sends:
/// `set_skip_verify(true)` for a self-signed server, or
/// `set_ca_pem(...)` to trust a private CA with verification still on.
/// nil keeps the default, which verifies against the system store and
/// bounds the handshake at 5s.
pub class Client {
    let _tls tls.TlsOptions?

    pub func __init__(options tls.TlsOptions? = nil) {
        _tls = options
    }

    /// Send `req` and return the response. The one core method.
    func do(req Request) Response? {
        let conn = _dial(req.url(), _tls)
        if conn == nil { return nil }
        return _send_on(conn, req)
    }

    /// GET `url` and return the parsed response.
    pub func get(url Url) Response? {
        return do(Request.get(url))
    }

    /// POST `body` to `url` and return the parsed response.
    pub func post(url Url, body bytes) Response? {
        return do(Request.post(url, body))
    }

    /// Send `req` and return its response as a stream, the equivalent
    /// of httpx's `client.stream(...)`. The head is read on first
    /// access; see `StreamResponse`.
    pub func stream(req Request, timeout_ms int = 5000) StreamResponse? {
        return _send_stream(req, timeout_ms, _tls)
    }
}

/// GET `url` with a one-shot default client.
pub func get(url Url) Response? { return _do(Request.get(url), nil) }

/// POST `body` to `url` with a one-shot default client.
pub func post(url Url, body bytes) Response? { return _do(Request.post(url, body), nil) }

/// Send `req` and return the parsed response.
///
/// The one shared path behind `get` and `post`. Public so callers can
/// send a hand-built Request.
func _do(req Request, options tls.TlsOptions?) Response? {
    let conn = _dial(req.url(), options)
    if conn == nil { return nil }
    return _send_on(conn, req)
}

// Send `req` over `conn` and read the full response.
//
// Forces Connection: close so a body framed by neither Content-Length
// nor chunked ends when the peer closes. Reads and feeds the parser
// piece by piece, and stops as soon as the response is complete,
// without waiting for EOF.
func _send_on(conn so.Conn, req Request) Response? {
    req.header("Connection", "close")

    let out = req.to_bytes()
    let nw = conn.write(out)
    if nw <= 0 { return nil }

    // Bound the read: with Connection: close the peer should close
    // promptly, but without a timeout a stalled peer blocks forever.
    conn.set_read_timeout(5000)

    let parser = _Parser.response()
    if parser == nil { return nil }

    let response = _read_from(conn, parser)
    parser.close()
    return response
}

// Read from `conn` and feed `parser` until the response is complete.
// Nil on a read error, a parse error, or a response cut short by EOF.
func _read_from(conn so.Conn, parser _Parser) Response? {
    let buf = bytes(4096)
    while parser.state() < _STATE_COMPLETE {
        let n = conn.read(buf)
        if n < 0 { return nil }

        // EOF: a body framed by connection close ends here.
        if n == 0 {
            if !parser.finish() { return nil }
            break
        }

        let fed = parser.feed(buf[0:n], _STATE_COMPLETE)
        if fed < 0 { return nil }
    }

    let head = _head_of(parser)
    return Response(head, parser.take_body())
}

// Pick the transport by scheme. Private: the public surface is
// Client / get / post. `options` nil means the default TLS policy.
func _dial(url Url, options tls.TlsOptions?) so.Conn? {
    let addr = url.host() + ":" + str(url.port())
    if url.is_tls() {
        // Same bound as the read timeout in _send_on: a stalled peer
        // must not block the handshake forever.
        let opts = options ?? tls.TlsOptions().set_handshake_timeout_ms(5000)
        return tls.dial(addr, opts)
    }
    return so.dial(addr, so.SocketTypeSpec.tcp())
}
