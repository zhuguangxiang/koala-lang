import "koala/http" as http
import "koala/sse" as sse
from "koala/http" import Url
from "koala/json" import try_parse_str, Object, Array, String, Integer, Float, Boolean, Value

/// The chat completions endpoint.
///
/// Mirrors Python: client.chat.completions.create(...)
pub class Completions {
    let _api_key str
    let _base_url Url
    let _timeout_ms int

    func __init__(api_key str, base_url Url, timeout_ms int) {
        _api_key = api_key
        _base_url = base_url
        _timeout_ms = timeout_ms
    }

    /// Create a chat completion from plain messages. Parameters match
    /// Python's create() signature order.
    pub func create(model str, messages list[dict[str, str]], temperature float = 1.0, max_tokens int = 0, top_p float = 0.0, frequency_penalty float = 0.0, presence_penalty float = 0.0) ChatCompletion {
        return create_tools(model, _plain(messages), list[ToolDef](), temperature, max_tokens, top_p, frequency_penalty, presence_penalty)
    }

    /// Create a chat completion with tool calling. `tools` declares what
    /// the model may call; `tool_choice` is "auto", "none" or "required",
    /// "" to leave it out. The returned choice's message carries the
    /// calls in `tool_calls`, and `finish_reason` is "tool_calls".
    pub func create_tools(model str, messages list[CompletionMessage], tools list[ToolDef], temperature float = 1.0, max_tokens int = 0, top_p float = 0.0, frequency_penalty float = 0.0, presence_penalty float = 0.0, tool_choice str = "auto") ChatCompletion {
        let url = _endpoint()
        let body = _build_body(model, messages, temperature, max_tokens, top_p, frequency_penalty, presence_penalty, tools, tool_choice, false)
        let resp = _post(url, _api_key, body, _timeout_ms)

        if resp == nil {
            return _parse_completion(0, "", "transport failure: connect or read error")
        }

        return _parse_completion(resp.status(), resp.body().to_str(), "")
    }

    func _endpoint() Url {
        let path = _base_url.path() + "/chat/completions"
        return Url(_base_url.scheme(), _base_url.host(), _base_url.port(), path)
    }

    /// Create a streamed chat completion, as Python's
    /// `create(..., stream=True)`. Returns at once; iterate the chunks
    /// with `for`. Each chunk carries the next piece of text in `delta`;
    /// the final chunk carries `usage` (`stream_options.include_usage`
    /// is sent). The iterator ends at `[DONE]` or the end of the stream.
    /// `ChatStream.ok()` is false on a connect error, an HTTP error, or
    /// a response that is not an SSE stream.
    pub func stream(model str, messages list[dict[str, str]], temperature float = 1.0, max_tokens int = 0, top_p float = 0.0, frequency_penalty float = 0.0, presence_penalty float = 0.0) ChatStream {
        return stream_tools(model, _plain(messages), list[ToolDef](), temperature, max_tokens, top_p, frequency_penalty, presence_penalty)
    }

    /// Stream a chat completion with tool calling. Tool call fragments
    /// arrive as `ChatChunk` tool deltas; `ChatStream.tool_calls()` is
    /// the assembled result once the stream ends.
    pub func stream_tools(model str, messages list[CompletionMessage], tools list[ToolDef], temperature float = 1.0, max_tokens int = 0, top_p float = 0.0, frequency_penalty float = 0.0, presence_penalty float = 0.0, tool_choice str = "auto") ChatStream {
        let url = _endpoint()
        let body = _build_body(model, messages, temperature, max_tokens, top_p, frequency_penalty, presence_penalty, tools, tool_choice, true)

        let headers = list[list[str]]()
        _hdr(headers, "Authorization", "Bearer " + _api_key)
        _hdr(headers, "Content-Type", "application/json")
        _hdr(headers, "Connection", "close")

        let client = http.Client()
        let es = sse.connect_sse(client, "POST", url, headers, body.to_bytes(), _timeout_ms)
        return ChatStream(es)
    }

    func _build_body(model str, messages list[CompletionMessage], temperature float, max_tokens int, top_p float, frequency_penalty float, presence_penalty float, tools list[ToolDef], tool_choice str, streaming bool) str {
        let root = Object()
        root.add("model", String(model))

        let arr = Array()
        var i = 0
        while i < messages.len() {
            arr.add(_message_json(messages[i]))
            i += 1
        }
        root.add("messages", arr)

        if tools.len() > 0 {
            let tarr = Array()
            var j = 0
            while j < tools.len() {
                tarr.add(_tool_json(tools[j]))
                j += 1
            }
            root.add("tools", tarr)
            if tool_choice.len() > 0 {
                root.add("tool_choice", String(tool_choice))
            }
        }

        if temperature != 1.0 {
            root.add("temperature", Float(temperature))
        }
        if max_tokens > 0 {
            root.add("max_tokens", Integer(max_tokens))
        }
        if top_p > 0.0 && top_p < 1.0 {
            root.add("top_p", Float(top_p))
        }
        if frequency_penalty != 0.0 {
            root.add("frequency_penalty", Float(frequency_penalty))
        }
        if presence_penalty != 0.0 {
            root.add("presence_penalty", Float(presence_penalty))
        }
        if streaming {
            root.add("stream", Boolean(true))
            let opts = Object()
            opts.add("include_usage", Boolean(true))
            root.add("stream_options", opts)
        }

        return root.to_json()
    }
}

// The plain messages of `create`/`stream`, as rich messages.
func _plain(messages list[dict[str, str]]) list[CompletionMessage] {
    let out = list[CompletionMessage]()
    var i = 0
    while i < messages.len() {
        out.append(CompletionMessage(messages[i]["role"], messages[i]["content"], list[ToolCall](), "", ""))
        i += 1
    }
    return out
}

// One wire message: the message object from types.kl, so a request and a
// saved session agree on the shape.
func _message_json(m CompletionMessage) Object {
    return message_to_object(m)
}

// One wire entry of `tools`.
func _tool_json(t ToolDef) Object {
    let o = Object()
    o.add("type", String(t.type_))
    let f = Object()
    f.add("name", String(t.function.name))
    f.add("description", String(t.function.description))
    f.add("parameters", t.function.parameters)
    o.add("function", f)
    return o
}

/// The chunks of a streamed chat completion, an iterator: `for chunk in
/// stream`. `ok()` is false when the request failed; `status_code()` and
/// `error_message()` report, as on `ChatCompletion`. `usage()` is the
/// usage of the last chunk that carried one. `tool_calls()` is the tool
/// calls assembled from the stream's fragments, complete once the
/// stream ends; `finish_reason()` is the last reason the server gave.
/// `close()` releases the connection before the stream ends.
pub class ChatStream : Iterator[ChatChunk] {
    let _es sse.EventSource?
    var _it sse.SSEIter? = nil
    var _status int = 0
    var _err str = ""
    var _usage Usage = Usage(0, 0, 0)
    var _ahead ChatChunk? = nil
    var _resolved bool = false
    // Tool call fragments, one slot per `index`, opened on first sight.
    var _tool_ids list[str] = list[str]()
    var _tool_names list[str] = list[str]()
    var _tool_args list[str] = list[str]()
    var _finish str = ""

    func __init__(es sse.EventSource?) {
        _es = es
    }

    // The response head is read lazily, on the first query.
    func _resolve() {
        if _resolved { return }
        _resolved = true
        if let es = _es {
            let status = es.response().status()
            if status == 0 {
                _err = "transport failure: connect or read error"
                es.response().close()
                return
            }
            _status = status
            if status != 200 {
                let buf = Buffer()
                while let chunk = es.response().read() { buf.write(chunk) }
                var msg = _extract_error(buf.to_str())
                if msg.len() == 0 { msg = "HTTP " + str(status) }
                _err = msg
                es.response().close()
                return
            }
            _it = es.iter_sse()
            if _it == nil {
                _err = es.error()
                es.response().close()
            }
        } else {
            _err = "transport failure: connect or read error"
        }
    }

    /// True when the stream is ready to iterate.
    pub func ok() bool {
        _resolve()
        return _it != nil
    }

    /// The HTTP status, 0 on a connect or read failure.
    pub func status_code() int {
        _resolve()
        return _status
    }

    /// The error message, "" when there is none.
    pub func error_message() str {
        _resolve()
        return _err
    }

    /// The usage of the last chunk that carried one (the final chunk).
    pub func usage() Usage { return _usage }

    /// The tool calls the stream asked for, assembled from their
    /// fragments. Complete once the stream ends; a call appears as soon
    /// as its name has arrived.
    pub func tool_calls() list[ToolCall] {
        let out = list[ToolCall]()
        var i = 0
        while i < _tool_names.len() {
            if _tool_names[i].len() > 0 {
                out.append(ToolCall(_tool_ids[i], "function", FunctionCall(_tool_names[i], _tool_args[i])))
            }
            i += 1
        }
        return out
    }

    /// The last non-empty `finish_reason` the server sent ("stop",
    /// "tool_calls", "length", ...), "" when it sent none.
    pub func finish_reason() str { return _finish }

    /// Release the connection; the stream ends where it is.
    pub func close() {
        if let es = _es { es.response().close() }
    }

    pub func has_next() bool {
        _resolve()
        if _ahead != nil { return true }
        _ahead = _next_chunk()
        return _ahead != nil
    }

    pub func next_strict() ChatChunk {
        if !has_next() { panic("No more chunks in ChatStream") }
        let chunk = _ahead!
        _ahead = nil
        return chunk
    }

    pub func next() ChatChunk? {
        if !has_next() { return nil }
        return next_strict()
    }

    // The next chunk from the SSE events: what is not a chunk is
    // skipped, and the stream ends at [DONE] or the end of the events.
    // Fields a proxy sends as null or with other types (e.g. "delta":
    // null, "usage": null) are treated as absent, never fatal.
    func _next_chunk() ChatChunk? {
        if _it == nil { return nil }
        loop {
            if let ev = _it.next() {
                if ev.data == "[DONE]" { return nil }
                let data = try_parse_str(ev.data)
                if data == nil { continue }
                let root = data as Object
                if root == nil { continue }
                let id = _get_str(root, "id")
                let mdl = _get_str(root, "model")
                var delta = ""
                var fr = ""
                var t_index = -1
                var t_id = ""
                var t_name = ""
                var t_args = ""
                if let arr = _get_arr(root, "choices") {
                    if arr.len() > 0 {
                        if let c = arr.value[0] as Object {
                            fr = _get_str(c, "finish_reason")
                            if let d = _get_obj(c, "delta") {
                                delta = _get_str(d, "content")
                                if let calls = _get_arr(d, "tool_calls") {
                                    var j = 0
                                    while j < calls.len() {
                                        if let tc = calls.value[j] as Object {
                                            let ci = _get_int(tc, "index")
                                            let cid = _get_str(tc, "id")
                                            var cname = ""
                                            var cargs = ""
                                            if let f = _get_obj(tc, "function") {
                                                cname = _get_str(f, "name")
                                                cargs = _get_str(f, "arguments")
                                            }
                                            _accum_tool(ci, cid, cname, cargs)
                                            if j == 0 {
                                                t_index = ci
                                                t_id = cid
                                                t_name = cname
                                                t_args = cargs
                                            }
                                        }
                                        j += 1
                                    }
                                }
                            }
                        }
                    }
                }
                if fr.len() > 0 { _finish = fr }
                var usage Usage? = nil
                if let u = _get_obj(root, "usage") {
                    usage = Usage(_get_int(u, "prompt_tokens"), _get_int(u, "completion_tokens"), _get_int(u, "total_tokens"))
                }
                if let u = usage { _usage = u }
                return ChatChunk(id, mdl, delta, fr, usage, t_index, t_id, t_name, t_args)
            }
            return nil
        }
    }

    // Append one tool call fragment to its slot, opening the slot on
    // first sight of `idx`. A fragment may carry only arguments.
    func _accum_tool(idx int, id str, name str, args str) {
        if idx < 0 { return }
        while _tool_ids.len() <= idx {
            _tool_ids.append("")
            _tool_names.append("")
            _tool_args.append("")
        }
        if id.len() > 0 { _tool_ids[idx] = id }
        if name.len() > 0 { _tool_names[idx] = name }
        _tool_args[idx] = _tool_args[idx] + args
    }
}

/// The chat namespace: client.chat.completions
pub class Chat {
    pub let completions Completions

    func __init__(completions Completions) {
        self.completions = completions
    }
}
