from "koala/json" import try_parse_str, Object, Array, String, Integer, Null, Value

// Internal response parsing. Public API shape is in types declared here;
// construction logic is internal.

/// A complete chat completion response — mirrors Python's ChatCompletion.
///
/// User-facing access (same syntax as Python):
///     resp.choices[0].message.content
///     resp.usage.total_tokens
///     resp.model
///     resp.id
///     resp.status_code
///     resp.error_message
pub class ChatCompletion {
    pub let status_code int
    pub let id str
    pub let object str
    pub let created int
    pub let model str
    pub let choices list[Choice]
    pub let usage Usage
    pub let error_message str

    pub func __init__(status int, id str, obj str, created int, model str, choices list[Choice], usage Usage, err str) {
        status_code = status
        self.id = id
        object = obj
        self.created = created
        self.model = model
        self.choices = choices
        self.usage = usage
        error_message = err
    }

    pub func ok() bool { return status_code == 200 }

    pub func first_content() str {
        if choices.len() == 0 { return "" }
        return choices[0].message.content
    }
}

pub class Choice {
    pub let index int
    pub let message CompletionMessage
    pub let finish_reason str

    pub func __init__(index int, message CompletionMessage, finish_reason str) {
        self.index = index
        self.message = message
        self.finish_reason = finish_reason
    }
}

/// The function a tool call names, with the arguments the model wrote.
/// `arguments` is raw JSON text: use `ToolCall.args()` to parse it.
pub class FunctionCall {
    pub let name str
    pub let arguments str

    pub func __init__(name str, arguments str) {
        self.name = name
        self.arguments = arguments
    }
}

/// One tool invocation asked for by the model, an element of
/// `CompletionMessage.tool_calls`.
pub class ToolCall {
    pub let id str
    pub let type_ str
    pub let function FunctionCall

    pub func __init__(id str, type_ str, function FunctionCall) {
        self.id = id
        self.type_ = type_
        self.function = function
    }

    /// The function name, shorthand for `function.name`.
    pub func name() str { return function.name }

    /// The raw argument JSON, shorthand for `function.arguments`.
    pub func arguments() str { return function.arguments }

    /// The arguments parsed as a JSON object, nil when the model wrote
    /// something that is not a JSON object.
    pub func args() Object? {
        let v = try_parse_str(arguments())
        if v == nil { return nil }
        return v as Object
    }
}

/// A function declared in a request's `tools`.
pub class FunctionDef {
    pub let name str
    pub let description str
    pub let parameters Object

    pub func __init__(name str, description str, parameters Object) {
        self.name = name
        self.description = description
        self.parameters = parameters
    }
}

/// One entry of a request's `tools`: a function the model may call.
///
///     let schema = Object()
///     // ... fill in JSON Schema ...
///     let tools = [ToolDef.of("Write", "Write a file", schema)]
pub class ToolDef {
    pub let type_ str
    pub let function FunctionDef

    pub func __init__(type_ str, function FunctionDef) {
        self.type_ = type_
        self.function = function
    }

    /// A `"function"` tool, the only kind the chat API defines.
    pub static func of(name str, description str, parameters Object) ToolDef {
        return ToolDef("function", FunctionDef(name, description, parameters))
    }

    /// The function name, shorthand for `function.name`.
    pub func name() str { return function.name }
}

/// A chat message, in both directions: what a request sends and what a
/// response returns.
///
/// A plain turn carries `role` and `content`. An assistant turn that
/// asks for tools carries `tool_calls`; each answer to a call is a
/// `role: "tool"` message with `tool_call_id` set.
pub class CompletionMessage {
    pub let role str
    pub let content str
    pub let tool_calls list[ToolCall]
    pub let tool_call_id str
    pub let name str

    pub func __init__(role str, content str, tool_calls list[ToolCall], tool_call_id str, name str) {
        self.role = role
        self.content = content
        self.tool_calls = tool_calls
        self.tool_call_id = tool_call_id
        self.name = name
    }

    /// True when the model asked for at least one tool call.
    pub func has_tool_calls() bool { return tool_calls.len() > 0 }
}

pub class Usage {
    pub let prompt_tokens int
    pub let completion_tokens int
    pub let total_tokens int

    pub func __init__(pt int, ct int, tt int) {
        prompt_tokens = pt
        completion_tokens = ct
        total_tokens = tt
    }
}

/// One chunk of a streamed chat completion — mirrors Python's
/// ChatCompletionChunk, flattened to the first choice.
///
///     for chunk in client.chat.completions.stream(...) {
///         print(chunk.delta)
///     }
pub class ChatChunk {
    pub let id str
    pub let model str
    pub let delta str
    pub let finish_reason str
    pub let usage Usage?
    /// The index of the tool call this chunk carries, -1 when it carries
    /// none. The model may ask for several calls at once: the `index`
    /// says which one the fragment belongs to.
    pub let tool_index int
    /// The call's id and function name, set on the chunk that opens it.
    pub let tool_id str
    pub let tool_name str
    /// The next slice of that call's argument JSON; concatenate the
    /// slices in arrival order to get the whole text, or use
    /// `ChatStream.tool_calls()` once the stream ends.
    pub let tool_args_delta str

    pub func __init__(id str, model str, delta str, finish_reason str, usage Usage?, tool_index int = -1, tool_id str = "", tool_name str = "", tool_args_delta str = "") {
        self.id = id
        self.model = model
        self.delta = delta
        self.finish_reason = finish_reason
        self.usage = usage
        self.tool_index = tool_index
        self.tool_id = tool_id
        self.tool_name = tool_name
        self.tool_args_delta = tool_args_delta
    }

    /// True when the chunk carries a piece of a tool call.
    pub func has_tool_delta() bool { return tool_index >= 0 }
}

// ---- internal: build ChatCompletion from raw JSON ----

func _parse_completion(status int, body str, transport_err str) ChatCompletion {
    if status == 0 {
        return _error_completion(0, transport_err)
    }
    if status != 200 {
        var msg = _extract_error(body)
        if msg.len() == 0 { msg = "HTTP " + str(status) }
        return _error_completion(status, msg)
    }

    let v = try_parse_str(body)
    if v == nil {
        return _error_completion(status, "malformed JSON in the response body")
    }
    let root = v as Object
    if root == nil {
        return _error_completion(status, "the response body is not a JSON object")
    }
    let rid = _get_str(root, "id")
    let obj = _get_str(root, "object")
    let created = _get_int(root, "created")
    let mdl = _get_str(root, "model")

    let choices = list[Choice]()
    if let arr = _get_arr(root, "choices") {
        var i = 0
        while i < arr.len() {
            if let c = arr.value[i] as Object {
                let idx = _get_int(c, "index")
                let fr = _get_str(c, "finish_reason")
                var mrole = ""
                var mcontent = ""
                var tcid = ""
                var mname = ""
                var calls = list[ToolCall]()
                if let m = _get_obj(c, "message") {
                    mrole = _get_str(m, "role")
                    mcontent = _get_str(m, "content")
                    tcid = _get_str(m, "tool_call_id")
                    mname = _get_str(m, "name")
                    calls = _parse_tool_calls(m)
                }
                choices.append(Choice(idx, CompletionMessage(mrole, mcontent, calls, tcid, mname), fr))
            }
            i += 1
        }
    }

    var pt = 0
    var ct = 0
    var tt = 0
    if let u = _get_obj(root, "usage") {
        pt = _get_int(u, "prompt_tokens")
        ct = _get_int(u, "completion_tokens")
        tt = _get_int(u, "total_tokens")
    }

    return ChatCompletion(status, rid, obj, created, mdl, choices, Usage(pt, ct, tt), "")
}

func _error_completion(status int, msg str) ChatCompletion {
    return ChatCompletion(status, "", "error", 0, "", list[Choice](), Usage(0, 0, 0), msg)
}

// `message.tool_calls`, empty when the field is absent, null or malformed.
func _parse_tool_calls(m Object) list[ToolCall] {
    let out = list[ToolCall]()
    if let arr = _get_arr(m, "tool_calls") {
        var i = 0
        while i < arr.len() {
            if let t = arr.value[i] as Object {
                let id = _get_str(t, "id")
                var kind = _get_str(t, "type")
                if kind.len() == 0 { kind = "function" }
                var fname = ""
                var fargs = ""
                if let f = _get_obj(t, "function") {
                    fname = _get_str(f, "name")
                    fargs = _get_str(f, "arguments")
                }
                out.append(ToolCall(id, kind, FunctionCall(fname, fargs)))
            }
            i += 1
        }
    }
    return out
}

func _get_str(obj Object, k str) str {
    if !(k in obj) { return "" }
    let v = obj[k]
    if v is String { return v.value }
    return ""
}

func _get_int(obj Object, k str) int {
    if !(k in obj) { return 0 }
    let v = obj[k]
    if v is Integer { return v.value }
    return 0
}

func _get_obj(obj Object, k str) Object? {
    if !(k in obj) { return nil }
    return obj[k] as Object
}

func _get_arr(obj Object, k str) Array? {
    if !(k in obj) { return nil }
    return obj[k] as Array
}

func _extract_error(body str) str {
    if body.len() == 0 { return "" }
    let val = try_parse_str(body)
    if val == nil { return "" }
    let obj = val as Object
    if obj == nil { return "" }
    if !("error" in obj) { return "" }
    let err = obj["error"]
    if !(err is Object) { return "" }
    if !("message" in err) { return "" }
    let msg = err["message"]
    if msg is String { return msg.value }
    return ""
}
