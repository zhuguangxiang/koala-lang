/// Smoke test for koala/openai against DeepSeek.
/// Skips gracefully when the API key is absent or network is unreachable.

import "std/ut"
import "std/os"
import "std/socket" as so
import "koala/openai" as openai

@test
func test_msg_helper() {
    let m = openai.msg("user", "hi")
    ut.assert_eq(m["role"], "user")
    ut.assert_eq(m["content"], "hi")
}

@test
func test_chat_basic() {
    let key = os.getenv("OPENAI_API_KEY")
    if key == nil { return }

    let client = openai.Client(key, "https://api.deepseek.com")
    let resp = client.chat.completions.create("deepseek-chat", [
        {"role": "system", "content": "Reply in one word only."},
        {"role": "user", "content": "What is 1+1?"},
    ], 0.0, 8)

    if !resp.ok() { return }

    ut.assert_true(resp.choices[0].message.content.len() > 0)
    ut.assert_true(resp.usage.prompt_tokens > 0)
    ut.assert_true(resp.usage.completion_tokens > 0)
    ut.assert_true(resp.usage.total_tokens > 0)
}

@test
func test_chat_model_field() {
    let key = os.getenv("OPENAI_API_KEY")
    if key == nil { return }

    let client = openai.Client(key, "https://api.deepseek.com")
    let resp = client.chat.completions.create("deepseek-chat", [
        openai.msg("user", "Hi"),
    ], 0.0, 4)

    if !resp.ok() { return }

    ut.assert_true(resp.model.len() > 0)
    ut.assert_true(resp.choices[0].finish_reason.len() > 0)
}

@test
func test_invalid_key_error() {
    let client = openai.Client("sk-invalid-key-for-test", "https://api.deepseek.com")
    let resp = client.chat.completions.create("deepseek-chat", [
        openai.msg("user", "test"),
    ])

    // Should not be ok with an invalid key
    ut.assert_true(!resp.ok())
    ut.assert_true(resp.error_message.len() > 0)
}

@test
func test_transport_failure() {
    // Connect to a port that is not listening
    let client = openai.Client("sk-x", "https://127.0.0.1:1")
    let resp = client.chat.completions.create("test", [openai.msg("user", "hi")])

    ut.assert_eq(resp.status_code, 0)
    ut.assert_true(!resp.ok())
    ut.assert_true(resp.error_message.len() > 0)
}

// ---- streaming (ChatStream) ----
//
// A raw TCP socket stands in for the SSE peer. `stream()` returns before
// the response head is read, so one thread can drive both ends: call
// `stream()`, then serve the canned response, then iterate.

const _SSE_HEAD = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n\r\n"

const _CHUNKS = "data: {\"id\":\"c1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hello\"},\"finish_reason\":null}]}\n\n" +
    "data: {\"id\":\"c1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\" world\"},\"finish_reason\":null}]}\n\n" +
    "data: {\"id\":\"c1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}\n\n" +
    "data: {\"id\":\"c1\",\"model\":\"m\",\"choices\":[],\"usage\":{\"prompt_tokens\":7,\"completion_tokens\":3,\"total_tokens\":10}}\n\n" +
    "data: [DONE]\n\n"

func _url(listener so.Listener) str {
    return "http://127.0.0.1:" + str(listener.local_addr().port())
}

// Accept, read the request, write `response`, close the peer side.
// Return the received request text.
func _serve(listener so.Listener, response str) str {
    let r = listener.accept()
    let server = r.conn()!
    let buf = bytes(65536)
    let n = server.read(buf)
    let req = buf[0:n].to_str()
    server.write_str(response)
    server.close()
    return req
}

@test
func test_stream_chunks() {
    let listener = so.listen("127.0.0.1:0", nil)!
    let client = openai.Client("sk-test", _url(listener))
    let stream = client.chat.completions.stream("m", [openai.msg("user", "hi")])
    _serve(listener, _SSE_HEAD + _CHUNKS)

    ut.assert_true(stream.ok())
    var text = ""
    var finish = ""
    var seen_usage = false
    var chunks = 0
    for chunk in stream {
        chunks += 1
        text += chunk.delta
        if chunk.finish_reason.len() > 0 { finish = chunk.finish_reason }
        if let u = chunk.usage {
            seen_usage = true
            ut.assert_eq(u.total_tokens, 10)
        }
    }
    ut.assert_eq(chunks, 4)
    ut.assert_eq(text, "Hello world")
    ut.assert_eq(finish, "stop")
    ut.assert_true(seen_usage)
    ut.assert_eq(stream.usage().total_tokens, 10)
    ut.assert_eq(stream.status_code(), 200)
    ut.assert_eq(stream.error_message(), "")
    stream.close()
    listener.close()
}

@test
func test_stream_request_body() {
    let listener = so.listen("127.0.0.1:0", nil)!
    let client = openai.Client("sk-test", _url(listener))
    let stream = client.chat.completions.stream("m", [openai.msg("user", "hi")], 0.5, 16)
    let req = _serve(listener, _SSE_HEAD + "data: [DONE]\n\n")

    ut.assert_true(req.starts_with("POST "))
    ut.assert_true("/chat/completions HTTP/1.1" in req)
    ut.assert_true("Authorization: Bearer sk-test\r\n" in req)
    ut.assert_true("\"stream\":true" in req)
    ut.assert_true("\"include_usage\":true" in req)
    ut.assert_true(stream.ok())
    stream.close()
    listener.close()
}

@test
func test_stream_http_error() {
    let listener = so.listen("127.0.0.1:0", nil)!
    let client = openai.Client("sk-test", _url(listener))
    let stream = client.chat.completions.stream("m", [openai.msg("user", "hi")])
    let body = "{\"error\":{\"message\":\"bad key\"}}"
    _serve(listener, "HTTP/1.1 401 Unauthorized\r\nContent-Type: application/json\r\nContent-Length: " + str(body.len()) + "\r\n\r\n" + body)

    ut.assert_true(!stream.ok())
    ut.assert_eq(stream.status_code(), 401)
    ut.assert_eq(stream.error_message(), "bad key")
    stream.close()
    listener.close()
}

@test
func test_stream_transport_failure() {
    let client = openai.Client("sk-x", "http://127.0.0.1:1")
    let stream = client.chat.completions.stream("m", [openai.msg("user", "hi")])

    ut.assert_true(!stream.ok())
    ut.assert_eq(stream.status_code(), 0)
    ut.assert_true(stream.error_message().len() > 0)
    stream.close()
}

@test
func test_stream_wrong_content_type() {
    let listener = so.listen("127.0.0.1:0", nil)!
    let client = openai.Client("sk-test", _url(listener))
    let stream = client.chat.completions.stream("m", [openai.msg("user", "hi")])
    _serve(listener, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n\r\n{}")

    ut.assert_true(!stream.ok())
    ut.assert_eq(stream.status_code(), 200)
    ut.assert_true(stream.error_message().len() > 0)
    stream.close()
    listener.close()
}

// Qwen-style chunks: "delta" and "usage" null instead of absent, as some
// proxies send them. Parsing must not fail on these.
const _QWEN_CHUNKS = "data: {\"id\":\"c1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hi\"},\"finish_reason\":null}]}\n\n" +
    "data: {\"id\":\"c1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":null,\"finish_reason\":\"stop\"}]}\n\n" +
    "data: {\"id\":\"c1\",\"model\":\"m\",\"choices\":null,\"usage\":null}\n\n" +
    "data: {\"id\":\"c1\",\"model\":\"m\",\"choices\":[],\"usage\":{\"prompt_tokens\":7,\"completion_tokens\":1,\"total_tokens\":8}}\n\n" +
    "data: [DONE]\n\n"

@test
func test_stream_null_fields() {
    let listener = so.listen("127.0.0.1:0", nil)!
    let client = openai.Client("sk-test", _url(listener))
    let stream = client.chat.completions.stream("m", [openai.msg("user", "hi")])
    _serve(listener, _SSE_HEAD + _QWEN_CHUNKS)

    ut.assert_true(stream.ok())
    var text = ""
    var finish = ""
    var chunks = 0
    for chunk in stream {
        chunks += 1
        text += chunk.delta
        if chunk.finish_reason.len() > 0 { finish = chunk.finish_reason }
    }
    ut.assert_eq(chunks, 4)
    ut.assert_eq(text, "Hi")
    ut.assert_eq(finish, "stop")
    ut.assert_eq(stream.usage().total_tokens, 8)
    stream.close()
    listener.close()
}

// A frame that is not valid JSON must be skipped, not fatal: proxies
// inject comment lines and an endpoint may truncate a chunk.
const _BROKEN_CHUNKS = "data: {\"id\":\"c1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"He\"},\"finish_reason\":null}]}\n\n" +
    "data: {\"id\":\"c1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":{\"content\n\n" +
    "data: {\"id\":\"c1\" \n\n" +
    "data: {\"id\":\"c1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"llo\"},\"finish_reason\":\"stop\"}]}\n\n" +
    "data: [DONE]\n\n"

@test
func test_stream_malformed_chunk_skipped() {
    let listener = so.listen("127.0.0.1:0", nil)!
    let client = openai.Client("sk-test", _url(listener))
    let stream = client.chat.completions.stream("m", [openai.msg("user", "hi")])
    _serve(listener, _SSE_HEAD + _BROKEN_CHUNKS)

    ut.assert_true(stream.ok())
    var text = ""
    var finish = ""
    var chunks = 0
    for chunk in stream {
        chunks += 1
        text += chunk.delta
        if chunk.finish_reason.len() > 0 { finish = chunk.finish_reason }
    }
    ut.assert_eq(chunks, 2)
    ut.assert_eq(text, "Hello")
    ut.assert_eq(finish, "stop")
    stream.close()
    listener.close()
}

// An error body of an unexpected shape (here a number where the message
// is a string) must not blow up the caller: the message falls back to the
// HTTP status.
@test
func test_stream_http_error_odd_body() {
    let listener = so.listen("127.0.0.1:0", nil)!
    let client = openai.Client("sk-test", _url(listener))
    let stream = client.chat.completions.stream("m", [openai.msg("user", "hi")])
    let body = "{\"error\": {\"message\": 42}}"
    _serve(listener, "HTTP/1.1 500 Internal Server Error\r\nContent-Type: application/json\r\nContent-Length: " + str(body.len()) + "\r\n\r\n" + body)

    ut.assert_true(!stream.ok())
    ut.assert_eq(stream.status_code(), 500)
    ut.assert_eq(stream.error_message(), "HTTP 500")
    stream.close()
    listener.close()
}

// A non-JSON error body is just as harmless.
@test
func test_stream_http_error_non_json_body() {
    let listener = so.listen("127.0.0.1:0", nil)!
    let client = openai.Client("sk-test", _url(listener))
    let stream = client.chat.completions.stream("m", [openai.msg("user", "hi")])
    let body = "<html>gateway timeout</html>"
    _serve(listener, "HTTP/1.1 504 Gateway Timeout\r\nContent-Type: text/html\r\nContent-Length: " + str(body.len()) + "\r\n\r\n" + body)

    ut.assert_true(!stream.ok())
    ut.assert_eq(stream.status_code(), 504)
    ut.assert_eq(stream.error_message(), "HTTP 504")
    stream.close()
    listener.close()
}
