// The page runtime: internal asset of koala/ui, embedded as string
// constants because wombat distributes only .klc/.so (no asset files) and
// the runtime has no module-path API. App composes them with
// webview.render_template and loads the result via set_html. Users never
// see or edit this; it is package code, like the C source inside a .so.
//
// Protocol v1 (see protocol.kl):
//   commands  mount{v,root} / set{id,prop,value} / add{parent,node}
//   events    window.__outbox entries: {"id":N,"kind":"click"[,"value":V]}
// All user text goes through textContent/value - never innerHTML.

/// The page template. {{css}} and {{js}} are filled by `App.mount`.
const RUNTIME_HTML = """<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
{{css}}
</style>
</head>
<body>
<div id="root" class="col"></div>
<script>
{{js}}
</script>
</body>
</html>
"""

/// Runtime styles: light/dark via CSS variables, flex box layout.
const RUNTIME_CSS = """
:root {
  --bg: #ffffff; --fg: #1c1e21; --accent: #2f6fed;
  --btn-bg: #2f6fed; --btn-fg: #ffffff; --border: #d0d3d9;
  --card: #f6f7f9; --muted: #6b7280;
}
body.dark {
  --bg: #16181d; --fg: #e6e8ee; --accent: #6ea8fe;
  --btn-bg: #3b6fd4; --btn-fg: #ffffff; --border: #3a3f4a;
  --card: #1f232b; --muted: #8b93a1;
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 16px; background: var(--bg); color: var(--fg);
  font-family: system-ui, sans-serif; font-size: 15px;
}
.col { display: flex; flex-direction: column; gap: 10px; align-items: stretch; }
.row { display: flex; flex-direction: row; gap: 10px; align-items: center; }
button {
  padding: 6px 16px; border: none; border-radius: 6px;
  background: var(--btn-bg); color: var(--btn-fg);
  font-size: 15px; cursor: pointer;
}
button:disabled { opacity: 0.5; cursor: default; }
input[type=text] {
  padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px;
  background: var(--bg); color: var(--fg); font-size: 15px;
}
.check { display: flex; flex-direction: row; gap: 8px; align-items: center; cursor: pointer; }
.check input { accent-color: var(--accent); width: 16px; height: 16px; }
input[type=range] { flex: 1; accent-color: var(--accent); }
"""

/// Runtime script: element registry, command application, event outbox.
const RUNTIME_JS = """
window.__outbox = [];
window.__ui_ready = false;
(function() {
  var els = new Map();
  function push(id, kind, value) {
    var e = {id: id, kind: kind};
    if (value !== undefined) { e.value = value; }
    window.__outbox.push(JSON.stringify(e));
  }
  function build(node) {
    var d;
    switch (node.type) {
      case "column":
        d = document.createElement("div"); d.className = "col"; break;
      case "row":
        d = document.createElement("div"); d.className = "row"; break;
      case "label":
        d = document.createElement("span"); d.textContent = node.text; break;
      case "button":
        d = document.createElement("button");
        d.textContent = node.text;
        d.disabled = !node.enabled;
        d.addEventListener("click", function() { push(node.id, "click"); });
        break;
      case "input":
        d = document.createElement("input");
        d.type = "text";
        d.value = node.text || "";
        d.placeholder = node.placeholder || "";
        d.addEventListener("input", function() { push(node.id, "change", d.value); });
        d.addEventListener("keydown", function(ev) {
          if (ev.key === "Enter") { push(node.id, "submit", d.value); }
        });
        break;
      case "checkbox": {
        d = document.createElement("label");
        d.className = "check";
        var box = document.createElement("input");
        box.type = "checkbox";
        box.checked = !!node.checked;
        box.addEventListener("change", function() { push(node.id, "change", box.checked); });
        var span = document.createElement("span");
        span.textContent = node.text;
        d.appendChild(box);
        d.appendChild(span);
        d.__box = box;
        d.__span = span;
        break;
      }
      case "slider":
        d = document.createElement("input");
        d.type = "range";
        d.step = "any";
        d.min = node.min;
        d.max = node.max;
        d.value = node.value;
        d.addEventListener("input", function() { push(node.id, "change", parseFloat(d.value)); });
        break;
      default:
        throw new Error("ui runtime: unknown node type " + node.type);
    }
    if (node.type === "column" || node.type === "row") {
      if (node.gap !== undefined) { d.style.gap = node.gap + "px"; }
      if (node.padding !== undefined) { d.style.padding = node.padding + "px"; }
      if (node.align !== undefined) { d.style.alignItems = node.align; }
    }
    d.id = "w" + node.id;
    els.set(node.id, d);
    if (node.children) {
      node.children.forEach(function(c) { d.appendChild(build(c)); });
    }
    return d;
  }
  function apply(c) {
    if (c.cmd === "mount") {
      if (c.v !== 1) { throw new Error("ui runtime: protocol mismatch"); }
      document.getElementById("root").appendChild(build(c.root));
    } else if (c.cmd === "set") {
      if (c.prop === "theme") {
        document.body.className = (c.value === "dark") ? "dark" : "";
        return;
      }
      var d = els.get(c.id);
      if (!d) { return; }
      if (c.prop === "text") {
        if (d.__span) { d.__span.textContent = c.value; }
        else if (d.tagName === "INPUT") { d.value = c.value; }
        else { d.textContent = c.value; }
      }
      else if (c.prop === "style") {
        var s = c.value;
        if (s.font_size !== undefined) { d.style.fontSize = s.font_size + "px"; }
        if (s.font_weight !== undefined) { d.style.fontWeight = s.font_weight; }
        if (s.color !== undefined) { d.style.color = "var(--" + s.color + ")"; }
        if (s.background !== undefined) { d.style.background = (s.background === "transparent") ? "transparent" : "var(--" + s.background + ")"; }
        if (s.border !== undefined) { d.style.border = s.border ? "1px solid var(--border)" : "none"; }
        if (s.radius !== undefined) { d.style.borderRadius = s.radius + "px"; }
        if (s.padding !== undefined) { d.style.padding = s.padding + "px"; }
        if (s.flex !== undefined) { d.style.flex = s.flex ? "1" : ""; }
        if (s.min_width !== undefined) { d.style.minWidth = s.min_width + "px"; }
        if (s.uppercase !== undefined) { d.style.textTransform = s.uppercase ? "uppercase" : "none"; }
        if (s.tabular !== undefined) { d.style.fontVariantNumeric = s.tabular ? "tabular-nums" : "normal"; }
        if (s.letter_spacing !== undefined) { d.style.letterSpacing = s.letter_spacing + "em"; }
      }
      else if (c.prop === "enabled") { d.disabled = !c.value; }
      else if (c.prop === "placeholder") { d.placeholder = c.value; }
      else if (c.prop === "checked") { d.__box.checked = !!c.value; }
      else if (c.prop === "value") { d.value = c.value; }
      else if (c.prop === "gap") { d.style.gap = c.value + "px"; }
      else if (c.prop === "padding") { d.style.padding = c.value + "px"; }
      else if (c.prop === "align") { d.style.alignItems = c.value; }
    } else if (c.cmd === "add") {
      var p = els.get(c.parent);
      if (p) { p.appendChild(build(c.node)); }
    }
  }
  window.__ui_apply = function(cmds) { cmds.forEach(apply); };
  window.__ui_ready = true;
})();
"""