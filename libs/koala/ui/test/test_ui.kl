// ==================== input command/value encoding ====================

@test
func test_encode_set_float_value() {
    let cmd = ui.encode_set(7, "value", json.Float(2.5))
    let o = json.parse_object(cmd.to_json())
    ut.assert(o.get_str("prop") == "value")
    ut.assert(o.get_float("value") == 2.5)
}

@test
func test_decode_change_bool() {
    let parsed = ui.decode_event("{\"id\":5,\"kind\":\"change\",\"value\":true}")!
    let (id, kind, value) = parsed
    ut.assert(id == 5)
    ut.assert(kind == "change")
    if let v = value {
        if let b = v as json.Boolean {
            ut.assert(b.value == true)
        } else {
            ut.assert(false)
        }
    } else {
        ut.assert(false)
    }
}

@test
func test_decode_change_float() {
    let parsed = ui.decode_event("{\"id\":7,\"kind\":\"change\",\"value\":2.5}")!
    let (id, kind, value) = parsed
    ut.assert(id == 7)
    if let v = value {
        if let f = v as json.Float {
            ut.assert(f.value == 2.5)
        } else {
            ut.assert(false)
        }
    } else {
        ut.assert(false)
    }
}

