func test_label_set_text_before_add() {
    ui.Label("x").set_text("y")
}

@should_panic("ui: widget not added to an app")
func test_button_set_text_before_add() {
    ui.Button("x").set_text("y")
}

@should_panic("ui: widget not added to an app")
func test_button_set_enabled_before_add() {
    ui.Button("x").set_enabled(false)
