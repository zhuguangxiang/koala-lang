@test
func test_text_style_default_payload() {
    let o = json.parse_object(ui.TextStyle().to_json().to_json())
    ut.assert(o.get_int("font_size") == 15)
    ut.assert(o.get_int("font_weight") == 400)
    ut.assert(o.get_str("color") == "fg")
    ut.assert(o.get_bool("uppercase") == false)
    ut.assert(o.get_bool("tabular") == false)
    ut.assert(o.get_float("letter_spacing") == 0.0)
}

@test
func test_text_style_custom_payload() {
    let s = ui.TextStyle(40, 600, "muted", true, true, 0.04)
    let o = json.parse_object(s.to_json().to_json())
    ut.assert(o.get_int("font_size") == 40)
    ut.assert(o.get_int("font_weight") == 600)
    ut.assert(o.get_str("color") == "muted")
    ut.assert(o.get_bool("uppercase") == true)
    ut.assert(o.get_bool("tabular") == true)
    ut.assert(o.get_float("letter_spacing") == 0.04)
}

