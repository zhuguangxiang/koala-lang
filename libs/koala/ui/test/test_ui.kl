import "std/ut"
import "std/time"
import "koala/json"
import "koala/ui"

// Headless tests: widget serialization, the wire protocol and event
// dispatch run without a window. App lifecycle (mount/pump/close) needs a
// graphical session and is covered by the live probe/demo, not here.

// ==================== widget serialization ====================

@test
func test_label_to_json() {
    let l = ui.Label("hello")
    let o = json.parse_object(l.to_json().to_json())
    ut.assert(o.get_int("id") == 0)
    ut.assert(o.get_str("type") == "label")
    ut.assert(o.get_str("text") == "hello")
}

@test
func test_button_to_json() {
    let b = ui.Button("+1")
    let o = json.parse_object(b.to_json().to_json())
    ut.assert(o.get_str("type") == "button")
    ut.assert(o.get_str("text") == "+1")
    ut.assert(o.get_bool("enabled") == true)
}

@test
func test_button_disabled_to_json() {
    let b = ui.Button("x")
    b.enabled = false
    let o = json.parse_object(b.to_json().to_json())
    ut.assert(o.get_bool("enabled") == false)
}

@test
func test_widget_id_before_add() {
    ut.assert(ui.Label("x").wid() == 0)
    ut.assert(ui.Button("x").wid() == 0)
}

