// ==================== layout containers (U3) ====================

@test
func test_row_to_json() {
    let r = ui.Row(ui.Label("a"), ui.Label("b"))
    let o = json.parse_object(r.to_json().to_json())
    ut.assert(o.get_str("type") == "row")
    ut.assert(o.get_int("gap") == 10)
    ut.assert(o.get_int("padding") == 0)
    ut.assert(o.get_str("align") == "center")
    let kids = o.get_array("children")
    ut.assert(kids.len() == 2)
    ut.assert(kids.get_object(0).get_str("type") == "label")
    ut.assert(kids.get_object(0).get_str("text") == "a")
    ut.assert(kids.get_object(1).get_str("text") == "b")
}

@test
func test_column_to_json() {
    let c = ui.Column()
    let o = json.parse_object(c.to_json().to_json())
    ut.assert(o.get_str("type") == "column")
    ut.assert(o.get_str("align") == "stretch")
    ut.assert(o.get_array("children").len() == 0)
}

@test
func test_nested_container_to_json() {
    let r = ui.Row(ui.Column(ui.Label("x")))
    let o = json.parse_object(r.to_json().to_json())
    let inner = o.get_array("children").get_object(0)
    ut.assert(inner.get_str("type") == "column")
    let leaf = inner.get_array("children").get_object(0)
    ut.assert(leaf.get_str("type") == "label")
    ut.assert(leaf.get_str("text") == "x")
}

@test
func test_container_children_field() {
    let r = ui.Row(ui.Label("a"), ui.Button("b"))
    ut.assert(r.children.len() == 2)
}

@test
func test_container_id_before_add() {
    ut.assert(ui.Row().wid() == 0)
    ut.assert(ui.Column().wid() == 0)
}

@test
func test_container_layout_defaults() {
    let r = ui.Row()
    ut.assert(r.gap == 10)
    ut.assert(r.padding == 0)
    ut.assert(r.align == ui.ALIGN_CENTER)
    let c = ui.Column()
    ut.assert(c.align == ui.ALIGN_STRETCH)
}

