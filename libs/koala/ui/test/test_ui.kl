// ==================== timers ====================

// Timers are driven by pump_timers (module-level, like dispatch), so they are
// testable headless with a synthetic instant instead of a real window. The
// App.every factory and the cancel-removes-from-list path need a window and
// are covered by the live probe.

var tm_calls = 0
var tm_kind = ""
var tm_widget_nil = false
var tm_value_nil = false
var tm_state any? = nil
var tm_other = 0
var tm_target ui.Timer? = nil
var tm_base = time.monotonic()
var tm_list = list[ui.Timer]()

func tm_record(e ui.Event) {
    tm_calls = tm_calls + 1
    tm_kind = e.kind
    tm_widget_nil = (e.widget == nil)
    tm_value_nil = (e.value == nil)
    tm_state = e.state
}

func tm_other_fn(e ui.Event) {
    tm_other = tm_other + 1
}

func tm_cancel_target(e ui.Event) {
    tm_calls = tm_calls + 1
    if let t = tm_target {
        t.cancel()
    }
}

func tm_add_another(e ui.Event) {
    tm_calls = tm_calls + 1
    tm_list.append(make_timer(tm_base, 100, tm_other_fn))
}

// A timer with a controlled deadline `base + ms` (app nil: no window needed).
func make_timer(base time.Instant, ms int, fn func(ui.Event)) ui.Timer {
    let t = ui.Timer(nil, time.Duration.from_millis(ms), fn)
    t.next = base + time.Duration.from_millis(ms)
    return t
}

func tm_reset() {
    tm_calls = 0
    tm_other = 0
    tm_kind = ""
    tm_widget_nil = false
    tm_value_nil = false
    tm_state = nil
    tm_target = nil
}

@test
func test_timer_not_due_yet() {
    tm_reset()
    let base = time.monotonic()
    let timers = list[ui.Timer]()
    timers.append(make_timer(base, 100, tm_record))
    ui.pump_timers(timers, base + time.Duration.from_millis(99), nil, nil)
    ut.assert(tm_calls == 0)
}

@test
func test_timer_fires_when_due() {
    tm_reset()
    let base = time.monotonic()
    let timers = list[ui.Timer]()
    timers.append(make_timer(base, 100, tm_record))
    ui.pump_timers(timers, base + time.Duration.from_millis(100), nil, nil)
    ut.assert(tm_calls == 1)
    ut.assert(tm_kind == "timer")
    ut.assert(tm_widget_nil)
    ut.assert(tm_value_nil)
}

@test
func test_timer_reschedules() {
    tm_reset()
    let base = time.monotonic()
    let t = make_timer(base, 100, tm_record)
    let timers = list[ui.Timer]()
    timers.append(t)
    ui.pump_timers(timers, base + time.Duration.from_millis(100), nil, nil)
    ut.assert(tm_calls == 1)
    ut.assert(t.next == base + time.Duration.from_millis(200))
    ui.pump_timers(timers, base + time.Duration.from_millis(200), nil, nil)
    ut.assert(tm_calls == 2)
}

@test
func test_timer_mixed_due_and_not_due() {
    tm_reset()
    let base = time.monotonic()
    let timers = list[ui.Timer]()
    timers.append(make_timer(base, 100, tm_record))
    timers.append(make_timer(base, 500, tm_other_fn))
    ui.pump_timers(timers, base + time.Duration.from_millis(100), nil, nil)
    ut.assert(tm_calls == 1)
    ut.assert(tm_other == 0)
}

@test
func test_timer_cancel_stops_firing() {
    tm_reset()
    let base = time.monotonic()
    let t = make_timer(base, 100, tm_record)
    let timers = list[ui.Timer]()
    timers.append(t)
    t.cancel()
    ut.assert(t.cancelled)
    ui.pump_timers(timers, base + time.Duration.from_millis(100), nil, nil)
    ut.assert(tm_calls == 0)
}

@test
func test_timer_cancel_idempotent() {
    let base = time.monotonic()
    let t = make_timer(base, 100, tm_record)
    t.cancel()
    t.cancel() // must not panic
    ut.assert(t.cancelled)
}

@test
func test_timer_cancelled_skipped_in_list() {
    tm_reset()
    let base = time.monotonic()
    let t = make_timer(base, 100, tm_record)
    t.cancelled = true // still in the list, but flagged
    let timers = list[ui.Timer]()
    timers.append(t)
    ui.pump_timers(timers, base + time.Duration.from_millis(100), nil, nil)
    ut.assert(tm_calls == 0)
}

@test
func test_timer_cancel_during_pump() {
    tm_reset()
    let base = time.monotonic()
    let t1 = make_timer(base, 100, tm_cancel_target)
    let t2 = make_timer(base, 100, tm_other_fn)
    tm_target = t2
    let timers = list[ui.Timer]()
    timers.append(t1)
    timers.append(t2)
    ui.pump_timers(timers, base + time.Duration.from_millis(100), nil, nil)
    ut.assert(tm_calls == 1) // t1 fired
    ut.assert(tm_other == 0) // t2 cancelled by t1 before it fired
    ut.assert(t2.cancelled)
}

@test
func test_timer_add_during_pump_uses_snapshot() {
    tm_reset()
    let base = time.monotonic()
    tm_base = base
    tm_list = list[ui.Timer]()
    tm_list.append(make_timer(base, 100, tm_add_another))
    // t1 fires and appends a due t2; the snapshot must not fire t2 this pass.
    ui.pump_timers(tm_list, base + time.Duration.from_millis(100), nil, nil)
    ut.assert(tm_calls == 1)
    ut.assert(tm_other == 0)
    ut.assert(tm_list.len() == 2)
    // next pass: t1 rescheduled (not due), t2 now fires.
    ui.pump_timers(tm_list, base + time.Duration.from_millis(100), nil, nil)
    ut.assert(tm_other == 1)
}

@test
func test_timer_state_passthrough() {
    tm_reset()
    let base = time.monotonic()
    let timers = list[ui.Timer]()
    timers.append(make_timer(base, 100, tm_record))
    ui.pump_timers(timers, base + time.Duration.from_millis(100), nil, "timerstate")
    ut.assert(tm_calls == 1)
    var state_ok = false
    if let v = tm_state {
        if let s = v as str {
            state_ok = s == "timerstate"
        }
    }
    ut.assert(state_ok)
}

@test
func test_timer_empty_list_noop() {
    tm_reset()
    let timers = list[ui.Timer]()
    ui.pump_timers(timers, time.monotonic(), nil, nil)
    ut.assert(tm_calls == 0)
}

