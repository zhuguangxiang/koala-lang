import "koala/json"

/// The common interface of all widgets. Classes are final in Koala, so
/// widgets are independent classes conforming to this trait; the shared
/// machinery (ids, command queue, dispatch) lives in `App`.
pub trait Widget {
    /// The app-assigned widget id (0 before `App.add`).
    func wid() int

    /// The mount-tree node for this widget.
    func to_json() json.Value

    /// Called by `App.add` to bind the widget to its app and id.
    func attach(app App, id int)

    /// Deliver one event; each widget acts on the kinds it owns.
    func handle(e Event)
}

// Shared setter path: queue an incremental command, or panic when the
// widget has not been added to an app yet.
func set_prop(app App?, id int, prop str, value json.Value) {
    if app == nil {
        panic("ui: widget not added to an app")
    }
    app.queue_set(id, prop, value)
}