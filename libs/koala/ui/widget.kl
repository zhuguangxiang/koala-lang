import "koala/json"

/// The common interface of all widgets. Classes are final in Koala, so
/// widgets are independent classes conforming to this trait; the shared
/// machinery (ids, command queue, dispatch) lives in `App`.
pub trait Widget {
    /// The app-assigned widget id (0 before `App.add`).
    func wid() int

    /// The mount-tree node for this widget.
    func to_json() json.Value

    /// Internal: called by `App.add` to bind the widget to its app and id.
    func _attach(app App, id int)

    /// Internal: deliver one event; each widget acts on the kinds it owns.
    func _handle(e Event)
}

// Shared setter path: queue an incremental command, or panic when the
// widget has not been added to an app yet.
func _set_prop(app App?, id int, prop str, value json.Value) {
    if app == nil {
        panic("ui: widget not added to an app")
    }
    app._queue_set(id, prop, value)
}

/// A static text label.
pub class Label : Widget {
    pub var _text str
    pub var _app App? = nil
    pub var _id int = 0

    pub func __init__(text str) {
        _text = text
    }

    pub func wid() int = _id

    /// Replace the label text. Takes effect on the next pump iteration.
    pub func set_text(text str) {
        _text = text
        _set_prop(_app, _id, "text", json.String(text))
    }

    pub func to_json() json.Value {
        let o = json.Object()
        o["id"] = json.Integer(_id)
        o["type"] = json.String("label")
        o["text"] = json.String(_text)
        return o
    }

    pub func _attach(app App, id int) {
        _app = app
        _id = id
    }

    pub func _handle(e Event) {}
}

/// A push button. `on_click` is a named handler function; it can also be
/// bound or rebound later with the `on_click(fn)` method.
pub class Button : Widget {
    pub var _text str
    pub var _enabled bool = true
    pub var _app App? = nil
    pub var _id int = 0
    pub var _handler Handler? = nil

    pub func __init__(text str, on_click Handler? = nil) {
        _text = text
        _handler = on_click
    }

    pub func wid() int = _id

    /// Replace the button text.
    pub func set_text(text str) {
        _text = text
        _set_prop(_app, _id, "text", json.String(text))
    }

    /// Enable or disable the button.
    pub func set_enabled(enabled bool) {
        _enabled = enabled
        _set_prop(_app, _id, "enabled", json.Boolean(enabled))
    }

    /// Bind or rebind the click handler.
    pub func on_click(fn Handler) {
        _handler = fn
    }

    pub func to_json() json.Value {
        let o = json.Object()
        o["id"] = json.Integer(_id)
        o["type"] = json.String("button")
        o["text"] = json.String(_text)
        o["enabled"] = json.Boolean(_enabled)
        return o
    }

    pub func _attach(app App, id int) {
        _app = app
        _id = id
    }

    pub func _handle(e Event) {
        if e.kind == "click" {
            if let h = _handler {
                h(e)
            }
        }
    }
}