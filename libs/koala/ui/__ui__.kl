/// Pure-Koala desktop UI: widgets, layout, events and themes - no HTML,
/// JavaScript or CSS required.
///
/// `koala/ui` renders through the system webview (the `koala/webview`
/// package). The page runtime is an internal asset of this package; app
/// code only touches Koala objects:
///
///     import "koala/ui"
///
///     var count = 0
///     var counter = ui.Label("0")
///
///     func on_inc(e ui.Event) {
///         count = count + 1
///         counter.set_text(format("{}", count))
///     }
///
///     func main() {
///         let app = ui.App("Counter", 400, 200)
///         app.add(counter)
///         app.add(ui.Button("+1", on_inc))
///         app.run()
///     }
///
/// Event handlers are named functions of type `Handler = func(Event)`:
/// Koala lambdas cannot capture local variables yet, so keep state in
/// module-level variables or pass a state object to `App(state = ...)`
/// and read it back as `e.state`.
///
/// Platform support follows `koala/webview`: Linux (GTK) is implemented;
/// the Windows (WebView2) and macOS (WKWebView) backends panic until
/// their webview branches are implemented.

/// Light theme (the default).
pub const THEME_LIGHT = "light"

/// Dark theme.
pub const THEME_DARK = "dark"