import "koala/json"

/// A labelled checkbox. `on_change` fires on every toggle and carries the
/// new checked state (`e.value_bool()`).
pub class CheckBox : Widget {
    pub var text str
    pub var checked bool
    pub var app App? = nil
    pub var id int = 0
    pub var change_handler Handler? = nil

    pub func __init__(text str, checked bool = false,
                      on_change Handler? = nil) {
        self.text = text
        self.checked = checked
        change_handler = on_change
    }

    pub func wid() int = id

    /// Check or uncheck the box.
    pub func set_checked(checked bool) {
        self.checked = checked
        set_prop(app, id, "checked", json.Boolean(checked))
    }

    /// Replace the label text.
    pub func set_text(text str) {
        self.text = text
        set_prop(app, id, "text", json.String(text))
    }

    /// Bind or rebind the toggle handler.
    pub func on_change(fn Handler) {
        change_handler = fn
    }

    pub func to_json() json.Value {
        let o = json.Object()
        o["id"] = json.Integer(id)
        o["type"] = json.String("checkbox")
        o["text"] = json.String(text)
        o["checked"] = json.Boolean(checked)
        return o
    }

    pub func attach(app App, id int) {
        self.app = app
        self.id = id
    }

    pub func handle(e Event) {
        if e.kind == "change" {
            if let v = e.value {
                if let b = v as json.Boolean {
                    checked = b.value
                }
            }
            if let h = change_handler {
                h(e)
            }
        }
    }
}