import "koala/json"

/// A horizontal slider over `[min, max]`. `on_change` fires while dragging
/// and carries the current value (`e.value_float()`). `value` is required:
/// Koala defaults must be literals, so `value = min` cannot be expressed.
pub class Slider : Widget {
    pub var min float
    pub var max float
    pub var value float
    pub var app App? = nil
    pub var id int = 0
    pub var change_handler Handler? = nil

    pub func __init__(min float, max float, value float,
                      on_change Handler? = nil) {
        self.min = min
        self.max = max
        self.value = value
        change_handler = on_change
    }

    pub func wid() int = id

    /// Move the slider to `value`.
    pub func set_value(value float) {
        self.value = value
        set_prop(app, id, "value", json.Float(value))
    }

    /// Bind or rebind the drag handler.
    pub func on_change(fn Handler) {
        change_handler = fn
    }

    pub func to_json() json.Value {
        let o = json.Object()
        o["id"] = json.Integer(id)
        o["type"] = json.String("slider")
        o["min"] = json.Float(min)
        o["max"] = json.Float(max)
        o["value"] = json.Float(value)
        return o
    }

    pub func attach(app App, id int) {
        self.app = app
        self.id = id
    }

    pub func handle(e Event) {
        if e.kind == "change" {
            if let v = e.value {
                if let f = v as json.Float {
                    value = f.value
                } else if let i = v as json.Integer {
                    value = float(i.value)
                }
            }
            if let h = change_handler {
                h(e)
            }
        }
    }
}