import "koala/webview"
import "koala/json"
import "std/time"

/// A desktop app window driven entirely from Koala. Build the widget tree
/// with `add`, then `run()` (blocking) or drive `poll()` yourself. The pump
/// loop drains page events, dispatches handlers and batches widget updates
/// back to the page; no HTML/JS/CSS is involved at this level.
pub class App {
    var win webview.Window
    var widgets = dict[int, Widget]()
    var pending = list[json.Object]()
    var root = list[Widget]()
    var timers = list[Timer]()
    var styles = dict[int, json.Value]()
    var next_id int = 1
    var running bool = false
    var closed bool = false

    /// User state object handed to every handler as `e.state`.
    pub var state any? = nil

    /// Create the window. `state` is an optional user object delivered to
    /// handlers as `e.state` (Koala lambdas cannot capture locals yet).
    /// Panics if the window cannot be created (e.g. no display).
    pub func __init__(title str, width int = 900, height int = 640,
                      state any? = nil) {
        win = webview.Window()
        win.set_title(title)
        win.set_size(width, height)
        self.state = state
    }

    /// Add a widget to the root layout. Assigns its id and registers it
    /// (for a container, its whole subtree). Before `run` the widget joins
    /// the initial mount tree; after `run` it is appended live. Panics if
    /// already added.
    pub func add(w Widget) Widget {
        register(w)
        if running {
            queue_add(0, w.to_json())
        } else {
            root.append(w)
        }
        return w
    }

    /// Set the theme: `ui.THEME_LIGHT` (default) or `ui.THEME_DARK`.
    /// Panics on any other value.
    pub func set_theme(name str) {
        if name != THEME_LIGHT && name != THEME_DARK {
            panic("ui: unknown theme '" + name + "'")
        }
        queue_set(0, "theme", json.String(name))
    }

    /// Start a periodic timer firing `fn` every `ms` milliseconds, driven by
    /// the pump loop (no page involvement). The handler gets a `"timer"` Event
    /// with `widget` nil. Returns a [`Timer`](#timer) whose `cancel()` stops it.
    pub func every(ms int, fn Handler) Timer {
        let t = Timer(self, time.Duration.from_millis(ms), fn)
        timers.append(t)
        return t
    }

    /// Apply a reusable [`Style`](#style) to a widget. Styles are decoupled
    /// from widget classes: any widget accepts any Style. The widget must
    /// already be added (id assigned). Before `run` the style is stored and
    /// applied at mount; after `run` it is queued immediately. Panics if the
    /// widget is not added to an app.
    pub func set_style(w Widget, s Style) {
        let id = w.wid()
        if id == 0 {
            panic("ui: widget not added to an app")
        }
        let payload = s.to_json()
        styles[id] = payload
        if running {
            queue_set(id, "style", payload)
        }
    }

    /// Enter the pump loop; blocks until the window is closed or `close()`
    /// is called.
    pub func run() {
        while poll() {}
    }

    /// Step the app once: mount on first call, then pump window events,
    /// dispatch page events to handlers and flush queued widget updates.
    /// Returns false once the window is closed.
    pub func poll() bool {
        if closed {
            return false
        }
        if !running {
            mount()
        }
        if !win.poll() {
            closed = true
            win.destroy()
            return false
        }
        let raw = win.eval_sync("window.__outbox.splice(0).join('\\n')")
        for line in raw.split("\n") {
            dispatch(widgets, self, state, line)
        }
        pump_timers(timers, time.monotonic(), self, state)
        flush()
        time.sleep(time.Duration(10000000)) // 10ms, avoid busy-spinning
        return true
    }

    /// Close the window and release it. Idempotent; `run`/`poll` return
    /// afterwards.
    pub func close() {
        if !closed {
            closed = true
            win.terminate()
            win.destroy()
        }
    }

    /// Evaluate JS in the page and return its result as a string. Escape
    /// hatch for live tests and advanced page interaction; the widget API
    /// covers normal use. Requires a mounted page (call `poll` first).
    pub func eval_sync(js str) str {
        return win.eval_sync(js)
    }

    /// Set the window title (pass-through to the webview window).
    pub func set_title(title str) {
        win.set_title(title)
    }

    /// Set the window size in pixels (pass-through to the webview window).
    pub func set_size(width int, height int) {
        win.set_size(width, height)
    }

    /// Enter or leave fullscreen (pass-through to the webview window).
    /// Panics if the window is closed.
    pub func set_fullscreen(on bool) {
        win.set_fullscreen(on)
    }

    /// The current window size in pixels as `(width, height)` (pass-through
    /// to the webview window). Panics if the window is closed.
    pub func get_size() (int, int) {
        return win.get_size()
    }

    /// Queue an incremental property command from a widget setter.
    func queue_set(id int, prop str, value json.Value) {
        pending.append(encode_set(id, prop, value))
    }

    /// Queue a live append of `node` under `parent` (0 = root).
    func queue_add(parent int, node json.Value) {
        pending.append(encode_add(parent, node))
    }

    // Assign a fresh id, bind the widget to this app and register it so its
    // events dispatch. Containers call this from `attach` for each child,
    // which registers the whole subtree. Panics if the widget is already
    // added to an app.
    func register(w Widget) int {
        if w.wid() != 0 {
            panic("ui: widget already added")
        }
        let id = next_id
        next_id = id + 1
        w.attach(self, id)
        widgets[id] = w
        return id
    }

    // Load the embedded runtime, wait until its script is ready, then
    // mount the initial widget tree. Page load is asynchronous, hence the
    // readiness pump (same pattern as the webview demo).
    func mount() {
        let root_node = json.Object()
        root_node["id"] = json.Integer(0)
        root_node["type"] = json.String("column")
        let children = json.Array()
        for w in root {
            children.append(w.to_json())
        }
        root_node["children"] = children

        let vars dict[str, any] = {"css": RUNTIME_CSS, "js": RUNTIME_JS}
        win.set_html(webview.render_template(RUNTIME_HTML, vars))
        win.poll()
        var waited = 0
        while win.eval_sync("window.__ui_ready === true") != "true" {
            win.poll()
            time.sleep(time.Duration(10000000))
            waited = waited + 10
            if waited > 5000 {
                panic("ui: runtime not ready (timeout)")
            }
        }
        let cmd = encode_mount(root_node)
        win.eval("window.__ui_apply([" + cmd.to_json() + "])")
        running = true
        for id in styles.keys() {
            queue_set(id, "style", styles[id])
        }
    }

    // Send all queued commands to the page in one eval.
    func flush() {
        if pending.empty() {
            return
        }
        let arr = json.Array()
        for c in pending {
            arr.append(c)
        }
        pending.clear()
        win.eval("window.__ui_apply(" + arr.to_json() + ")")
    }
}

// Dispatch one outbox line. Module-level (not a method) so the headless
// tests can drive it without a window. Unknown widget ids are dropped:
// they are stale page events, not an error. Unbound handlers are a no-op,
// like a tkinter button without command. Each widget handles the event
// kinds it owns via Widget.handle (function types cannot be generic type
// arguments, so handlers live on the widgets, not in a registry dict).
pub func dispatch(widgets dict[int, Widget], app App?, state any?, line str) {
    let parsed = decode_event(line) else { return }
    let (id, kind, value) = parsed
    let w = widgets.get(id) else { return }
    w.handle(Event(kind, w, app, state, value))
}