import "std/time"

/// A periodic timer created by [`App.every`](#app). It is driven by the app's
/// pump loop, not the page: each `poll` fires the handler once the interval
/// has elapsed, then reschedules. The handler receives a `"timer"` Event whose
/// `widget` is nil. `cancel()` stops it permanently (idempotent).
///
/// Normally obtained from `app.every(ms, fn)`; the constructor is public so
/// headless tests can build timers and drive `pump_timers` with a synthetic
/// instant.
pub class Timer {
    pub var app App?
    pub var interval time.Duration
    pub var next time.Instant
    pub var handler Handler
    pub var cancelled bool = false

    pub func __init__(app App?, interval time.Duration, handler Handler) {
        self.app = app
        self.interval = interval
        self.handler = handler
        next = time.monotonic() + interval
    }

    /// Stop the timer; the handler will not fire again. Idempotent.
    pub func cancel() {
        if cancelled {
            return
        }
        cancelled = true
        if let a = app {
            a.timers.remove(self)
        }
    }
}

/// Fire every timer whose deadline has passed at `now`, rescheduling each by
/// its interval. Module-level (like `dispatch`) so headless tests can drive it
/// with a synthetic instant instead of a real window. A handler may add or
/// cancel timers, so collect the due timers first and iterate that snapshot;
/// re-check `cancelled` before firing in case an earlier handler cancelled a
/// later one. Timer events carry kind `"timer"`, widget nil, value nil.
pub func pump_timers(timers list[Timer], now time.Instant, app App?, state any?) {
    let due = list[Timer]()
    for t in timers {
        if !t.cancelled && now >= t.next {
            due.append(t)
        }
    }
    for t in due {
        if t.cancelled {
            continue
        }
        t.next = now + t.interval
        t.handler(Event("timer", nil, app, state, nil))
    }
}