import "koala/json"

/// A reusable appearance description, decoupled from any widget. Apply one
/// with `App.set_style(w, style)`; widget classes never reference it, so new
/// styles need no widget changes. A Style serializes to a structured payload
/// (typography/box properties plus palette color roles) that the page runtime
/// maps to inline styles. Users pick a preset or compose a general style;
/// no CSS text is exposed and colors follow the active theme.
pub trait Style {
    /// The appearance payload applied to a widget's element.
    func to_json() json.Value
}

// Validate a palette color role. Colors and backgrounds reference theme
// variables (var(--role)) rather than raw CSS, so styles track the theme.
func check_role(name str) {
    if name != "fg" && name != "muted" && name != "accent" &&
       name != "bg" && name != "card" && name != "border" &&
       name != "btn-bg" && name != "btn-fg" && name != "transparent" {
        panic("ui: unknown color role '" + name + "'")
    }
}

/// General text style: font size/weight, a palette color role and
/// typographic flags. Compose freely, or use a preset such as `DisplayText`.
pub class TextStyle : Style {
    pub var size int
    pub var weight int
    pub var color str
    pub var uppercase bool
    pub var tabular bool
    pub var letter_spacing float

    pub func __init__(size int = 15, weight int = 400, color str = "fg",
                      uppercase bool = false, tabular bool = false,
                      letter_spacing float = 0.0) {
        check_role(color)
        self.size = size
        self.weight = weight
        self.color = color
        self.uppercase = uppercase
        self.tabular = tabular
        self.letter_spacing = letter_spacing
    }

    pub func to_json() json.Value {
        let o = json.Object()
        o["font_size"] = json.Integer(size)
        o["font_weight"] = json.Integer(weight)
        o["color"] = json.String(color)
        o["uppercase"] = json.Boolean(uppercase)
        o["tabular"] = json.Boolean(tabular)
        o["letter_spacing"] = json.Float(letter_spacing)
        return o
    }
}

/// General box style: surface background, border, corner radius, padding
/// and flex growth. Apply to a container (e.g. `Column`) to make a card.
pub class BoxStyle : Style {
    pub var background str
    pub var border bool
    pub var radius int
    pub var padding int
    pub var flex bool
    pub var min_width int

    pub func __init__(background str = "card", border bool = true,
                      radius int = 12, padding int = 22, flex bool = true,
                      min_width int = 220) {
        check_role(background)
        self.background = background
        self.border = border
        self.radius = radius
        self.padding = padding
        self.flex = flex
        self.min_width = min_width
    }

    pub func to_json() json.Value {
        let o = json.Object()
        o["background"] = json.String(background)
        o["border"] = json.Boolean(border)
        o["radius"] = json.Integer(radius)
        o["padding"] = json.Integer(padding)
        o["flex"] = json.Boolean(flex)
        o["min_width"] = json.Integer(min_width)
        return o
    }
}

/// General button style: background/color roles, border and corner radius.
/// The default is the filled primary look; `GhostButton` is the outline preset.
pub class ButtonStyle : Style {
    pub var background str
    pub var color str
    pub var border bool
    pub var radius int

    pub func __init__(background str = "btn-bg", color str = "btn-fg",
                      border bool = false, radius int = 6) {
        check_role(background)
        check_role(color)
        self.background = background
        self.color = color
        self.border = border
        self.radius = radius
    }

    pub func to_json() json.Value {
        let o = json.Object()
        o["background"] = json.String(background)
        o["color"] = json.String(color)
        o["border"] = json.Boolean(border)
        o["radius"] = json.Integer(radius)
        return o
    }
}

/// Large display numerals/text (a clock or counter readout).
pub class DisplayText : Style {
    let inner = TextStyle(40, 600, "fg", false, true)
    pub func __init__() {}
    pub func to_json() json.Value = inner.to_json()
}

/// Small uppercase muted section heading (a card title).
pub class HeadingText : Style {
    let inner = TextStyle(13, 500, "muted", true, false, 0.04)
    pub func __init__() {}
    pub func to_json() json.Value = inner.to_json()
}

/// Prominent title text (an app header).
pub class TitleText : Style {
    let inner = TextStyle(18, 600)
    pub func __init__() {}
    pub func to_json() json.Value = inner.to_json()
}

/// Outlined secondary button: transparent background with a border.
pub class GhostButton : Style {
    let inner = ButtonStyle("transparent", "fg", true)
    pub func __init__() {}
    pub func to_json() json.Value = inner.to_json()
}

/// Card surface with a filled background (the default card look).
pub class ElevatedCard : Style {
    let inner = BoxStyle("card", true, 12, 22, true, 220)
    pub func __init__() {}
    pub func to_json() json.Value = inner.to_json()
}

/// Card surface with a transparent background and a border only.
pub class OutlinedCard : Style {
    let inner = BoxStyle("transparent", true, 12, 22, true, 220)
    pub func __init__() {}
    pub func to_json() json.Value = inner.to_json()
}