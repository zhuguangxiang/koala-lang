import "koala/json"

/// A static text label.
pub class Label : Widget {
    pub var text str
    pub var app App? = nil
    pub var id int = 0

    pub func __init__(text str) {
        self.text = text
    }

    pub func wid() int = id

    /// Replace the label text. Takes effect on the next pump iteration.
    pub func set_text(text str) {
        self.text = text
        set_prop(app, id, "text", json.String(text))
    }

    pub func to_json() json.Value {
        let o = json.Object()
        o["id"] = json.Integer(id)
        o["type"] = json.String("label")
        o["text"] = json.String(text)
        return o
    }

    pub func attach(app App, id int) {
        self.app = app
        self.id = id
    }

    pub func handle(e Event) {}
}