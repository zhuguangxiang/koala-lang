import "koala/klex"

/// A builtin type keyword used as a type: `int`, `str`, `bool`, `any`,
/// `type`, `range`, and the fixed-width numeric types.
pub class AtomType : TypeNode {
    pub let name SyntaxToken

    pub func __init__(name SyntaxToken) {
        self.name = name
    }

    pub func kind() NodeKind = NodeKind.ATOM_TYPE
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.name)
        return out
    }
}

/// `[T1, T2, ...]`: the bracketed argument list of a parameterized type.
pub class TypeArgList : Node {
    pub let lbracket SyntaxToken
    pub let items list[TypeNode]
    pub let seps list[SyntaxToken]
    pub let rbracket SyntaxToken

    pub func __init__(lbracket SyntaxToken, items list[TypeNode], seps list[SyntaxToken], rbracket SyntaxToken) {
        self.lbracket = lbracket
        self.items = items
        self.seps = seps
        self.rbracket = rbracket
    }

    pub func kind() NodeKind = NodeKind.TYPE_ARGS
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.lbracket)
        var i = 0
        while i < self.items.len() {
            out.append(self.items[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        out.append(self.rbracket)
        return out
    }
}

/// A user-defined type name: `Foo`, `pkg.Foo`, `Foo[int]`, `pkg.Foo[int]`.
pub class NamedType : TypeNode {
    pub let prefix SyntaxToken?
    pub let dot SyntaxToken?
    pub let name SyntaxToken
    pub let args TypeArgList?

    pub func __init__(prefix SyntaxToken?, dot SyntaxToken?, name SyntaxToken, args TypeArgList?) {
        self.prefix = prefix
        self.dot = dot
        self.name = name
        self.args = args
    }

    pub func kind() NodeKind = NodeKind.NAMED_TYPE
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        add_opt(out, self.prefix)
        add_opt(out, self.dot)
        out.append(self.name)
        add_opt(out, self.args)
        return out
    }
}

/// `T?`: an optional type.
pub class OptionalType : TypeNode {
    pub let inner TypeNode
    pub let question SyntaxToken

    pub func __init__(inner TypeNode, question SyntaxToken) {
        self.inner = inner
        self.question = question
    }

    pub func kind() NodeKind = NodeKind.OPTIONAL_TYPE
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.inner)
        out.append(self.question)
        return out
    }
}

/// `A | B | C`: a union type. `seps` holds the `|` tokens.
pub class UnionType : TypeNode {
    pub let items list[TypeNode]
    pub let seps list[SyntaxToken]

    pub func __init__(items list[TypeNode], seps list[SyntaxToken]) {
        self.items = items
        self.seps = seps
    }

    pub func kind() NodeKind = NodeKind.UNION_TYPE
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        var i = 0
        while i < self.items.len() {
            out.append(self.items[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        return out
    }
}

/// `func(A, B) R`. The lexer spells `func(` as one token, held in `kw`.
pub class FuncType : TypeNode {
    pub let kw SyntaxToken
    pub let params list[TypeNode]
    pub let seps list[SyntaxToken]
    pub let rparen SyntaxToken
    pub let ret TypeNode?

    pub func __init__(kw SyntaxToken, params list[TypeNode], seps list[SyntaxToken], rparen SyntaxToken, ret TypeNode?) {
        self.kw = kw
        self.params = params
        self.seps = seps
        self.rparen = rparen
        self.ret = ret
    }

    pub func kind() NodeKind = NodeKind.FUNC_TYPE
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        var i = 0
        while i < self.params.len() {
            out.append(self.params[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        out.append(self.rparen)
        add_opt(out, self.ret)
        return out
    }
}
/// A builtin container type applied to arguments: `list[T]`, `map[K, V]`,
/// `set[T]`, `tuple[A, B]`.
///
/// All four have the same shape, so they share one class; `kind()` tells
/// them apart (`LIST_TYPE`, `MAP_TYPE`, `SET_TYPE`, `TUPLE_TYPE`).
pub class AppliedType : TypeNode {
    pub let kw SyntaxToken
    pub let args TypeArgList

    pub func __init__(kw SyntaxToken, args TypeArgList) {
        self.kw = kw
        self.args = args
    }

    pub func kind() NodeKind {
        switch self.kw.token_kind() {
            case klex.TokenKind.MAP: return NodeKind.MAP_TYPE
            case klex.TokenKind.SET: return NodeKind.SET_TYPE
            case klex.TokenKind.TUPLE: return NodeKind.TUPLE_TYPE
            case _: return NodeKind.LIST_TYPE
        }
    }

    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        out.append(self.args)
        return out
    }
}

/// `(A, B)`: the parenthesized spelling of a tuple type.
pub class ParenTupleType : TypeNode {
    pub let lparen SyntaxToken
    pub let items list[TypeNode]
    pub let seps list[SyntaxToken]
    pub let rparen SyntaxToken

    pub func __init__(lparen SyntaxToken, items list[TypeNode], seps list[SyntaxToken], rparen SyntaxToken) {
        self.lparen = lparen
        self.items = items
        self.seps = seps
        self.rparen = rparen
    }

    pub func kind() NodeKind = NodeKind.PAREN_TUPLE_TYPE
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.lparen)
        var i = 0
        while i < self.items.len() {
            out.append(self.items[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        out.append(self.rparen)
        return out
    }
}

/// A fixed-size array type, written either `array[T, N]` or `[N] T`.
///
/// `elem_first` is true for the `[N] T` spelling, where the element type
/// follows the closing bracket. `dims` holds the extent tokens, each an
/// integer literal or `_`.
pub class ArrayType : TypeNode {
    pub let kw SyntaxToken?
    pub let lbracket SyntaxToken
    pub let elem TypeNode?
    pub let comma SyntaxToken?
    pub let dims list[SyntaxToken]
    pub let dseps list[SyntaxToken]
    pub let rbracket SyntaxToken
    pub let elem_first bool

    pub func __init__(
        kw SyntaxToken?, lbracket SyntaxToken, elem TypeNode?, comma SyntaxToken?,
        dims list[SyntaxToken], dseps list[SyntaxToken], rbracket SyntaxToken, elem_first bool ) {
        self.kw = kw
        self.lbracket = lbracket
        self.elem = elem
        self.comma = comma
        self.dims = dims
        self.dseps = dseps
        self.rbracket = rbracket
        self.elem_first = elem_first
    }

    pub func kind() NodeKind = NodeKind.ARRAY_TYPE
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        if self.elem_first {
            out.append(self.lbracket)
            var i = 0
            while i < self.dims.len() {
                out.append(self.dims[i])
                if i < self.dseps.len() {
                    out.append(self.dseps[i])
                }
                i += 1
            }
            out.append(self.rbracket)
            add_opt(out, self.elem)
            return out
        }
        add_opt(out, self.kw)
        out.append(self.lbracket)
        add_opt(out, self.elem)
        add_opt(out, self.comma)
        var i = 0
        while i < self.dims.len() {
            out.append(self.dims[i])
            if i < self.dseps.len() {
                out.append(self.dseps[i])
            }
            i += 1
        }
        out.append(self.rbracket)
        return out
    }
}