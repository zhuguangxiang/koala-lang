import "koala/klex"

/// A leaf of the syntax tree: one token plus the trivia attached to it.
///
/// Trivia (whitespace, newlines, comments) is split at the first newline
/// after a token: everything up to and including that newline is `trailing`
/// trivia of this token, the rest is `leading` trivia of the next token.
/// A semicolon inserted by ASI is a token with an empty lexeme whose
/// `trailing` trivia holds the newline that triggered it, so the tree stays
/// lossless.
///
/// `missing` marks a token the parser expected but did not find; it has an
/// empty lexeme and contributes no text.
pub class SyntaxToken : Node {
    pub let token klex.Token
    pub let leading list[klex.Token]
    pub let trailing list[klex.Token]
    pub let missing bool

    pub func __init__(token klex.Token, leading list[klex.Token], trailing list[klex.Token], missing bool) {
        self.token = token
        self.leading = leading
        self.trailing = trailing
        self.missing = missing
    }

    pub func kind() NodeKind = NodeKind.TOKEN

    pub func slots() list[Node] {
        return list[Node]()
    }

    pub func text() str {
        let buf = Buffer()
        for t in self.leading {
            buf.write_str(t.lexeme)
        }
        buf.write_str(self.token.lexeme)
        for t in self.trailing {
            buf.write_str(t.lexeme)
        }
        return buf.to_str()
    }

    pub func span() Span {
        let t = self.token
        return Span(t.offset, t.offset + t.lexeme.len(), t.line, t.col)
    }

    /// The lexer kind of the token, e.g. `klex.TokenKind.ID`.
    pub func token_kind() klex.TokenKind = self.token.kind

    /// The source spelling of the token, empty for inserted/missing tokens.
    pub func lexeme() str = self.token.lexeme

    pub func line() int = self.token.line
    pub func col() int = self.token.col
    pub func offset() int = self.token.offset

    /// Byte offset just past the token itself, ignoring trivia.
    pub func end() int = self.token.offset + self.token.lexeme.len()

    /// True for a semicolon inserted by automatic semicolon insertion.
    pub func is_inserted() bool {
        if self.missing {
            return false
        }
        return self.token.is_inserted_semi()
    }

    /// True for the synthetic end-of-input token.
    pub func is_eof() bool = self.token.kind == klex.TokenKind.EOF

    /// Byte offset of the first byte of `text()`, including leading trivia.
    pub func full_start() int {
        if self.leading.len() == 0 {
            return self.token.offset
        }
        return self.leading[0].offset
    }

    /// Byte offset just past the last byte of `text()`, including trivia.
    pub func full_end() int {
        let n = self.trailing.len()
        if n == 0 {
            return self.end()
        }
        let t = self.trailing[n - 1]
        return t.offset + t.lexeme.len()
    }
}