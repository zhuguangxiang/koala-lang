import "koala/klex"

/// A cursor over the significant tokens of a file.
///
/// The cursor never moves past the synthetic `EOF` token, so a parser loop
/// that keeps bumping always terminates.
pub class Cursor {
    let toks list[SyntaxToken]
    var i int = 0

    pub func __init__(toks list[SyntaxToken]) {
        self.toks = toks
    }

    /// Number of tokens, including the final `EOF`.
    pub func len() int = self.toks.len()

    /// Current index.
    pub func pos() int = self.i

    /// Jump to `p`, clamped to the last token.
    pub func seek(p int) {
        if p < 0 {
            self.i = 0
        } else if p >= self.toks.len() {
            self.i = self.toks.len() - 1
        } else {
            self.i = p
        }
    }

    /// The token at absolute index `p`, or `EOF` when past the end.
    pub func at(p int) SyntaxToken {
        if p >= self.toks.len() {
            return self.toks[self.toks.len() - 1]
        }
        if p < 0 {
            return self.toks[0]
        }
        return self.toks[p]
    }

    /// The token under the cursor.
    pub func cur() SyntaxToken = self.at(self.i)

    /// The token `n` positions ahead; `peek(0)` is `cur()`.
    pub func peek(n int) SyntaxToken = self.at(self.i + n)

    /// Kind of the token under the cursor.
    pub func kind() klex.TokenKind = self.cur().token_kind()

    /// Kind of the token `n` positions ahead.
    pub func kind_at(n int) klex.TokenKind = self.peek(n).token_kind()

    /// True when the current token has kind `k`.
    pub func check(k klex.TokenKind) bool = self.kind() == k

    /// True when the current token and the next one have kinds `k1`, `k2`.
    pub func check2(k1 klex.TokenKind, k2 klex.TokenKind) bool {
        if self.kind() != k1 {
            return false
        }
        return self.kind_at(1) == k2
    }

    /// Consume and return the current token. Stays put at `EOF`.
    pub func bump() SyntaxToken {
        let t = self.cur()
        if self.i < self.toks.len() - 1 {
            self.i += 1
        }
        return t
    }

    /// Consume the current token when it has kind `k`, else return nil.
    pub func eat(k klex.TokenKind) SyntaxToken? {
        if self.check(k) {
            return self.bump()
        }
        return nil
    }

    /// True at the synthetic end-of-input token.
    pub func at_end() bool = self.cur().is_eof()
}