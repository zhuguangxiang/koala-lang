/// A half-open byte range `[start, end)` in the source text.
///
/// `line` and `col` locate the first byte of the range; both are 1-based,
/// and `col` counts bytes, matching `klex`.
pub class Span {
    pub let start int
    pub let end int
    pub let line int
    pub let col int

    pub func __init__(start int, end int, line int, col int) {
        self.start = start
        self.end = end
        self.line = line
        self.col = col
    }

    /// Number of bytes covered by the span.
    pub func len() int = self.end - self.start

    /// Render as `line:col..end`, for diagnostics and test output.
    pub func to_str() str = format("{}:{}..{}", self.line, self.col, self.end)
}