/// A syntax error found while parsing.
///
/// The parser never throws: it records a diagnostic, inserts a missing
/// token or an error node, and keeps going, so one bad statement does not
/// hide the rest of the file.
pub class Diagnostic {
    pub let message str
    pub let span Span

    pub func __init__(message str, span Span) {
        self.message = message
        self.span = span
    }

    pub func line() int = self.span.line
    pub func col() int = self.span.col
    pub func offset() int = self.span.start

    /// Render as `line:col: message`.
    pub func to_str() str = format("{}:{}: {}", self.span.line, self.span.col, self.message)
}