        self.lparen = lparen
        self.let_kw = let_kw
        self.name = name
        self.eq = eq
        self.cond = cond
        self.rparen = rparen
        self.body = body
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.WHILE
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
