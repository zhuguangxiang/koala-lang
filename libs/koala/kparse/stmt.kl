}

/// `for x in e { ... }`, `for (k, v) in e { ... }`, `for _ in e { ... }`.
pub class ForStmt : Stmt {
    pub let kw SyntaxToken
    pub let lparen SyntaxToken?
    pub let vars list[SyntaxToken]
    pub let seps list[SyntaxToken]
    pub let rparen SyntaxToken?
    pub let in_kw SyntaxToken
    pub let iter Expr
    pub let body Block
    pub let semi SyntaxToken?

    pub func __init__(
        kw SyntaxToken, lparen SyntaxToken?, vars list[SyntaxToken], seps list[SyntaxToken],
        rparen SyntaxToken?, in_kw SyntaxToken, iter Expr, body Block, semi SyntaxToken? ) {
        self.kw = kw
        self.lparen = lparen
        self.vars = vars
        self.seps = seps
        self.rparen = rparen
        self.in_kw = in_kw
        self.iter = iter
        self.body = body
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.FOR
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        add_opt(out, self.lparen)
        var i = 0
        while i < self.vars.len() {
            out.append(self.vars[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        add_opt(out, self.rparen)
        out.append(self.in_kw)
        out.append(self.iter)
        out.append(self.body)
        add_opt(out, self.semi)
        return out
    }
}

/// `with r { ... }`, `with v = e { ... }`, `with let v = e { ... } else { ... }`.
