pub class ReturnStmt : Stmt {
    pub let kw SyntaxToken
    pub let value Expr?
    pub let semi SyntaxToken?

    pub func __init__(kw SyntaxToken, value Expr?, semi SyntaxToken?) {
        self.kw = kw
        self.value = value
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.RETURN
