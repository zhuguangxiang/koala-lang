        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.LINK
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        out.append(self.path)
        add_opt(out, self.semi)
        return out
    }
}

/// One function parameter: `x int`, `args ...T`, `x = 1`, `x int = 1`.
pub class Param : Node {
    pub let name SyntaxToken
    pub let vararg SyntaxToken?
    pub let ty TypeNode?
    pub let eq SyntaxToken?
    pub let default Expr?

    pub func __init__(name SyntaxToken, vararg SyntaxToken?, ty TypeNode?, eq SyntaxToken?, default Expr?) {
        self.name = name
        self.vararg = vararg
        self.ty = ty
        self.eq = eq
        self.default = default
    }

    pub func kind() NodeKind = NodeKind.PARAM
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.name)
        add_opt(out, self.vararg)
        add_opt(out, self.ty)
        add_opt(out, self.eq)
        add_opt(out, self.default)
        return out
    }
}

/// One type parameter: `T`, `T : Bound & Bound`, `infer T`, `const N int`.
pub class TypeParam : Node {
    pub let const_kw SyntaxToken?
    pub let infer_kw SyntaxToken?
    pub let name SyntaxToken
    pub let colon SyntaxToken?
    pub let bounds list[TypeNode]
    pub let bseps list[SyntaxToken]

    pub func __init__(
        const_kw SyntaxToken?, infer_kw SyntaxToken?, name SyntaxToken, colon SyntaxToken?,
        bounds list[TypeNode], bseps list[SyntaxToken] ) {
        self.const_kw = const_kw
        self.infer_kw = infer_kw
        self.name = name
        self.colon = colon
        self.bounds = bounds
        self.bseps = bseps
    }

    pub func kind() NodeKind = NodeKind.TYPE_PARAM
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        add_opt(out, self.const_kw)
        add_opt(out, self.infer_kw)
        out.append(self.name)
        add_opt(out, self.colon)
        var i = 0
        while i < self.bounds.len() {
            out.append(self.bounds[i])
            if i < self.bseps.len() {
                out.append(self.bseps[i])
            }
            i += 1
        }
        return out
    }
}

/// `[T, U : Bound]`: the type parameter list of a function, class or trait.
pub class TypeParamList : Node {
    pub let lbracket SyntaxToken
    pub let items list[TypeParam]
    pub let seps list[SyntaxToken]
    pub let rbracket SyntaxToken

    pub func __init__(lbracket SyntaxToken, items list[TypeParam], seps list[SyntaxToken], rbracket SyntaxToken) {
        self.lbracket = lbracket
        self.items = items
        self.seps = seps
        self.rbracket = rbracket
    }

    pub func kind() NodeKind = NodeKind.TYPE_PARAMS
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.lbracket)
        var i = 0
        while i < self.items.len() {
            out.append(self.items[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        out.append(self.rbracket)
        return out
    }
}

/// A function or method declaration.
///
/// `body` is a [`Block`](#block), or an expression for the one-line form
/// `func f() = expr`. It is nil for a trait method signature, which has no
/// body at all.
pub class FuncDecl : Decl {
    pub let prefix Prefix?
    pub let kw SyntaxToken
    pub let name SyntaxToken
    pub let tparams TypeParamList?
    pub let lparen SyntaxToken
    pub let params list[Param]
    pub let seps list[SyntaxToken]
    pub let rparen SyntaxToken
    pub let ret TypeNode?
    pub let eq SyntaxToken?
    pub let body Node?
    pub let semi SyntaxToken?

    pub func __init__(
        prefix Prefix?, kw SyntaxToken, name SyntaxToken, tparams TypeParamList?, lparen SyntaxToken,
        params list[Param], seps list[SyntaxToken], rparen SyntaxToken, ret TypeNode?,
        eq SyntaxToken?, body Node?, semi SyntaxToken? ) {
        self.prefix = prefix
        self.kw = kw
        self.name = name
        self.tparams = tparams
        self.lparen = lparen
        self.params = params
        self.seps = seps
        self.rparen = rparen
        self.ret = ret
        self.eq = eq
        self.body = body
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.FUNC
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        add_opt(out, self.prefix)
        out.append(self.kw)
        out.append(self.name)
        add_opt(out, self.tparams)
        out.append(self.lparen)
        var i = 0
        while i < self.params.len() {
            out.append(self.params[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        out.append(self.rparen)
        add_opt(out, self.ret)
        add_opt(out, self.eq)
        add_opt(out, self.body)
        add_opt(out, self.semi)
        return out
    }
}

/// One `name = value` argument of an annotation.
pub class AnnotParam : Node {
    pub let name SyntaxToken
    pub let eq SyntaxToken
    pub let value Expr

    pub func __init__(name SyntaxToken, eq SyntaxToken, value Expr) {
        self.name = name
        self.eq = eq
        self.value = value
    }

    pub func kind() NodeKind = NodeKind.ANNOT_PARAM
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.name)
        out.append(self.eq)
        out.append(self.value)
        return out
    }
}

/// `@name`, `@name(...)`. Arguments are types, a string literal, or
/// `name = value` pairs; they are kept as generic nodes.
pub class Annotation : Node {
    pub let at SyntaxToken
    pub let name SyntaxToken
    pub let lparen SyntaxToken?
    pub let args list[Node]
    pub let seps list[SyntaxToken]
    pub let rparen SyntaxToken?
    pub let semi SyntaxToken?

    pub func __init__(
        at SyntaxToken, name SyntaxToken, lparen SyntaxToken?, args list[Node],
        seps list[SyntaxToken], rparen SyntaxToken?, semi SyntaxToken? ) {
        self.at = at
        self.name = name
        self.lparen = lparen
        self.args = args
        self.seps = seps
        self.rparen = rparen
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.ANNOTATION
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.at)
        out.append(self.name)
        add_opt(out, self.lparen)
        var i = 0
        while i < self.args.len() {
            out.append(self.args[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        add_opt(out, self.rparen)
        add_opt(out, self.semi)
        return out
    }
}

/// What may precede a declaration: annotations, `pub`, and `static`.
pub class Prefix : Node {
    pub let annotations list[Annotation]
    pub let pub_kw SyntaxToken?
    pub let static_kw SyntaxToken?

    pub func __init__(annotations list[Annotation], pub_kw SyntaxToken?, static_kw SyntaxToken?) {
        self.annotations = annotations
        self.pub_kw = pub_kw
        self.static_kw = static_kw
    }

    pub func kind() NodeKind = NodeKind.PREFIX
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        for a in self.annotations {
            out.append(a)
        }
        add_opt(out, self.pub_kw)
        add_opt(out, self.static_kw)
        return out
    }
}

/// A `class` or `trait` declaration; `kind()` tells them apart.
///
/// `bases` holds the types after `:`, separated by `&` in `bseps`.
/// `members` holds [`VarDecl`](#vardecl) fields and [`FuncDecl`](#funcdecl)
/// methods for a class, and body-less `FuncDecl` signatures for a trait.
pub class TypeDecl : Decl {
    pub let prefix Prefix?
    pub let kw SyntaxToken
    pub let name SyntaxToken
    pub let tparams TypeParamList?
    pub let colon SyntaxToken?
    pub let bases list[TypeNode]
    pub let bseps list[SyntaxToken]
    pub let lbrace SyntaxToken
    pub let members list[Stmt]
    pub let rbrace SyntaxToken
    pub let semi SyntaxToken?

    pub func __init__(
        prefix Prefix?, kw SyntaxToken, name SyntaxToken, tparams TypeParamList?, colon SyntaxToken?,
        bases list[TypeNode], bseps list[SyntaxToken], lbrace SyntaxToken, members list[Stmt],
        rbrace SyntaxToken, semi SyntaxToken? ) {
        self.prefix = prefix
        self.kw = kw
        self.name = name
        self.tparams = tparams
        self.colon = colon
        self.bases = bases
        self.bseps = bseps
        self.lbrace = lbrace
        self.members = members
        self.rbrace = rbrace
        self.semi = semi
    }

    pub func kind() NodeKind {
        if self.kw.token_kind() == klex.TokenKind.TRAIT {
            return NodeKind.TRAIT
        }
        return NodeKind.CLASS
    }

    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        add_opt(out, self.prefix)
        out.append(self.kw)
        out.append(self.name)
        add_opt(out, self.tparams)
        add_opt(out, self.colon)
        var i = 0
        while i < self.bases.len() {
            out.append(self.bases[i])
            if i < self.bseps.len() {
                out.append(self.bseps[i])
            }
            i += 1
        }
        out.append(self.lbrace)
        for m in self.members {
            out.append(m)
        }
        out.append(self.rbrace)
        add_opt(out, self.semi)
        return out
    }
}

/// One enum member: `NAME` or `NAME = 3`.
pub class EnumMember : Node {
    pub let name SyntaxToken
    pub let eq SyntaxToken?
    pub let value SyntaxToken?

    pub func __init__(name SyntaxToken, eq SyntaxToken?, value SyntaxToken?) {
        self.name = name
        self.eq = eq
        self.value = value
    }

    pub func kind() NodeKind = NodeKind.ENUM_MEMBER
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.name)
        add_opt(out, self.eq)
        add_opt(out, self.value)
        return out
    }
}

/// An `enum` declaration. Members are separated by `,`, `;` or a newline;
/// `seps[i]` is the separator written after `members[i]`.
pub class EnumDecl : Decl {
    pub let prefix Prefix?
    pub let kw SyntaxToken
    pub let name SyntaxToken
    pub let lbrace SyntaxToken
    pub let members list[EnumMember]
    pub let seps list[SyntaxToken]
    pub let rbrace SyntaxToken
    pub let semi SyntaxToken?

    pub func __init__(
        prefix Prefix?, kw SyntaxToken, name SyntaxToken, lbrace SyntaxToken,
        members list[EnumMember], seps list[SyntaxToken], rbrace SyntaxToken, semi SyntaxToken? ) {
        self.prefix = prefix
        self.kw = kw
        self.name = name
        self.lbrace = lbrace
        self.members = members
        self.seps = seps
        self.rbrace = rbrace
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.ENUM
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        add_opt(out, self.prefix)
        out.append(self.kw)
        out.append(self.name)
        out.append(self.lbrace)
        var i = 0
        while i < self.members.len() {
            out.append(self.members[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        out.append(self.rbrace)
        add_opt(out, self.semi)
        return out
    }
}

/// `type Name = SomeType`.
pub class TypeAliasStmt : Decl {
    pub let prefix Prefix?
    pub let kw SyntaxToken
    pub let name SyntaxToken
    pub let eq SyntaxToken
    pub let ty TypeNode
    pub let semi SyntaxToken?

    pub func __init__(prefix Prefix?, kw SyntaxToken, name SyntaxToken, eq SyntaxToken, ty TypeNode, semi SyntaxToken?) {
        self.prefix = prefix
        self.kw = kw
        self.name = name
        self.eq = eq
        self.ty = ty
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.TYPE_ALIAS
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        add_opt(out, self.prefix)
        out.append(self.kw)
        out.append(self.name)
        out.append(self.eq)
        out.append(self.ty)
        add_opt(out, self.semi)
        return out
    }
}