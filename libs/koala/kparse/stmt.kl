}

/// `break` or `continue`; `kind()` tells them apart.
pub class JumpStmt : Stmt {
    pub let kw SyntaxToken
    pub let semi SyntaxToken?

    pub func __init__(kw SyntaxToken, semi SyntaxToken?) {
        self.kw = kw
        self.semi = semi
    }

    pub func kind() NodeKind {
        if self.kw.token_kind() == klex.TokenKind.CONTINUE {
            return NodeKind.CONTINUE
        }
        return NodeKind.BREAK
    }

    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        add_opt(out, self.semi)
        return out
    }
}

/// An `if` statement, including `if let x = e { ... }` and its parenthesized
/// spelling `if (let x = e) { ... }`.
///
/// `else_body` is a [`Block`](#block) or another `IfStmt` for `else if`.
pub class IfStmt : Stmt {
    pub let kw SyntaxToken
    pub let lparen SyntaxToken?
    pub let let_kw SyntaxToken?
    pub let name SyntaxToken?
    pub let eq SyntaxToken?
    pub let cond Expr
    pub let rparen SyntaxToken?
    pub let body Block
    pub let else_kw SyntaxToken?
    pub let else_body Node?
    pub let semi SyntaxToken?

    pub func __init__(
        kw SyntaxToken, lparen SyntaxToken?, let_kw SyntaxToken?, name SyntaxToken?, eq SyntaxToken?,
        cond Expr, rparen SyntaxToken?, body Block, else_kw SyntaxToken?, else_body Node?, semi SyntaxToken? ) {
        self.kw = kw
        self.lparen = lparen
        self.let_kw = let_kw
        self.name = name
        self.eq = eq
        self.cond = cond
        self.rparen = rparen
        self.body = body
        self.else_kw = else_kw
        self.else_body = else_body
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.IF
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        add_opt(out, self.lparen)
        add_opt(out, self.let_kw)
        add_opt(out, self.name)
        add_opt(out, self.eq)
        out.append(self.cond)
        add_opt(out, self.rparen)
        out.append(self.body)
        add_opt(out, self.else_kw)
        add_opt(out, self.else_body)
        add_opt(out, self.semi)
        return out
    }
}

