        self.let_kw = let_kw
        self.name = name
        self.eq = eq
        self.value = value
        self.body = body
        self.else_kw = else_kw
        self.else_block = else_block
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.WITH
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        add_opt(out, self.let_kw)
        add_opt(out, self.name)
        add_opt(out, self.eq)
        out.append(self.value)
        out.append(self.body)
        add_opt(out, self.else_kw)
        add_opt(out, self.else_block)
        add_opt(out, self.semi)
        return out
    }
}

/// One pattern of a `case`: an expression, `in expr`, or `is Type`.
pub class CasePattern : Node {
    pub let in_kw SyntaxToken?
    pub let is_kw SyntaxToken?
    pub let value Expr?
    pub let ty TypeNode?

    pub func __init__(in_kw SyntaxToken?, is_kw SyntaxToken?, value Expr?, ty TypeNode?) {
        self.in_kw = in_kw
        self.is_kw = is_kw
        self.value = value
        self.ty = ty
    }

    pub func kind() NodeKind = NodeKind.CASE_PATTERN
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        add_opt(out, self.in_kw)
        add_opt(out, self.is_kw)
        add_opt(out, self.value)
        add_opt(out, self.ty)
        return out
    }
}

/// `case p1, p2: body`. `tail` holds the `;` or `,` written after the body.
pub class CaseClause : Node {
    pub let kw SyntaxToken
    pub let patterns list[CasePattern]
    pub let seps list[SyntaxToken]
    pub let colon SyntaxToken
    pub let body Stmt
    pub let tail SyntaxToken?

    pub func __init__(
        kw SyntaxToken, patterns list[CasePattern], seps list[SyntaxToken],
        colon SyntaxToken, body Stmt, tail SyntaxToken? ) {
        self.kw = kw
        self.patterns = patterns
        self.seps = seps
        self.colon = colon
        self.body = body
        self.tail = tail
    }

    pub func kind() NodeKind = NodeKind.CASE
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        var i = 0
        while i < self.patterns.len() {
            out.append(self.patterns[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        out.append(self.colon)
        out.append(self.body)
        add_opt(out, self.tail)
        return out
    }
}

/// `switch e { case ...: ... }`.
///
/// `cases` holds [`CaseClause`](#caseclause) nodes, plus `ErrorStmt` nodes
/// for tokens skipped while recovering inside the body.
pub class SwitchStmt : Stmt {
    pub let kw SyntaxToken
    pub let subject Expr
    pub let lbrace SyntaxToken
    pub let cases list[Node]
    pub let rbrace SyntaxToken
    pub let semi SyntaxToken?

    pub func __init__(kw SyntaxToken, subject Expr, lbrace SyntaxToken, cases list[Node], rbrace SyntaxToken, semi SyntaxToken?) {
        self.kw = kw
        self.subject = subject
        self.lbrace = lbrace
        self.cases = cases
        self.rbrace = rbrace
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.SWITCH
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        out.append(self.subject)
        out.append(self.lbrace)
        for c in self.cases {
            out.append(c)
        }
        out.append(self.rbrace)
        add_opt(out, self.semi)
        return out
    }
}

/// `import "path"` or `import "path" as alias`.
pub class ImportStmt : Decl {
    pub let kw SyntaxToken
    pub let path SyntaxToken
    pub let as_kw SyntaxToken?
    pub let alias SyntaxToken?
    pub let semi SyntaxToken?

    pub func __init__(kw SyntaxToken, path SyntaxToken, as_kw SyntaxToken?, alias SyntaxToken?, semi SyntaxToken?) {
        self.kw = kw
        self.path = path
        self.as_kw = as_kw
        self.alias = alias
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.IMPORT
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        out.append(self.path)
        add_opt(out, self.as_kw)
        add_opt(out, self.alias)
        add_opt(out, self.semi)
        return out
    }
}

/// One name of a `from ... import ...` list: `name` or `name as alias`.
pub class ImportItem : Node {
    pub let name SyntaxToken
    pub let as_kw SyntaxToken?
    pub let alias SyntaxToken?

    pub func __init__(name SyntaxToken, as_kw SyntaxToken?, alias SyntaxToken?) {
        self.name = name
        self.as_kw = as_kw
        self.alias = alias
    }

    pub func kind() NodeKind = NodeKind.IMPORT_ITEM
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.name)
        add_opt(out, self.as_kw)
        add_opt(out, self.alias)
        return out
    }
}

/// `from "path" import a, b as c`.
pub class FromStmt : Decl {
    pub let kw SyntaxToken
    pub let path SyntaxToken
    pub let import_kw SyntaxToken
    pub let items list[ImportItem]
    pub let seps list[SyntaxToken]
    pub let semi SyntaxToken?

    pub func __init__(
        kw SyntaxToken, path SyntaxToken, import_kw SyntaxToken,
        items list[ImportItem], seps list[SyntaxToken], semi SyntaxToken? ) {
        self.kw = kw
        self.path = path
        self.import_kw = import_kw
        self.items = items
        self.seps = seps
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.FROM
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        out.append(self.path)
        out.append(self.import_kw)
        var i = 0
        while i < self.items.len() {
            out.append(self.items[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        add_opt(out, self.semi)
        return out
    }
}

/// `link "path"`.
pub class LinkStmt : Decl {
    pub let kw SyntaxToken
    pub let path SyntaxToken
    pub let semi SyntaxToken?

    pub func __init__(kw SyntaxToken, path SyntaxToken, semi SyntaxToken?) {
        self.kw = kw
