import "koala/klex"

/// A whole source file: top-level statements plus the end-of-input token,
/// which owns any trivia left at the end of the file.
pub class Module : Node {
    pub let items list[Stmt]
    pub let eof SyntaxToken

    pub func __init__(items list[Stmt], eof SyntaxToken) {
        self.items = items
        self.eof = eof
    }

    pub func kind() NodeKind = NodeKind.MODULE
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        for s in self.items {
            out.append(s)
        }
        out.append(self.eof)
        return out
    }
}

/// `{ ... }`: a statement block.
pub class Block : Stmt {
    pub let lbrace SyntaxToken
    pub let items list[Stmt]
    pub let rbrace SyntaxToken

    pub func __init__(lbrace SyntaxToken, items list[Stmt], rbrace SyntaxToken) {
        self.lbrace = lbrace
        self.items = items
        self.rbrace = rbrace
    }

    pub func kind() NodeKind = NodeKind.BLOCK
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.lbrace)
        for s in self.items {
            out.append(s)
        }
        out.append(self.rbrace)
        return out
    }
}

/// An expression evaluated for its effect, with its optional terminator.
pub class ExprStmt : Stmt {
    pub let value Expr
    pub let semi SyntaxToken?

    pub func __init__(value Expr, semi SyntaxToken?) {
        self.value = value
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.EXPR_STMT
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.value)
        add_opt(out, self.semi)
        return out
    }
}

/// A lone `;`.
pub class EmptyStmt : Stmt {
    pub let semi SyntaxToken

    pub func __init__(semi SyntaxToken) {
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.EMPTY
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.semi)
        return out
    }
}

/// Tokens the parser skipped while recovering from an error.
pub class ErrorStmt : Stmt {
    pub let tokens list[SyntaxToken]

    pub func __init__(tokens list[SyntaxToken]) {
        self.tokens = tokens
    }

    pub func kind() NodeKind = NodeKind.ERROR_STMT
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        for t in self.tokens {
            out.append(t)
        }
        return out
    }
}

/// A `let`, `var` or `const` binding; also used for class fields.
///
/// `kind()` returns `LET`, `VAR` or `CONST`. `value` is nil for a field
/// declared without an initializer (`pub let name str`). `else_kw` and
/// `else_block` hold the diverging branch of `let x = e else { ... }`.
pub class VarDecl : Stmt {
    pub let prefix Prefix?
    pub let kw SyntaxToken
    pub let name SyntaxToken
    pub let ty TypeNode?
    pub let eq SyntaxToken?
    pub let value Expr?
    pub let else_kw SyntaxToken?
    pub let else_block Block?
    pub let semi SyntaxToken?

    pub func __init__(
        prefix Prefix?, kw SyntaxToken, name SyntaxToken, ty TypeNode?, eq SyntaxToken?,
        value Expr?, else_kw SyntaxToken?, else_block Block?, semi SyntaxToken? ) {
        self.prefix = prefix
        self.kw = kw
        self.name = name
        self.ty = ty
        self.eq = eq
        self.value = value
        self.else_kw = else_kw
        self.else_block = else_block
        self.semi = semi
    }

    pub func kind() NodeKind {
        switch self.kw.token_kind() {
            case klex.TokenKind.VAR: return NodeKind.VAR
            case klex.TokenKind.CONST: return NodeKind.CONST
            case _: return NodeKind.LET
        }
    }

    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        add_opt(out, self.prefix)
        out.append(self.kw)
        out.append(self.name)
        add_opt(out, self.ty)
        add_opt(out, self.eq)
        add_opt(out, self.value)
        add_opt(out, self.else_kw)
        add_opt(out, self.else_block)
        add_opt(out, self.semi)
        return out
    }
}

/// One name of a destructuring binding: `a`, `a int`, or the placeholder `_`.
pub class TupleTarget : Node {
    pub let name SyntaxToken
    pub let ty TypeNode?

    pub func __init__(name SyntaxToken, ty TypeNode?) {
        self.name = name
        self.ty = ty
    }

    pub func kind() NodeKind = NodeKind.TUPLE_TARGET
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.name)
        add_opt(out, self.ty)
        return out
    }
}

/// A destructuring binding: `let (a, b) = t`, `var (a int, _) = t`,
/// optionally followed by `else { ... }`.
pub class TupleDeclStmt : Stmt {
    pub let kw SyntaxToken
    pub let lparen SyntaxToken
    pub let targets list[TupleTarget]
    pub let seps list[SyntaxToken]
    pub let rparen SyntaxToken
    pub let eq SyntaxToken
    pub let value Expr
    pub let else_kw SyntaxToken?
    pub let else_block Block?
    pub let semi SyntaxToken?

    pub func __init__(
        kw SyntaxToken, lparen SyntaxToken, targets list[TupleTarget], seps list[SyntaxToken],
        rparen SyntaxToken, eq SyntaxToken, value Expr, else_kw SyntaxToken?, else_block Block?, semi SyntaxToken? ) {
        self.kw = kw
        self.lparen = lparen
        self.targets = targets
        self.seps = seps
        self.rparen = rparen
        self.eq = eq
        self.value = value
        self.else_kw = else_kw
        self.else_block = else_block
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.TUPLE_DECL
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.kw)
        out.append(self.lparen)
        var i = 0
        while i < self.targets.len() {
            out.append(self.targets[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        out.append(self.rparen)
        out.append(self.eq)
        out.append(self.value)
        add_opt(out, self.else_kw)
        add_opt(out, self.else_block)
        add_opt(out, self.semi)
        return out
    }
}

/// An assignment: `x = v`, `x += v`, `a[i] = v`, `o.f = v`.
pub class AssignStmt : Stmt {
    pub let target Expr
    pub let op SyntaxToken
    pub let value Expr
    pub let semi SyntaxToken?

    pub func __init__(target Expr, op SyntaxToken, value Expr, semi SyntaxToken?) {
        self.target = target
        self.op = op
        self.value = value
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.ASSIGN
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.target)
        out.append(self.op)
        out.append(self.value)
        add_opt(out, self.semi)
        return out
    }
}

/// A tuple assignment: `(a, b) = t`.
pub class TupleAssignStmt : Stmt {
    pub let lparen SyntaxToken
    pub let items list[Expr]
    pub let seps list[SyntaxToken]
    pub let rparen SyntaxToken
    pub let op SyntaxToken
    pub let value Expr
    pub let semi SyntaxToken?

    pub func __init__(
        lparen SyntaxToken, items list[Expr], seps list[SyntaxToken], rparen SyntaxToken,
        op SyntaxToken, value Expr, semi SyntaxToken? ) {
        self.lparen = lparen
        self.items = items
        self.seps = seps
        self.rparen = rparen
        self.op = op
        self.value = value
        self.semi = semi
    }

    pub func kind() NodeKind = NodeKind.TUPLE_ASSIGN
    pub func text() str = node_text(self)
    pub func span() Span = node_span(self)

    pub func slots() list[Node] {
        let out = list[Node]()
        out.append(self.lparen)
        var i = 0
        while i < self.items.len() {
            out.append(self.items[i])
            if i < self.seps.len() {
                out.append(self.seps[i])
            }
            i += 1
        }
        out.append(self.rparen)
        out.append(self.op)
        out.append(self.value)
        add_opt(out, self.semi)
        return out
    }
}

