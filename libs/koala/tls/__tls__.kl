// tls

link "koala_tls"

import "std/socket" as so

@native
pub func probe() bool {}

/// Connect to `url` over TCP, then upgrade to TLS.
///
/// `url` accepts "host:port" or "[v6]:port", as `so.dial` does. `host`
/// is both the connect target and the SNI name, the way Go's tls.Dial
/// uses its address argument; `options.server_name()` overrides the
/// latter. `net_options` configures the TCP connection. Returns nil on
/// a bad url, TCP failure or TLS failure.
pub func dial(url str, options TlsOptions? = nil, net_options so.DialOptions? = nil) TlsConn? {
    let (host, _) = so.split_host_port(url) else { return nil }

    let c = so.dial(url, so.SocketTypeSpec.tcp(), net_options)
    if c == nil { return nil }
    let tcp = (c as so.TcpConn)!

    let conn = TlsConn.wrap(tcp, host, options)
    // The TCP connection belongs to no one when the handshake fails.
    if conn == nil { tcp.close() }
    return conn
}
