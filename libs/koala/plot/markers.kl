/// Full matplotlib marker support beyond the fmt characters.
///
/// A marker argument (`int | str`) accepts, like matplotlib:
/// - int 0..11 : the tick/caret table (matplotlib `_markers_int`)
/// - named strings : the full mpl registry plus the fmt characters
/// - "None" / "none" / "" / " " : no marker
/// - "$...$" : mathtext; the renderer draws the inner text as-is
///   (simplified: raw LaTeX source, no math layout)
/// - "path:x0,y0;x1,y1;..." : custom polygon path, vertices in the unit
///   box around the point, closed and filled (simplified `Path` support;
///   matplotlib takes a `Path` object instead)
///
/// `resolve_marker` returns the renderer kind string, or nil when nothing
/// is drawn. Panics with matplotlib's message on an unknown spec.

/// The int marker table (matplotlib `_markers_int`).
func int_marker(i int) str {
    if i == 0 {
        return "tickleft"
    }
    if i == 1 {
        return "tickright"
    }
    if i == 2 {
        return "tickup"
    }
    if i == 3 {
        return "tickdown"
    }
    if i == 4 {
        return "caretleft"
    }
    if i == 5 {
        return "caretright"
    }
    if i == 6 {
        return "caretup"
    }
    if i == 7 {
        return "caretdown"
    }
    if i == 8 {
        return "caretleftbase"
    }
    if i == 9 {
        return "caretrightbase"
    }
    if i == 10 {
        return "caretupbase"
    }
    if i == 11 {
        return "caretdownbase"
    }
    panic(format("Unrecognized marker style {}", i))
}

/// The named marker registry: fmt characters plus matplotlib's named
/// tick/caret kinds, space separated.
func named_markers() str {
    return "o v ^ < > 1 2 3 4 8 s p P * h H + x X D d | _ . , tickleft tickright tickup tickdown caretleft caretright caretup caretdown caretleftbase caretrightbase caretupbase caretdownbase"
}

/// True when `word` is one of the space-separated tokens of `s`.
func has_token(s str, word str) bool {
    let words = s.split(" ")
    for w in words {
        if w == word {
            return true
        }
    }
    return false
}

/// Resolve a string marker to the renderer kind string.
pub func resolve_marker_str(m str) str? {
    if m == "" || m == " " || m == "None" || m == "none" {
        return nil
    }
    if m.len() >= 2 && m.starts_with("$") && m.ends_with("$") {
        return m
    }
    if m.index("path:") == 0 {
        return m
    }
    if has_token(named_markers(), m) {
        return m
    }
    panic(format("Unrecognized marker style {}", m))
}

/// Resolve a marker argument to the renderer kind string.
pub func resolve_marker(mv int | str) str? {
    switch mv {
        case is int64: {
            return int_marker(mv)
        }
        case is str: {
            return resolve_marker_str(mv)
        }
    }
    return nil
}
