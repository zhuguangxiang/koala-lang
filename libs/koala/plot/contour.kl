/// Contour extraction (marching squares) for the plot spec layer, computed
/// Koala-side per docs/koala_ml.md §6.3 so the figure spec carries resolved
/// contour line geometry in data coordinates and the renderer only strokes
/// it. This is the hard requirement for cost-surface J(theta0, theta1)
/// assignments.
///
/// `Z` is a row-major grid `Z[row][col]`; `xs[col]` and `ys[row]` give the
/// data coordinates of the grid lines. Each level yields a set of line
/// segments (the v1 representation; connected polylines are a later
/// refinement). Saddle cells (cases 5 and 10) are disambiguated by the
/// cell-center average.

/// One contour line segment in data coordinates.
pub class Segment {
    pub let x0 float
    pub let y0 float
    pub let x1 float
    pub let y1 float

    pub func __init__(x0 float, y0 float, x1 float, y1 float) {
        self.x0 = x0
        self.y0 = y0
        self.x1 = x1
        self.y1 = y1
    }
}

/// All segments extracted for one contour level.
pub class ContourLevel {
    pub let level float
    pub let segments = list[Segment]()

    pub func __init__(level float) {
        self.level = level
    }
}

/// A single grid cell: corner values (v0 bottom-left, v1 bottom-right,
/// v2 top-right, v3 top-left) and corner coordinates. Internal helper.
class Cell {
    let v0 float
    let v1 float
    let v2 float
    let v3 float
    let x0 float
    let x1 float
    let y0 float
    let y1 float

    func __init__(v0 float, v1 float, v2 float, v3 float,
                  x0 float, x1 float, y0 float, y1 float) {
        self.v0 = v0
        self.v1 = v1
        self.v2 = v2
        self.v3 = v3
        self.x0 = x0
        self.x1 = x1
        self.y0 = y0
        self.y1 = y1
    }

    /// Marching-squares case index: bit i set when corner i is >= level.
    func code_at(level float) int {
        var code = 0
        if v0 >= level {
            code = code + 1
        }
        if v1 >= level {
            code = code + 2
        }
        if v2 >= level {
            code = code + 4
        }
        if v3 >= level {
            code = code + 8
        }
        return code
    }

    /// Crossing point on edge `edge` (0 bottom, 1 right, 2 top, 3 left),
    /// linearly interpolated to where the corner values straddle `level`.
    func edge_xy(edge int, level float) (float, float) {
        if edge == 0 {
            let t = frac(v0, v1, level)
            return (x0 + t * (x1 - x0), y0)
        }
        if edge == 1 {
            let t = frac(v1, v2, level)
            return (x1, y0 + t * (y1 - y0))
        }
        if edge == 2 {
            let t = frac(v2, v3, level)
            return (x1 + t * (x0 - x1), y1)
        }
        let t = frac(v3, v0, level)
        return (x0, y1 + t * (y0 - y1))
    }
}

/// Interpolation fraction where `level` falls between corner values a, b.
/// A crossed edge always straddles the level (a != b); the zero-denominator
/// guard only covers degenerate float equality.
func frac(a float, b float, level float) float {
    let d = b - a
    if d == 0.0 {
        return 0.5
    }
    return (level - a) / d
}

/// Append the segment joining edges `ea` and `eb` of `cell` at `level`.
func add_seg(cl ContourLevel, ea int, eb int, cell Cell, level float) {
    let (ax, ay) = cell.edge_xy(ea, level)
    let (bx, by) = cell.edge_xy(eb, level)
    cl.segments.append(Segment(ax, ay, bx, by))
}

/// Extract contour segments for each level in `levels` from grid `Z` with
/// coordinate axes `xs` (length = cols) and `ys` (length = rows). Returns
/// one `ContourLevel` per requested level, in order. Panics on a grid with
/// fewer than 2 rows/cols, a non-rectangular grid, or axis length mismatch.
pub func marching_squares(Z list[list[float]], xs list[float], ys list[float],
                          levels list[float]) list[ContourLevel] {
    let rows = Z.len()
    if rows < 2 {
        panic("plot.contour: Z needs at least 2 rows")
    }
    let cols = Z[0].len()
    if cols < 2 {
        panic("plot.contour: Z needs at least 2 cols")
    }
    if xs.len() != cols {
        panic("plot.contour: xs length must match Z columns")
    }
    if ys.len() != rows {
        panic("plot.contour: ys length must match Z rows")
    }
    for row in Z {
        if row.len() != cols {
            panic("plot.contour: Z must be rectangular")
        }
    }

    let result = list[ContourLevel]()
    for level in levels {
        result.append(ContourLevel(level))
    }

    var r = 0
    while r < rows - 1 {
        var c = 0
        while c < cols - 1 {
            let cell = Cell(Z[r][c], Z[r][c + 1], Z[r + 1][c + 1], Z[r + 1][c],
                            xs[c], xs[c + 1], ys[r], ys[r + 1])
            var li = 0
            while li < levels.len() {
                let level = levels[li]
                let cl = result[li]
                let code = cell.code_at(level)
                if code == 1 || code == 14 {
                    add_seg(cl, 3, 0, cell, level)
                } else if code == 2 || code == 13 {
                    add_seg(cl, 0, 1, cell, level)
                } else if code == 3 || code == 12 {
                    add_seg(cl, 3, 1, cell, level)
                } else if code == 4 || code == 11 {
                    add_seg(cl, 1, 2, cell, level)
                } else if code == 6 || code == 9 {
                    add_seg(cl, 0, 2, cell, level)
                } else if code == 7 || code == 8 {
                    add_seg(cl, 3, 2, cell, level)
                } else if code == 5 {
                    let center = (cell.v0 + cell.v1 + cell.v2 + cell.v3) / 4.0
                    if center >= level {
                        add_seg(cl, 0, 1, cell, level)
                        add_seg(cl, 2, 3, cell, level)
                    } else {
                        add_seg(cl, 3, 0, cell, level)
                        add_seg(cl, 1, 2, cell, level)
                    }
                } else if code == 10 {
                    let center = (cell.v0 + cell.v1 + cell.v2 + cell.v3) / 4.0
                    if center >= level {
                        add_seg(cl, 3, 0, cell, level)
                        add_seg(cl, 1, 2, cell, level)
                    } else {
                        add_seg(cl, 0, 1, cell, level)
                        add_seg(cl, 2, 3, cell, level)
                    }
                }
                li = li + 1
            }
            c = c + 1
        }
        r = r + 1
    }
    return result
}

/// Choose `n` evenly spaced interior contour levels spanning the min/max of
/// `Z` (the automatic level selection of docs/koala_ml.md §6.3). A constant
/// grid yields a single level at that value. Panics on `n < 1` or empty Z.
pub func auto_levels(Z list[list[float]], n int = 8) list[float] {
    if n < 1 {
        panic("plot.auto_levels: n must be >= 1")
    }
    if Z.len() == 0 || Z[0].len() == 0 {
        panic("plot.auto_levels: Z must be non-empty")
    }
    var lo = Z[0][0]
    var hi = Z[0][0]
    for row in Z {
        for v in row {
            if v < lo {
                lo = v
            }
            if v > hi {
                hi = v
            }
        }
    }
    let levels = list[float]()
    if hi == lo {
        levels.append(lo)
        return levels
    }
    var i = 0
    while i < n {
        levels.append(lo + (float(i) + 1.0) * (hi - lo) / float(n + 1))
        i = i + 1
    }
    return levels
}