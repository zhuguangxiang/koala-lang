import "koala/math"

/// Contour extraction (marching squares) for the plot spec layer, computed
/// Koala-side per docs/koala_ml.md §6.3 so the figure spec carries resolved
/// contour line geometry in data coordinates and the renderer only strokes
/// it. This is the hard requirement for cost-surface J(theta0, theta1)
/// assignments.
///
/// `Z` is a row-major grid `Z[row][col]`; `xs[col]` and `ys[row]` give the
/// data coordinates of the grid lines. Each level yields a set of line
/// segments (the v1 representation; connected polylines are a later
/// refinement). Saddle cells (cases 5 and 10) are disambiguated by the
/// cell-center average.

/// One contour line segment in data coordinates.
pub class Segment {
    pub let x0 float
    pub let y0 float
    pub let x1 float
    pub let y1 float

    pub func __init__(x0 float, y0 float, x1 float, y1 float) {
        self.x0 = x0
        self.y0 = y0
        self.x1 = x1
        self.y1 = y1
    }
}

/// All segments extracted for one contour level.
pub class ContourLevel {
    pub let level float
    pub let segments = list[Segment]()

    pub func __init__(level float) {
        self.level = level
    }
}

/// A single grid cell: corner values (v0 bottom-left, v1 bottom-right,
/// v2 top-right, v3 top-left) and corner coordinates. Internal helper.
class Cell {
    let v0 float
    let v1 float
    let v2 float
    let v3 float
    let x0 float
    let x1 float
    let y0 float
    let y1 float

    func __init__(v0 float, v1 float, v2 float, v3 float,
                  x0 float, x1 float, y0 float, y1 float) {
        self.v0 = v0
        self.v1 = v1
        self.v2 = v2
        self.v3 = v3
        self.x0 = x0
        self.x1 = x1
        self.y0 = y0
        self.y1 = y1
    }

    /// Marching-squares case index: bit i set when corner i is >= level.
    func code_at(level float) int {
        var code = 0
        if v0 >= level {
            code = code + 1
        }
        if v1 >= level {
            code = code + 2
        }
        if v2 >= level {
            code = code + 4
        }
        if v3 >= level {
            code = code + 8
        }
        return code
    }

    /// Crossing point on edge `edge` (0 bottom, 1 right, 2 top, 3 left),
    /// linearly interpolated to where the corner values straddle `level`.
    func edge_xy(edge int, level float) (float, float) {
        if edge == 0 {
            let t = frac(v0, v1, level)
            return (x0 + t * (x1 - x0), y0)
        }
        if edge == 1 {
            let t = frac(v1, v2, level)
            return (x1, y0 + t * (y1 - y0))
        }
        if edge == 2 {
            let t = frac(v2, v3, level)
            return (x1 + t * (x0 - x1), y1)
        }
        let t = frac(v3, v0, level)
        return (x0, y1 + t * (y0 - y1))
    }
}

/// Interpolation fraction where `level` falls between corner values a, b.
/// A crossed edge always straddles the level (a != b); the zero-denominator
/// guard only covers degenerate float equality.
func frac(a float, b float, level float) float {
    let d = b - a
    if d == 0.0 {
        return 0.5
    }
    return (level - a) / d
}

/// Append the segment joining edges `ea` and `eb` of `cell` at `level`.
func add_seg(cl ContourLevel, ea int, eb int, cell Cell, level float) {
    let (ax, ay) = cell.edge_xy(ea, level)
    let (bx, by) = cell.edge_xy(eb, level)
    cl.segments.append(Segment(ax, ay, bx, by))
}

/// Extract contour segments for each level in `levels` from grid `Z` with
/// coordinate axes `xs` (length = cols) and `ys` (length = rows). Returns
/// one `ContourLevel` per requested level, in order. Panics on a grid with
/// fewer than 2 rows/cols, a non-rectangular grid, or axis length mismatch.
pub func marching_squares(Z list[list[float]], xs list[float], ys list[float],
                          levels list[float]) list[ContourLevel] {
    let rows = Z.len()
    if rows < 2 {
        panic("plot.contour: Z needs at least 2 rows")
    }
    let cols = Z[0].len()
    if cols < 2 {
        panic("plot.contour: Z needs at least 2 cols")
    }
    if xs.len() != cols {
        panic("plot.contour: xs length must match Z columns")
    }
    if ys.len() != rows {
        panic("plot.contour: ys length must match Z rows")
    }
    for row in Z {
        if row.len() != cols {
            panic("plot.contour: Z must be rectangular")
        }
    }

    let result = list[ContourLevel]()
    for level in levels {
        result.append(ContourLevel(level))
    }

    var r = 0
    while r < rows - 1 {
        var c = 0
        while c < cols - 1 {
            let cell = Cell(Z[r][c], Z[r][c + 1], Z[r + 1][c + 1], Z[r + 1][c],
                            xs[c], xs[c + 1], ys[r], ys[r + 1])
            var li = 0
            while li < levels.len() {
                let level = levels[li]
                let cl = result[li]
                let code = cell.code_at(level)
                if code == 1 || code == 14 {
                    add_seg(cl, 3, 0, cell, level)
                } else if code == 2 || code == 13 {
                    add_seg(cl, 0, 1, cell, level)
                } else if code == 3 || code == 12 {
                    add_seg(cl, 3, 1, cell, level)
                } else if code == 4 || code == 11 {
                    add_seg(cl, 1, 2, cell, level)
                } else if code == 6 || code == 9 {
                    add_seg(cl, 0, 2, cell, level)
                } else if code == 7 || code == 8 {
                    add_seg(cl, 3, 2, cell, level)
                } else if code == 5 {
                    let center = (cell.v0 + cell.v1 + cell.v2 + cell.v3) / 4.0
                    if center >= level {
                        add_seg(cl, 0, 1, cell, level)
                        add_seg(cl, 2, 3, cell, level)
                    } else {
                        add_seg(cl, 3, 0, cell, level)
                        add_seg(cl, 1, 2, cell, level)
                    }
                } else if code == 10 {
                    let center = (cell.v0 + cell.v1 + cell.v2 + cell.v3) / 4.0
                    if center >= level {
                        add_seg(cl, 3, 0, cell, level)
                        add_seg(cl, 1, 2, cell, level)
                    } else {
                        add_seg(cl, 0, 1, cell, level)
                        add_seg(cl, 2, 3, cell, level)
                    }
                }
                li = li + 1
            }
            c = c + 1
        }
        r = r + 1
    }
    return result
}

/// Choose `n` evenly spaced interior contour levels spanning the min/max of
/// `Z` (the automatic level selection of docs/koala_ml.md §6.3). A constant
/// grid yields a single level at that value. Panics on `n < 1` or empty Z.
pub func auto_levels(Z list[list[float]], n int = 8) list[float] {
    if n < 1 {
        panic("plot.auto_levels: n must be >= 1")
    }
    if Z.len() == 0 || Z[0].len() == 0 {
        panic("plot.auto_levels: Z must be non-empty")
    }
    var lo = Z[0][0]
    var hi = Z[0][0]
    for row in Z {
        for v in row {
            if v < lo {
                lo = v
            }
            if v > hi {
                hi = v
            }
        }
    }
    let levels = list[float]()
    if hi == lo {
        levels.append(lo)
        return levels
    }
    var i = 0
    while i < n {
        levels.append(lo + (float(i) + 1.0) * (hi - lo) / float(n + 1))
        i = i + 1
    }
    return levels
}

/// ---------------------------------------------------------------------------
/// Filled contours (contourf)
/// ---------------------------------------------------------------------------

/// Open-ended sentinels for the below/above `extend` bands; they never
/// straddle real data so no interpolation divides by them.
const NEG_INF = -1.0e300
const POS_INF = 1.0e300

/// Append the polygon described by flat `[x0, y0, x1, y1, ...]` verts to
/// `out`, dropping duplicate points and sorting the vertices by angle around
/// their centroid so the canvas fill rule is order-independent. A clipped
/// triangle yields 3-6 vertices; fewer than 3 means the polygon is empty.
func add_polygon(out list[list[float]], verts list[float]) {
    let ded = list[float]()
    var i = 0
    while i + 1 < verts.len() {
        let x = verts[i]
        let y = verts[i + 1]
        var dup = false
        var j = 0
        while j + 1 < ded.len() {
            if ded[j] == x && ded[j + 1] == y {
                dup = true
                break
            }
            j = j + 2
        }
        if !dup {
            ded.append(x)
            ded.append(y)
        }
        i = i + 2
    }
    let n = ded.len() / 2
    if n < 3 {
        return
    }
    var cx = 0.0
    var cy = 0.0
    var k = 0
    while k < ded.len() {
        cx = cx + ded[k]
        cy = cy + ded[k + 1]
        k = k + 2
    }
    cx = cx / float(n)
    cy = cy / float(n)
    // Insertion sort by angle around the centroid.
    var a = 1
    while a < n {
        var b = a
        while b > 0 {
            let ang1 = math.atan2(ded[2 * b + 1] - cy, ded[2 * b] - cx)
            let ang2 = math.atan2(ded[2 * b - 1] - cy, ded[2 * b - 2] - cx)
            if ang1 >= ang2 {
                break
            }
            let tx = ded[2 * b]
            let ty = ded[2 * b + 1]
            ded[2 * b] = ded[2 * b - 2]
            ded[2 * b + 1] = ded[2 * b - 1]
            ded[2 * b - 2] = tx
            ded[2 * b - 1] = ty
            b = b - 1
        }
        a = a + 1
    }
    out.append(ded)
}

/// Clip triangle (px0,py0,z0), (px1,py1,z1), (px2,py2,z2) against the band
/// `lo <= z <= hi`, appending the result polygon to `out`.
func clip_tri(out list[list[float]],
              p0x float, p0y float, z0 float,
              p1x float, p1y float, z1 float,
              p2x float, p2y float, z2 float,
              lo float, hi float) {
    let verts = list[float]()
    let xs = [p0x, p1x, p2x]
    let ys = [p0y, p1y, p2y]
    let zs = [z0, z1, z2]
    var v = 0
    while v < 3 {
        if zs[v] >= lo && zs[v] <= hi {
            verts.append(xs[v])
            verts.append(ys[v])
        }
        v = v + 1
    }
    // Edge (i, j) straddle intersections for both band boundaries.
    var e = 0
    while e < 3 {
        let j = (e + 1) % 3
        if (zs[e] < lo) != (zs[j] < lo) {
            let t = (lo - zs[e]) / (zs[j] - zs[e])
            verts.append(xs[e] + t * (xs[j] - xs[e]))
            verts.append(ys[e] + t * (ys[j] - ys[e]))
        }
        if (zs[e] < hi) != (zs[j] < hi) {
            let t = (hi - zs[e]) / (zs[j] - zs[e])
            verts.append(xs[e] + t * (xs[j] - xs[e]))
            verts.append(ys[e] + t * (ys[j] - ys[e]))
        }
        e = e + 1
    }
    add_polygon(out, verts)
}

/// Filled-contour paths for `contourf`: each grid cell splits into four
/// triangles meeting at the cell center (like matplotlib's quad refinement),
/// and each triangle is clipped against every level band. Returns one entry
/// per band — ordering matches the artist's band list: an optional below
/// band (`extend` "min"/"both"), one band per `levels[i]..levels[i+1]`
/// interval, then an optional above band (`extend` "max"/"both"). Each band
/// is a list of flat `[x0, y0, x1, y1, ...]` data-space polygons. A
/// constant-Z grid produces no geometry (the artist emits empty bands).
pub func contourf_paths(Z list[list[float]], xax list[float],
                        yax list[float], levels list[float],
                        extend str?) list[list[list[float]]] {
    let bands = list[list[list[float]]]()
    var ext_below = false
    var ext_above = false
    if let e = extend {
        ext_below = e == "min" || e == "both"
        ext_above = e == "max" || e == "both"
    }

    let los = list[float]()
    let his = list[float]()
    if ext_below {
        los.append(NEG_INF)
        his.append(levels[0])
    }
    var bi = 0
    while bi < levels.len() - 1 {
        los.append(levels[bi])
        his.append(levels[bi + 1])
        bi = bi + 1
    }
    if ext_above {
        los.append(levels[levels.len() - 1])
        his.append(POS_INF)
    }

    var b = 0
    while b < los.len() {
        bands.append(list[list[float]]())
        b = b + 1
    }

    let rows = Z.len()
    let cols = Z[0].len()
    var r = 0
    while r < rows - 1 {
        var c = 0
        while c < cols - 1 {
            // Corner z: z00 bottom-left, z01 bottom-right, z10 top-left,
            // z11 top-right; xs[c]/ys[r] are the grid coordinates.
            let z00 = Z[r][c]
            let z01 = Z[r][c + 1]
            let z10 = Z[r + 1][c]
            let z11 = Z[r + 1][c + 1]
            let x0 = xax[c]
            let x1 = xax[c + 1]
            let y0 = yax[r]
            let y1 = yax[r + 1]
            let zmid = (z00 + z01 + z10 + z11) / 4.0
            let xmid = (x0 + x1) / 2.0
            let ymid = (y0 + y1) / 2.0
            var b2 = 0
            while b2 < los.len() {
                let out = bands[b2]
                clip_tri(out, x0, y0, z00, x0, y1, z10, xmid, ymid, zmid,
                         los[b2], his[b2])
                clip_tri(out, x0, y1, z10, x1, y1, z11, xmid, ymid, zmid,
                         los[b2], his[b2])
                clip_tri(out, x1, y1, z11, x1, y0, z01, xmid, ymid, zmid,
                         los[b2], his[b2])
                clip_tri(out, x1, y0, z01, x0, y0, z00, xmid, ymid, zmid,
                         los[b2], his[b2])
                b2 = b2 + 1
            }
            c = c + 1
        }
        r = r + 1
    }
    return bands
}