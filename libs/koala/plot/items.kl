import "koala/json"
import "koala/math"

/// Data artists for the plot spec layer (docs/koala_ml.md §6.2). Each
/// artist holds its data + style as `list` (v1) and resolves itself into
/// pixel geometry through the axes scales at spec time, so the renderer
/// only paints. Classes are final in Koala, so artists are independent
/// classes conforming to the `Artist` trait (the same shape `koala/ui`
/// uses for widgets).
///
/// A builtin `Tensor` entry will be added later without reworking this
/// geometry: the artists already operate on resolved numeric lists.

/// The matplotlib tab10 default color cycle. A function rather than a const
/// because Koala const values must be scalar constant expressions.
pub func color_cycle() list[str] {
    return ["#1f77b4", "#ff7f0e", "#2ca02c", "#d62728",
            "#9467bd", "#8c564b", "#e377c2", "#7f7f7f",
            "#bcbd22", "#17becf"]
}

/// Resolve a matplotlib color spec to something the canvas painter accepts.
/// Single-character codes map to the matplotlib base colors; hex strings
/// and CSS color names pass through unchanged.
pub func resolve_color(c str) str {
    if c == "b" {
        return "#0000ff"
    }
    if c == "g" {
        return "#008000"
    }
    if c == "r" {
        return "#ff0000"
    }
    if c == "c" {
        return "#00bfbf"
    }
    if c == "m" {
        return "#bf00bf"
    }
    if c == "y" {
        return "#bfbf00"
    }
    if c == "k" {
        return "#000000"
    }
    if c == "w" {
        return "#ffffff"
    }
    // mpl CSS base names (probed from matplotlib.colors.to_rgb).
    if c == "blue" {
        return "#0000ff"
    }
    if c == "green" {
        return "#008000"
    }
    if c == "red" {
        return "#ff0000"
    }
    if c == "cyan" {
        return "#00ffff"
    }
    if c == "magenta" {
        return "#ff00ff"
    }
    if c == "yellow" {
        return "#ffff00"
    }
    if c == "black" {
        return "#000000"
    }
    if c == "white" {
        return "#ffffff"
    }
    if c.len() == 2 && c[0] == "C" && "0123456789".index(c[1]) >= 0 {
        let cycle = color_cycle()
        return cycle[c[1].to_int()]
    }
    return c
}

/// Min/max of a non-empty list, or nil when empty. Internal autoscale aid.
func bounds(v list[float]) (float, float)? {
    if v.len() == 0 {
        return nil
    }
    var lo = v[0]
    var hi = v[0]
    for x in v {
        if x < lo {
            lo = x
        }
        if x > hi {
            hi = x
        }
    }
    return (lo, hi)
}

/// The common interface of all data artists. `to_json` resolves the artist
/// into pixel geometry through the axes scales; `xbounds`/`ybounds` feed
/// autoscaling; the legend accessors feed the legend box. `xstickies`/
/// `ystickies` report matplotlib-style sticky edge values: autoscale
/// margins do not push the view past any of them (empty list = no sticky
/// edges).
pub trait Artist {
    func kind() str
    func to_json(sx Scale, sy Scale, plot Rect) json.Object
    func xbounds() (float, float)?
    func ybounds() (float, float)?
    func legend_label() str?
    func legend_color() str?
    func xstickies() list[float]
    func ystickies() list[float]
    /// (vmin, vmax, cmap, default ticks) for a colorbar, nil if the artist
    /// is not color-mappable (matplotlib's mappable protocol).
    func cmap_range() (float, float, str, list[float]?)?
}

/// A polyline (matplotlib `Line2D`), the artist behind `plot`.
pub class Line : Artist {
    pub let xdata list[float]
    pub let ydata list[float]
    pub let label str?
    pub let color str
    pub let linestyle str
    pub let linewidth float
    pub let marker str?
    pub let alpha float

    pub func __init__(xdata list[float], ydata list[float], label str? = nil,
                      color str = "#1f77b4", linestyle str = "-",
                      linewidth float = 1.5, marker str? = nil,
                      alpha float = 1.0) {
        if xdata.len() != ydata.len() {
            panic("plot.Line: x and y must have the same length")
        }
        if alpha < 0.0 || alpha > 1.0 {
            panic("plot.Line: alpha must be in [0, 1]")
        }
        self.xdata = xdata
        self.ydata = ydata
        self.label = label
        self.color = resolve_color(color)
        self.linestyle = linestyle
        self.linewidth = linewidth
        if let m = marker {
            self.marker = resolve_marker_str(m)
        } else {
            self.marker = nil
        }
        self.alpha = alpha
    }

    pub func kind() str = "line"

    pub func xbounds() (float, float)? = bounds(xdata)
    pub func ybounds() (float, float)? = bounds(ydata)
    pub func legend_label() str? = label
    pub func legend_color() str? = color
    func cmap_range() (float, float, str, list[float]?)? { return nil }
    func xstickies() list[float] { return list[float]() }
    func ystickies() list[float] { return list[float]() }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        let pts = json.Array()
        var i = 0
        while i < xdata.len() {
            let p = json.Object()
            p["x"] = json.Float(sx.pixel(xdata[i]))
            p["y"] = json.Float(sy.pixel(ydata[i]))
            pts.append(p)
            i = i + 1
        }
        let o = json.Object()
        o["kind"] = json.String("line")
        o["points"] = pts
        o["color"] = json.String(color)
        o["linestyle"] = json.String(linestyle)
        o["linewidth"] = json.Float(linewidth)
        o["alpha"] = json.Float(alpha)
        if let m = marker {
            o["marker"] = json.String(m)
        }
        if let l = label {
            o["label"] = json.String(l)
        }
        return o
    }
}

/// A point cloud (matplotlib `PathCollection`), the artist behind `scatter`.
/// v1 takes a single color per call; the two-class decision-boundary
/// scenario uses two scatter calls with different colors.
pub class Scatter : Artist {
    pub let xdata list[float]
    pub let ydata list[float]
    pub let label str?
    pub let color str
    pub let marker str?
    pub let size float
    pub let alpha float
    pub let colors list[str]?
    pub let cmap str
    pub let cvmin float?
    pub let cvmax float?

    pub func __init__(xdata list[float], ydata list[float], label str? = nil,
                      color str? = nil, marker str? = "o",
                      size float = 36.0, alpha float = 1.0,
                      cvals list[float]? = nil, cmap str = "viridis",
                      vmin float? = nil, vmax float? = nil) {
        if xdata.len() != ydata.len() {
            panic("plot.Scatter: x and y must have the same length")
        }
        if alpha < 0.0 || alpha > 1.0 {
            panic("plot.Scatter: alpha must be in [0, 1]")
        }
        if cvals != nil && color != nil {
            panic("plot.Scatter: 'c' and 'cvals' are mutually exclusive")
        }
        self.xdata = xdata
        self.ydata = ydata
        self.label = label
        if let m = marker {
            self.marker = resolve_marker_str(m)
        } else {
            self.marker = nil
        }
        self.size = size
        self.alpha = alpha
        self.cmap = cmap
        if let cs = cvals {
            if cs.len() != xdata.len() {
                panic("plot.Scatter: cvals must match x length")
            }
            // Explicit vmin/vmax override the data bounds; a missing side
            // falls back to the data bound (matplotlib Normalize).
            var lo = vmin
            var hi = vmax
            if lo == nil || hi == nil {
                if let b = bounds(cs) {
                    let (dlo, dhi) = b
                    if lo == nil {
                        lo = dlo
                    }
                    if hi == nil {
                        hi = dhi
                    }
                }
            }
            if let a = lo {
                if let b2 = hi {
                    let cols = list[str]()
                    for t in normalize_range(cs, a, b2) {
                        let (r, g, b) = colormap(cmap, t)
                        cols.append(rgb_hex(r, g, b))
                    }
                    self.colors = cols
                    self.cvmin = a
                    self.cvmax = b2
                } else {
                    self.colors = nil
                    self.cvmin = nil
                    self.cvmax = nil
                }
            } else {
                self.colors = nil
                self.cvmin = nil
                self.cvmax = nil
            }
            // The legend patch shows the cmap midpoint, like matplotlib.
            let (mr, mg, mb) = colormap(cmap, 0.5)
            self.color = rgb_hex(mr, mg, mb)
        } else {
            // vmin/vmax without numeric `cvals` are ignored, like
            // matplotlib (which warns "No data for colormapping").
            self.colors = nil
            self.cvmin = nil
            self.cvmax = nil
            self.color = resolve_color(color ?? "#1f77b4")
        }
    }

    pub func kind() str = "scatter"

    pub func xbounds() (float, float)? = bounds(xdata)
    pub func ybounds() (float, float)? = bounds(ydata)
    pub func legend_label() str? = label
    pub func legend_color() str? = color
    func cmap_range() (float, float, str, list[float]?)? {
        if let lo = cvmin {
            if let hi = cvmax {
                return (lo, hi, cmap, nil)
            }
        }
        return nil
    }
    func xstickies() list[float] { return list[float]() }
    func ystickies() list[float] { return list[float]() }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        let pts = json.Array()
        var i = 0
        while i < xdata.len() {
            let p = json.Object()
            p["x"] = json.Float(sx.pixel(xdata[i]))
            p["y"] = json.Float(sy.pixel(ydata[i]))
            pts.append(p)
            i = i + 1
        }
        let o = json.Object()
        o["kind"] = json.String("scatter")
        o["points"] = pts
        o["color"] = json.String(color)
        if let cols = colors {
            let arr = json.Array()
            for c in cols {
                arr.append(json.String(c))
            }
            o["colors"] = arr
        }
        if let m = marker {
            o["marker"] = json.String(m)
        }
        o["size"] = json.Float(size)
        o["alpha"] = json.Float(alpha)
        if let l = label {
            o["label"] = json.String(l)
        }
        return o
    }
}

/// A bar series (matplotlib `Axes.bar` / `barh`). Vertical bars are stored
/// as `(xs, heights)` with `bottom` as the baseline; horizontal bars are
/// `(ys, widths)` with `left` as the baseline — the same class holds both,
/// distinguished by `horizontal`. `align` places `xs`/`ys` at the bar
/// center (default) or its leading edge. `bottom`/`left` accept a scalar,
/// a single-element sequence (broadcast), or a per-bar sequence, like
/// matplotlib/numpy broadcasting.
pub class Bar : Artist {
    pub let vals list[float]
    pub let sizes list[float]
    pub let horizontal bool
    pub let thickness float
    pub let baselines list[float]
    pub let align str
    pub let label str?
    pub let color str
    pub let edgecolor str?
    pub let linewidth float
    pub let alpha float

    pub func __init__(vals list[float], sizes list[float],
                      horizontal bool, thickness float = 0.8,
                      baseline float | list[float] = 0.0,
                      align str = "center",
                      label str? = nil, color str? = nil,
                      edgecolor str? = nil, linewidth float = 1.0,
                      alpha float = 1.0) {
        if vals.len() != sizes.len() {
            panic("plot.Bar: coordinates and sizes must have the same length")
        }
        if align != "center" && align != "edge" {
            panic("plot.Bar: align must be 'center' or 'edge'")
        }
        if alpha < 0.0 || alpha > 1.0 {
            panic("plot.Bar: alpha must be in [0, 1]")
        }
        let bas = list[float]()
        switch baseline {
            case is float64: {
                // Scalar baseline broadcasts to every bar.
                var i = 0
                while i < vals.len() {
                    bas.append(baseline)
                    i = i + 1
                }
            }
            case is list[float]: {
                // Single-element baseline broadcasts, like numpy
                // broadcasting in matplotlib.
                if baseline.len() == 1 {
                    var i = 0
                    while i < vals.len() {
                        bas.append(baseline[0])
                        i = i + 1
                    }
                } else if baseline.len() == vals.len() {
                    for v in baseline {
                        bas.append(v)
                    }
                } else {
                    panic("plot.Bar: baseline must be scalar or match the bar count")
                }
            }
        }
        self.vals = vals
        self.sizes = sizes
        self.horizontal = horizontal
        self.thickness = thickness
        self.baselines = bas
        self.align = align
        self.label = label
        self.color = resolve_color(color ?? "#1f77b4")
        if let ec = edgecolor {
            self.edgecolor = resolve_color(ec)
        } else {
            self.edgecolor = nil
        }
        self.linewidth = linewidth
        self.alpha = alpha
    }

    pub func kind() str = "bar"

    // Along the value axis the baseline is part of the data range, like
    // matplotlib (bars always include the baseline).
    pub func xbounds() (float, float)? {
        if horizontal {
            return val_extent()
        }
        let r = bounds(vals) else { return nil }
        let (vlo, vhi) = r
        let half = thickness / 2.0
        if align == "edge" {
            return (vlo, vhi + thickness)
        }
        return (vlo - half, vhi + half)
    }

    pub func ybounds() (float, float)? {
        if horizontal {
            let r = bounds(vals) else { return nil }
            let (vlo, vhi) = r
            let half = thickness / 2.0
            if align == "edge" {
                return (vlo, vhi + thickness)
            }
            return (vlo - half, vhi + half)
        }
        return val_extent()
    }

    // Value-axis data extent: min/max over each bar's baseline and
    // baseline+size (sizes may be negative).
    func val_extent() (float, float)? {
        if baselines.len() == 0 {
            return nil
        }
        let b0 = baselines[0]
        var lo = b0
        var hi = b0 + sizes[0]
        var i = 1
        while i < baselines.len() {
            let b = baselines[i]
            let t = b + sizes[i]
            if b < lo {
                lo = b
            }
            if t < lo {
                lo = t
            }
            if b > hi {
                hi = b
            }
            if t > hi {
                hi = t
            }
            i = i + 1
        }
        return (lo, hi)
    }

    pub func legend_label() str? = label
    pub func legend_color() str? = color
    func cmap_range() (float, float, str, list[float]?)? { return nil }

    // The baselines are sticky like matplotlib bar: autoscale margins do
    // not push the view past any of them.
    func xstickies() list[float] {
        if horizontal {
            return baselines
        }
        return list[float]()
    }

    func ystickies() list[float] {
        if !horizontal {
            return baselines
        }
        return list[float]()
    }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        let rects = json.Array()
        var i = 0
        while i < vals.len() {
            let r = json.Object()
            if horizontal {
                let half = thickness / 2.0
                let y = vals[i]
                var y0 = y - half
                if align == "edge" {
                    y0 = y
                }
                r["x0"] = json.Float(sx.pixel(baselines[i]))
                r["y0"] = json.Float(sy.pixel(y0))
                r["x1"] = json.Float(sx.pixel(baselines[i] + sizes[i]))
                r["y1"] = json.Float(sy.pixel(y0 + thickness))
            } else {
                let half = thickness / 2.0
                let x = vals[i]
                var x0 = x - half
                if align == "edge" {
                    x0 = x
                }
                r["x0"] = json.Float(sx.pixel(x0))
                r["y0"] = json.Float(sy.pixel(baselines[i]))
                r["x1"] = json.Float(sx.pixel(x0 + thickness))
                r["y1"] = json.Float(sy.pixel(baselines[i] + sizes[i]))
            }
            rects.append(r)
            i = i + 1
        }
        let o = json.Object()
        o["kind"] = json.String("bar")
        o["rects"] = rects
        o["color"] = json.String(color)
        if let ec = edgecolor {
            o["edgecolor"] = json.String(ec)
        }
        o["linewidth"] = json.Float(linewidth)
        o["alpha"] = json.Float(alpha)
        if let l = label {
            o["label"] = json.String(l)
        }
        return o
    }
}

/// Format an 0..255 RGB triple as a `#rrggbb` hex string.
pub func rgb_hex(r int, g int, b int) str {
    return format("#{:02x}{:02x}{:02x}", r, g, b)
}

/// Contour lines (matplotlib `ContourSet`), the artist behind `contour`.
/// Marching squares runs Koala-side at construction; the spec carries the
/// resolved pixel segments per level. `xs`/`ys` default to index ranges.
pub class Contour : Artist {
    pub let levels list[ContourLevel]
    pub let colors list[str]
    pub let xlo float
    pub let xhi float
    pub let ylo float
    pub let yhi float
    pub let alpha float
    pub let cmap str

    pub func __init__(Z list[list[float]], xs list[float]?, ys list[float]?,
                      levels list[float]?, cmap str, alpha float = 1.0) {
        let rows = Z.len()
        if rows < 2 {
            panic("plot.contour: Z needs at least 2 rows")
        }
        if alpha < 0.0 || alpha > 1.0 {
            panic("plot.Contour: alpha must be in [0, 1]")
        }
        self.alpha = alpha
        let cols = Z[0].len()
        var xax = list[float]()
        var yax = list[float]()
        if let x = xs {
            xax = x
        } else {
            var i = 0
            while i < cols {
                xax.append(float(i))
                i = i + 1
            }
        }
        if let y = ys {
            yax = y
        } else {
            var i = 0
            while i < rows {
                yax.append(float(i))
                i = i + 1
            }
        }
        var lv = list[float]()
        if let l = levels {
            lv = l
        } else {
            lv = auto_levels(Z)
        }
        self.levels = marching_squares(Z, xax, yax, lv)
        let n = self.levels.len()
        let cols2 = list[str]()
        var i = 0
        while i < n {
            var t = 0.5
            if n > 1 {
                t = float(i) / float(n - 1)
            }
            let (r, g, b) = colormap(cmap, t)
            cols2.append(rgb_hex(r, g, b))
            i = i + 1
        }
        self.colors = cols2
        self.cmap = cmap
        xlo = xax[0]
        xhi = xax[xax.len() - 1]
        ylo = yax[0]
        yhi = yax[yax.len() - 1]
    }

    pub func kind() str = "contour"
    pub func xbounds() (float, float)? = (xlo, xhi)
    pub func ybounds() (float, float)? = (ylo, yhi)
    pub func legend_label() str? = nil
    pub func legend_color() str? = nil
    func cmap_range() (float, float, str, list[float]?)? {
        // The colorbar spans the requested levels with the levels as its
        // ticks (matplotlib's FixedLocator for ContourSet mappables).
        if levels.len() >= 2 {
            let lv = list[float]()
            for cl in levels {
                lv.append(cl.level)
            }
            return (levels[0].level, levels[levels.len() - 1].level, cmap,
                    lv)
        }
        return nil
    }
    func xstickies() list[float] { return list[float]() }
    func ystickies() list[float] { return list[float]() }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        let arr = json.Array()
        var i = 0
        while i < levels.len() {
            let cl = levels[i]
            let segs = json.Array()
            for s in cl.segments {
                let so = json.Object()
                so["x0"] = json.Float(sx.pixel(s.x0))
                so["y0"] = json.Float(sy.pixel(s.y0))
                so["x1"] = json.Float(sx.pixel(s.x1))
                so["y1"] = json.Float(sy.pixel(s.y1))
                segs.append(so)
            }
            let lo = json.Object()
            lo["level"] = json.Float(cl.level)
            lo["color"] = json.String(colors[i])
            lo["segments"] = segs
            arr.append(lo)
            i = i + 1
        }
        let o = json.Object()
        o["kind"] = json.String("contour")
        o["levels"] = arr
        o["alpha"] = json.Float(alpha)
        return o
    }
}

/// A raster image (matplotlib `AxesImage`), the artist behind `imshow`.
/// The RGB grid is resolved Koala-side via the colormap; the renderer fills
/// it into the data-area rectangle (origin upper: row 0 at top).
pub class Image : Artist {
    pub let rows int
    pub let cols int
    pub let pixels list[str]
    pub let cmap str
    pub let alpha float
    pub let vmin float
    pub let vmax float

    pub func __init__(Z list[list[float]], cmap str, alpha float = 1.0) {
        if Z.len() == 0 || Z[0].len() == 0 {
            panic("plot.imshow: Z must be non-empty")
        }
        if alpha < 0.0 || alpha > 1.0 {
            panic("plot.Image: alpha must be in [0, 1]")
        }
        self.alpha = alpha
        rows = Z.len()
        cols = Z[0].len()
        var lo = Z[0][0]
        var hi = Z[0][0]
        for row in Z {
            if row.len() != cols {
                panic("plot.imshow: Z must be rectangular")
            }
            for v in row {
                if v < lo {
                    lo = v
                }
                if v > hi {
                    hi = v
                }
            }
        }
        self.vmin = lo
        self.vmax = hi
        let span = hi - lo
        pixels = list[str]()
        for row in Z {
            for v in row {
                var t = 0.5
                if span != 0.0 {
                    t = (v - lo) / span
                }
                let (r, g, b) = colormap(cmap, t)
                pixels.append(rgb_hex(r, g, b))
            }
        }
        self.cmap = cmap
    }

    pub func kind() str = "image"
    pub func xbounds() (float, float)? = (-0.5, float(cols) - 0.5)
    pub func ybounds() (float, float)? = (float(rows) - 0.5, -0.5)
    pub func legend_label() str? = nil
    pub func legend_color() str? = nil
    func cmap_range() (float, float, str, list[float]?)? {
        return (vmin, vmax, cmap, nil)
    }
    func xstickies() list[float] { return list[float]() }
    func ystickies() list[float] { return list[float]() }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        let o = json.Object()
        o["kind"] = json.String("image")
        o["rect"] = rect_json(plot)
        o["rows"] = json.Integer(rows)
        o["cols"] = json.Integer(cols)
        o["cmap"] = json.String(cmap)
        o["alpha"] = json.Float(alpha)
        let px = json.Array()
        for c in pixels {
            px.append(json.String(c))
        }
        o["pixels"] = px
        return o
    }
}

/// Histogram bars (matplotlib `BarContainer`), the artist behind `hist`.
/// Counts and edges are resolved Koala-side; bars become pixel rectangles.
pub class Hist : Artist {
    pub let counts list[float]
    pub let edges list[float]
    pub let color str
    pub let label str?
    pub let alpha float

    pub func __init__(counts list[float], edges list[float], color str,
                      label str?, alpha float = 1.0) {
        if alpha < 0.0 || alpha > 1.0 {
            panic("plot.Hist: alpha must be in [0, 1]")
        }
        self.counts = counts
        self.edges = edges
        self.color = resolve_color(color)
        self.label = label
        self.alpha = alpha
    }

    pub func kind() str = "hist"
    pub func xbounds() (float, float)? = (edges[0], edges[edges.len() - 1])

    pub func ybounds() (float, float)? {
        var mx = 0.0
        var mn = 0.0
        for c in counts {
            if math.isnan(c) || math.isinf(c) {
                continue
            }
            if c > mx {
                mx = c
            }
            if c < mn {
                mn = c
            }
        }
        if mx == 0.0 && mn == 0.0 {
            return (0.0, 1.0)
        }
        return (mn, mx)
    }

    pub func legend_label() str? = label
    pub func legend_color() str? = color
    func cmap_range() (float, float, str, list[float]?)? { return nil }
    func xstickies() list[float] { return list[float]() }
    func ystickies() list[float] { return list[float]() }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        let bars = json.Array()
        let base = sy.pixel(0.0)
        var i = 0
        while i < counts.len() {
            let c = counts[i]
            // Non-finite counts (NaN from zero-total density, or inf from
            // zero-total with cancelling weights) draw nothing, like mpl.
            if math.isnan(c) || math.isinf(c) {
                i = i + 1
                continue
            }
            let x0 = sx.pixel(edges[i])
            let x1 = sx.pixel(edges[i + 1])
            let yc = sy.pixel(c)
            let b = json.Object()
            b["x"] = json.Float(x0)
            b["w"] = json.Float(x1 - x0)
            if c >= 0.0 {
                b["y"] = json.Float(yc)
                b["h"] = json.Float(base - yc)
            } else {
                b["y"] = json.Float(base)
                b["h"] = json.Float(yc - base)
            }
            bars.append(b)
            i = i + 1
        }
        let o = json.Object()
        o["kind"] = json.String("hist")
        o["bars"] = bars
        o["color"] = json.String(color)
        o["alpha"] = json.Float(alpha)
        if let l = label {
            o["label"] = json.String(l)
        }
        return o
    }
}
/// Format one slice's autopct text. v1 supports matplotlib's common
/// "%d%%" and "%[width].[precision]f%%" format strings (callables are
/// deferred); anything else panics.
func autopct_text(fmt str, v float) str {
    if fmt.index("%") != 0 {
        panic("plot.Axes.pie: unsupported autopct format '" + fmt + "'")
    }
    let f = fmt.index("f")
    if f > 0 {
        if fmt.substr(f + 1) != "%%" {
            panic("plot.Axes.pie: unsupported autopct format '" + fmt + "'")
        }
        let body = fmt.substr(1, f)
        let dot = body.index(".")
        if dot < 0 {
            panic("plot.Axes.pie: unsupported autopct format '" + fmt + "'")
        }
        let prec = body.substr(dot + 1)
        return format("{:." + prec + "f}", v) + "%"
    }
    if fmt == "%d%%" {
        return format("{:d}", int(v)) + "%"
    }
    panic("plot.Axes.pie: unsupported autopct format '" + fmt + "'")
}

/// A pie chart (matplotlib `Axes.pie`), one wedge per slice. Wedge angles
/// follow matplotlib's convention: degrees counterclockwise from +x, or
/// clockwise when `counterclock` is false. `center_x`/`center_y` spell
/// matplotlib's `center=(cx, cy)` (Koala has no tuple default arguments).
///
/// Geometry resolves against a square sub-frame of the plot rect (equal
/// aspect), the same effect matplotlib's `set_aspect('equal')` produces,
/// so wedges stay circular whatever the axes box shape.
/// Text properties for pie autopct labels (matplotlib's `textprops` dict,
/// statically typed): color, fontsize, fontweight, fontstyle, family,
/// alpha, rotation. nil fields keep matplotlib's Text defaults (black,
/// 10pt, normal, normal, sans-serif, opaque, upright).
pub class TextProps {
    pub let color str?
    pub let fontsize float?
    pub let fontweight str?
    pub let fontstyle str?
    pub let family str?
    pub let alpha float?
    pub let rotation float?

    pub func __init__(color str? = nil, fontsize float? = nil,
                      fontweight str? = nil, fontstyle str? = nil,
                      family str? = nil, alpha float? = nil,
                      rotation float? = nil) {
        if let fs = fontsize {
            if fs <= 0.0 {
                panic("plot.TextProps: 'fontsize' must be a positive number")
            }
        }
        if let a = alpha {
            if a < 0.0 || a > 1.0 {
                panic("plot.TextProps: 'alpha' must be in [0, 1]")
            }
        }
        self.color = color
        self.fontsize = fontsize
        self.fontweight = fontweight
        self.fontstyle = fontstyle
        self.family = family
        self.alpha = alpha
        self.rotation = rotation
    }
}

pub class Pie : Artist {
    pub let fracs list[float]
    pub let explode list[float]
    pub let labels list[str]
    pub let colors list[str]
    pub let autotexts list[str]
    pub let autopct_on bool
    pub let pctdistance float
    pub let labeldistance float
    pub let startangle float
    pub let radius float
    pub let counterclock bool
    pub let center_x float
    pub let center_y float
    pub let edgecolor str?
    pub let linewidth float
    pub let width float?
    pub let textprops TextProps?
    pub let alpha float

    pub func __init__(fracs list[float], explode list[float],
                      labels list[str], colors list[str],
                      autotexts list[str], autopct_on bool,
                      pctdistance float, labeldistance float,
                      startangle float, radius float, counterclock bool,
                      center_x float, center_y float, edgecolor str?,
                      linewidth float, width float?, textprops TextProps?,
                      alpha float) {
        self.fracs = fracs
        self.explode = explode
        self.labels = labels
        self.colors = colors
        self.autotexts = autotexts
        self.autopct_on = autopct_on
        self.pctdistance = pctdistance
        self.labeldistance = labeldistance
        self.startangle = startangle
        self.radius = radius
        self.counterclock = counterclock
        self.center_x = center_x
        self.center_y = center_y
        self.edgecolor = edgecolor
        self.linewidth = linewidth
        self.width = width
        self.textprops = textprops
        self.alpha = alpha
    }

    pub func kind() str = "pie"
    pub func legend_label() str? = nil
    pub func legend_color() str? = nil
    func cmap_range() (float, float, str, list[float]?)? { return nil }
    func xstickies() list[float] { return list[float]() }
    func ystickies() list[float] { return list[float]() }
    func xbounds() (float, float)? { return nil }
    func ybounds() (float, float)? { return nil }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        // Equal-aspect square sub-frame: `unit` px per data unit, center
        // of the plot rect, y flipped (data y grows upward).
        var side = plot.w
        if plot.h < side {
            side = plot.h
        }
        let unit = side / 2.5
        let cx = plot.center_x()
        let cy = plot.center_y()

        let wedges = json.Array()
        let labs = json.Array()
        let autos = json.Array()
        var theta1 = startangle / 360.0
        var i = 0
        while i < fracs.len() {
            let frac = fracs[i]
            var theta2 = theta1 + frac
            if !counterclock {
                theta2 = theta1 - frac
            }
            // mid angle in radians (2π * 0.5 * (t1 + t2), t in circle
            // fractions), like matplotlib.
            let mid = math.PI * (theta1 + theta2)
            let dx = explode[i] * math.cos(mid)
            let dy = explode[i] * math.sin(mid)
            let wcx = center_x + dx
            let wcy = center_y + dy
            var a0 = 360.0 * theta1
            var a1 = 360.0 * theta2
            if a0 > a1 {
                let t = a0
                a0 = a1
                a1 = t
            }
            let w = json.Object()
            w["cx"] = json.Float(cx + wcx * unit)
            w["cy"] = json.Float(cy - wcy * unit)
            w["r"] = json.Float(radius * unit)
            w["a0"] = json.Float(a0)
            w["a1"] = json.Float(a1)
            w["color"] = json.String(colors[i % colors.len()])
            if let ec = edgecolor {
                w["edgecolor"] = json.String(ec)
            }
            w["linewidth"] = json.Float(linewidth)
            if let wd = width {
                w["width"] = json.Float(wd)
            }
            wedges.append(w)

            // Labels sit at labeldistance along the bisector from the
            // (exploded) wedge center; horizontal alignment follows the
            // x sign, like matplotlib's 'outer' alignment.
            let lx = wcx + labeldistance * radius * math.cos(mid)
            let ly = wcy + labeldistance * radius * math.sin(mid)
            if labels[i] != "" {
                let t = json.Object()
                t["text"] = json.String(labels[i])
                t["x"] = json.Float(cx + lx * unit)
                t["y"] = json.Float(cy - ly * unit)
                if lx > 0.0 {
                    t["ha"] = json.String("left")
                } else {
                    t["ha"] = json.String("right")
                }
                labs.append(t)
            }
            // Autopct texts at pctdistance, center-aligned.
            if autopct_on {
                let px = wcx + pctdistance * radius * math.cos(mid)
                let py = wcy + pctdistance * radius * math.sin(mid)
                let t = json.Object()
                t["text"] = json.String(autotexts[i])
                t["x"] = json.Float(cx + px * unit)
                t["y"] = json.Float(cy - py * unit)
                autos.append(t)
            }
            theta1 = theta2
            i = i + 1
        }
        let o = json.Object()
        o["kind"] = json.String("pie")
        o["wedges"] = wedges
        o["labels"] = labs
        o["autotexts"] = autos
        o["alpha"] = json.Float(alpha)
        if let tp = textprops {
            let p = json.Object()
            if let c = tp.color {
                p["color"] = json.String(resolve_color(c))
            }
            if let f = tp.fontsize {
                p["fontsize"] = json.Float(f)
            }
            if let w = tp.fontweight {
                p["fontweight"] = json.String(w)
            }
            if let s = tp.fontstyle {
                p["fontstyle"] = json.String(s)
            }
            if let fam = tp.family {
                p["family"] = json.String(fam)
            }
            if let al = tp.alpha {
                p["alpha"] = json.Float(al)
            }
            if let rot = tp.rotation {
                p["rotation"] = json.Float(rot)
            }
            o["textprops"] = p
        }
        return o
    }
}

/// An errorbar series (matplotlib `Axes.errorbar`): a data line/marker set
/// plus vertical (`yerr`) and horizontal (`xerr`) error bars with optional
/// end caps. Errors are per-point lists (`ylower`/`yupper` are the two
/// half-lengths; symmetric input just duplicates the value). A NaN error
/// skips that point's bars (like matplotlib). `ylims`/`xlims` are per-point
/// one-sided masks (bit0 = lolims/xlolims, bit1 = uplims/xuplims; 0 for a
/// two-sided bar): the arrow points away from the data value and only the
/// bar tip takes part in autoscaling. `caplen_px` is the full cap length in
/// pixels (matplotlib's `2 * capsize` points); `caretsize_px` is the arrow
/// head size (same as `caplen_px` when caps are on, else 6 pt).
pub class Errorbar : Artist {
    pub let xdata list[float]
    pub let ydata list[float]
    pub let ylower list[float]
    pub let yupper list[float]
    pub let xlower list[float]
    pub let xupper list[float]
    pub let ylims list[int]
    pub let xlims list[int]
    pub let linestyle str
    pub let marker str?
    pub let linewidth float
    pub let color str
    pub let label str?
    pub let ecolor str
    pub let elinewidth float
    pub let caplen_px float
    pub let capthick float
    pub let errorevery int
    pub let barsabove bool
    pub let caretsize_px float
    pub let alpha float

    pub func __init__(xdata list[float], ydata list[float],
                      ylower list[float], yupper list[float],
                      xlower list[float], xupper list[float],
                      ylims list[int], xlims list[int],
                      linestyle str, marker str?, linewidth float,
                      color str, label str?, ecolor str?, elinewidth float,
                      caplen_px float, capthick float, errorevery int,
                      barsabove bool, caretsize_px float, alpha float) {
        self.xdata = xdata
        self.ydata = ydata
        self.ylower = ylower
        self.yupper = yupper
        self.xlower = xlower
        self.xupper = xupper
        self.ylims = ylims
        self.xlims = xlims
        self.linestyle = linestyle
        if let m = marker {
            self.marker = resolve_marker_str(m)
        } else {
            self.marker = nil
        }
        self.linewidth = linewidth
        self.color = resolve_color(color)
        self.label = label
        if let ec = ecolor {
            self.ecolor = resolve_color(ec)
        } else {
            self.ecolor = resolve_color(color)
        }
        self.elinewidth = elinewidth
        self.caplen_px = caplen_px
        self.capthick = capthick
        self.errorevery = errorevery
        self.barsabove = barsabove
        self.caretsize_px = caretsize_px
        self.alpha = alpha
    }

    pub func kind() str = "errorbar"
    pub func legend_label() str? = label
    pub func legend_color() str? = color
    func cmap_range() (float, float, str, list[float]?)? { return nil }
    func xstickies() list[float] { return list[float]() }
    func ystickies() list[float] { return list[float]() }

    // Error extents take part in autoscaling; NaN errors drop the point
    // from the range (matplotlib skips those bars entirely). An empty
    // error list means no errors in that dimension. A one-sided bar
    // (lolims/xlolims bit0, uplims/xuplims bit1) extends the range only
    // toward its arrow tip, not the data end.
    pub func xbounds() (float, float)? {
        var lo = 0.0
        var hi = 0.0
        var found = false
        var i = 0
        while i < xdata.len() {
            var a = xdata[i]
            var b = xdata[i]
            if xlower.len() > 0 {
                let e0 = xlower[i]
                let e1 = xupper[i]
                if !math.isnan(e0) && !math.isnan(e1) {
                    let lim = xlims[i]
                    if lim != 1 {
                        a = xdata[i] - e0
                    }
                    if lim != 2 {
                        b = xdata[i] + e1
                    }
                }
            }
            if !found {
                lo = a
                hi = b
                found = true
            } else {
                if a < lo {
                    lo = a
                }
                if b > hi {
                    hi = b
                }
            }
            i = i + 1
        }
        if !found {
            return nil
        }
        return (lo, hi)
    }

    pub func ybounds() (float, float)? {
        var lo = 0.0
        var hi = 0.0
        var found = false
        var i = 0
        while i < ydata.len() {
            var a = ydata[i]
            var b = ydata[i]
            if ylower.len() > 0 {
                let e0 = ylower[i]
                let e1 = yupper[i]
                if !math.isnan(e0) && !math.isnan(e1) {
                    let lim = ylims[i]
                    if lim != 1 {
                        a = ydata[i] - e0
                    }
                    if lim != 2 {
                        b = ydata[i] + e1
                    }
                }
            }
            if !found {
                lo = a
                hi = b
                found = true
            } else {
                if a < lo {
                    lo = a
                }
                if b > hi {
                    hi = b
                }
            }
            i = i + 1
        }
        if !found {
            return nil
        }
        return (lo, hi)
    }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        let pts = json.Array()
        let yerrs = json.Array()
        let xerrs = json.Array()
        let ycaps = json.Array()
        let xcaps = json.Array()
        var i = 0
        while i < xdata.len() {
            let px = sx.pixel(xdata[i])
            let py = sy.pixel(ydata[i])
            // The data line/markers are omitted for fmt "none".
            if linestyle != "" || marker != nil {
                let p = json.Object()
                p["x"] = json.Float(px)
                p["y"] = json.Float(py)
                pts.append(p)
            }
            // Error bars are drawn every `errorevery` points. A one-sided
            // bar (lim bit0 = lolims, bit1 = uplims) starts at the data
            // value; its cap sits at the data end only, the arrow head at
            // the other end (both for lim 3, the degenerate bar).
            if i % errorevery == 0 {
                var ylo = 0.0
                var yhi = 0.0
                var ylim = 0
                var has_y = false
                if ylower.len() > 0 {
                    let e0 = ylower[i]
                    let e1 = yupper[i]
                    if !math.isnan(e0) && !math.isnan(e1) {
                        has_y = true
                        ylim = ylims[i]
                        ylo = ydata[i] - e0
                        yhi = ydata[i] + e1
                        if ylim == 1 || ylim == 3 {
                            ylo = ydata[i]
                        }
                        if ylim == 2 || ylim == 3 {
                            yhi = ydata[i]
                        }
                    }
                }
                if has_y {
                    let s = json.Object()
                    s["x"] = json.Float(px)
                    s["y0"] = json.Float(sy.pixel(ylo))
                    s["y1"] = json.Float(sy.pixel(yhi))
                    if ylim != 0 {
                        s["lim"] = json.Integer(ylim)
                    }
                    yerrs.append(s)
                    if caplen_px > 0.0 {
                        if ylim != 2 {
                            let lo = json.Object()
                            lo["x"] = json.Float(px)
                            lo["y"] = json.Float(sy.pixel(ylo))
                            ycaps.append(lo)
                        }
                        if ylim != 1 {
                            let hi = json.Object()
                            hi["x"] = json.Float(px)
                            hi["y"] = json.Float(sy.pixel(yhi))
                            ycaps.append(hi)
                        }
                    }
                }
                var xlo = 0.0
                var xhi = 0.0
                var xlim = 0
                var has_x = false
                if xlower.len() > 0 {
                    let e0 = xlower[i]
                    let e1 = xupper[i]
                    if !math.isnan(e0) && !math.isnan(e1) {
                        has_x = true
                        xlim = xlims[i]
                        xlo = xdata[i] - e0
                        xhi = xdata[i] + e1
                        if xlim == 1 || xlim == 3 {
                            xlo = xdata[i]
                        }
                        if xlim == 2 || xlim == 3 {
                            xhi = xdata[i]
                        }
                    }
                }
                if has_x {
                    let s = json.Object()
                    s["y"] = json.Float(py)
                    s["x0"] = json.Float(sx.pixel(xlo))
                    s["x1"] = json.Float(sx.pixel(xhi))
                    if xlim != 0 {
                        s["lim"] = json.Integer(xlim)
                    }
                    xerrs.append(s)
                    if caplen_px > 0.0 {
                        if xlim != 2 {
                            let lo = json.Object()
                            lo["x"] = json.Float(sx.pixel(xlo))
                            lo["y"] = json.Float(py)
                            xcaps.append(lo)
                        }
                        if xlim != 1 {
                            let hi = json.Object()
                            hi["x"] = json.Float(sx.pixel(xhi))
                            hi["y"] = json.Float(py)
                            xcaps.append(hi)
                        }
                    }
                }
            }
            i = i + 1
        }
        let o = json.Object()
        o["kind"] = json.String("errorbar")
        o["points"] = pts
        o["linestyle"] = json.String(linestyle)
        if let m = marker {
            o["marker"] = json.String(m)
        }
        o["linewidth"] = json.Float(linewidth)
        o["color"] = json.String(color)
        o["ecolor"] = json.String(ecolor)
        o["elinewidth"] = json.Float(elinewidth)
        o["caplen"] = json.Float(caplen_px)
        o["capthick"] = json.Float(capthick)
        o["yerrs"] = yerrs
        o["xerrs"] = xerrs
        o["ycaps"] = ycaps
        o["xcaps"] = xcaps
        o["caretsize"] = json.Float(caretsize_px)
        o["barsabove"] = json.Boolean(barsabove)
        o["alpha"] = json.Float(alpha)
        if let l = label {
            o["label"] = json.String(l)
        }
        return o
    }
}

/// Boundary of a `fill_between` band for the index run `[i0, i1]`, as flat
/// `[x0, y0, x1, y1, ...]` data-space vertices. `forward` builds the top
/// edge (i0 -> i1); reversed builds the bottom edge (i1 -> i0). `step`
/// stair-steps the boundary like matplotlib ("pre" jumps at x[i], "post"
/// jumps at x[i+1], "mid" at the midpoint).
func band_boundary(x list[float], y list[float], i0 int, i1 int,
                   step str?, forward bool) list[float] {
    let v = list[float]()
    if forward {
        v.append(x[i0])
        v.append(y[i0])
        if let st = step {
            var i = i0
            while i < i1 {
                if st == "pre" {
                    v.append(x[i])
                    v.append(y[i + 1])
                    v.append(x[i + 1])
                    v.append(y[i + 1])
                } else if st == "post" {
                    v.append(x[i + 1])
                    v.append(y[i])
                    v.append(x[i + 1])
                    v.append(y[i + 1])
                } else {
                    let m = (x[i] + x[i + 1]) / 2.0
                    v.append(m)
                    v.append(y[i])
                    v.append(m)
                    v.append(y[i + 1])
                }
                i = i + 1
            }
            if st == "mid" {
                v.append(x[i1])
                v.append(y[i1])
            }
        } else {
            var j = i0 + 1
            while j <= i1 {
                v.append(x[j])
                v.append(y[j])
                j = j + 1
            }
        }
        return v
    }
    v.append(x[i1])
    v.append(y[i1])
    if let st = step {
        var i = i1 - 1
        while i >= i0 {
            if st == "pre" {
                v.append(x[i])
                v.append(y[i + 1])
                v.append(x[i])
                v.append(y[i])
            } else if st == "post" {
                v.append(x[i + 1])
                v.append(y[i])
                v.append(x[i])
                v.append(y[i])
            } else {
                let m = (x[i] + x[i + 1]) / 2.0
                v.append(m)
                v.append(y[i + 1])
                v.append(m)
                v.append(y[i])
            }
            i = i - 1
        }
        if st == "mid" {
            v.append(x[i0])
            v.append(y[i0])
        }
    } else {
        var j = i1 - 1
        while j >= i0 {
            v.append(x[j])
            v.append(y[j])
            j = j - 1
        }
    }
    return v
}

/// The point where curves `y1` and `y2` cross between data indices
/// `idx-1` and `idx`, mirroring matplotlib's
/// `_get_interpolating_points` (clamped `np.interp` root of the diff,
/// linear interpolation of `y1`). Single-sided (idx at either end) and
/// parallel (equal diffs) segments collapse to the segment endpoint.
func crossing_point(x list[float], y1 list[float], y2 list[float],
                    idx int) (float, float) {
    var im1 = idx - 1
    if idx == 0 {
        im1 = 0
    }
    if idx == 0 || idx == x.len() {
        return (x[im1], y1[im1])
    }
    let d0 = y1[im1] - y2[im1]
    let d1 = y1[idx] - y2[idx]
    var t = x[im1]
    if d0 != d1 {
        t = x[im1] + (0.0 - d0) * (x[idx] - x[im1]) / (d1 - d0)
        var lo = x[im1]
        var hi = x[idx]
        if lo > hi {
            let tmp = lo
            lo = hi
            hi = tmp
        }
        if t < lo {
            t = lo
        }
        if t > hi {
            t = hi
        }
    } else {
        // np.interp on equal diffs clamps to fp[0] unless the common
        // value is negative, in which case it lands on fp[-1].
        if d0 < 0.0 {
            t = x[idx]
        } else {
            t = x[im1]
        }
    }
    let dx = x[idx] - x[im1]
    var f = y1[im1]
    if dx != 0.0 {
        f = y1[im1] + (t - x[im1]) * (y1[idx] - y1[im1]) / dx
    }
    return (t, f)
}

/// A filled band between two curves (matplotlib `PolyCollection`), the
/// artist behind `fill_between`. `where` gaps split the band into separate
/// closed polygons (`paths`); each path is a flat `[x0, y0, x1, y1, ...]`
/// data-space vertex list (top edge, then bottom edge back).
pub class FillBetween : Artist {
    pub let xdata list[float]
    pub let y1 list[float]
    pub let y2 list[float]
    pub let paths list[list[float]]
    pub let label str?
    pub let color str
    pub let alpha float?

    pub func __init__(xdata list[float], y1 list[float], y2 list[float],
                      paths list[list[float]], label str? = nil,
                      color str = "#1f77b4", alpha float? = nil) {
        if let a = alpha {
            if a < 0.0 || a > 1.0 {
                panic("plot.FillBetween: alpha must be in [0, 1]")
            }
        }
        self.xdata = xdata
        self.y1 = y1
        self.y2 = y2
        self.paths = paths
        self.label = label
        self.color = resolve_color(color)
        self.alpha = alpha
    }

    pub func kind() str = "fill_between"

    pub func xbounds() (float, float)? = bounds(xdata)

    pub func ybounds() (float, float)? {
        if let t1 = bounds(y1) {
            let (a, b) = t1
            if let t2 = bounds(y2) {
                let (c, d) = t2
                var lo = a
                var hi = b
                if c < lo {
                    lo = c
                }
                if d > hi {
                    hi = d
                }
                return (lo, hi)
            }
        }
        return nil
    }

    pub func legend_label() str? = label
    pub func legend_color() str? = color
    func cmap_range() (float, float, str, list[float]?)? { return nil }
    func xstickies() list[float] { return list[float]() }
    func ystickies() list[float] { return list[float]() }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        let ps = json.Array()
        for path in paths {
            let verts = json.Array()
            var i = 0
            while i + 1 < path.len() {
                let p = json.Object()
                p["x"] = json.Float(sx.pixel(path[i]))
                p["y"] = json.Float(sy.pixel(path[i + 1]))
                verts.append(p)
                i = i + 2
            }
            let po = json.Object()
            po["verts"] = verts
            ps.append(po)
        }
        let o = json.Object()
        o["kind"] = json.String("fill_between")
        o["paths"] = ps
        o["color"] = json.String(color)
        if let a = alpha {
            o["alpha"] = json.Float(a)
        }
        if let l = label {
            o["label"] = json.String(l)
        }
        return o
    }
}

/// A stem plot (matplotlib `StemContainer`), the artist behind `stem`.
/// Each entry has a stem line from the baseline `bottom` to the data
/// point plus a marker at the head; the baseline spans the data extent.
pub class Stem : Artist {
    pub let xdata list[float]
    pub let ydata list[float]
    pub let bottom float
    pub let orientation str
    pub let color str
    pub let linestyle str
    pub let markercolor str
    pub let marker str
    pub let markersize float
    pub let basecolor str
    pub let basestyle str
    pub let label str?
    pub let alpha float

    pub func __init__(xdata list[float], ydata list[float], bottom float,
                      orientation str, color str, linestyle str,
                      markercolor str, marker str, markersize float,
                      basecolor str, basestyle str, label str? = nil,
                      alpha float = 1.0) {
        if alpha < 0.0 || alpha > 1.0 {
            panic("plot.Stem: alpha must be in [0, 1]")
        }
        self.xdata = xdata
        self.ydata = ydata
        self.bottom = bottom
        self.orientation = orientation
        self.color = resolve_color(color)
        self.linestyle = linestyle
        self.markercolor = resolve_color(markercolor)
        self.marker = marker
        self.markersize = markersize
        self.basecolor = resolve_color(basecolor)
        self.basestyle = basestyle
        self.label = label
        self.alpha = alpha
    }

    pub func kind() str = "stem"

    pub func xbounds() (float, float)? {
        if let t = bounds(xdata) {
            let (a, b) = t
            if orientation == "vertical" {
                return (a, b)
            }
            var lo = a
            var hi = b
            if bottom < lo {
                lo = bottom
            }
            if bottom > hi {
                hi = bottom
            }
            return (lo, hi)
        }
        return nil
    }

    pub func ybounds() (float, float)? {
        if let t = bounds(ydata) {
            let (a, b) = t
            if orientation == "horizontal" {
                return (a, b)
            }
            var lo = a
            var hi = b
            if bottom < lo {
                lo = bottom
            }
            if bottom > hi {
                hi = bottom
            }
            return (lo, hi)
        }
        return nil
    }

    pub func legend_label() str? = label
    pub func legend_color() str? = color
    func cmap_range() (float, float, str, list[float]?)? { return nil }
    func xstickies() list[float] { return list[float]() }
    func ystickies() list[float] { return list[float]() }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        let segs = json.Array()
        let pts = json.Array()
        var i = 0
        while i < xdata.len() {
            let px = sx.pixel(xdata[i])
            let py = sy.pixel(ydata[i])
            let s = json.Object()
            if orientation == "vertical" {
                s["x0"] = json.Float(px)
                s["y0"] = json.Float(sy.pixel(bottom))
                s["x1"] = json.Float(px)
                s["y1"] = json.Float(py)
            } else {
                s["x0"] = json.Float(sx.pixel(bottom))
                s["y0"] = json.Float(py)
                s["x1"] = json.Float(px)
                s["y1"] = json.Float(py)
            }
            segs.append(s)
            let m = json.Object()
            m["x"] = json.Float(px)
            m["y"] = json.Float(py)
            pts.append(m)
            i = i + 1
        }
        let o = json.Object()
        o["kind"] = json.String("stem")
        o["stems"] = segs
        o["markers"] = pts
        o["color"] = json.String(color)
        o["linestyle"] = json.String(linestyle)
        o["linewidth"] = json.Float(1.5)
        o["markercolor"] = json.String(markercolor)
        o["marker"] = json.String(marker)
        o["markersize"] = json.Float(markersize)
        o["basecolor"] = json.String(basecolor)
        o["basestyle"] = json.String(basestyle)
        o["alpha"] = json.Float(alpha)
        if basestyle != "" {
            if let t = bounds(xdata) {
                let (a, b) = t
                let bl = json.Object()
                if orientation == "vertical" {
                    bl["x0"] = json.Float(sx.pixel(a))
                    bl["y0"] = json.Float(sy.pixel(bottom))
                    bl["x1"] = json.Float(sx.pixel(b))
                    bl["y1"] = json.Float(sy.pixel(bottom))
                } else {
                    if let t2 = bounds(ydata) {
                        let (c, d) = t2
                        bl["x0"] = json.Float(sx.pixel(bottom))
                        bl["y0"] = json.Float(sy.pixel(c))
                        bl["x1"] = json.Float(sx.pixel(bottom))
                        bl["y1"] = json.Float(sy.pixel(d))
                    }
                }
                o["baseline"] = bl
            }
        }
        if let l = label {
            o["label"] = json.String(l)
        }
        return o
    }
}

/// A filled-contour plot (matplotlib `contourf`). Each band entry carries
/// its fill color and the band's clipped polygons in data coordinates; the
/// renderer only fills them. Below/above extend bands occupy the first and
/// last band slots. Bands with no geometry are still emitted so the legend
/// and colorbar (later) see every color.
pub class FilledContour : Artist {
    pub let xs list[float]
    pub let ys list[float]
    pub let colors list[str]
    pub let bands list[list[list[float]]]
    pub let levels list[float]
    pub let cmap str
    pub let alpha float?
    pub let label str?
    pub let extend str

    pub func __init__(xs list[float], ys list[float], colors list[str],
                      bands list[list[list[float]]], levels list[float],
                      cmap str, alpha float? = nil, label str? = nil,
                      extend str = "neither") {
        if let a = alpha {
            if a < 0.0 || a > 1.0 {
                panic("plot.FilledContour: alpha must be in [0, 1]")
            }
        }
        self.xs = xs
        self.ys = ys
        self.colors = colors
        self.bands = bands
        self.levels = levels
        self.cmap = cmap
        self.alpha = alpha
        self.label = label
        self.extend = extend
    }

    pub func kind() str = "contourf"

    pub func xbounds() (float, float)? = bounds(xs)

    pub func ybounds() (float, float)? = bounds(ys)

    pub func legend_label() str? = label
    pub func legend_color() str? {
        if colors.len() > 0 {
            return colors[0]
        }
        return nil
    }
    func cmap_range() (float, float, str, list[float]?)? {
        if levels.len() >= 2 {
            return (levels[0], levels[levels.len() - 1], cmap, levels)
        }
        return nil
    }
    func xstickies() list[float] { return list[float]() }
    func ystickies() list[float] { return list[float]() }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        let bs = json.Array()
        var b = 0
        while b < bands.len() {
            let bo = json.Object()
            let ps = json.Array()
            for path in bands[b] {
                let verts = json.Array()
                var i = 0
                while i + 1 < path.len() {
                    let p = json.Object()
                    p["x"] = json.Float(sx.pixel(path[i]))
                    p["y"] = json.Float(sy.pixel(path[i + 1]))
                    verts.append(p)
                    i = i + 2
                }
                let po = json.Object()
                po["verts"] = verts
                ps.append(po)
            }
            bo["color"] = json.String(colors[b])
            bo["paths"] = ps
            bs.append(bo)
            b = b + 1
        }
        let o = json.Object()
        o["kind"] = json.String("contourf")
        o["bands"] = bs
        if let a = alpha {
            o["alpha"] = json.Float(a)
        }
        if let l = label {
            o["label"] = json.String(l)
        }
        return o
    }
}

/// A boxplot (matplotlib `boxplot`). One entry per dataset carries its
/// resolved statistics (`BoxStat`); the artist only serializes the parts
/// (box outline, median, whiskers, caps, fliers, mean) into pixel
/// geometry for the renderer. Style defaults mirror matplotlib's
/// boxplot.*props rcParams: black box/whiskers/caps, C1 median, C2 mean
/// (`^` marker, `--` meanline), C0 box fill with `patch_artist`, hollow
/// `o` fliers.
pub class Boxplot : Artist {
    pub let stats list[BoxStat]
    pub let notch bool
    pub let patch_artist bool
    pub let showmeans bool
    pub let meanline bool
    pub let showfliers bool
    pub let flier_marker str
    pub let flier_color str
    pub let flier_facecolor str
    pub let flier_size float
    pub let mean_size float
    pub let orientation str
    pub let label str?
    pub let box_color str
    pub let box_facecolor str
    pub let box_linestyle str
    pub let box_linewidth float
    pub let whisker_color str
    pub let whisker_linestyle str
    pub let whisker_linewidth float
    pub let cap_color str
    pub let cap_linestyle str
    pub let cap_linewidth float
    pub let median_color str
    pub let median_linestyle str
    pub let median_linewidth float
    pub let mean_color str
    pub let mean_marker str
    pub let mean_facecolor str
    pub let mean_linestyle str
    pub let mean_linewidth float

    pub func __init__(stats list[BoxStat], notch bool, patch_artist bool,
                      showmeans bool, meanline bool, showfliers bool,
                      flier_marker str, flier_color str,
                      flier_facecolor str, flier_size float,
                      mean_size float, orientation str,
                      label str? = nil, box_color str = "#000000",
                      box_facecolor str = "#1f77b4",
                      box_linestyle str = "-",
                      box_linewidth float = 1.0, whisker_color str = "#000000",
                      whisker_linestyle str = "-",
                      whisker_linewidth float = 1.0,
                      cap_color str = "#000000",
                      cap_linestyle str = "-", cap_linewidth float = 1.0,
                      median_color str = "#ff7f0e",
                      median_linestyle str = "-",
                      median_linewidth float = 1.0,
                      mean_color str = "#2ca02c",
                      mean_marker str = "^",
                      mean_facecolor str = "#2ca02c",
                      mean_linestyle str = "--",
                      mean_linewidth float = 1.0) {
        self.stats = stats
        self.notch = notch
        self.patch_artist = patch_artist
        self.showmeans = showmeans
        self.meanline = meanline
        self.showfliers = showfliers
        self.flier_marker = flier_marker
        self.flier_color = resolve_color(flier_color)
        self.flier_facecolor = resolve_color(flier_facecolor)
        self.flier_size = flier_size
        self.mean_size = mean_size
        self.orientation = orientation
        self.label = label
        self.box_color = resolve_color(box_color)
        self.box_facecolor = resolve_color(box_facecolor)
        self.box_linestyle = box_linestyle
        self.box_linewidth = box_linewidth
        self.whisker_color = resolve_color(whisker_color)
        self.whisker_linestyle = whisker_linestyle
        self.whisker_linewidth = whisker_linewidth
        self.cap_color = resolve_color(cap_color)
        self.cap_linestyle = cap_linestyle
        self.cap_linewidth = cap_linewidth
        self.median_color = resolve_color(median_color)
        self.median_linestyle = median_linestyle
        self.median_linewidth = median_linewidth
        self.mean_color = resolve_color(mean_color)
        self.mean_marker = mean_marker
        self.mean_facecolor = resolve_color(mean_facecolor)
        self.mean_linestyle = mean_linestyle
        self.mean_linewidth = mean_linewidth
    }

    pub func kind() str = "boxplot"

    func lo_ext(st BoxStat) float {
        var a = st.wlo
        for f in st.fliers {
            if f < a {
                a = f
            }
        }
        return a
    }

    func hi_ext(st BoxStat) float {
        var a = st.whi
        for f in st.fliers {
            if f > a {
                a = f
            }
        }
        return a
    }

    pub func xbounds() (float, float)? {
        if stats.len() == 0 {
            return nil
        }
        var lo = 0.0
        var hi = 0.0
        var first = true
        for st in stats {
            var a = st.pos - st.hw
            var b = st.pos + st.hw
            if orientation == "horizontal" {
                a = lo_ext(st)
                b = hi_ext(st)
            }
            if first {
                lo = a
                hi = b
                first = false
            } else {
                if a < lo {
                    lo = a
                }
                if b > hi {
                    hi = b
                }
            }
        }
        return (lo, hi)
    }

    pub func ybounds() (float, float)? {
        if stats.len() == 0 {
            return nil
        }
        var lo = 0.0
        var hi = 0.0
        var first = true
        for st in stats {
            var a = lo_ext(st)
            var b = hi_ext(st)
            if orientation == "horizontal" {
                a = st.pos - st.hw
                b = st.pos + st.hw
            }
            if first {
                lo = a
                hi = b
                first = false
            } else {
                if a < lo {
                    lo = a
                }
                if b > hi {
                    hi = b
                }
            }
        }
        return (lo, hi)
    }

    pub func legend_label() str? = label
    pub func legend_color() str? = "#000000"
    func cmap_range() (float, float, str, list[float]?)? { return nil }
    func xstickies() list[float] { return list[float]() }
    func ystickies() list[float] { return list[float]() }

    pub func to_json(sx Scale, sy Scale, plot Rect) json.Object {
        let boxes = json.Array()
        let medians = json.Array()
        let whiskers = json.Array()
        let caps = json.Array()
        let fliers = json.Array()
        let meanpts = json.Array()
        let meanlines = json.Array()
        for st in stats {
            let chw = st.hw / 2.0
            var verts = list[(float, float)]()
            let dy = st.notch_dy()
            if notch && dy > 0.0 {
                verts.append((st.pos - st.hw, st.q1))
                verts.append((st.pos + st.hw, st.q1))
                verts.append((st.pos + st.hw, st.med - dy))
                verts.append((st.pos + chw, st.med))
                verts.append((st.pos + st.hw, st.med + dy))
                verts.append((st.pos + st.hw, st.q3))
                verts.append((st.pos - st.hw, st.q3))
                verts.append((st.pos - st.hw, st.med + dy))
                verts.append((st.pos - chw, st.med))
                verts.append((st.pos - st.hw, st.med - dy))
            } else {
                verts.append((st.pos - st.hw, st.q1))
                verts.append((st.pos + st.hw, st.q1))
                verts.append((st.pos + st.hw, st.q3))
                verts.append((st.pos - st.hw, st.q3))
            }
            let bv = json.Array()
            for (a, b) in verts {
                let p = json.Object()
                if orientation == "horizontal" {
                    p["x"] = json.Float(sx.pixel(b))
                    p["y"] = json.Float(sy.pixel(a))
                } else {
                    p["x"] = json.Float(sx.pixel(a))
                    p["y"] = json.Float(sy.pixel(b))
                }
                bv.append(p)
            }
            let bo = json.Object()
            bo["verts"] = bv
            boxes.append(bo)

            let m = json.Object()
            let mw = st.hw
            var m0 = st.pos - mw
            var m1 = st.pos + mw
            if notch && dy > 0.0 {
                m0 = st.pos - chw
                m1 = st.pos + chw
            }
            if orientation == "horizontal" {
                m["x0"] = json.Float(sx.pixel(st.med))
                m["y0"] = json.Float(sy.pixel(m0))
                m["x1"] = json.Float(sx.pixel(st.med))
                m["y1"] = json.Float(sy.pixel(m1))
            } else {
                m["x0"] = json.Float(sx.pixel(m0))
                m["y0"] = json.Float(sy.pixel(st.med))
                m["x1"] = json.Float(sx.pixel(m1))
                m["y1"] = json.Float(sy.pixel(st.med))
            }
            medians.append(m)

            var wcount = 0
            while wcount < 2 {
                let w = json.Object()
                if wcount == 0 {
                    if orientation == "horizontal" {
                        w["x0"] = json.Float(sx.pixel(st.q1))
                        w["y0"] = json.Float(sy.pixel(st.pos))
                        w["x1"] = json.Float(sx.pixel(st.wlo))
                        w["y1"] = json.Float(sy.pixel(st.pos))
                    } else {
                        w["x0"] = json.Float(sx.pixel(st.pos))
                        w["y0"] = json.Float(sy.pixel(st.q1))
                        w["x1"] = json.Float(sx.pixel(st.pos))
                        w["y1"] = json.Float(sy.pixel(st.wlo))
                    }
                } else {
                    if orientation == "horizontal" {
                        w["x0"] = json.Float(sx.pixel(st.q3))
                        w["y0"] = json.Float(sy.pixel(st.pos))
                        w["x1"] = json.Float(sx.pixel(st.whi))
                        w["y1"] = json.Float(sy.pixel(st.pos))
                    } else {
                        w["x0"] = json.Float(sx.pixel(st.pos))
                        w["y0"] = json.Float(sy.pixel(st.q3))
                        w["x1"] = json.Float(sx.pixel(st.pos))
                        w["y1"] = json.Float(sy.pixel(st.whi))
                    }
                }
                whiskers.append(w)
                wcount = wcount + 1
            }

            var ccount = 0
            while ccount < 2 {
                let c = json.Object()
                var cy = st.wlo
                if ccount == 1 {
                    cy = st.whi
                }
                if orientation == "horizontal" {
                    c["x0"] = json.Float(sx.pixel(cy))
                    c["y0"] = json.Float(sy.pixel(st.pos - chw))
                    c["x1"] = json.Float(sx.pixel(cy))
                    c["y1"] = json.Float(sy.pixel(st.pos + chw))
                } else {
                    c["x0"] = json.Float(sx.pixel(st.pos - chw))
                    c["y0"] = json.Float(sy.pixel(cy))
                    c["x1"] = json.Float(sx.pixel(st.pos + chw))
                    c["y1"] = json.Float(sy.pixel(cy))
                }
                caps.append(c)
                ccount = ccount + 1
            }

            if showfliers && flier_marker != "" {
                for f in st.fliers {
                    let fp = json.Object()
                    if orientation == "horizontal" {
                        fp["x"] = json.Float(sx.pixel(f))
                        fp["y"] = json.Float(sy.pixel(st.pos))
                    } else {
                        fp["x"] = json.Float(sx.pixel(st.pos))
                        fp["y"] = json.Float(sy.pixel(f))
                    }
                    fliers.append(fp)
                }
            }

            if showmeans {
                if meanline {
                    let ml = json.Object()
                    if orientation == "horizontal" {
                        ml["x0"] = json.Float(sx.pixel(st.mean))
                        ml["y0"] = json.Float(sy.pixel(st.pos - st.hw))
                        ml["x1"] = json.Float(sx.pixel(st.mean))
                        ml["y1"] = json.Float(sy.pixel(st.pos + st.hw))
                    } else {
                        ml["x0"] = json.Float(sx.pixel(st.pos - st.hw))
                        ml["y0"] = json.Float(sy.pixel(st.mean))
                        ml["x1"] = json.Float(sx.pixel(st.pos + st.hw))
                        ml["y1"] = json.Float(sy.pixel(st.mean))
                    }
                    meanlines.append(ml)
                    // An explicit marker survives meanline mode and is
                    // drawn at the mean (matplotlib Line2D markers).
                    if mean_marker != "" {
                        let mp = json.Object()
                        if orientation == "horizontal" {
                            mp["x"] = json.Float(sx.pixel(st.mean))
                            mp["y"] = json.Float(sy.pixel(st.pos))
                        } else {
                            mp["x"] = json.Float(sx.pixel(st.pos))
                            mp["y"] = json.Float(sy.pixel(st.mean))
                        }
                        meanpts.append(mp)
                    }
                } else if mean_marker != "" {
                    let mp = json.Object()
                    if orientation == "horizontal" {
                        mp["x"] = json.Float(sx.pixel(st.mean))
                        mp["y"] = json.Float(sy.pixel(st.pos))
                    } else {
                        mp["x"] = json.Float(sx.pixel(st.pos))
                        mp["y"] = json.Float(sy.pixel(st.mean))
                    }
                    meanpts.append(mp)
                }
            }
        }
        let o = json.Object()
        o["kind"] = json.String("boxplot")
        o["boxes"] = boxes
        o["medians"] = medians
        o["whiskers"] = whiskers
        o["caps"] = caps
        o["fliers"] = fliers
        o["means"] = meanpts
        o["meanlines"] = meanlines
        o["boxcolor"] = json.String(box_color)
        if patch_artist {
            o["boxfillcolor"] = json.String(box_facecolor)
        }
        o["boxlinestyle"] = json.String(box_linestyle)
        o["boxlinewidth"] = json.Float(box_linewidth)
        o["mediancolor"] = json.String(median_color)
        o["medianlinestyle"] = json.String(median_linestyle)
        o["medianlinewidth"] = json.Float(median_linewidth)
        o["whiskercolor"] = json.String(whisker_color)
        o["whiskerlinestyle"] = json.String(whisker_linestyle)
        o["whiskerlinewidth"] = json.Float(whisker_linewidth)
        o["capcolor"] = json.String(cap_color)
        o["caplinestyle"] = json.String(cap_linestyle)
        o["caplinewidth"] = json.Float(cap_linewidth)
        o["fliermarker"] = json.String(flier_marker)
        o["fliercolor"] = json.String(flier_color)
        o["flierfacecolor"] = json.String(flier_facecolor)
        o["fliersize"] = json.Float(flier_size)
        o["meancolor"] = json.String(mean_color)
        o["meanmarker"] = json.String(mean_marker)
        o["meanfacecolor"] = json.String(mean_facecolor)
        o["meansize"] = json.Float(mean_size)
        o["meanlinestyle"] = json.String(mean_linestyle)
        o["meanlinewidth"] = json.Float(mean_linewidth)
        if let l = label {
            o["label"] = json.String(l)
        }
        return o
    }
}

/// A colorbar attached to an axes (matplotlib `Figure.colorbar`). The
/// geometry contract follows matplotlib's `make_axes`: the data rect of
/// the owning axes shrinks by `(fraction + pad)` of its width (vertical)
/// or height (horizontal), and the bar occupies the freed strip with a
/// `pad` gap, scaled around its center by `shrink`; the bar's thickness
/// is `length / aspect` (matplotlib's box-aspect width model). With
/// `extend` "min"/"max"/"both", the gradient bar shrinks toward the
/// middle and triangles in the colormap's under/over colors fill the
/// ends. Tick values resolve Koala-side at spec time;
/// `set_label`/`set_ticks` mirror matplotlib's `Colorbar` methods. v1
/// deviations: fraction/pad are fractions of the *data rect* (matplotlib
/// uses the full axes box including labels), and bar ticks use fixed
/// defaults rather than the axes' `tick_params`.
pub class Colorbar {
    pub let orientation str
    pub let fraction float
    pub let pad float
    pub let shrink float
    pub let aspect float
    pub let extend str
    pub let extendfrac float
    pub var label str? = nil
    pub var ticks list[float]? = nil
    pub let vmin float
    pub let vmax float
    pub let cmap str

    pub func __init__(orientation str, fraction float, pad float,
                      shrink float, aspect float, extend str,
                      extendfrac float, label str?, ticks list[float]?,
                      vmin float, vmax float, cmap str) {
        self.orientation = orientation
        self.fraction = fraction
        self.pad = pad
        self.shrink = shrink
        self.aspect = aspect
        self.extend = extend
        self.extendfrac = extendfrac
        self.label = label
        self.ticks = ticks
        self.vmin = vmin
        self.vmax = vmax
        self.cmap = cmap
    }

    /// Set the colorbar title (matplotlib `Colorbar.set_label`).
    pub func set_label(s str) {
        label = s
    }

    /// Override the tick values (matplotlib `Colorbar.set_ticks`).
    pub func set_ticks(t list[float]) {
        ticks = t
    }

    /// Serialize the resolved bar: the gradient `inner` rect, pixel tick
    /// positions and labels, and the `extend` triangles. The passed `rect`
    /// is the outer bar allocation; with extend active, the inner gradient
    /// bar shrinks toward the middle and triangles with the colormap end
    /// colors fill the freed ends (matplotlib's extendfrac model: each
    /// triangle is `extendfrac` of the inner bar length).
    pub func to_spec(rect Rect) json.Object {
        let o = json.Object()
        o["kind"] = json.String("colorbar")
        o["orientation"] = json.String(orientation)
        o["x"] = json.Float(rect.x)
        o["y"] = json.Float(rect.y)
        o["w"] = json.Float(rect.w)
        o["h"] = json.Float(rect.h)
        var lo = 0.0
        var hi = 0.0
        if extend == "min" || extend == "both" {
            lo = extendfrac
        }
        if extend == "max" || extend == "both" {
            hi = extendfrac
        }
        let s = 1.0 + lo + hi
        var inner = rect
        if orientation == "vertical" {
            let il = rect.h / s
            inner = Rect(rect.x, rect.y + lo * il, rect.w, il)
        } else {
            let il = rect.w / s
            inner = Rect(rect.x + lo * il, rect.y, il, rect.h)
        }
        o["inner"] = rect_json(inner)
        let (ur, ug, ub) = colormap(cmap, 0.0)
        let (or_, og, ob) = colormap(cmap, 1.0)
        let ex = json.Object()
        ex["min"] = json.Boolean(extend == "min" || extend == "both")
        ex["max"] = json.Boolean(extend == "max" || extend == "both")
        ex["frac"] = json.Float(extendfrac)
        ex["under"] = json.String(rgb_hex(ur, ug, ub))
        ex["over"] = json.String(rgb_hex(or_, og, ob))
        o["extend"] = ex
        let stops = json.Array()
        var i = 0
        while i < 16 {
            let t = float(i) / 15.0
            let (r, g, b) = colormap(cmap, t)
            let so = json.Object()
            so["t"] = json.Float(t)
            so["c"] = json.String(rgb_hex(r, g, b))
            stops.append(so)
            i = i + 1
        }
        o["stops"] = stops
        var vals = list[float]()
        var labels = list[str]()
        if let ov = ticks {
            // Override ticks are shown even outside [vmin, vmax], clamped
            // to the bar ends (matplotlib normalizes them the same way).
            var dec = 0
            if ov.len() >= 2 {
                let gap = abs(ov[1] - ov[0])
                if gap > 0.0 {
                    dec = tick_decimals(gap)
                }
            }
            for v in ov {
                vals.append(v)
                labels.append(format_tick(v, dec))
            }
        } else {
            let (nv, nl) = axis_ticks(vmin, vmax, nil, nil, false)
            vals = nv
            labels = nl
        }
        let tks = json.Array()
        let span = vmax - vmin
        var j = 0
        while j < vals.len() {
            var t = 0.5
            if span > 0.0 {
                t = (vals[j] - vmin) / span
                if t < 0.0 {
                    t = 0.0
                }
                if t > 1.0 {
                    t = 1.0
                }
            }
            let to = json.Object()
            to["v"] = json.Float(vals[j])
            if orientation == "vertical" {
                to["px"] = json.Float(inner.h * (1.0 - t))
            } else {
                to["px"] = json.Float(inner.w * t)
            }
            to["label"] = json.String(labels[j])
            tks.append(to)
            j = j + 1
        }
        o["ticks"] = tks
        if let l = label {
            o["label"] = json.String(l)
        }
        return o
    }
}
