import "koala/json"

/// Tight-bbox geometry (docs/koala_ml.md §6.5). Walks the resolved figure
/// spec and returns the pixel bounding box of everything the painter draws
/// outside the axes frames: tick labels, axis labels, titles, legend boxes,
/// colorbars and the suptitle. `savefig(bbox_inches = "tight")` crops the
/// canvas to it; `tight_layout` reuses it to grow margins.
///
/// Text extents are *estimated* (`w ≈ 0.6 · size · len`, `h ≈ 1.2 · size`),
/// not measured — the Koala side has no glyph metrics. matplotlib measures
/// real glyphs; the estimate is the documented 支持方式 (docs/koala_ml.md
/// §6.6).

/// Estimated rendered width of `s` at font size `size` px.
pub func text_w(size float, s str) float {
    return 0.6 * size * float(s.len())
}

/// Estimated line height at font size `size` px.
pub func text_h(size float) float {
    return 1.2 * size
}

/// The tight bounding box of one axes: the frame (data box) plus every
/// decoration the painter draws outside it. Mirrors the renderer's label
/// geometry (renderer.kl paintFrameTicks/paintLabels/paintLegend):
/// direction "in" labels sit at `pad`, otherwise beyond the tick at
/// `len + pad`; xlabel/title are 13/14 px centered, ylabel is rotated
/// 13 px; the legend box is label-len*7+34 wide, 18 px/row + 10.
///
/// `for_layout` mirrors matplotlib's `for_layout_only` bbox used by
/// `tight_layout`: tick marks are excluded (labels sit at `pad` only),
/// and the xlabel/title contribute only their y extent while the ylabel
/// contributes only its x extent, so a long title cannot widen the left
/// margin.
pub func axes_tight_bbox(ax json.Object, for_layout bool = false) Rect {
    let p = ax.get_object("plot")
    let px0 = p.get_float("x")
    let py0 = p.get_float("y")
    let pw = p.get_float("w")
    let ph = p.get_float("h")
    var x0 = px0
    var y0 = py0
    var x1 = px0 + pw
    var y1 = py0 + ph

    let ts = ax.get_object("tickstyle")
    let ls = ts.get_float("labelsize")
    let off = if ts.get_str("direction") == "in" || for_layout {
        ts.get_float("pad")
    } else {
        ts.get_float("length") + ts.get_float("pad")
    }
    let xt = ax.get_array("xticks")
    let yt = ax.get_array("yticks")
    if ts.get_bool("labelbottom") {
        var k = 0
        while k < xt.len() {
            let t = xt.get_object(k)
            let w = text_w(ls, t.get_str("label"))
            let cx = t.get_float("px")
            if cx - w / 2.0 < x0 {
                x0 = cx - w / 2.0
            }
            if cx + w / 2.0 > x1 {
                x1 = cx + w / 2.0
            }
            k = k + 1
        }
        y1 = y1 + off + ls
    }
    if ts.get_bool("labeltop") {
        var k = 0
        while k < xt.len() {
            let t = xt.get_object(k)
            let w = text_w(ls, t.get_str("label"))
            let cx = t.get_float("px")
            if cx - w / 2.0 < x0 {
                x0 = cx - w / 2.0
            }
            if cx + w / 2.0 > x1 {
                x1 = cx + w / 2.0
            }
            k = k + 1
        }
        if py0 - off - ls < y0 {
            y0 = py0 - off - ls
        }
    }
    if ts.get_bool("labelleft") {
        var m = 0
        while m < yt.len() {
            let t = yt.get_object(m)
            let w = text_w(ls, t.get_str("label"))
            let cy = t.get_float("px")
            if px0 - off - w < x0 {
                x0 = px0 - off - w
            }
            if cy - ls / 2.0 < y0 {
                y0 = cy - ls / 2.0
            }
            if cy + ls / 2.0 > y1 {
                y1 = cy + ls / 2.0
            }
            m = m + 1
        }
    }
    if ts.get_bool("labelright") {
        var m = 0
        while m < yt.len() {
            let t = yt.get_object(m)
            let w = text_w(ls, t.get_str("label"))
            let cy = t.get_float("px")
            if px0 + pw + off + w > x1 {
                x1 = px0 + pw + off + w
            }
            if cy - ls / 2.0 < y0 {
                y0 = cy - ls / 2.0
            }
            if cy + ls / 2.0 > y1 {
                y1 = cy + ls / 2.0
            }
            m = m + 1
        }
    }

    if "xlabel" in ax {
        let xl = ax.get_object("xlabel")
        if xl.get_str("text") != "" {
            let w = text_w(13.0, xl.get_str("text"))
            let cx = xl.get_float("x")
            let cy = xl.get_float("y")
            if !for_layout {
                if cx - w / 2.0 < x0 {
                    x0 = cx - w / 2.0
                }
                if cx + w / 2.0 > x1 {
                    x1 = cx + w / 2.0
                }
            }
            if cy - 6.5 < y0 {
                y0 = cy - 6.5
            }
            if cy + 6.5 > y1 {
                y1 = cy + 6.5
            }
        }
    }
    if "ylabel" in ax {
        let yl = ax.get_object("ylabel")
        if yl.get_str("text") != "" {
            // Rotated text: the width runs along y, the height along x.
            let w = text_w(13.0, yl.get_str("text"))
            let cx = yl.get_float("x")
            let cy = yl.get_float("y")
            if cx - 6.5 < x0 {
                x0 = cx - 6.5
            }
            if cx + 6.5 > x1 {
                x1 = cx + 6.5
            }
            if !for_layout {
                if cy - w / 2.0 < y0 {
                    y0 = cy - w / 2.0
                }
                if cy + w / 2.0 > y1 {
                    y1 = cy + w / 2.0
                }
            }
        }
    }
    let ti = ax.get_object("title")
    if ti.get_str("text") != "" {
        let w = text_w(14.0, ti.get_str("text"))
        let cx = ti.get_float("x")
        let cy = ti.get_float("y")
        if !for_layout {
            if cx - w / 2.0 < x0 {
                x0 = cx - w / 2.0
            }
            if cx + w / 2.0 > x1 {
                x1 = cx + w / 2.0
            }
        }
        if cy - 7.0 < y0 {
            y0 = cy - 7.0
        }
        if cy + 7.0 > y1 {
            y1 = cy + 7.0
        }
    }

    let lg = ax.get_object("legend")
    if lg.get_bool("show") {
        let entries = lg.get_array("entries")
        if entries.len() > 0 {
            var w = 0.0
            var j = 0
            while j < entries.len() {
                let lw = float(entries.get_object(j).get_str("label").len()) * 7.0 + 34.0
                if lw > w {
                    w = lw
                }
                j = j + 1
            }
            let h = float(entries.len()) * 18.0 + 10.0
            let loc = lg.get_str("loc")
            var lx = px0 + pw - w - 8.0
            var ly = py0 + 8.0
            if loc == "upper left" {
                lx = px0 + 8.0
            } else if loc == "lower left" {
                lx = px0 + 8.0
                ly = py0 + ph - h - 8.0
            } else if loc == "lower right" {
                lx = px0 + pw - w - 8.0
                ly = py0 + ph - h - 8.0
            } else if loc == "center" {
                lx = px0 + (pw - w) / 2.0
                ly = py0 + (ph - h) / 2.0
            }
            if lx < x0 {
                x0 = lx
            }
            if ly < y0 {
                y0 = ly
            }
            if lx + w > x1 {
                x1 = lx + w
            }
            if ly + h > y1 {
                y1 = ly + h
            }
        }
    }

    if "colorbar" in ax {
        let cb = ax.get_object("colorbar")
        let cbx = cb.get_float("x")
        let cby = cb.get_float("y")
        let cbw = cb.get_float("w")
        let cbh = cb.get_float("h")
        if cbx < x0 {
            x0 = cbx
        }
        if cby < y0 {
            y0 = cby
        }
        if cbx + cbw > x1 {
            x1 = cbx + cbw
        }
        if cby + cbh > y1 {
            y1 = cby + cbh
        }
    }

    return Rect(x0, y0, x1 - x0, y1 - y0)
}

/// The tight pixel bbox of a whole figure: the union of every axes' tight
/// bbox plus the suptitle. Nil when the figure draws nothing (no axes and
/// no suptitle) — matplotlib would yield an empty bbox there.
pub func tight_bbox(spec json.Object) Rect? {
    let axes = spec.get_array("axes")
    var found = axes.len() > 0
    var x0 = 0.0
    var y0 = 0.0
    var x1 = 0.0
    var y1 = 0.0
    var i = 0
    while i < axes.len() {
        let r = axes_tight_bbox(axes.get_object(i))
        if i == 0 {
            x0 = r.x
            y0 = r.y
            x1 = r.right()
            y1 = r.bottom()
        } else {
            if r.x < x0 {
                x0 = r.x
            }
            if r.y < y0 {
                y0 = r.y
            }
            if r.right() > x1 {
                x1 = r.right()
            }
            if r.bottom() > y1 {
                y1 = r.bottom()
            }
        }
        i = i + 1
    }
    if "suptitle" in spec {
        let st = spec.get_object("suptitle")
        let s = st.get_str("text")
        if s != "" {
            let w = text_w(16.0, s)
            let ha = st.get_str("ha")
            var sx0 = st.get_float("x")
            var sx1 = sx0 + w
            if ha == "center" {
                sx0 = st.get_float("x") - w / 2.0
                sx1 = st.get_float("x") + w / 2.0
            } else if ha == "right" {
                sx0 = st.get_float("x") - w
                sx1 = st.get_float("x")
            }
            let va = st.get_str("va")
            var sy0 = st.get_float("y")
            var sy1 = sy0 + 16.0
            if va == "middle" || va == "center_baseline" {
                sy0 = st.get_float("y") - 8.0
                sy1 = st.get_float("y") + 8.0
            } else if va == "bottom" || va == "alphabetic" || va == "baseline" {
                sy0 = st.get_float("y") - 16.0
                sy1 = st.get_float("y")
            }
            if sx0 < x0 {
                x0 = sx0
            }
            if sy0 < y0 {
                y0 = sy0
            }
            if sx1 > x1 {
                x1 = sx1
            }
            if sy1 > y1 {
                y1 = sy1
            }
            found = true
        }
    }
    if !found {
        return nil
    }
    return Rect(x0, y0, x1 - x0, y1 - y0)
}
