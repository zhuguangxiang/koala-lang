/// Subplot grid and axes-margin layout for the plot spec layer, resolved
/// Koala-side into pixel rectangles so the renderer only paints. v1 uses
/// fixed pixel margins (text measurement is a later refinement); the
/// geometry is deterministic and headless-testable.
///
/// Coordinate convention: figure pixels grow rightward (x) and downward
/// (y); subplot row 0 is the top row, column 0 the left column, matching
/// matplotlib's row-major subplot indexing.

/// Outer margin around the whole subplot grid, in pixels.
pub const FIG_MARGIN = 10.0
/// Gap between adjacent subplot cells, in pixels.
pub const CELL_GAP = 20.0
/// Left inset of the data area within a cell (room for y ticks + ylabel).
pub const PAD_LEFT = 60.0
/// Right inset of the data area within a cell.
pub const PAD_RIGHT = 20.0
/// Top inset of the data area within a cell (room for the title).
pub const PAD_TOP = 40.0
/// Bottom inset of the data area within a cell (room for x ticks + xlabel).
pub const PAD_BOTTOM = 50.0

/// An axis-aligned pixel rectangle.
pub class Rect {
    pub let x float
    pub let y float
    pub let w float
    pub let h float

    pub func __init__(x float, y float, w float, h float) {
        self.x = x
        self.y = y
        self.w = w
        self.h = h
    }

    pub func right() float = x + w
    pub func bottom() float = y + h
    pub func center_x() float = x + w / 2.0
    pub func center_y() float = y + h / 2.0
}

/// Pixel rectangle of subplot cell `(r, c)` in a `rows x cols` grid on a
/// `figw x figh` figure. Panics on a non-positive grid or an out-of-range
/// cell index.
pub func cell_rect(figw float, figh float, rows int, cols int, r int, c int) Rect {
    if rows < 1 || cols < 1 {
        panic("plot.layout: rows and cols must be >= 1")
    }
    if r < 0 || r >= rows || c < 0 || c >= cols {
        panic("plot.layout: cell index out of range")
    }
    let usable_w = figw - 2.0 * FIG_MARGIN
    let usable_h = figh - 2.0 * FIG_MARGIN
    let cw = (usable_w - float(cols - 1) * CELL_GAP) / float(cols)
    let ch = (usable_h - float(rows - 1) * CELL_GAP) / float(rows)
    let x = FIG_MARGIN + float(c) * (cw + CELL_GAP)
    let y = FIG_MARGIN + float(r) * (ch + CELL_GAP)
    return Rect(x, y, cw, ch)
}

/// The data-area rectangle inside a subplot `cell`, inset by the fixed
/// axes margins. Panics if the cell is too small to leave a positive area.
pub func plot_rect(cell Rect) Rect {
    let x = cell.x + PAD_LEFT
    let y = cell.y + PAD_TOP
    let w = cell.w - PAD_LEFT - PAD_RIGHT
    let h = cell.h - PAD_TOP - PAD_BOTTOM
    if w <= 0.0 || h <= 0.0 {
        panic("plot.layout: figure too small for axes margins")
    }
    return Rect(x, y, w, h)
}

/// Cell rectangle for figure-fraction layout parameters (matplotlib
/// `subplots_adjust` / `tight_layout`): `left`/`right`/`bottom`/`top` are
/// figure fractions of the DATA area measured from the figure's
/// bottom-left corner (matplotlib `SubplotParams`), `wspace`/`hspace`
/// fractions of the average column width / row height. The returned cell
/// is the data area expanded by the fixed axes margins, so `plot_rect` of
/// it recovers the exact fraction-specified data rectangle (matplotlib's
/// axes box).
pub func cell_rect_frac(figw float, figh float, rows int, cols int, r int,
                        c int, left float, bottom float, right float,
                        top float, wspace float, hspace float) Rect {
    if rows < 1 || cols < 1 {
        panic("plot.layout: rows and cols must be >= 1")
    }
    if r < 0 || r >= rows || c < 0 || c >= cols {
        panic("plot.layout: cell index out of range")
    }
    let x0 = left * figw
    let x1 = right * figw
    let y0 = (1.0 - top) * figh
    let y1 = (1.0 - bottom) * figh
    let colw = (x1 - x0) / (float(cols) + float(cols - 1) * wspace)
    let gapx = colw * wspace
    let rowh = (y1 - y0) / (float(rows) + float(rows - 1) * hspace)
    let gapy = rowh * hspace
    let px = x0 + float(c) * (colw + gapx)
    let py = y0 + float(r) * (rowh + gapy)
    return Rect(px - PAD_LEFT, py - PAD_TOP, colw + PAD_LEFT + PAD_RIGHT,
                rowh + PAD_TOP + PAD_BOTTOM)
}