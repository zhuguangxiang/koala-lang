import "koala/math"

/// Axis autoscaling and the linear/log data<->pixel transform for the plot
/// spec layer. Both are resolved Koala-side so the figure spec carries pixel
/// geometry and the renderer only paints.

/// Expand a data range to cover `values` with a fractional `margin` on each
/// side (matplotlib-style autoscale). Returns `(lo, hi)` with `hi > lo`:
/// an empty list yields `(0, 1)`, a constant value `c` yields matplotlib's
/// 5%-of-value default interval (floor 1) expanded by `margin`, otherwise
/// the min/max padded by `margin * span`.
pub func autoscale(values list[float], margin = 0.05) (float, float) {
    if values.len() == 0 {
        return (0.0, 1.0)
    }
    var lo = values[0]
    var hi = values[0]
    for v in values {
        if v < lo {
            lo = v
        }
        if v > hi {
            hi = v
        }
    }
    let span = hi - lo
    if span == 0.0 {
        var base = abs(lo)
        if base < 1.0 {
            base = 1.0
        }
        let half = 0.05 * base * (1.0 + 2.0 * margin)
        return (lo - half, hi + half)
    }
    let pad = margin * span
    return (lo - pad, hi + pad)
}

/// Greatest integer <= `v` (math.floor; std/math has no floor/ceil).
pub func flr(v float) float {
    if v >= 0.0 {
        return math.trunc(v)
    }
    let t = math.trunc(v)
    if t == v {
        return t
    }
    return t - 1.0
}

/// Least integer >= `v` (math.ceil).
pub func cil(v float) float {
    if v <= 0.0 {
        return math.trunc(v)
    }
    let t = math.trunc(v)
    if t == v {
        return t
    }
    return t + 1.0
}

/// Expand a data range for a log scale (matplotlib LogScale autoscale):
/// non-positive values are masked; the `margin` is a fraction of the log10
/// span (e.g. [1, 100] spans 2 decades and with the default 0.05 gains 0.1
/// decade each side). A single value expands to its decade bracket first
/// (matplotlib nonsingular). With no positive values the default view
/// `(0.1, 10)` is returned.
pub func autoscale_log(values list[float], margin = 0.05) (float, float) {
    var lo = 0.0
    var hi = 0.0
    var found = false
    for v in values {
        if v <= 0.0 {
            continue
        }
        if !found {
            lo = v
            hi = v
            found = true
        } else {
            if v < lo {
                lo = v
            }
            if v > hi {
                hi = v
            }
        }
    }
    if !found {
        return (0.1, 10.0)
    }
    if lo == hi {
        let dec = flr(math.log10(lo))
        let dl = math.pow(10.0, dec)
        let dh = math.pow(10.0, dec + 1.0)
        let pad = margin * (math.log10(dh) - math.log10(dl))
        return (math.pow(10.0, math.log10(dl) - pad),
                math.pow(10.0, math.log10(dh) + pad))
    }
    let span = math.log10(hi) - math.log10(lo)
    let pad = margin * span
    return (math.pow(10.0, math.log10(lo) - pad),
            math.pow(10.0, math.log10(hi) + pad))
}

/// A map between a data interval `[lo, hi]` and a pixel interval
/// `[px_lo, px_hi]`, linear or base-10 logarithmic (`log`). The pixel
/// interval may be inverted (px_hi < px_lo) for the y axis, where screen
/// coordinates grow downward. Panics on a zero data span; a log scale
/// requires positive limits (`value` additionally requires a non-zero
/// pixel span, `pixel` a positive data value).
pub class Scale {
    pub let lo float
    pub let hi float
    pub let px_lo float
    pub let px_hi float
    pub let log bool

    pub func __init__(lo float, hi float, px_lo float, px_hi float,
                      log bool = false) {
        if hi == lo {
            panic("plot.Scale: zero data span")
        }
        if log {
            if lo <= 0.0 || hi <= 0.0 {
                panic("plot.Scale: log scale requires positive limits")
            }
        }
        self.lo = lo
        self.hi = hi
        self.px_lo = px_lo
        self.px_hi = px_hi
        self.log = log
    }

    /// Map a data value to its pixel coordinate.
    pub func pixel(v float) float {
        if !log {
            return px_lo + (v - lo) / (hi - lo) * (px_hi - px_lo)
        }
        if v <= 0.0 {
            panic("plot.Scale: log scale requires positive data")
        }
        return px_lo + (math.log10(v) - math.log10(lo)) /
               (math.log10(hi) - math.log10(lo)) * (px_hi - px_lo)
    }

    /// Map a pixel coordinate back to its data value.
    pub func value(px float) float {
        if px_hi == px_lo {
            panic("plot.Scale.value: zero pixel span")
        }
        if !log {
            return lo + (px - px_lo) / (px_hi - px_lo) * (hi - lo)
        }
        let t = (px - px_lo) / (px_hi - px_lo)
        return math.exp(t * (math.log(hi) - math.log(lo)) + math.log(lo))
    }
}