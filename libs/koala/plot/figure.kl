import "koala/json"
import "koala/math"

// ---- boxplot props helpers -------------------------------------------------

// Keys each boxplot props dict accepts (matplotlib key names). Unknown keys
// panic like matplotlib's artist validation.
func bprop_keys(which str) list[str] {
    if which == "box" {
        return ["color", "facecolor", "linestyle", "linewidth"]
    }
    if which == "flier" {
        return ["marker", "markersize", "markeredgecolor",
                "markerfacecolor", "color"]
    }
    if which == "mean" {
        return ["color", "linestyle", "linewidth", "marker", "markersize",
                "markerfacecolor"]
    }
    return ["color", "linestyle", "linewidth"]
}

func bprop_check(props dict[str, any], which str) {
    let keys = bprop_keys(which)
    for (k, _) in props.items() {
        var ok = false
        for sk in keys {
            if k == sk {
                ok = true
            }
        }
        if !ok {
            panic("plot.Axes.boxplot: unexpected key '" + k + "' in " +
                  which + "props (supported: " + ", ".join(keys) + ")")
        }
    }
}

func bprop_str(props dict[str, any], key str) str? {
    if let v = props.get(key) {
        if let s = v as str {
            return s
        }
        panic("plot.Axes.boxplot: '" + key + "' must be a string")
    }
    return nil
}

func bprop_float(props dict[str, any], key str) float? {
    if let v = props.get(key) {
        if let f = v as float {
            return f
        }
        // NOTE: must not write `if let n = v as int { return float(n) }`;
        // the compiler miscompiles float() on an if-let-bound cast
        // (int bits survive as a float payload, JIT and VM both).
        let n = v as int
        if n != nil {
            return float(n)
        }
        panic("plot.Axes.boxplot: '" + key + "' must be a number")
    }
    return nil
}

// Normalize a matplotlib linestyle spelling to the renderer dash key:
// '-' solid, '--' dashed, '-.' dashdot, ':' dotted, ''/'none' no line.
func bprop_ls(ls str, which str) str {
    if ls == "solid" { return "-" }
    if ls == "dashed" { return "--" }
    if ls == "dashdot" { return "-." }
    if ls == "dotted" { return ":" }
    if ls == "none" { return "" }
    if ls == "-" || ls == "--" || ls == "-." || ls == ":" || ls == "" {
        return ls
    }
    panic("'" + ls + "' is not a valid value for linestyle in " + which +
          "props")
}

// matplotlib marker spellings that mean "no marker".
func bprop_marker(m str) str {
    if m == "none" || m == "None" || m == " " { return "" }
    return m
}

/// The two-level Figure/Axes object tree (docs/koala_ml.md §6.2), mirroring
/// matplotlib's object model. v1 holds decoration state and resolves the
/// coordinate frame (rect, ticks, labels, grid, legend) into the figure
/// spec; data artists (plot/scatter/contour/imshow/hist) are added in a
/// later increment without reworking this frame.
///
/// `Figure` dimensions follow matplotlib's inch + dpi convention. Koala
/// has no tuple default arguments, so the constructor takes `width`/
/// `height` in inches as scalars; `pyplot.figure(figsize=(w, h), dpi=...)`
/// provides the exact matplotlib entry point.

/// One subplot: axis limits, labels, title, grid, legend and tick overrides,
/// plus the resolved coordinate frame. Obtained from `Figure.subplot`.
pub class Axes {
    pub var row int
    pub var col int
    pub var xlim (float, float)? = nil
    pub var ylim (float, float)? = nil
    /// Data aspect ratio (matplotlib `Axes.set_aspect`); nil means "auto"
    /// (no adjustment). Set by `imshow(aspect=...)`; applied in `to_spec`
    /// with the limits resolved at draw time.
    var aspect float? = nil
    pub var xlabel_text str = ""
    pub var ylabel_text str = ""
    pub var title_text str = ""
    pub var grid_on bool = false
    pub var legend_on bool = false
    pub var legend_loc str = "best"
    pub var xscale str = "linear"
    pub var yscale str = "linear"
    /// Autoscale padding as a fraction of the data interval on each side
    /// (matplotlib `Axes.margins`); must be > -0.5.
    pub var xmargin float = 0.05
    pub var ymargin float = 0.05
    /// Tick and tick-label appearance (matplotlib `Axes.tick_params`;
    /// v1 takes float sizes in pixels, matplotlib uses points).
    pub var tick_dir str = "out"
    pub var tick_len float = 3.5
    pub var tick_width float = 0.8
    pub var tick_color str = "#000000"
    pub var tick_pad float = 3.5
    pub var label_size float = 10.0
    pub var label_color str = "#000000"
    pub var bottom_on bool = true
    pub var top_on bool = true
    pub var left_on bool = true
    pub var right_on bool = true
    pub var label_bottom_on bool = true
    pub var label_top_on bool = false
    pub var label_left_on bool = true
    pub var label_right_on bool = false
    pub var xticks_override list[float]? = nil
    pub var yticks_override list[float]? = nil
    pub var xtick_labels list[str]? = nil
    pub var ytick_labels list[str]? = nil
    /// Boxplot-managed data interval (positions +- 0.5), accumulated with
    /// expand-only semantics like matplotlib's `bxp` `manage_ticks` (the
    /// dataLim interval never shrinks across boxplot calls).
    var bp_xlim (float, float)? = nil
    var bp_ylim (float, float)? = nil
    pub let artists = list[Artist]()
    var color_index int = 0
    /// The owning figure's dpi (set by `Figure.subplot`), used to convert
    /// point-sized styles like errorbar caps to pixels.
    var dpi int = 100
    /// Whether the axes box and ticks are drawn. `pie` turns this off
    /// (matplotlib `Axes.pie` removes the frame and ticks unless `frame`).
    pub var frame_on bool = true
    /// The colorbar attached to this axes (matplotlib `Figure.colorbar`),
    /// which shrinks the data rect at spec time.
    pub var cbar Colorbar? = nil
    /// The owning figure, set by `Figure.subplot`; `twinx`/`twiny` use it
    /// to register the twin axes on the figure.
    var fig Figure? = nil
    /// Twin linkage (matplotlib `Axes.twinx`/`twiny`): the twin shares the
    /// host's x (twinx) or y (twiny) view; explicit limits propagate both
    /// ways and autoscaling unions the whole share group's data.
    var share_x Axes? = nil
    var share_y Axes? = nil
    var twin_xs list[Axes] = list[Axes]()
    var twin_ys list[Axes] = list[Axes]()
    /// "right" on a twinx axes, "top" on a twiny axes, "" on hosts.
    var twin_side str = ""

    pub func __init__(row int, col int) {
        self.row = row
        self.col = col
    }

    /// Set the x-axis label (matplotlib `Axes.set_xlabel`).
    pub func set_xlabel(text str) {
        xlabel_text = text
    }

    /// Set the y-axis label (matplotlib `Axes.set_ylabel`).
    pub func set_ylabel(text str) {
        ylabel_text = text
    }

    /// Set the axes title (matplotlib `Axes.set_title`).
    pub func set_title(text str) {
        title_text = text
    }

    /// Set the x-axis scale (matplotlib `Axes.set_xscale`); "linear" or
    /// "log". A log scale requires positive data and limits.
    pub func set_xscale(scale str) {
        if scale != "linear" && scale != "log" {
            panic("plot.Axes.set_xscale: '" + scale + "' is not a valid value for scale.")
        }
        xscale = scale
    }

    /// Set the y-axis scale (matplotlib `Axes.set_yscale`); as `set_xscale`.
    pub func set_yscale(scale str) {
        if scale != "linear" && scale != "log" {
            panic("plot.Axes.set_yscale: '" + scale + "' is not a valid value for scale.")
        }
        yscale = scale
    }

    /// The current x-axis scale (`Axes.get_xscale`).
    pub func get_xscale() str = xscale

    /// The current y-axis scale (`Axes.get_yscale`).
    pub func get_yscale() str = yscale

    /// Set the x-axis limits to `[left, right]` (`Axes.set_xlim`). On a
    /// twin axes the call goes through the host, which fans the value out
    /// to every member of the shared-x group.
    pub func set_xlim(left float, right float) {
        if let h = share_x {
            h.set_xlim(left, right)
        } else {
            xlim = (left, right)
            for t in twin_xs {
                t.xlim = (left, right)
            }
        }
    }

    /// Set the y-axis limits to `[bottom, top]` (`Axes.set_ylim`); as
    /// `set_xlim`, propagated through the shared-y group.
    pub func set_ylim(bottom float, top float) {
        if let h = share_y {
            h.set_ylim(bottom, top)
        } else {
            ylim = (bottom, top)
            for t in twin_ys {
                t.ylim = (bottom, top)
            }
        }
    }

    /// Set or retrieve the autoscale margins (matplotlib `Axes.margins`).
    /// With both arguments omitted the current `(xmargin, ymargin)` is
    /// returned; otherwise each provided margin is validated (> -0.5) and
    /// stored. The margins pad the data interval on each side when the
    /// limits are auto-resolved.
    pub func margins(x float? = nil, y float? = nil) (float, float) {
        if x == nil && y == nil {
            return (xmargin, ymargin)
        }
        if let m = x {
            if m < -0.5 {
                panic("margin must be greater than -0.5")
            }
            xmargin = m
        }
        if let m = y {
            if m < -0.5 {
                panic("margin must be greater than -0.5")
            }
            ymargin = m
        }
        return (xmargin, ymargin)
    }

    /// Change the appearance of ticks and tick labels (matplotlib
    /// `Axes.tick_params`). `axis` selects 'x', 'y' or 'both'; `which`
    /// accepts 'major'/'minor'/'both' but only major ticks exist in v1
    /// ('minor'/'both' are accepted and ignore the minor part). Side
    /// toggles only apply to the selected axis. Sizes are pixels
    /// (matplotlib uses points; documented deviation).
    pub func tick_params(axis str? = nil, which str? = nil,
                         direction str? = nil, length float? = nil,
                         width float? = nil, color str? = nil,
                         pad float? = nil, labelsize float? = nil,
                         labelcolor str? = nil, bottom bool? = nil,
                         top bool? = nil, left bool? = nil, right bool? = nil,
                         labelbottom bool? = nil, labeltop bool? = nil,
                         labelleft bool? = nil, labelright bool? = nil) {
        var ax = "both"
        if let v = axis {
            ax = v
        }
        if ax != "x" && ax != "y" && ax != "both" {
            panic("'" + ax + "' is not a valid value for axis. Supported values are 'x', 'y', 'both'")
        }
        var wh = "major"
        if let v = which {
            wh = v
        }
        if wh != "major" && wh != "minor" && wh != "both" {
            panic("'" + wh + "' is not a valid value for which. Supported values are 'major', 'minor', 'both'")
        }
        if let d = direction {
            if d != "in" && d != "out" && d != "inout" {
                panic("'" + d + "' is not a valid value for tickdir. Supported values are 'in', 'out', 'inout'")
            }
            tick_dir = d
        }
        if let v = length {
            tick_len = v
        }
        if let v = width {
            tick_width = v
        }
        if let v = color {
            tick_color = v
        }
        if let v = pad {
            tick_pad = v
        }
        if let v = labelsize {
            label_size = v
        }
        if let v = labelcolor {
            label_color = v
        }
        if ax != "y" {
            if let v = bottom {
                bottom_on = v
            }
            if let v = top {
                top_on = v
            }
            if let v = labelbottom {
                label_bottom_on = v
            }
            if let v = labeltop {
                label_top_on = v
            }
        }
        if ax != "x" {
            if let v = left {
                left_on = v
            }
            if let v = right {
                right_on = v
            }
            if let v = labelleft {
                label_left_on = v
            }
            if let v = labelright {
                label_right_on = v
            }
        }
    }

    /// Show or hide the grid (matplotlib `Axes.grid`).
    pub func grid(on bool = true) {
        grid_on = on
    }

    /// Enable the legend; entries come from labeled artists (`Axes.legend`).
    /// `loc` is matplotlib's legend location ("best", "upper right",
    /// "upper left", "lower left", "lower right", "center"); "best" places
    /// it upper right (a heuristic "best" is deferred).
    pub func legend(loc str = "best") {
        legend_on = true
        legend_loc = loc
    }

    /// Override the x tick positions (`Axes.set_xticks`); optional custom
    /// `labels` (matplotlib's `set_xticks(ticks, labels)`) must match the
    /// tick count. Labels are formatted automatically when omitted.
    pub func set_xticks(ticks list[float], labels list[str]? = nil) {
        if let ls = labels {
            if ls.len() != ticks.len() {
                panic("plot.Axes.set_xticks: labels must match ticks length")
            }
        }
        xticks_override = ticks
        xtick_labels = labels
    }

    /// Override the y tick positions (`Axes.set_yticks`); optional custom
    /// `labels`, as `set_xticks`.
    pub func set_yticks(ticks list[float], labels list[str]? = nil) {
        if let ls = labels {
            if ls.len() != ticks.len() {
                panic("plot.Axes.set_yticks: labels must match ticks length")
            }
        }
        yticks_override = ticks
        ytick_labels = labels
    }

    /// Current x view limits, autoscaled when not set (`Axes.get_xlim`).
    pub func get_xlim() (float, float) = resolved_xlim()

    /// Current y view limits, autoscaled when not set (`Axes.get_ylim`).
    pub func get_ylim() (float, float) = resolved_ylim()

    /// Current x tick positions and their labels (`Axes.get_xticks`).
    pub func get_xticks() (list[float], list[str]) {
        let (xlo, xhi) = resolved_xlim()
        return axis_ticks(xlo, xhi, xticks_override, xtick_labels,
                          xscale == "log")
    }

    /// Current y tick positions and their labels (`Axes.get_yticks`).
    pub func get_yticks() (list[float], list[str]) {
        let (ylo, yhi) = resolved_ylim()
        return axis_ticks(ylo, yhi, yticks_override, ytick_labels,
                          yscale == "log")
    }

    /// Draw a polyline (matplotlib `Axes.plot`). With a single argument the
    /// values are y and x defaults to `0..N-1`. `fmt` is a matplotlib format
    /// string (e.g. "ro--"); explicit `color`/`linestyle`/`marker` keywords
    /// override it. Auto color advances the tab10 cycle. Returns the `Line`.
    ///
    /// Koala is statically typed, so matplotlib's `plot(y, fmt)` positional
    /// form is spelled `plot(y, fmt = "...")` (the second positional slot is
    /// always `y`); `plot(x, y, fmt)` works positionally as in matplotlib.
    pub func plot(x list[float], y list[float]? = nil, fmt str? = nil,
                  label str? = nil, color str? = nil, linestyle str? = nil,
                  linewidth float = 1.5, marker int | str = "none",
                  alpha float = 1.0) Line {
        var xdata = list[float]()
        var ydata = list[float]()
        if let yy = y {
            xdata = x
            ydata = yy
        } else {
            ydata = x
            var i = 0
            while i < ydata.len() {
                xdata.append(float(i))
                i = i + 1
            }
        }
        var ls = "-"
        var mk str? = nil
        var col str? = nil
        if let f = fmt {
            let (fc, fls, fmk) = parse_fmt(f)
            col = fc
            if let l = fls {
                ls = l
            }
            mk = fmk
        }
        if let c = color {
            col = c
        }
        if let l = linestyle {
            ls = l
        }
        // "none" (the default) keeps the fmt marker; anything else
        // overrides, like matplotlib's kwargs-over-fmt rule.
        var mkf str? = mk
        switch marker {
            case is str: {
                if marker != "none" {
                    mkf = marker
                }
            }
            case is int64: {
                mkf = int_marker(marker)
            }
        }
        let cycle = color_cycle()
        let cyc = cycle[color_index % cycle.len()]
        color_index = color_index + 1
        var final_col = cyc
        if let c = col {
            final_col = c
        }
        let line = Line(xdata, ydata, label, final_col, ls, linewidth, mkf, alpha)
        add_artist(line)
        return line
    }

    /// Draw a point cloud (matplotlib `Axes.scatter`). `s` is the marker
    /// area and `c` the color, matching matplotlib's parameter names.
    /// Returns the `Scatter` artist.
    pub func scatter(x list[float], y list[float], s float = 36.0,
                     c str? = nil, marker int | str = "o", label str? = nil,
                     alpha float = 1.0, cvals list[float]? = nil,
                     cmap str = "viridis", vmin float? = nil,
                     vmax float? = nil) Scatter {
        let cycle = color_cycle()
        let cyc = cycle[color_index % cycle.len()]
        color_index = color_index + 1
        var col str? = cyc
        if let cc = c {
            col = cc
        } else if cvals != nil {
            // Numeric coloring takes over from the cycle; an explicit `c`
            // together with `cvals` still reaches Scatter and panics.
            col = nil
        }
        let sc = Scatter(x, y, label, col, resolve_marker(marker), s, alpha,
                         cvals, cmap, vmin, vmax)
        add_artist(sc)
        return sc
    }

    /// Vertical bars (matplotlib `Axes.bar`): `x` is the bar position
    /// (center by default, see `align`), `height` the bar value, baseline
    /// `bottom` (scalar, or a per-bar sequence like matplotlib). `tick_label`
    /// overrides the x ticks with `x`/labels, like matplotlib.
    pub func bar(x list[float], height list[float], width float = 0.8,
                 bottom float | list[float] = 0.0, align str = "center",
                 color str? = nil, edgecolor str? = nil,
                 linewidth float = 1.0, tick_label list[str]? = nil,
                 label str? = nil, alpha float = 1.0) Bar {
        let cycle = color_cycle()
        let cyc = cycle[color_index % cycle.len()]
        color_index = color_index + 1
        var col str? = cyc
        if let cc = color {
            col = cc
        }
        let b = Bar(x, height, false, width, bottom, align, label, col,
                    edgecolor, linewidth, alpha)
        add_artist(b)
        if let tl = tick_label {
            if tl.len() != x.len() {
                panic("plot.Axes.bar: tick_label must match x length")
            }
            set_xticks(x, tl)
        }
        return b
    }

    /// Horizontal bars (matplotlib `Axes.barh`): `y` is the bar position,
    /// `width` the bar value, baseline `left` (scalar, or a per-bar
    /// sequence like matplotlib). `tick_label` overrides the y ticks.
    pub func barh(y list[float], width list[float], height float = 0.8,
                  left float | list[float] = 0.0, align str = "center",
                  color str? = nil, edgecolor str? = nil,
                  linewidth float = 1.0, tick_label list[str]? = nil,
                  label str? = nil, alpha float = 1.0) Bar {
        let cycle = color_cycle()
        let cyc = cycle[color_index % cycle.len()]
        color_index = color_index + 1
        var col str? = cyc
        if let cc = color {
            col = cc
        }
        let b = Bar(y, width, true, height, left, align, label, col,
                    edgecolor, linewidth, alpha)
        add_artist(b)
        if let tl = tick_label {
            if tl.len() != y.len() {
                panic("plot.Axes.barh: tick_label must match y length")
            }
            set_yticks(y, tl)
        }
        return b
    }

    /// Draw contour lines of grid `Z` (matplotlib `Axes.contour`). `levels`
    /// defaults to automatic spacing over Z; `xs`/`ys` default to index
    /// ranges. Returns the `Contour` artist.
    pub func contour(Z list[list[float]], levels list[float]? = nil,
                     cmap str = "viridis", xs list[float]? = nil,
                     ys list[float]? = nil, alpha float = 1.0) Contour {
        let art = Contour(Z, xs, ys, levels, cmap, alpha)
        add_artist(art)
        return art
    }

    /// Display grid `Z` as a raster image (matplotlib `Axes.imshow`),
    /// origin upper. Sets the axis limits to the image extent unless
    /// already fixed. `extent=(left, right, bottom, top)` overrides the
    /// limits like matplotlib; `aspect` is matplotlib's aspect kwarg:
    /// "equal" (default) makes data units square, "auto" disables the
    /// adjustment, a positive number sets the data aspect ratio (applied
    /// at draw time, shrink-only, centered). Returns the `Image` artist.
    pub func imshow(Z list[list[float]], cmap str = "viridis",
                    alpha float = 1.0,
                    extent (float, float, float, float)? = nil,
                    aspect float | str = "equal") Image {
        let art = Image(Z, cmap, alpha)
        add_artist(art)
        if let e = extent {
            let (l, r, b, t) = e
            xlim = (l, r)
            ylim = (b, t)
        } else {
            if xlim == nil {
                xlim = (-0.5, float(art.cols) - 0.5)
            }
            if ylim == nil {
                ylim = (float(art.rows) - 0.5, -0.5)
            }
        }
        switch aspect {
            case is str: {
                if aspect == "auto" {
                    self.aspect = nil
                } else if aspect == "equal" {
                    self.aspect = 1.0
                } else {
                    // mpl float() accepts "inf"/"nan" strings (then fails
                    // the finite check); the Koala parser rejects them.
                    var v = 0.0 / 0.0
                    if aspect != "inf" && aspect != "-inf" && aspect != "nan" {
                        v = aspect.to_float_or(0.0 / 0.0)
                        if math.isnan(v) {
                            panic(format("plot.Axes.imshow: could not convert string to float: '{}'",
                                         aspect))
                        }
                    }
                    if math.isnan(v) || math.isinf(v) || v <= 0.0 {
                        panic("plot.Axes.imshow: aspect must be finite and positive")
                    }
                    self.aspect = v
                }
            }
            case is float: {
                if aspect <= 0.0 || math.isnan(aspect) || math.isinf(aspect) {
                    panic("plot.Axes.imshow: aspect must be finite and positive")
                }
                self.aspect = aspect
            }
        }
        return art
    }

    /// Histogram of `x` (matplotlib `Axes.hist`). Returns the matplotlib
    /// triple `(n, bins, patches)`: counts, bin edges and the `Hist` artist.
    /// `range_` is matplotlib's `range=` (a Koala reserved word). `weights`
    /// replaces each sample's unit contribution; `density` normalizes
    /// counts so the histogram integrates to 1.
    pub func hist(x list[float], bins int = 10, range_ (float, float)? = nil,
                  color str? = nil, label str? = nil, alpha float = 1.0,
                  weights list[float]? = nil,
                  density bool = false) (list[float], list[float], Hist) {
        let (counts, edges) = histogram(x, bins, range_, weights, density)
        let cycle = color_cycle()
        let cyc = cycle[color_index % cycle.len()]
        color_index = color_index + 1
        var col = cyc
        if let c = color {
            col = c
        }
        let art = Hist(counts, edges, col, label, alpha)
        add_artist(art)
        return (counts, edges, art)
    }

    /// Draw a pie chart of `x` (matplotlib `Axes.pie`). Slice fractions are
    /// computed from the sum by default (`normalize`), or taken as-is when
    /// `normalize = false` (sum must not exceed 1). `colors` cycles like
    /// matplotlib, so shorter lists wrap. `autopct` takes "%d%%" and
    /// "%[w].[p]f%%" format strings (callables deferred). `edgecolor`/
    /// `linewidth`/`width` spell matplotlib's `wedgeprops` dict (`width`
    /// cuts a donut hole), `textprops` styles the autopct labels (as a
    /// statically-typed `TextProps` value), and `center_x`/`center_y`
    /// spell `center=(cx, cy)`. Returns the `Pie` artist (matplotlib
    /// returns a variable-length tuple). The frame and ticks are removed
    /// and the limits set to ±1.25 around the center, exactly like
    /// matplotlib.
    pub func pie(x list[float], explode list[float]? = nil,
                 labels list[str]? = nil, colors list[str]? = nil,
                 autopct str? = nil, pctdistance float = 0.6,
                 labeldistance float = 1.1, startangle float = 0.0,
                 radius float = 1.0, counterclock bool = true,
                 center_x float = 0.0, center_y float = 0.0,
                 frame bool = false, normalize bool = true,
                 edgecolor str? = nil, linewidth float = 0.0,
                 width float? = nil, textprops TextProps? = nil,
                 alpha float = 1.0) Pie {
        var i = 0
        while i < x.len() {
            if x[i] < 0.0 {
                panic("plot.Axes.pie: Wedge sizes 'x' must be non negative values")
            }
            if math.isnan(x[i]) || math.isinf(x[i]) {
                panic("plot.Axes.pie: Wedge sizes must be finite numbers")
            }
            i = i + 1
        }
        var total = 0.0
        for v in x {
            total = total + v
        }
        if total == 0.0 {
            panic("plot.Axes.pie: All wedge sizes are zero")
        }
        if !normalize && total > 1.0 {
            panic("plot.Axes.pie: Cannot plot an unnormalized pie with sum(x) > 1")
        }
        if radius <= 0.0 {
            panic("plot.Axes.pie: 'radius' must be a positive number")
        }
        var fracs = list[float]()
        for v in x {
            if normalize {
                fracs.append(v / total)
            } else {
                fracs.append(v)
            }
        }
        var expl = list[float]()
        if let e = explode {
            if e.len() != x.len() {
                panic("plot.Axes.pie: 'explode' must be of length 'x'")
            }
            expl = e
        } else {
            var j = 0
            while j < x.len() {
                expl.append(0.0)
                j = j + 1
            }
        }
        var labs = list[str]()
        if let ls = labels {
            if ls.len() != x.len() {
                panic("plot.Axes.pie: 'labels' must be of length 'x'")
            }
            labs = ls
        } else {
            var j = 0
            while j < x.len() {
                labs.append("")
                j = j + 1
            }
        }
        var cols = list[str]()
        if let cs = colors {
            if cs.len() == 0 {
                panic("plot.Axes.pie: colors must not be empty")
            }
            for c in cs {
                cols.append(resolve_color(c))
            }
        } else {
            cols = color_cycle()
        }
        var autos = list[str]()
        var on = false
        if let ap = autopct {
            on = true
            for f in fracs {
                autos.append(autopct_text(ap, 100.0 * f))
            }
        }
        var ec str? = nil
        if let e = edgecolor {
            ec = resolve_color(e)
        }
        let art = Pie(fracs, expl, labs, cols, autos, on, pctdistance,
                      labeldistance, startangle, radius, counterclock,
                      center_x, center_y, ec, linewidth, width, textprops,
                      alpha)
        add_artist(art)
        xlim = (center_x - 1.25, center_x + 1.25)
        ylim = (center_y - 1.25, center_y + 1.25)
        if !frame {
            frame_on = false
        }
        return art
    }

    /// Draw `y` vs `x` with error bars (matplotlib `Axes.errorbar`).
    /// Scalar `yerr`/`xerr` are symmetric for every point; per-point lists
    /// are spelled `yerrs`/`xerrs`, asymmetric 2xN errors `yerrs2`/`xerrs2`
    /// (row 0 lower, row 1 upper). A NaN error skips that point's bars.
    /// `lolims`/`uplims`/`xlolims`/`xuplims` draw one-sided bars like
    /// matplotlib: the bar runs from the data value toward the arrow tip,
    /// a cap marks the data end, an arrow head marks the tip, and
    /// autoscaling extends only to the tip. The flag is a scalar bool or,
    /// for per-point masks, the `_ls` list variant (`lolims_ls` etc.;
    /// static typing cannot take bool-or-list in one parameter). `fmt`
    /// follows `plot` ("none" draws only the error bars); `ecolor`
    /// defaults to the line color and `elinewidth` to `linewidth`.
    /// `capsize`/`capthick` are in points like matplotlib. Returns the
    /// `Errorbar` artist (matplotlib returns an ErrorbarContainer).
    pub func errorbar(x list[float], y list[float], yerr float? = nil,
                      xerr float? = nil, yerrs list[float]? = nil,
                      xerrs list[float]? = nil,
                      yerrs2 list[list[float]]? = nil,
                      xerrs2 list[list[float]]? = nil,
                      fmt str = "", ecolor str? = nil,
                      elinewidth float? = nil, capsize float = 0.0,
                      capthick float = 1.0, errorevery int = 1,
                      barsabove bool = false,
                      lolims bool = false, uplims bool = false,
                      xlolims bool = false, xuplims bool = false,
                      lolims_ls list[bool]? = nil,
                      uplims_ls list[bool]? = nil,
                      xlolims_ls list[bool]? = nil,
                      xuplims_ls list[bool]? = nil,
                      label str? = nil, color str? = nil,
                      linestyle str? = nil, linewidth float = 1.5,
                      marker int | str = "none", alpha float = 1.0) Errorbar {
        if x.len() != y.len() {
            panic("plot.Axes.errorbar: 'x' and 'y' must have the same size")
        }
        if yerr != nil && yerrs != nil {
            panic("plot.Axes.errorbar: 'yerr' and 'yerrs' are mutually exclusive")
        }
        if yerr != nil && yerrs2 != nil {
            panic("plot.Axes.errorbar: 'yerr' and 'yerrs2' are mutually exclusive")
        }
        if yerrs != nil && yerrs2 != nil {
            panic("plot.Axes.errorbar: 'yerrs' and 'yerrs2' are mutually exclusive")
        }
        if xerr != nil && xerrs != nil {
            panic("plot.Axes.errorbar: 'xerr' and 'xerrs' are mutually exclusive")
        }
        if xerr != nil && xerrs2 != nil {
            panic("plot.Axes.errorbar: 'xerr' and 'xerrs2' are mutually exclusive")
        }
        if xerrs != nil && xerrs2 != nil {
            panic("plot.Axes.errorbar: 'xerrs' and 'xerrs2' are mutually exclusive")
        }
        if errorevery < 1 {
            panic("plot.Axes.errorbar: 'errorevery' must be >= 1")
        }
        // Resolve y/x errors into per-point lower/upper half-lengths.
        var ylo = list[float]()
        var yhi = list[float]()
        if let es2 = yerrs2 {
            if es2.len() != 2 {
                panic("plot.Axes.errorbar: 'yerrs2' must have exactly 2 rows")
            }
            if es2[0].len() != y.len() || es2[1].len() != y.len() {
                panic("plot.Axes.errorbar: 'yerrs2' rows must match 'y' length")
            }
            var i = 0
            while i < y.len() {
                ylo.append(es2[0][i])
                yhi.append(es2[1][i])
                i = i + 1
            }
        } else if let es = yerrs {
            if es.len() != y.len() {
                panic("plot.Axes.errorbar: 'yerrs' must match 'y' length")
            }
            var i = 0
            while i < es.len() {
                ylo.append(es[i])
                yhi.append(es[i])
                i = i + 1
            }
        } else if let e = yerr {
            var i = 0
            while i < y.len() {
                ylo.append(e)
                yhi.append(e)
                i = i + 1
            }
        }
        var xlo = list[float]()
        var xhi = list[float]()
        if let es2 = xerrs2 {
            if es2.len() != 2 {
                panic("plot.Axes.errorbar: 'xerrs2' must have exactly 2 rows")
            }
            if es2[0].len() != x.len() || es2[1].len() != x.len() {
                panic("plot.Axes.errorbar: 'xerrs2' rows must match 'x' length")
            }
            var i = 0
            while i < x.len() {
                xlo.append(es2[0][i])
                xhi.append(es2[1][i])
                i = i + 1
            }
        } else if let es = xerrs {
            if es.len() != x.len() {
                panic("plot.Axes.errorbar: 'xerrs' must match 'x' length")
            }
            var i = 0
            while i < es.len() {
                xlo.append(es[i])
                xhi.append(es[i])
                i = i + 1
            }
        } else if let e = xerr {
            var i = 0
            while i < x.len() {
                xlo.append(e)
                xhi.append(e)
                i = i + 1
            }
        }
        for e in ylo {
            if e < 0.0 {
                panic("plot.Axes.errorbar: 'yerr' must not contain negative values")
            }
        }
        for e in yhi {
            if e < 0.0 {
                panic("plot.Axes.errorbar: 'yerr' must not contain negative values")
            }
        }
        for e in xlo {
            if e < 0.0 {
                panic("plot.Axes.errorbar: 'xerr' must not contain negative values")
            }
        }
        for e in xhi {
            if e < 0.0 {
                panic("plot.Axes.errorbar: 'xerr' must not contain negative values")
            }
        }
        // One-sided masks: bit0 = lower limit (arrow up/right), bit1 =
        // upper limit (arrow down/left). mpl ignores the flag silently
        // when no error is given, so the mask only matters with errors.
        if let l = lolims_ls {
            if l.len() != y.len() {
                panic("plot.Axes.errorbar: 'lolims_ls' must match 'y' length")
            }
        }
        if let l = uplims_ls {
            if l.len() != y.len() {
                panic("plot.Axes.errorbar: 'uplims_ls' must match 'y' length")
            }
        }
        if let l = xlolims_ls {
            if l.len() != x.len() {
                panic("plot.Axes.errorbar: 'xlolims_ls' must match 'x' length")
            }
        }
        if let l = xuplims_ls {
            if l.len() != x.len() {
                panic("plot.Axes.errorbar: 'xuplims_ls' must match 'x' length")
            }
        }
        var ylims = list[int]()
        var i = 0
        while i < y.len() {
            var m = 0
            if lolims {
                m = 1
            }
            if let l = lolims_ls {
                if l[i] {
                    m = 1
                }
            }
            if uplims {
                m = m + 2
            }
            if let l = uplims_ls {
                if l[i] {
                    m = m + 2
                }
            }
            ylims.append(m)
            i = i + 1
        }
        var xlims = list[int]()
        i = 0
        while i < x.len() {
            var m = 0
            if xlolims {
                m = 1
            }
            if let l = xlolims_ls {
                if l[i] {
                    m = 1
                }
            }
            if xuplims {
                m = m + 2
            }
            if let l = xuplims_ls {
                if l[i] {
                    m = m + 2
                }
            }
            xlims.append(m)
            i = i + 1
        }
        var ls = ""
        var mk str? = nil
        var col str? = nil
        if fmt == "none" {
            // Error bars only: no data line, no markers.
        } else {
            if fmt != "" {
                let (fc, fls, fmk) = parse_fmt(fmt)
                col = fc
                if let l = fls {
                    ls = l
                }
                mk = fmk
            } else {
                ls = "-"
            }
        }
        if let c = color {
            col = c
        }
        if let l = linestyle {
            ls = l
        }
        // "none" (the default) keeps the fmt marker; anything else
        // overrides, like matplotlib's kwargs-over-fmt rule.
        var mkf str? = mk
        switch marker {
            case is str: {
                if marker != "none" {
                    mkf = marker
                }
            }
            case is int64: {
                mkf = int_marker(marker)
            }
        }
        let cycle = color_cycle()
        let cyc = cycle[color_index % cycle.len()]
        color_index = color_index + 1
        var final_col = cyc
        if let c = col {
            final_col = c
        }
        var ec = ecolor
        var elw = linewidth
        if let w = elinewidth {
            elw = w
        }
        let cap_px = 2.0 * capsize * float(self.dpi) / 72.0
        // Arrow heads use the cap size when caps are on, else 6 pt like
        // matplotlib's rcParams default marker size for one-sided bars.
        var caretsize_px = 6.0 * float(self.dpi) / 72.0
        if capsize > 0.0 {
            caretsize_px = cap_px
        }
        let art = Errorbar(x, y, ylo, yhi, xlo, xhi, ylims, xlims, ls, mkf,
                           linewidth, final_col, label, ec, elw, cap_px,
                           capthick, errorevery, barsabove, caretsize_px,
                           alpha)
        add_artist(art)
        return art
    }

    /// Fill the area between two horizontal curves (matplotlib
    /// `Axes.fill_between`). `y2` defaults to 0; `where` masks regions
    /// (gaps split the fill into separate polygons); `step` stair-steps
    /// both boundaries ("pre"/"post"/"mid"); `interpolate` extends the
    /// polygons across gaps to the crossing points of `y1` and `y2`, the
    /// same geometry as matplotlib's FillBetweenPolyCollection.
    pub func fill_between(x list[float], y1 list[float], y2 list[float]? = nil,
                          where list[bool]? = nil, interpolate bool = false,
                          step str? = nil, color str? = nil,
                          alpha float? = nil, label str? = nil) FillBetween {
        if x.len() != y1.len() {
            panic("plot.Axes.fill_between: 'x' has size " +
                  format("{}", x.len()) + ", but 'y1' has an unequal size of " +
                  format("{}", y1.len()))
        }
        var y2data = list[float]()
        if let yy = y2 {
            if yy.len() != x.len() {
                panic("plot.Axes.fill_between: 'y2' has an unequal size of " +
                      format("{}", yy.len()))
            }
            y2data = yy
        } else {
            var i = 0
            while i < x.len() {
                y2data.append(0.0)
                i = i + 1
            }
        }
        if let w = where {
            if w.len() != x.len() {
                panic("plot.Axes.fill_between: where size (" +
                      format("{}", w.len()) + ") does not match 'x' size (" +
                      format("{}", x.len()) + ")")
            }
        }
        if let st = step {
            if st != "pre" && st != "post" && st != "mid" {
                panic("plot.Axes.fill_between: '" + st + "' is not a valid value for step. Supported values are 'pre', 'post', 'mid'")
            }
        }
        let cycle = color_cycle()
        let cyc = cycle[color_index % cycle.len()]
        color_index = color_index + 1
        var final_col = cyc
        if let c = color {
            final_col = c
        }
        if let a = alpha {
            if a < 0.0 || a > 1.0 {
                panic("plot.Axes.fill_between: alpha must be in [0, 1]")
            }
        }
        // Split the x range into contiguous `where` runs; each run becomes
        // one closed polygon (top boundary forward, bottom boundary back).
        let paths = list[list[float]]()
        var i = 0
        while i < x.len() {
            var on = true
            if let w = where {
                on = w[i]
            }
            if !on {
                i = i + 1
                continue
            }
            var j = i
            while j + 1 < x.len() {
                var nxt = true
                if let w = where {
                    nxt = w[j + 1]
                }
                if !nxt {
                    break
                }
                j = j + 1
            }
            let top = band_boundary(x, y1, i, j, step, true)
            let bot = band_boundary(x, y2data, i, j, step, false)
            if interpolate {
                // Extend the polygon across the gaps to where y1 meets y2
                // (matplotlib's _get_interpolating_points). The start
                // crossing lands between x[i-1] and x[i], the end crossing
                // between x[j] and x[j+1]; with no gap on that side the
                // boundary vertex already is the crossing.
                if i > 0 {
                    let (cx, cy) = crossing_point(x, y1, y2data, i)
                    top.insert(0, cx)
                    top.insert(1, cy)
                }
                if j + 1 < x.len() {
                    let (cx, cy) = crossing_point(x, y1, y2data, j + 1)
                    top.append(cx)
                    top.append(cy)
                }
            }
            var k = 0
            while k < bot.len() {
                top.append(bot[k])
                k = k + 1
            }
            paths.append(top)
            i = j + 1
        }
        let art = FillBetween(x, y1, y2data, paths, label, final_col, alpha)
        add_artist(art)
        return art
    }

    /// A stepwise polyline (matplotlib `Axes.step`). The staircase points
    /// are expanded at call time (`where` pre/post/mid, as matplotlib's
    /// drawstyle); autoscale sees the raw data. Returns the `Line`.
    pub func step(x list[float], y list[float], where str = "pre",
                  fmt str = "", label str? = nil, color str? = nil,
                  linestyle str? = nil, linewidth float = 1.5,
                  marker int | str = "none", alpha float = 1.0) Line {
        if x.len() != y.len() {
            panic("plot.Axes.step: 'x' and 'y' must have the same size")
        }
        if where != "pre" && where != "post" && where != "mid" {
            panic("plot.Axes.step: '" + where + "' is not a valid value for where. Supported values are 'pre', 'post', 'mid'")
        }
        if x.len() == 0 {
            return self.plot(x, y, fmt, label, color, linestyle, linewidth,
                             marker, alpha)
        }
        let xs = list[float]()
        let ys = list[float]()
        xs.append(x[0])
        ys.append(y[0])
        var i = 0
        while i + 1 < x.len() {
            if where == "pre" {
                // matplotlib "pre": y[i+1] holds on (x[i], x[i+1]].
                xs.append(x[i])
                ys.append(y[i + 1])
                xs.append(x[i + 1])
                ys.append(y[i + 1])
            } else if where == "post" {
                // matplotlib "post": y[i] holds on [x[i], x[i+1]).
                xs.append(x[i + 1])
                ys.append(y[i])
                xs.append(x[i + 1])
                ys.append(y[i + 1])
            } else {
                let m = (x[i] + x[i + 1]) / 2.0
                xs.append(m)
                ys.append(y[i])
                xs.append(m)
                ys.append(y[i + 1])
            }
            i = i + 1
        }
        if where == "mid" {
            xs.append(x[x.len() - 1])
            ys.append(y[y.len() - 1])
        }
        return self.plot(xs, ys, fmt, label, color, linestyle, linewidth,
                         marker, alpha)
    }

    /// A stem plot (matplotlib `Axes.stem`): a baseline plus a stem and a
    /// marker head per point. matplotlib's literal 'C0-'/'o'/'C3-' defaults
    /// are replicated (the color cycle is not advanced); `linefmt`/
    /// `markerfmt`/`basefmt` accept the usual fmt strings, "none" hides
    /// the respective part. Returns the `Stem` artist.
    pub func stem(x list[float], y list[float], linefmt str? = nil,
                  markerfmt str? = nil, basefmt str? = nil,
                  bottom float = 0.0, label str? = nil,
                  orientation str = "vertical", alpha float = 1.0) Stem {
        if x.len() != y.len() {
            panic("plot.Axes.stem: 'x' and 'y' must have the same size")
        }
        if orientation != "vertical" && orientation != "horizontal" {
            panic("plot.Axes.stem: '" + orientation + "' is not a valid value for orientation. Supported values are 'vertical', 'horizontal'")
        }
        var ls = "-"
        var lc str? = nil
        if let lf = linefmt {
            if lf == "none" || lf == " " {
                ls = ""
            } else {
                let (fc, fls, _) = parse_fmt(lf)
                lc = fc
                if let l = fls {
                    ls = l
                }
            }
        }
        var mk = "o"
        var mc str? = nil
        if let mf = markerfmt {
            if mf == "none" || mf == " " {
                mk = ""
            } else {
                let (fc, _, fmk) = parse_fmt(mf)
                mc = fc
                if let m = fmk {
                    mk = m
                }
            }
        }
        var bs = "-"
        var bc str? = nil
        if let bf = basefmt {
            if bf == "none" || bf == " " {
                bs = ""
            } else {
                let (fc, fls, _) = parse_fmt(bf)
                bc = fc
                if let l = fls {
                    bs = l
                }
            }
        }
        var line_col = "#1f77b4"
        if let c = lc {
            line_col = c
        }
        var mk_col = line_col
        if let c = mc {
            mk_col = c
        }
        var base_col = "#d62728"
        if let c = bc {
            base_col = c
        }
        let ms_px = 6.0 * float(self.dpi) / 72.0
        let art = Stem(x, y, bottom, orientation, line_col, ls, mk_col, mk,
                       ms_px, base_col, bs, label, alpha)
        add_artist(art)
        return art
    }

    /// Filled contours of grid `Z` (matplotlib `Axes.contourf`). `Z[i][j]`
    /// is row i, column j; `xs` (length = cols) and `ys` (length = rows)
    /// locate the grid lines. Like matplotlib, automatic levels are
    /// `maxn_levels(zmin, zmax, 7)` (MaxNLocator nbins=7) and each band is
    /// filled with the colormap color at its midpoint; `extend` "min"/"max"/
    /// "both" adds below/above bands at the colormap ends. Default grid
    /// coordinates ascend with row 0 at the bottom (matplotlib contourf
    /// defaults to origin "lower"); the limits are set to the grid extent
    /// like matplotlib. A constant grid fills the whole domain with one
    /// band color. Returns the `FilledContour` artist.
    pub func contourf(Z list[list[float]], levels list[float]? = nil,
                      cmap str = "viridis", xs list[float]? = nil,
                      ys list[float]? = nil, alpha float? = nil,
                      extend str? = nil, label str? = nil) FilledContour {
        let rows = Z.len()
        if rows < 2 {
            panic("plot.Axes.contourf: Z needs at least 2 rows")
        }
        let cols = Z[0].len()
        if cols < 2 {
            panic("plot.Axes.contourf: Z needs at least 2 cols")
        }
        for row in Z {
            if row.len() != cols {
                panic("plot.Axes.contourf: Z must be rectangular")
            }
        }
        if let e = extend {
            if e != "min" && e != "max" && e != "both" {
                panic("plot.Axes.contourf: '" + e + "' is not a valid value for extend. Supported values are 'min', 'max', 'both'")
            }
        }
        var lvs = list[float]()
        if let l = levels {
            if l.len() < 2 {
                panic("Filled contours require at least 2 levels.")
            }
            var i = 1
            while i < l.len() {
                if l[i] <= l[i - 1] {
                    panic("Contour levels must be increasing")
                }
                i = i + 1
            }
            lvs = l
        } else {
            var lo = Z[0][0]
            var hi = Z[0][0]
            for row in Z {
                for v in row {
                    if v < lo {
                        lo = v
                    }
                    if v > hi {
                        hi = v
                    }
                }
            }
            if hi == lo {
                // matplotlib expands a constant field by half a step on
                // each side so the whole domain fills with one band color
                // at cmap(norm(z)).
                lvs.append(lo - 0.5)
                lvs.append(lo + 0.5)
            } else {
                lvs = maxn_levels(lo, hi, 7)
            }
        }
        var xax = list[float]()
        if let x = xs {
            if x.len() != cols {
                panic("plot.Axes.contourf: xs length must match Z columns")
            }
            xax = x
        } else {
            var i = 0
            while i < cols {
                xax.append(float(i))
                i = i + 1
            }
        }
        var yax = list[float]()
        if let y = ys {
            if y.len() != rows {
                panic("plot.Axes.contourf: ys length must match Z rows")
            }
            yax = y
        } else {
            var i = 0
            while i < rows {
                yax.append(float(i))
                i = i + 1
            }
        }
        var cols_ = list[str]()
        let bands = contourf_paths(Z, xax, yax, lvs, extend)
        var ext_below = false
        var ext_above = false
        if let e = extend {
            ext_below = e == "min" || e == "both"
            ext_above = e == "max" || e == "both"
        }
        var bi = 0
        while bi < bands.len() {
            var idx = bi
            if ext_below {
                idx = idx - 1
            }
            var t = 0.5
            if idx < 0 {
                t = 0.0
            } else if idx >= lvs.len() - 1 {
                t = 1.0
            } else {
                let mid = (lvs[idx] + lvs[idx + 1]) / 2.0
                t = (mid - lvs[0]) / (lvs[lvs.len() - 1] - lvs[0])
            }
            let (r, g, b) = colormap(cmap, t)
            cols_.append(rgb_hex(r, g, b))
            bi = bi + 1
        }
        let art = FilledContour(xax, yax, cols_, bands, lvs, cmap, alpha, label)
        add_artist(art)
        if xlim == nil {
            if let b = bounds(xax) {
                xlim = b
            }
        }
        if ylim == nil {
            if let b = bounds(yax) {
                ylim = b
            }
        }
        return art
    }

    /// Box-and-whisker plot of each dataset in `x` (matplotlib
    /// `Axes.boxplot`). `whis` is a scalar fence multiplier or a sequence
    /// of two percentiles (0-100). The props dicts take matplotlib key
    /// names: `boxprops` color/facecolor/linestyle/linewidth;
    /// `whiskerprops`/`capprops`/`medianprops` color/linestyle/linewidth;
    /// `flierprops` marker/markersize/markeredgecolor/markerfacecolor/
    /// color; `meanprops` color/linestyle/linewidth/marker/markersize/
    /// markerfacecolor. `sym` overrides the flier marker and colors.
    /// `patch_artist` fills the box with `facecolor` (default C0). Colors
    /// match matplotlib defaults (black box/whiskers/caps, C1 median, C2
    /// mean). NaN or empty datasets are skipped like matplotlib's
    /// invisible NaN geometry. `manage_ticks` sets positions as ticks and
    /// the position axis to (first-0.5, last+0.5). Returns the `Boxplot`
    /// artist.
    pub func boxplot(x list[list[float]], tick_labels list[str]? = nil,
                     notch bool = false, sym str? = nil,
                     orientation str = "vertical",
                     whis float | list[float] = 1.5,
                     positions list[float]? = nil,
                     widths list[float]? = nil,
                     patch_artist bool = false, showmeans bool = false,
                     showfliers bool = true, meanline bool = false,
                     manage_ticks bool = true,
                     label str? = nil,
                     boxprops dict[str, any]? = nil,
                     whiskerprops dict[str, any]? = nil,
                     capprops dict[str, any]? = nil,
                     flierprops dict[str, any]? = nil,
                     medianprops dict[str, any]? = nil,
                     meanprops dict[str, any]? = nil) Boxplot {
        let n = x.len()
        if orientation != "vertical" && orientation != "horizontal" {
            panic("plot.Axes.boxplot: '" + orientation + "' is not a valid value for orientation. Supported values are 'horizontal', 'vertical'")
        }
        if let tl = tick_labels {
            if tl.len() != n {
                panic(format("The number of labels ({}) must match the number of columns ({}).", tl.len(), n))
            }
        }
        // An empty input still gets one position (tick [1], axis 0.5..1.5)
        // like matplotlib, but no box geometry.
        let nd = if n == 0 { 1 } else { n }
        var poss = list[float]()
        if let ps = positions {
            if ps.len() != n {
                panic("List of boxplot statistics and `positions` values must have same the length")
            }
            poss = ps
        } else {
            var i = 1
            while i <= nd {
                poss.append(float(i))
                i = i + 1
            }
        }
        var wids = list[float]()
        if let ws = widths {
            if ws.len() != n {
                panic("List of boxplot statistics and `widths` values must have same the length")
            }
            for w in ws {
                wids.append(w / 2.0)
            }
        } else {
            var span = 0.0
            if nd > 1 {
                span = poss[nd - 1] - poss[0]
            }
            var w = 0.15 * span
            if w < 0.15 {
                w = 0.15
            }
            if w > 0.5 {
                w = 0.5
            }
            let hw = w / 2.0
            var i = 0
            while i < nd {
                wids.append(hw)
                i = i + 1
            }
        }
        // Style defaults from matplotlib's boxplot rcParams; each props
        // dict overrides its group. Linestyle spellings normalize to the
        // renderer dash keys; marker sizes convert points to pixels.
        var bcol = "#000000"
        var bface = "#1f77b4"
        var bls = "-"
        var blw = 1.0
        var wcol = "#000000"
        var wls = "-"
        var wlw = 1.0
        var ccol = "#000000"
        var cls = "-"
        var clw = 1.0
        var mcol = "#ff7f0e"
        var mls = "-"
        var mlw = 1.0
        var fmk = "o"
        var fcol = "#000000"
        var fface = "none"
        var fsz = 6.0
        var meancol = "#2ca02c"
        var meanmk = "^"
        var meanface = "#2ca02c"
        var meansz = 6.0
        var meanls = "--"
        var meanlw = 1.0
        var has_meanmk = false
        var has_meanls = false
        if let p = boxprops {
            bprop_check(p, "box")
            if let c = bprop_str(p, "color") { bcol = c }
            if let c = bprop_str(p, "facecolor") { bface = c }
            if let c = bprop_str(p, "linestyle") { bls = bprop_ls(c, "box") }
            if let w = bprop_float(p, "linewidth") { blw = w }
        }
        if let p = whiskerprops {
            bprop_check(p, "whisker")
            if let c = bprop_str(p, "color") { wcol = c }
            if let c = bprop_str(p, "linestyle") { wls = bprop_ls(c, "whisker") }
            if let w = bprop_float(p, "linewidth") { wlw = w }
        }
        if let p = capprops {
            bprop_check(p, "cap")
            if let c = bprop_str(p, "color") { ccol = c }
            if let c = bprop_str(p, "linestyle") { cls = bprop_ls(c, "cap") }
            if let w = bprop_float(p, "linewidth") { clw = w }
        }
        if let p = flierprops {
            bprop_check(p, "flier")
            if let m = bprop_str(p, "marker") { fmk = bprop_marker(m) }
            if let c = bprop_str(p, "markeredgecolor") { fcol = c }
            if let c = bprop_str(p, "markerfacecolor") { fface = c }
            if let s = bprop_float(p, "markersize") { fsz = s }
            // 'color' sets the Line2D color, invisible for marker-only
            // fliers (matplotlib quirk, accepted for parity).
        }
        if let p = medianprops {
            bprop_check(p, "median")
            if let c = bprop_str(p, "color") { mcol = c }
            if let c = bprop_str(p, "linestyle") { mls = bprop_ls(c, "median") }
            if let w = bprop_float(p, "linewidth") { mlw = w }
        }
        if let p = meanprops {
            bprop_check(p, "mean")
            if let c = bprop_str(p, "color") { meancol = c }
            if let c = bprop_str(p, "linestyle") {
                meanls = bprop_ls(c, "mean")
                has_meanls = true
            }
            if let w = bprop_float(p, "linewidth") { meanlw = w }
            if let m = bprop_str(p, "marker") {
                meanmk = bprop_marker(m)
                has_meanmk = true
            }
            if let s = bprop_float(p, "markersize") { meansz = s }
            if let c = bprop_str(p, "markerfacecolor") { meanface = c }
        }
        // matplotlib fills in the meanline defaults only when the user
        // did not set them: meanline drops the marker, marker mode drops
        // the line, but an explicit marker/linestyle is kept.
        if meanline {
            if !has_meanmk { meanmk = "" }
        } else {
            if !has_meanls { meanls = "" }
        }
        // matplotlib forces a solid edge on filled patch boxes.
        if patch_artist {
            bls = "-"
        }
        if let sf = sym {
            if sf == "none" || sf == " " {
                fmk = ""
            } else {
                let (fc, _, mk) = parse_fmt(sf)
                if let c = fc {
                    fcol = c
                }
                if let m = mk {
                    fmk = m
                }
                fface = fcol
            }
        }
        let stats = list[BoxStat]()
        var i = 0
        while i < n {
            if !box_skip(x[i]) {
                stats.append(box_stats(x[i], poss[i], wids[i], whis))
            }
            i = i + 1
        }
        let flier_px = fsz * float(self.dpi) / 72.0
        let mean_px = meansz * float(self.dpi) / 72.0
        let art = Boxplot(stats, notch, patch_artist, showmeans, meanline,
                          showfliers, fmk, fcol, fface, flier_px, mean_px,
                          orientation, label, bcol, bface, bls, blw, wcol,
                          wls, wlw, ccol, cls, clw, mcol, mls, mlw, meancol,
                          meanmk, meanface, meanls, meanlw)
        add_artist(art)
        if manage_ticks {
            let lo = poss[0] - 0.5
            let hi = poss[nd - 1] + 0.5
            if orientation == "vertical" {
                let (merged, mlabels) = merge_box_ticks(xticks_override,
                                                        xtick_labels, poss,
                                                        tick_labels)
                xticks_override = merged
                xtick_labels = mlabels
                if let r = bp_xlim {
                    let (a, b) = r
                    bp_xlim = (min(a, lo), max(b, hi))
                } else {
                    bp_xlim = (lo, hi)
                }
            } else {
                let (merged, mlabels) = merge_box_ticks(yticks_override,
                                                        ytick_labels, poss,
                                                        tick_labels)
                yticks_override = merged
                ytick_labels = mlabels
                if let r = bp_ylim {
                    let (a, b) = r
                    bp_ylim = (min(a, lo), max(b, hi))
                } else {
                    bp_ylim = (lo, hi)
                }
            }
        }
        return art
    }

    /// Append boxplot positions to existing tick overrides, keeping the
    /// label list aligned (matplotlib `bxp` appends to the FixedLocator and
    /// FixedFormatter instead of replacing them).
    func merge_box_ticks(existing list[float]?, existing_labels list[str]?,
                         poss list[float],
                         new_labels list[str]?) (list[float], list[str]?) {
        if let ov = existing {
            var dec = 0
            if ov.len() >= 2 {
                let gap = abs(ov[1] - ov[0])
                if gap > 0.0 {
                    dec = tick_decimals(gap)
                }
            }
            var need_labels = existing_labels != nil || new_labels != nil
            var mlabels = list[str]()
            if need_labels {
                if let el = existing_labels {
                    for t in el {
                        mlabels.append(t)
                    }
                } else {
                    for t in ov {
                        mlabels.append(format_tick(t, dec))
                    }
                }
                if let nl = new_labels {
                    for t in nl {
                        mlabels.append(t)
                    }
                } else {
                    for p in poss {
                        mlabels.append(format_tick(p, dec))
                    }
                }
            }
            for p in poss {
                ov.append(p)
            }
            if need_labels {
                return (ov, mlabels)
            }
            return (ov, nil)
        }
        return (poss, new_labels)
    }

    /// Resolved x limits: explicit override, else autoscale across artist
    /// data extents, else the unit interval. A zero-span override is
    /// expanded so the scale stays non-degenerate.
    func resolved_xlim() (float, float) {
        if let r = xlim {
            let (a, b) = r
            if a == b {
                if xscale == "log" {
                    if a <= 0.0 {
                        panic("plot.Axes: 'xlim' must be positive for log scale")
                    }
                    return autoscale_log([a], xmargin)
                }
                return (a - 0.5, b + 0.5)
            }
            if xscale == "log" {
                if a <= 0.0 || b <= 0.0 {
                    panic("plot.Axes: 'xlim' must be positive for log scale")
                }
            }
            return (a, b)
        }
        if let h = share_x {
            // Follow the host's stored view (explicit limit or the union
            // autoscaled at host resolution); the host always resolves
            // before its twins in `Figure.to_spec`.
            if let r = h.xlim {
                let (a, b) = r
                if a == b {
                    if xscale == "log" {
                        if a <= 0.0 {
                            panic("plot.Axes: 'xlim' must be positive for log scale")
                        }
                        return autoscale_log([a], xmargin)
                    }
                    return (a - 0.5, b + 0.5)
                }
                if xscale == "log" {
                    if a <= 0.0 || b <= 0.0 {
                        panic("plot.Axes: 'xlim' must be positive for log scale")
                    }
                }
                return (a, b)
            }
        }
        var lo = 0.0
        var hi = 0.0
        var found = false
        for m in x_group() {
            if let r = m.bp_xlim {
                let (a, b) = r
                if !found {
                    lo = a
                    hi = b
                    found = true
                } else {
                    if a < lo {
                        lo = a
                    }
                    if b > hi {
                        hi = b
                    }
                }
            }
            for art in m.artists {
                if let b = art.xbounds() {
                    let (a, c) = b
                    if !found {
                        lo = a
                        hi = c
                        found = true
                    } else {
                        if a < lo {
                            lo = a
                        }
                        if c > hi {
                            hi = c
                        }
                    }
                }
            }
        }
        if !found {
            if xscale == "log" {
                return (0.1, 10.0)
            }
            return (0.0, 1.0)
        }
        if xscale == "log" {
            return autoscale_log([lo, hi], xmargin)
        }
        let (plo, phi) = autoscale([lo, hi], xmargin)
        // matplotlib sticky edges (autoscale_view): the largest sticky
        // below the data floor and the smallest above the data ceiling
        // clamp the margin-expanded view.
        var flo = plo
        var fhi = phi
        var stickies = list[float]()
        for m in x_group() {
            for art in m.artists {
                for s in art.xstickies() {
                    stickies.append(s)
                }
            }
        }
        if stickies.len() > 0 {
            let tol = 1e-5 * abs(hi - lo)
            var blo = lo
            var found = false
            for s in stickies {
                if s < lo + tol {
                    if !found || s > blo {
                        blo = s
                        found = true
                    }
                }
            }
            if found && flo < blo {
                flo = blo
            }
            var bhi = hi
            found = false
            for s in stickies {
                if s > hi - tol {
                    if !found || s < bhi {
                        bhi = s
                        found = true
                    }
                }
            }
            if found && fhi > bhi {
                fhi = bhi
            }
        }
        // The boxplot interval is sticky at both ends (bxp attaches sticky
        // edges at pos +- 0.5 to the median lines).
        for m in x_group() {
            if let r = m.bp_xlim {
                let (a, b) = r
                if flo < a {
                    flo = a
                }
                if fhi > b {
                    fhi = b
                }
            }
        }
        return (flo, fhi)
    }

    /// The axes sharing this one's x view: the host plus every twinx twin
    /// (matplotlib shared-view semantics); for plain axes just itself.
    func x_group() list[Axes] {
        var g = list[Axes]()
        if let h = share_x {
            g.append(h)
            for t in h.twin_xs {
                g.append(t)
            }
        } else {
            g.append(self)
            for t in twin_xs {
                g.append(t)
            }
        }
        return g
    }

    /// Resolved y limits (autoscale across artist data extents).
    func resolved_ylim() (float, float) {
        if let r = ylim {
            let (a, b) = r
            if a == b {
                if yscale == "log" {
                    if a <= 0.0 {
                        panic("plot.Axes: 'ylim' must be positive for log scale")
                    }
                    return autoscale_log([a], ymargin)
                }
                return (a - 0.5, b + 0.5)
            }
            if yscale == "log" {
                if a <= 0.0 || b <= 0.0 {
                    panic("plot.Axes: 'ylim' must be positive for log scale")
                }
            }
            return (a, b)
        }
        if let h = share_y {
            if let r = h.ylim {
                let (a, b) = r
                if a == b {
                    if yscale == "log" {
                        if a <= 0.0 {
                            panic("plot.Axes: 'ylim' must be positive for log scale")
                        }
                        return autoscale_log([a], ymargin)
                    }
                    return (a - 0.5, b + 0.5)
                }
                if yscale == "log" {
                    if a <= 0.0 || b <= 0.0 {
                        panic("plot.Axes: 'ylim' must be positive for log scale")
                    }
                }
                return (a, b)
            }
        }
        var lo = 0.0
        var hi = 0.0
        var found = false
        for m in y_group() {
            if let r = m.bp_ylim {
                let (a, b) = r
                if !found {
                    lo = a
                    hi = b
                    found = true
                } else {
                    if a < lo {
                        lo = a
                    }
                    if b > hi {
                        hi = b
                    }
                }
            }
            for art in m.artists {
                if let b = art.ybounds() {
                    let (a, c) = b
                    if !found {
                        lo = a
                        hi = c
                        found = true
                    } else {
                        if a < lo {
                            lo = a
                        }
                        if c > hi {
                            hi = c
                        }
                    }
                }
            }
        }
        if !found {
            if yscale == "log" {
                return (0.1, 10.0)
            }
            return (0.0, 1.0)
        }
        if yscale == "log" {
            return autoscale_log([lo, hi], ymargin)
        }
        let (plo, phi) = autoscale([lo, hi], ymargin)
        // matplotlib sticky edges (autoscale_view): the largest sticky
        // below the data floor and the smallest above the data ceiling
        // clamp the margin-expanded view.
        var flo = plo
        var fhi = phi
        var stickies = list[float]()
        for m in y_group() {
            for art in m.artists {
                for s in art.ystickies() {
                    stickies.append(s)
                }
            }
        }
        if stickies.len() > 0 {
            let tol = 1e-5 * abs(hi - lo)
            var blo = lo
            var found = false
            for s in stickies {
                if s < lo + tol {
                    if !found || s > blo {
                        blo = s
                        found = true
                    }
                }
            }
            if found && flo < blo {
                flo = blo
            }
            var bhi = hi
            found = false
            for s in stickies {
                if s > hi - tol {
                    if !found || s < bhi {
                        bhi = s
                        found = true
                    }
                }
            }
            if found && fhi > bhi {
                fhi = bhi
            }
        }
        // The boxplot interval is sticky at both ends (bxp attaches sticky
        // edges at pos +- 0.5 to the median lines).
        for m in y_group() {
            if let r = m.bp_ylim {
                let (a, b) = r
                if flo < a {
                    flo = a
                }
                if fhi > b {
                    fhi = b
                }
            }
        }
        return (flo, fhi)
    }

    /// The axes sharing this one's y view: the host plus every twiny twin
    /// (matplotlib shared-view semantics); for plain axes just itself.
    func y_group() list[Axes] {
        var g = list[Axes]()
        if let h = share_y {
            g.append(h)
            for t in h.twin_ys {
                g.append(t)
            }
        } else {
            g.append(self)
            for t in twin_ys {
                g.append(t)
            }
        }
        return g
    }

    /// Serialize this axes' resolved coordinate frame into the figure spec,
    /// given its subplot `cell` rectangle. Data artists append to `items`
    /// in a later increment.
    pub func to_spec(cell Rect) json.Object {
        let p = plot_rect(cell)
        var pl = p
        var cbs json.Object? = nil
        if let cb = cbar {
            if cb.orientation == "vertical" {
                let f = cb.fraction + cb.pad
                pl = Rect(p.x, p.y, (1.0 - f) * p.w, p.h)
                let hh = cb.shrink * p.h
                let cy = p.y + (p.h - hh) / 2.0
                cbs = cb.to_spec(Rect(p.x + (1.0 - cb.fraction) * p.w, cy,
                                      cb.fraction * p.w, hh))
            } else {
                let f = cb.fraction + cb.pad
                pl = Rect(p.x, p.y, p.w, (1.0 - f) * p.h)
                let ww = cb.shrink * p.w
                let cx = p.x + (p.w - ww) / 2.0
                cbs = cb.to_spec(Rect(cx, p.y + (1.0 - cb.fraction) * p.h, ww,
                                      cb.fraction * p.h))
            }
        }
        let (xlo, xhi) = resolved_xlim()
        let (ylo, yhi) = resolved_ylim()
        // Aspect adjustment (matplotlib apply_aspect): shrink the data box
        // so its pixel w/h equals (|xspan|/|yspan|)/aspect, centered in the
        // original position, never growing. The figure-size factor of the
        // matplotlib formula cancels in pixel units; a degenerate span
        // (identical limits) skips the adjustment.
        if let a = aspect {
            let xspan = abs(xhi - xlo)
            let yspan = abs(yhi - ylo)
            if xspan > 0.0 && yspan > 0.0 {
                let r = (xspan / yspan) / a
                if pl.w / pl.h > r {
                    let w2 = pl.h * r
                    pl = Rect(pl.x + (pl.w - w2) / 2.0, pl.y, w2, pl.h)
                } else {
                    let h2 = pl.w / r
                    pl = Rect(pl.x, pl.y + (pl.h - h2) / 2.0, pl.w, h2)
                }
            }
        }
        let xs = Scale(xlo, xhi, pl.x, pl.right(), xscale == "log")
        let ys = Scale(ylo, yhi, pl.bottom(), pl.y, yscale == "log")
        let (xvals, xlabels) = axis_ticks(xlo, xhi, xticks_override, xtick_labels, xscale == "log")
        let (yvals, ylabels) = axis_ticks(ylo, yhi, yticks_override, ytick_labels, yscale == "log")

        let o = json.Object()
        o["rect"] = rect_json(cell)
        o["plot"] = rect_json(pl)
        o["frame"] = json.Boolean(frame_on)
        o["xscale"] = json.String(xscale)
        o["yscale"] = json.String(yscale)
        o["xlim"] = pair_json(xlo, xhi)
        o["ylim"] = pair_json(ylo, yhi)
        o["xticks"] = ticks_json(xvals, xlabels, xs)
        o["yticks"] = ticks_json(yvals, ylabels, ys)
        let ts = json.Object()
        ts["direction"] = json.String(tick_dir)
        ts["length"] = json.Float(tick_len)
        ts["width"] = json.Float(tick_width)
        ts["color"] = json.String(tick_color)
        ts["pad"] = json.Float(tick_pad)
        ts["labelsize"] = json.Float(label_size)
        ts["labelcolor"] = json.String(label_color)
        ts["bottom"] = json.Boolean(bottom_on)
        ts["top"] = json.Boolean(top_on)
        ts["left"] = json.Boolean(left_on)
        ts["right"] = json.Boolean(right_on)
        ts["labelbottom"] = json.Boolean(label_bottom_on)
        ts["labeltop"] = json.Boolean(label_top_on)
        ts["labelleft"] = json.Boolean(label_left_on)
        ts["labelright"] = json.Boolean(label_right_on)
        o["tickstyle"] = ts
        // twinx hides the x-axis (ticks, labels and the xlabel); twiny
        // moves the xlabel to the top and hides the ylabel (its y-axis is
        // invisible). Host axes keep the standard positions.
        if twin_side == "top" {
            o["xlabel"] = text_json(xlabel_text, pl.center_x(), cell.y + PAD_TOP / 2.0)
        } else if twin_side == "" {
            o["xlabel"] = text_json(xlabel_text, pl.center_x(), pl.bottom() + PAD_BOTTOM / 2.0)
        }
        if twin_side == "right" {
            o["ylabel"] = text_json(ylabel_text, cell.x + cell.w - PAD_RIGHT / 2.0, pl.center_y())
        } else if twin_side == "" {
            o["ylabel"] = text_json(ylabel_text, cell.x + PAD_LEFT / 2.0, pl.center_y())
        }
        o["title"] = text_json(title_text, pl.center_x(), cell.y + PAD_TOP / 2.0)
        o["grid"] = grid_json(grid_on, xvals, xs, yvals, ys)
        o["legend"] = legend_json(legend_on, artists, legend_loc)
        o["items"] = items_json(artists, xs, ys, pl)
        if let c = cbs {
            o["colorbar"] = c
        }
        return o
    }

    /// Append an artist to this axes and register it on the figure's
    /// artist->axes registry (`colorbar` uses it to locate a mappable's
    /// axes, like matplotlib's `mappable.axes`).
    func add_artist(art Artist) Artist {
        artists.append(art)
        if let f = fig {
            f.artist_ax[art] = self
        }
        return art
    }

    /// Resolve and cache this axes' view limits. `Figure.to_spec` calls
    /// this on every axes (hosts before their twins); a twin writes the
    /// shared view back to the host so all group members emit the same
    /// interval.
    func resolve_lims() {
        let (a, b) = resolved_xlim()
        if let h = share_x {
            h.xlim = (a, b)
        } else {
            xlim = (a, b)
        }
        let (c, d) = resolved_ylim()
        if let h = share_y {
            h.ylim = (c, d)
        } else {
            ylim = (c, d)
        }
    }

    /// Create a twin axes sharing this axes' x-axis (matplotlib
    /// `Axes.twinx`): same cell and x view, its own y-axis drawn on the
    /// right, x-axis hidden. Limit changes propagate both ways and
    /// autoscaling unions the share group's data (matplotlib semantics).
    pub func twinx() Axes {
        let t = Axes(row, col)
        t.dpi = dpi
        t.fig = fig
        t.share_x = self
        t.twin_side = "right"
        t.bottom_on = false
        t.top_on = false
        t.label_bottom_on = false
        t.label_top_on = false
        t.left_on = false
        t.label_left_on = false
        t.right_on = true
        t.label_right_on = true
        twin_xs.append(t)
        if let f = fig {
            f.axes.append(t)
        }
        return t
    }

    /// Create a twin axes sharing this axes' y-axis (matplotlib
    /// `Axes.twiny`): same cell and y view, its own x-axis drawn on top,
    /// y-axis hidden.
    pub func twiny() Axes {
        let t = Axes(row, col)
        t.dpi = dpi
        t.fig = fig
        t.share_y = self
        t.twin_side = "top"
        t.bottom_on = false
        t.top_on = true
        t.label_bottom_on = false
        t.label_top_on = true
        t.left_on = false
        t.right_on = false
        t.label_left_on = false
        t.label_right_on = false
        twin_ys.append(t)
        if let f = fig {
            f.axes.append(t)
        }
        return t
    }
}

/// A figure: pixel canvas plus a grid of axes. Dimensions are given in
/// inches and dpi (matplotlib convention) and resolved to pixels.
pub class Figure {
    pub let width float
    pub let height float
    pub let dpi int
    pub var rows int = 1
    pub var cols int = 1
    pub let axes = list[Axes]()
    /// Artist -> owning axes registry (matplotlib's `mappable.axes`), fed
    /// by `Axes.add_artist`; `colorbar` uses it to find the target axes.
    var artist_ax dict[Artist, Axes] = dict[Artist, Axes]()
    pub var background str = "#ffffff"
    /// Figure-fraction layout (left, bottom, right, top of the data area,
    /// measured from the figure's bottom-left corner); nil = the default
    /// fixed pixel-margin layout.
    var frac_adj (float, float, float, float)? = nil
    var frac_wspace float = 0.2
    var frac_hspace float = 0.2
    var suptitle_text str? = nil
    var suptitle_x float = 0.5
    var suptitle_y float = 0.98
    var suptitle_ha str = "center"
    var suptitle_va str = "top"

    pub func __init__(width float = 6.4, height float = 4.8, dpi int = 100) {
        if width <= 0.0 || height <= 0.0 {
            panic("plot.Figure: width and height must be > 0")
        }
        if dpi <= 0 {
            panic("plot.Figure: dpi must be > 0")
        }
        self.dpi = dpi
        self.width = width * float(dpi)
        self.height = height * float(dpi)
    }

    /// Add (or reuse) the subplot at 1-based row-major `index` in a
    /// `rows x cols` grid (matplotlib `plt.subplot` / `Figure.add_subplot`).
    pub func subplot(rows int, cols int, index int) Axes {
        if rows < 1 || cols < 1 {
            panic("plot.Figure.subplot: rows and cols must be >= 1")
        }
        if index < 1 || index > rows * cols {
            panic("plot.Figure.subplot: index out of range")
        }
        self.rows = rows
        self.cols = cols
        let r = (index - 1) / cols
        let c = (index - 1) % cols
        for ax in axes {
            if ax.row == r && ax.col == c {
                return ax
            }
        }
        let ax = Axes(r, c)
        ax.dpi = self.dpi
        ax.fig = self
        axes.append(ax)
        return ax
    }

    /// Serialize the whole figure (canvas + every axes' resolved frame) to
    /// the figure-spec JSON object consumed by the renderer.
    pub func to_spec() json.Object {
        let o = json.Object()
        o["width"] = json.Float(width)
        o["height"] = json.Float(height)
        o["background"] = json.String(background)
        // Pass 1: resolve view limits in axes order (hosts precede their
        // twins) so shared-x/y groups emit one consistent interval.
        for ax in axes {
            ax.resolve_lims()
        }
        let arr = json.Array()
        for ax in axes {
            var cell = cell_rect(width, height, rows, cols, ax.row, ax.col)
            if let a = frac_adj {
                let (l, b, r, t) = a
                cell = cell_rect_frac(width, height, rows, cols, ax.row,
                                      ax.col, l, b, r, t, frac_wspace,
                                      frac_hspace)
            }
            arr.append(ax.to_spec(cell))
        }
        o["axes"] = arr
        if let st = suptitle_text {
            let so = json.Object()
            so["text"] = json.String(st)
            so["x"] = json.Float(suptitle_x * width)
            // matplotlib's y fraction is measured from the figure bottom;
            // spec pixels grow downward, so flip it.
            so["y"] = json.Float((1.0 - suptitle_y) * height)
            so["ha"] = json.String(suptitle_ha)
            so["va"] = json.String(suptitle_va)
            o["suptitle"] = so
        }
        return o
    }

    /// Tune the subplot layout via figure fractions (matplotlib
    /// `Figure.subplots_adjust`). Omitted parameters keep their current
    /// value; `wspace`/`hspace` are fractions of the average column width /
    /// row height. A call with all parameters omitted is a no-op (like
    /// matplotlib). The first real call seeds the fractions from the
    /// default pixel-margin layout, so partial adjustments don't jump the
    /// geometry (multi-cell gaps are approximated by the fraction model).
    pub func subplots_adjust(left float? = nil, bottom float? = nil,
                             right float? = nil, top float? = nil,
                             wspace float? = nil, hspace float? = nil) {
        if left == nil && bottom == nil && right == nil && top == nil &&
           wspace == nil && hspace == nil {
            return
        }
        var l = 0.0
        var b = 0.0
        var r = 0.0
        var t = 0.0
        if let a = frac_adj {
            let (fl, fb, fr, ft) = a
            l = fl
            b = fb
            r = fr
            t = ft
        } else {
            // Seed from the pixel-margin layout so partial adjustments
            // start from the current geometry.
            l = (FIG_MARGIN + PAD_LEFT) / width
            b = (FIG_MARGIN + PAD_BOTTOM) / height
            r = 1.0 - (FIG_MARGIN + PAD_RIGHT) / width
            t = 1.0 - (FIG_MARGIN + PAD_TOP) / height
            let cw = (width - 2.0 * FIG_MARGIN - float(cols - 1) * CELL_GAP) / float(cols)
            let ch = (height - 2.0 * FIG_MARGIN - float(rows - 1) * CELL_GAP) / float(rows)
            if cw > 0.0 {
                frac_wspace = CELL_GAP / cw
            }
            if ch > 0.0 {
                frac_hspace = CELL_GAP / ch
            }
        }
        if let v = left {
            l = v
        }
        if let v = bottom {
            b = v
        }
        if let v = right {
            r = v
        }
        if let v = top {
            t = v
        }
        if l >= r {
            panic("left cannot be >= right")
        }
        if b >= t {
            panic("bottom cannot be >= top")
        }
        frac_adj = (l, b, r, t)
        if let v = wspace {
            frac_wspace = v
        }
        if let v = hspace {
            frac_hspace = v
        }
    }

    /// Shrink the figure margins to the minimum needed for the axes
    /// decorations (matplotlib `Figure.tight_layout`). v1 uses the fixed
    /// pixel margin constants as the content extents (no text measurement,
    /// documented deviation); `pad` scales the outer margins and
    /// `w_pad`/`h_pad` override the horizontal/vertical outer margins in
    /// pixels.
    pub func tight_layout(pad float = 1.08, w_pad float? = nil,
                          h_pad float? = nil) {
        if axes.len() == 0 {
            return
        }
        if pad <= 0.0 {
            panic("plot.Figure.tight_layout: pad must be > 0")
        }
        var ol = PAD_LEFT
        var or_ = PAD_RIGHT
        var ot = PAD_TOP
        var ob = PAD_BOTTOM
        if let v = w_pad {
            ol = v
            or_ = v
        }
        if let v = h_pad {
            ot = v
            ob = v
        }
        ol = ol * pad
        or_ = or_ * pad
        ot = ot * pad
        ob = ob * pad
        let x0 = ol
        let x1 = width - or_
        let y0 = ot
        let y1 = height - ob
        var colw = x1 - x0
        if cols > 1 {
            colw = (x1 - x0 - float(cols - 1) * CELL_GAP) / float(cols)
        }
        var rowh = y1 - y0
        if rows > 1 {
            rowh = (y1 - y0 - float(rows - 1) * CELL_GAP) / float(rows)
        }
        if colw <= 0.0 || rowh <= 0.0 {
            panic("plot.Figure.tight_layout: figure too small")
        }
        frac_adj = (x0 / width, ob / height, x1 / width, 1.0 - ot / height)
        frac_wspace = CELL_GAP / colw
        frac_hspace = CELL_GAP / rowh
    }

    /// Add a centered figure-level title (matplotlib `Figure.suptitle`).
    /// `x`/`y` are figure fractions; `ha`/`va` anchor the text. A later
    /// call replaces the previous title (like matplotlib).
    pub func suptitle(t str, x float = 0.5, y float = 0.98,
                      ha str = "center", va str = "top") {
        if ha != "center" && ha != "right" && ha != "left" {
            panic("'" + ha + "' is not a valid value for align. Supported values are 'center', 'right', 'left'")
        }
        if va != "top" && va != "bottom" && va != "center" &&
           va != "baseline" && va != "center_baseline" {
            panic("'" + va + "' is not a valid value for align. Supported values are 'top', 'bottom', 'center', 'baseline', 'center_baseline'")
        }
        suptitle_text = t
        suptitle_x = x
        suptitle_y = y
        suptitle_ha = ha
        suptitle_va = va
    }

    /// Attach a colorbar for `mappable` (matplotlib `Figure.colorbar`).
    /// With `mappable` omitted, the last color-mapped artist on the target
    /// axes is used (matplotlib's current-image registry approximation).
    /// The data rect of the owning axes shrinks by `fraction + pad` and
    /// the bar fills the freed strip (`pad` defaults to 0.05 vertical /
    /// 0.15 horizontal, like matplotlib); `shrink` scales the bar around
    /// its center. A second call replaces the previous bar.
    pub func colorbar(mappable Artist? = nil, ax Axes? = nil,
                      orientation str? = nil, fraction float = 0.15,
                      pad float? = nil, shrink float = 1.0,
                      label str? = nil, ticks list[float]? = nil) Colorbar {
        if let ori = orientation {
            if ori != "vertical" && ori != "horizontal" {
                panic("'" + ori + "' is not a valid value for orientation. Supported values are None, 'vertical', 'horizontal'")
            }
        }
        let ori = orientation ?? "vertical"
        // mpl: an explicit mappable's own axes is the default target; with
        // no mappable, the current image's axes (the last axes holding a
        // mappable). Only otherwise fall back to the last axes.
        var target = ax
        if target == nil {
            if let m = mappable {
                target = artist_ax.get(m)
            }
        }
        if target == nil {
            var i = axes.len() - 1
            while i >= 0 && target == nil {
                for art in axes[i].artists {
                    if art.cmap_range() != nil {
                        target = axes[i]
                    }
                }
                i = i - 1
            }
        }
        if target == nil {
            if axes.len() == 0 {
                panic("plot.Figure.colorbar: no Axes present")
            }
            target = axes[axes.len() - 1]
        }
        var rvmin float? = nil
        var rvmax float? = nil
        var rcmap str? = nil
        var def_ticks list[float]? = nil
        if let m = mappable {
            if let r = m.cmap_range() {
                let (lo, hi, cm, dt) = r
                rvmin = lo
                rvmax = hi
                rcmap = cm
                def_ticks = dt
            } else {
                panic("plot.colorbar: mappable of kind '" + m.kind() + "' has no colormap")
            }
        } else {
            if let tg = target {
                var i = tg.artists.len() - 1
                while i >= 0 {
                    if let r = tg.artists[i].cmap_range() {
                        let (lo, hi, cm, dt) = r
                        rvmin = lo
                        rvmax = hi
                        rcmap = cm
                        def_ticks = dt
                        break
                    }
                    i = i - 1
                }
            }
            if rvmin == nil {
                panic("No mappable was found to use for colorbar creation. First define a mappable such as an image (with imshow) or a contour set (with contourf).")
            }
        }
        var tk = ticks
        if tk == nil {
            tk = def_ticks
        }
        var pd = 0.15
        if ori == "vertical" {
            pd = 0.05
        }
        if let v = pad {
            pd = v
        }
        let cb = Colorbar(ori, fraction, pd, shrink, label, tk, rvmin!,
                          rvmax!, rcmap!)
        if let tg = target {
            tg.cbar = cb
        }
        return cb
    }
}