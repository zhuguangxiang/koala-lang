/// Colormaps for the plot spec layer (the geometry behind `imshow` and
/// scalar-colored `scatter`). Each maps a normalized scalar `t` (clamped to
/// [0, 1]) to an `(r, g, b)` triple of 0..255 ints, resolved Koala-side so
/// the spec carries pixel colors and the renderer only fills.
///
/// The 256-entry tables behind the named maps are vendored from matplotlib
/// 3.11.2 (see cmap_data.kl for provenance); `t` indexes them exactly like
/// matplotlib: entry `int(t * 255)`.

/// Clamp `t` into [0, 1].
func clamp01(t float) float {
    if t < 0.0 {
        return 0.0
    }
    if t > 1.0 {
        return 1.0
    }
    return t
}

/// Look `t` up in a 256-entry table like matplotlib's ListedColormap:
/// index `int(t * 255)` after clamping.
func table_color(tab list[list[int]], t float) (int, int, int) {
    let i = int(clamp01(t) * 255.0)
    return (tab[i][0], tab[i][1], tab[i][2])
}

/// Grayscale: t=0 -> black, t=1 -> white.
pub func gray(t float) (int, int, int) {
    let c = int(round(clamp01(t) * 255.0))
    return (c, c, c)
}

/// matplotlib viridis (CC0, vendored table).
pub func viridis(t float) (int, int, int) = table_color(_viridis_tab, t)

/// matplotlib plasma (CC0, vendored table).
pub func plasma(t float) (int, int, int) = table_color(_plasma_tab, t)

/// matplotlib inferno (CC0, vendored table).
pub func inferno(t float) (int, int, int) = table_color(_inferno_tab, t)

/// matplotlib magma (CC0, vendored table).
pub func magma(t float) (int, int, int) = table_color(_magma_tab, t)

/// matplotlib cividis (BSD-style, vendored table).
pub func cividis(t float) (int, int, int) = table_color(_cividis_tab, t)

/// matplotlib turbo (Apache-2.0, vendored table).
pub func turbo(t float) (int, int, int) = table_color(_turbo_tab, t)

/// matplotlib jet (sampled from its segment data, vendored table).
pub func jet(t float) (int, int, int) = table_color(_jet_tab, t)

/// matplotlib coolwarm (sampled from its segment data, vendored table).
pub func coolwarm(t float) (int, int, int) = table_color(_coolwarm_tab, t)

/// Normalize `values` into [0, 1] like matplotlib's default `Normalize`:
/// `(v - min) / (max - min)`. An empty list yields an empty list; a
/// constant list maps every value to 0.0 (matplotlib returns 0 when
/// vmin == vmax).
pub func normalize(values list[float]) list[float] {
    let n = values.len()
    var out = list[float]()
    if n == 0 {
        return out
    }
    var lo = values[0]
    var hi = values[0]
    for v in values {
        if v < lo {
            lo = v
        }
        if v > hi {
            hi = v
        }
    }
    for v in values {
        if hi == lo {
            out.append(0.0)
        } else {
            out.append((v - lo) / (hi - lo))
        }
    }
    return out
}

/// Normalize `values` into [0, 1] against an explicit range, like
/// matplotlib's `Normalize(vmin, vmax)`: `(v - vmin) / (vmax - vmin)`.
/// Out-of-range values are not clamped here (the color table lookup
/// clamps, like matplotlib's colormap call). A constant range maps every
/// value to 0.0 (matplotlib returns 0 when vmin == vmax). Panics if
/// `vmin > vmax`, with matplotlib's message.
pub func normalize_range(values list[float], vmin float, vmax float) list[float] {
    if vmin > vmax {
        panic("minvalue must be less than or equal to maxvalue")
    }
    var out = list[float]()
    if vmin == vmax {
        for v in values {
            out.append(0.0)
        }
        return out
    }
    for v in values {
        out.append((v - vmin) / (vmax - vmin))
    }
    return out
}

/// Resolve a colormap by name at normalized `t` (clamped to [0, 1]), from
/// the full matplotlib registry (all 91 base maps, cmap_data.kl). A
/// trailing `_r` suffix reverses the map like matplotlib:
/// `name_r(t)` == `name(1 - t)`. Panics on an unknown name.
pub func colormap(name str, t float) (int, int, int) {
    var key = name
    var rev = false
    if key.ends_with("_r") {
        rev = true
        key = key.substr(0, key.len() - 2)
    }
    // gray/grey are exactly linear; the formula matches matplotlib's
    // continuous map at every t, where a 256-entry table would be off by
    // one at half-integers (t=0.5 -> 127 vs matplotlib's 128).
    if key == "gray" || key == "grey" {
        if rev {
            return gray(1.0 - t)
        }
        return gray(t)
    }
    var i = 0
    while i < _cmap_names.len() {
        if _cmap_names[i] == key {
            if rev {
                return table_color(_cmap_tables[i], 1.0 - t)
            }
            return table_color(_cmap_tables[i], t)
        }
        i = i + 1
    }
    panic(format("plot.colormap: unknown colormap '{}'", name))
}
