/// Histogram binning for the plot spec layer (the geometry behind
/// `pyplot.hist`). Mirrors `numpy.histogram` semantics: equal-width bins
/// from an integer count, or explicit bin edges; values outside the range
/// are ignored and the rightmost edge is inclusive. Computed Koala-side so
/// the spec carries resolved bar geometry.
///
/// Note: matplotlib's `range=` keyword is `range_` here because `range` is
/// a reserved word in Koala.

/// Build `nbins + 1` equal-width ascending edges spanning `[lo, hi]`. The
/// last edge is exactly `hi` (no float drift). Panics on `nbins < 1` or
/// `hi <= lo`.
pub func bin_edges(nbins int, lo float, hi float) list[float] {
    if nbins < 1 {
        panic("plot.bin_edges: nbins must be >= 1")
    }
    if hi <= lo {
        panic("plot.bin_edges: require hi > lo")
    }
    let w = (hi - lo) / float(nbins)
    let edges = list[float]()
    var i = 0
    while i <= nbins {
        if i == nbins {
            edges.append(hi)
        } else {
            edges.append(lo + float(i) * w)
        }
        i = i + 1
    }
    return edges
}

/// Count `x` into the bins defined by ascending `edges` (len >= 2). Returns
/// `(counts, edges)` with `counts.len() == edges.len() - 1`. A value equal
/// to the last edge falls in the rightmost bin; values outside
/// `[edges[0], edges[last]]` are ignored. Panics on fewer than 2 edges or
/// non-ascending edges.
pub func histogram_edges(x list[float], edges list[float]) (list[int], list[float]) {
    if edges.len() < 2 {
        panic("plot.histogram: need at least 2 edges")
    }
    var i = 1
    while i < edges.len() {
        if edges[i] <= edges[i - 1] {
            panic("plot.histogram: edges must be ascending")
        }
        i = i + 1
    }
    let nb = edges.len() - 1
    let counts = list[int]()
    i = 0
    while i < nb {
        counts.append(0)
        i = i + 1
    }
    let lo = edges[0]
    let hi = edges[nb]
    for v in x {
        if v < lo || v > hi {
            continue
        }
        var b = nb - 1
        var j = 0
        var found = false
        while j < nb - 1 && !found {
            if v < edges[j + 1] {
                b = j
                found = true
            }
            j = j + 1
        }
        counts[b] = counts[b] + 1
    }
    return (counts, edges)
}

/// Histogram of `x` with `bins` equal-width bins over `range_` (or the data
/// min/max when nil; an empty sample defaults to `(0, 1)` and a constant
/// sample `c` expands to `(c-0.5, c+0.5)`, matching matplotlib). Returns
/// `(counts, edges)`. Panics on `bins < 1` or a non-positive range span.
pub func histogram(x list[float], bins int = 10, range_ (float, float)? = nil) (list[int], list[float]) {
    if bins < 1 {
        panic("plot.histogram: bins must be >= 1")
    }
    var lo = 0.0
    var hi = 1.0
    if let r = range_ {
        let (a, b) = r
        lo = a
        hi = b
    } else if x.len() > 0 {
        lo = x[0]
        hi = x[0]
        for v in x {
            if v < lo {
                lo = v
            }
            if v > hi {
                hi = v
            }
        }
        if hi == lo {
            lo = lo - 0.5
            hi = hi + 0.5
        }
    }
    let edges = bin_edges(bins, lo, hi)
    return histogram_edges(x, edges)
}