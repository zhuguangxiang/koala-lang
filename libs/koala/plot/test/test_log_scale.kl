// RUN: koala --test %s

// Unit tests for the log axis (Scale log mode + autoscale_log in
// transform.kl, Axes.set_xscale/set_yscale in figure.kl, log decade
// ticks in spec.kl, plt semilogx/semilogy/loglog in pyplot.kl).
// Limits and margins are matplotlib 3.11.2's own values (probed in the
// venv): margin = 0.05 of the log10 span; a single value expands to its
// decade bracket first; ticks are bracketing decades clipped to the view.

import "std/ut"
import "koala/plot"
import "koala/plot" as plt
import "koala/json"

func first_axes(fig plot.Figure) json.Object {
    return fig.to_spec().get_array("axes").get_object(0)
}

@test
func test_scale_log_pixel() {
    let s = plot.Scale(1.0, 100.0, 0.0, 100.0, true)
    ut.assert_float_close(s.pixel(1.0), 0.0)
    ut.assert_float_close(s.pixel(10.0), 50.0)
    ut.assert_float_close(s.pixel(100.0), 100.0)
    ut.assert_float_close(s.value(50.0), 10.0)
    ut.assert_float_close(s.value(0.0), 1.0)
    ut.assert_float_close(s.value(100.0), 100.0)
}

@should_panic("plot.Scale: log scale requires positive limits")
func test_scale_log_bad_limits() {
    plot.Scale(0.0, 10.0, 0.0, 100.0, true)
}

@should_panic("plot.Scale: log scale requires positive data")
func test_scale_log_bad_value() {
    let s = plot.Scale(1.0, 100.0, 0.0, 100.0, true)
    s.pixel(0.0)
}

@should_panic("plot.Axes.set_xscale: 'xx' is not a valid value for scale.")
func test_set_xscale_bad() {
    plot.Figure().subplot(1, 1, 1).set_xscale("xx")
}

@should_panic("plot.Axes.set_yscale: 'xx' is not a valid value for scale.")
func test_set_yscale_bad() {
    plot.Figure().subplot(1, 1, 1).set_yscale("xx")
}

@test
func test_plot_log_autoscale() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xscale("log")
    ax.plot([1.0, 100.0], [1.0, 100.0])
    let a = first_axes(fig)
    // x: 2 decades -> +/- 0.1 decade margins; y: linear margins.
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.7943282347242815)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 125.89254117941677)
    ut.assert_float_close(a.get_array("ylim").get_float(0), -3.95)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 104.95)
    ut.assert_eq(a.get_str("xscale"), "log")
    ut.assert_eq(a.get_str("yscale"), "linear")
}

@test
func test_plot_log_single_value() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xscale("log")
    ax.plot([5.0], [5.0])
    let a = first_axes(fig)
    // single 5 -> decade bracket [1, 10] +/- 0.05 decade (matplotlib).
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.8912509381337456)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 11.220184543019636)
}

@test
func test_log_empty_axes() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).set_xscale("log")
    let a = first_axes(fig)
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.1)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 10.0)
}

@test
func test_log_ticks() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xscale("log")
    ax.plot([1.0, 100.0], [1.0, 100.0])
    let (vals, labels) = ax.get_xticks()
    ut.assert_int_eq(vals.len(), 3)
    ut.assert_float_close(vals[0], 1.0)
    ut.assert_float_close(vals[1], 10.0)
    ut.assert_float_close(vals[2], 100.0)
    ut.assert_eq(labels[0], "10⁰")
    ut.assert_eq(labels[1], "10¹")
    ut.assert_eq(labels[2], "10²")
}

@test
func test_log_ticks_negative_exp() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xscale("log")
    ax.set_xlim(0.1, 1000.0)
    let (vals, labels) = ax.get_xticks()
    ut.assert_int_eq(vals.len(), 5)
    ut.assert_eq(labels[0], "10⁻¹")
    ut.assert_eq(labels[1], "10⁰")
    ut.assert_eq(labels[4], "10³")
}

@test
func test_log_point_pixels() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xscale("log")
    ax.set_xlim(1.0, 100.0)
    ax.set_ylim(0.0, 1.0)
    ax.plot([10.0], [1.0])
    let it = first_axes(fig).get_array("items").get_object(0)
    let p = it.get_array("points").get_object(0)
    ut.assert_float_close(p.get_float("x"), 340.0)
    ut.assert_float_close(p.get_float("y"), 50.0)
}

@should_panic("plot.Axes: 'xlim' must be positive for log scale")
func test_log_xlim_nonpositive() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xscale("log")
    ax.set_xlim(0.0, 10.0)
    fig.to_spec()
}

@test
func test_pyplot_semilogy() {
    plt.close()
    plt.figure()
    plt.semilogy([1.0, 2.0, 3.0], [0.5, 50.0, 5000.0])
    let a = first_axes(plt.gcf())
    // 4 decades -> +/- 0.2 decade margins (matplotlib values).
    ut.assert_float_close(a.get_array("ylim").get_float(0), 0.31547867224009657)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 7924.465962305572)
    ut.assert_eq(a.get_str("xscale"), "linear")
    ut.assert_eq(a.get_str("yscale"), "log")
}

@test
func test_pyplot_loglog() {
    plt.close()
    plt.figure()
    plt.loglog([1.0, 100.0], [1.0, 100.0])
    let a = first_axes(plt.gcf())
    ut.assert_eq(a.get_str("xscale"), "log")
    ut.assert_eq(a.get_str("yscale"), "log")
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.7943282347242815)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 125.89254117941677)
}

@test
func test_pyplot_semilogx() {
    plt.close()
    plt.figure()
    plt.semilogx([1.0, 100.0], [1.0, 100.0])
    let a = first_axes(plt.gcf())
    ut.assert_eq(a.get_str("xscale"), "log")
    ut.assert_eq(a.get_str("yscale"), "linear")
}
