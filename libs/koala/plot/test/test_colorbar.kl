@should_panic("plot.colorbar: mappable of kind 'contour' has no colormap")
func test_cbar_contour_single_level() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    let cs = ax.contour([[0.0, 1.0], [2.0, 3.0]], [5.0])
    fig.colorbar(cs)
}
