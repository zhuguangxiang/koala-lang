// RUN: koala --test %s

// Unit tests for stem and step (Stem artist in items.kl, Axes.stem and
// Axes.step in figure.kl, plt facades in pyplot.kl). Defaults and
// autoscale expectations are matplotlib 3.11.2's own values (probed in
// the venv): stem = literal C0 stems/markers + C3 (#d62728) baseline,
// no cycle advance; step = cycle color line. Fixed-limit pixel frame
// (0, 4) x (0, 10): x 70..610, y 50..420.

import "std/ut"
import "koala/plot"
import "koala/plot" as plt
import "koala/json"

func first_axes(fig plot.Figure) json.Object {
    return fig.to_spec().get_array("axes").get_object(0)
}

func item(fig plot.Figure) json.Object {
    return first_axes(fig).get_array("items").get_object(0)
}

@test
func test_stem_default() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.stem([1.0, 2.0, 3.0], [1.0, 4.0, 9.0])
    let a = first_axes(fig)
    let it = a.get_array("items").get_object(0)
    ut.assert_eq(it.get_str("kind"), "stem")
    ut.assert_int_eq(it.get_array("stems").len(), 3)
    ut.assert_int_eq(it.get_array("markers").len(), 3)
    ut.assert_eq(it.get_str("color"), "#1f77b4")
    ut.assert_eq(it.get_str("linestyle"), "-")
    ut.assert_float_close(it.get_float("linewidth"), 1.5)
    ut.assert_eq(it.get_str("markercolor"), "#1f77b4")
    ut.assert_eq(it.get_str("marker"), "o")
    ut.assert_float_close(it.get_float("markersize"), 8.333333333333334)
    ut.assert_eq(it.get_str("basecolor"), "#d62728")
    ut.assert_eq(it.get_str("basestyle"), "-")
    // matplotlib autoscale: xlim (0.9, 3.1); y extent [0, 9] -> (-0.45, 9.45).
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.9)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 3.1)
    ut.assert_float_close(a.get_array("ylim").get_float(0), -0.45)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 9.45)
    // baseline spans the x data extent at y = bottom.
    let bl = it.get_object("baseline")
    ut.assert_float_close(bl.get_float("x0"), 94.54545454545455)
    ut.assert_float_close(bl.get_float("x1"), 585.4545454545455)
    ut.assert_float_close(bl.get_float("y0"), 403.1818181818182)
}

@test
func test_stem_segment_pixels() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 10.0)
    ax.stem([1.0, 2.0, 3.0], [1.0, 4.0, 9.0])
    let it = item(fig)
    let s0 = it.get_array("stems").get_object(0)
    ut.assert_float_close(s0.get_float("x0"), 205.0)
    ut.assert_float_close(s0.get_float("y0"), 420.0)
    ut.assert_float_close(s0.get_float("x1"), 205.0)
    ut.assert_float_close(s0.get_float("y1"), 383.0)
    let s2 = it.get_array("stems").get_object(2)
    ut.assert_float_close(s2.get_float("y1"), 87.0)
    let bl = it.get_object("baseline")
    ut.assert_float_close(bl.get_float("x0"), 205.0)
    ut.assert_float_close(bl.get_float("x1"), 475.0)
    ut.assert_float_close(bl.get_float("y0"), 420.0)
}

@test
func test_stem_bottom() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).stem([1.0, 2.0, 3.0], [1.0, 4.0, 9.0], bottom = 2.0)
    let a = first_axes(fig)
    // extent [1, 9] (bottom 2 is inside) -> (0.6, 9.4).
    ut.assert_float_close(a.get_array("ylim").get_float(0), 0.6)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 9.4)
}

@test
func test_stem_horizontal() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 10.0)
    ax.stem([1.0, 2.0, 3.0], [1.0, 4.0, 9.0], orientation = "horizontal")
    let it = item(fig)
    let s0 = it.get_array("stems").get_object(0)
    ut.assert_float_close(s0.get_float("x0"), 70.0)
    ut.assert_float_close(s0.get_float("y0"), 383.0)
    ut.assert_float_close(s0.get_float("x1"), 205.0)
    ut.assert_float_close(s0.get_float("y1"), 383.0)
    let bl = it.get_object("baseline")
    ut.assert_float_close(bl.get_float("x0"), 70.0)
    ut.assert_float_close(bl.get_float("y0"), 383.0)
    ut.assert_float_close(bl.get_float("x1"), 70.0)
    ut.assert_float_close(bl.get_float("y1"), 87.0)
}

@test
func test_stem_horizontal_autoscale() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).stem([1.0, 2.0, 3.0], [1.0, 4.0, 9.0],
                               orientation = "horizontal")
    let a = first_axes(fig)
    // x extent includes bottom 0: [0, 3] -> (-0.15, 3.15); y data only.
    ut.assert_float_close(a.get_array("xlim").get_float(0), -0.15)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 3.15)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 0.6)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 9.4)
}

@test
func test_stem_fmts() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).stem([1.0, 2.0], [1.0, 2.0], linefmt = "r:",
                              markerfmt = "gs", basefmt = "b--")
    let it = item(fig)
    ut.assert_eq(it.get_str("color"), "#ff0000")
    ut.assert_eq(it.get_str("linestyle"), ":")
    ut.assert_eq(it.get_str("markercolor"), "#008000")
    ut.assert_eq(it.get_str("marker"), "s")
    ut.assert_eq(it.get_str("basecolor"), "#0000ff")
    ut.assert_eq(it.get_str("basestyle"), "--")
}

@test
func test_stem_none_parts() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).stem([1.0, 2.0], [1.0, 2.0], linefmt = "none",
                              markerfmt = "none", basefmt = "none")
    let it = item(fig)
    ut.assert_eq(it.get_str("linestyle"), "")
    ut.assert_eq(it.get_str("marker"), "")
    ut.assert_true(!("baseline" in it))
}

@test
func test_stem_label_alpha() {
    let fig = plot.Figure()
    let s = fig.subplot(1, 1, 1).stem([1.0, 2.0], [1.0, 2.0], label = "s",
                                      alpha = 0.5)
    let it = item(fig)
    ut.assert_eq(it.get_str("label"), "s")
    ut.assert_float_close(it.get_float("alpha"), 0.5)
    ut.assert_eq(s.legend_color()!, "#1f77b4")
}

@should_panic("plot.Axes.stem: 'x' and 'y' must have the same size")
func test_stem_len_mismatch() {
    plot.Figure().subplot(1, 1, 1).stem([1.0, 2.0], [1.0])
}

@should_panic("plot.Axes.stem: 'xx' is not a valid value for orientation. Supported values are 'vertical', 'horizontal'")
func test_stem_bad_orientation() {
    plot.Figure().subplot(1, 1, 1).stem([1.0], [1.0], orientation = "xx")
}

@test
func test_step_pre() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 10.0)
    ax.step([1.0, 2.0, 3.0], [1.0, 4.0, 9.0])
    let it = item(fig)
    ut.assert_eq(it.get_str("kind"), "line")
    ut.assert_eq(it.get_str("linestyle"), "-")
    ut.assert_eq(it.get_str("color"), "#1f77b4")
    ut.assert_float_close(it.get_float("linewidth"), 1.5)
    ut.assert_true(!("marker" in it))
    let pts = it.get_array("points")
    ut.assert_int_eq(pts.len(), 5)
    // (1,1),(1,4),(2,4),(2,9),(3,9).
    ut.assert_float_close(pts.get_object(0).get_float("x"), 205.0)
    ut.assert_float_close(pts.get_object(0).get_float("y"), 383.0)
    ut.assert_float_close(pts.get_object(1).get_float("x"), 205.0)
    ut.assert_float_close(pts.get_object(1).get_float("y"), 272.0)
    ut.assert_float_close(pts.get_object(2).get_float("y"), 272.0)
    ut.assert_float_close(pts.get_object(4).get_float("x"), 475.0)
    ut.assert_float_close(pts.get_object(4).get_float("y"), 87.0)
}

@test
func test_step_post() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 10.0)
    ax.step([1.0, 2.0, 3.0], [1.0, 4.0, 9.0], where = "post")
    let pts = item(fig).get_array("points")
    ut.assert_int_eq(pts.len(), 5)
    // (1,1),(2,1),(2,4),(3,4),(3,9).
    ut.assert_float_close(pts.get_object(1).get_float("x"), 340.0)
    ut.assert_float_close(pts.get_object(1).get_float("y"), 383.0)
    ut.assert_float_close(pts.get_object(3).get_float("x"), 475.0)
    ut.assert_float_close(pts.get_object(3).get_float("y"), 272.0)
}

@test
func test_step_mid() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 10.0)
    ax.step([1.0, 2.0, 3.0], [1.0, 4.0, 9.0], where = "mid")
    let pts = item(fig).get_array("points")
    ut.assert_int_eq(pts.len(), 6)
    // (1,1),(1.5,1),(1.5,4),(2.5,4),(2.5,9),(3,9).
    ut.assert_float_close(pts.get_object(1).get_float("x"), 272.5)
    ut.assert_float_close(pts.get_object(1).get_float("y"), 383.0)
    ut.assert_float_close(pts.get_object(2).get_float("y"), 272.0)
    ut.assert_float_close(pts.get_object(4).get_float("x"), 407.5)
    ut.assert_float_close(pts.get_object(5).get_float("x"), 475.0)
}

@test
func test_step_autoscale() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).step([1.0, 2.0, 3.0], [1.0, 4.0, 9.0])
    let a = first_axes(fig)
    // matplotlib values: xlim (0.9, 3.1), ylim (0.6, 9.4).
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.9)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 3.1)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 0.6)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 9.4)
}

@test
func test_step_fmt() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).step([1.0, 2.0], [1.0, 2.0], fmt = "ro--")
    let it = item(fig)
    ut.assert_eq(it.get_str("color"), "#ff0000")
    ut.assert_eq(it.get_str("linestyle"), "--")
    ut.assert_eq(it.get_str("marker"), "o")
}

@should_panic("plot.Axes.step: 'x' and 'y' must have the same size")
func test_step_len_mismatch() {
    plot.Figure().subplot(1, 1, 1).step([1.0, 2.0], [1.0])
}

@should_panic("plot.Axes.step: 'xx' is not a valid value for where. Supported values are 'pre', 'post', 'mid'")
func test_step_bad_where() {
    plot.Figure().subplot(1, 1, 1).step([1.0], [1.0], where = "xx")
}

@test
func test_pyplot_stem_step_forwarding() {
    plt.close()
    plt.figure()
    let s = plt.stem([1.0, 2.0], [1.0, 2.0], label = "st")
    ut.assert_eq(s.kind(), "stem")
    let st = plt.step([1.0, 2.0], [1.0, 2.0], where = "pre")
    ut.assert_eq(st.kind(), "line")
    let fig = plt.gcf()
    let a = fig.to_spec().get_array("axes").get_object(0)
    let items = a.get_array("items")
    ut.assert_int_eq(items.len(), 2)
    ut.assert_eq(items.get_object(0).get_str("kind"), "stem")
    ut.assert_eq(items.get_object(1).get_str("kind"), "line")
}
