// RUN: koala --test %s

// Unit tests for the contour / imshow / hist artists via Axes
// (items.kl / figure.kl), asserting resolved pixel geometry in the spec.

import "std/ut"
import "koala/plot"
import "koala/json"

func ax0(fig plot.Figure) json.Object {
    return fig.to_spec().get_array("axes").get_object(0)
}

@test
func test_contour_artist_pixels() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 1.0)
    ax.set_ylim(0.0, 1.0)
    ax.contour([[0.0, 1.0], [0.0, 1.0]], [0.5])
    let it = ax0(fig).get_array("items").get_object(0)
    ut.assert_eq(it.get_str("kind"), "contour")
    let lvs = it.get_array("levels")
    ut.assert_int_eq(lvs.len(), 1)
    ut.assert_float_close(lvs.get_object(0).get_float("level"), 0.5)
    ut.assert_eq(lvs.get_object(0).get_str("color"), "#21908d")
    let segs = lvs.get_object(0).get_array("segments")
    ut.assert_int_eq(segs.len(), 1)
    ut.assert_float_close(segs.get_object(0).get_float("x0"), 340.0)
    ut.assert_float_close(segs.get_object(0).get_float("y0"), 420.0)
    ut.assert_float_close(segs.get_object(0).get_float("x1"), 340.0)
    ut.assert_float_close(segs.get_object(0).get_float("y1"), 50.0)
}

@test
func test_contour_auto_levels() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.contour([[0.0, 1.0], [2.0, 3.0]])
    let it = ax0(fig).get_array("items").get_object(0)
    ut.assert_int_eq(it.get_array("levels").len(), 8)
}

@test
func test_contour_custom_axes() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    let art = ax.contour([[0.0, 1.0], [0.0, 1.0]], [0.5],
                         xs = [10.0, 20.0], ys = [0.0, 5.0])
    ut.assert_float_close(art.xlo, 10.0)
    ut.assert_float_close(art.xhi, 20.0)
    ut.assert_float_close(art.yhi, 5.0)
}

@test
func test_imshow_pixels_gray() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.imshow([[0.0, 1.0], [2.0, 3.0]], cmap = "gray")
    let a = ax0(fig)
    let it = a.get_array("items").get_object(0)
    ut.assert_eq(it.get_str("kind"), "image")
    ut.assert_int_eq(it.get_int("rows"), 2)
    ut.assert_int_eq(it.get_int("cols"), 2)
    ut.assert_eq(it.get_str("cmap"), "gray")
    let px = it.get_array("pixels")
    ut.assert_int_eq(px.len(), 4)
    ut.assert_eq(px.get_str(0), "#000000")
    ut.assert_eq(px.get_str(1), "#555555")
    ut.assert_eq(px.get_str(2), "#aaaaaa")
    ut.assert_eq(px.get_str(3), "#ffffff")
    // imshow sets the extent limits (origin upper).
    ut.assert_float_close(a.get_array("xlim").get_float(0), -0.5)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 1.5)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 1.5)
    ut.assert_float_close(a.get_array("ylim").get_float(1), -0.5)
}

@test
func test_imshow_constant_grid() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.imshow([[7.0, 7.0], [7.0, 7.0]], cmap = "gray")
    let px = ax0(fig).get_array("items").get_object(0).get_array("pixels")
    // span 0 -> t=0.5 -> mid gray
    ut.assert_eq(px.get_str(0), "#808080")
}

@test
func test_imshow_default_aspect_equal() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.imshow([[0.0, 1.0], [2.0, 3.0]])
    // 2x2 data: (2/2)/1 = 1 -> square box, width shrunk, centered.
    let p = ax0(fig).get_object("plot")
    ut.assert_float_close(p.get_float("w"), 370.0)
    ut.assert_float_close(p.get_float("h"), 370.0)
    ut.assert_float_close(p.get_float("x"), 155.0)
    ut.assert_float_close(p.get_float("y"), 50.0)
}

@test
func test_imshow_aspect_auto_full_rect() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.imshow([[0.0, 1.0], [2.0, 3.0]], aspect = "auto")
    let p = ax0(fig).get_object("plot")
    ut.assert_float_close(p.get_float("x"), 70.0)
    ut.assert_float_close(p.get_float("w"), 540.0)
    ut.assert_float_close(p.get_float("h"), 370.0)
}

@test
func test_imshow_aspect_number_shrinks() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    // aspect 2: (2/2)/2 = 0.5 -> w = 185, centered x = 247.5
    ax.imshow([[0.0, 1.0], [2.0, 3.0]], aspect = 2.0)
    let p = ax0(fig).get_object("plot")
    ut.assert_float_close(p.get_float("w"), 185.0)
    ut.assert_float_close(p.get_float("h"), 370.0)
    ut.assert_float_close(p.get_float("x"), 247.5)

    let fig2 = plot.Figure()
    let ax2 = fig2.subplot(1, 1, 1)
    // aspect 0.5: (2/2)/0.5 = 2 -> h = 270, centered y = 100
    ax2.imshow([[0.0, 1.0], [2.0, 3.0]], aspect = 0.5)
    let p2 = ax0(fig2).get_object("plot")
    ut.assert_float_close(p2.get_float("w"), 540.0)
    ut.assert_float_close(p2.get_float("h"), 270.0)
    ut.assert_float_close(p2.get_float("y"), 100.0)
}

@test
func test_imshow_aspect_numeric_string() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.imshow([[0.0, 1.0], [2.0, 3.0]], aspect = "2")
    let p = ax0(fig).get_object("plot")
    ut.assert_float_close(p.get_float("w") / p.get_float("h"), 0.5)
}

@test
func test_imshow_aspect_applies_at_draw_time() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.imshow([[0.0, 1.0], [2.0, 3.0]])
    ax.set_xlim(0.0, 4.0)
    // aspect resolves with the current limits: yspan 2, xspan 4 -> (4/2)/1 = 2
    let p = ax0(fig).get_object("plot")
    ut.assert_float_close(p.get_float("w") / p.get_float("h"), 2.0)
    ut.assert_float_close(p.get_float("w"), 540.0)
    ut.assert_float_close(p.get_float("h"), 270.0)
    ut.assert_float_close(p.get_float("x"), 70.0)
    ut.assert_float_close(p.get_float("y"), 100.0)
}

@test
func test_imshow_aspect_image_rect_follows() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.imshow([[0.0, 1.0], [2.0, 3.0]], aspect = 2.0)
    let a = ax0(fig)
    // limits keep the extent semantics, only the box shrinks
    ut.assert_float_close(a.get_array("xlim").get_float(0), -0.5)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 1.5)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 1.5)
    ut.assert_float_close(a.get_array("ylim").get_float(1), -0.5)
    let r = a.get_array("items").get_object(0).get_object("rect")
    ut.assert_float_close(r.get_float("x"), 247.5)
    ut.assert_float_close(r.get_float("w"), 185.0)
    ut.assert_float_close(r.get_float("h"), 370.0)
}

@test
func test_imshow_extent_sets_limits() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.imshow([[0.0, 1.0], [2.0, 3.0]], extent = (10.0, 20.0, 30.0, 40.0))
    let a = ax0(fig)
    ut.assert_float_close(a.get_array("xlim").get_float(0), 10.0)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 20.0)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 30.0)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 40.0)
    // square spans -> equal aspect keeps a square box
    let p = a.get_object("plot")
    ut.assert_float_close(p.get_float("w"), 370.0)
    ut.assert_float_close(p.get_float("h"), 370.0)
}

@test
func test_imshow_extent_overrides_limits() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(-1.0, 1.0)
    ax.set_ylim(-1.0, 1.0)
    ax.imshow([[0.0, 1.0], [2.0, 3.0]], extent = (0.0, 2.0, 0.0, 2.0))
    let a = ax0(fig)
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.0)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 2.0)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 0.0)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 2.0)
}

@test
func test_imshow_extent_inverted_aspect() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.imshow([[0.0, 1.0], [2.0, 3.0]], extent = (2.0, 0.0, 3.0, 0.0),
              aspect = 2.0)
    let a = ax0(fig)
    // inverted limits kept; |span| used -> (2/3)/2 = 1/3
    ut.assert_float_close(a.get_array("xlim").get_float(0), 2.0)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 0.0)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 3.0)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 0.0)
    let p = a.get_object("plot")
    ut.assert_float_close(p.get_float("w") / p.get_float("h"), 1.0 / 3.0)
}

@test
func test_imshow_aspect_identical_limits_expanded() {
    // Identical extent limits expand to (a-0.5, b+0.5) in resolved_xlim
    // before the aspect applies (mpl also auto-expands, different amount).
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.imshow([[0.0, 1.0], [2.0, 3.0]], extent = (1.0, 1.0, 0.0, 3.0),
              aspect = 2.0)
    let a = ax0(fig)
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.5)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 1.5)
    // expanded span 1, yspan 3 -> (1/3)/2 = 1/6 -> w = 370/6
    let p = a.get_object("plot")
    ut.assert_float_close(p.get_float("w"), 370.0 / 6.0)
    ut.assert_float_close(p.get_float("h"), 370.0)
}

@should_panic("plot.Axes.imshow: aspect must be finite and positive")
func test_imshow_aspect_zero() {
    plot.Figure().subplot(1, 1, 1).imshow([[0.0, 1.0]], aspect = 0.0)
}

