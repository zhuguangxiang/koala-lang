func test_imshow_aspect_inf_str() {
    plot.Figure().subplot(1, 1, 1).imshow([[0.0, 1.0]], aspect = "inf")
}

@should_panic("plot.Axes.imshow: aspect must be finite and positive")
func test_imshow_aspect_nan_str() {
    plot.Figure().subplot(1, 1, 1).imshow([[0.0, 1.0]], aspect = "nan")
}

