// RUN: koala --test %s

// Headless tests for the tight-bbox walker (tight.kl), which savefig
// (bbox_inches="tight") and tight_layout reuse. Expected numbers are
// derived from the layout constants (layout.kl) and the renderer's label
// geometry (13/14 px axis labels, tick labels at len+pad below the frame).

import "std/ut"
import "koala/plot" as plt
import "koala/json"

@test
func test_empty_figure_is_nil() {
    plt.close()
    plt.figure()
    if let r = plt.tight_bbox(plt.gcf().to_spec()) {
        ut.assert_true(false, "empty figure should have no tight bbox")
    }
}

@test
func test_labeled_single_axes() {
    plt.close()
    plt.figure()
    plt.plot([0.0, 1.0], [0.0, 1.0])
    plt.xlim(0.0, 1.0)
    plt.ylim(0.0, 1.0)
    plt.xticks([0.0, 0.5, 1.0], ["0", "5", "10"])
    plt.yticks([0.0, 1.0], ["0", "1"])
    plt.xlabel("x")
    plt.ylabel("y")
    plt.title("t")
    let spec = plt.gcf().to_spec()
    if let r = plt.tight_bbox(spec) {
        // cell = (10, 10, 620, 460), plot = (70, 50, 540, 370) at
        // 640x480/100dpi; tick labels sit len+pad below the frame at
        // 10pt labelsize.
        let dpi = 100.0
        let cell_x = plt.FIG_MARGIN
        let cell_y = plt.FIG_MARGIN
        let pw = 620.0 - plt.PAD_LEFT - plt.PAD_RIGHT
        let ph = 460.0 - plt.PAD_TOP - plt.PAD_BOTTOM
        // Left: rotated ylabel at cell_x + PAD_LEFT/2, half a 13px line.
        ut.assert_float_close(r.x, cell_x + plt.PAD_LEFT / 2.0 - 6.5)
        // Top: 14px title at cell_y + PAD_TOP/2.
        ut.assert_float_close(r.y, cell_y + plt.PAD_TOP / 2.0 - 7.0)
        // Right: widest bottom tick label "10" centered on the right edge.
        let ls = 10.0 * dpi / 72.0
        ut.assert_float_close(r.right(), cell_x + plt.PAD_LEFT + pw +
                              plt.text_w(ls, "10") / 2.0)
        // Bottom: xlabel at plot bottom + PAD_BOTTOM/2, half a 13px line.
        ut.assert_float_close(r.bottom(), cell_y + plt.PAD_TOP + ph +
                              plt.PAD_BOTTOM / 2.0 + 6.5)
    } else {
        ut.assert_true(false, "tight bbox missing")
    }
}

@test
func test_multi_axes_union() {
    plt.close()
    let (fig, _) = plt.subplots(2, 2)
    plt.gca().set_xlabel("x")
    plt.gca().set_title("t")
    if let r = plt.tight_bbox(fig.to_spec()) {
        // Contains the whole grid: right edge at FIG_MARGIN+PAD_LEFT+2*cw+GAP.
        ut.assert_true(r.right() > 610.0)
        ut.assert_true(r.bottom() > 420.0)
        // Extends left of the leftmost frame (ylabel/tick labels).
        ut.assert_true(r.x < 70.0)
        // Extends above the topmost frame (title).
        ut.assert_true(r.y < 50.0)
    } else {
        ut.assert_true(false, "tight bbox missing")
    }
}

@test
func test_suptitle_extends_top() {
    plt.close()
    plt.figure()
    plt.plot([0.0, 1.0], [0.0, 1.0])
    plt.title("t")
    plt.suptitle("s")
    if let r = plt.tight_bbox(plt.gcf().to_spec()) {
        // suptitle at y=0.98 from the bottom -> spec y = 0.02*480 = 9.6,
        // baseline "top" so it covers [9.6, 25.6]; beats the title at 13.
        ut.assert_float_close(r.y, 9.6)
    } else {
        ut.assert_true(false, "tight bbox missing")
    }
}

@test
func test_text_w_h() {
    ut.assert_float_close(plt.text_w(10.0, "abc"), 18.0)
    ut.assert_float_close(plt.text_h(10.0), 12.0)
}

/// A synthetic axes spec with a tiny 40x40 data box at (100, 100) and
/// long xlabel/ylabel/title centered on it, so the decorations stick out
/// on every side and the two walker modes differ.
func tiny_axes_spec() json.Object {
    let ax = json.Object()
    let p = json.Object()
    p["x"] = json.Float(100.0)
    p["y"] = json.Float(100.0)
    p["w"] = json.Float(40.0)
    p["h"] = json.Float(40.0)
    ax["plot"] = p
    let ts = json.Object()
    ts["labelsize"] = json.Float(10.0)
    ts["direction"] = json.String("out")
    ts["length"] = json.Float(4.0)
    ts["pad"] = json.Float(3.0)
    ts["labelbottom"] = json.Boolean(true)
    ts["labeltop"] = json.Boolean(false)
    ts["labelleft"] = json.Boolean(false)
    ts["labelright"] = json.Boolean(false)
    ax["tickstyle"] = ts
    ax["xticks"] = json.Array()
    ax["yticks"] = json.Array()
    let xl = json.Object()
    xl["text"] = json.String("a very long xlabel")
    xl["x"] = json.Float(120.0)
    xl["y"] = json.Float(120.0)
    ax["xlabel"] = xl
    let yl = json.Object()
    yl["text"] = json.String("looooooooong")
    yl["x"] = json.Float(120.0)
    yl["y"] = json.Float(120.0)
    ax["ylabel"] = yl
    let ti = json.Object()
    ti["text"] = json.String("very long title")
    ti["x"] = json.Float(120.0)
    ti["y"] = json.Float(120.0)
    ax["title"] = ti
    let lg = json.Object()
    lg["show"] = json.Boolean(false)
    lg["entries"] = json.Array()
    ax["legend"] = lg
    return ax
}

@test
func test_axes_tight_bbox_for_layout() {
    let ax = tiny_axes_spec()
    let full = plt.axes_tight_bbox(ax)
    // Full bbox: the xlabel x extent dominates both sides (wider than the
    // title), the ylabel y extent the top and bottom; the bottom tick
    // labels (empty array) only add len+pad below the frame.
    let xlw = plt.text_w(13.0, "a very long xlabel")
    ut.assert_float_close(full.x, 120.0 - xlw / 2.0)
    ut.assert_float_close(full.right(), 120.0 + xlw / 2.0)
    let ylw = plt.text_w(13.0, "looooooooong")
    ut.assert_float_close(full.y, 120.0 - ylw / 2.0)
    ut.assert_float_close(full.bottom(), 120.0 + ylw / 2.0)
    // For layout: the title/xlabel x extents and the ylabel y extent
    // collapse (matplotlib for_layout_only), and the tick length is
    // excluded, so only the bottom label pad remains.
    let lo = plt.axes_tight_bbox(ax, true)
    ut.assert_float_close(lo.x, 100.0)
    ut.assert_float_close(lo.right(), 140.0)
    ut.assert_float_close(lo.y, 100.0)
    ut.assert_float_close(lo.bottom(), 140.0 + 3.0 + 10.0)
}
