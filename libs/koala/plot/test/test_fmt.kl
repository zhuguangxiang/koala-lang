// RUN: koala --test %s

// Unit tests for matplotlib format-string parsing (fmt.kl) and its
// integration into Axes.plot, plus C0..C9 cycle-color resolution.

import "std/ut"
import "koala/plot"

func want_opt(got str?, want str?) {
    if let w = want {
        if let g = got {
            ut.assert_eq(g, w)
        } else {
            ut.assert_true(false, "expected a value, got nil")
        }
    } else {
        ut.assert_true(got == nil)
    }
}

func check_fmt(fmt str, color str?, ls str?, marker str?) {
    let (c, l, m) = plot.parse_fmt(fmt)
    want_opt(c, color)
    want_opt(l, ls)
    want_opt(m, marker)
}

@test
func test_fmt_color_marker_line() {
    check_fmt("ro--", "r", "--", "o")
    check_fmt("r--x", "r", "--", "x")
    check_fmt("b^--", "b", "--", "^")
}

@test
func test_fmt_partial() {
    check_fmt("b^", "b", nil, "^")
    check_fmt("g:", "g", ":", nil)
    check_fmt("m", "m", nil, nil)
    check_fmt("o", nil, nil, "o")
    check_fmt("--", nil, "--", nil)
    check_fmt("", nil, nil, nil)
}

@test
func test_fmt_dashdot_vs_point() {
    check_fmt("r-.", "r", "-.", nil)
    check_fmt("k.", "k", nil, ".")
    check_fmt(".-", nil, "-", ".")
}

@test
func test_fmt_cycle_color() {
    check_fmt("C0o-", "C0", "-", "o")
    check_fmt("C3", "C3", nil, nil)
}

@test
func test_plot_fmt_integration() {
    let ax = plot.Figure().subplot(1, 1, 1)
    let line = ax.plot([0.0, 1.0], [0.0, 1.0], "ro--")
    ut.assert_eq(line.color, "#ff0000")
    ut.assert_eq(line.linestyle, "--")
    want_opt(line.marker, "o")
}

@test
func test_plot_fmt_kwargs_override() {
    let ax = plot.Figure().subplot(1, 1, 1)
    let line = ax.plot([0.0, 1.0], [0.0, 1.0], "ro--",
                       color = "b", linestyle = ":", marker = "x")
    ut.assert_eq(line.color, "#0000ff")
    ut.assert_eq(line.linestyle, ":")
    want_opt(line.marker, "x")
}

@test
func test_plot_fmt_marker_only() {
    let ax = plot.Figure().subplot(1, 1, 1)
    let line = ax.plot([0.0, 1.0], [0.0, 1.0], "^")
    ut.assert_eq(line.color, "#1f77b4")
    ut.assert_eq(line.linestyle, "-")
    want_opt(line.marker, "^")
}

@test
func test_plot_fmt_cycle_color() {
    let ax = plot.Figure().subplot(1, 1, 1)
    let line = ax.plot([0.0, 1.0], [0.0, 1.0], "C2")
    ut.assert_eq(line.color, "#2ca02c")
}

@test
func test_plot_single_arg_fmt() {
    let ax = plot.Figure().subplot(1, 1, 1)
    let line = ax.plot([0.0, 1.0, 2.0], fmt = "g:")
    ut.assert_int_eq(line.xdata.len(), 3)
    ut.assert_float_close(line.xdata[2], 2.0)
    ut.assert_float_close(line.ydata[2], 2.0)
    ut.assert_eq(line.color, "#008000")
    ut.assert_eq(line.linestyle, ":")
}

@test
func test_resolve_cycle_colors() {
    ut.assert_eq(plot.resolve_color("C0"), "#1f77b4")
    ut.assert_eq(plot.resolve_color("C2"), "#2ca02c")
    ut.assert_eq(plot.resolve_color("C9"), "#17becf")
    ut.assert_eq(plot.resolve_color("#abcdef"), "#abcdef")
    ut.assert_eq(plot.resolve_color("red"), "red")
}

@should_panic("plot.fmt: invalid format character 'z'")
func test_fmt_invalid_char() {
    plot.parse_fmt("rz")
}

@should_panic("plot.fmt: multiple colors in format string")
func test_fmt_multiple_colors() {
    plot.parse_fmt("rb")
}

@should_panic("plot.fmt: multiple markers in format string")
func test_fmt_multiple_markers() {
    plot.parse_fmt("oo")
}

@should_panic("plot.fmt: 'C' must be followed by a cycle digit")
func test_fmt_dangling_c() {
    plot.parse_fmt("C")
}

@should_panic("plot.fmt: invalid cycle index 'Cx'")
func test_fmt_bad_cycle() {
    plot.parse_fmt("Cx")
}

@should_panic("plot.fmt: invalid format character ':'")
func test_fmt_double_colon() {
    plot.parse_fmt("r::")
}