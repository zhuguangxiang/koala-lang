// RUN: koala --test %s

// Unit tests for the plot nice-ticks geometry (libs/koala/plot/ticks.kl).

import "std/ut"
import "koala/plot"

@test
func test_nice_ticks_zero_to_ten() {
    let (ticks, step) = plot.nice_ticks(0.0, 10.0, 6)
    ut.assert_float_close(step, 2.0)
    ut.assert_int_eq(ticks.len(), 6)
    ut.assert_float_close(ticks[0], 0.0)
    ut.assert_float_close(ticks[1], 2.0)
    ut.assert_float_close(ticks[2], 4.0)
    ut.assert_float_close(ticks[3], 6.0)
    ut.assert_float_close(ticks[4], 8.0)
    ut.assert_float_close(ticks[5], 10.0)
}

@test
func test_nice_ticks_zero_to_one() {
    let (ticks, step) = plot.nice_ticks(0.0, 1.0, 6)
    ut.assert_float_close(step, 0.2)
    ut.assert_int_eq(ticks.len(), 6)
    ut.assert_float_close(ticks[0], 0.0)
    ut.assert_float_close(ticks[3], 0.6)
    ut.assert_float_close(ticks[5], 1.0)
}

@test
func test_nice_ticks_brackets_data() {
    // [1, 9] expands to nice bounds [0, 10] with step 2.
    let (ticks, step) = plot.nice_ticks(1.0, 9.0, 5)
    ut.assert_float_close(step, 2.0)
    ut.assert_float_close(ticks[0], 0.0)
    ut.assert_float_close(ticks[ticks.len() - 1], 10.0)
    ut.assert_true(ticks[0] <= 1.0)
    ut.assert_true(ticks[ticks.len() - 1] >= 9.0)
}

@test
func test_nice_ticks_negative_range() {
    let (ticks, step) = plot.nice_ticks(-5.0, 5.0, 6)
    ut.assert_float_close(step, 2.0)
    ut.assert_int_eq(ticks.len(), 7)
    ut.assert_float_close(ticks[0], -6.0)
    ut.assert_float_close(ticks[3], 0.0)
    ut.assert_float_close(ticks[6], 6.0)
}

@test
func test_nice_ticks_ascending() {
    let (ticks, step) = plot.nice_ticks(3.0, 97.0, 8)
    ut.assert_true(step > 0.0)
    var i = 1
    while i < ticks.len() {
        ut.assert_true(ticks[i] > ticks[i - 1])
        i = i + 1
    }
    ut.assert_true(ticks[0] <= 3.0)
    ut.assert_true(ticks[ticks.len() - 1] >= 97.0)
}

@test
func test_tick_decimals() {
    ut.assert_int_eq(plot.tick_decimals(2.0), 0)
    ut.assert_int_eq(plot.tick_decimals(1.0), 0)
    ut.assert_int_eq(plot.tick_decimals(5.0), 0)
    ut.assert_int_eq(plot.tick_decimals(10.0), 0)
    ut.assert_int_eq(plot.tick_decimals(100.0), 0)
    ut.assert_int_eq(plot.tick_decimals(0.5), 1)
    ut.assert_int_eq(plot.tick_decimals(0.2), 1)
    ut.assert_int_eq(plot.tick_decimals(0.1), 1)
    ut.assert_int_eq(plot.tick_decimals(1.5), 1)
    ut.assert_int_eq(plot.tick_decimals(2.5), 1)
    ut.assert_int_eq(plot.tick_decimals(0.05), 2)
    ut.assert_int_eq(plot.tick_decimals(0.25), 2)
    ut.assert_int_eq(plot.tick_decimals(0.75), 2)
    ut.assert_int_eq(plot.tick_decimals(0.015), 3)
    ut.assert_int_eq(plot.tick_decimals(0.3), 1)
}

@should_panic("plot.nice_ticks: require hi > lo")
func test_nice_ticks_zero_span() {
    plot.nice_ticks(5.0, 5.0)
}

@should_panic("plot.nice_ticks: require hi > lo")
func test_nice_ticks_inverted() {
    plot.nice_ticks(10.0, 0.0)
}

@should_panic("plot.nice_ticks: require target >= 2")
func test_nice_ticks_bad_target() {
    plot.nice_ticks(0.0, 10.0, 1)
}

@should_panic("plot.tick_decimals: require step > 0")
func test_tick_decimals_zero() {
    plot.tick_decimals(0.0)
}

@should_panic("plot.tick_decimals: require step > 0")
func test_tick_decimals_negative() {
    plot.tick_decimals(-1.0)
}