// RUN: koala --test %s

// Unit tests for the plot Figure/Axes object model + figure-spec frame
// serialization (figure.kl / spec.kl). Assertions target the resolved
// pixel geometry in the serialized JSON, per docs/koala_ml.md §6.5.

import "std/ut"
import "koala/plot"

@test
func test_figure_default_size() {
    let fig = plot.Figure()
    ut.assert_float_close(fig.width, 640.0)
    ut.assert_float_close(fig.height, 480.0)
    let spec = fig.to_spec()
    ut.assert_float_close(spec.get_float("width"), 640.0)
    ut.assert_float_close(spec.get_float("height"), 480.0)
    ut.assert_eq(spec.get_str("background"), "#ffffff")
}

@test
func test_figure_custom_size() {
    let fig = plot.Figure(8.0, 6.0, 50)
    ut.assert_float_close(fig.width, 400.0)
    ut.assert_float_close(fig.height, 300.0)
}

@test
func test_subplot_indexing() {
    let fig = plot.Figure()
    let a1 = fig.subplot(2, 2, 1)
    ut.assert_int_eq(a1.row, 0)
    ut.assert_int_eq(a1.col, 0)
    let a4 = fig.subplot(2, 2, 4)
    ut.assert_int_eq(a4.row, 1)
    ut.assert_int_eq(a4.col, 1)
    let a3 = fig.subplot(2, 2, 3)
    ut.assert_int_eq(a3.row, 1)
    ut.assert_int_eq(a3.col, 0)
    ut.assert_int_eq(fig.axes.len(), 3)
}

@test
func test_subplot_reuse() {
    let fig = plot.Figure()
    let a = fig.subplot(1, 2, 1)
    let b = fig.subplot(1, 2, 1)
    ut.assert_int_eq(fig.axes.len(), 1)
    a.set_title("shared")
    ut.assert_eq(b.title_text, "shared")
}

@test
func test_spec_frame_geometry() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 10.0)
    ax.set_ylim(0.0, 100.0)
    ax.set_xlabel("x")
    ax.set_ylabel("y")
    ax.set_title("T")
    ax.grid(true)

    let spec = fig.to_spec()
    let axes = spec.get_array("axes")
    ut.assert_int_eq(axes.len(), 1)
    let a = axes.get_object(0)

    // Data area rect for a 640x480 single-axes figure.
    let p = a.get_object("plot")
    ut.assert_float_close(p.get_float("x"), 70.0)
    ut.assert_float_close(p.get_float("y"), 50.0)
    ut.assert_float_close(p.get_float("w"), 540.0)
    ut.assert_float_close(p.get_float("h"), 370.0)

    // Limits.
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.0)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 10.0)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 100.0)

    // X ticks: 0,2,4,6,8,10 resolved to pixels 70..610.
    let xt = a.get_array("xticks")
    ut.assert_int_eq(xt.len(), 6)
    ut.assert_float_close(xt.get_object(0).get_float("value"), 0.0)
    ut.assert_float_close(xt.get_object(0).get_float("px"), 70.0)
    ut.assert_eq(xt.get_object(0).get_str("label"), "0")
    ut.assert_float_close(xt.get_object(1).get_float("px"), 178.0)
    ut.assert_eq(xt.get_object(5).get_str("label"), "10")
    ut.assert_float_close(xt.get_object(5).get_float("px"), 610.0)

    // Y ticks inverted: data 0 at bottom pixel 420, data 100 at top 50.
    let yt = a.get_array("yticks")
    ut.assert_int_eq(yt.len(), 6)
    ut.assert_float_close(yt.get_object(0).get_float("px"), 420.0)
    ut.assert_float_close(yt.get_object(5).get_float("px"), 50.0)
    ut.assert_eq(yt.get_object(0).get_str("label"), "0")

    // Label anchors.
    let xl = a.get_object("xlabel")
    ut.assert_eq(xl.get_str("text"), "x")
    ut.assert_float_close(xl.get_float("x"), 340.0)
    ut.assert_float_close(xl.get_float("y"), 445.0)
    let yl = a.get_object("ylabel")
    ut.assert_eq(yl.get_str("text"), "y")
    ut.assert_float_close(yl.get_float("x"), 40.0)
    let ti = a.get_object("title")
    ut.assert_eq(ti.get_str("text"), "T")
    ut.assert_float_close(ti.get_float("y"), 30.0)

    // Grid resolved to tick pixel positions.
    let g = a.get_object("grid")
    ut.assert_true(g.get_bool("show"))
    ut.assert_int_eq(g.get_array("xlines").len(), 6)
    ut.assert_float_close(g.get_array("xlines").get_float(0), 70.0)
    ut.assert_float_close(g.get_array("ylines").get_float(0), 420.0)
    ut.assert_float_close(g.get_array("ylines").get_float(5), 50.0)

    // No artists yet.
    ut.assert_int_eq(a.get_array("items").len(), 0)
}

@test
func test_spec_default_limits_and_legend() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.legend()
    let a = fig.to_spec().get_array("axes").get_object(0)
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.0)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 1.0)
    ut.assert_true(a.get_object("legend").get_bool("show"))
    ut.assert_false(a.get_object("grid").get_bool("show"))
}

@test
func test_spec_tick_override() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 1.0)
    ax.set_xticks([0.0, 0.5, 1.0])
    let a = fig.to_spec().get_array("axes").get_object(0)
    let xt = a.get_array("xticks")
    ut.assert_int_eq(xt.len(), 3)
    ut.assert_eq(xt.get_object(1).get_str("label"), "0.5")
}

@test
func test_spec_ticks_clipped_to_view() {
    // Autoscaled limits (-0.1,2.1)/(-0.2,4.2): nice_ticks brackets the data
    // and emits -1..3 / -1..5, but only in-view ticks may reach the spec.
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.plot([0.0, 1.0, 2.0], [0.0, 1.0, 4.0])
    let a = fig.to_spec().get_array("axes").get_object(0)
    let xt = a.get_array("xticks")
    ut.assert_int_eq(xt.len(), 3)
    ut.assert_float_close(xt.get_object(0).get_float("value"), 0.0)
    ut.assert_float_close(xt.get_object(2).get_float("value"), 2.0)
    let yt = a.get_array("yticks")
    ut.assert_int_eq(yt.len(), 5)
    ut.assert_float_close(yt.get_object(0).get_float("value"), 0.0)
    ut.assert_float_close(yt.get_object(4).get_float("value"), 4.0)
    ut.assert_int_eq(a.get_object("grid").get_array("xlines").len(), 3)
}

@test
func test_spec_tick_override_clipped() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 1.0)
    ax.set_xticks([-1.0, 0.0, 0.5, 1.0, 2.0])
    let xt = fig.to_spec().get_array("axes").get_object(0).get_array("xticks")
    ut.assert_int_eq(xt.len(), 3)
    ut.assert_float_close(xt.get_object(0).get_float("value"), 0.0)
    ut.assert_float_close(xt.get_object(2).get_float("value"), 1.0)
}

@test
func test_spec_zero_span_limit_expands() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(5.0, 5.0)
    let a = fig.to_spec().get_array("axes").get_object(0)
    ut.assert_float_close(a.get_array("xlim").get_float(0), 4.5)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 5.5)
}

@test
func test_spec_multiple_axes() {
    let fig = plot.Figure()
    fig.subplot(1, 2, 1).set_title("left")
    fig.subplot(1, 2, 2).set_title("right")
    let axes = fig.to_spec().get_array("axes")
    ut.assert_int_eq(axes.len(), 2)
    ut.assert_eq(axes.get_object(0).get_object("title").get_str("text"), "left")
    ut.assert_eq(axes.get_object(1).get_object("title").get_str("text"), "right")
    // Second cell starts to the right of the first.
    ut.assert_true(axes.get_object(1).get_object("rect").get_float("x") >
                   axes.get_object(0).get_object("rect").get_float("x"))
}

@should_panic("plot.Figure: width and height must be > 0")
func test_figure_zero_width() {
    plot.Figure(0.0, 5.0)
}

@should_panic("plot.Figure: dpi must be > 0")
func test_figure_zero_dpi() {
    plot.Figure(5.0, 5.0, 0)
}

@should_panic("plot.Figure.subplot: rows and cols must be >= 1")
func test_subplot_zero_rows() {
    plot.Figure().subplot(0, 1, 1)
}

@should_panic("plot.Figure.subplot: index out of range")
func test_subplot_index_zero() {
    plot.Figure().subplot(2, 2, 0)
}

@should_panic("plot.Figure.subplot: index out of range")
func test_subplot_index_too_big() {
    plot.Figure().subplot(2, 2, 5)
}