@test
func test_pyplot_errorbar_forwarding() {
    plt.close()
    plt.figure()
    let e = plt.errorbar([1.0, 2.0], [2.0, 4.0], yerr = 0.5, fmt = "o",
                         label = "n")
    ut.assert_eq(e.kind(), "errorbar")
    ut.assert_eq(e.color, "#1f77b4")
    if let lb = e.legend_label() {
        ut.assert_eq(lb, "n")
    } else {
        ut.assert_true(false, "label not set")
    }
}

@test
func test_errorbar_lolims_scalar() {
    // One-sided bar: [y, y+err]; cap at the data end only, arrow head
    // (caretsize, default 6 pt = 8.333 px at 100 dpi) at the tip.
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 4.0)
    ax.errorbar([1.0, 2.0, 3.0], [1.0, 2.0, 3.0], yerr = 0.5, lolims = true)
    let it = item(fig)
    let ys = it.get_array("yerrs")
    ut.assert_int_eq(ys.len(), 3)
    let s0 = ys.get_object(0)
    ut.assert_float_close(s0.get_float("y0"), 327.5)
    ut.assert_float_close(s0.get_float("y1"), 281.25)
    ut.assert_int_eq(s0.get_int("lim"), 1)
    let ycaps = it.get_array("ycaps")
    // capsize 0 draws no caps (arrow heads only).
    ut.assert_int_eq(ycaps.len(), 0)
    ut.assert_float_close(it.get_float("caretsize"), 8.333333333333334)
}

@test
func test_errorbar_lolims_autoscale() {
    // Only the arrow tip extends the view: y extent [1, 3.5].
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).errorbar([1.0, 2.0, 3.0], [1.0, 2.0, 3.0],
                                  yerr = 0.5, lolims = true)
    let a = first_axes(fig)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 0.875)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 3.625)
}

@test
func test_errorbar_uplims_list() {
    // Per-point mask: bar [y-err, y]; cap at the data end (top) only.
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 4.0)
    ax.errorbar([1.0, 2.0, 3.0], [1.0, 2.0, 3.0], yerr = 0.5,
                capsize = 3.6, uplims_ls = [true, false, true])
    let it = item(fig)
    let ys = it.get_array("yerrs")
    let s0 = ys.get_object(0)
    ut.assert_float_close(s0.get_float("y0"), 373.75)
    ut.assert_float_close(s0.get_float("y1"), 327.5)
    ut.assert_int_eq(s0.get_int("lim"), 2)
    ut.assert_true(!("lim" in ys.get_object(1)))
    // caps: uplims points 1 each (data end), plain point 2 (both ends).
    ut.assert_int_eq(it.get_array("ycaps").len(), 4)
}

@test
func test_errorbar_xlolims_xuplims() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 4.0)
    ax.errorbar([1.0, 2.0, 3.0], [1.0, 2.0, 3.0], xerr = 0.5, capsize = 3.6,
                xlolims_ls = [true, false, false],
                xuplims_ls = [false, false, true])
    let it = item(fig)
    let xs = it.get_array("xerrs")
    let s0 = xs.get_object(0)
    ut.assert_float_close(s0.get_float("x0"), 205.0)
    ut.assert_float_close(s0.get_float("x1"), 272.5)
    ut.assert_int_eq(s0.get_int("lim"), 1)
    let s2 = xs.get_object(2)
    ut.assert_float_close(s2.get_float("x0"), 407.5)
    ut.assert_float_close(s2.get_float("x1"), 475.0)
    ut.assert_int_eq(s2.get_int("lim"), 2)
    // caps: one-sided points 1 each, plain point 2.
    ut.assert_int_eq(it.get_array("xcaps").len(), 4)
}

@test
func test_errorbar_yerrs2_asymmetric() {
    // 2xN: row 0 lower, row 1 upper; two-sided bars, no lim key.
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 4.0)
    ax.errorbar([1.0, 2.0], [1.0, 2.0], yerrs2 = [[0.1, 0.2], [0.4, 0.5]],
                capsize = 3.6)
    let it = item(fig)
    let ys = it.get_array("yerrs")
    let s0 = ys.get_object(0)
    ut.assert_float_close(s0.get_float("y0"), 336.75)
    ut.assert_float_close(s0.get_float("y1"), 290.5)
    ut.assert_true(!("lim" in s0))
    let s1 = ys.get_object(1)
    ut.assert_float_close(s1.get_float("y0"), 253.5)
    ut.assert_float_close(s1.get_float("y1"), 188.75)
    ut.assert_int_eq(it.get_array("ycaps").len(), 4)
}

@test
func test_errorbar_yerrs2_uplims() {
    // uplims with 2xN uses only the lower row: bar [y-0.1, y].
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 4.0)
    ax.errorbar([1.0], [1.0], yerrs2 = [[0.1], [0.4]], uplims = true)
    let s0 = item(fig).get_array("yerrs").get_object(0)
    ut.assert_float_close(s0.get_float("y0"), 336.75)
    ut.assert_float_close(s0.get_float("y1"), 327.5)
    ut.assert_int_eq(s0.get_int("lim"), 2)
}

@test
func test_errorbar_both_lims() {
    // lolims + uplims: degenerate bar y..y, both caps, lim 3.
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 4.0)
    ax.errorbar([1.0], [1.0], yerr = 0.5, capsize = 3.6, lolims = true,
                uplims = true)
    let it = item(fig)
    let s0 = it.get_array("yerrs").get_object(0)
    ut.assert_float_close(s0.get_float("y0"), 327.5)
    ut.assert_float_close(s0.get_float("y1"), 327.5)
    ut.assert_int_eq(s0.get_int("lim"), 3)
    ut.assert_int_eq(it.get_array("ycaps").len(), 2)
}

@test
func test_errorbar_caretsize_with_caps() {
    // With caps on, the arrow head matches the cap length (2*capsize).
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).errorbar([1.0], [1.0], yerr = 0.5, lolims = true,
                                  capsize = 3.6)
    let it = item(fig)
    ut.assert_float_close(it.get_float("caplen"), 10.0)
    ut.assert_float_close(it.get_float("caretsize"), 10.0)
}

@test
func test_errorbar_lolims_ignored_without_yerr() {
    // matplotlib silently ignores the flag when no error is given.
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).errorbar([1.0, 2.0], [1.0, 2.0], lolims = true,
                                  uplims = true)
    let it = item(fig)
    ut.assert_int_eq(it.get_array("yerrs").len(), 0)
    ut.assert_int_eq(it.get_array("xerrs").len(), 0)
}

