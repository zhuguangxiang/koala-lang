// RUN: koala --test %s

// Unit tests for errorbar (Errorbar artist in items.kl, Axes.errorbar in
// figure.kl, plt.errorbar in pyplot.kl). Autoscale/segment expectations
// are matplotlib 3.11.2's own values for the same data (probed in the
// venv). Pixel frame with fixed limits (0, 4): x 70..610, y 50..420.

import "std/ut"
import "koala/plot"
import "koala/plot" as plt
import "koala/json"

func first_axes(fig plot.Figure) json.Object {
    return fig.to_spec().get_array("axes").get_object(0)
}

func item(fig plot.Figure) json.Object {
    return first_axes(fig).get_array("items").get_object(0)
}

@test
func test_errorbar_default() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.errorbar([1.0, 2.0, 3.0], [1.0, 2.0, 3.0], yerr = 0.5)
    let a = first_axes(fig)
    let it = a.get_array("items").get_object(0)
    ut.assert_eq(it.get_str("kind"), "errorbar")
    ut.assert_int_eq(it.get_array("points").len(), 3)
    ut.assert_eq(it.get_str("linestyle"), "-")
    ut.assert_true(!("marker" in it))
    ut.assert_eq(it.get_str("color"), "#1f77b4")
    ut.assert_eq(it.get_str("ecolor"), "#1f77b4")
    ut.assert_float_close(it.get_float("elinewidth"), 1.5)
    ut.assert_int_eq(it.get_array("yerrs").len(), 3)
    ut.assert_int_eq(it.get_array("xerrs").len(), 0)
    ut.assert_float_close(it.get_float("caplen"), 0.0)
    ut.assert_false(it.get_bool("barsabove"))
    // matplotlib autoscale: x data [1,3] -> (0.9, 3.1); y extent
    // [0.5, 3.5] -> (0.35, 3.65).
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.9)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 3.1)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 0.35)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 3.65)
}

@test
func test_errorbar_fmt_o() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).errorbar([1.0, 2.0], [1.0, 2.0], yerr = 0.5, fmt = "o")
    let it = item(fig)
    ut.assert_eq(it.get_str("linestyle"), "")
    ut.assert_eq(it.get_str("marker"), "o")
    ut.assert_int_eq(it.get_array("points").len(), 2)
}

@test
func test_errorbar_fmt_none() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).errorbar([1.0, 2.0], [1.0, 2.0], yerr = 0.5,
                                  fmt = "none")
    let it = item(fig)
    ut.assert_eq(it.get_str("linestyle"), "")
    ut.assert_true(!("marker" in it))
    ut.assert_int_eq(it.get_array("points").len(), 0)
    ut.assert_int_eq(it.get_array("yerrs").len(), 2)
}

@test
func test_errorbar_segment_pixels() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 4.0)
    ax.errorbar([1.0, 2.0], [1.0, 2.0], yerr = 0.1, xerr = 0.3)
    let it = item(fig)
    // point (1,1): y bar [0.9, 1.1] -> y 336.75..318.25; x bar [0.7, 1.3]
    // -> x 164.5..245.5.
    let ys = it.get_array("yerrs").get_object(0)
    ut.assert_float_close(ys.get_float("x"), 205.0)
    ut.assert_float_close(ys.get_float("y0"), 336.75)
    ut.assert_float_close(ys.get_float("y1"), 318.25)
    let xs = it.get_array("xerrs").get_object(0)
    ut.assert_float_close(xs.get_float("y"), 327.5)
    ut.assert_float_close(xs.get_float("x0"), 164.5)
    ut.assert_float_close(xs.get_float("x1"), 245.5)
}

@test
func test_errorbar_caps() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 4.0)
    // capsize 3.6 points at 100 dpi: cap length 2*3.6*100/72 = 10 px.
    ax.errorbar([1.0, 2.0], [1.0, 2.0], yerr = 0.1, capsize = 3.6,
                capthick = 2.0)
    let it = item(fig)
    ut.assert_float_close(it.get_float("caplen"), 10.0)
    ut.assert_float_close(it.get_float("capthick"), 2.0)
    let ycaps = it.get_array("ycaps")
    ut.assert_int_eq(ycaps.len(), 4)
    ut.assert_float_close(ycaps.get_object(0).get_float("y"), 336.75)
    ut.assert_float_close(ycaps.get_object(1).get_float("y"), 318.25)
}

@test
func test_errorbar_errorevery() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).errorbar([1.0, 2.0, 3.0, 4.0],
                                  [1.0, 2.0, 3.0, 4.0], yerr = 0.5,
                                  errorevery = 2)
    let it = item(fig)
    ut.assert_int_eq(it.get_array("yerrs").len(), 2)
}

@test
func test_errorbar_ecolor_elinewidth() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).errorbar([1.0, 2.0], [1.0, 2.0], yerr = 0.5,
                                  ecolor = "r", elinewidth = 2.5)
    let it = item(fig)
    ut.assert_eq(it.get_str("ecolor"), "#ff0000")
    ut.assert_float_close(it.get_float("elinewidth"), 2.5)
    // the data line keeps its own color.
    ut.assert_eq(it.get_str("color"), "#1f77b4")
}

@test
func test_errorbar_nan_skip() {
    let fig = plot.Figure()
    let nan = 0.0 / 0.0
    fig.subplot(1, 1, 1).errorbar([1.0, 2.0, 3.0], [1.0, 2.0, 3.0],
                                  yerrs = [0.5, nan, 2.0])
    let a = first_axes(fig)
    let it = a.get_array("items").get_object(0)
    // the NaN point's bar is skipped.
    ut.assert_int_eq(it.get_array("yerrs").len(), 2)
    // y extent [0.5, 5.0] -> margin 0.225 -> (0.275, 5.225).
    ut.assert_float_close(a.get_array("ylim").get_float(0), 0.275)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 5.225)
}

@test
func test_errorbar_barsabove() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).errorbar([1.0, 2.0], [1.0, 2.0], yerr = 0.5,
                                  barsabove = true)
    ut.assert_true(item(fig).get_bool("barsabove"))
}

@test
func test_errorbar_label_and_alpha() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).errorbar([1.0, 2.0], [1.0, 2.0], yerr = 0.5,
                                  label = "e", alpha = 0.5)
    let it = item(fig)
    ut.assert_eq(it.get_str("label"), "e")
    ut.assert_float_close(it.get_float("alpha"), 0.5)
}

