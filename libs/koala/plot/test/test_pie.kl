// RUN: koala --test %s

// Unit tests for pie (Pie artist in items.kl, Axes.pie in figure.kl,
// plt.pie in pyplot.kl). Angle/label/autopct expectations are matplotlib
// 3.11.2's own values for the same data (probed in the venv). Pixel
// geometry: default figure plot rect (70, 50, 540, 370); the pie resolves
// against the square sub-frame side 370 -> unit 148 px per data unit,
// center (340, 235).

import "std/ut"
import "koala/plot"
import "koala/plot" as plt
import "koala/json"

func first_axes(fig plot.Figure) json.Object {
    return fig.to_spec().get_array("axes").get_object(0)
}

func pie_item(fig plot.Figure) json.Object {
    return first_axes(fig).get_array("items").get_object(0)
}

func wedge(it json.Object, i int) json.Object {
    return it.get_array("wedges").get_object(i)
}

@test
func test_pie_angles_ccw() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.pie([1.0, 2.0, 3.0])
    let it = pie_item(fig)
    ut.assert_eq(it.get_str("kind"), "pie")
    let w0 = wedge(it, 0)
    ut.assert_float_close(w0.get_float("a0"), 0.0)
    ut.assert_float_close(w0.get_float("a1"), 60.0)
    let w1 = wedge(it, 1)
    ut.assert_float_close(w1.get_float("a0"), 60.0)
    ut.assert_float_close(w1.get_float("a1"), 180.0)
    let w2 = wedge(it, 2)
    ut.assert_float_close(w2.get_float("a0"), 180.0)
    ut.assert_float_close(w2.get_float("a1"), 360.0)
    // tab10 cycle, square sub-frame radius.
    ut.assert_eq(w0.get_str("color"), "#1f77b4")
    ut.assert_eq(w1.get_str("color"), "#ff7f0e")
    ut.assert_eq(w2.get_str("color"), "#2ca02c")
    ut.assert_float_close(w0.get_float("r"), 148.0)
    ut.assert_float_close(w0.get_float("cx"), 340.0)
    ut.assert_float_close(w0.get_float("cy"), 235.0)
}

@test
func test_pie_angles_cw() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], counterclock = false)
    let it = pie_item(fig)
    let w0 = wedge(it, 0)
    ut.assert_float_close(w0.get_float("a0"), -60.0)
    ut.assert_float_close(w0.get_float("a1"), 0.0)
    let w1 = wedge(it, 1)
    ut.assert_float_close(w1.get_float("a0"), -180.0)
    ut.assert_float_close(w1.get_float("a1"), -60.0)
    let w2 = wedge(it, 2)
    ut.assert_float_close(w2.get_float("a0"), -360.0)
    ut.assert_float_close(w2.get_float("a1"), -180.0)
}

@test
func test_pie_startangle() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], startangle = 90.0)
    let it = pie_item(fig)
    let w0 = wedge(it, 0)
    ut.assert_float_close(w0.get_float("a0"), 90.0)
    ut.assert_float_close(w0.get_float("a1"), 150.0)
    let w2 = wedge(it, 2)
    ut.assert_float_close(w2.get_float("a0"), 270.0)
    ut.assert_float_close(w2.get_float("a1"), 450.0)
}

@test
func test_pie_explode() {
    let fig = plot.Figure()
    // wedge 1 mid = 120 deg: offset (0.1*cos120, 0.1*sin120).
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], explode = [0.0, 0.1, 0.0])
    let w1 = wedge(pie_item(fig), 1)
    ut.assert_float_close(w1.get_float("cx"), 332.6)
    ut.assert_float_close(w1.get_float("cy"), 222.18282402399032)
    let w0 = wedge(pie_item(fig), 0)
    ut.assert_float_close(w0.get_float("cx"), 340.0)
    ut.assert_float_close(w0.get_float("cy"), 235.0)
}

@test
func test_pie_limits_and_frame() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0])
    let a = first_axes(fig)
    ut.assert_float_close(a.get_array("xlim").get_float(0), -1.25)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 1.25)
    ut.assert_float_close(a.get_array("ylim").get_float(0), -1.25)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 1.25)
    ut.assert_false(a.get_bool("frame"))
}

@test
func test_pie_center() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], center_x = 1.0, center_y = 0.5)
    let a = first_axes(fig)
    ut.assert_float_close(a.get_array("xlim").get_float(0), -0.25)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 2.25)
    ut.assert_float_close(a.get_array("ylim").get_float(0), -0.75)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 1.75)
}

@test
func test_pie_frame_true() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], frame = true)
    ut.assert_true(first_axes(fig).get_bool("frame"))
}

@test
func test_pie_labels() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], labels = ["a", "b", "c"])
    let labs = pie_item(fig).get_array("labels")
    ut.assert_int_eq(labs.len(), 3)
    // labeldistance 1.1 along the bisector, ha by x sign.
    let t0 = labs.get_object(0)
    ut.assert_eq(t0.get_str("text"), "a")
    ut.assert_eq(t0.get_str("ha"), "left")
    ut.assert_float_close(t0.get_float("x"), 480.98893573610667)
    ut.assert_float_close(t0.get_float("y"), 153.6)
    let t1 = labs.get_object(1)
    ut.assert_eq(t1.get_str("text"), "b")
    ut.assert_eq(t1.get_str("ha"), "right")
    ut.assert_float_close(t1.get_float("x"), 258.6)
    ut.assert_float_close(t1.get_float("y"), 94.01106426389336)
    let t2 = labs.get_object(2)
    ut.assert_eq(t2.get_str("ha"), "right")
    ut.assert_float_close(t2.get_float("y"), 235.0 + 1.1 * 148.0)
}

@test
func test_pie_autopct() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], autopct = "%1.1f%%")
    let autos = pie_item(fig).get_array("autotexts")
    ut.assert_int_eq(autos.len(), 3)
    ut.assert_eq(autos.get_object(0).get_str("text"), "16.7%")
    ut.assert_eq(autos.get_object(1).get_str("text"), "33.3%")
    ut.assert_eq(autos.get_object(2).get_str("text"), "50.0%")
    // pctdistance 0.6 along the bisector of wedge 0 (mid 30 deg).
    let t0 = autos.get_object(0)
    ut.assert_float_close(t0.get_float("x"), 416.90305585605813)
    ut.assert_float_close(t0.get_float("y"), 190.6)
}

@test
func test_pie_autopct_int() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], autopct = "%d%%")
    let autos = pie_item(fig).get_array("autotexts")
    ut.assert_eq(autos.get_object(0).get_str("text"), "16%")
    ut.assert_eq(autos.get_object(1).get_str("text"), "33%")
    ut.assert_eq(autos.get_object(2).get_str("text"), "50%")
}

@test
func test_pie_no_autopct_key() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0])
    let it = pie_item(fig)
    ut.assert_int_eq(it.get_array("autotexts").len(), 0)
}

@test
func test_pie_radius() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], radius = 0.8)
    ut.assert_float_close(wedge(pie_item(fig), 0).get_float("r"), 0.8 * 148.0)
}

@test
func test_pie_donut_width() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], width = 0.4)
    let w0 = wedge(pie_item(fig), 0)
    ut.assert_float_close(w0.get_float("width"), 0.4)

    let fig2 = plot.Figure()
    fig2.subplot(1, 1, 1).pie([1.0, 2.0, 3.0])
    let w = wedge(pie_item(fig2), 0)
    ut.assert_true(!("width" in w))
}

@test
func test_pie_colors_wrap() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], colors = ["r"])
    let it = pie_item(fig)
    ut.assert_eq(wedge(it, 0).get_str("color"), "#ff0000")
    ut.assert_eq(wedge(it, 1).get_str("color"), "#ff0000")
    ut.assert_eq(wedge(it, 2).get_str("color"), "#ff0000")
}

@test
func test_pie_normalize_false() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([0.2, 0.3], normalize = false)
    let it = pie_item(fig)
    let w0 = wedge(it, 0)
    ut.assert_float_close(w0.get_float("a0"), 0.0)
    ut.assert_float_close(w0.get_float("a1"), 72.0)
    let w1 = wedge(it, 1)
    ut.assert_float_close(w1.get_float("a0"), 72.0)
    ut.assert_float_close(w1.get_float("a1"), 180.0)
}

@test
func test_pie_edgecolor_alpha() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0], edgecolor = "k", linewidth = 2.0,
                             alpha = 0.5)
    let it = pie_item(fig)
    ut.assert_eq(wedge(it, 0).get_str("edgecolor"), "#000000")
    ut.assert_float_close(wedge(it, 0).get_float("linewidth"), 2.0)
    ut.assert_float_close(it.get_float("alpha"), 0.5)
}

@test
func test_pie_no_edgecolor_key() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0])
    let w = wedge(pie_item(fig), 0)
    ut.assert_true(!("edgecolor" in w))
}

@should_panic("plot.Axes.pie: All wedge sizes are zero")
func test_pie_empty() {
    plot.Figure().subplot(1, 1, 1).pie([])
}

@should_panic("plot.Axes.pie: All wedge sizes are zero")
func test_pie_all_zero() {
    plot.Figure().subplot(1, 1, 1).pie([0.0, 0.0])
}

@should_panic("plot.Axes.pie: Wedge sizes 'x' must be non negative values")
func test_pie_negative() {
    plot.Figure().subplot(1, 1, 1).pie([1.0, -1.0])
}

@should_panic("plot.Axes.pie: Wedge sizes must be finite numbers")
func test_pie_nonfinite() {
    let z = 0.0
    let inf = 1.0 / z
    plot.Figure().subplot(1, 1, 1).pie([1.0, inf])
}

@should_panic("plot.Axes.pie: 'labels' must be of length 'x'")
func test_pie_labels_mismatch() {
    plot.Figure().subplot(1, 1, 1).pie([1.0, 2.0], labels = ["a"])
}

@should_panic("plot.Axes.pie: 'explode' must be of length 'x'")
func test_pie_explode_mismatch() {
    plot.Figure().subplot(1, 1, 1).pie([1.0, 2.0], explode = [0.1])
}

@should_panic("plot.Axes.pie: 'radius' must be a positive number")
func test_pie_bad_radius() {
    plot.Figure().subplot(1, 1, 1).pie([1.0], radius = 0.0)
}

@should_panic("plot.Axes.pie: Cannot plot an unnormalized pie with sum(x) > 1")
func test_pie_unnormalized_sum() {
    plot.Figure().subplot(1, 1, 1).pie([0.6, 0.6], normalize = false)
}

@should_panic("plot.Axes.pie: unsupported autopct format '%s'")
func test_pie_autopct_bad_conversion() {
    plot.Figure().subplot(1, 1, 1).pie([1.0, 2.0], autopct = "%s")
}

@should_panic("plot.Axes.pie: unsupported autopct format '%.1f'")
func test_pie_autopct_missing_percent() {
    plot.Figure().subplot(1, 1, 1).pie([1.0, 2.0], autopct = "%.1f")
}

@should_panic("plot.Axes.pie: colors must not be empty")
func test_pie_empty_colors() {
    plot.Figure().subplot(1, 1, 1).pie([1.0, 2.0], colors = [])
}

@test
func test_pyplot_pie_forwarding() {
    plt.close()
    plt.figure()
    let p = plt.pie([1.0, 2.0, 3.0], labels = ["a", "b", "c"])
    ut.assert_eq(p.kind(), "pie")
    ut.assert_int_eq(plt.gca().artists.len(), 1)
    ut.assert_false(plt.gca().frame_on)
}

@test
func test_pie_textprops_full() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0, 3.0], autopct = "%1.1f%%",
        textprops = plot.TextProps(color = "white", fontsize = 14.0,
            fontweight = "bold", fontstyle = "italic",
            family = "monospace", alpha = 0.5, rotation = 45.0))
    let p = pie_item(fig).get_object("textprops")
    ut.assert_eq(p.get_str("color"), "#ffffff")
    ut.assert_float_close(p.get_float("fontsize"), 14.0)
    ut.assert_eq(p.get_str("fontweight"), "bold")
    ut.assert_eq(p.get_str("fontstyle"), "italic")
    ut.assert_eq(p.get_str("family"), "monospace")
    ut.assert_float_close(p.get_float("alpha"), 0.5)
    ut.assert_float_close(p.get_float("rotation"), 45.0)
    // autotexts still present
    let its = pie_item(fig).get_array("autotexts")
    ut.assert_int_eq(its.len(), 3)
}

@test
func test_pie_textprops_partial() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0], autopct = "%d%%",
        textprops = plot.TextProps(color = "red"))
    let p = pie_item(fig).get_object("textprops")
    ut.assert_eq(p.get_str("color"), "#ff0000")
    ut.assert_true(p.get("fontsize") == nil)
    ut.assert_true(p.get("alpha") == nil)
}

@test
func test_pie_no_textprops_key() {
    let fig = plot.Figure()
    fig.subplot(1, 1, 1).pie([1.0, 2.0], autopct = "%d%%")
    ut.assert_true(pie_item(fig).get("textprops") == nil)
}

@test
func test_pyplot_pie_textprops_forwarding() {
    plt.close()
    plt.figure()
    plt.pie([1.0, 2.0], autopct = "%d%%",
            textprops = plt.TextProps(fontsize = 20.0))
    let ax = plt.gcf().to_spec().get_array("axes").get_object(0)
    let p = ax.get_array("items").get_object(0).get_object("textprops")
    ut.assert_float_close(p.get_float("fontsize"), 20.0)
}

@should_panic("plot.TextProps: 'fontsize' must be a positive number")
func test_textprops_zero_fontsize() {
    plot.TextProps(fontsize = 0.0)
}

@should_panic("plot.TextProps: 'alpha' must be in [0, 1]")
func test_textprops_bad_alpha() {
    plot.TextProps(alpha = 1.5)
}
