// RUN: koala --test %s

// Unit tests for bar/barh (Bar artist in items.kl, Axes.bar/barh in
// figure.kl, plt.bar/plt.barh in pyplot.kl). Autoscale expectations are
// matplotlib 3.11.2's own view limits for the same data (baseline sticky,
// width 0.8, margin 5%).

import "std/ut"
import "koala/plot"
import "koala/plot" as plt
import "koala/json"

func first_axes(fig plot.Figure) json.Object {
    return fig.to_spec().get_array("axes").get_object(0)
}

@test
func test_bar_autoscale_center() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.bar([1.0, 2.0, 3.0], [1.0, 2.0, 3.0])
    let a = first_axes(fig)
    // data x [0.6, 3.4] + 5% margin; y baseline 0 is sticky.
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.46)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 3.54)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 0.0)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 3.15)
    let it = a.get_array("items").get_object(0)
    ut.assert_eq(it.get_str("kind"), "bar")
    ut.assert_int_eq(it.get_array("rects").len(), 3)
    ut.assert_eq(it.get_str("color"), "#1f77b4")
}

@test
func test_bar_autoscale_edge() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.bar([1.0, 2.0, 3.0], [1.0, 2.0, 3.0], align = "edge")
    let a = first_axes(fig)
    // data x [1, 3.8] + 5% margin.
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.86)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 3.94)
}

@test
func test_bar_negative_baseline_sticky() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.bar([1.0, 2.0, 3.0], [-1.0, 2.0, -3.0])
    let a = first_axes(fig)
    ut.assert_float_close(a.get_array("ylim").get_float(0), -3.25)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 2.25)
}

@test
func test_barh_autoscale() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.barh([1.0, 2.0, 3.0], [1.0, 2.0, 3.0])
    let a = first_axes(fig)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 0.46)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 3.54)
    ut.assert_float_close(a.get_array("xlim").get_float(0), 0.0)
    ut.assert_float_close(a.get_array("xlim").get_float(1), 3.15)
}

@test
func test_bar_spec_fields() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.set_xlim(0.0, 4.0)
    ax.set_ylim(0.0, 4.0)
    ax.bar([1.0, 3.0], [1.0, 2.0], width = 2.0, bottom = 1.0,
           edgecolor = "k", linewidth = 2.0, alpha = 0.5, label = "a")
    let it = first_axes(fig).get_array("items").get_object(0)
    ut.assert_eq(it.get_str("edgecolor"), "#000000")
    ut.assert_float_close(it.get_float("linewidth"), 2.0)
    ut.assert_float_close(it.get_float("alpha"), 0.5)
    ut.assert_eq(it.get_str("label"), "a")
    // Known pixel frame: x 70..610 over [0,4], y 420..50 over [0,4].
    // Bar at x=1, width 2 -> x 70..340; bottom 1, height 1 -> y 327.5..235.
    let r0 = it.get_array("rects").get_object(0)
    ut.assert_float_close(r0.get_float("x0"), 70.0)
    ut.assert_float_close(r0.get_float("x1"), 340.0)
    ut.assert_float_close(r0.get_float("y0"), 327.5)
    ut.assert_float_close(r0.get_float("y1"), 235.0)
}

@test
func test_bar_tick_label() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.bar([1.0, 2.0], [1.0, 2.0], tick_label = ["a", "b"])
    let (locs, labels) = ax.get_xticks()
    ut.assert_int_eq(locs.len(), 2)
    ut.assert_eq(labels[0], "a")
    ut.assert_eq(labels[1], "b")
}

@test
func test_bar_bottom_sequence() {
    // Per-bar baseline: rect y0 comes from the per-bar bottom, and the
    // autoscaled view includes the baseline spread (no common sticky).
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.bar([1.0, 2.0, 3.0], [1.0, 2.0, 3.0],
           bottom = [0.5, 1.0, 1.5])
    let it = first_axes(fig).get_array("items").get_object(0)
    ut.assert_int_eq(it.get_array("rects").len(), 3)
    let r0 = it.get_array("rects").get_object(0)
    // xlim/ylim: data spans y [0.5, 4.5]; margins 5% of 4 -> +-0.2, then
    // sticky baselines clamp the floor to 0.5 (mpl: ylim (0.5, 4.7)).
    let a = first_axes(fig)
    ut.assert_float_close(a.get_array("ylim").get_float(0), 0.5)
    ut.assert_float_close(a.get_array("ylim").get_float(1), 4.7)
    // With set_ylim the pixel math is exact: y 0..5 -> pixel y0 for
    // bottom 0.5/1.5 differs per bar.
    ax.set_ylim(0.0, 5.0)
    let it2 = first_axes(fig).get_array("items").get_object(0)
    let r0b = it2.get_array("rects").get_object(0)
    let r2b = it2.get_array("rects").get_object(2)
    // y pixel: 420 - v/5*370.
    ut.assert_float_close(r0b.get_float("y0"), 420.0 - 0.5 / 5.0 * 370.0)
    ut.assert_float_close(r2b.get_float("y0"), 420.0 - 1.5 / 5.0 * 370.0)
    ut.assert_float_close(r0b.get_float("y1"), 420.0 - 1.5 / 5.0 * 370.0)
}

@test
func test_bar_bottom_single_element_broadcasts() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.bar([1.0, 2.0], [1.0, 2.0], bottom = [2.0])
    ax.set_ylim(0.0, 5.0)
    let it = first_axes(fig).get_array("items").get_object(0)
    let r0 = it.get_array("rects").get_object(0)
    let r1 = it.get_array("rects").get_object(1)
    ut.assert_float_close(r0.get_float("y0"), 420.0 - 2.0 / 5.0 * 370.0)
    ut.assert_float_close(r1.get_float("y0"), 420.0 - 2.0 / 5.0 * 370.0)
}

@test
func test_barh_left_sequence() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.barh([1.0, 2.0], [3.0, 4.0], left = [0.25, 0.75])
    ax.set_xlim(0.0, 5.0)
    let it = first_axes(fig).get_array("items").get_object(0)
    let r0 = it.get_array("rects").get_object(0)
    let r1 = it.get_array("rects").get_object(1)
    // x pixel: 70 + v/5*540.
    ut.assert_float_close(r0.get_float("x0"), 70.0 + 0.25 / 5.0 * 540.0)
    ut.assert_float_close(r1.get_float("x0"), 70.0 + 0.75 / 5.0 * 540.0)
    ut.assert_float_close(r0.get_float("x1"), 70.0 + 3.25 / 5.0 * 540.0)
}

@should_panic("plot.Bar: baseline must be scalar or match the bar count")
func test_bar_bottom_length_mismatch() {
    plot.Figure().subplot(1, 1, 1).bar([1.0, 2.0], [1.0, 2.0],
                                       bottom = [0.5, 1.0, 1.5])
}

@should_panic("plot.Bar: baseline must be scalar or match the bar count")
func test_barh_left_length_mismatch() {
    plot.Figure().subplot(1, 1, 1).barh([1.0, 2.0], [1.0, 2.0],
                                        left = [0.25, 0.75, 1.25])
}

@test
func test_pyplot_bar_sequence_forwarding() {
    plt.close()
    plt.figure()
    let b = plt.bar([1.0, 2.0], [2.0, 4.0], bottom = [1.0, 2.0])
    ut.assert_int_eq(b.baselines.len(), 2)
    ut.assert_float_close(b.baselines[1], 2.0)
}

@test
func test_barh_tick_label() {
    let fig = plot.Figure()
    let ax = fig.subplot(1, 1, 1)
    ax.barh([1.0, 2.0], [1.0, 2.0], tick_label = ["x", "y"])
    let (locs, labels) = ax.get_yticks()
    ut.assert_int_eq(locs.len(), 2)
    ut.assert_eq(labels[0], "x")
    ut.assert_eq(labels[1], "y")
}

@should_panic("plot.Bar: coordinates and sizes must have the same length")
func test_bar_length_mismatch() {
    plot.Figure().subplot(1, 1, 1).bar([1.0], [1.0, 2.0])
}

@should_panic("plot.Bar: align must be 'center' or 'edge'")
func test_bar_bad_align() {
    plot.Figure().subplot(1, 1, 1).bar([1.0], [1.0], align = "middle")
}

@should_panic("plot.Axes.bar: tick_label must match x length")
func test_bar_tick_label_mismatch() {
    plot.Figure().subplot(1, 1, 1).bar([1.0, 2.0], [1.0, 2.0],
                                       tick_label = ["only"])
}

@should_panic("plot.Bar: alpha must be in [0, 1]")
func test_bar_alpha_bad() {
    plot.Figure().subplot(1, 1, 1).bar([1.0], [1.0], alpha = 2.0)
}

@test
func test_pyplot_bar_forwarding() {
    plt.close()
    plt.figure()
    let b = plt.bar([1.0, 2.0], [2.0, 4.0], color = "r", label = "n")
    ut.assert_eq(b.kind(), "bar")
    ut.assert_eq(b.color, "#ff0000")
    // NOTE: assert_eq(str?, str) crashes the parser (check_generic_bound
    // assertion, optional type arg); unwrap with if let as elsewhere.
    if let lb = b.legend_label() {
        ut.assert_eq(lb, "n")
    } else {
        ut.assert_true(false, "label not set")
    }
    let h = plt.barh([1.0, 2.0], [2.0, 4.0], color = "g")
    ut.assert_eq(h.color, "#008000")
    ut.assert_int_eq(plt.gca().artists.len(), 2)
}
