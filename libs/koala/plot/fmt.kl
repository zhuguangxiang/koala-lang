/// matplotlib format-string parsing for `plot` (e.g. "ro--" = red, circle
/// marker, dashed line). A fmt string combines, in any order, an optional
/// color (single char `rgbcmykw` or `C0`..`C9` cycle index), an optional
/// line style (`-` `--` `-.` `:`) and an optional marker. Explicit keyword
/// arguments override whatever the fmt string supplies.

/// The marker characters matplotlib accepts in a fmt string.
func marker_chars() str {
    return ".,ov^<>12348spP*hH+xXDd|_"
}

/// Remove the first occurrence of `sub` from `s` (no-op when absent).
func remove_first(s str, sub str) str {
    let i = s.index(sub)
    if i < 0 {
        return s
    }
    return s.substr(0, i) + s.substr(i + sub.len())
}

/// Parse a matplotlib fmt string into `(color, linestyle, marker)`, each nil
/// when the string does not specify it. The line style is matched longest
/// first so "-." is not mistaken for "-" plus a "." marker. Panics on an
/// unknown character or a repeated color/marker.
pub func parse_fmt(fmt str) (str?, str?, str?) {
    var rest = fmt
    var ls str? = nil
    if rest.index("-.") >= 0 {
        ls = "-."
        rest = remove_first(rest, "-.")
    } else if rest.index("--") >= 0 {
        ls = "--"
        rest = remove_first(rest, "--")
    } else if rest.index(":") >= 0 {
        ls = ":"
        rest = remove_first(rest, ":")
    } else if rest.index("-") >= 0 {
        ls = "-"
        rest = remove_first(rest, "-")
    }

    var color str? = nil
    var marker str? = nil
    let markers = marker_chars()
    var i = 0
    while i < rest.len() {
        let c = rest[i]
        if c == "C" {
            if i + 1 >= rest.len() {
                panic("plot.fmt: 'C' must be followed by a cycle digit")
            }
            let d = rest[i + 1]
            if "0123456789".index(d) < 0 {
                panic(format("plot.fmt: invalid cycle index 'C{}'", d))
            }
            if color != nil {
                panic("plot.fmt: multiple colors in format string")
            }
            color = "C" + d
            i = i + 2
        } else if "rgbcmykw".index(c) >= 0 {
            if color != nil {
                panic("plot.fmt: multiple colors in format string")
            }
            color = c
            i = i + 1
        } else if markers.index(c) >= 0 {
            if marker != nil {
                panic("plot.fmt: multiple markers in format string")
            }
            marker = c
            i = i + 1
        } else {
            panic(format("plot.fmt: invalid format character '{}'", c))
        }
    }
    return (color, ls, marker)
}