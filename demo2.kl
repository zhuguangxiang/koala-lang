class LinkedList {
    next Node?
    count int

    public func __init__() {
        self.next = none
        self.count = 0
    }
}

class Node {
    next Node?
    val int

    public static let K = 100

    public static func __new__() {

    }

    func __init__(val int, next Node? = none) {
        self.val = val
        self.next = next
    }
}

l := List()

next := l.next
node := Node(200, next)
l.next = node

head := l.next
while r := head {
    print(r.val)
    head = r.next
}

