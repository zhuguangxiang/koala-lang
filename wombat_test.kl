import "std/os"
import "std/fs"
import "wombat_build" as wb

/// Run all tests for every package in the workspace.
///
/// Does not build. The `.klc` artifacts that tests import must
/// already exist on `KOALA_PATH`, produced by a prior `wombat build`.
/// This keeps `test` focused on running tests, not compiling.
///
/// Packages without a `test` field are skipped silently. Packages
/// whose `test` directory is missing are a configuration error and
/// abort the run. Empty test directories are reported and skipped.
pub func test_all(src_dir str) int {
    print("🧪 Wombat Test Started...")

    let src_abs = fs.Path(src_dir).absolute().to_str()
    let ws = wb.load_workspace(src_abs)
    if ws.packages.len() == 0 {
        print("wombat test: no packages to test")
        return 1
    }

    let ws_parent = fs.Path(ws.root).parent().to_str()
    let ws_name = fs.Path(ws.root).name()
    var total = 0
    var failed = 0
    var tested_pkgs = 0
    var skipped_pkgs = 0

    for pkg in ws.packages {
        // 1. No `test` field: this package does not ship tests.
        if pkg.test.empty() {
            skipped_pkgs += 1
            continue
        }

        // 2. `test` is configured but the directory is missing.
        //    This is a configuration error: `__pkg__.toml` claims
        //    tests exist, but the path does not resolve.
        let test_dir_abs = fs.Path(ws.root).cat(pkg.dir_name).cat(pkg.test).to_str()
        if !fs.exists(test_dir_abs) {
            print("❌ " + pkg.name + ": test directory '" + pkg.test +
                  "' not found (expected: " + test_dir_abs + ")")
            return 1
        }

        // 3. Collect `.kl` files in the test directory. `list_dir`
        //    returns full Paths; only the file name is kept so the
        //    command uses a path relative to `ws_parent`, matching
        //    the base that `wombat build` uses.
        let entries = fs.list_dir(test_dir_abs)
        let test_files = list[str]()
        for e in entries {
            if e.name().ends_with(".kl") {
                test_files.append(e.name())
            }
        }
        if test_files.len() == 0 {
            print("⏭️  " + pkg.name + ": no test files in '" + pkg.test + "', skipped")
            skipped_pkgs += 1
            continue
        }

        // 4. Run each test file in its own process.
        tested_pkgs += 1
        print("")
        print("🧪 Testing package: " + pkg.name +
              " (" + test_files.len().to_str() + " files)")

        let test_rel = ws_name + "/" + pkg.dir_name + "/" + pkg.test
        for name in test_files {
            let rel = test_rel + "/" + name
            print("")
            print("🚀 Running: koala --test " + rel)

            let full = "cd " + ws_parent +
                       " && koala --test " + rel

            let rc = os.system(full)

            // Blank line separates koala's test output ("All tests
            // passed.") from wombat's own PASS/FAIL line.
            print("")
            total += 1
            if rc != 0 {
                failed += 1
                print("❌ FAIL: " + rel)
            } else {
                print("✅ PASS: " + rel)
            }
        }
    }

    let passed = total - failed
    print("")
    if total > 0 {
        print("wombat test: " + passed.to_str() + " passed, " +
              failed.to_str() + " failed, " + total.to_str() + " total")
    }
    print("wombat test: " + tested_pkgs.to_str() + " package(s) tested, " +
          skipped_pkgs.to_str() + " skipped")

    if total == 0 {
        print("wombat test: no test files found")
        return 0
    }
    if failed > 0 { return 1 }
    return 0
}
