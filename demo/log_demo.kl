/*
 * log_demo.kl — koala/log 用法示例。
 */

import "koala/log"

func main() {
    // 1. Default logger: stderr, INFO threshold
    log.info("demo started")

    // 2. Below threshold: fast path, no Record constructed
    log.debug("not shown at INFO level")

    // 3. Lower the global threshold
    log.get_default().set_level(log.DEBUG)
    log.debug("shown after lowering the level")

    // 4. Resident fields: assigned once, attached to every record
    let base = list[log.Attr]()
    base.append(log.Attr("service", "demo"))
    base.append(log.Attr("pid", "1234"))
    log.get_default().set_attrs(base)
    log.info("request received")

    //-----------------------------------------------------------------

    // 5. File output with its own logger
    let f = log.FileHandler("demo.log")

    let flog = log.Logger(f, log.TextFormatter())
    flog.set_attrs(base)
    flog.debug("debug to file")
    flog.info("info to file")


    //-----------------------------------------------------------------

    // 6. Multi output: terminal and file in one logger
    let hs = list[log.Handler]()
    hs.append(log.DefaultHandler())
    hs.append(log.FileHandler("both.log"))
    let both = log.Logger(log.MultiHandler(hs), log.TextFormatter())
    both.info("to terminal and both.log")

    f.close()
}
