/*
 * webview_demo.kl — 用 koala/webview 创建一个原生桌面 app。
 *
 * 运行（仓库根目录或 demo/ 目录均可，需先构建 koala/webview）：
 *
 *     export LD_LIBRARY_PATH=libs/koala/dist/koala:$HOME/.local/lib:$LD_LIBRARY_PATH
 *     export KOALA_PATH=libs/koala/dist:libs/std/dist
 *     koala demo/webview_demo.kl
 *
 * 它打开一个系统 webview 原生窗口（Linux 上是 WebKitGTK），渲染一个小型
 * 交互 app：实时时钟、Koala 驱动的计数按钮、主题切换、全屏切换。
 * 关掉窗口即退出。
 *
 * 演示的 API：
 *   Window() / set_title / set_size   创建并配置窗口
 *   set_html_file(path, vars)         从独立模板文件加载 HTML，{{key}} 替换
 *   poll()                            非阻塞步进事件循环（pump 模式，替代 run()）
 *   eval_sync(js)                     取回 JS 结果：排空 window.__outbox 事件队列
 *   eval(js)                          把 Koala 侧的更新推回页面
 *   set_fullscreen(on)                全屏切换
 *   destroy()                         释放窗口（运行时暂无 finalizer，需显式调用）
 *
 * 事件回路：页面点击 → push 进 window.__outbox → Koala 每帧 eval_sync 取回
 * → 在 Koala 里处理 → eval 更新页面。全程没有 native->Koala 回调。
 *
 * 进阶：把 set_html_file 换成 navigate("http://127.0.0.1:8080/")，就能显示
 * 由 koala/http 服务、koala/sse 实时推送的仪表盘——桌面 ML 看板就是这么搭的。
 */

import "koala/webview"
import "std/time"
import "std/fs"

func main() {
    let w = webview.Window()
    w.set_title("Koala Desktop App")
    w.set_size(900, 640)

    // HTML 不再硬编码：独立模板文件 + {{version}} 占位替换。
    // 兼容从仓库根目录或 demo/ 目录运行。
    var html_path = "demo/webview_demo.html"
    if !fs.exists(html_path) { html_path = "webview_demo.html" }
    let vars dict[str, any] = {"version": webview.version}
    w.set_html_file(html_path, vars)

    // 等页面脚本就绪（load_html 是异步的）。
    w.poll()
    while w.eval_sync("typeof window.__outbox") != "object" {
        w.poll()
    }

    var count = 0
    var fullscreen = false
    while w.poll() {
        let events = w.eval_sync("window.__outbox.splice(0).join(',')")
        if !events.empty() {
            for ev in events.split(",") {
                if ev == "inc" {
                    count = count + 1
                    w.eval("document.getElementById('count').textContent = " + format("{}", count))
                } else if ev == "fs" {
                    fullscreen = !fullscreen
                    w.set_fullscreen(fullscreen)
                    var label = "Windowed"
                    if fullscreen { label = "Fullscreen" }
                    w.eval("document.getElementById('fs-state').textContent = '" + label + "'")
                }
            }
        }
        time.sleep(time.Duration(10000000)) // 10ms，避免空转
    }
    w.destroy()
}