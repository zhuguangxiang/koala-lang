/*
 * redis_demo.kl — koala/redis 用法示例。
 *
 * 先写入数据，再从服务器读出来；最后演示一次 pipeline。
 */

import "koala/redis"

func main() {
    let c = redis.connect()
    if !c.ping() {
        print("redis demo: cannot connect to 127.0.0.1:6379")
        c.close()
        return
    }

    let str_key = "koala:demo:greeting"
    let list_key = "koala:demo:queue"
    let pipe_key = "koala:demo:pipeline"

    // 清掉上次运行残留
    c.del([str_key, list_key, pipe_key])

    //-----------------------------------------------------------------
    // 1. 写入
    print("-- write --")

    if c.set(str_key, "hello koala") {
        print("SET   ", str_key, "=", "hello koala")
    }

    print("RPUSH ", list_key, "first  ->", c.rpush(list_key, "first"))
    print("RPUSH ", list_key, "second ->", c.rpush(list_key, "second"))
    print("LPUSH ", list_key, "zeroth ->", c.lpush(list_key, "zeroth"))

    //-----------------------------------------------------------------
    // 2. 从服务器读回
    print("-- read --")

    print("GET   ", str_key, "->", c.get(str_key)!)

    let items = c.lrange(list_key, 0, -1)!
    print("LRANGE", list_key, "0 -1 ->", items.len(), "items")
    var i = 0
    while i < items.len() {
        print("  [", i, "]", items[i])
        i += 1
    }
    print("LLEN  ", list_key, "->", c.llen(list_key))

    //-----------------------------------------------------------------
    // 3. 一次请求发送多条命令（pipeline）
    print("-- pipeline --")

    let set_cmd = redis.Command("SET").arg(pipe_key).arg("pipelined")
    let get_cmd = redis.Command("GET").arg(pipe_key)

    let p = c.pipeline()
    p.add(set_cmd)
    p.add(get_cmd)
    p.exec()

    let r0 = set_cmd.result().val
    if r0 is redis.StatusReply {
        print("  SET ->", r0.value)
    }

    let r1 = get_cmd.result().val
    if r1 is redis.BulkReply {
        print("  GET ->", r1.value)
    }

    //-----------------------------------------------------------------
    // 4. 清理
    c.del([str_key, list_key, pipe_key])

    c.close()
    print("done")
}
