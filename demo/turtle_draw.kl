/*
 * turtle_draw.kl — koala/turtle 交互示例：键盘控制海龟画图。
 *
 * 运行：./demo/run_turtle_draw.sh
 *
 * 操作：
 *   ↑ / ↓      前进 / 后退（落笔时画线）
 *   ← / →      左转 / 右转
 *   空格       抬笔 / 落笔 切换
 *   C          清屏
 *   Esc/关窗   退出
 *
 * 画笔颜色随时间渐变，落笔移动即画出彩虹轨迹。空格和 C 用边沿检测
 * （只在按下的那一帧触发一次），避免按住时反复切换。
 */

import "koala/turtle"

func main() {
    let step = 3.0
    let turn = 4.0
    var space_was = false
    var c_was = false
    var tick = 0

    turtle.pensize(2)
    while !turtle.closed() {
        // 彩虹渐变画笔
        turtle.color((tick * 2) % 256, (tick * 2 + 85) % 256, (tick * 2 + 170) % 256)

        if turtle.key("up") { turtle.forward(step) }
        if turtle.key("down") { turtle.backward(step) }
        if turtle.key("left") { turtle.left(turn) }
        if turtle.key("right") { turtle.right(turn) }

        let space_now = turtle.key("space")
        if space_now && !space_was {
            if turtle.isdown() { turtle.penup() } else { turtle.pendown() }
        }
        space_was = space_now

        let c_now = turtle.key("c")
        if c_now && !c_was { turtle.clear() }
        c_was = c_now

        turtle.update()
        tick = tick + 1
    }
    turtle.bye()
}