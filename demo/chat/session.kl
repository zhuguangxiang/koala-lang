/*
 * demo/chat — the conversation, model selection and agent work directory.
 */

import "std/fs"
import "std/os"
import "std/time"
import "koala/readline"
import "koala/openai" as openai
from "koala/http" import Url, Request, Client
from "koala/json" import try_parse_str, Object, String, Integer, Boolean, Array

/// An ordered conversation of OpenAI-format messages, starting with a
/// system prompt. Session owns the message list, the turn-taking with the
/// model, and the current model (switchable mid-chat). Settings come from
/// `cfg`; `key` is the credential used for the model-list query.
pub class Session {
    let client openai.Client
    let cfg Config
    let key str
    var _name str
    // the storage id: the record's file name (`<id>.json`). /rename only
    // changes the display name, so the id is what a save writes to and what
    // the .current pointer stores.
    var _id str
    var paused bool
    var model str
    var workdir str
    // the tool permission mode for this session's agent; /permissions and
    // /plan switch it, and a new or restored Agent inherits it
    var permission_mode str
    let messages list[dict[str, str]]
    var _agent Agent?
    var _last_tokens int
    // the git branch under `workdir`, queried once per work dir
    var _branch_dir str
    var _branch_name str

    pub func __init__(_client openai.Client, _cfg Config, _key str, name str = "main") {
        client = _client
        cfg = _cfg
        key = _key
        _name = name
        _id = name
        paused = false
        model = _cfg.model
        workdir = os.getcwd()
        permission_mode = _cfg.agent_permission_mode
        messages = list[dict[str, str]]()
        _agent = nil
        _last_tokens = 0
        _branch_dir = ""
        _branch_name = ""
        reset()
    }

    /// The session's name in the session list.
    pub func name() str { return _name }

    /// Rename the session (used by /rename).
    pub func set_name(n str) { _name = n }

    /// The stable storage id: the record's file name without ".json". A save
    /// writes `<id>.json`, and /rename never changes it.
    pub func id() str { return _id }

    /// Set the storage id (used when a restored record's id is missing).
    pub func set_id(i str) { _id = i }

    /// Freeze automatic compaction for this session; manual /compact still
    /// works. The live agent, if any, is paused with it.
    pub func pause() {
        paused = true
        if let a = _agent { a.set_paused(true) }
    }

    /// Undo pause().
    pub func resume() {
        paused = false
        if let a = _agent { a.set_paused(false) }
    }

    /// True while the session is paused.
    pub func is_paused() bool { return paused }

    /// The session's tool permission mode.
    pub func permission() str { return permission_mode }

    /// Switch the permission mode; false when `mode` is not a mode name.
    /// A live agent is switched with it, so the next call obeys the new
    /// decision table immediately.
    pub func set_permission_mode(mode str) bool {
        let m = normalize_permission_mode(mode)
        if m == "" { return false }
        permission_mode = m
        if let a = _agent { a.set_permission_mode(m) }
        return true
    }

    /// The persisted record of this session.
    pub func to_record() Object {
        let o = Object()
        o["version"] = Integer(2)
        o["id"] = String(_id)
        o["name"] = String(_name)
        o["model"] = String(model)
        o["workdir"] = String(workdir)
        o["paused"] = Boolean(paused)
        o["last_tokens"] = Integer(_last_tokens)
        o["messages"] = _msgs(messages)
        var am = Array()
        if let a = _agent { am = a.conversation_json() }
        o["agent_messages"] = am
        o["run_state"] = String(run_state())
        if let a = _agent {
            let why = a.pending_reason()
            if why != "" {
                let p = Object()
                p["mark"] = Integer(a.pending_mark())
                p["reason"] = String(why)
                o["pending"] = p
            }
        }
        return o
    }

    /// "pending" while the agent holds a turn /continue can resume (step
    /// limit or Ctrl-C), "idle" otherwise.
    pub func run_state() str {
        if let a = _agent {
            if a.pending_reason() != "" { return "pending" }
        }
        return "idle"
    }

    /// "" when no agent turn is unfinished, else why it stopped.
    pub func pending_reason() str {
        if let a = _agent { return a.pending_reason() }
        return ""
    }

    /// Clear the conversation back to the single system message, and drop
    /// the agent's memory so the next agent task starts fresh.
    pub func reset() {
        messages.clear()
        messages.append({"role": "system", "content": cfg.system_prompt})
        _agent = nil
        _last_tokens = 0
    }

    /// (chat messages, agent messages) — the agent side is 0 until it has
    /// run, and /sessions shows both so a long agent task is visible.
    pub func message_counts() (int, int) {
        var am = 0
        if let a = _agent { am = a.message_count() }
        return (messages.len(), am)
    }

    /// The model currently in use.
    pub func current_model() str { return model }

    /// Switch the model used for subsequent turns.
    pub func set_model(name str) { model = name }

    /// Load `path` into the conversation as a user message: the chat history,
    /// or the agent's conversation when `is_agent` (so an agent task started
    /// later in the same session sees the file). Return the number of
    /// characters added, or nil when the file cannot be read or is inside a
    /// no-access directory.
    /// The fence and the path line are what make the model quote locations
    /// back well.
    pub func load_file(path str, is_agent bool = false) int? {
        if path_blocked(path, workdir, cfg.no_access_dirs) { return nil }
        if !fs.is_file(path) { return nil }
        let text = fs.read_str(path, cfg.max_code_bytes)
        let content = "File: " + path + "\n```\n" + text + "\n```\n"
        if is_agent {
            _ensure_agent().add_context(content)
        } else {
            messages.append({"role": "user", "content": content})
        }
        return content.len()
    }

    /// Send `text` as a user turn and stream the reply in line by line:
    /// each line is emitted as soon as its newline arrives. On a failed
    /// request the user turn is rolled back so the conversation stays
    /// consistent for a retry; on success the full reply is appended.
    /// Return false on failure.
    pub func ask(text str) bool {
        messages.append({"role": "user", "content": text})
        show_busy("Thinking")
        let stream = client.chat.completions.stream(model, messages, cfg.temperature, cfg.max_tokens)
        hide_busy()
        if !stream.ok() {
            messages.pop()
            emit(http_error(stream.status_code(), stream.error_message(), plain_mode()))
            stream.close()
            return false
        }
        var content = ""
        var pending = ""
        var started = false
        for chunk in stream {
            // a resize may arrive between two streamed chunks; re-lay out
            // before the next line is printed
            poll_resize()
            if chunk.delta.len() == 0 { continue }
            content += chunk.delta
            pending += chunk.delta
            let lines = pending.split("\n")
            var i = 0
            while i < lines.len() - 1 {
                if !started {
                    emit("bot> " + lines[i])
                    started = true
                } else {
                    emit(lines[i])
                }
                _pace(cfg.stream_delay_ms)
                i += 1
            }
            pending = lines[lines.len() - 1]
        }
        // The tail after the last newline, if any.
        if pending.len() > 0 {
            if started {
                emit(pending)
            } else {
                emit("bot> " + pending)
            }
            _pace(cfg.stream_delay_ms)
        }
        let usage = stream.usage()
        stream.close()
        messages.append({"role": "assistant", "content": content})
        _last_tokens = usage.prompt_tokens
        if usage.total_tokens > 0 { emit(format("({} tokens)", usage.total_tokens)) }
        if !paused {
            if let after = maybe_compact(client, model, cfg, messages, usage.prompt_tokens) {
                _last_tokens = after
            }
        }
        return true
    }

    /// Run the coding agent loop on `task` with the current model. The
    /// Agent persists across calls so follow-up tasks keep the conversation
    /// and the working directory; /reset drops it.
    pub func agent(task str) {
        _ensure_agent().run(task, model)
    }

    /// The live agent, created and wired to the UI on first use: the
    /// approver, the permission mode and the paused flag all come from this
    /// session, so a restored or freshly made Agent cannot bypass them.
    func _ensure_agent() Agent {
        if let a = _agent { return a }
        let a = Agent(client, cfg, workdir)
        a.set_approver(request_approval)
        a.set_permission_mode(permission_mode)
        a.set_paused(paused)
        _agent = a
        return a
    }

    /// Continue the active agent task after the step cap (/continue): the
    /// conversation is kept, only a new request is made.
    pub func continue_agent() {
        if let a = _agent {
            a.resume(model)
        } else {
            emit("(no agent task to continue)")
        }
    }

    /// /cancel: drop the turn an interrupt left half done, including its user
    /// message, so the conversation is what it was before the task. False
    /// when nothing was interrupted.
    pub func cancel_agent() bool {
        if let a = _agent {
            if a.cancel() {
                emit("(cancelled the interrupted turn)")
                return true
            }
        }
        return false
    }

    /// The last executed tool action and its full observation, for Ctrl-O.
    /// Nil when no tool has run in this process (a restored session's agent
    /// has the conversation but not the per-action screen state).
    pub func tool_output() (str, str)? {
        if let a = _agent {
            if a.has_tool_output() { return a.tool_output() }
        }
        return nil
    }

    /// Manually compact the active conversation (/compact): the agent's in
    /// agent mode, else the chat's.
    pub func compact(is_agent bool) {
        if is_agent {
            if let a = _agent {
                a.compact(model)
            } else {
                emit("(no agent conversation yet)")
            }
        } else {
            if let after = compact_now(client, model, cfg, messages, _last_tokens) {
                _last_tokens = after
            }
        }
    }

    /// Show the context window size and last usage ratio (/context).
    pub func show_context(is_agent bool) {
        var which = "chat"
        if is_agent { which = "agent" }
        let used = active_tokens(is_agent)
        let window = cfg.context_window
        let tenths = used * 1000 / window
        let pct = str(tenths / 10) + "." + str(tenths % 10) + "%"
        emit("[" + which + "] context: " + str(used) + " / " + str(window) + " tokens (" + pct + ")")
        emit("auto-compaction at " + str(COMPACT_PERCENT) + "% (" + str(window * COMPACT_PERCENT / 100) + " tokens)")
    }

    /// Change the directory the agent works in (/workdir PATH). Return
    /// false when `path` is not a directory or is inside a no-access
    /// directory. Applies to the next agent run and, when an agent is
    /// already live, to it too.
    pub func set_workdir(path str) bool {
        if !fs.is_dir(path) { return false }
        if path_blocked(path, workdir, cfg.no_access_dirs) { return false }
        workdir = path
        if let a = _agent { a.set_workdir(path) }
        return true
    }

    /// True when `path` is inside one of the no-access directories.
    pub func is_blocked(path str) bool {
        return path_blocked(path, workdir, cfg.no_access_dirs)
    }

    /// Show the directory the agent works in (/workdir).
    pub func show_workdir() {
        emit("[agent] work dir: " + workdir)
    }

    /// The git branch checked out under the work dir, or "" when it is not
    /// a repository (or git is unavailable). The answer is cached per work
    /// dir, so a status row redraw does not spawn a process every frame.
    pub func branch() str {
        if _branch_dir == workdir { return _branch_name }
        _branch_dir = workdir
        _branch_name = ""
        if let r = os.output("git", ["rev-parse", "--abbrev-ref", "HEAD"], workdir) {
            let (code, out, _) = r
            if code == 0 {
                let name = out.strip()
                if name != "" && name != "HEAD" { _branch_name = name }
            }
        }
        return _branch_name
    }

    /// Prompt tokens of the active conversation: the agent's in agent mode
    /// (0 before its first request), the chat's otherwise. /context and the
    /// status row both read this, so the two can never disagree.
    pub func active_tokens(is_agent bool) int {
        if is_agent {
            if let a = _agent { return a.last_tokens() }
            return 0
        }
        return _last_tokens
    }

    /// One line for the status row: model, work dir (with its git branch),
    /// and token usage of the active conversation — the agent's when
    /// `is_agent`, the chat's otherwise. With `cols > 0` the work dir is
    /// elided from the left to fit, so the useful tail survives in a narrow
    /// terminal.
    pub func status_line(cols = 0, is_agent bool = false) str {
        let used = active_tokens(is_agent)
        let window = cfg.context_window
        let tenths = used * 1000 / window
        let pct = str(tenths / 10) + "." + str(tenths % 10) + "%"
        let branch_name = branch()
        var tail = " | tokens " + str(used) + "/" + str(window) + " (" + pct + ")"
        // TodoWrite keeps its list in memory; show the progress when there is one
        let tstat = todo_status()
        if tstat != "" { tail = tail + " | " + tstat }
        // the permission mode is only worth the row when it is not the default
        if permission_mode != PERM_DEFAULT { tail = tail + " | perm " + permission_mode }
        var suffix = ""
        if branch_name != "" { suffix = " (" + branch_name + ")" }
        let full = "model=" + model + " | dir=" + workdir + suffix + tail
        if cols <= 0 { return full }
        if readline.width(full) <= cols { return full }
        let prefix = "model=" + model + " | dir="
        var room = cols - readline.width(prefix) - readline.width(tail)
        // drop the branch before squeezing the path further; keep a few
        // columns for a recognisable tail
        if room < readline.width(suffix) + 4 { suffix = "" }
        room -= readline.width(suffix)
        if room < 1 { return elide_left(full, cols, plain_mode()) }
        return prefix + elide_left(workdir, room, plain_mode()) + suffix + tail
    }

    /// The model ids the endpoint offers (GET {base_url}/models), or nil
    /// when the request fails or the response is unexpected.
    pub func list_models() list[str]? {
        let base = Url.parse(cfg.base_url)
        if base == nil { return nil }
        let url = Url(base.scheme(), base.host(), base.port(), base.path() + "/models")
        let req = Request.get(url)
        req.header("Authorization", "Bearer " + key)
        req.header("Accept", "application/json")
        let resp = Client().stream(req, 15000)
        if resp == nil { return nil }
        let buf = Buffer()
        while let chunk = resp.read() { buf.write(chunk) }
        let status = resp.status()
        resp.close()
        if status != 200 { return nil }
        let root = try_parse_str(buf.to_str())
        if root == nil { return nil }
        let v = root
        if v is Object {
            if "data" in v {
                let out = list[str]()
                for item in v.get_array("data").value {
                    if item is Object {
                        if "id" in item { out.append(item.get_str("id")) }
                    }
                }
                return out
            }
        }
        return nil
    }
}

/// Pause `ms` milliseconds between streamed reply lines, so the eye can
/// follow the line-by-line print effect; no-op for 0.
func _pace(ms int) {
    if ms > 0 { time.sleep(time.Duration.from_millis(ms)) }
}

/// Rebuild a Session from a persisted record; nil when a field is missing
/// or mistyped. The agent is restored with its own conversation when one
/// was saved; paused sessions come back paused.
pub func restore_session(client openai.Client, cfg Config, key str, obj Object) Session? {
    let name = _field_str(obj, "name")
    let model = _field_str(obj, "model")
    let workdir = _field_str(obj, "workdir")
    let paused = _field_bool(obj, "paused")
    let tokens = _field_int(obj, "last_tokens")
    // v2 writes both; a v1 record has neither, and its id is the file name.
    let id = _field_str(obj, "id")
    let msgs = _field_msgs(obj, "messages")
    let amsgs = _field_array(obj, "agent_messages")
    if name == nil || model == nil || workdir == nil || paused == nil || tokens == nil || msgs == nil || amsgs == nil {
        return nil
    }
    let s = Session(client, cfg, key, name!)
    if id != nil { s.set_id(id) }
    s.model = model!
    s.workdir = workdir!
    s.paused = paused!
    s._last_tokens = tokens!
    s.messages.clear()
    for m in msgs! { s.messages.append(m) }
    if amsgs!.value.len() > 0 {
        s._agent = restore_agent(client, cfg, workdir!, amsgs!, paused!)
        if let a = s._agent {
            a.set_approver(request_approval)
            a.set_permission_mode(s.permission_mode)
            // a turn cut short before the process ended: /continue resumes
            // it, and /cancel still knows where it began
            let state = _field_str(obj, "run_state")
            let pending = _field_obj(obj, "pending")
            if let st = state {
                if let p = pending {
                    if st == "pending" {
                        let mark = _field_int(p, "mark")
                        let reason = _field_str(p, "reason")
                        if mark != nil {
                            if reason != nil { a.restore_pending(mark, reason) }
                        }
                    }
                }
            }
        }
    }
    return s
}

/// The string field `key`, or nil when absent or not a string.
func _field_str(obj Object, key str) str? {
    if key in obj {
        let v = obj.get(key)!
        if v is String { return v.value }
    }
    return nil
}

/// The bool field `key`, or nil when absent or not a bool.
func _field_bool(obj Object, key str) bool? {
    if key in obj {
        let v = obj.get(key)!
        if v is Boolean { return v.value }
    }
    return nil
}

/// The int field `key`, or nil when absent or not an int.
func _field_int(obj Object, key str) int? {
    if key in obj {
        let v = obj.get(key)!
        if v is Integer { return v.value }
    }
    return nil
}

/// The message-list field `key`, or nil when absent, not an array, or
/// holding anything but {role, content} string pairs.
func _field_msgs(obj Object, key str) list[dict[str, str]]? {
    if key in obj {
        let v = obj.get(key)!
        if v is Array {
            let out = list[dict[str, str]]()
            for e in v.value {
                if e is Object {
                    let role = _field_str(e, "role")
                    let content = _field_str(e, "content")
                    if role == nil || content == nil { return nil }
                    let m = dict[str, str]()
                    m["role"] = role!
                    m["content"] = content!
                    out.append(m)
                } else {
                    return nil
                }
            }
            return out
        }
    }
    return nil
}

/// The JSON-array field `key`, or nil when absent or not an array. The
/// elements are validated lazily by restore_agent: an old record holds
/// {role, content} objects, a new one also holds the tool fields.
func _field_array(obj Object, key str) Array? {
    if key in obj {
        let v = obj.get(key)!
        if v is Array { return v }
    }
    return nil
}

/// The object field `key`, or nil when absent or not an object.
func _field_obj(obj Object, key str) Object? {
    if key in obj {
        let v = obj.get(key)!
        if v is Object { return v }
    }
    return nil
}

/// The JSON array form of a message list.
func _msgs(msgs list[dict[str, str]]) Array {
    let a = Array()
    for m in msgs {
        let o = Object()
        o["role"] = String(m["role"])
        o["content"] = String(m["content"])
        a.append(o)
    }
    return a
}