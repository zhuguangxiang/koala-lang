/*
 * demo/chat — the multi-session store and manager.
 *
 * One JSON file per session in chat_sessions/ (the working directory), named
 * after the session's stable id: `<id>.json`. The record holds the display
 * name, model, workdir, paused, last_tokens, the chat messages and the
 * agent's messages (present once an agent has run). SessionManager is the
 * live view: it loads every session at startup and keeps them in name order;
 * the id in the `.current` pointer becomes current (a missing or stale
 * pointer falls back to the most recently modified file). The current
 * session is saved at the top of every REPL turn, so quitting never loses a
 * reply.
 *
 * The id is the file name and never changes. /rename rewrites only the
 * record's `name`, so the history file and the `.current` pointer stay
 * valid across renames.
 *
 * A record with missing or mistyped fields, or a file that is not valid
 * JSON, is skipped at load with a warning: one bad file never stops the
 * session list. Saves go through a sibling .tmp file and a rename, so a
 * crash mid-write leaves the previous record intact; a failing disk warns
 * once per streak instead of once per turn.
 */

import "std/fs"
import "koala/datetime"
import "koala/json" as json
from "koala/json" import Object, String
from "koala/openai" import Client

const SESSION_DIR = "chat_sessions"

/// A session name must be a plain file name: not empty, no "/", and not
/// "." or "..".
pub func valid_name(name str) bool {
    if name.len() == 0 { return false }
    if name == "." || name == ".." { return false }
    if "/" in name { return false }
    return true
}

/// The on-disk store: one JSON object per session, `<dir>/<name>.json`.
pub class SessionStore {
    let dir str

    pub func __init__(dir str = SESSION_DIR) {
        self.dir = fs.Path(dir).absolute().to_str()
        if !fs.is_dir(self.dir) { fs.mkdir(self.dir) }
    }

    /// The path of the session file for `name`.
    pub func path(name str) str { return dir + "/" + name + ".json" }

    /// True when a session file for `name` exists.
    pub func exists(name str) bool { return fs.is_file(path(name)) }

    /// All session names (every *.json file), unordered.
    pub func list_names() list[str] {
        let out = list[str]()
        if !fs.is_dir(dir) { return out }
        for p in fs.list_dir(dir) {
            let n = p.name()
            if n.ends_with(".json") { out.append(n.substr(0, n.len() - 5)) }
        }
        return out
    }

    /// The record for `name` as a JSON object; nil when the file is gone,
    /// is not valid JSON, or its root is not an object.
    pub func load(name str) Object? {
        if !exists(name) { return nil }
        let root = json.try_parse_file(path(name))
        if root == nil { return nil }
        let v = root
        if v is Object { return v }
        return nil
    }

    /// The record's last write as a nanosecond timestamp, 0 when it is gone
    /// or cannot be stat'ed (/sessions shows it as "last active").
    pub func mtime(name str) int {
        if let st = fs.stat(path(name)) { return st.mtime_ns }
        return 0
    }

    /// The `.current` pointer file: the id of the session to resume when the
    /// command line does not say. It is not a `*.json` record, so it never
    /// shows up in the session list.
    pub func current_path() str { return dir + "/.current" }

    /// The id in the `.current` pointer, "" when the file is missing or is
    /// not a `{"id": "..."}` object.
    pub func read_current() str {
        let root = json.try_parse_file(current_path())
        if root == nil { return "" }
        let v = root
        if v is Object {
            // get_str would panic on a missing key or a non-string value
            if "id" in v {
                let id = v.get("id")!
                if id is String { return id.value }
            }
        }
        return ""
    }

    /// Point `.current` at `id`, atomically (tmp + rename) so a crash never
    /// leaves a half-written pointer. False when the write fails.
    pub func write_current(id str) bool {
        let file = current_path()
        let tmp = file + ".tmp"
        let obj = Object()
        obj["id"] = String(id)
        if !fs.write_str(tmp, json.dumps(obj)) { return false }
        if !fs.rename(tmp, file) {
            fs.remove(tmp)
            return false
        }
        return true
    }

    /// Write the record atomically: the text goes to a sibling `.tmp` file
    /// first, then a rename puts it in place, so a crash mid-write leaves
    /// the previous record intact. False when either step fails (the tmp
    /// file is removed so the next save starts clean).
    pub func save(name str, obj Object) bool {
        let file = path(name)
        let tmp = file + ".tmp"
        if !fs.write_str(tmp, json.dumps(obj)) { return false }
        if !fs.rename(tmp, file) {
            fs.remove(tmp)
            return false
        }
        return true
    }

    /// Rename the session file; false when the move fails. The manager no longer
    /// calls this (/rename changes only the display name and keeps the id),
    /// but it stays for one-off migrations and for the store tests.
    pub func rename(old str, new str) bool {
        return fs.rename(path(old), path(new))
    }
}

/// A fresh automatic name: the UTC timestamp ("2026-11-22-153045"), with a
/// -2, -3... suffix while the name is taken.
pub func auto_name(store SessionStore) str {
    // to_str() carries nanoseconds; keep just the seconds for a short name.
    let base = datetime.DateTime.now().to_str().substr(0, 19).replace("T", "-").replace(":", "")
    if !store.exists(base) { return base }
    var n = 2
    while store.exists(base + "-" + str(n)) { n += 1 }
    return base + "-" + str(n)
}

/// The live session list: every stored session in name order plus the
/// current index. `new` / `switch_to` / `set_paused` / `rename` move the
/// cursor and persist; `save_current` writes the current session's record.
pub class SessionManager {
    let store SessionStore
    let client Client
    let cfg Config
    let key str
    var sessions list[Session]
    var current int
    // ids (with a reason) of files that could not be loaded, for the
    // /sessions footer; a bad file never stops the list
    var _broken list[str]
    // true once a save failed without a success in between, so a failing
    // disk warns per streak, not once per turn
    var _save_warned bool

    pub func __init__(_client Client, _cfg Config, _key str, dir str = SESSION_DIR) {
        client = _client
        cfg = _cfg
        key = _key
        store = SessionStore(dir)
        sessions = list[Session]()
        current = 0
        _broken = list[str]()
        _save_warned = false
        _load_all()
    }

    /// Load every stored session; `.current` names the one to resume, and
    /// an empty or stale pointer falls back to the most recently modified
    /// file. An empty store starts a fresh "main".
    func _load_all() {
        var most = ""
        var best = -1
        for n in store.list_names() {
            let obj = store.load(n)
            if obj == nil {
                _broken.append(n + " (not a JSON object)")
                emit("(skipping session " + n + ": not a JSON object)")
                continue
            }
            let s = restore_session(client, cfg, key, obj)
            if s == nil {
                _broken.append(n + " (malformed record)")
                emit("(skipping session " + n + ": malformed record)")
                continue
            }
            // the file name is the id, even when the record disagrees (an
            // older build renamed files, a hand edit moved them)
            s.set_id(n)
            _insert(s)
            if let st = fs.stat(store.path(n)) {
                // '>=' so equal mtimes (same-tick writes) pick the last
                // listed file, not the first.
                if st.mtime_ns >= best {
                    best = st.mtime_ns
                    most = n
                }
            }
        }
        if sessions.len() == 0 {
            let s = Session(client, cfg, key, "main")
            _insert(s)
            current = 0
            // no file yet, so no pointer: the first save writes both
            return
        }
        // .current wins over recency: switching sessions must survive a
        // restart even when another session was written later.
        let want = store.read_current()
        var idx = -1
        if want != "" { idx = _index(want) }
        if idx < 0 {
            if want != "" {
                // the pointer names a file that is gone (deleted or renamed
                // by hand): say so, then repair it below
                emit("(warning: .current points at missing session " + want + ")")
            }
            idx = _index(most)
        }
        if idx < 0 { idx = 0 }
        current = idx
        _pointer()
    }

    /// Ids of session files that could not be loaded, each with the reason
    /// (`"foo (not a JSON object)"`). /sessions prints them as a footer.
    pub func broken() list[str] { return _broken }

    /// The session list size.
    pub func count() int { return sessions.len() }

    /// The current index (for the * marker in /sessions).
    pub func current_index() int { return current }

    /// The session at position `i` (for /sessions).
    pub func at(i int) Session { return sessions[i] }

    /// The session the REPL talks to.
    pub func current_session() Session { return sessions[current] }

    /// All session names in list order (for Tab completion).
    pub func names() list[str] {
        let out = list[str]()
        for s in sessions { out.append(s.name()) }
        return out
    }

    /// Create a session named `name` (auto-named when nil or "") and switch
    /// to it. False when the name is invalid or already taken. The new
    /// session's id is the file name, so /rename can later change only the
    /// display name.
    pub func new(name str?) bool {
        var n = name
        if n == nil || n! == "" { n = auto_name(store) }
        if !valid_name(n!) { return false }
        if _index(n!) >= 0 { return false }
        let s = Session(client, cfg, key, n!)
        _insert(s)
        current = _index(n!)
        save_current()
        _pointer()
        return true
    }

    /// Switch to the session named `target` — a name, an id or a 1-based
    /// /sessions number. False when there is no such session.
    pub func switch_to(target str) bool {
        let i = _resolve(target)
        if i < 0 { return false }
        current = i
        _pointer()
        return true
    }

    /// Pause (`on` true) or resume (`on` false) the session named `target`
    /// — a name, a 1-based number, or nil for the current one. Returns the
    /// affected session's name, or nil when there is no such session.
    pub func set_paused(target str?, on bool) str? {
        var i = current
        if target != nil && target! != "" { i = _resolve(target!) }
        if i < 0 || i >= sessions.len() { return nil }
        if on {
            sessions[i].pause()
        } else {
            sessions[i].resume()
        }
        let n = sessions[i].name()
        if i == current {
            save_current()
        } else {
            _save(sessions[i])
        }
        return n
    }

    /// Rename the current session's display name. The storage id — and with it
    /// the file name — never changes, so the history and the `.current`
    /// pointer stay valid. False when the name is invalid, taken, or the save
    /// fails (the old name is put back then).
    pub func rename(new_name str) bool {
        let s = current_session()
        if !valid_name(new_name) { return false }
        // the id and the display name share one selection space; renaming
        // back to the session's own id is fine, another session's is not
        let other = _index(new_name)
        if other >= 0 && other != current { return false }
        let old = s.name()
        s.set_name(new_name)
        if !store.save(s.id(), s.to_record()) {
            s.set_name(old)
            return false
        }
        sessions.pop(current)
        _insert(s)
        current = _index(new_name)
        _pointer()
        return true
    }

    /// Write the current session's record to disk.
    pub func save_current() {
        _save(current_session())
    }

    /// Persist one session; a failure warns once per failing streak because
    /// the REPL saves on every turn and a dead disk must not flood the screen.
    func _save(s Session) {
        if store.save(s.id(), s.to_record()) {
            _save_warned = false
            return
        }
        if !_save_warned {
            _save_warned = true
            emit("(warning: could not save session '" + s.name() + "' under " + store.dir + ")")
        }
    }

    /// Refresh `.current` after the cursor moves, so the next start resumes
    /// this session even when another file was written later.
    func _pointer() {
        store.write_current(current_session().id())
    }

    /// The list position of `key` — an id or a display name, or -1.
    func _index(key str) int {
        var i = 0
        while i < sessions.len() {
            if sessions[i].id() == key || sessions[i].name() == key { return i }
            i += 1
        }
        return -1
    }

    /// The list position for a /sessions number or a name, or -1.
    func _resolve(target str) int {
        let n = target.to_int_or(0)
        if n >= 1 && n <= sessions.len() { return n - 1 }
        return _index(target)
    }

    /// Insert keeping the list in name order.
    func _insert(s Session) {
        var i = 0
        while i < sessions.len() {
            if s.name() < sessions[i].name() { break }
            i += 1
        }
        sessions.insert(i, s)
    }
}
