/*
 * demo/chat — the tools the agent offers to the model.
 *
 * These are native OpenAI tool declarations (`tools` in the request), not
 * fenced text blocks. Each call carries an id and a JSON argument object;
 * `tool_action` turns one call into the (info, body) pair the rest of the
 * harness already understands, so the approval prompt, the path guard and
 * the executor are shared with the fenced fallback. For Read, Edit, Glob,
 * Grep and TodoWrite the body is the raw argument JSON: the optional fields
 * (offset/limit, replace_all, include) are read where the tool runs.
 *
 * Names are matched case-insensitively, so a model that writes `read` or
 * `bash` is understood as well as Claude Code's `Read` / `Bash`.
 *
 * Every implementation returns the observation for the model: `ok` on
 * success, `ERROR: ...` on failure. Nothing here panics — the arguments
 * come from a model.
 */

import "std/fs"
import "std/os"
import "koala/openai" as openai
import "koala/re"
from "koala/json" import Object, Array, String, Integer, Boolean, try_parse_str

/// Read and Edit refuse a file larger than this instead of loading it.
const MAX_FILE_BYTES = 2_000_000
/// Glob lists at most this many paths.
const GLOB_MAX_RESULTS = 200
/// Grep stops after this many matching lines.
const GREP_MAX_MATCHES = 200
/// Grep reads at most this many files.
const GREP_MAX_FILES = 5_000

/// The in-memory TodoWrite list; persistence is a later milestone.
var _todos list[dict[str, str]] = list[dict[str, str]]()

/// The tools declared in every native request.
pub func agent_tools() list[openai.ToolDef] {
    return [
        openai.ToolDef.of("Read", "Read a file with line numbers. Optional offset (1-based first line) and limit (max lines, default 2000).", _read_schema()),
        openai.ToolDef.of("Write", "Create or overwrite one file with the full content given. Relative paths are resolved against the work directory.", _write_schema()),
        openai.ToolDef.of("Edit", "Replace an exact string in one file. old_string must match once unless replace_all is true.", _edit_schema()),
        openai.ToolDef.of("Bash", "Run one shell command in the work directory and return its exit code, stdout and stderr.", _bash_schema()),
        openai.ToolDef.of("Glob", "List files matching a glob pattern, newest tool for finding paths. Optional path (base directory, default the work directory).", _glob_schema()),
        openai.ToolDef.of("Grep", "Search file contents with a regular expression and return path:line:text. Optional path, include (glob filter) and ignore_case.", _grep_schema()),
        openai.ToolDef.of("TodoWrite", "Replace the task list. Each item is {content, status} with status pending, in_progress or completed.", _todo_schema()),
    ]
}

/// The declared tool names, for error messages.
pub func tool_names() str {
    return "Read, Write, Edit, Bash, Glob, Grep, TodoWrite"
}

/// The (info, body) view of one native call: `("write PATH", content)` or
/// `("shell", command)`. Nil when the name is unknown or the arguments do
/// not hold what that tool needs (the model may have written broken JSON).
pub func tool_action(name str, call openai.ToolCall) (str, str)? {
    let args = call.args()
    if args == nil { return nil }
    let a = args
    let n = name.lower()
    if n == "read" {
        if !("path" in a) { return nil }
        let path = _field(a, "path")
        if path.strip() == "" { return nil }
        return ("read " + path.strip(), call.arguments())
    }
    if n == "write" {
        if !("path" in a) || !("content" in a) { return nil }
        let path = _field(a, "path")
        if path.strip() == "" { return nil }
        return ("write " + path.strip(), _field(a, "content"))
    }
    if n == "edit" {
        if !("path" in a) { return nil }
        if !("old_string" in a) || !("new_string" in a) { return nil }
        let path = _field(a, "path")
        if path.strip() == "" { return nil }
        return ("edit " + path.strip(), call.arguments())
    }
    if n == "bash" || n == "shell" || n == "sh" {
        if !("command" in a) { return nil }
        let cmd = _field(a, "command")
        if cmd.strip() == "" { return nil }
        return ("shell", cmd)
    }
    if n == "glob" {
        if !("pattern" in a) { return nil }
        let pattern = _field(a, "pattern")
        if pattern.strip() == "" { return nil }
        return ("glob " + pattern.strip(), call.arguments())
    }
    if n == "grep" {
        if !("pattern" in a) { return nil }
        let pattern = _field(a, "pattern")
        if pattern == "" { return nil }
        return ("grep " + pattern, call.arguments())
    }
    if n == "todowrite" || n == "todo" {
        if !("todos" in a) { return nil }
        return ("todo", call.arguments())
    }
    return nil
}

/// The transcript preview of an Edit before it runs: the old and new text,
/// at most four lines each, with `- ` / `+ ` prefixes. Empty when the
/// arguments are not usable.
pub func edit_preview(args_json str) list[str] {
    let out = list[str]()
    let a = _args(args_json) else { return out }
    _append_preview(out, _arg_str(a, "old_string"), "- ")
    _append_preview(out, _arg_str(a, "new_string"), "+ ")
    return out
}

/// Append at most four lines of `text`, each with `prefix`.
func _append_preview(out list[str], text str, prefix str) {
    if text == "" { return }
    let lines = text.split("\n")
    var i = 0
    while i < lines.len() && i < 4 {
        out.append("    " + prefix + lines[i])
        i += 1
    }
    if lines.len() > 4 { out.append("    " + prefix + "... " + str(lines.len() - 4) + " more lines") }
}

// ---- argument helpers ----

/// The arguments of a tool call as an object, or nil when the JSON is broken
/// or its root is not an object.
func _args(body str) Object? {
    let v = try_parse_str(body)
    if v == nil { return nil }
    if !(v is Object) { return nil }
    return v as Object
}

/// The string argument `key` of `obj`, or "" when absent or not a string.
func _arg_str(obj Object, key str) str {
    if !(key in obj) { return "" }
    return _field(obj, key)
}

/// The integer argument `key` of `obj`, or `def` when absent or not an
/// integer.
func _arg_int(obj Object, key str, def int) int {
    if !(key in obj) { return def }
    let v = obj[key]
    if v is Integer { return v.value }
    return def
}

/// `path` resolved against `workdir` (an absolute path names its own
/// target) and normalized, so the guard and the tool see one location.
pub func resolve_tool_path(path str, workdir str) str {
    var target = path
    if !fs.Path(path).is_absolute() { target = workdir + "/" + path }
    return fs.Path(target).normalize().to_str()
}

/// `full` shown relative to `workdir` when it is below it.
func _display_path(full str, workdir str) str {
    let prefix = workdir + "/"
    if full.starts_with(prefix) { return full.substr(prefix.len()) }
    return full
}

/// True when the bytes hold a NUL, the cheap test for a binary file.
func _looks_binary(b bytes) bool {
    return b.count(uint8(0)) > 0
}

// ---- Read ----

/// Read `path` with line numbers: `offset` (1-based, default 1) and `limit`
/// (default 2000, at most 2000) come from `args_json`. The output stops at
/// `max_bytes`, saying so; a directory, a missing file, a binary file and a
/// no-access path are errors.
pub func read_tool(path str, args_json str, workdir str, blocked list[str], max_bytes int) str {
    var cap = max_bytes
    if cap <= 0 { cap = 1_000_000 }
    let full = resolve_tool_path(path, workdir)
    if path_blocked(full, workdir, blocked) {
        return "ERROR: read: " + path + " is in a no-access directory"
    }
    if fs.is_dir(full) { return "ERROR: read: " + path + " is a directory" }
    if !fs.is_file(full) { return "ERROR: read: " + path + ": no such file" }
    var offset = 1
    var limit = 2000
    if let a = _args(args_json) {
        offset = _arg_int(a, "offset", 1)
        limit = _arg_int(a, "limit", 2000)
    }
    if offset < 1 { offset = 1 }
    if limit < 1 { limit = 1 }
    if limit > 2000 { limit = 2000 }
    let st = fs.stat(full) else { return "ERROR: read: " + path + ": cannot stat" }
    if st.size > MAX_FILE_BYTES {
        return "ERROR: read: " + path + " is " + str(st.size) + " bytes, larger than " + str(MAX_FILE_BYTES) + "; use Grep or Bash to inspect it"
    }
    let raw = fs.read_all(full, MAX_FILE_BYTES)
    if _looks_binary(raw) { return "ERROR: read: " + path + " looks like a binary file" }
    let lines = raw.to_str().split("\n")
    var total = lines.len()
    // a trailing newline leaves one empty element: it is not a line
    if total > 0 && lines[total - 1] == "" { total -= 1 }
    if total == 0 { return "read ok: " + path + " (empty file)" }
    if offset > total {
        return "read ok: " + path + " (no lines from " + str(offset) + "; the file has " + str(total) + ")"
    }
    var last = offset + limit - 1
    if last > total { last = total }
    var text = "read ok: " + path + " (lines " + str(offset) + "-" + str(last) + " of " + str(total) + ")"
    var used = text.len()
    var truncated = false
    var i = offset - 1
    while i < last {
        let row = "  " + str(i + 1).rjust(6) + "\t" + lines[i]
        if used + row.len() + 1 > cap { truncated = true; break }
        text += "\n" + row
        used += row.len() + 1
        i += 1
    }
    if truncated { text += "\n  ... output truncated at " + str(cap) + " bytes; use offset/limit" }
    return text
}

// ---- Edit ----

/// Replace `old_string` with `new_string` in `path`. One match is replaced
/// unless the `replace_all` argument is true; zero or several matches are
/// errors the model can fix. The file must already exist and stay under the
/// no-access guard.
pub func edit_tool(path str, args_json str, workdir str, blocked list[str]) str {
    let a = _args(args_json) else { return "ERROR: edit: arguments are not a JSON object" }
    if !("old_string" in a) || !("new_string" in a) {
        return "ERROR: edit: old_string and new_string are required"
    }
    let old_string = _arg_str(a, "old_string")
    let new_string = _arg_str(a, "new_string")
    if old_string == "" { return "ERROR: edit: old_string is empty" }
    let full = resolve_tool_path(path, workdir)
    if path_blocked(full, workdir, blocked) {
        return "ERROR: edit: " + path + " is in a no-access directory"
    }
    if !fs.is_file(full) { return "ERROR: edit: " + path + ": no such file" }
    let st = fs.stat(full) else { return "ERROR: edit: " + path + ": cannot stat" }
    if st.size > MAX_FILE_BYTES {
        return "ERROR: edit: " + path + " is too large to edit safely"
    }
    let text = fs.read_str(full, MAX_FILE_BYTES)
    let n = text.count(old_string)
    if n == 0 { return "ERROR: edit: old_string not found in " + path }
    var replace_all = false
    if "replace_all" in a {
        let v = a["replace_all"]
        if v is Boolean { replace_all = v.value }
    }
    if n > 1 && !replace_all {
        return "ERROR: edit: old_string appears " + str(n) + " times in " + path + "; pass replace_all=true or include more context"
    }
    var updated = text
    if replace_all {
        updated = text.replace(old_string, new_string)
    } else {
        let at = text.index(old_string)
        updated = text.substr(0, at) + new_string + text.substr(at + old_string.len())
    }
    if !fs.write_str(full, updated) { return "ERROR: edit: cannot write " + path }
    var unit = " replacements"
    if n == 1 { unit = " replacement" }
    return "edit ok: " + path + " (" + str(n) + unit + ")"
}
// ---- Glob ----

/// List files matching `pattern` (relative, `**` supported) under the
/// optional `path` argument (default `workdir`). Results outside the
/// no-access rule are skipped and the count is reported; only the first
/// `GLOB_MAX_RESULTS` paths are printed.
pub func glob_tool(pattern str, args_json str, workdir str, blocked list[str]) str {
    if fs.Path(pattern).is_absolute() { return "ERROR: glob: pattern must be relative: " + pattern }
    var base = workdir
    if let a = _args(args_json) {
        let rel = _arg_str(a, "path").strip()
        if rel != "" { base = resolve_tool_path(rel, workdir) }
    }
    if path_blocked(base, workdir, blocked) {
        return "ERROR: glob: " + _display_path(base, workdir) + " is in a no-access directory"
    }
    if !fs.is_dir(base) { return "ERROR: glob: " + _display_path(base, workdir) + ": no such directory" }
    let found = fs.glob(base + "/" + pattern)
    let out = list[str]()
    var skipped = 0
    for p in found {
        let s = p.to_str()
        if path_blocked(s, workdir, blocked) {
            skipped += 1
            continue
        }
        if fs.is_dir(s) { continue }
        out.append(_display_path(s, workdir))
    }
    if out.len() == 0 { return "glob ok: " + pattern + " (no files)" }
    var text = "glob ok: " + pattern + " (" + str(out.len()) + " files"
    if skipped > 0 { text += ", " + str(skipped) + " skipped by the no-access rule" }
    text += ")"
    var i = 0
    while i < out.len() && i < GLOB_MAX_RESULTS {
        text += "\n  " + out[i]
        i += 1
    }
    if out.len() > GLOB_MAX_RESULTS {
        text += "\n  ... " + str(out.len() - GLOB_MAX_RESULTS) + " more"
    }
    return text
}

// ---- Grep ----

/// Search a file or a tree for `pattern`, printing `path:line:text`. The
/// optional arguments are `path` (base, default `workdir`), `include` (a
/// glob the path must match, e.g. `*.kl`) and `ignore_case`. Blocked paths
/// are skipped, binary and huge files are not read, and at most
/// `GREP_MAX_MATCHES` lines come back.
pub func grep_tool(pattern str, args_json str, workdir str, blocked list[str]) str {
    if !_regex_ok(pattern) { return "ERROR: grep: invalid regular expression: " + pattern }
    var base = workdir
    var include = ""
    var flags = 0
    if let a = _args(args_json) {
        let rel = _arg_str(a, "path").strip()
        if rel != "" { base = resolve_tool_path(rel, workdir) }
        include = _arg_str(a, "include").strip()
        if "ignore_case" in a {
            let v = a["ignore_case"]
            if v is Boolean {
                if v.value { flags = flags | re.IGNORECASE }
            }
        }
    }
    if path_blocked(base, workdir, blocked) {
        return "ERROR: grep: " + _display_path(base, workdir) + " is in a no-access directory"
    }
    let pat = re.compile(pattern, flags)
    let matches = list[str]()
    var files = 0
    if fs.is_file(base) {
        files = 1
        _grep_file(base, pat, workdir, matches)
    } else if fs.is_dir(base) {
        for (_, _, names) in fs.walk(base) {
            if matches.len() >= GREP_MAX_MATCHES { break }
            if files >= GREP_MAX_FILES { break }
            for p in names {
                if matches.len() >= GREP_MAX_MATCHES { break }
                if files >= GREP_MAX_FILES { break }
                let s = p.to_str()
                if path_blocked(s, workdir, blocked) { continue }
                if !fs.is_file(s) { continue }
                if include != "" {
                    if !fs.Path(s).match(include) { continue }
                }
                files += 1
                _grep_file(s, pat, workdir, matches)
            }
        }
    } else {
        return "ERROR: grep: " + _display_path(base, workdir) + ": no such file or directory"
    }
    if matches.len() == 0 { return "grep ok: " + pattern + " (no matches in " + str(files) + " files)" }
    var text = "grep ok: " + pattern + " (" + str(matches.len()) + " matches in " + str(files) + " files)"
    for m in matches { text += "\n  " + m }
    if matches.len() >= GREP_MAX_MATCHES {
        text += "\n  ... stopped at " + str(GREP_MAX_MATCHES) + " matches"
    }
    return text
}

/// Append the matching lines of `path`, shown relative to `workdir`.
func _grep_file(path str, pat re.Pattern, workdir str, matches list[str]) {
    let st = fs.stat(path) else { return }
    if st.size > MAX_FILE_BYTES { return }
    let raw = fs.read_all(path, MAX_FILE_BYTES)
    if _looks_binary(raw) { return }
    let shown = _display_path(path, workdir)
    let lines = raw.to_str().split("\n")
    var i = 0
    while i < lines.len() {
        if matches.len() >= GREP_MAX_MATCHES { return }
        var line = lines[i]
        if line.ends_with("\r") { line = line.substr(0, line.len() - 1) }
        if pat.search(line) != nil {
            var text = line
            if text.len() > 400 { text = text.substr(0, 400) + "..." }
            matches.append(shown + ":" + str(i + 1) + ": " + text)
        }
        i += 1
    }
}

/// True when `pattern` compiles as an extended regular expression. The check
/// runs the system `grep`, which reports a bad pattern with exit 2, because
/// `re.compile` panics and this pattern comes from a model. Without `grep`
/// the pattern is trusted (best effort).
func _regex_ok(pattern str) bool {
    if pattern == "" { return false }
    if os.which("grep") == nil { return true }
    let r = os.output("grep", ["-qE", "--", pattern, "/dev/null"])
    if r == nil { return true }
    let (code, _, _) = r
    return code != 2
}

/// The string field `key` of `obj`, or "" when it is absent or not a
/// string (never panics).
func _field(obj Object, key str) str {
    if !(key in obj) { return "" }
    let v = obj[key]
    if v is String { return v.value }
    return ""
}

// ---- TodoWrite ----

/// Replace the in-memory task list with the `todos` array of `args_json`;
/// each item is a string or {content, status}. Returns the list for the
/// model.
pub func todo_tool(args_json str) str {
    let a = _args(args_json) else { return "ERROR: todo: arguments are not a JSON object" }
    if !("todos" in a) { return "ERROR: todo: missing 'todos'" }
    let v = a["todos"]
    if !(v is Array) { return "ERROR: todo: 'todos' must be an array" }
    let items = list[dict[str, str]]()
    for e in v.value {
        var content = ""
        var status = "pending"
        if e is String { content = e.value }
        if e is Object {
            content = _arg_str(e, "content")
            let s = _arg_str(e, "status")
            if s == "pending" || s == "in_progress" || s == "completed" { status = s }
        }
        if content.strip() == "" { continue }
        let d = dict[str, str]()
        d["content"] = content.strip()
        d["status"] = status
        items.append(d)
    }
    _todos = items
    var done = 0
    var active = 0
    for t in items {
        if t["status"] == "completed" { done += 1 }
        if t["status"] == "in_progress" { active += 1 }
    }
    var text = "todo ok: " + str(items.len()) + " items (" + str(done) + " done, " + str(active) + " in progress)"
    for t in items {
        var mark = "[ ]"
        if t["status"] == "completed" { mark = "[x]" }
        if t["status"] == "in_progress" { mark = "[>]" }
        text += "\n  " + mark + " " + t["content"]
    }
    return text
}

/// The current todo list (the last TodoWrite wins).
pub func todos() list[dict[str, str]] {
    return _todos
}

/// A short "done/total" summary for the status row, or "" when the list is
/// empty.
pub func todo_status() str {
    if _todos.len() == 0 { return "" }
    var done = 0
    for t in _todos {
        if t["status"] == "completed" { done += 1 }
    }
    return "todo " + str(done) + "/" + str(_todos.len())
}

/// One JSON Schema property.
func _prop(type_ str, desc str) Object {
    let p = Object()
    p["type"] = String(type_)
    p["description"] = String(desc)
    return p
}

/// A JSON Schema object with `props`, requiring the names in `required`.
func _schema(props Object, required list[str]) Object {
    let req = Array()
    for name in required { req.append(String(name)) }
    let s = Object()
    s["type"] = String("object")
    s["properties"] = props
    s["required"] = req
    return s
}

/// JSON Schema of Read: required `path`, optional `offset` and `limit`.
func _read_schema() Object {
    let props = Object()
    props["path"] = _prop("string", "File to read; relative paths resolve against the work directory.")
    props["offset"] = _prop("integer", "1-based line to start at (default 1).")
    props["limit"] = _prop("integer", "Maximum number of lines (default 2000, at most 2000).")
    return _schema(props, ["path"])
}

/// JSON Schema of Write: `path` and `content`, both required.
func _write_schema() Object {
    let props = Object()
    props["path"] = _prop("string", "File path; relative paths resolve against the work directory.")
    props["content"] = _prop("string", "The complete file content.")
    return _schema(props, ["path", "content"])
}

/// JSON Schema of Edit: `path`, `old_string`, `new_string` and optional
/// `replace_all`.
func _edit_schema() Object {
    let props = Object()
    props["path"] = _prop("string", "File to change; relative paths resolve against the work directory.")
    props["old_string"] = _prop("string", "Exact text to replace (must match once unless replace_all is true).")
    props["new_string"] = _prop("string", "Replacement text; may be empty to delete.")
    props["replace_all"] = _prop("boolean", "Replace every occurrence (default false).")
    return _schema(props, ["path", "old_string", "new_string"])
}

/// JSON Schema of Bash: one required `command`.
func _bash_schema() Object {
    let props = Object()
    props["command"] = _prop("string", "The shell command to run.")
    return _schema(props, ["command"])
}

/// JSON Schema of Glob: required `pattern`, optional `path`.
func _glob_schema() Object {
    let props = Object()
    props["pattern"] = _prop("string", "Glob pattern relative to the base, e.g. src/**/*.kl.")
    props["path"] = _prop("string", "Base directory (default the work directory).")
    return _schema(props, ["pattern"])
}

/// JSON Schema of Grep: required `pattern`, optional `path`, `include` and
/// `ignore_case`.
func _grep_schema() Object {
    let props = Object()
    props["pattern"] = _prop("string", "Regular expression to search for.")
    props["path"] = _prop("string", "File or directory to search (default the work directory).")
    props["include"] = _prop("string", "Only search paths matching this glob, e.g. *.kl.")
    props["ignore_case"] = _prop("boolean", "Case-insensitive match (default false).")
    return _schema(props, ["pattern"])
}

/// JSON Schema of TodoWrite: required `todos`.
func _todo_schema() Object {
    let props = Object()
    props["todos"] = _prop("array", "The full task list; each item is {content, status}.")
    return _schema(props, ["todos"])
}