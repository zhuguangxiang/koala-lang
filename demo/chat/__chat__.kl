/// demo/chat — a command-line chat REPL on koala/openai (OpenAI-compatible).
///
/// Usage:
///   source env.sh at the repository root, then
///       cd demo && wombat build chat && wombat run chat
///
/// Configuration:
///   All settings come from config.json in the working directory (or the
///   file named by $CHAT_CONFIG); there are no built-in defaults, so the
///   file and every field are required. A template lives at
///   demo/chat/config.json. The API key is NOT in config: it comes from
///   $OPENAI_COMPAT_API_KEY, or is entered at startup when unset.
///
/// Commands: /quit /exit Ctrl-D leave, /reset clears the conversation,
///   @FILE loads a file, /model shows the current model, /model NAME
///   switches it, /models lists the models the endpoint offers.
///
/// Layout:
///   config.kl   — Config (from config.json) and resolve_key
///   session.kl  — Session: conversation, model selection, model listing
///   repl.kl     — the input loop, commands, and terminal I/O

import "koala/openai" as openai

func main() {
    let cfg = Config()
    let key = resolve_key()
    run_repl(Session(openai.Client(key, cfg.base_url), cfg, key), cfg)
}