    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.run("do it", "auto")
    _stop(p)

    // one request only; the failed turn leaves the conversation as it
    // was (the task is rolled back, the error is reported to the screen)
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 1)
    ut.assert_eq(a.conversation().len(), 1)
    ut.assert_false(a.has_tool_output())
}

// ---- streaming: a tool call assembled from fragments runs like any other ----

@test
func test_streamed_tool_call_arguments_are_assembled() {
    let dir = _setup()
    let replies = list[Object]()
    let first = list[Object]()
    // the mock streams this call's arguments in two fragments, as a real
    // endpoint does: the loop must join them by `index`
    first.append(_call("s1", "Write", _write_args("streamed.txt", "from fragments\n")))
    replies.append(_reply_tools(first))
    replies.append(_reply("done"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    a.run("write it", "auto")
    _stop(p)

    ut.assert_true(fs.is_file(dir + "/work/streamed.txt"))
    ut.assert_eq(fs.read_str(dir + "/work/streamed.txt"), "from fragments\n")
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 2)
    if reqs.len() < 2 { return }
    // the second request carries the assembled call and its tool result
    ut.assert_eq(_call_count(reqs[1], 2), 1)
    ut.assert_eq(_call_name(reqs[1], 2, 0), "Write")
    ut.assert_true(_field(reqs[1], 3, "content").starts_with("write ok"))
    ut.assert_false(a.was_interrupted())
}

// ---- interrupt: a Ctrl-C stops the run at its next checkpoint ----

// The interrupt probe: the `n`-th check reports an interrupt, so a test
// stops a run at a chosen point. Lambdas cannot capture locals, hence the
// globals.
var g_probe_calls = 0
var g_probe_at = 0

func _probe() bool {
    g_probe_calls += 1
    return g_probe_calls >= g_probe_at
}

/// Make `a` report an interrupt on its `n`-th checkpoint.
func _interrupt_on(a chat.Agent, n int) {
    g_probe_calls = 0
    g_probe_at = n
    a.set_interrupt_probe(_probe)
}

@test
func test_interrupt_before_request_sends_nothing() {
    let dir = _setup()
    let replies = list[Object]()
    replies.append(_reply("must not be requested"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    _interrupt_on(a, 1)
    a.run("do it", "auto")
    _stop(p)

    ut.assert_eq(_requests(dir).len(), 0)
    ut.assert_true(a.was_interrupted())
    // the interrupted turn is a saved pending state, with its start mark
    ut.assert_true(a.pending_reason() == "interrupted")
    ut.assert_eq(a.pending_mark(), 1)
    // the task stays in the conversation, ready for /continue
    ut.assert_eq(a.conversation().len(), 2)
    // /cancel drops it again, and a second /cancel finds nothing to do
    ut.assert_true(a.cancel())
    ut.assert_eq(a.conversation().len(), 1)
    ut.assert_false(a.cancel())
    ut.assert_false(a.was_interrupted())
    ut.assert_true(a.pending_reason() == "")
}

@test
func test_interrupt_mid_stream_keeps_partial_text() {
    let dir = _setup()
    let replies = list[Object]()
    replies.append(_reply_stream(["one ", "two ", "three"]))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    // check 1 is the step guard; checks 2 and 3 come before the first two
    // chunks, so the fourth stops the stream after chunk two
    _interrupt_on(a, 4)
    a.run("talk", "auto")
    _stop(p)

    ut.assert_eq(_requests(dir).len(), 1)
    ut.assert_true(a.was_interrupted())
    let msgs = a.conversation()
    ut.assert_eq(msgs.len(), 3)
    ut.assert_eq(msgs[2]["role"], "assistant")
    ut.assert_true(msgs[2]["content"].starts_with("one two"))
    ut.assert_true("interrupted by the user" in msgs[2]["content"])
}

@test
func test_interrupt_pairs_declared_calls() {
    let dir = _setup()
    let replies = list[Object]()
    let first = list[Object]()
    first.append(_call("c9", "Write", _write_args("never.txt", "no\n")))
    replies.append(_reply_tools(first))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    // the call arrives in four chunk checks (three fragments and the final
    // chunk), so check six is the one before the call would run
    _interrupt_on(a, 6)
    a.run("write it", "auto")
    _stop(p)

    // the call never ran, and the protocol still pairs it with a result
    ut.assert_false(fs.is_file(dir + "/work/never.txt"))
    ut.assert_eq(_requests(dir).len(), 1)
    let msgs = a.conversation()
    ut.assert_eq(msgs.len(), 4)
    ut.assert_eq(msgs[2]["role"], "assistant")
    ut.assert_eq(msgs[3]["role"], "user")
    ut.assert_true(msgs[3]["content"].starts_with("[tool result] interrupted by the user"))
    ut.assert_true(a.was_interrupted())
}
