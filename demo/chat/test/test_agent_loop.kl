// Multi-step agent-loop tests, driven by a mock OpenAI endpoint.
//
// `test/support/mock_openai.kl` runs as a child process (Koala has no
// threads, so client and server cannot share one), answers from a
// scripted list of replies, and logs every request body. The tests
// here assert both the observable effect (files on disk, tool results)
// and the exact message sequence the loop sent.

import "std/ut"
import "std/fs"
import "std/os"
import "std/time"
import "demo/chat"
import "koala/openai" as openai
from "koala/json" import parse_str, Object, Array, String, Integer, Boolean

const LBASE = "/tmp/koala_chat_looptest"

// The mock, relative to the workspace parent, which is the working
// directory `wombat test` gives every test process.
const MOCK = "demo/chat/test/support/mock_openai.kl"

// ---- fixture ----

/// A fresh tree: `work/` for the agent, plus the script, port and log
/// files the mock uses.
func _setup() str {
    fs.remove_all(LBASE)
    fs.mkdir(LBASE)
    fs.mkdir(LBASE + "/work")
    return LBASE
}

/// One scripted assistant reply.
func _reply(content str) Object {
    let r = Object()
    r.add("content", String(content))
    return r
}

/// A scripted reply streamed as SSE chunks, last one carrying `stop`.
func _reply_stream(chunks list[str]) Object {
    let arr = Array()
    for c in chunks { arr.add(String(c)) }
    let r = Object()
    r.add("stream", Boolean(true))
    r.add("chunks", arr)
    return r
}

/// A scripted reply with an explicit `finish_reason`, e.g. "length".
func _reply_finish(content str, reason str) Object {
    let r = _reply(content)
    r.add("finish_reason", String(reason))
    return r
}

/// A scripted error reply.
func _reply_error(status int, message str) Object {
    let r = Object()
    r.add("status", Integer(status))
    r.add("error", String(message))
    return r
}

/// Write the script file the mock reads: `{"responses": [...]}`.
func _write_script(path str, replies list[Object]) {
    let arr = Array()
    for r in replies { arr.add(r) }
    let root = Object()
    root.add("responses", arr)
    fs.write_str(path, root.to_json())
}

/// Start the mock endpoint as a child process.
func _start_mock(dir str) os.Process? {
    let args = list[str]()
    args.append(MOCK)
    args.append("--script")
    args.append(dir + "/script.json")
    args.append("--port-file")
    args.append(dir + "/port")
    args.append("--requests")
    args.append(dir + "/requests.jsonl")
    if let k = os.which("koala") {
        return os.run(k, args)
    }
    return nil
}

/// Wait for the mock to write its port; 0 when it never does.
func _wait_port(dir str) int {
    let file = dir + "/port"
    var i = 0
    while i < 100 {
        if fs.is_file(file) {
            let text = fs.read_str(file)
            if text != "" { return text.to_int() }
        }
        time.sleep(time.Duration.from_millis(50))
        i += 1
    }
    return 0
}

/// Stop the mock. Killing an already-exited child is harmless.
func _stop(p os.Process) {
    p.kill()
    p.wait(5.0)
}

/// The approver every test uses: approve all.
func _approve_all(info str, body str, workdir str) str {
    return "y"
}

/// A chat.Config pointed at the mock, built through $CHAT_CONFIG.
func _cfg(file str, port int, steps int, window = 8192) chat.Config {
    let json = "{\"model\": \"auto\", \"base_url\": \"http://127.0.0.1:" + str(port) + "/v1\", " +
               "\"history_file\": \"" + LBASE + "/history\", \"max_code_bytes\": 65536, " +
               "\"temperature\": 0.0, \"max_tokens\": 100, \"context_window\": " + str(window) + ", " +
               "\"stream_delay_ms\": 0, \"agent_max_steps\": " + str(steps) + ", " +
               "\"system_prompt\": \"test\"}"
    fs.write_str(file, json)
    os.setenv("CHAT_CONFIG", file)
    let cfg = chat.Config()
    os.unsetenv("CHAT_CONFIG")
    return cfg
}

/// The request bodies the mock saw, one JSON object per line.
func _requests(dir str) list[Object] {
    let out = list[Object]()
    let path = dir + "/requests.jsonl"
    if !fs.is_file(path) { return out }
    let text = fs.read_str(path, -1)
    for line in text.split("\n") {
        if line == "" { continue }
        let v = parse_str(line)
        let obj = v as Object
        if obj != nil { out.append(obj) }
    }
    return out
}

/// The `messages` array of one logged request.
func _messages(req Object) Array {
    return req.get_array("messages")
}

/// `role:content` of message `i`, for compact assertions.
func _msg(req Object, i int) str {
    let msgs = _messages(req)
    if i >= msgs.len() { return "<missing>" }
    let m = msgs.get_object(i)
    return m.get_str("role") + ":" + m.get_str("content")
}

// ---- native tool calls: Write -> Bash -> answer ----

/// One scripted tool call: `{ "id": ..., "name": ..., "arguments": {...} }`.
func _call(id str, name str, args Object) Object {
    let c = Object()
    c.add("id", String(id))
    c.add("name", String(name))
    c.add("arguments", args)
    return c
}

/// A scripted assistant reply that asks for `calls`.
func _reply_tools(calls list[Object], content = "") Object {
    let arr = Array()
    for c in calls { arr.add(c) }
    let r = Object()
    r.add("content", String(content))
    r.add("tool_calls", arr)
    return r
}

/// Write's arguments.
func _write_args(path str, content str) Object {
    let a = Object()
    a.add("path", String(path))
    a.add("content", String(content))
    return a
}

/// Bash's arguments.
func _bash_args(command str) Object {
    let a = Object()
    a.add("command", String(command))
    return a
}

/// The string field `key` of request `r`'s message `i`; "<missing>" when
/// there is no such message or field.
func _field(req Object, i int, key str) str {
    let msgs = _messages(req)
    if i >= msgs.len() { return "<missing>" }
    let m = msgs.get_object(i)
    if !(key in m) { return "<absent>" }
    return m.get_str(key)
}

/// How many tool calls message `i` of request `r` carries.
func _call_count(req Object, i int) int {
    let msgs = _messages(req)
    if i >= msgs.len() { return -1 }
    let m = msgs.get_object(i)
    if !("tool_calls" in m) { return 0 }
    return m.get_array("tool_calls").len()
}

/// The id of tool call `k` in message `i` of request `r`.
func _call_id(req Object, i int, k int) str {
    let m = _messages(req).get_object(i)
    let t = m.get_array("tool_calls").get_object(k)
    return t.get_str("id")
}

/// The name of tool call `k` in message `i` of request `r`.
func _call_name(req Object, i int, k int) str {
    let m = _messages(req).get_object(i)
    let t = m.get_array("tool_calls").get_object(k)
    return t.get_object("function").get_str("name")
}

@test
func test_native_write_bash_answer() {
    let dir = _setup()
    let replies = list[Object]()
    let first = list[Object]()
    first.append(_call("c1", "Write", _write_args("hello.txt", "hello from mock")))
    replies.append(_reply_tools(first))
    let second = list[Object]()
    second.append(_call("c2", "Bash", _bash_args("cat hello.txt")))
    replies.append(_reply_tools(second))
    replies.append(_reply("done: hello.txt created"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    a.run("create hello.txt", "auto")
    _stop(p)

    // the tools really ran: the file exists and Bash read it back
    let out_file = dir + "/work/hello.txt"
    ut.assert_true(fs.is_file(out_file))
    ut.assert_eq(fs.read_str(out_file), "hello from mock")
    ut.assert_true(a.has_tool_output())
    let (last_action, last_result) = a.tool_output()
    ut.assert_eq(last_action, "shell")
    ut.assert_true(last_result.starts_with("exit 0"))

    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 3)
    if reqs.len() < 3 { return }

    // request 1 offers the tools; system + task only
    ut.assert_eq(_messages(reqs[0]).len(), 2)
    ut.assert_true(_field(reqs[0], 0, "role") == "system")
    ut.assert_true(_msg(reqs[0], 1) == "user:create hello.txt")
    ut.assert_eq(reqs[0].get_array("tools").len(), 7)
    ut.assert_true(reqs[0].get_str("tool_choice") == "auto")

    // request 2 carries the assistant tool call and its paired result
    ut.assert_eq(_messages(reqs[1]).len(), 4)
    ut.assert_true(_field(reqs[1], 2, "role") == "assistant")
    ut.assert_eq(_call_count(reqs[1], 2), 1)
    ut.assert_eq(_call_id(reqs[1], 2, 0), "c1")
    ut.assert_eq(_call_name(reqs[1], 2, 0), "Write")
    ut.assert_true(_field(reqs[1], 3, "role") == "tool")
    ut.assert_true(_field(reqs[1], 3, "tool_call_id") == "c1")
    ut.assert_true(_field(reqs[1], 3, "content").starts_with("write ok"))

    // request 3 carries both rounds; the shell saw the written file
    ut.assert_eq(_messages(reqs[2]).len(), 6)
    ut.assert_eq(_call_id(reqs[2], 4, 0), "c2")
    ut.assert_true(_field(reqs[2], 5, "tool_call_id") == "c2")
    ut.assert_true("hello from mock" in _field(reqs[2], 5, "content"))
}

// ---- two tool calls in one assistant turn ----

@test
func test_native_two_calls_one_turn() {
    let dir = _setup()
    let both = list[Object]()
    both.append(_call("w1", "Write", _write_args("pair.txt", "pair value")))
    both.append(_call("b1", "Bash", _bash_args("cat pair.txt")))
    let replies = list[Object]()
    replies.append(_reply_tools(both))
    replies.append(_reply("both done"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    a.run("write then read", "auto")
    _stop(p)

    ut.assert_true(fs.is_file(dir + "/work/pair.txt"))
    ut.assert_eq(fs.read_str(dir + "/work/pair.txt"), "pair value")
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 2)
    if reqs.len() < 2 { return }
    // assistant turn with two calls, then two tool answers in order
    ut.assert_eq(_call_count(reqs[1], 2), 2)
    ut.assert_eq(_messages(reqs[1]).len(), 5)
    ut.assert_true(_field(reqs[1], 3, "tool_call_id") == "w1")
    ut.assert_true(_field(reqs[1], 4, "tool_call_id") == "b1")
    ut.assert_true(_field(reqs[1], 4, "content").starts_with("exit 0"))
}

// ---- a failed tool result lets the model fix it ----

@test
func test_native_tool_error_then_fix() {
    let dir = _setup()
    let replies = list[Object]()
    let bad = list[Object]()
    bad.append(_call("bad1", "Write", _write_args("nope/x.txt", "x")))
    replies.append(_reply_tools(bad))
    let good = list[Object]()
    good.append(_call("good1", "Write", _write_args("fixed.txt", "fixed")))
    replies.append(_reply_tools(good))
    replies.append(_reply("recovered"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    a.run("write to a missing directory, then fix it", "auto")
    _stop(p)

    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 3)
    if reqs.len() < 3 { return }
    ut.assert_true(_field(reqs[1], 3, "content").starts_with("write failed"))
    ut.assert_true(fs.is_file(dir + "/work/fixed.txt"))
    ut.assert_eq(fs.read_str(dir + "/work/fixed.txt"), "fixed")
}

// ---- a denied call does not run, and its result says so ----

/// The approver that denies every action.
func _deny(info str, body str, workdir str) str {
    return "n"
}

@test
func test_native_permission_denied() {
    let dir = _setup()
    let replies = list[Object]()
    let calls = list[Object]()
    calls.append(_call("d1", "Write", _write_args("denied.txt", "nope")))
    replies.append(_reply_tools(calls))
    replies.append(_reply("the write was denied; asking what to do"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_deny)
    a.run("write denied.txt", "auto")
    _stop(p)

    // nothing was written, and the model got a paired denial
    ut.assert_false(fs.is_file(dir + "/work/denied.txt"))
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 2)
    if reqs.len() < 2 { return }
    ut.assert_true(_field(reqs[1], 3, "role") == "tool")
    ut.assert_true(_field(reqs[1], 3, "tool_call_id") == "d1")
    ut.assert_true(_field(reqs[1], 3, "content").starts_with("permission denied"))
}

// ---- the step cap says so, and /continue resumes ----

@test
func test_native_step_limit_then_continue() {
    let dir = _setup()
    let replies = list[Object]()
    let first = list[Object]()
    first.append(_call("s1", "Write", _write_args("step.txt", "one")))
    replies.append(_reply_tools(first))
    let second = list[Object]()
    second.append(_call("s2", "Bash", _bash_args("cat step.txt")))
    replies.append(_reply_tools(second))
    replies.append(_reply("finished after continue"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 2)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    a.run("do two steps", "auto")
    // the cap stopped the loop after two rounds, keeping the conversation
    ut.assert_eq(_requests(dir).len(), 2)
    ut.assert_eq(a.conversation().len(), 6)
    // the stop is a resumable pending state (saved with the session record)
    ut.assert_true(a.pending_reason() == "step limit")
    ut.assert_eq(a.pending_mark(), 1)
    // /continue asks again without a new user message
    a.resume("auto")
    ut.assert_true(a.pending_reason() == "")
    _stop(p)

    ut.assert_eq(fs.read_str(dir + "/work/step.txt"), "one")
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 3)
    if reqs.len() < 3 { return }
    ut.assert_eq(_messages(reqs[2]).len(), 6)
    ut.assert_true(_field(reqs[2], 5, "tool_call_id") == "s2")
}

// ---- a truncated reply says so and ends the turn; /continue resumes ----

@test
func test_native_finish_length_ends_turn() {
    let dir = _setup()
    let replies = list[Object]()
    replies.append(_reply_finish("half an answer", "length"))
    replies.append(_reply("this must not be requested"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    a.run("answer briefly", "auto")
    _stop(p)

    // the truncated turn ends the task (a notice is printed), so the
    // scripted second reply is never requested
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 1)
    // the partial answer stays in the conversation for /continue
    ut.assert_eq(a.conversation().len(), 3)
    ut.assert_eq(a.conversation()[2]["content"], "half an answer")
}

// ---- finish_reason: content_filter stops the turn ----

@test
func test_native_content_filter_stops() {
    let dir = _setup()
    let replies = list[Object]()
    replies.append(_reply_finish("blocked text", "content_filter"))
    replies.append(_reply("this must not be requested"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    a.run("something filtered", "auto")
    _stop(p)

    ut.assert_eq(_requests(dir).len(), 1)
    // no tool ran, and the filtered assistant turn is kept
    ut.assert_false(a.has_tool_output())
    let conv = a.conversation()
    ut.assert_eq(conv.len(), 3)
    ut.assert_eq(conv[2]["role"], "assistant")
}

// ---- a 400 that looks like context overflow compacts, then retries ----

/// A restored conversation with enough history for compaction to run:
/// a system message plus four user/assistant pairs, in the JSON array
/// shape a session record holds.
func _old_conversation() Array {
    let msgs = Array()
    msgs.append(_plain_msg("system", "test"))
    var i = 0
    while i < 4 {
        msgs.append(_plain_msg("user", "old question " + str(i)))
        msgs.append(_plain_msg("assistant", "old answer " + str(i)))
        i += 1
    }
    return msgs
}

/// One {role, content} message object, as an older session record holds it.
func _plain_msg(role str, content str) Object {
    let m = Object()
    m["role"] = String(role)
    m["content"] = String(content)
    return m
}

@test
func test_overflow_compacts_then_retries() {
    let dir = _setup()
    let replies = list[Object]()
    replies.append(_reply_error(400, "This model's maximum context length is 8192 tokens"))
    replies.append(_reply("SUMMARY OF OLD TURNS"))
    replies.append(_reply("all done"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.restore_agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"),
                              cfg, dir + "/work", _old_conversation(), false)
    a.set_approver(_approve_all)
    a.run("carry on", "auto")
    _stop(p)

    // error -> summary request -> retried loop request
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 3)
    if reqs.len() < 3 { return }
    // the retry carries system + summary + the four recent messages
    ut.assert_eq(_messages(reqs[2]).len(), 6)
    ut.assert_true(_field(reqs[2], 1, "content").starts_with("[Summary of the earlier conversation]"))
    ut.assert_eq(_messages(reqs[0]).len(), 10)
}

// ---- a big tool output: the pre-request guard compacts, then fits ----

@test
func test_big_tool_output_compacts_before_request() {
    let dir = _setup()
    let replies = list[Object]()
    let names = list[str]()
    names.append("a.txt")
    names.append("b.txt")
    names.append("c.txt")
    names.append("d.txt")
    var i = 0
    while i < 4 {
        let calls = list[Object]()
        calls.append(_call("w" + str(i), "Write", _write_args(names[i], "x")))
        replies.append(_reply_tools(calls))
        i += 1
    }
    // 20 KB of stdout: more than the whole window on its own
    let big = list[Object]()
    big.append(_call("bash", "Bash", _bash_args("yes | head -c 20000")))
    replies.append(_reply_tools(big))
    replies.append(_reply("SUMMARY: wrote a.txt b.txt c.txt d.txt, ran yes"))
    replies.append(_reply("all done"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    // 600 tokens of window: the observation alone exceeds it
    let cfg = _cfg(dir + "/config.json", port, 10, 600)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    a.run("write four files, then dump 20 KB", "auto")
    _stop(p)

    // five tool turns, the summary request, the final request
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 7)
    if reqs.len() < 7 { return }
    // the last request: system, summary, then two whole tool turns
    ut.assert_eq(_messages(reqs[6]).len(), 6)
    ut.assert_true(_msg(reqs[6], 1).starts_with("user:[Summary of the earlier conversation]"))
    ut.assert_true(_field(reqs[6], 2, "role") == "assistant")
    ut.assert_eq(_call_count(reqs[6], 2), 1)
    ut.assert_true(_field(reqs[6], 3, "tool_call_id") == _call_id(reqs[6], 2, 0))
    ut.assert_true(_field(reqs[6], 4, "role") == "assistant")
    ut.assert_true(_field(reqs[6], 5, "tool_call_id") == _call_id(reqs[6], 4, 0))
    // the oversized observation was truncated to fit the window
    let out = _field(reqs[6], 5, "content")
    ut.assert_true("bytes omitted" in out)
    ut.assert_true(out.len() < 2000)
}

// ---- a failed summary must not wipe the history ----

@test
func test_empty_summary_keeps_history() {
    let dir = _setup()
    let replies = list[Object]()
    // the model answers the summary request with blank text
    replies.append(_reply("   "))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.restore_agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"),
                              cfg, dir + "/work", _old_conversation(), false)
    a.set_approver(_approve_all)
    a.compact("auto")
    _stop(p)

    // nothing was replaced: every turn is still there and no summary slipped in
    let conv = a.conversation()
    ut.assert_eq(conv.len(), 9)
    ut.assert_eq(_requests(dir).len(), 1)
    for m in conv {
        ut.assert_false("[Summary of the earlier conversation]" in m["content"])
    }
}

// ---- a restored conversation keeps its tool structure on the wire ----

@test
func test_restored_tool_history_is_sent_back_rich() {
    let dir = _setup()
    let replies = list[Object]()
    replies.append(_reply("done"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    // what a previous run saved: an assistant turn that asked for Write,
    // and the harness's answer to it
    let calls = list[openai.ToolCall]()
    calls.append(openai.ToolCall("c1", "function",
        openai.FunctionCall("Write", "{\"path\": \"old.txt\", \"content\": \"old\"}")))
    let saved = Array()
    saved.append(openai.message_to_object(openai.system_msg("test")))
    saved.append(openai.message_to_object(openai.user_msg("earlier task")))
    saved.append(openai.message_to_object(openai.assistant_msg("", calls)))
    saved.append(openai.message_to_object(openai.tool_msg("c1", "wrote old.txt")))
    let a = chat.restore_agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"),
                              cfg, dir + "/work", saved, false)
    a.set_approver(_approve_all)
    a.run("carry on", "auto")
    _stop(p)

    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 1)
    if reqs.len() < 1 { return }
    // the restored turns go back as they were, so the API sees a valid pair
    ut.assert_eq(_messages(reqs[0]).len(), 5)
    ut.assert_eq(_call_count(reqs[0], 2), 1)
    ut.assert_eq(_call_id(reqs[0], 2, 0), "c1")
    ut.assert_eq(_call_name(reqs[0], 2, 0), "Write")
    ut.assert_eq(_field(reqs[0], 3, "role"), "tool")
    ut.assert_eq(_field(reqs[0], 3, "tool_call_id"), "c1")
    ut.assert_eq(_field(reqs[0], 3, "content"), "wrote old.txt")
    ut.assert_eq(_msg(reqs[0], 4), "user:carry on")
}

// ---- an endpoint that rejects tools falls back to fenced blocks ----

@test
func test_fenced_fallback_on_400() {
    let dir = _setup()
    let replies = list[Object]()
    replies.append(_reply_error(400, "unknown parameter: tools"))
    replies.append(_reply("```write fallback.txt\nhello fallback\n```"))
    replies.append(_reply("```done\ncreated fallback.txt\n```"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    a.set_approver(_approve_all)
    a.run("create fallback.txt", "auto")
    _stop(p)

    ut.assert_true(fs.is_file(dir + "/work/fallback.txt"))
    ut.assert_eq(fs.read_str(dir + "/work/fallback.txt"), "hello fallback")
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 3)
    if reqs.len() < 3 { return }
    // the first request offered tools; the fallback requests do not
    ut.assert_true("\"tools\"" in reqs[0].to_json())
    ut.assert_false("\"tools\"" in reqs[1].to_json())
    ut.assert_true("fenced action block" in _field(reqs[1], 0, "content"))
}

// ---- the mock's SSE path, through the real streaming client ----

@test
func test_stream_from_mock() {
    let dir = _setup()
    let chunks = list[str]()
    chunks.append("hel")
    chunks.append("lo")
    let replies = list[Object]()
    replies.append(_reply_stream(chunks))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let msgs = list[dict[str, str]]()
    msgs.append({"role": "user", "content": "hi"})
    let stream = openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1").chat.completions.stream("auto", msgs)
    ut.assert_true(stream.ok())
    var text = ""
    var last_finish = ""
    for chunk in stream {
        text += chunk.delta
        if chunk.finish_reason != "" { last_finish = chunk.finish_reason }
    }
    ut.assert_eq(stream.usage().total_tokens, 15)
    _stop(p)

    ut.assert_eq(text, "hello")
    ut.assert_eq(last_finish, "stop")
    // the request asked for a stream, with usage on the final chunk
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 1)
    if reqs.len() < 1 { return }
    ut.assert_true(reqs[0].get_bool("stream"))
}

// ---- baseline: an HTTP error ends the turn without retrying ----

// ---- the permission model in the loop: plan refuses, accept_edits runs ----

@test
func test_plan_mode_denies_changes_without_asking() {
    let dir = _setup()
    let replies = list[Object]()
    let calls = list[Object]()
    calls.append(_call("p1", "Write", _write_args("planned.txt", "nope")))
    replies.append(_reply_tools(calls))
    replies.append(_reply("here is the plan"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    // the approver would say yes: the refusal must come from plan mode
    a.set_approver(_approve_all)
    ut.assert_true(a.set_permission_mode("plan"))
    a.run("change the file", "auto")
    _stop(p)

    ut.assert_false(fs.is_file(dir + "/work/planned.txt"))
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 2)
    if reqs.len() < 2 { return }
    // the refusal is paired with the call and explains the ceiling
    ut.assert_true(_field(reqs[1], 3, "tool_call_id") == "p1")
    let obs = _field(reqs[1], 3, "content")
    ut.assert_true(obs.starts_with("The harness denied this call"))
    ut.assert_true("plan mode" in obs)
    ut.assert_true("/plan off" in obs)
    // the system prompt the model saw states the ceiling up front
    ut.assert_true("Permission mode: plan" in _field(reqs[0], 0, "content"))
}

@test
func test_accept_edits_runs_write_but_still_asks_bash() {
    let dir = _setup()
    let replies = list[Object]()
    let calls = list[Object]()
    calls.append(_call("e1", "Write", _write_args("auto.txt", "auto")))
    calls.append(_call("e2", "Bash", _bash_args("touch shell-ran.txt")))
    replies.append(_reply_tools(calls))
    replies.append(_reply("done"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
    let port = _wait_port(dir)
    if port == 0 {
        _stop(p)
        ut.assert_true(false)
        return
    }
    let cfg = _cfg(dir + "/config.json", port, 10)
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:" + str(port) + "/v1"), cfg, dir + "/work", true)
    // the approver denies: the write must never reach it
    a.set_approver(_deny)
    ut.assert_true(a.set_permission_mode("accept_edits"))
    a.run("write then run", "auto")
    _stop(p)

    // the write ran, the shell did not
    ut.assert_true(fs.is_file(dir + "/work/auto.txt"))
    ut.assert_false(fs.is_file(dir + "/work/shell-ran.txt"))
    let reqs = _requests(dir)
    ut.assert_eq(reqs.len(), 2)
    if reqs.len() < 2 { return }
    ut.assert_true(_field(reqs[1], 3, "content").starts_with("write ok"))
    ut.assert_true(_field(reqs[1], 4, "content").starts_with("permission denied by user"))
}

@test
func test_loop_stops_on_http_error() {
    let dir = _setup()
    let replies = list[Object]()
    replies.append(_reply_error(401, "bad key"))
    _write_script(dir + "/script.json", replies)

    let p = _start_mock(dir) else {
        ut.assert_true(false)
        return
    }
