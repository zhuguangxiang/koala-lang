// ---- native tools: declarations and the call -> action mapping ----

/// A tool call the model might have written.
func _tc(name str, args str) openai.ToolCall {
    return openai.ToolCall("c1", "function", openai.FunctionCall(name, args))
}

@test
func test_agent_tools_declares_the_core_set() {
    let tools = chat.agent_tools()
    ut.assert_eq(tools.len(), 7)
    ut.assert_eq(tools[0].name(), "Read")
    ut.assert_eq(tools[1].name(), "Write")
    ut.assert_eq(tools[2].name(), "Edit")
    ut.assert_eq(tools[3].name(), "Bash")
    ut.assert_eq(tools[4].name(), "Glob")
    ut.assert_eq(tools[5].name(), "Grep")
    ut.assert_eq(tools[6].name(), "TodoWrite")
    // each names its required arguments
    ut.assert_true("path" in tools[0].function.parameters.get_object("properties"))
    ut.assert_true("content" in tools[1].function.parameters.get_object("properties"))
    ut.assert_true("old_string" in tools[2].function.parameters.get_object("properties"))
    ut.assert_true("command" in tools[3].function.parameters.get_object("properties"))
    ut.assert_true("pattern" in tools[4].function.parameters.get_object("properties"))
    ut.assert_true("pattern" in tools[5].function.parameters.get_object("properties"))
    ut.assert_true("todos" in tools[6].function.parameters.get_object("properties"))
}

@test
func test_tool_action_write() {
    let action = chat.tool_action("Write", _tc("Write", "{\"path\": \"a.txt\", \"content\": \"hi\"}")) else {
        ut.assert_true(false)
        return
    }
    let (info, body) = action
    ut.assert_eq(info, "write a.txt")
    ut.assert_eq(body, "hi")
}

@test
func test_tool_action_names_are_case_insensitive() {
    let a = chat.tool_action("write", _tc("write", "{\"path\": \"b.txt\", \"content\": \"\"}")) else {
        ut.assert_true(false)
        return
    }
    let (a_info, a_body) = a
    ut.assert_eq(a_info, "write b.txt")
    ut.assert_eq(a_body, "")
    let b = chat.tool_action("bash", _tc("bash", "{\"command\": \"echo hi\"}")) else {
        ut.assert_true(false)
        return
    }
    let (b_info, b_body) = b
    ut.assert_eq(b_info, "shell")
    ut.assert_eq(b_body, "echo hi")
}

@test
func test_tool_action_rejects_bad_calls() {
    // unknown tool name
    ut.assert_true(chat.tool_action("Frob", _tc("Frob", "{}")) == nil)
    // malformed argument JSON never panics
    ut.assert_true(chat.tool_action("Write", _tc("Write", "{not json")) == nil)
    // a missing required argument
    ut.assert_true(chat.tool_action("Write", _tc("Write", "{\"path\": \"a.txt\"}")) == nil)
    // an empty path or command
    ut.assert_true(chat.tool_action("Write", _tc("Write", "{\"path\": \"  \", \"content\": \"x\"}")) == nil)
    ut.assert_true(chat.tool_action("Bash", _tc("Bash", "{\"command\": \"   \"}")) == nil)
    // non-object JSON
    ut.assert_true(chat.tool_action("Bash", _tc("Bash", "[1,2]")) == nil)
}

@test
func test_tool_names_lists_available() {
    ut.assert_true("Write" in chat.tool_names())
    ut.assert_true("Bash" in chat.tool_names())
}

// ---- heap settle (settle_heap / gc.collect at the stop points) ----

/// Allocate `n` short-lived strings and use them, so the loop cannot be
/// optimized away: the counter must clear the settle threshold so the next
/// `settle_heap()` really collects. Returns the total length, for an assert.
func _churn(n int) int {
    var acc = 0
    for i in range(n) {
        let s = "abc" + str(i)
        acc += s.len()
    }
    return acc
}

@test
func test_settle_heap_collects_after_churn() {
    gc.collect()
    let before = gc.get_stats()["collections"].to_int()
    // four blocks per iteration: the int's text, the concatenation and the
    // two tuples `range` yields
    ut.assert_true(_churn(200_000) > 0)
    let (allocated, _, _) = gc.get_count()
    // well past the 50k-block threshold settle_heap uses
    ut.assert_true(allocated > 100_000)
    chat.settle_heap()
    let (left, _, _) = gc.get_count()
    ut.assert_true(left < 10_000)
    ut.assert_eq(gc.get_stats()["collections"].to_int(), before + 1)
}

@test
func test_settle_heap_skips_a_quiet_turn() {
    // a fresh collection zeroes the counter, so the next stop point must not
    // pay for another full mark & sweep
    gc.collect()
    let before = gc.get_stats()["collections"].to_int()
    chat.settle_heap()
    ut.assert_eq(gc.get_stats()["collections"].to_int(), before)
}

@test
func test_settle_heap_keeps_the_live_conversation() {
    let w = _work()
    _write_config(ABASE + "/cfg.json", "")
    let cfg = _cfg(ABASE + "/cfg.json")
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:1/v1"), cfg, w, true)
    a.add_context("kept across a collection")
    ut.assert_true(_churn(200_000) > 0)
    chat.settle_heap()
    // everything the Agent holds is reachable from the stack or a module
    // global, so a collection in the middle of a session must not touch it
    let conv = a.conversation()
    ut.assert_eq(conv.len(), 2)
    ut.assert_eq(conv[1]["content"], "kept across a collection")
    ut.assert_eq(a.permission(), "default")
}
