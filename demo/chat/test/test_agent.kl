@test
func test_shell_stdout() {
    let w = _work()
    ut.assert_true(chat.run_action("shell", "echo hi", w, list[str]()) == "exit 0\nstdout:\nhi")
}

@test
func test_shell_stderr() {
    let w = _work()
    ut.assert_true(chat.run_action("shell", "echo e 1>&2", w, list[str]()) == "exit 0\nstderr:\ne")
}

@test
func test_shell_both_streams() {
    let w = _work()
    let r = chat.run_action("shell", "echo o; echo e 1>&2", w, list[str]())
    ut.assert_true(r == "exit 0\nstdout:\no\nstderr:\ne")
}

@test
func test_shell_failure_code() {
    let w = _work()
    ut.assert_true(chat.run_action("shell", "exit 3", w, list[str]()) == "exit 3")
}

@test
func test_shell_empty_command() {
    let w = _work()
    ut.assert_true(chat.run_action("shell", "  ", w, list[str]()) == "shell: empty command")
}

@test
func test_shell_runs_in_workdir() {
    let w = _work()
    ut.assert_true(chat.run_action("shell", "pwd", w, list[str]()) == "exit 0\nstdout:\n" + w)
}

@test
func test_shell_aliases() {
    let w = _work()
    ut.assert_true("stdout:\nsh-run" in chat.run_action("sh", "echo sh-run", w, list[str]()))
    ut.assert_true("stdout:\nbash-run" in chat.run_action("bash", "echo bash-run", w, list[str]()))
    // "shell <extra>" runs the body, not the info tail
    ut.assert_true("stdout:\nbody-runs" in chat.run_action("shell echo ignored", "echo body-runs", w, list[str]()))
}

// ---- run_action: unknown ----

@test
func test_unknown_action() {
    let w = _work()
    ut.assert_true(chat.run_action("frobnicate x", "body", w, list[str]()) == "unknown action: frobnicate x")
}

// ---- Agent ----

@test
func test_agent_set_workdir() {
    let w = _work()
    _write_config(ABASE + "/cfg.json", ", \"no_access_dirs\": [\"secret\"]")
    let cfg = _cfg(ABASE + "/cfg.json")
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:1/v1"), cfg, w)
    ut.assert_eq(a.last_tokens(), 0)
    // nothing for Ctrl-O until a tool actually runs
    ut.assert_false(a.has_tool_output())
    ut.assert_true(a.set_workdir(w))
    ut.assert_false(a.set_workdir(w + "/secret"))
    ut.assert_false(a.set_workdir(w + "/missing"))
    ut.assert_false(a.set_workdir(w + "/cfg.json"))
}

@test
func test_agent_permission_mode_switch() {
    let w = _work()
    _write_config(ABASE + "/cfg.json", "")
    let cfg = _cfg(ABASE + "/cfg.json")
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:1/v1"), cfg, w, true)
    ut.assert_eq(a.permission(), "default")
    ut.assert_false("Permission mode: plan" in a.conversation()[0]["content"])
    ut.assert_true(a.set_permission_mode("plan"))
    ut.assert_eq(a.permission(), "plan")
    // the system prompt is refreshed, so the next request carries the ceiling
    ut.assert_true("Permission mode: plan" in a.conversation()[0]["content"])
    // an unknown mode is refused and changes nothing
    ut.assert_false(a.set_permission_mode("nope"))
    ut.assert_eq(a.permission(), "plan")
    ut.assert_true(a.set_permission_mode("accept-edits"))
    ut.assert_eq(a.permission(), "accept_edits")
    ut.assert_false("Permission mode: plan" in a.conversation()[0]["content"])
}

@test
func test_agent_run_error_smoke() {
    let w = _work()
    _write_config(ABASE + "/cfg.json", "")
    let cfg = _cfg(ABASE + "/cfg.json")
    // an unreachable endpoint: the loop reports the error and returns
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:1/v1"), cfg, w)
    a.run("do it", "auto")
}

@test
func test_agent_compact_smoke() {
    let w = _work()
    _write_config(ABASE + "/cfg.json", "")
    let cfg = _cfg(ABASE + "/cfg.json")
    let a = chat.Agent(openai.Client("sk", "http://127.0.0.1:1/v1"), cfg, w)
    // a conversation too short to compact: "(nothing to compact)"
    a.compact("auto")
}

@test
func test_estimate_tokens() {
    let msgs = list[dict[str, str]]()
    ut.assert_eq(chat.estimate_tokens(msgs), 0)
    // 4 bytes is about one token, plus the per-message overhead
    msgs.append({"role": "user", "content": "abcd"})
    ut.assert_eq(chat.estimate_tokens(msgs), 5)
    // rounding up keeps a short message from counting as zero
    msgs.append({"role": "assistant", "content": "a"})
    ut.assert_eq(chat.estimate_tokens(msgs), 10)
}

@test
func test_estimate_rich_tokens_counts_tool_fields() {
    let msgs = list[openai.CompletionMessage]()
    msgs.append(openai.CompletionMessage("system", "s", list[openai.ToolCall](), "", ""))
    msgs.append(openai.CompletionMessage("user", "abcd", list[openai.ToolCall](), "", ""))
    // text only: (1+3)/4+4 and (4+3)/4+4
    ut.assert_eq(chat.estimate_rich_tokens(msgs), 10)
    // a tool call's name and arguments count, not only the text
    let calls = list[openai.ToolCall]()
    calls.append(_tc("Bash", "{\"command\":\"ls -la\"}"))
    msgs.append(openai.CompletionMessage("assistant", "", calls, "", ""))
    // 4 + 20 bytes of name and arguments -> 6 tokens plus the overhead
    ut.assert_eq(chat.estimate_rich_message_tokens(msgs[2]), 10)
    // a tool result's id counts as well as its content
    msgs.append(openai.CompletionMessage("tool", "0123456789", list[openai.ToolCall](), "c1", ""))
    ut.assert_eq(chat.estimate_rich_message_tokens(msgs[3]), 7)
    // the range form only sums what a request would add
    ut.assert_eq(chat.estimate_rich_tokens_from(msgs, 2), 17)
    ut.assert_eq(chat.estimate_rich_tokens_from(msgs, 4), 0)
    ut.assert_eq(chat.estimate_rich_tokens_from(msgs, 99), 0)
}

/// A rich message with only text.
func _rich(role str, content str) openai.CompletionMessage {
    return openai.CompletionMessage(role, content, list[openai.ToolCall](), "", "")
}

/// A rich tool round: an assistant turn with `ids.len()` calls plus one
/// result per call.
func _append_round(msgs list[openai.CompletionMessage], ids list[str]) {
    let calls = list[openai.ToolCall]()
    for id in ids {
        calls.append(openai.ToolCall(id, "function", openai.FunctionCall("Bash", "{}")))
    }
    msgs.append(openai.CompletionMessage("assistant", "", calls, "", ""))
    for id in ids {
        msgs.append(openai.CompletionMessage("tool", "exit 0", list[openai.ToolCall](), id, ""))
    }
}

@test
func test_rich_split_index_keeps_tool_turns() {
    // a conversation too short to compact at all
    ut.assert_false(chat.can_compact_rich(list[openai.CompletionMessage]()))
    // sys, user, a1 + 3 results, a2 + 1 result: the last KEEP_RECENT
    // messages would start inside a1's results
    let msgs = list[openai.CompletionMessage]()
    msgs.append(_rich("system", "s"))
    msgs.append(_rich("user", "go"))
    let first = list[str]()
    first.append("c1")
    first.append("c2")
    first.append("c3")
    _append_round(msgs, first)
    let second = list[str]()
    second.append("c4")
    _append_round(msgs, second)
    ut.assert_true(chat.can_compact_rich(msgs))
    // the split moves back to the assistant turn, so no tool result is
    // orphaned and no assistant turn loses its results
    ut.assert_eq(chat.rich_split_index(msgs), 2)
    ut.assert_true(msgs[2].role == "assistant")
    ut.assert_eq(msgs[2].tool_calls.len(), 3)
}

@test
func test_truncate_middle_keeps_ends() {
    let s = "abcdefghijklmnopqrstuvwxyz"
    ut.assert_true(chat.truncate_middle(s, 100) == s)
    let cut = chat.truncate_middle(s, 12)
    ut.assert_true(cut.starts_with("abcdefgh"))
    ut.assert_true(cut.ends_with("wxyz"))
    ut.assert_true("bytes omitted" in cut)
    ut.assert_true(cut.len() < s.len() + 40)
}

@test
func test_shrink_tool_results() {
    let w = _work()
    // context_window 4096 -> the compaction threshold is about 3276 tokens
    _write_config(ABASE + "/cfg.json", "")
    let cfg = _cfg(ABASE + "/cfg.json")
    let msgs = list[openai.CompletionMessage]()
    msgs.append(_rich("system", "s"))
    msgs.append(_rich("user", "go"))
    var big = "0123456789"
    while big.len() < 40000 { big = big + big }
    msgs.append(openai.CompletionMessage("tool", big, list[openai.ToolCall](), "c1", ""))
    if let after = chat.shrink_tool_results(cfg, msgs) {
        ut.assert_true(after < cfg.context_window * 80 / 100)
    } else {
        ut.assert_true(false)
    }
    ut.assert_true(msgs[2].content.len() < 5000)
    ut.assert_true(msgs[2].tool_call_id == "c1")
    ut.assert_true("bytes omitted" in msgs[2].content)
    // nothing oversized: nothing to do
    let small = list[openai.CompletionMessage]()
    small.append(openai.CompletionMessage("tool", "exit 0", list[openai.ToolCall](), "c1", ""))
    ut.assert_true(chat.shrink_tool_results(cfg, small) == nil)
}

// ---- action_target: one path rule for the guard, diff and write ----

@test
func test_action_target_relative_and_absolute() {
    let w = "/tmp/w"
    if let a = chat.action_target("write a.txt", w) {
        ut.assert_eq(a, w + "/a.txt")
    } else {
        ut.assert_true(false)
    }
    if let b = chat.action_target("write /etc/hosts", w) {
        ut.assert_eq(b, "/etc/hosts")
    } else {
        ut.assert_true(false)
    }
    if let c = chat.action_target("write sub/../x", w) {
        ut.assert_eq(c, w + "/x")
    } else {
        ut.assert_true(false)
    }
    ut.assert_true(chat.action_target("write ", w) == nil)
    ut.assert_true(chat.action_target("shell", w) == nil)
}

@test
func test_default_approver_denies() {
    ut.assert_eq(chat.deny_action("write a.txt", "x", "/tmp"), "n")
    ut.assert_eq(chat.deny_action("shell", "rm -rf /", "/tmp"), "n")
}

