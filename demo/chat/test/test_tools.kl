// The tool set (tools.kl): every implementation's success and failure
// branches — Read with offset/limit, Edit's unique-match rule, Glob/Grep
// filters and limits, TodoWrite, the argument dispatch, and the Bash
// timeout/output cap in `run_action`.

import "std/ut"
import "std/fs"
import "std/os"
import "std/time"
import "demo/chat"
import "koala/openai" as openai

const TBASE = "/tmp/koala_chat_toolstest"

/// A fresh tree: `src/` with two .kl files, `a.txt`, `secret/`, and a
/// binary file. `blocked` names `secret`.
func _tree() str {
    fs.remove_all(TBASE)
    fs.mkdir(TBASE)
    fs.mkdir(TBASE + "/secret")
    fs.mkdir(TBASE + "/src")
    fs.mkdir(TBASE + "/src/deep")
    fs.write_str(TBASE + "/a.txt", "one\ntwo\nthree\n")
    fs.write_str(TBASE + "/src/main.kl", "func main() {\n    print(\"hi\")\n}\n")
    fs.write_str(TBASE + "/src/deep/util.kl", "// Helper\nfunc helper() {}\n")
    fs.write_str(TBASE + "/secret/key.txt", "secret = 42\n")
    let raw = bytes(3)
    raw[0] = uint8(65)
    raw[1] = uint8(0)
    raw[2] = uint8(66)
    fs.write_bytes(TBASE + "/bin.dat", raw)
    return TBASE
}

/// The no-access list every test passes.
func _blocked() list[str] {
    let b = list[str]()
    b.append("secret")
    return b
}

// ---- Read ----

@test
func test_read_line_numbers_and_range() {
    let d = _tree()
    let all = chat.read_tool("a.txt", "{}", d, _blocked(), 100_000)
    ut.assert_true(all.starts_with("read ok: a.txt (lines 1-3 of 3)"))
    ut.assert_true("     1\tone" in all)
    ut.assert_true("     3\tthree" in all)

    let mid = chat.read_tool("a.txt", "{\"offset\":2,\"limit\":1}", d, _blocked(), 100_000)
    ut.assert_true(mid.starts_with("read ok: a.txt (lines 2-2 of 3)"))
    ut.assert_true("two" in mid)
    ut.assert_false("one" in mid)

    let past = chat.read_tool("a.txt", "{\"offset\":9}", d, _blocked(), 100_000)
    ut.assert_true(past.starts_with("read ok: a.txt (no lines from 9"))
}

@test
func test_read_errors() {
    let d = _tree()
    ut.assert_true(chat.read_tool("nope.txt", "{}", d, _blocked(), 100_000).starts_with("ERROR: read: nope.txt: no such file"))
    ut.assert_true(chat.read_tool("src", "{}", d, _blocked(), 100_000).starts_with("ERROR: read: src is a directory"))
    ut.assert_true(chat.read_tool("bin.dat", "{}", d, _blocked(), 100_000).starts_with("ERROR: read: bin.dat looks like a binary"))
    ut.assert_true(chat.read_tool("secret/key.txt", "{}", d, _blocked(), 100_000).starts_with("ERROR: read: secret/key.txt is in a no-access"))
    // a path that leaves the work directory into a blocked one
    ut.assert_true(chat.read_tool("src/../secret/key.txt", "{}", d, _blocked(), 100_000).starts_with("ERROR: read"))
    // empty arguments are fine: defaults apply
    ut.assert_true(chat.read_tool("a.txt", "", d, _blocked(), 100_000).starts_with("read ok: a.txt"))
}

@test
func test_read_truncates_at_byte_budget() {
    let d = _tree()
    let cut = chat.read_tool("a.txt", "{}", d, _blocked(), 60)
    ut.assert_true("output truncated at 60 bytes" in cut)
}

// ---- Edit ----

@test
func test_edit_replaces_one_match() {
    let d = _tree()
    let r = chat.edit_tool("a.txt", "{\"old_string\":\"two\",\"new_string\":\"TWO\"}", d, _blocked())
    ut.assert_eq(r, "edit ok: a.txt (1 replacement)")
    let text = fs.read_str(d + "/a.txt")
    ut.assert_true("one\nTWO\nthree\n" == text)
}

@test
func test_edit_rejects_missing_and_ambiguous() {
    let d = _tree()
    let miss = chat.edit_tool("a.txt", "{\"old_string\":\"zzz\",\"new_string\":\"y\"}", d, _blocked())
    ut.assert_true(miss.starts_with("ERROR: edit: old_string not found"))
    fs.write_str(d + "/dup.txt", "x\nx\n")
    let dup = chat.edit_tool("dup.txt", "{\"old_string\":\"x\",\"new_string\":\"y\"}", d, _blocked())
    ut.assert_true("appears 2 times" in dup)
    // the file is untouched after a refused edit
    ut.assert_eq(fs.read_str(d + "/dup.txt"), "x\nx\n")
    // missing arguments and empty old_string
    ut.assert_true(chat.edit_tool("a.txt", "{\"path\":\"a.txt\"}", d, _blocked()).starts_with("ERROR: edit: old_string"))
    ut.assert_true(chat.edit_tool("a.txt", "{\"old_string\":\"\",\"new_string\":\"x\"}", d, _blocked()).starts_with("ERROR: edit: old_string is empty"))
}

@test
func test_edit_replace_all_and_guards() {
    let d = _tree()
    fs.write_str(d + "/dup.txt", "x\nx\nx\n")
    let r = chat.edit_tool("dup.txt", "{\"old_string\":\"x\",\"new_string\":\"y\",\"replace_all\":true}", d, _blocked())
    ut.assert_eq(r, "edit ok: dup.txt (3 replacements)")
    ut.assert_eq(fs.read_str(d + "/dup.txt"), "y\ny\ny\n")
    ut.assert_true(chat.edit_tool("secret/key.txt", "{\"old_string\":\"42\",\"new_string\":\"0\"}", d, _blocked()).starts_with("ERROR: edit: secret/key.txt is in a no-access"))
    ut.assert_true(chat.edit_tool("nope.txt", "{\"old_string\":\"a\",\"new_string\":\"b\"}", d, _blocked()).starts_with("ERROR: edit: nope.txt: no such file"))
}

// ---- Glob ----

@test
func test_glob_finds_and_skips_blocked() {
    let d = _tree()
    let r = chat.glob_tool("src/**/*.kl", "{}", d, _blocked())
    ut.assert_true(r.starts_with("glob ok: src/**/*.kl (2 files)"))
    ut.assert_true("src/main.kl" in r)
    ut.assert_true("src/deep/util.kl" in r)
    // a pattern under a blocked directory lists nothing and says it skipped
    let s = chat.glob_tool("secret/*.txt", "{}", d, _blocked())
    ut.assert_true(s.starts_with("glob ok: secret/*.txt (no files)"))
    // a relative base is resolved against the work directory
    let sub = chat.glob_tool("*.kl", "{\"path\":\"src\"}", d, _blocked())
    ut.assert_true(sub.starts_with("glob ok: *.kl (1 files)"))
    ut.assert_true("src/main.kl" in sub)
}

@test
func test_glob_errors() {
    let d = _tree()
    ut.assert_true(chat.glob_tool("/etc/*", "{}", d, _blocked()).starts_with("ERROR: glob: pattern must be relative"))
    ut.assert_true(chat.glob_tool("*.kl", "{\"path\":\"nope\"}", d, _blocked()).starts_with("ERROR: glob: nope: no such directory"))
    ut.assert_true(chat.glob_tool("*.kl", "{\"path\":\"secret\"}", d, _blocked()).starts_with("ERROR: glob: secret is in a no-access"))
}

// ---- Grep ----

@test
func test_grep_reports_line_numbers() {
    let d = _tree()
    let r = chat.grep_tool("func", "{}", d, _blocked())
    ut.assert_true(r.starts_with("grep ok: func (2 matches in"))
    ut.assert_true("src/main.kl:1: func main() {" in r)
    ut.assert_true("src/deep/util.kl:2: func helper() {}" in r)
    // the blocked tree is never searched
    ut.assert_false("key.txt" in r)
}

@test
func test_grep_include_and_ignore_case() {
    let d = _tree()
    let inc = chat.grep_tool("func", "{\"include\":\"util.kl\"}", d, _blocked())
    ut.assert_true("util.kl:2" in inc)
    ut.assert_false("main.kl" in inc)
    let ci = chat.grep_tool("FUNC", "{\"ignore_case\":true}", d, _blocked())
    ut.assert_true("2 matches" in ci)
    let miss = chat.grep_tool("FUNC", "{}", d, _blocked())
    ut.assert_true(miss.starts_with("grep ok: FUNC (no matches"))
    // one file as the base
    let one = chat.grep_tool("print", "{\"path\":\"src/main.kl\"}", d, _blocked())
    ut.assert_true(one.starts_with("grep ok: print (1 matches"))
}

@test
func test_grep_errors() {
    let d = _tree()
    ut.assert_true(chat.grep_tool("", "{}", d, _blocked()).starts_with("ERROR: grep: invalid regular expression"))
    ut.assert_true(chat.grep_tool("a(", "{}", d, _blocked()).starts_with("ERROR: grep: invalid regular expression"))
    ut.assert_true(chat.grep_tool("x", "{\"path\":\"nope\"}", d, _blocked()).starts_with("ERROR: grep: nope: no such file or directory"))
    ut.assert_true(chat.grep_tool("x", "{\"path\":\"secret\"}", d, _blocked()).starts_with("ERROR: grep: secret is in a no-access"))
}

// ---- TodoWrite ----

@test
func test_todo_replaces_list() {
    let r = chat.todo_tool("{\"todos\":[{\"content\":\"read code\",\"status\":\"completed\"},{\"content\":\"write fix\",\"status\":\"in_progress\"},\"plain\"]}")
    ut.assert_true(r.starts_with("todo ok: 3 items (1 done, 1 in progress)"))
    ut.assert_true("[x] read code" in r)
    ut.assert_true("[>] write fix" in r)
    ut.assert_true("[ ] plain" in r)
    ut.assert_eq(chat.todos().len(), 3)
    ut.assert_eq(chat.todos()[1]["status"], "in_progress")
    ut.assert_eq(chat.todo_status(), "todo 1/3")
    // the last TodoWrite wins, and a bad status falls back to pending
    chat.todo_tool("{\"todos\":[{\"content\":\"only\",\"status\":\"weird\"}]}")
    ut.assert_eq(chat.todos().len(), 1)
    ut.assert_eq(chat.todos()[0]["status"], "pending")
    ut.assert_eq(chat.todo_status(), "todo 0/1")
}

@test
func test_todo_rejects_bad_arguments() {
    ut.assert_true(chat.todo_tool("").starts_with("ERROR: todo: arguments are not a JSON object"))
    ut.assert_true(chat.todo_tool("{}").starts_with("ERROR: todo: missing 'todos'"))
    ut.assert_true(chat.todo_tool("{\"todos\":3}").starts_with("ERROR: todo: 'todos' must be an array"))
    // an all-blank entry is dropped, an empty array clears the list
    chat.todo_tool("{\"todos\":[{\"content\":\"  \"}]}")
    ut.assert_eq(chat.todos().len(), 0)
    ut.assert_eq(chat.todo_status(), "")
}

// ---- dispatch ----

/// A native call `name` with the argument JSON `args`.
func _call(name str, args str) openai.ToolCall {
    return openai.ToolCall("c1", "function", openai.FunctionCall(name, args))
}

@test
func test_tool_action_maps_core_names() {
    let write = chat.tool_action("Write", _call("Write", "{\"path\":\"a.txt\",\"content\":\"x\"}"))
    ut.assert_true(write != nil)
    let (wi, wb) = write else { return }
    ut.assert_eq(wi, "write a.txt")
    ut.assert_eq(wb, "x")

    let read = chat.tool_action("read", _call("read", "{\"path\":\"src/main.kl\",\"offset\":2}"))
    ut.assert_true(read != nil)
    let (ri, rb) = read else { return }
    ut.assert_eq(ri, "read src/main.kl")
    ut.assert_true("\"offset\"" in rb)

    let edit = chat.tool_action("EDIT", _call("EDIT", "{\"path\":\"a.txt\",\"old_string\":\"a\",\"new_string\":\"b\"}"))
    ut.assert_true(edit != nil)
    let (ei, _) = edit else { return }
    ut.assert_eq(ei, "edit a.txt")

    let glob = chat.tool_action("Glob", _call("Glob", "{\"pattern\":\"src/**/*.kl\"}"))
    ut.assert_true(glob != nil)
    let (gi, _) = glob else { return }
    ut.assert_eq(gi, "glob src/**/*.kl")

    let grep = chat.tool_action("Grep", _call("Grep", "{\"pattern\":\"func x\"}"))
    ut.assert_true(grep != nil)
    let (si, _) = grep else { return }
    ut.assert_eq(si, "grep func x")

    let todo = chat.tool_action("TodoWrite", _call("TodoWrite", "{\"todos\":[]}"))
    ut.assert_true(todo != nil)
    let (ti, _) = todo else { return }
    ut.assert_eq(ti, "todo")
}

@test
func test_tool_action_rejects_bad_arguments() {
    // a call that misses a required argument is not an action
    ut.assert_true(chat.tool_action("Read", _call("Read", "{}")) == nil)
    ut.assert_true(chat.tool_action("Read", _call("Read", "not json")) == nil)
    ut.assert_true(chat.tool_action("Write", _call("Write", "{\"path\":\"  \",\"content\":\"x\"}")) == nil)
    ut.assert_true(chat.tool_action("Edit", _call("Edit", "{\"path\":\"a.txt\",\"old_string\":\"a\"}")) == nil)
    ut.assert_true(chat.tool_action("Glob", _call("Glob", "{}")) == nil)
    ut.assert_true(chat.tool_action("Grep", _call("Grep", "{\"pattern\":\"\"}")) == nil)
    ut.assert_true(chat.tool_action("TodoWrite", _call("TodoWrite", "{}")) == nil)
    ut.assert_true(chat.tool_action("Frobnicate", _call("Frobnicate", "{}")) == nil)
}

@test
func test_run_action_dispatches_each_tool() {
    let d = _tree()
    ut.assert_true(chat.run_action("read a.txt", "{}", d, _blocked()).starts_with("read ok: a.txt"))
    ut.assert_true(chat.run_action("write b.txt", "hi", d, _blocked()).starts_with("write ok: b.txt (2 bytes)"))
    ut.assert_true(chat.run_action("edit b.txt", "{\"old_string\":\"hi\",\"new_string\":\"ho\"}", d, _blocked()).starts_with("edit ok: b.txt"))
    ut.assert_true(chat.run_action("glob *.txt", "{}", d, _blocked()).starts_with("glob ok: *.txt"))
    ut.assert_true(chat.run_action("grep ho", "{}", d, _blocked()).starts_with("grep ok: ho"))
    ut.assert_true(chat.run_action("todo", "{\"todos\":[\"x\"]}", d, _blocked()).starts_with("todo ok: 1 items"))
    ut.assert_true(chat.run_action("teleport", "", d, _blocked()).starts_with("unknown action"))
    // the no-access guard applies to read and write alike
    ut.assert_true(chat.run_action("write secret/x", "x", d, _blocked()).starts_with("write refused"))
}

// ---- Bash ----

@test
func test_shell_timeout_does_not_hang() {
    let d = _tree()
    let start = time.monotonic()
    let r = chat.run_action("shell", "sleep 5", d, _blocked(), 300, 1000)
    let spent = time.monotonic().diff(start)
    ut.assert_true(r.starts_with("shell: timeout after 300ms"))
    ut.assert_true(spent.to_ms() < 3000)
}

@test
func test_shell_output_is_capped_and_logged() {
    let d = _tree()
    let r = chat.run_action("shell", "yes koala | head -n 4000", d, _blocked(), 10_000, 500)
    ut.assert_true(r.starts_with("exit 0"))
    ut.assert_true("output capped at 500 bytes per stream" in r)
    ut.assert_true("full output: " in r)
    // the log file named in the result exists and holds the whole text
    let at = r.index("full output: ") + 13
    let full = r.substr(at)
    let log = full.substr(0, full.index(")"))
    ut.assert_true(fs.is_file(log))
    ut.assert_true(fs.read_str(log, 100_000).len() > 500)
    fs.remove(log)
}