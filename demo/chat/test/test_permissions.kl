// The permission model (permission.kl): tool kinds, mode-name normalising
// and the whole allow/ask/deny decision table, including the config lists
// that override a mode.

import "std/ut"
import "demo/chat"

func _none() list[str] {
    return list[str]()
}

/// The decision for one kind, with no config rules.
func _decide(mode str, kind str) str {
    let (d, r) = chat.permission_decision(mode, kind, "", _none(), _none(), _none())
    return d
}

/// The prefix `body` hits, or "" when it hits none.
func _prefix(body str, prefixes list[str]) str {
    if let p = chat.bash_deny_prefix(body, prefixes) { return p }
    return ""
}

@test
func test_tool_kind_spellings() {
    ut.assert_eq(chat.tool_kind("write a.txt"), "write")
    ut.assert_eq(chat.tool_kind("Write a.txt"), "write")
    ut.assert_eq(chat.tool_kind("read"), "read")
    ut.assert_eq(chat.tool_kind("shell"), "bash")
    ut.assert_eq(chat.tool_kind("bash echo hi"), "bash")
    ut.assert_eq(chat.tool_kind("edit a.txt"), "edit")
    ut.assert_eq(chat.tool_kind("glob **/*.kl"), "glob")
    ut.assert_eq(chat.tool_kind("grep TODO"), "grep")
    ut.assert_eq(chat.tool_kind("todo"), "todo")
    ut.assert_eq(chat.tool_kind("TodoWrite"), "todo")
    ut.assert_eq(chat.tool_kind("done"), "done")
    ut.assert_eq(chat.tool_kind("nonsense"), "")
    ut.assert_eq(chat.tool_kind(""), "")
}

@test
func test_permission_mode_normalize() {
    ut.assert_eq(chat.normalize_permission_mode("default"), "default")
    ut.assert_eq(chat.normalize_permission_mode("  PLAN "), "plan")
    ut.assert_eq(chat.normalize_permission_mode("accept-edits"), "accept_edits")
    ut.assert_eq(chat.normalize_permission_mode("acceptEdits"), "accept_edits")
    ut.assert_eq(chat.normalize_permission_mode("Bypass"), "bypass")
    ut.assert_eq(chat.normalize_permission_mode(""), "")
    ut.assert_eq(chat.normalize_permission_mode("yolo"), "")
    ut.assert_eq(chat.permission_modes().len(), 4)
    ut.assert_eq(chat.permission_modes_text(), "default, accept_edits, plan, bypass")
}

@test
func test_decision_table_read_only_kinds_always_run() {
    for m in chat.permission_modes() {
        for k in ["read", "glob", "grep", "todo", "done"] {
            ut.assert_eq(_decide(m, k), "allow")
        }
    }
}

@test
func test_decision_table_changing_kinds() {
    // default: every change asks first
    ut.assert_eq(_decide("default", "write"), "ask")
    ut.assert_eq(_decide("default", "edit"), "ask")
    ut.assert_eq(_decide("default", "bash"), "ask")
    // accept_edits: files run, the shell still asks
    ut.assert_eq(_decide("accept_edits", "write"), "allow")
    ut.assert_eq(_decide("accept_edits", "edit"), "allow")
    ut.assert_eq(_decide("accept_edits", "bash"), "ask")
    // plan: read-only ceiling
    ut.assert_eq(_decide("plan", "write"), "deny")
    ut.assert_eq(_decide("plan", "edit"), "deny")
    ut.assert_eq(_decide("plan", "bash"), "deny")
    // bypass: everything runs
    ut.assert_eq(_decide("bypass", "write"), "allow")
    ut.assert_eq(_decide("bypass", "edit"), "allow")
    ut.assert_eq(_decide("bypass", "bash"), "allow")
    // an unknown action is not a permission decision: run_action reports it
    ut.assert_eq(_decide("plan", ""), "allow")
}

@test
func test_deny_list_wins_over_every_mode() {
    let deny = ["bash"]
    for m in chat.permission_modes() {
        let (d, why) = chat.permission_decision(m, "bash", "echo hi", _none(), deny, _none())
        ut.assert_eq(d, "deny")
        ut.assert_true("agent_deny_tools" in why)
    }
    // even when allow_tools names the same kind
    let (d, r) = chat.permission_decision("bypass", "bash", "echo hi", deny, deny, _none())
    ut.assert_eq(d, "deny")
}

@test
func test_plan_is_a_ceiling_for_allow_tools() {
    let allow = ["Write", "Bash", "TodoWrite"]
    let (d, why) = chat.permission_decision("plan", "write", "", allow, _none(), _none())
    ut.assert_eq(d, "deny")
    ut.assert_true("plan mode" in why)
    let (d2, r2) = chat.permission_decision("plan", "bash", "echo hi", allow, _none(), _none())
    ut.assert_eq(d2, "deny")
    // under default the same list lifts the question
    let (d3, r3) = chat.permission_decision("default", "write", "", allow, _none(), _none())
    ut.assert_eq(d3, "allow")
    // and a read-only kind on the list is still allowed in plan mode
    let (d4, r4) = chat.permission_decision("plan", "todo", "", allow, _none(), _none())
    ut.assert_eq(d4, "allow")
}

@test
func test_bash_deny_prefixes() {
    let prefixes = ["rm", "sudo"]
    ut.assert_eq(_prefix("rm -rf build", prefixes), "rm")
    ut.assert_eq(_prefix("  sudo ls", prefixes), "sudo")
    ut.assert_eq(_prefix("echo rm", prefixes), "")
    ut.assert_eq(_prefix("", prefixes), "")
    ut.assert_eq(_prefix("rm x", _none()), "")
    // a prefix list also refuses in bypass
    let (d, why) = chat.permission_decision("bypass", "bash", "rm -rf /", _none(), _none(), prefixes)
    ut.assert_eq(d, "deny")
    ut.assert_true("agent_bash_deny" in why)
    // documented limitation: a prefix is not a sandbox
    let (d2, r2) = chat.permission_decision("bypass", "bash", "cd x && rm -rf /", _none(), _none(), prefixes)
    ut.assert_eq(d2, "allow")
}