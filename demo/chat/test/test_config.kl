@should_panic("config field 'temperature' must be a number")
func test_config_temperature_non_number_panics() {
    _fresh()
    os.setenv("CHAT_CONFIG", CFGBASE + "/str_temp.json")
    let json = "{\"model\": \"auto\", \"base_url\": \"http://127.0.0.1:1/v1\", \"history_file\": \"/tmp/h\", \"max_code_bytes\": 1000, \"temperature\": \"hot\", \"max_tokens\": 100, \"context_window\": 4096, \"system_prompt\": \"s\"}"
    fs.write_str(CFGBASE + "/str_temp.json", json)
    chat.Config()
}

@should_panic
func test_config_root_not_object_panics() {
    _fresh()
    os.setenv("CHAT_CONFIG", CFGBASE + "/array.json")
    fs.write_str(CFGBASE + "/array.json", "[1, 2, 3]")
    chat.Config()
}
