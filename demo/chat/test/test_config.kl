// Config (config.kl): every required field, the two numeric spellings of
// `temperature`, resolve_key's environment path, and the panic diagnostics
// for a missing field, a non-object root and a wrong-typed number.

import "std/ut"
import "std/fs"
import "std/os"
import "demo/chat"

const CFGBASE = "/tmp/koala_chat_cfgtest"

func _fresh() {
    fs.remove_all(CFGBASE)
    fs.mkdir(CFGBASE)
}

/// A complete config.json with `omit` (one key name, or "") left out.
func _json(omit str) str {
    var s = "{"
    var first = true
    let pairs = ["model", "\"auto\"", "base_url", "\"http://127.0.0.1:1/v1\"",
                 "history_file", "\"/tmp/koala_chat_cfgtest/history\"",
                 "max_code_bytes", "1000", "temperature", "0.5",
                 "max_tokens", "100", "context_window", "4096",
                 "system_prompt", "\"s\""]
    var i = 0
    while i < pairs.len() {
        let key = pairs[i]
        let val = pairs[i + 1]
        if key != omit {
            if !first { s += ", " }
            s += "\"" + key + "\": " + val
            first = false
        }
        i += 2
    }
    return s + "}"
}

/// Write `json` to `file` and build a Config from it via $CHAT_CONFIG.
func _config_of(file str, json str) chat.Config {
    fs.write_str(file, json)
    os.setenv("CHAT_CONFIG", file)
    let cfg = chat.Config()
    os.unsetenv("CHAT_CONFIG")
    return cfg
}

@test
func test_resolve_key_from_env() {
    os.setenv("OPENAI_COMPAT_API_KEY", "sk-from-env-123")
    ut.assert_true(chat.resolve_key() == "sk-from-env-123")
    os.unsetenv("OPENAI_COMPAT_API_KEY")
}

@test
func test_config_all_fields() {
    _fresh()
    let cfg = _config_of(CFGBASE + "/ok.json", _json(""))
    ut.assert_true(cfg.model == "auto")
    ut.assert_true(cfg.base_url == "http://127.0.0.1:1/v1")
    ut.assert_true(cfg.history_file == "/tmp/koala_chat_cfgtest/history")
    ut.assert_eq(cfg.max_code_bytes, 1000)
    ut.assert_float_close(cfg.temperature, 0.5, 0.0001)
    ut.assert_eq(cfg.max_tokens, 100)
    ut.assert_eq(cfg.context_window, 4096)
    ut.assert_true(cfg.system_prompt == "s")
    ut.assert_eq(cfg.no_access_dirs.len(), 0)
    ut.assert_eq(cfg.stream_delay_ms, 40)
}

@test
func test_config_stream_delay_ms() {
    _fresh()
    // an explicit value overrides the 40 ms default
    let json = "{\"model\": \"auto\", \"base_url\": \"http://127.0.0.1:1/v1\", \"history_file\": \"/tmp/h\", \"max_code_bytes\": 1000, \"temperature\": 0.5, \"max_tokens\": 100, \"context_window\": 4096, \"system_prompt\": \"s\", \"stream_delay_ms\": 120}"
    let cfg = _config_of(CFGBASE + "/delay.json", json)
    ut.assert_eq(cfg.stream_delay_ms, 120)
    // 0 disables the pause
    let json0 = "{\"model\": \"auto\", \"base_url\": \"http://127.0.0.1:1/v1\", \"history_file\": \"/tmp/h\", \"max_code_bytes\": 1000, \"temperature\": 0.5, \"max_tokens\": 100, \"context_window\": 4096, \"system_prompt\": \"s\", \"stream_delay_ms\": 0}"
    let cfg0 = _config_of(CFGBASE + "/delay0.json", json0)
    ut.assert_eq(cfg0.stream_delay_ms, 0)
}

@test
func test_config_explicit_path_wins_over_env() {
    _fresh()
    // $CHAT_CONFIG points at one file, the --config path at another: the
    // explicit path wins
    fs.write_str(CFGBASE + "/flag.json", "{\"model\": \"flagmodel\", \"base_url\": \"http://127.0.0.1:1/v1\", \"history_file\": \"/tmp/h\", \"max_code_bytes\": 1000, \"temperature\": 0.5, \"max_tokens\": 100, \"context_window\": 4096, \"system_prompt\": \"s\"}")
    fs.write_str(CFGBASE + "/env.json", "{\"model\": \"envmodel\", \"base_url\": \"http://127.0.0.1:1/v1\", \"history_file\": \"/tmp/h\", \"max_code_bytes\": 1000, \"temperature\": 0.5, \"max_tokens\": 100, \"context_window\": 4096, \"system_prompt\": \"s\"}")
    os.setenv("CHAT_CONFIG", CFGBASE + "/env.json")
    let cfg = chat.Config(CFGBASE + "/flag.json")
    ut.assert_true(cfg.model == "flagmodel")
    // an empty path falls back to the environment variable
    let cfg2 = chat.Config("")
    ut.assert_true(cfg2.model == "envmodel")
    os.unsetenv("CHAT_CONFIG")
}

@test
func test_config_temperature_integer() {
    _fresh()
    // an integer spelling of the numeric field is accepted
    let json = "{\"model\": \"auto\", \"base_url\": \"http://127.0.0.1:1/v1\", \"history_file\": \"/tmp/h\", \"max_code_bytes\": 1000, \"temperature\": 1, \"max_tokens\": 100, \"context_window\": 4096, \"system_prompt\": \"s\"}"
    let cfg = _config_of(CFGBASE + "/int.json", json)
    ut.assert_float_close(cfg.temperature, 1.0, 0.0001)
}

@should_panic("config.json missing required field: model")
func test_config_missing_model_panics() {
    _fresh()
    os.setenv("CHAT_CONFIG", CFGBASE + "/no_model.json")
    fs.write_str(CFGBASE + "/no_model.json", _json("model"))
    chat.Config()
}

