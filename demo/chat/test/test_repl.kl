// The REPL's pure helpers (repl.kl): blank-line detection, the narrow
// prompt, `~` expansion, slash-command names/help, and the file/dir
// completion matchers. The TUI and the command loop itself are covered by
// the pty E2E tests.

import "std/ut"
import "std/fs"
import "std/os"
import "koala/readline"
import "demo/chat"

const RBASE = "/tmp/koala_chat_repltest"

@test
func test_is_blank() {
    ut.assert_true(chat.is_blank(""))
    ut.assert_true(chat.is_blank("   "))
    ut.assert_true(chat.is_blank("\t\t"))
    ut.assert_false(chat.is_blank("a"))
    ut.assert_false(chat.is_blank("a "))
    ut.assert_false(chat.is_blank(" a"))
    ut.assert_false(chat.is_blank("\n"))
}

@test
func test_prompt_is_narrow() {
    // the mode lives in the status row now; the tty form only wraps `> `
    ut.assert_true("> " in chat.prompt())
    ut.assert_false("[chat]" in chat.prompt())
    ut.assert_false("you>" in chat.prompt())
}

@test
func test_command_name_and_known() {
    ut.assert_eq(chat.command_name("/quit"), "/quit")
    ut.assert_eq(chat.command_name("  /model gpt  "), "/model")
    ut.assert_eq(chat.command_name("/agent\tfix it"), "/agent")
    ut.assert_true(chat.is_known_command("/help"))
    ut.assert_true(chat.is_known_command("/switch 1"))
    ut.assert_false(chat.is_known_command("/nope"))
    ut.assert_eq(chat.unknown_command("/nope arg"),
                 "(unknown command: /nope; /help lists commands)")
    // a known command with extra arguments is a usage error, not unknown
    ut.assert_eq(chat.unknown_command("/quit now"),
                 "(usage error: /quit; /help lists usage)")
}

@test
func test_help_lines_cover_commands() {
    let lines = chat.help_lines()
    ut.assert_true(lines.len() > 10)
    var joined = ""
    for line in lines {
        joined += line + "\n"
        // 80 columns minus the two transcript border columns
        ut.assert_true(readline.width(line) <= 78)
        ut.assert_false("\x1b" in line)
    }
    ut.assert_true("Commands" in lines)
    ut.assert_true("Shortcuts" in lines)
    ut.assert_true("/help" in joined)
    ut.assert_true("/switch" in joined)
    ut.assert_true("Ctrl-J" in joined)
    ut.assert_true("Ctrl-O" in joined)
    // every completable command also appears in the help text
    let names = chat.command_names()
    for name in names {
        ut.assert_true(name in joined)
    }
    var i = 0
    while i < names.len() {
        // index() is the first occurrence, so a duplicate is caught here
        ut.assert_eq(names.index(names[i]), i)
        i += 1
    }
}

@test
func test_permission_commands_are_registered() {
    let names = chat.command_names()
    ut.assert_true("/permissions" in names)
    ut.assert_true("/plan" in names)
    ut.assert_true("/permissions" in chat.command_matches("/perm"))
    ut.assert_true(chat.is_known_command("/permissions plan"))
    ut.assert_true(chat.is_known_command("/plan off"))
}

@test
func test_permission_lines() {
    let none = list[str]()
    let rows = chat.permission_lines("plan", none, none, none)
    var joined = ""
    for l in rows {
        joined += l + "\n"
        ut.assert_true(readline.width(l) <= 78)
        ut.assert_false("\x1b" in l)
    }
    ut.assert_eq(rows[0], "permission mode: plan")
    // every mode is listed, the current one is marked
    ut.assert_true("* plan" in joined)
    ut.assert_true("accept_edits" in joined)
    ut.assert_true("bypass" in joined)
    ut.assert_true("(none)" in joined)
    ut.assert_true("/plan off" in joined)

    // the config rules are echoed as given
    let allow = list[str]()
    allow.append("Read")
    let deny = list[str]()
    deny.append("Bash")
    let prefixes = list[str]()
    prefixes.append("rm")
    let cfg_rows = chat.permission_lines("default", allow, deny, prefixes)
    var text = ""
    for l in cfg_rows { text += l + "\n" }
    ut.assert_true("allow_tools: Read" in text)
    ut.assert_true("deny_tools: Bash" in text)
    ut.assert_true("bash deny prefixes: rm" in text)
}

@test
func test_session_commands_are_registered() {
    let names = chat.command_names()
    ut.assert_true("/switch" in names)
    ut.assert_true("/pause" in names)
    ut.assert_true("/unpause" in names)
    ut.assert_true("/resume" in names)
    ut.assert_true(chat.is_known_command("/resume 2"))
    ut.assert_true(chat.is_known_command("/unpause work"))
    // /unpause has its own entry, so /pause is not its prefix
    ut.assert_eq(chat.command_info("/unpause")!.desc, "resume automatic compaction")
    ut.assert_true("saved session" in chat.command_info("/resume")!.desc)
}

@test
func test_command_matches_are_fuzzy() {
    // An empty filter offers every command, in completion order.
    let all = chat.command_matches("/")
    let names = chat.command_names()
    ut.assert_eq(all.len(), names.len())
    for i in range(names.len()) { ut.assert_eq(all[i], names[i]) }
    // Subsequence filtering: /se matches sessions, pause, unpause and resume.
    let se = chat.command_matches("/se")
    ut.assert_true("/sessions" in se)
    ut.assert_true("/pause" in se)
    ut.assert_true("/resume" in se)
    ut.assert_false("/switch" in se)
    // /mdl matches both model commands.
    let mdl = chat.command_matches("/mdl")
    ut.assert_true("/model" in mdl)
    ut.assert_true("/models" in mdl)
    // Ordinary words and no-match filters open no panel.
    ut.assert_eq(chat.command_matches("model").len(), 0)
    ut.assert_eq(chat.command_matches("/zzz").len(), 0)
}

@test
func test_command_panel_groups_and_fits() {
    let matches = chat.command_matches("/se")
    let lines = chat.command_panel_lines(matches, 40, true)
    // Group headers come from the metadata, in first-seen order.
    ut.assert_true("Conversation" in lines)
    ut.assert_true("Sessions" in lines)
    ut.assert_false("Model" in lines)
    for line in lines {
        ut.assert_true(readline.width(line) <= 40)
        ut.assert_false("\x1b" in line)
    }
    // Every matched command appears somewhere in the panel.
    var joined = ""
    for line in lines { joined += line + "\n" }
    for name in matches { ut.assert_true(name in joined) }
    // A very narrow panel still fits; descriptions are dropped first.
    for cols in [8, 9, 12, 13, 20] {
        for line in chat.command_panel_lines(matches, cols, true) {
            ut.assert_true(readline.width(line) <= cols)
        }
    }
    ut.assert_eq(chat.command_panel_lines(list[str](), 40, true).len(), 0)
}

@test
func test_command_panel_golden() {
    // A fixed snapshot: group header, aligned label column, description.
    let lines = chat.command_panel_lines(["/help", "/quit"], 40, true)
    ut.assert_eq(lines.len(), 3)
    ut.assert_eq(lines[0], "Conversation")
    ut.assert_eq(lines[1], "  /help   show this help")
    ut.assert_eq(lines[2], "  /quit   leave (Ctrl-D also leaves)")

    // At 40 columns the longest description is cut and marked, never wrapped.
    let ctx = chat.command_panel_lines(["/context"], 40, true)
    ut.assert_eq(ctx.len(), 2)
    ut.assert_eq(ctx[1], "  /context   show context window and ...")
    ut.assert_eq(readline.width(ctx[1]), 40)
}

@test
func test_expand_tilde() {
    if let home = os.getenv("HOME") {
        ut.assert_true(chat.expand("~/x") == home + "/x")
        ut.assert_true(chat.expand("~") == home)
        ut.assert_true(chat.expand("~/a/b") == home + "/a/b")
    }
    // non-tilde paths pass through untouched
    ut.assert_true(chat.expand("plain") == "plain")
    ut.assert_true(chat.expand("/abs/path") == "/abs/path")
}

/// A fresh completion tree: aa.txt, ab.txt, z.txt and sub/aa.txt.
func _tree() str {
    fs.remove_all(RBASE)
    fs.mkdir(RBASE)
    fs.mkdir(RBASE + "/files")
    fs.mkdir(RBASE + "/files/sub")
    fs.write_str(RBASE + "/files/aa.txt", "a")
    fs.write_str(RBASE + "/files/ab.txt", "b")
    fs.write_str(RBASE + "/files/z.txt", "z")
    fs.write_str(RBASE + "/files/sub/aa.txt", "s")
    return RBASE
}

@test
func test_file_matches_prefix() {
    let b = _tree()
    let m = chat.file_matches(b + "/files/a")
    ut.assert_eq(m.len(), 2)
    ut.assert_true((b + "/files/aa.txt") in m)
    ut.assert_true((b + "/files/ab.txt") in m)
}

@test
func test_file_matches_no_prefix() {
    let b = _tree()
    // a trailing slash completes everything in the directory
    let m = chat.file_matches(b + "/files/")
    ut.assert_eq(m.len(), 4)
    ut.assert_true((b + "/files/sub") in m)
}

@test
func test_file_matches_nothing() {
    let b = _tree()
    ut.assert_eq(chat.file_matches(b + "/files/zz").len(), 0)
}

@test
func test_file_matches_missing_dir() {
    let b = _tree()
    ut.assert_eq(chat.file_matches(b + "/missing/a").len(), 0)
}

@test
func test_at_matches_keep_prefix() {
    let b = _tree()
    let m = chat.at_matches("@" + b + "/files/a")
    ut.assert_eq(m.len(), 2)
    ut.assert_true(("@" + b + "/files/aa.txt") in m)
    ut.assert_true(("@" + b + "/files/ab.txt") in m)
    // the @ is optional on input, but every candidate carries it
    let n = chat.at_matches("@" + b + "/files/")
    ut.assert_eq(n.len(), 4)
    for candidate in n {
        ut.assert_true(candidate.starts_with("@"))
    }
    ut.assert_eq(chat.at_matches(b + "/files/a").len(), 2)
}

@test
func test_dir_matches_filters_files() {
    let b = _tree()
    let m = chat.dir_matches(b + "/files/")
    ut.assert_eq(m.len(), 1)
    ut.assert_true((b + "/files/sub") in m)
    // prefix matches that are files only are dropped entirely
    ut.assert_eq(chat.dir_matches(b + "/files/a").len(), 0)
}
