/*
 * demo/chat — configuration, loaded entirely from config.json.
 *
 * There are no built-in defaults: config.json (in the working directory,
 * or the file named by $CHAT_CONFIG, or the path given as --config PATH)
 * must exist and provide every field except `no_access_dirs`,
 * `stream_delay_ms`, `agent_max_steps`, `agent_tool_timeout_ms`,
 * `agent_max_tool_output_bytes`, `agent_permission_mode`,
 * `agent_allow_tools`, `agent_deny_tools` and `agent_bash_deny`, which are
 * optional: an absent `no_access_dirs` is empty, an absent
 * `stream_delay_ms` is 40, an absent `agent_max_steps` is 100, an absent
 * `agent_tool_timeout_ms` is 120000, an absent
 * `agent_max_tool_output_bytes` is 32000, an absent
 * `agent_permission_mode` is `default`, and the three tool lists are empty.
 * An unrecognised mode name is a fatal error. Precedence: the
 * --config path, then $CHAT_CONFIG, then config.json in the working
 * directory.
 * The API key is deliberately NOT config — see resolve_key().
 */

import "std/fs"
import "std/os"
import "koala/readline"
from "koala/json" import try_parse_file, Object, Float, Integer, Array, String

/// Runtime configuration. Every field is required and comes from
/// config.json; a missing file or field is a fatal error.
pub class Config {
    pub let model str
    pub let base_url str
    pub let history_file str
    pub let max_code_bytes int
    pub let temperature float
    pub let max_tokens int
    pub let context_window int
    pub let system_prompt str
    /// Directories the agent may not access, each relative to the agent's
    /// work directory or absolute. Optional; empty when the field is absent.
    pub let no_access_dirs list[str]
    /// Milliseconds to pause between streamed reply lines, so the
    /// line-by-line effect is visible to the eye. Optional; 40 when the
    /// field is absent; 0 disables the pause.
    pub let stream_delay_ms int
    /// The agent loop's model->tool round cap. Optional; 100 when the
    /// field is absent. A cap is a safety net: hitting it says so and
    /// /continue resumes with the context intact.
    pub let agent_max_steps int
    /// Milliseconds a Bash tool call may run before it is killed. Optional;
    /// 120000 (two minutes) when the field is absent.
    pub let agent_tool_timeout_ms int
    /// Bytes kept per output stream (stdout, stderr) of a Bash tool call;
    /// the rest goes to a temp log named in the result. Optional; 32000
    /// when the field is absent. Read/Edit/Glob/Grep use it as their output
    /// budget too.
    pub let agent_max_tool_output_bytes int
    /// The tool permission mode: `default` (read-only runs, changes ask),
    /// `accept_edits` (write/edit run, shell asks), `plan` (read-only only)
    /// or `bypass` (everything runs). Optional; `default` when the field is
    /// absent. Switchable at runtime with /permissions.
    pub let agent_permission_mode str
    /// Tool names that skip the approval question, e.g. ["Read", "Grep"].
    /// Optional; empty when absent. Plan mode still caps them at read-only.
    pub let agent_allow_tools list[str]
    /// Tool names that are always refused, in every mode (even `bypass`).
    /// Optional; empty when absent.
    pub let agent_deny_tools list[str]
    /// Shell command prefixes that are always refused, e.g. ["rm", "sudo"].
    /// Optional; empty when absent. A prefix match on the stripped command —
    /// a guardrail, not a sandbox: `x && rm -rf /` does not start with `rm`.
    pub let agent_bash_deny list[str]

    /// Build the configuration. `path` names the config file explicitly
    /// (the --config command-line option); nil (or "") falls back to
    /// $CHAT_CONFIG, then config.json in the working directory.
    pub func __init__(path str? = nil) {
        let obj = _load_object(path)
        model = _str(obj, "model")
        base_url = _str(obj, "base_url")
        history_file = _str(obj, "history_file")
        max_code_bytes = _int(obj, "max_code_bytes")
        temperature = _float(obj, "temperature")
        max_tokens = _int(obj, "max_tokens")
        context_window = _int(obj, "context_window")
        system_prompt = _str(obj, "system_prompt")
        no_access_dirs = _strs(obj, "no_access_dirs")
        stream_delay_ms = _opt_int(obj, "stream_delay_ms", 40)
        agent_max_steps = _opt_int(obj, "agent_max_steps", 100)
        agent_tool_timeout_ms = _opt_int(obj, "agent_tool_timeout_ms", 120_000)
        agent_max_tool_output_bytes = _opt_int(obj, "agent_max_tool_output_bytes", 32_000)
        let mode = normalize_permission_mode(_opt_str(obj, "agent_permission_mode", PERM_DEFAULT))
        if mode == "" {
            panic("config field 'agent_permission_mode' must be one of: " + permission_modes_text())
        }
        agent_permission_mode = mode
        agent_allow_tools = _strs(obj, "agent_allow_tools")
        agent_deny_tools = _strs(obj, "agent_deny_tools")
        agent_bash_deny = _strs(obj, "agent_bash_deny")
    }
}

/// The API key: $OPENAI_COMPAT_API_KEY when set, otherwise prompt once at
/// startup, without echoing what is typed. The key is never stored in code
/// or config.json, and never enters the readline history.
pub func resolve_key() str {
    if let k = os.getenv("OPENAI_COMPAT_API_KEY") { return k }
    let entered = readline.password("API key: ")
    if let k = entered {
        if k != "" { return k }
    }
    panic("no API key: set $OPENAI_COMPAT_API_KEY or enter it at startup")
}

/// The config file path: the explicit `--config` path when given, else
/// $CHAT_CONFIG, else config.json in the working dir.
func _config_path(path str?) str {
    if path != nil && path! != "" { return path! }
    if let p = os.getenv("CHAT_CONFIG") { return p }
    return "config.json"
}

/// Load the config file as a JSON object. Fatal when missing or not an object.
func _load_object(path str?) Object {
    let p = _config_path(path)
    if !fs.is_file(p) {
        panic("config file not found: " + p + " (create config.json or set $CHAT_CONFIG)")
    }
    let root = try_parse_file(p)
    if root == nil {
        panic("config file is not valid JSON: " + p)
    }
    let v = root
    if v is Object { return v }
    panic("config file must contain a JSON object: " + p)
}

/// A required string field.
func _str(obj Object, key str) str {
    if key in obj { return obj.get_str(key) }
    panic("config.json missing required field: " + key)
}

/// A required integer field.
func _int(obj Object, key str) int {
    if key in obj { return obj.get_int(key) }
    panic("config.json missing required field: " + key)
}

/// An optional integer field, `def` when absent.
func _opt_int(obj Object, key str, def int) int {
    if key in obj { return obj.get_int(key) }
    return def
}

/// An optional string field, `def` when absent or not a string.
func _opt_str(obj Object, key str, def str) str {
    if key in obj {
        let v = obj.get(key)!
        if v is String { return v.value }
    }
    return def
}

/// A required numeric field as a float; accepts JSON floats (0.7) and
/// integers (1) so either spelling works.
func _float(obj Object, key str) float {
    if key in obj {
        let v = obj.get(key)!
        if v is Float { return v.value }
        if v is Integer { return float(v.value) }
        panic("config field '" + key + "' must be a number")
    }
    panic("config.json missing required field: " + key)
}

/// An optional list-of-strings field; empty when absent or not an array.
/// Non-string and empty-string elements are ignored.
func _strs(obj Object, key str) list[str] {
    let out = list[str]()
    if key in obj {
        let v = obj.get(key)!
        if v is Array {
            for e in v.value {
                if e is String {
                    if e.value != "" { out.append(e.value) }
                }
            }
        }
    }
    return out
}

/// True when `path` is inside one of `dirs` — the no-access directories,
/// each relative to `workdir` (or absolute). `.`, `..`, `~` and symlinks
/// are resolved against the disk, so an alias of a blocked directory is
/// blocked too. A blocked `/` blocks everything.
pub func path_blocked(path str, workdir str, dirs list[str]) bool {
    if dirs.len() == 0 { return false }
    let target = _canonical(path)
    if target == nil { return false }
    for d in dirs {
        if d == "" { continue }
        var entry = d
        if !fs.Path(d).is_absolute() { entry = workdir + "/" + d }
        if let b = _canonical(entry) {
            if b == "/" || target == b || target.starts_with(b + "/") { return true }
        }
    }
    return false
}

/// The nearest existing ancestor of `path`, resolved against the disk with
/// links followed, plus the missing tail; nil when nothing up to the root
/// exists. Parents are cut with `substr`, never `Path.parent`: a view
/// shares its source string's storage (by design), so the fs natives'
/// C side reads the full source buffer, not the view.
func _canonical(path str) str? {
    var p = fs.Path(path).expand_user().absolute().normalize().to_str()
    var tail = ""
    loop {
        if let r = fs.real_path(p) {
            return r.to_str() + tail
        }
        let idx = p.rindex("/")
        if idx < 0 { return nil }
        tail = "/" + p.substr(idx + 1) + tail
        p = p.substr(0, idx)
        if p.len() == 0 { p = "/" }
    }
}