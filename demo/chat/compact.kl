/*
 * demo/chat — context compaction.
 *
 * The model is stateless: every call re-sends the whole message list, which
 * grows until it hits the context window. Compaction summarizes the older
 * history with a separate model call and replaces it with the summary,
 * keeping the system message and the most recent turns. For the agent it
 * runs as a pre-request guard (compact_before_request): the last request's
 * actual prompt tokens plus whatever its tool results appended, then a
 * turn-group-safe summary, then a truncation of any oversized tool result
 * that still would not fit. Chat mode compacts after a request
 * (maybe_compact); /compact runs compact_now or compact_rich_now on demand.
 * A failed or empty summary is reported and the history is left untouched.
 */

import "koala/openai" as openai

/// Compact when prompt tokens reach this percent of the context window.
const COMPACT_PERCENT = 80

/// How many recent messages to keep verbatim after compaction.
const KEEP_RECENT = 4

/// What the summary must keep, so a compacted agent can carry on: the task,
/// the files it touched, what it ran and what failed, what is left.
const SUMMARIZE_PROMPT = "You summarize an ongoing coding session so it can continue after the older turns are dropped. Keep, in short bullet form: (1) the current task and goal, (2) files created or changed, with their paths, (3) key commands run and the important errors they produced, (4) what remains unfinished. Preserve exact paths, identifiers and error text. Output only the summary, no preamble."

/// Auto-compaction: if the last request used at least COMPACT_PERCENT of
/// the context window, summarize the older history. Mutates `messages` and
/// returns the estimated prompt size after compaction, or nil when nothing
/// was compacted. A failed summary is reported, never swapped in empty.
pub func maybe_compact(client openai.Client, model str, cfg Config, messages list[dict[str, str]], prompt_tokens int) int? {
    let limit = cfg.context_window * COMPACT_PERCENT / 100
    if prompt_tokens < limit { return nil }
    if !can_compact(messages) { return nil }
    show_busy("Compacting")
    let compacted = _compact(client, model, cfg, messages)
    hide_busy()
    if !compacted {
        emit(error_event("compaction failed: no usable summary; keeping the full history", plain_mode()))
        return nil
    }
    let after = estimate_tokens(messages)
    emit(compact_note(prompt_tokens, after, plain_mode()))
    return after
}

/// True when chat-mode history has older turns worth summarizing.
pub func can_compact(messages list[dict[str, str]]) bool {
    return messages.len() > KEEP_RECENT + 2
}

/// Manual compaction (the /compact command), regardless of token usage.
/// `before_tokens` is the last request's actual prompt size when known; zero
/// falls back to an estimate. Returns the estimated size after compaction,
/// or nil when nothing was compacted or the summary failed.
pub func compact_now(client openai.Client, model str, cfg Config, messages list[dict[str, str]], before_tokens = 0) int? {
    if !can_compact(messages) {
        emit(notice("(nothing to compact)", plain_mode()))
        return nil
    }
    var before = before_tokens
    if before <= 0 { before = estimate_tokens(messages) }
    show_busy("Compacting")
    let compacted = _compact(client, model, cfg, messages)
    hide_busy()
    if !compacted {
        emit(error_event("compaction failed: no usable summary; keeping the full history", plain_mode()))
        return nil
    }
    let after = estimate_tokens(messages)
    emit(compact_note(before, after, plain_mode()))
    return after
}

/// Approximate the prompt tokens for `messages`: about four UTF-8 bytes per
/// token plus a few tokens of per-message overhead. A `name` field (the
/// tool a message belongs to) counts too. The compaction note uses it (the
/// next model request replaces it with actual usage).
pub func estimate_tokens(messages list[dict[str, str]]) int {
    var total = 0
    for m in messages {
        var size = m["content"].len()
        if "name" in m { size += m["name"].len() }
        total += (size + 3) / 4 + 4
    }
    return total
}

/// Summarize the older messages and replace them with the summary, keeping
/// the system message and the most recent KEEP_RECENT messages. Mutates
/// `messages` in place; true if compacted, false if too short or on failure.
func _compact(client openai.Client, model str, cfg Config, messages list[dict[str, str]]) bool {
    if !can_compact(messages) { return false }

    // The older history to summarize: everything between the system message
    // and the most recent KEEP_RECENT messages.
    let old = list[dict[str, str]]()
    var i = 1
    while i < messages.len() - KEEP_RECENT {
        old.append(messages[i])
        i += 1
    }
    let summary = _summarize(client, model, cfg, old)
    if summary == nil { return false }

    let recent = list[dict[str, str]]()
    var j = messages.len() - KEEP_RECENT
    while j < messages.len() {
        recent.append(messages[j])
        j += 1
    }
    let system = messages[0]
    messages.clear()
    messages.append(system)
    messages.append({"role": "user", "content": "[Summary of the earlier conversation]\n" + summary})
    for m in recent { messages.append(m) }
    return true
}

/// Ask the model to summarize `old` messages; nil on failure.
func _summarize(client openai.Client, model str, cfg Config, old list[dict[str, str]]) str? {
    var transcript = ""
    for m in old {
        transcript += m["role"] + ": " + m["content"] + "\n\n"
    }
    let req = list[dict[str, str]]()
    req.append({"role": "system", "content": SUMMARIZE_PROMPT})
    req.append({"role": "user", "content": "Summarize this conversation:\n\n" + transcript})
    let resp = client.chat.completions.create(model, req, cfg.temperature, cfg.max_tokens)
    if !resp.ok() { return nil }
    if resp.choices.len() == 0 { return nil }
    let text = resp.choices[0].message.content
    // an empty summary would silently wipe the history: treat it as failure
    if text.strip() == "" { return nil }
    return text
}

// ---- rich messages (agent mode): text, tool calls and tool results ----

/// Approximate the prompt tokens of one rich message: its text, the tool
/// name and result id it carries, and every tool call's name and arguments —
/// a Bash observation is often the largest part of a request.
pub func estimate_rich_message_tokens(m openai.CompletionMessage) int {
    var size = m.content.len() + m.tool_call_id.len() + m.name.len()
    for call in m.tool_calls {
        size += call.name().len() + call.arguments().len()
    }
    return (size + 3) / 4 + 4
}

/// Approximate the prompt tokens of rich messages.
pub func estimate_rich_tokens(messages list[openai.CompletionMessage]) int {
    return estimate_rich_tokens_from(messages, 0)
}

/// The same estimate for the messages at `start` and after: what a request
/// adds on top of the last one's actual prompt usage.
pub func estimate_rich_tokens_from(messages list[openai.CompletionMessage], start int) int {
    var i = start
    if i < 0 { i = 0 }
    var total = 0
    while i < messages.len() {
        total += estimate_rich_message_tokens(messages[i])
        i += 1
    }
    return total
}

/// The pre-request guard for a rich conversation: when the last request's
/// actual usage plus the messages appended since then reaches the
/// threshold, summarize the older turns (never splitting a turn from its
/// tool results) and then truncate any oversized tool result still left in
/// the recent turns — a single 32 KB Bash observation can fill a whole
/// window on its own, and summarizing cannot drop it while it is recent.
/// Returns the estimate the next request will use, or nil when nothing
/// changed. A failed summary is reported, never swapped in empty.
pub func compact_before_request(client openai.Client, model str, cfg Config, messages list[openai.CompletionMessage], prompt_tokens int, sent_len int) int? {
    let limit = cfg.context_window * COMPACT_PERCENT / 100
    var estimate = prompt_tokens + estimate_rich_tokens_from(messages, sent_len)
    if estimate < limit { return nil }
    var changed = false
    if can_compact_rich(messages) {
        show_busy("Compacting")
        let compacted = _compact_rich(client, model, cfg, messages)
        hide_busy()
        if compacted {
            changed = true
            estimate = estimate_rich_tokens(messages)
            emit(compact_note(prompt_tokens, estimate, plain_mode()))
        } else {
            emit(error_event("compaction failed: no usable summary; keeping the full history", plain_mode()))
        }
    }
    if estimate >= limit {
        if let shrunk = shrink_tool_results(cfg, messages) {
            changed = true
            estimate = shrunk
        }
    }
    if !changed { return nil }
    return estimate
}

/// True when a rich conversation has older turns worth summarizing and a
/// split point that keeps every tool turn with its results.
pub func can_compact_rich(messages list[openai.CompletionMessage]) bool {
    if messages.len() <= KEEP_RECENT + 2 { return false }
    return rich_split_index(messages) > 1
}

/// Truncate oversized `tool` results in place until the estimate fits the
/// threshold, with progressively smaller budgets. Only content changes, so
/// the message sequence stays protocol-valid. Returns the estimate after,
/// or nil when nothing was trimmed.
pub func shrink_tool_results(cfg Config, messages list[openai.CompletionMessage]) int? {
    let limit = cfg.context_window * COMPACT_PERCENT / 100
    if estimate_rich_tokens(messages) < limit { return nil }
    var changed = false
    var budget = 4000
    while budget >= 100 {
        var i = 0
        while i < messages.len() {
            let m = messages[i]
            if m.role == "tool" && m.content.len() > budget {
                messages[i] = openai.tool_msg(m.tool_call_id, truncate_middle(m.content, budget))
                changed = true
            }
            i += 1
        }
        if estimate_rich_tokens(messages) < limit { break }
        budget = budget / 3
    }
    if !changed { return nil }
    emit(notice("(large tool output truncated to fit the context window)", plain_mode()))
    return estimate_rich_tokens(messages)
}

/// `s` cut to about `budget` bytes, keeping the head and the tail, with a
/// marker that says how much was dropped.
pub func truncate_middle(s str, budget int) str {
    var cap = budget
    if cap < 20 { cap = 20 }
    if s.len() <= cap { return s }
    let head = cap * 2 / 3
    let tail = cap - head
    let dropped = s.len() - head - tail
    return s.substr(0, head) + "\n... (" + str(dropped) + " bytes omitted) ...\n" + s.substr(s.len() - tail)
}

/// Manual compaction of a rich conversation (/compact in agent mode).
pub func compact_rich_now(client openai.Client, model str, cfg Config, messages list[openai.CompletionMessage], before_tokens = 0) int? {
    if !can_compact_rich(messages) {
        emit(notice("(nothing to compact)", plain_mode()))
        return nil
    }
    var before = before_tokens
    if before <= 0 { before = estimate_rich_tokens(messages) }
    show_busy("Compacting")
    let compacted = _compact_rich(client, model, cfg, messages)
    hide_busy()
    if !compacted {
        emit(error_event("compaction failed: no usable summary; keeping the full history", plain_mode()))
        return nil
    }
    let after = estimate_rich_tokens(messages)
    emit(compact_note(before, after, plain_mode()))
    return after
}

/// The first message kept verbatim: the last KEEP_RECENT messages, moved
/// back so a `tool` result is never separated from the assistant turn that
/// asked for it (the split never lands inside a tool round).
pub func rich_split_index(messages list[openai.CompletionMessage]) int {
    var idx = messages.len() - KEEP_RECENT
    if idx < 1 { return 1 }
    while idx > 1 && messages[idx].role == "tool" { idx -= 1 }
    return idx
}

/// Summarize the older rich messages and replace them with the summary,
/// keeping the system message and the recent messages intact.
func _compact_rich(client openai.Client, model str, cfg Config, messages list[openai.CompletionMessage]) bool {
    if !can_compact_rich(messages) { return false }
    let idx = rich_split_index(messages)
    if idx <= 1 { return false }

    let old = list[openai.CompletionMessage]()
    var i = 1
    while i < idx {
        old.append(messages[i])
        i += 1
    }
    let summary = _summarize_rich(client, model, cfg, old)
    if summary == nil { return false }

    let recent = list[openai.CompletionMessage]()
    var j = idx
    while j < messages.len() {
        recent.append(messages[j])
        j += 1
    }
    let system = messages[0]
    messages.clear()
    messages.append(system)
    messages.append(openai.user_msg("[Summary of the earlier conversation]\n" + summary))
    for m in recent { messages.append(m) }
    return true
}

/// Ask the model to summarize rich messages; nil on failure. Tool calls and
/// results are spelled out so the summary keeps what was attempted.
func _summarize_rich(client openai.Client, model str, cfg Config, old list[openai.CompletionMessage]) str? {
    var transcript = ""
    for m in old {
        transcript += m.role + ": " + m.content
        for call in m.tool_calls {
            transcript += "\n  [tool call " + call.name() + " " + call.arguments() + "]"
        }
        if m.tool_call_id != "" {
            transcript += "\n  [tool result for " + m.tool_call_id + "]"
        }
        transcript += "\n\n"
    }
    let req = list[dict[str, str]]()
    req.append({"role": "system", "content": SUMMARIZE_PROMPT})
    req.append({"role": "user", "content": "Summarize this conversation:\n\n" + transcript})
    let resp = client.chat.completions.create(model, req, cfg.temperature, cfg.max_tokens)
    if !resp.ok() { return nil }
    if resp.choices.len() == 0 { return nil }
    let text = resp.choices[0].message.content
    // an empty summary would silently wipe the history: treat it as failure
    if text.strip() == "" { return nil }
    return text
}