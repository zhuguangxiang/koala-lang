/*
 * demo/chat — pure on-screen formatting for the transcript and events.
 *
 * Nothing here touches the terminal: the functions return strings/lines that
 * `repl.kl` writes through `tui.Screen`, and tests assert them directly.
 */

import "std/os"
import "koala/readline"

/// The glyphs of the agent-CLI transcript. They are plain Unicode on a
/// colour terminal; `plain_mode` selects ASCII for pipes, `NO_COLOR` and
/// `TERM=dumb`.
pub const GLYPH_TOOL = "⏺"
pub const GLYPH_RESULT = "⎿"
pub const GLYPH_OK = "✓"
pub const GLYPH_FAIL = "✗"
pub const GLYPH_BUSY = "✻"
pub const GLYPH_COMPACT = "↺"

// set by force_plain when the terminal is too small for the chat chrome
var _force_plain = false

/// True when output must be plain for the given terminal facts. Broken out
/// of `plain_mode` so the matrix is testable without a real terminal.
pub func plain_for(tty bool, no_color bool, term str?) bool {
    if !tty { return true }
    if no_color { return true }
    if term != nil && term! == "dumb" { return true }
    return false
}

/// True when output must stay plain: a pipe, `NO_COLOR` set, a dumb
/// terminal, or a terminal too small for the chrome (see `force_plain`).
pub func plain_mode() bool {
    if _force_plain { return true }
    return plain_for(os.isatty(1), os.getenv("NO_COLOR") != nil, os.getenv("TERM"))
}

/// Force plain output regardless of the terminal facts for the rest of the
/// process. The REPL uses it when the terminal is too small for the TUI
/// chrome; there is no way back to the layout in the same session.
pub func force_plain(on bool) {
    _force_plain = on
}

/// `text` without ANSI CSI escape sequences. Use it when a coloured
/// transcript is replayed on a plain terminal.
pub func strip_ansi(text str) str {
    let chars = list[str]()
    for c in text { chars.append(c) }
    var out = ""
    var i = 0
    let n = chars.len()
    while i < n {
        if chars[i] == "\x1b" && i + 1 < n && chars[i + 1] == "[" {
            i += 2
            while i < n && !_csi_final(chars[i]) { i += 1 }
            if i < n { i += 1 }
            continue
        }
        out += chars[i]
        i += 1
    }
    return out
}

func _csi_final(c str) bool {
    return c >= "@" && c <= "~"
}

/// Wrap every logical line to `width` display columns.
pub func wrap_lines(lines list[str], width int) list[str] {
    let out = list[str]()
    for line in lines {
        for part in readline.wrap_text(line, width) {
            out.append(part)
        }
    }
    return out
}

/// `text` cut from the left to at most `width` display columns, with a
/// marker showing that the start was dropped. Use it for paths in a status
/// row: the tail (the useful part) survives. With `plain`, the marker is
/// ASCII `...`.
pub func elide_left(text str, width int, plain = false) str {
    if width <= 0 { return "" }
    if readline.width(text) <= width { return text }
    var mark = "…"
    if plain { mark = "..." }
    let mark_width = readline.width(mark)
    if width <= mark_width { return readline.fit_text(text, width) }
    let chars = list[str]()
    for c in text { chars.append(c) }
    var out = ""
    var used = 0
    var i = chars.len() - 1
    while i >= 0 {
        let cw = readline.width(chars[i])
        if used + cw > width - mark_width { break }
        out = chars[i] + out
        used += cw
        i -= 1
    }
    return mark + out
}

/// `text` cut from the right to at most `width` display columns, with a
/// marker showing that the end was dropped. Use it for names in a table.
/// With `plain`, the marker is ASCII `...`.
pub func elide_right(text str, width int, plain = false) str {
    if width <= 0 { return "" }
    if readline.width(text) <= width { return text }
    var mark = "…"
    if plain { mark = "..." }
    let mark_width = readline.width(mark)
    if width <= mark_width { return readline.fit_text(text, width) }
    return readline.fit_text(text, width - mark_width).strip() + mark
}

/// The startup welcome card. `cols` is the transcript content width, so
/// every returned row already fits; `plain` swaps the emoji mascot and
/// separators for ASCII art, and a narrow terminal drops the box rather
/// than letting its borders wrap.
pub func startup_lines(model str, cols int, plain = false) list[str] {
    let out = list[str]()
    if cols <= 0 { return out }
    let greet = "Chat with " + model + "."
    var icon = "🐨"
    var title = icon + "  Koala Code Agent  🐾"
    var tip = "🍃 type / for commands, @ for files"
    var long_commands = "/help commands · /agent code · /chat ask · /quit leave"
    var short_commands = "/help · /agent · /chat · /quit"
    if plain {
        icon = "^._.^"
        title = icon + "  Koala Code Agent  *"
        tip = "type / for commands, @ for files"
        long_commands = "/help commands | /agent code | /chat ask | /quit leave"
        short_commands = "/help | /agent | /chat | /quit"
    }
    // Below this the card's borders cost more than they add.
    if cols < 30 {
        out.append(readline.fit_text(title, cols))
        var greeting = greet
        // the pty smoke test keys on the plain marker
        if plain { greeting += " |" }
        out.append(readline.fit_text(greeting, cols))
        out.append(readline.fit_text(icon + "  /help /agent /chat", cols))
        return out
    }
    var width = 62
    if cols < width { width = cols }
    let indent = (cols - width) / 2
    let margin = " " * indent
    let inner = width - 2
    var commands = long_commands
    if readline.width(commands) > inner { commands = short_commands }
    if readline.width(commands) > inner { commands = "/help /agent" }
    var tl = "╭"
    var tr = "╮"
    var bl = "╰"
    var br = "╯"
    var h = "─"
    var v = "│"
    if plain {
        tl = "+"
        tr = "+"
        bl = "+"
        br = "+"
        h = "-"
        v = "|"
    }
    out.append(margin + tl + h * inner + tr)
    out.append(margin + v + readline.fit_text("  " + title, inner) + v)
    var greeting = "  " + greet
    // the pty smoke test keys on the plain marker
    if plain { greeting += " |" }
    out.append(margin + v + readline.fit_text(greeting, inner) + v)
    out.append(margin + v + readline.fit_text("  " + commands, inner) + v)
    if readline.width("  " + tip) <= inner {
        out.append(margin + v + readline.fit_text("  " + tip, inner) + v)
    }
    out.append(margin + bl + h * inner + br)
    return out
}

/// The first display row of the tail window.
pub func max_top(lines list[str], height int) int {
    let m = lines.len() - height
    if m < 0 { return 0 }
    return m
}

/// The tail of a transient menu that fits in `height` rows. A menu taller
/// than the transcript shows its last rows, matching the transcript's
/// follow-the-tail behavior; an empty or non-positive height yields no rows.
pub func menu_rows(lines list[str], height int) list[str] {
    let out = list[str]()
    if height <= 0 { return out }
    var start = lines.len() - height
    if start < 0 { start = 0 }
    var i = start
    while i < lines.len() {
        out.append(lines[i])
        i += 1
    }
    return out
}

/// The visible slice of already-wrapped lines, oldest first.
pub func visible(lines list[str], height int, top int) list[str] {
    let out = list[str]()
    if height <= 0 { return out }
    var start = top
    let m = max_top(lines, height)
    if start > m { start = m }
    if start < 0 { start = 0 }
    var i = start
    while i < lines.len() && i < start + height {
        out.append(lines[i])
        i += 1
    }
    return out
}

/// A pure transcript frame: wrap `lines` to `cols`, show the window of
/// `rows` rows at `top` (tail when `top` is negative), and pad each row to
/// exactly `cols`. This is what `draw_transcript` should look like, without
/// a terminal.
pub func render(lines list[str], cols int, rows int, top int) list[str] {
    let wrapped = wrap_lines(lines, cols)
    var start = top
    if start < 0 { start = max_top(wrapped, rows) }
    let window = visible(wrapped, rows, start)
    let out = list[str]()
    for line in window {
        out.append(readline.pad_text(line, cols))
    }
    return out
}

/// The vertical rows of the chat chrome, all 1-based; 0 means that row is
/// absent. The transcript box is `trans_top`..`trans_bottom` around the
/// elastic content rows, the input box is `input_top`..`input_bottom` around
/// three content rows, and the hint and status rows sit below it.
pub class ChatRows {
    pub let status int
    pub let hint int
    pub let input_top int
    pub let input_bottom int
    pub let input_row int
    pub let input_height int
    pub let trans_top int
    pub let trans_bottom int
    pub let trans_row int
    pub let trans_height int

    pub func __init__(rows int, bar bool) {
        status = 0
        hint = 0
        var bottom = rows
        if bar {
            status = bottom
            bottom -= 1
            hint = bottom
            bottom -= 1
        }
        input_bottom = bottom
        bottom -= 1
        input_height = 3
        input_row = bottom - input_height + 1
        bottom -= input_height
        input_top = bottom
        bottom -= 1
        trans_bottom = bottom
        bottom -= 1
        trans_top = 1
        trans_row = trans_top + 1
        trans_height = bottom - trans_top
        if trans_height < 0 { trans_height = 0 }
    }
}

/// The first line of a tool action, before the tool runs. With `plain`, the
/// glyph degrades to `*` for pipes and dumb terminals.
pub func tool_start(step int, info str, plain = false) str {
    var g = GLYPH_TOOL
    if plain { g = "*" }
    return g + " " + info
}

/// The result line(s) of a tool action. A success is one compact line; a
/// failure keeps the tail of stderr (or stdout) and says how many lines were
/// omitted. `max_lines` is the tail size per stream; `plain` degrades the
/// glyphs to `+` / `-`.
pub func tool_result(result str, max_lines = 20, plain = false) str {
    let lines = result.split("\n")
    let first = lines[0]
    let ok = first.starts_with("exit 0") || first.starts_with("write ok:")
    if ok {
        var mark = GLYPH_RESULT + " " + GLYPH_OK
        if plain { mark = "+" }
        return "  " + mark + " " + first
    }
    // Prefer stderr for a failure; fall back to stdout, then the first line.
    var body = -1
    var i = 0
    while i < lines.len() {
        if lines[i] == "stderr:" { body = i + 1 }
        i += 1
    }
    if body < 0 {
        i = 0
        while i < lines.len() {
            if lines[i] == "stdout:" { body = i + 1 }
            i += 1
        }
    }
    var mark = GLYPH_RESULT + " " + GLYPH_FAIL
    if plain { mark = "-" }
    var out = "  " + mark + " " + first
    if body < 0 || body >= lines.len() { return out }
    var limit = max_lines
    if limit < 1 { limit = 1 }
    var start_at = body
    var omitted = 0
    if lines.len() - body > limit {
        omitted = lines.len() - body - limit
        start_at = lines.len() - limit
    }
    if omitted > 0 {
        if plain { out += "\n    ... " + str(omitted) + " lines omitted" }
        else { out += "\n    … " + str(omitted) + " lines omitted" }
    }
    i = start_at
    while i < lines.len() {
        out += "\n    " + lines[i]
        i += 1
    }
    return out
}

/// The `tool_end` event: the result block shown after a tool finishes. It is
/// the same compact/failure-tail form as `tool_result`; the event name makes
/// the start/end pair explicit at call sites.
pub func tool_end(result str, max_lines = 20, plain = false) str {
    return tool_result(result, max_lines, plain)
}

/// The full output of a tool action, for Ctrl-O: a header naming the action
/// and its line count, then every line unchanged. The collapsed form is
/// `tool_result`; this one never drops lines. With `plain`, the glyph
/// degrades to `*` for pipes and dumb terminals.
pub func tool_expand_lines(action str, result str, plain = false) list[str] {
    let lines = result.split("\n")
    var g = GLYPH_TOOL
    if plain { g = "*" }
    var unit = " lines"
    if lines.len() == 1 { unit = " line" }
    let out = list[str]()
    out.append(g + " " + action + " (full output, " + str(lines.len()) + unit + ")")
    for line in lines {
        out.append("  " + line)
    }
    return out
}

/// A user turn in the transcript: `> ` on the first row, two spaces on the
/// continuation rows of a multi-line input. With `dim`, every row is wrapped
/// in the dim SGR; wrapping keeps the style per row.
pub func user_lines(text str, dim = false) str {
    let lines = text.split("\n")
    var first = "> " + lines[0]
    if dim { first = "\x1b[2m" + first + "\x1b[0m" }
    var out = first
    var i = 1
    while i < lines.len() {
        var row = "  " + lines[i]
        if dim { row = "\x1b[2m" + row + "\x1b[0m" }
        out += "\n" + row
        i += 1
    }
    return out
}

/// The `turn_start` event: the user's submitted line, recorded in the
/// transcript with a `> ` prefix. `dim` marks it as past input.
pub func turn_start(text str, dim = false) str {
    return user_lines(text, dim)
}

// ---- the /sessions table ----

/// One row of `/sessions`: the switch number, name, model, message count and
/// state. The REPL builds these from the session manager; `session_lines`
/// turns them into aligned text.
pub class SessionRow {
    pub let number int
    pub let name str
    pub let model str
    pub let msgs int
    pub let paused bool
    pub let current bool

    pub func __init__(_number int, _name str, _model str, _msgs int, _paused bool, _current bool) {
        number = _number
        name = _name
        model = _model
        msgs = _msgs
        paused = _paused
        current = _current
    }
}

/// The decimal digits in `n`, at least one.
func _digits(n int) int {
    var v = n
    if v < 0 { v = -v }
    var d = 1
    while v >= 10 {
        v /= 10
        d += 1
    }
    return d
}

/// `text` right-aligned in `cols` display columns.
func _pad_left(text str, cols int) str {
    var out = text
    var used = readline.width(text)
    while used < cols {
        out = " " + out
        used += 1
    }
    return out
}

/// The `/sessions` table: `● 1 main  auto  12 msgs`, one row per session.
/// Names and models are elided on the right to fit `cols`, names first keep
/// four columns when possible. The current row is bold cyan, the paused
/// marker is `⏸`; with `plain`, markers degrade to `*` / `~` and no ANSI is
/// emitted. When `cols` is too narrow for the model column, it is dropped
/// before the message count; a very narrow table keeps marker, number and
/// name only.
pub func session_lines(rows list[SessionRow], cols int, plain = false) list[str] {
    let out = list[str]()
    if rows.len() == 0 { return out }
    var num_width = 1
    var msg_width = 1
    var max_name = 1
    var max_model = 1
    for row in rows {
        let nd = _digits(row.number)
        if nd > num_width { num_width = nd }
        let md = _digits(row.msgs)
        if md > msg_width { msg_width = md }
        let nw = readline.width(row.name)
        if nw > max_name { max_name = nw }
        let mw = readline.width(row.model)
        if mw > max_model { max_model = mw }
    }
    // marker + space + number + space + name + 2 + model + 2 + msgs + " msgs"
    let full_fixed = 12 + num_width + msg_width
    var with_model = false
    var with_msgs = true
    var model_width = 0
    var name_width = 1
    if cols >= full_fixed + 8 {
        with_model = true
        let avail = cols - full_fixed
        model_width = max_model
        if model_width > 12 { model_width = 12 }
        if model_width > avail - 4 { model_width = avail - 4 }
        if model_width < 1 { model_width = 1 }
        name_width = max_name
        if name_width > avail - model_width { name_width = avail - model_width }
        if name_width < 1 { name_width = 1 }
    } else {
        // without the model: marker + space + number + space + name + 2 +
        // msgs + " msgs"
        let no_model_fixed = 10 + num_width + msg_width
        if cols >= no_model_fixed + 1 {
            name_width = max_name
            if name_width > cols - no_model_fixed { name_width = cols - no_model_fixed }
        } else {
            // last resort: marker + space + number + space + name
            with_msgs = false
            name_width = cols - (3 + num_width)
        }
        if name_width < 1 { name_width = 1 }
    }
    for row in rows {
        var mark = " "
        if row.paused {
            if plain { mark = "~" } else { mark = "⏸" }
        } else if row.current {
            if plain { mark = "*" } else { mark = "●" }
        }
        let number = _pad_left(str(row.number), num_width)
        let name = readline.pad_text(elide_right(row.name, name_width, plain), name_width)
        var line = mark + " " + number + " " + name
        if with_model {
            let model = readline.pad_text(elide_right(row.model, model_width, plain), model_width)
            line += "  " + model
        }
        if with_msgs {
            line += "  " + _pad_left(str(row.msgs), msg_width) + " msgs"
        }
        if row.current && !plain {
            line = "\x1b[1;36m" + line + "\x1b[0m"
        }
        out.append(line)
    }
    return out
}

/// A structured HTTP error, with an actionable hint for the common cases.
/// With `plain`, the `✗` glyph degrades to `-`.
pub func http_error(status int, message str, plain = false) str {
    var mark = GLYPH_FAIL
    if plain { mark = "-" }
    if status == 401 {
        if plain { return mark + " HTTP 401: API key rejected - check $OPENAI_COMPAT_API_KEY" }
        return mark + " HTTP 401: API key rejected — check $OPENAI_COMPAT_API_KEY"
    }
    if status == 429 {
        if plain { return mark + " HTTP 429: rate limited - retry later" }
        return mark + " HTTP 429: rate limited — retry later"
    }
    return mark + " HTTP " + str(status) + ": " + message
}

/// The `status` event: the mode badge plus an optional detail. This is the
/// pure part of the status row; `repl._write_status` adds dim and fitting.
pub func status_event(mode str, detail str) str {
    if detail == "" { return "[" + mode + "]" }
    return "[" + mode + "] " + detail
}

/// The `error` event for errors that do not carry an HTTP status. With
/// `plain`, the `✗` glyph degrades to `-`.
pub func error_event(message str, plain = false) str {
    var mark = GLYPH_FAIL
    if plain { mark = "-" }
    if message == "" { return mark }
    return mark + " " + message
}

/// The `notice` event: neutral information such as a work-dir change or an
/// empty tool history. On a colour terminal it is dim; `plain` leaves the
/// text untouched.
pub func notice(text str, plain = false) str {
    if plain { return text }
    return "\x1b[2m" + text + "\x1b[0m"
}

/// The busy line: `✻ Thinking…`, `✻ Running <cmd>…`, and so on. With `plain`,
/// it degrades to `* Thinking...` for pipes and dumb terminals.
pub func busy(what str, plain = false) str {
    if plain { return "* " + what + "..." }
    return GLYPH_BUSY + " " + what + "…"
}

/// The one-line key hint under the input box. With `plain`, the middle dots
/// become ASCII pipes; the caller fits it to the terminal width.
pub func hint_line(plain = false) str {
    var sep = " · "
    if plain { sep = " | " }
    return "Enter send" + sep + "Ctrl-J newline" + sep + "Tab complete"
}

// ---- compaction: the before/after token note ----

/// A token count in a short form: `950`, `1k`, `4.1k`, `18.2k`, `131k`.
/// Used by the compaction note so before/after use one spelling.
pub func tokens_short(count int) str {
    var n = count
    if n < 0 { n = 0 }
    if n < 1000 { return str(n) }
    if n < 100_000 {
        let whole = n / 1000
        let frac = (n / 100) % 10
        if frac == 0 { return str(whole) + "k" }
        return str(whole) + "." + str(frac) + "k"
    }
    return str(n / 1000) + "k"
}

/// One dim line after compaction: `↺ context compacted 18.2k → 4.1k tokens`.
/// With `plain`, the glyph and arrow degrade to ASCII for pipes and dumb
/// terminals. The after value is an estimate until the next request reports
/// actual usage.
pub func compact_note(before int, after int, plain = false) str {
    let old_text = tokens_short(before)
    let new_text = tokens_short(after)
    if plain {
        return "* context compacted " + old_text + " -> " + new_text + " tokens"
    }
    return "\x1b[2m" + GLYPH_COMPACT + " context compacted " + old_text + " → " + new_text + " tokens\x1b[0m"
}

// ---- approval: the action preview and the y/a/n/d choice ----

/// Split file content into lines for a diff. Empty content is zero lines,
/// not one empty line, so creating an empty file shows no `+` rows.
func _text_lines(text str) list[str] {
    let out = list[str]()
    if text.len() == 0 { return out }
    for line in text.split("\n") { out.append(line) }
    return out
}

/// A prefix/suffix diff, used when the LCS table would be too large. The
/// unchanged middle is collapsed by `diff_lines`; only the prefix, the
/// changed middle and the suffix are emitted here.
func _simple_edits(a list[str], b list[str]) list[str] {
    let out = list[str]()
    let n = a.len()
    let m = b.len()
    var start = 0
    while start < n && start < m && a[start] == b[start] { start += 1 }
    var enda = n
    var endb = m
    while enda > start && endb > start && a[enda - 1] == b[endb - 1] {
        enda -= 1
        endb -= 1
    }
    var i = 0
    while i < start {
        out.append("  " + a[i])
        i += 1
    }
    i = start
    while i < enda {
        out.append("- " + a[i])
        i += 1
    }
    i = start
    while i < endb {
        out.append("+ " + b[i])
        i += 1
    }
    i = enda
    while i < n {
        out.append("  " + a[i])
        i += 1
    }
    return out
}

/// Line edits from `a` to `b`, each prefixed with `"  "`, `"- "` or `"+ "`.
/// Long inputs fall back to the prefix/suffix form so the O(n*m) table
/// cannot explode on a large file.
func _line_edits(a list[str], b list[str]) list[str] {
    let out = list[str]()
    let n = a.len()
    let m = b.len()
    if n == 0 {
        for line in b { out.append("+ " + line) }
        return out
    }
    if m == 0 {
        for line in a { out.append("- " + line) }
        return out
    }
    if n * m > 250_000 { return _simple_edits(a, b) }
    let dp = list[list[int]]()
    var i = 0
    while i <= n {
        let row = list[int]()
        var j = 0
        while j <= m {
            row.append(0)
            j += 1
        }
        dp.append(row)
        i += 1
    }
    i = n - 1
    while i >= 0 {
        var j = m - 1
        while j >= 0 {
            if a[i] == b[j] {
                dp[i][j] = dp[i + 1][j + 1] + 1
            } else if dp[i + 1][j] >= dp[i][j + 1] {
                dp[i][j] = dp[i + 1][j]
            } else {
                dp[i][j] = dp[i][j + 1]
            }
            j -= 1
        }
        i -= 1
    }
    i = 0
    var j = 0
    while i < n && j < m {
        if a[i] == b[j] {
            out.append("  " + a[i])
            i += 1
            j += 1
        } else if dp[i + 1][j] >= dp[i][j + 1] {
            out.append("- " + a[i])
            i += 1
        } else {
            out.append("+ " + b[j])
            j += 1
        }
    }
    while i < n {
        out.append("- " + a[i])
        i += 1
    }
    while j < m {
        out.append("+ " + b[j])
        j += 1
    }
    return out
}

/// A line diff from `old_text` to `new_text`: changed lines with two lines
/// of context, unchanged runs collapsed, and at most `max_rows` rows (plus
/// a truncation marker). No ANSI here; `approval_lines` adds the colours.
pub func diff_lines(old_text str, new_text str, max_rows = 120) list[str] {
    let out = list[str]()
    let edits = _line_edits(_text_lines(old_text), _text_lines(new_text))
    let marks = list[bool]()
    var i = 0
    while i < edits.len() {
        marks.append(false)
        i += 1
    }
    var changed = 0
    i = 0
    while i < edits.len() {
        if edits[i].starts_with("+ ") || edits[i].starts_with("- ") {
            changed += 1
            var j = i - 2
            if j < 0 { j = 0 }
            while j < edits.len() && j <= i + 2 {
                marks[j] = true
                j += 1
            }
        }
        i += 1
    }
    if changed == 0 { return out }
    var limit = max_rows
    if limit < 1 { limit = 1 }
    var kept = -1
    i = 0
    while i < edits.len() {
        if marks[i] {
            if kept >= 0 && i > kept + 1 {
                out.append("… " + str(i - kept - 1) + " unchanged")
                if out.len() >= limit {
                    out.append("… diff truncated")
                    return out
                }
            }
            out.append(edits[i])
            kept = i
            if out.len() >= limit {
                out.append("… diff truncated")
                return out
            }
        }
        i += 1
    }
    return out
}

/// Format a line diff for the transcript: four-space indent, red removals,
/// green additions and a dim collapsed-run marker. With `plain`, no ANSI is
/// emitted and the ellipsis degrades to ASCII.
func _diff_rows(diff list[str], plain bool) list[str] {
    let out = list[str]()
    for item in diff {
        var line = item
        if plain && line.starts_with("…") { line = "..." + line.substr(1) }
        var row = "    " + line
        if !plain {
            if line.starts_with("+ ") { row = "\x1b[32m" + row + "\x1b[0m" }
            if line.starts_with("- ") { row = "\x1b[31m" + row + "\x1b[0m" }
            if line.starts_with("…") { row = "\x1b[2m" + row + "\x1b[0m" }
        }
        out.append(row)
    }
    return out
}

/// The `diff` event: the changed lines from `old_text` to `new_text` with
/// colours (or plain prefixes). Max rows and truncation match `diff_lines`.
pub func diff_event(old_text str, new_text str, max_rows = 120, plain = false) list[str] {
    return _diff_rows(diff_lines(old_text, new_text, max_rows), plain)
}

/// The action detail shown before the approval question. A shell command
/// gets its body; a write's path is already on the tool-start row.
pub func action_detail(info str, body str, plain = false) list[str] {
    let out = list[str]()
    if info == "shell" || info == "sh" || info == "bash" || info.starts_with("shell ") {
        let cmd = body.strip()
        if cmd == "" { return out }
        for line in cmd.split("\n") { out.append("    $ " + line) }
    }
    return out
}

/// The preview for one approval: a write's summary and diff, or the hint
/// alone for a shell (its command is in `action_detail`). `show_diff` is
/// false when the old file is too large to read safely.
pub func approval_lines(info str, body str, old_text str, old_exists bool, show_diff bool, max_rows int, plain = false) list[str] {
    let out = list[str]()
    if info.starts_with("write") {
        let path = info.substr(5).strip()
        if !show_diff {
            var sep = " · "
            if plain { sep = " | " }
            out.append("  " + path + sep + "diff unavailable (file is too large)")
        } else {
            let diff = diff_lines(old_text, body, max_rows)
            var add = 0
            var rem = 0
            for line in diff {
                if line.starts_with("+ ") { add += 1 }
                if line.starts_with("- ") { rem += 1 }
            }
            if old_exists {
                out.append("  update " + path + " (+" + str(add) + " -" + str(rem) + ")")
            } else {
                out.append("  create " + path + " (+" + str(add) + ")")
            }
            if diff.len() == 0 { out.append("    (no changes)") }
            for row in _diff_rows(diff, plain) { out.append(row) }
        }
    }
    var sep = " · "
    if plain { sep = " | " }
    out.append("  [y] once" + sep + "[a] all this session" + sep + "[n] deny" + sep + "[d] full diff")
    return out
}

/// Normalise the answer to one of `y` (once), `a` (all this session),
/// `n` (deny; also the default for blank or unknown input) and `d` (show
/// the full diff).
pub func approval_choice(line str) str {
    let s = line.strip().lower()
    if s == "a" || s == "all" { return "a" }
    if s == "y" || s == "yes" { return "y" }
    if s == "d" || s == "diff" { return "d" }
    return "n"
}

/// The in-box prompt for an approval; the default is denial.
pub func approval_prompt() str {
    return "Apply [y/a/n/d] (default n): "
}