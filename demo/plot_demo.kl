/*
 * plot_demo.kl — koala/plot 功能演示菜单。
 *
 * 运行（任意目录均可，需先构建 koala/plot 及其依赖 koala/webview、
 * koala/json、koala/math、koala/readline）：
 *
 *     ./demo/run_plot_demo.sh
 *
 * 启动后是一个终端菜单，每个菜单项演示一个功能；选 1-4 是一页一图，
 * 选 5 是把四个功能放进同一页的 2x2 子图（一页多图）。每次开一个
 * 系统 webview 原生窗口（Linux 上是 WebKitGTK），关窗回到菜单，选 0
 * 退出（Ctrl-D 亦可）：
 *
 *   1  训练曲线     plot(fmt,label) + legend/grid   一页一图
 *   2  预测 vs 目标 scatter(s=,c=) + y=x 参考线      一页一图
 *   3  残差分布     hist(bins=)                      一页一图
 *   4  损失地形     contour(levels=,xs=,ys=)         一页一图
 *   5  2x2 总览     四个功能放在同一页               一页多图
 *   0  退出
 *
 * 管道下自动退化为普通行读取（无行编辑/历史），便于脚本化：
 *
 *     printf '5\n0\n' | KOALA_PLOT_BACKEND=html ./demo/run_plot_demo.sh
 *
 * 无显示环境（headless）加 KOALA_PLOT_BACKEND=html：每个菜单项写出
 * plot.html（每次覆盖）后立即返回菜单。
 *
 * 接口与 matplotlib.pyplot 一致，matplotlib 脚本近乎零成本迁移：
 *
 *     import "koala/plot" as plt        # 对应 import matplotlib.pyplot as plt
 *     plt.figure(figsize = (10.0, 8.0)) # 英寸，像素 = 英寸 * dpi
 *     plt.subplot(2, 2, 1)              # 1-based 行优先索引
 *     plt.plot(x, y, "C0-", label = "train loss")
 *     plt.xlabel("epoch"); plt.legend(); plt.grid()
 *     plt.show()                        # v1 默认阻塞，直到关窗
 *
 * 数据约定：v1 用 list[float] 装数据（渲染几何 != ML 数值计算）；builtin
 * Tensor 入口后续增量加入，几何层不动。下面的随机样本只是演示用的确定性
 * 伪随机数据（stdlib 暂无 random 包），不是 ML 计算路径。
 */

import "koala/plot" as plt
import "koala/math"
import "koala/readline"

// ---- 演示用确定性伪随机源（LCG + Box-Muller 生成标准正态样本）----

var seed = 12345

func next_uniform() float {
    seed = (seed * 1103515245 + 12345) % 2147483648
    return float(seed) / 2147483648.0
}

func randn() float {
    let u1 = next_uniform() + 1e-12
    let u2 = next_uniform()
    return math.sqrt(-2.0 * math.log(u1)) * math.cos(math.TAU * u2)
}

func linspace(a float, b float, n int) list[float] {
    var xs = list[float]()
    for i in range(n) {
        xs.append(a + (b - a) * float(i) / float(n - 1))
    }
    return xs
}

// ---- 菜单 ----

func print_menu() {
    print("=== koala/plot 功能演示 ===")
    print("  1  训练曲线     plot(fmt,label) + legend/grid   一页一图")
    print("  2  预测 vs 目标 scatter(s=,c=) + y=x 参考线      一页一图")
    print("  3  残差分布     hist(bins=)                      一页一图")
    print("  4  损失地形     contour(levels=,xs=,ys=)         一页一图")
    print("  5  2x2 总览     四个功能放在同一页               一页多图")
    print("  0  退出")
}

func main() {
    print_menu()
    while let line = readline.input("选择 > ") {
        let n = line.strip().to_int_or(-1)
        if n == 0 {
            print("再见")
            break
        }
        var shown = false
        switch n {
            case 1: {
                page_train()
                shown = true
            }
            case 2: {
                page_scatter()
                shown = true
            }
            case 3: {
                page_hist()
                shown = true
            }
            case 4: {
                page_contour()
                shown = true
            }
            case 5: {
                page_overview()
                shown = true
            }
        }
        if shown {
            print_menu()
        } else {
            print("无效选择，请输入 0-5")
        }
    }
}

// ---- 演示数据（各菜单项按需重建）----

// 指数衰减的 train/val loss。
func train_series() (list[float], list[float], list[float]) {
    let epochs = linspace(0.0, 49.0, 50)
    var train = list[float]()
    var val = list[float]()
    for i in range(50) {
        let t = float(i)
        train.append(2.0 * math.exp(-t / 12.0) + 0.08)
        val.append(2.0 * math.exp(-t / 15.0) + 0.22 + 0.03 * math.sin(t))
    }
    return (epochs, train, val)
}

// 带噪声的预测值。
func scatter_series() (list[float], list[float]) {
    let targets = linspace(0.0, 10.0, 40)
    var preds = list[float]()
    for t in targets {
        preds.append(t + 0.6 * randn())
    }
    return (targets, preds)
}

// 标准正态残差样本。
func residual_series() list[float] {
    var residuals = list[float]()
    for i in range(2000) {
        residuals.append(randn())
    }
    return residuals
}

// 二次碗 + 正弦涟漪的损失地形网格。
func landscape_series() (list[float], list[list[float]]) {
    let g = linspace(-2.0, 2.0, 40)
    var z = list[list[float]]()
    for i in range(40) {
        var row = list[float]()
        let y = g[i]
        for j in range(40) {
            let x = g[j]
            row.append(x * x + y * y + 0.4 * math.sin(3.0 * x) * math.cos(3.0 * y))
        }
        z.append(row)
    }
    return (g, z)
}

// ---- 各功能页（一页一图）----

// (1) 训练曲线：指数衰减的 train/val loss。
func page_train() {
    plt.figure(figsize = (6.0, 4.5))
    let (epochs, train, val) = train_series()
    plt.plot(epochs, train, "C0-", label = "train loss")
    plt.plot(epochs, val, "C1--", label = "val loss")
    plt.title("Training curves")
    plt.xlabel("epoch")
    plt.ylabel("loss")
    plt.legend()
    plt.grid()
    plt.show()
}

// (2) 预测 vs 目标：带噪声的散点 + y=x 参考线。
func page_scatter() {
    plt.figure(figsize = (6.0, 4.5))
    let (targets, preds) = scatter_series()
    plt.scatter(targets, preds, s = 22.0, c = "C3", label = "samples")
    plt.plot([0.0, 10.0], [0.0, 10.0], "k--", label = "y = x")
    plt.title("Predictions vs targets")
    plt.xlabel("target")
    plt.ylabel("prediction")
    plt.legend()
    plt.show()
}

// (3) 残差分布：标准正态样本的直方图。
func page_hist() {
    plt.figure(figsize = (6.0, 4.5))
    plt.hist(residual_series(), bins = 24, color = "C2")
    plt.title("Residual distribution")
    plt.xlabel("residual")
    plt.ylabel("count")
    plt.show()
}

// (4) 损失地形：二次碗 + 正弦涟漪的等高线。
func page_contour() {
    plt.figure(figsize = (6.0, 4.5))
    let (g, z) = landscape_series()
    plt.contour(z, [0.5, 1.0, 2.0, 4.0, 8.0], xs = g, ys = g)
    plt.title("Loss landscape")
    plt.xlabel("w0")
    plt.ylabel("w1")
    plt.show()
}

// ---- 2x2 总览（一页多图）----

// (5) 上面四个功能放进同一页的 2x2 子图。
func page_overview() {
    plt.figure(figsize = (10.0, 8.0))

    plt.subplot(2, 2, 1)
    let (epochs, train, val) = train_series()
    plt.plot(epochs, train, "C0-", label = "train loss")
    plt.plot(epochs, val, "C1--", label = "val loss")
    plt.title("Training curves")
    plt.xlabel("epoch")
    plt.ylabel("loss")
    plt.legend()
    plt.grid()

    plt.subplot(2, 2, 2)
    let (targets, preds) = scatter_series()
    plt.scatter(targets, preds, s = 22.0, c = "C3", label = "samples")
    plt.plot([0.0, 10.0], [0.0, 10.0], "k--", label = "y = x")
    plt.title("Predictions vs targets")
    plt.xlabel("target")
    plt.ylabel("prediction")
    plt.legend()

    plt.subplot(2, 2, 3)
    plt.hist(residual_series(), bins = 24, color = "C2")
    plt.title("Residual distribution")
    plt.xlabel("residual")
    plt.ylabel("count")

    plt.subplot(2, 2, 4)
    let (g, z) = landscape_series()
    plt.contour(z, [0.5, 1.0, 2.0, 4.0, 8.0], xs = g, ys = g)
    plt.title("Loss landscape")
    plt.xlabel("w0")
    plt.ylabel("w1")

    plt.show()
}
