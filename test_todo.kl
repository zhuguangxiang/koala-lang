
trait Hello {
    func hello() str
    func hi() str
}


class MyClass : Hello {
    func hello2() str {
        return "Hello from MyClass!"
    }
    func hi() str {
        return "Hi from MyClass!"
    }

    func __call__() str {
        return "MyClass instance called!"
    }
}

