import "std/sys"
import "koala/cli"
import "koala/wombat" as wb

const VERSION = "0.5.0"

/// `wombat` command line entry point.
pub func main() {
    let argv = sys.args()
    let code = dispatch(argv)
    if code != 0 { sys.exit(code) }
}

/// The parser of `wombat` and of each of its commands.
class Commands {
    let wombat cli.ArgumentParser
    let sub cli.SubParsers

    func __init__() {
        let description = "wombat " + VERSION + " — build system & package manager"
        let epilog = "Run `wombat help <command>` for details."
        wombat = cli.ArgumentParser(prog="wombat", description=description, epilog=epilog)
        wombat.add_argument("-V", "--version", action="version", version="wombat " + VERSION)
        sub = wombat.add_subparsers(dest="command", metavar="<command>")

        let new = sub.add_parser("new", help="Create a workspace or package",
                                 epilog="Creates a workspace when the current directory has " +
                                        "no __ws__.toml, otherwise creates a package inside it.")
        new.add_argument("name", help="Name of the workspace or package")

        let build = sub.add_parser("build", help="Compile the current workspace or package",
                                   epilog="When <dir> contains __ws__.toml the whole workspace " +
                                          "is built; when it contains __pkg__.toml only that " +
                                          "package is built.")
        build.add_argument("dir", nargs="?", default=".",
                           help="Workspace or package directory (default: %(default)s)")
        build.add_argument("-o", "--output", default="./dist",
                           help="Output directory (default: %(default)s)")
        build.add_argument("--force", action="store_true",
                           help="Rebuild every artifact, even an up-to-date one")

        let check = sub.add_parser("check", help="Check without producing artifacts",
                                   epilog="Parses and type-checks without producing artifacts.")
        check.add_argument("dir", nargs="?", default=".")

        let run = sub.add_parser("run", help="Run a .kl source file or a .klc artifact",
                                 epilog="<target> may be a .kl source file, a .klc artifact, " +
                                        "or a name without extension, which is looked up as " +
                                        "<name>.klc, then <name>.kl. Extra arguments are " +
                                        "forwarded to the program.\n" +
                                        "\n" +
                                        "Options must come before <target>: everything after " +
                                        "it belongs to the program.")
        run.add_argument("target", help="What to run")
        run.add_argument("--no-jit", action="store_true",
                         help="Run with the JIT disabled (sets KOALA_JIT=0 for the program)")
        run.add_argument("args", nargs=cli.REMAINDER, help="Arguments for the program")

        let test_epilog = "targets:\n" +
                          "  (no target)   Test every directory package and ws/test/\n" +
                          "  @             Test only ws/test/, no package tests\n" +
                          "  <dir>         Test a workspace or a single package\n" +
                          "  <file.kl>     Not supported yet\n" +
                          "\n" +
                          "ws/test/ holds tests that do not belong to a specific package;\n" +
                          "it is only run from a workspace root."
        let test = sub.add_parser("test", help="Run tests for the current workspace or package",
                                  epilog=test_epilog,
                                  formatter_class=cli.RawDescriptionHelpFormatter)
        test.add_argument("target", nargs="?", default=".", help="What to test")
        test.add_argument("--no-jit", action="store_true",
                          help="Run every test with the JIT disabled (sets KOALA_JIT=0)")

        let fmt = sub.add_parser("fmt", help="Format source code",
                                 epilog="Formats every `.kl` file in the workspace or package.")
        fmt.add_argument("dir", nargs="?", default=".")

        let doc = sub.add_parser("doc", help="Generate documentation",
                                 epilog="Generates documentation for the workspace or package.")
        doc.add_argument("dir", nargs="?", default=".")

        let clean_epilog = "Removes <workspace>/dist. Must be run inside a workspace (a " +
                           "directory containing __ws__.toml). Without -y, you must type the " +
                           "full word `yes` to confirm."
        let clean = sub.add_parser("clean", help="Remove build artifacts", epilog=clean_epilog)
        clean.add_argument("dir", nargs="?", default=".")
        clean.add_argument("-y", "--yes", action="store_true", help="Skip the confirmation prompt")

        let help = sub.add_parser("help", help="Show the options of one command")
        help.add_argument("name", nargs="?", help="The command")

        sub.add_parser("version", help="Print the wombat version")
    }
}

func dispatch(argv list[str]) int {
    let commands = Commands()
    let args = commands.wombat.parse_args(argv)

    let picked = args.get("command")
    if picked == nil {
        commands.wombat.print_help()
        return 0
    }
    let cmd = (picked as str)!

    if cmd == "help" {
        if let name = args.get("name") {
            if let p = commands.sub.find((name as str)!) {
                p.print_help()
                return 0
            }
        }
        commands.wombat.print_help()
        return 0
    }

    if cmd == "version" {
        print("wombat " + VERSION)
        return 0
    }

    if cmd == "new" { return wb.new_auto(_value(args, "name")) }
    if cmd == "build" {
        let force = (args.get("force")! as bool)!
        return wb.build_all(_value(args, "dir"), _value(args, "output"), force)
    }
    if cmd == "test" { return cmd_test(_value(args, "target"), _flag(args, "no_jit")) }
    if cmd == "run" {
        return wb.run(_value(args, "target"), (args.get("args")! as list[str])!,
                      _flag(args, "no_jit"))
    }
    if cmd == "clean" { return wb.clean_all(_value(args, "dir"), (args.get("yes")! as bool)!) }

    // check, fmt, doc
    printf("wombat {}: not implemented yet\n", cmd)
    return 1
}

// The str value of `name`, which has a default or is required.
func _value(args cli.Namespace, name str) str {
    return (args.get(name)! as str)!
}

// The bool value of a store_true flag.
func _flag(args cli.Namespace, name str) bool {
    return (args.get(name)! as bool)!
}

/// `wombat test [target] [--no-jit]`
///
/// `target` may be `@` (only `ws/test/*.kl`), a directory (workspace
/// or single package), or a `.kl` / `.klc` file (not supported yet).
func cmd_test(target str, no_jit bool) int {
    return wb.test_all(target, no_jit)
}
