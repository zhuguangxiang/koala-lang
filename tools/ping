#!/usr/bin/env koala
/*
 * ping — a classic ping front end built on koala/icmp.
 *
 * Drives IcmpSocket directly so each reply prints as it arrives and
 * probes are spaced one second apart, the way the system ping works.
 * The library's ping_ip collects everything first; this front end
 * keeps the loop local for streaming output.
 */

import "std/socket" as so
import "std/sys"
import "std/time"
import "koala/icmp"

func main() {
    let args = sys.args()
    if args.len() < 1 {
        print("usage: ping <host>")
        return
    }
    let host = args[0]

    let rr = so.resolve(host)
    if rr.status() != so.DNS_OK || rr.addrs().len() == 0 {
        print("ping: cannot resolve " + host)
        return
    }
    let ip = rr.addrs()[0]
    let ip_str = ip.to_str()

    print("PING " + host + " (" + ip_str + ") 18(38) bytes of data.")

    let sock = icmp.IcmpSocket.open() else {
        print("ping: cannot open ICMP socket")
        return
    }

    let count = 4
    let timeout = time.Duration.from_secs(1)
    let interval_ns = int(time.Duration.from_secs(1).to_ns())
    let stats = icmp.PingStats.new()

    var seq = 0
    while seq < count {
        let t_start = time.now()
        let outcome = sock.echo(ip, seq, timeout)
        stats.record(seq, outcome)

        let n = seq + 1
        if outcome.kind() == icmp.PING_SUCCESS {
            print("18 bytes from " + ip_str + ": icmp_seq=" + str(n) +
                  " time=" + format("{}", outcome.rtt()!))
        } else if outcome.kind() == icmp.PING_TIMEOUT {
            print("Request timeout for icmp_seq=" + str(n))
        } else if outcome.has_icmp_error() {
            print("ICMP failure for icmp_seq=" + str(n) + " (" +
                  icmp.icmp_type_name(outcome.icmp_type()) +
                  ", code " + str(outcome.icmp_code()) + ")")
        } else {
            print("ICMP failure for icmp_seq=" + str(n) + " (socket error)")
        }

        seq += 1
        if seq < count {
            let elapsed_ns = int(time.now().diff(t_start).to_ns())
            if elapsed_ns < interval_ns {
                let wait_ns = interval_ns - elapsed_ns
                // print("  [sleep " + str(wait_ns / 1000000) + "ms]")
                time.sleep(time.Duration.from_nanos(wait_ns))
            }
        }
    }

    sock.close()

    print("")
    print("--- " + host + " ping statistics ---")
    print(str(stats.sent()) + " packets transmitted, " + str(stats.succeeded()) +
          " received, " + str(int(stats.loss())) + "% packet loss")
    if stats.min_rtt() != nil {
        print("rtt min/avg/max = " +
              format("{}", stats.min_rtt()!) + "/" +
              format("{}", stats.avg_rtt()!) + "/" +
              format("{}", stats.max_rtt()!))
    }
}
