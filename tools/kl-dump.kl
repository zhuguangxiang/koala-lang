// Dump a `.klc` (Koala Code) file, written in Koala itself.
//
// usage:
//     koala tools/kl-dump.kl <file.klc>
//
// A klc file is a Stream Object Format (SOF) stream produced by
// `src/common/klc.c`. This tool parses every section and prints it:
// header, constants, variables, functions, classes (with pip/lro and
// interface tables), runtime constants, imports, links, codes and
// disassembled bytecodes.
//
// The opcode tables below mirror `include/common/opcode_list.h` and
// must be kept in sync with it.

import "std/os"
import "std/fs"

/* ---------------- opcode tables ---------------- */

