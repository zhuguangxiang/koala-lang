    let pkg_sec = toml.TomTable()
    pkg_sec.add("name", toml.TomString("koala/my_package"))
    pkg_sec.add("version", toml.TomString("0.1.0"))
    pkg_sec.add("dependencies", toml.TomArray())
    pkg_sec.add("natives", toml.TomArray())

    let root = toml.TomTable()
    root.add("package", pkg_sec)
    print(dump(root))
}
