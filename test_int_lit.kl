var h int64 = 0x8000000000000000  // 成功: 位模式填充为 INT64_MIN
var i uint64 = 0xFFFFFFFFFFFFFFFF // 成功: UINT64_MAX
var j int64 = -9223372036854775808 // 成功: INT64_MIN (使用 int128 准确解析)

