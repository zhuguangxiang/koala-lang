class List[T] : Iterable[T] {
    public func __iter__() Iterator[T] {
        return ListIter[T](self)
    }
}

class ListIter[T] : Iterator[T] {
    var l List[T]

    public func __init__(l_ List[T]) {
        self.l = l_
    }

    public func __next__() T {
        return eof
    }
}

