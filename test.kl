public trait Indexable[T] {
    func __getitem__(index object) T?
    func __setitem__(index object, v T)
}

public class object {

    @native(object_hash)
    public func hash() int {}

    @native(object_equals)
    public func equals(rhs object) bool {}

    @native(object_str)
    public func to_str() str {}
}

public trait Iterator[T] {
    func has_next() bool
    func next() T
}

/**

*/
public trait Iterable[T] {
    func iter() Iterator[T]
}

class Foo {
    var name str
    var age int

    func bar() {
        hello()
    }
}

trait Foo {
    func hello()
    func bar()
}
