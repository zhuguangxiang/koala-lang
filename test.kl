// @native(kl_builtin_print)
// public func print(objs ..., sep = ' ', end = '\n', file io.Writer? = none) {}

public trait AutoClosable {
    public func close()
}

public trait Writer : AutoClosable {
    public func write(bs Bytes, off int = 0, len int = -1) int
    public func flush()
}

public trait Reader : AutoClosable {
    public func read(bs Bytes, off int = 0, len int = -1) int
    public func reset()
}

public class Splits : Iterator[bytes] {
    @native(kl_split_new)
    public static func __new__(r Reader) {}

    @native(kl_split_next)
    public func __next__() bytes? {}
}

public class BufferedReader : Reader & Iterable[bytes] {

    public static func __new__(r Reader) {

    }

    @native(kl_buf_read_until)
    public func read_until(sep int) bytes {}

    @native(kl_buf_read_line)
    public func read_line() bytes? {}

    @native(kl_buf_read_lines)
    public func __iter__() Iterator[bytes] {}

    @native(ok)
    public func split(sep int) Splits {}
}

